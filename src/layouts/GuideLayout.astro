---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';

interface CalculatorCallout {
  title: string;
  slug: string;
  desc: string;
  badge: string;
}

interface Props {
  title: string;
  metaDescription: string;
  canonicalPath: string;
  guideTitle: string;
  guideSubtitle: string;
  standardBadge: string;
  readingTime?: string;
  lastUpdated?: string;
  calculatorsSupported: CalculatorCallout[];
  schemaType?: 'Article' | 'HowTo';
  schemaData?: Record<string, any>;
  upLinks?: Array<{ title: string; slug: string; badge?: string }>;
  lateralLinks?: Array<{ title: string; slug: string; badge?: string }>;
  bridgeLinks?: Array<{ title: string; slug: string; badge?: string }>;
}

const {
  title,
  metaDescription,
  canonicalPath,
  guideTitle,
  guideSubtitle,
  standardBadge,
  readingTime = '6 min read',
  lastUpdated = 'September 2026',
  calculatorsSupported = [],
  schemaType = 'Article',
  schemaData = {},
  upLinks = [],
  lateralLinks = [],
  bridgeLinks = []
} = Astro.props;

const siteUrl = 'https://rockcoveragecalculator.com';
const canonicalURL = `${siteUrl}${canonicalPath}`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Technical Guides', url: '/rock-coverage-chart' },
  { name: guideTitle, url: canonicalPath }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "headline": guideTitle,
  "description": metaDescription,
  "inLanguage": "en-US",
  "url": canonicalURL,
  "datePublished": "2026-01-15T08:00:00+00:00",
  "dateModified": "2026-09-22T08:00:00+00:00",
  "author": {
    "@type": "Organization",
    "name": "Civil & Geotechnical Editorial Board",
    "url": `${siteUrl}/about#editorial-board`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Rock Coverage Calculator",
    "url": siteUrl
  },
  ...schemaData
};
---

<BaseLayout
  title={title}
  description={metaDescription}
  canonicalPath={canonicalPath}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": crumb.name,
        "item": `${siteUrl}${crumb.url}`
      }))
    })} />
  </Fragment>

  <Header />

  <main class="guide-main">
    <!-- Guide Header -->
    <header class="guide-hero">
      <div class="container">
        <nav class="guide-breadcrumbs" aria-label="Breadcrumbs">
          <ol>
            {breadcrumbs.map((crumb, index) => (
              <li>
                {index < breadcrumbs.length - 1 ? (
                  <a href={crumb.url}>{crumb.name}</a>
                ) : (
                  <span aria-current="page">{crumb.name}</span>
                )}
                {index < breadcrumbs.length - 1 && <span class="crumb-separator">/</span>}
              </li>
            ))}
          </ol>
        </nav>

        <div class="guide-hero-badge-row">
          <span class="standard-badge">{standardBadge}</span>
          <span class="reading-meta">{readingTime}</span>
          <span class="reading-meta">Updated: {lastUpdated}</span>
        </div>

        <h1 class="guide-hero-title">{guideTitle}</h1>
        <p class="guide-hero-subtitle">{guideSubtitle}</p>

        <div class="guide-author-bar">
          <div class="author-avatar">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="author-info">
            <span class="author-name"><a href="/about#editorial-board" style="color: inherit; text-decoration: none;">Reviewed by Civil &amp; Geotechnical Editorial Board</a></span>
            <span class="author-title">ASTM C29 &amp; AASHTO Standards Verification</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Guide Content Body -->
    <article class="guide-article">
      <div class="container guide-layout-grid">
        
        <!-- Main Article Column -->
        <div class="guide-content-col">
          <slot />

          <!-- Transactional Calculators Callout Box -->
          {calculatorsSupported.length > 0 && (
            <section class="calc-callout-section" aria-label="Companion Calculators">
              <div class="calc-callout-header">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10v10H7z"/></svg>
                <h3>Companion Calculators for This Project</h3>
              </div>
              <p>Apply the principles and formulas from this guide directly into our calibrated volumetric estimators:</p>
              <div class="calc-callout-grid">
                {calculatorsSupported.map((calc) => (
                  <a href={calc.slug} class="calc-callout-card">
                    <div class="calc-callout-card-top">
                      <h4>{calc.title}</h4>
                      <span class="calc-callout-badge">{calc.badge}</span>
                    </div>
                    <p>{calc.desc}</p>
                    <span class="calc-callout-action">Launch Calculator &rarr;</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- Sidebar Column -->
        <aside class="guide-sidebar-col">
          <div class="sidebar-sticky-wrapper">
            <div class="sidebar-card">
              <h3 class="sidebar-title">Engineering Standards</h3>
              <ul class="standards-list">
                <li>
                  <strong>ASTM C29 / C29M:</strong>
                  <span>Bulk density unit weight testing for loose stockpiles.</span>
                </li>
                <li>
                  <strong>ASTM D448:</strong>
                  <span>Standard sizes of coarse aggregate for civil construction.</span>
                </li>
                <li>
                  <strong>AASHTO M43:</strong>
                  <span>Standard sizes for highway and road base aggregates.</span>
                </li>
                <li>
                  <strong>AASHTO M147:</strong>
                  <span>Dense graded materials for sub-base and base courses.</span>
                </li>
                <li>
                  <strong>ASTM C136:</strong>
                  <span>Sieve analysis test method for fine and coarse aggregates.</span>
                </li>
              </ul>
            </div>

            <div class="sidebar-card highlight">
              <h3 class="sidebar-title">Need Immediate Estimates?</h3>
              <p class="sidebar-text">Use our primary multi-shape estimator to calculate cubic yards and tons for any bed geometry.</p>
              <a href="/" class="btn-sidebar-primary">Open Main Calculator</a>
            </div>
          </div>
        </aside>

      </div>
    </article>

    <!-- Topic Cluster Navigation -->
    <TopicClusterNav
      currentPage={canonicalPath}
      category="guide"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .guide-main {
    background: var(--bg-body);
    color: var(--text-primary);
  }

  .guide-hero {
    padding: var(--space-12) 0 var(--space-8) 0;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .guide-breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .guide-breadcrumbs a:hover {
    color: var(--accent-gold);
  }

  .crumb-separator {
    color: var(--border-subtle);
    margin-left: var(--space-2);
  }

  .guide-hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .standard-badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    background: rgba(212, 168, 83, 0.12);
    border: 1px solid rgba(212, 168, 83, 0.3);
    border-radius: var(--radius-full);
  }

  .reading-meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .guide-hero-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    margin: 0 0 var(--space-3) 0;
  }

  .guide-hero-subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.6;
    margin: 0 0 var(--space-6) 0;
  }

  .guide-author-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(212, 168, 83, 0.15);
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-primary);
  }

  .author-title {
    font-size: 11px;
    color: var(--text-muted);
  }

  /* Guide Layout Grid */
  .guide-article {
    padding: var(--space-12) 0 var(--space-16) 0;
  }

  .guide-layout-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-10);
  }

  @media (max-width: 992px) {
    .guide-layout-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .guide-content-col {
    min-width: 0;
  }

  /* Sidebar */
  .sidebar-sticky-wrapper {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .sidebar-card.highlight {
    border-color: rgba(212, 168, 83, 0.35);
    background: rgba(212, 168, 83, 0.04);
  }

  .sidebar-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-4) 0;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-2);
  }

  .standards-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .standards-list li {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .standards-list strong {
    display: block;
    color: var(--text-primary);
  }

  .sidebar-text {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .btn-sidebar-primary {
    display: block;
    text-align: center;
    padding: var(--space-3);
    background: var(--accent-gold);
    color: #111;
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: opacity var(--transition-fast);
  }

  .btn-sidebar-primary:hover {
    opacity: 0.9;
  }

  /* Calculators Callout Section */
  .calc-callout-section {
    margin-top: var(--space-12);
    padding: var(--space-8);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
  }

  .calc-callout-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    color: var(--accent-gold);
  }

  .calc-callout-header h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .calc-callout-section > p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-6) 0;
  }

  .calc-callout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .calc-callout-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--transition-fast);
  }

  .calc-callout-card:hover {
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .calc-callout-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .calc-callout-card-top h4 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .calc-callout-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(212, 168, 83, 0.15);
    color: var(--accent-gold);
    white-space: nowrap;
  }

  .calc-callout-card p {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0 0 var(--space-3) 0;
  }

  .calc-callout-action {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-gold);
  }
</style>
