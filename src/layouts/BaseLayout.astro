---
import '../styles/global.css';
import '../styles/calculator.css';
import '../styles/visualizer.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const { title, description, metaDescription, canonicalPath, noindex = false } = Astro.props;
const pageDescription = description || metaDescription || 'Free rock coverage and aggregate calculator for landscaping and civil construction projects.';
const siteUrl = 'https://rockcoveragecalculator.com';
const pagePath = canonicalPath ?? Astro.url.pathname;
const canonicalURL = new URL(pagePath === '/' ? '/' : pagePath.replace(/\/+$/, ''), siteUrl).href;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="google-site-verification" content="HCyFYA4BAPRS0wlYok2AsFsajHg5rBZyENsSi1pIcNI" />
  <link rel="canonical" href={canonicalURL} />

  <!-- US Geographic Targeting -->
  <meta name="geo.region" content="US" />
  <meta name="geo.placename" content="United States" />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Rock Coverage Calculator" />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Rock Coverage Calculator website preview" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
  <meta name="twitter:image:alt" content="Rock Coverage Calculator website preview" />

  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8089300808424687" crossorigin="anonymous"></script>

  <!-- JSON-LD Schema Knowledge Graph -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": `${canonicalURL}#webpage`,
        "name": title,
        "url": canonicalURL,
        "description": pageDescription,
        "inLanguage": "en-US",
        "isPartOf": { "@id": `${siteUrl}/#website` },
        "publisher": { "@id": `${siteUrl}/#organization` }
      },
      {
        "@type": "Organization",
        "@id": "https://rockcoveragecalculator.com/#organization",
        "name": "Rock Coverage Calculator",
        "url": "https://rockcoveragecalculator.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://rockcoveragecalculator.com/favicon.svg"
        },
        "areaServed": {
          "@type": "Country",
          "name": "United States"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://rockcoveragecalculator.com/#website",
        "url": "https://rockcoveragecalculator.com",
        "name": "Rock Coverage Calculator",
        "description": "Rock, gravel, and stone coverage estimators and practical project guides.",
        "inLanguage": "en-US",
        "publisher": {
          "@id": "https://rockcoveragecalculator.com/#organization"
        }
      }
    ]
  })} />

  <!-- Early Theme Initialization (Light Mode by Default) -->
  <script is:inline>
    (function() {
      try {
        const savedTheme = localStorage.getItem('theme');
        const requestedTheme = location.pathname.replace(/\/$/, '') === '/embed' ? new URLSearchParams(location.search).get('theme') : null;
        const theme = requestedTheme === 'dark' || requestedTheme === 'light' ? requestedTheme : savedTheme || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  <!-- Additional Head Elements (Page Schemas) -->
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <slot />
</body>
</html>
