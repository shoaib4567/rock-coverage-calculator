---
import '../styles/global.css';
import '../styles/calculator.css';
import '../styles/visualizer.css';
import '../styles/animations.css';
import { getContentPage, getBreadcrumbs } from '../lib/content-map.mjs';

interface Props {
  title: string;
  description?: string;
  metaDescription?: string;
  canonicalPath?: string;
  noindex?: boolean;
  hideAds?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, metaDescription, canonicalPath, noindex = false, hideAds = false, ogType } = Astro.props;
const siteUrl = 'https://rockcoveragecalculator.com';
const pagePath = canonicalPath ?? Astro.url.pathname;
const page = getContentPage(pagePath);
const pageTitle = page?.title ?? title;
const pageDescription = page?.summary || description || metaDescription || 'Estimate rock volume and weight from your measurements and supplier assumptions.';
const breadcrumbItems = getBreadcrumbs(pagePath);
const hasBreadcrumb = breadcrumbItems.length > 1 && !['/embed', '/404'].includes(pagePath);
const canonicalURL = new URL(pagePath === '/' ? '/' : pagePath.replace(/\/+$/, ''), siteUrl).href;
const isArticleKind = Boolean(page?.kind?.includes('guide') || page?.kind === 'methodology');
const resolvedOgType = ogType ?? (isArticleKind ? 'article' : 'website');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={pageDescription} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="google-site-verification" content="HCyFYA4BAPRS0wlYok2AsFsajHg5rBZyENsSi1pIcNI" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:locale" content="en" />
  <meta property="og:type" content={resolvedOgType} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Rock Coverage Calculator" />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Rock Coverage Calculator website preview" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
  <meta name="twitter:image:alt" content="Rock Coverage Calculator website preview" />

  <title>{pageTitle}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {!hideAds && !noindex && (
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8089300808424687" crossorigin="anonymous"></script>
  )}

  <!-- JSON-LD Schema Knowledge Graph -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": page?.kind === 'directory' ? 'CollectionPage' : page?.kind === 'contact' ? 'ContactPage' : page?.kind === 'methodology' ? 'AboutPage' : 'WebPage',
        "@id": `${canonicalURL}#webpage`,
        "name": pageTitle,
        "url": canonicalURL,
        "description": pageDescription,
        "inLanguage": "en",
        "isPartOf": { "@id": `${siteUrl}/#website` },
        "publisher": { "@id": `${siteUrl}/#organization` },
        ...(page ? { "about": { "@type": "Thing", "name": page.entity } } : {}),
        ...(hasBreadcrumb ? { "breadcrumb": { "@id": `${canonicalURL}#breadcrumb` } } : {})
      },
      {
        "@type": "Organization",
        "@id": "https://rockcoveragecalculator.com/#organization",
        "name": "Rock Coverage Calculator",
        "url": "https://rockcoveragecalculator.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://rockcoveragecalculator.com/favicon.svg"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://rockcoveragecalculator.com/#website",
        "url": "https://rockcoveragecalculator.com",
        "name": "Rock Coverage Calculator",
        "description": "Rock, gravel, and stone coverage estimators and project reference guides.",
        "inLanguage": "en",
        "publisher": {
          "@id": "https://rockcoveragecalculator.com/#organization"
        }
      },
      ...(hasBreadcrumb ? [{
        "@type": "BreadcrumbList",
        "@id": `${canonicalURL}#breadcrumb`,
        "itemListElement": breadcrumbItems.map((crumb, index) => ({
          "@type": "ListItem", "position": index + 1, "name": crumb.name,
          "item": new URL(crumb.url, siteUrl).href
        }))
      }] : [])
    ]
  })} />

  <!-- Early Theme Initialization (Light Mode by Default) -->
  <script is:inline>
    (function() {
      try {
        const savedTheme = localStorage.getItem('theme');
        const requestedTheme = location.pathname.replace(/\/$/, '') === '/embed' ? new URLSearchParams(location.search).get('theme') : null;
        const theme = requestedTheme === 'dark' || requestedTheme === 'light' ? requestedTheme : savedTheme || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    })();
  </script>
  <!-- Additional Head Elements (Page Schemas) -->
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <slot />
</body>
</html>
