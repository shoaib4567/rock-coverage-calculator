---

<section class="topic-cluster-section">
  <div class="container">
    <div class="cluster-header">
      <span class="badge-cluster">Quarry Knowledge Network</span>
      <h2>Related Landscape Rock Calculators</h2>
      <p>Explore specialized volumetric engines, rock grading tools, and unit conversion calculators tailored to your project requirements.</p>
    </div>

    <div class="cluster-columns">
      <!-- Material Calculators -->
      <div class="cluster-col">
        <div class="cluster-col-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M3 12h18"/></svg>
          <h3>Material-Specific Calculators</h3>
        </div>
        <div class="cluster-grid">
          {MATERIAL_CALCULATORS.map((item) => (
            <a 
              href={item.slug} 
              class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
            >
              <div class="cluster-icon" set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">${item.icon}</svg>`}></div>
              <div class="cluster-card-content">
                <div class="cluster-card-title-row">
                  <h4>{item.title}</h4>
                  <span class="cluster-tag">{item.density}</span>
                </div>
                <p>{item.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Quantity & Conversion Calculators -->
      <div class="cluster-col">
        <div class="cluster-col-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10v10H7z"/></svg>
          <h3>Quantity & Conversion Calculators</h3>
        </div>
        <div class="cluster-grid">
          {QUANTITY_CALCULATORS.map((item) => (
            <a 
              href={item.slug} 
              class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
            >
              <div class="cluster-icon" set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">${item.icon}</svg>`}></div>
              <div class="cluster-card-content">
                <div class="cluster-card-title-row">
                  <h4>{item.title}</h4>
                  <span class="cluster-tag alt">{item.metric}</span>
                </div>
                <p>{item.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .topic-cluster-section {
    padding: var(--space-12) 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cluster-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-10) auto;
  }

  .badge-cluster {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    background: rgba(212, 168, 83, 0.1);
    border: 1px solid rgba(212, 168, 83, 0.25);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .cluster-header h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .cluster-header p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .cluster-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
  }

  @media (max-width: 900px) {
    .cluster-columns {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .cluster-col-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-3);
  }

  .cluster-col-title h3 {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .cluster-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cluster-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .cluster-card:hover {
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .cluster-card.active-spoke {
    border-color: var(--accent-gold);
    background: rgba(212, 168, 83, 0.05);
    pointer-events: none;
  }

  .cluster-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-gold);
    margin-top: 2px;
  }

  .cluster-card-content {
    flex: 1;
    min-width: 0;
  }

  .cluster-card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: 3px;
  }

  .cluster-card-title-row h4 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .cluster-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(212, 168, 83, 0.15);
    color: var(--accent-gold);
    white-space: nowrap;
  }

  .cluster-tag.alt {
    background: rgba(139, 157, 168, 0.15);
    color: var(--text-secondary);
  }

  .cluster-card p {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }
</style>
