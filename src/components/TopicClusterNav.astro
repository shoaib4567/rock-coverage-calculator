    density: '1.40 t/yd³',
    icon: `<circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 17h14v-5l-3-4H8L5 12v5z"/>`
  },
  {
    title: 'Crushed Stone Calculator',
