---
import { relatedTools, type ToolLink } from '../lib/site-navigation';
interface Props { currentPage?: string; activePage?: string; category?: string; upLinks?: ToolLink[]; lateralLinks?: ToolLink[]; bridgeLinks?: ToolLink[]; supportGuides?: ToolLink[]; }
const route=Astro.props.currentPage || Astro.url.pathname.replace(/\/$/,'') || '/';
const {upLinks=[],lateralLinks=[],bridgeLinks=[],supportGuides=[]}=Astro.props;
const candidates=[...upLinks,...bridgeLinks,...supportGuides,...lateralLinks,...relatedTools(route)];
const seen=new Set<string>();
const links=candidates.filter(l=>l.slug!==route&&!seen.has(l.slug)&&seen.add(l.slug)).slice(0,8);
---
<nav class="topic-cluster-section" aria-label="Related calculators and guides">
 <div class="container related-tools">
  <h2>Continue planning your project</h2>
  <ul>{links.map(link=><li><a href={link.slug}>{link.title.replace(/\s*\((Pillar|Material Parent|Home|Conversion Hub|Quarry Weight|Pure Volume|Retail Bags)\)/g,'')}</a></li>)}</ul>
  <p><a href="/calculators">Browse all calculators and guides →</a></p>
 </div>
</nav>
<style>
 .topic-cluster-section{padding:var(--space-8) 0;border-top:1px solid var(--border-subtle);margin-top:var(--space-8)}
 .related-tools h2{font-size:var(--text-xl);margin:0 0 var(--space-4);color:var(--text-primary)}
 ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:var(--space-3)}
 a{color:var(--text-primary);text-decoration:underline;text-underline-offset:3px}li a{display:block;padding:var(--space-3);background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:var(--radius-md)}
 p{margin-top:var(--space-4)}a:focus-visible{outline:3px solid var(--gold-400);outline-offset:3px}
</style>
