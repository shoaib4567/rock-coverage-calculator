    slug: '/cobblestone-calculator',
    desc: 'Belgian blocks, granite cobbles, driveway aprons, border curbing, and unit counts.',
    density: '1.45 t/yd³',
    icon: `<rect x="3" y="4" width="8" height="6" rx="1"/><rect x="13" y="4" width="8" height="6" rx="1"/><rect x="7" y="14" width="10" height="6" rx="1"/>`
  },
