---
/**
 * TopicClusterNav Component - DWG 01 REV B
 * Implements the 4 link types: Up, Lateral, Bridge, Support.
 * Strict US Civil Engineering & Aggregate Standards. Zero en/em dashes.
 */
interface LinkItem {
  title: string;
  slug: string;
  desc?: string;
  badge?: string;
}

interface Props {
  currentPage: string;
  category?: 'material' | 'quantity' | 'guide';
  upLinks?: LinkItem[];
  lateralLinks?: LinkItem[];
  bridgeLinks?: LinkItem[];
  supportGuides?: LinkItem[];
}

const { 
  currentPage, 
  category = 'material',
  upLinks = [],
  lateralLinks = [],
  bridgeLinks = [],
  supportGuides = []
} = Astro.props;

const CORE_MATERIALS: LinkItem[] = [
  { title: 'Pea Gravel Calculator', slug: '/pea-gravel-calculator', badge: '1.35 t/yd³', desc: '3/8 inch rounded pea gravel for walkways, dog runs, and patio surfaces.' },
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: '1.35 t/yd³', desc: '1-3 inch and 3-5 inch smooth river rock for dry creek beds and borders.' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: '1.35-1.50 t/yd³', desc: 'ASTM D448 #57, #411, and dense graded aggregate for driveways and bases.' },
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: '1.40 t/yd³', desc: 'Driveway gravel, road gravel, and parking pad aggregate estimation.' },
  { title: 'Drain Rock Calculator', slug: '/drain-rock-calculator', badge: '1.35 t/yd³', desc: 'Washed #57 clean stone for French drains, weeping tile, and dry wells.' },
  { title: 'Decorative Rock Calculator', slug: '/decorative-rock-calculator', badge: '0.75-1.40 t/yd³', desc: 'Lava rock, marble chips, and architectural rock for xeriscaping.' },
  { title: 'Cobblestone Calculator', slug: '/cobblestone-calculator', badge: '1.45 t/yd³', desc: 'Belgian block cobbles, driveway aprons, and granite border curbing.' },
  { title: 'Landscape Rock Calculator', slug: '/landscape-rock-calculator', badge: '1.30 t/yd³', desc: 'Decorative bed coverage, shrub borders, and weed suppression stone.' },
  { title: 'Landscape Stone Calculator', slug: '/landscape-stone-calculator', badge: '1.40 t/yd³', desc: 'Compacted crushed stone base, walkway fines, and structural sub-base.' }
];

const EXPANSION_MATERIALS: LinkItem[] = [
  { title: 'Driveway Rock Calculator', slug: '/driveway-rock-calculator', badge: 'Driveways', desc: 'Two-layer driveway rock coverage calculator with 15% vehicular compaction.' },
  { title: 'Egg Rock Calculator', slug: '/egg-rock-calculator', badge: '1.35 t/yd³', desc: '1-2 inch and 2-3 inch smooth egg pebbles for decorative beds and modern mulch replacement.' },
  { title: 'Trap Rock Calculator', slug: '/trap-rock-calculator', badge: '1.52 t/yd³', desc: 'Dense igneous basalt and diabase aggregate for driveways, track ballast, and borders.' },
  { title: 'Garden Rock Calculator', slug: '/garden-rock-calculator', badge: 'Horticultural', desc: 'Decorative rock mulch estimator for flower beds, perennials, and garden borders.' },
  { title: 'Decomposed Granite Calculator', slug: '/decomposed-granite-calculator', badge: '1.25 t/yd³', desc: '1/4 inch minus with fines for compacted pathways, patios, and bocce courts.' },
  { title: 'Lava Rock Calculator', slug: '/lava-rock-calculator', badge: '0.75 t/yd³', desc: 'Lightweight volcanic scoria for garden beds, mulch replacement, and fire pits.' },
  { title: 'Marble Chips Calculator', slug: '/marble-chips-calculator', badge: '1.25 t/yd³', desc: 'Sparkling white crystalline dolomite rock for formal borders and tree wells.' },
  { title: 'Crushed Granite Calculator', slug: '/crushed-granite-calculator', badge: '1.40 t/yd³', desc: '3/4 inch fractured angular granite for heavy driveways and parking pads.' },
  { title: 'Riprap Calculator', slug: '/riprap-calculator', badge: '1.40 t/yd³', desc: '6-12 inch Class 1 erosion control rock for culverts, slopes, and shorelines.' },
  { title: 'Crusher Run Calculator', slug: '/crusher-run-calculator', badge: '1.45 t/yd³', desc: 'Dense graded aggregate (AASHTO M147) blending crushed stone and rock dust.' },
  { title: 'Beach Pebble Calculator', slug: '/beach-pebble-calculator', badge: '1.35 t/yd³', desc: 'Smooth Mexican beach pebbles for contemporary borders and planter tops.' }
];

const GENERIC_CONVERSIONS: LinkItem[] = [
  { title: 'Rock Coverage Calculator Yard', slug: '/rock-coverage-calculator-yard', badge: '27 cu ft / yd³', desc: 'Convert length, width, and depth into cubic yards for bulk ordering.' },
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: '2,000 lbs / ton', desc: 'Convert cubic volume into commercial scale weight using bulk density.' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: '0.5 cu ft bags', desc: 'Calculate retail 0.5 cu ft bags needed with bulk break-even cost analysis.' },
  { title: 'Rock Square Foot Calculator', slug: '/rock-square-foot-calculator', badge: 'sq ft coverage', desc: 'Calculate aggregate tons and cubic yards needed from known square footage.' },
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Truckload Sizing', desc: 'Estimate dump truck delivery payloads, axle weight limits, and settling margins.' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'Intent Hub', desc: 'Guided calculator matching your specific project type to depth and volume.' },
  { title: 'Rock Coverage Chart', slug: '/rock-coverage-chart', badge: 'Conversion Hub', desc: 'Interactive depth matrix showing square feet per yard and square feet per ton.' }
];

const MATERIAL_CONVERSIONS: LinkItem[] = [
  { title: 'River Rock Coverage Calculator', slug: '/river-rock-coverage-calculator', badge: 'Coverage Solver', desc: 'Calculate square foot coverage per ton and cubic yard for 1-3 inch and 3-5 inch river stone.' },
  { title: 'Gravel Tons Calculator', slug: '/gravel-tons-calculator', badge: 'Tons Solver', desc: 'Calculate exact quarry scale tons for crushed and driveway gravel.' },
  { title: 'Gravel Cubic Yards Calculator', slug: '/gravel-cubic-yard-calculator', badge: 'Yards Solver', desc: 'Calculate cubic yards of gravel needed for driveways and paths.' },
  { title: 'Gravel Bag Calculator', slug: '/gravel-bag-calculator', badge: 'Bag Solver', desc: 'Calculate 0.5 cu ft retail bags of gravel for small installations.' },
  { title: 'Crushed Stone Tons Calculator', slug: '/crushed-stone-tons-calculator', badge: 'Tons Solver', desc: 'Calculate tonnage for ASTM D448 #57, #4, and crusher run stone.' },
  { title: 'Crushed Stone Yardage Calculator', slug: '/crushed-stone-yardage-calculator', badge: 'Delivery Sizing', desc: 'Calculate cubic yards and dump truck loads for crushed stone delivery.' },
  { title: 'Crushed Stone Bag Calculator', slug: '/crushed-stone-bag-calculator', badge: 'Bag Solver', desc: 'Calculate 0.5 cu ft bags of #57 stone for pads, post holes, and drains.' },
  { title: 'River Rock Tons Calculator', slug: '/river-rock-tons-calculator', badge: 'Tons Solver', desc: 'Determine quarry scale weight for 1-3 inch and 3-5 inch river stone.' },
  { title: 'River Rock Cubic Yard Calculator', slug: '/river-rock-cubic-yard-calculator', badge: 'Yards Solver', desc: 'Calculate cubic yards of river rock for beds and dry creek channels.' },
  { title: 'River Rock Bag Calculator', slug: '/river-rock-bag-calculator', badge: 'Bag Solver', desc: 'Calculate 0.5 cu ft bags of river rock for garden borders and accents.' },
  { title: 'Pea Gravel Patio Calculator', slug: '/pea-gravel-patio-calculator', badge: 'Patio Solver', desc: 'Calculate 4-inch base and 2-inch pea stone surface requirements for patios.' },
  { title: 'Pea Gravel Tons Calculator', slug: '/pea-gravel-tons-calculator', badge: 'Tons Solver', desc: 'Determine quarry scale tonnage for ASTM D448 #8 pea stone.' },
  { title: 'Pea Gravel Cubic Yard Calculator', slug: '/pea-gravel-cubic-yard-calculator', badge: 'Yards Solver', desc: 'Calculate cubic yards of pea gravel needed for patios and pathways.' },
  { title: 'Pea Gravel Bag Calculator', slug: '/pea-gravel-bag-calculator', badge: 'Bag Solver', desc: 'Calculate 0.5 cu ft bags of pea gravel for patios and walkways.' },
  { title: 'Pea Gravel Coverage Calculator', slug: '/pea-gravel-coverage-calculator', badge: 'Coverage Solver', desc: 'Estimate square foot coverage per ton and cubic yard for 3/8 inch pea gravel.' },
  { title: 'Decomposed Granite Tons Calculator', slug: '/decomposed-granite-tons-calculator', badge: 'Tons Solver', desc: 'Calculate DG tonnage with 20% plate tamper compaction allowances.' },
  { title: 'Decomposed Granite Coverage Calculator', slug: '/decomposed-granite-coverage-calculator', badge: 'Coverage Solver', desc: 'Estimate compacted square foot coverage per ton and loose cubic yard.' },
  { title: 'Lava Rock Bag Calculator', slug: '/lava-rock-bag-calculator', badge: 'Bag Solver', desc: 'Calculate lightweight 0.5 cu ft bags of red or black volcanic scoria.' },
  { title: 'Lava Rock Coverage Calculator', slug: '/lava-rock-coverage-calculator', badge: 'Coverage Solver', desc: 'Calculate high-yield square footage for lightweight volcanic lava rock.' },
  { title: 'Marble Chips Bag Calculator', slug: '/marble-chips-bag-calculator', badge: 'Bag Solver', desc: 'Calculate 0.5 cu ft bags of sparkling white dolomite marble chips.' }
];

const SUPPORTING_GUIDES: LinkItem[] = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448', desc: 'Complete gradation envelope, sieve specs, and applications for #57 aggregate.' },
  { title: 'Gravel Size Chart Explained', slug: '/gravel-sizes', badge: 'AASHTO M43', desc: 'Standard aggregate size numbers from #1 down to #10 with sieve dimensions.' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech Guide', desc: 'Particle interlock, friction angles (40-45 deg), and structural load behavior.' },
  { title: 'How Deep Should Rock Be?', slug: '/rock-depth-guide', badge: 'Depth Rules', desc: 'Standard thickness guidelines by aggregate size and project application.' },
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Contractor Protocol', desc: 'Step by step site preparation, geotextile fabric, edging, and screeding.' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Analysis', desc: 'Economic break-even point between 0.5 cu ft bags and bulk quarry truckloads.' },
  { title: 'Dry Creek Bed Guide', slug: '/dry-creek-bed', badge: 'Drainage Design', desc: 'Sizing channels, parabolic cross-sections, and placing river rock and riprap.' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29', desc: 'Calibrated bulk density table with loose stockpile unit weights and moisture ranges.' }
];

const hasContextLinks = upLinks.length > 0 || lateralLinks.length > 0 || bridgeLinks.length > 0 || supportGuides.length > 0;
---

<section class="topic-cluster-section" aria-label="Topic Cluster and Knowledge Network">
  <div class="container">
    
    {hasContextLinks && (
      <div class="context-links-wrapper">
        <div class="context-header">
          <span class="badge-cluster">Project Navigation</span>
          <h2>Related Calculation Tools and Field Guides</h2>
          <p>Navigate directly to companion calculators, complementary units, and technical engineering guides for this project.</p>
        </div>

        <div class="context-grid">
          {upLinks.length > 0 && (
            <div class="context-card">
              <div class="context-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
                <h3>Parent Calculators (Up)</h3>
              </div>
              <ul class="context-list">
                {upLinks.map((link) => (
                  <li>
                    <a href={link.slug} class="context-link">
                      <span class="link-name">{link.title}</span>
                      {link.badge && <span class="link-badge">{link.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {lateralLinks.length > 0 && (
            <div class="context-card">
              <div class="context-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <h3>Alternative Materials (Lateral)</h3>
              </div>
              <ul class="context-list">
                {lateralLinks.map((link) => (
                  <li>
                    <a href={link.slug} class="context-link">
                      <span class="link-name">{link.title}</span>
                      {link.badge && <span class="link-badge">{link.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {bridgeLinks.length > 0 && (
            <div class="context-card">
              <div class="context-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
                <h3>Units and Conversions (Bridge)</h3>
              </div>
              <ul class="context-list">
                {bridgeLinks.map((link) => (
                  <li>
                    <a href={link.slug} class="context-link">
                      <span class="link-name">{link.title}</span>
                      {link.badge && <span class="link-badge">{link.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {supportGuides.length > 0 && (
            <div class="context-card highlight">
              <div class="context-card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <h3>Engineering Guides (Support)</h3>
              </div>
              <ul class="context-list">
                {supportGuides.map((link) => (
                  <li>
                    <a href={link.slug} class="context-link">
                      <span class="link-name">{link.title}</span>
                      {link.badge && <span class="link-badge guide">{link.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Complete Directory Section -->
    <div class="directory-wrapper">
      <div class="cluster-header">
        <span class="badge-cluster">Quarry Knowledge Network</span>
        <h2>Complete Landscape Aggregate Calculator Library</h2>
        <p>Explore all 41 specialized volumetric engines, rock grading tools, unit conversion calculators, and civil engineering guides.</p>
      </div>

      <div class="cluster-columns-three">
        <!-- Column 1: Material Calculators -->
        <div class="cluster-col">
          <div class="cluster-col-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M3 12h18"/></svg>
            <h3>Material Calculators ({CORE_MATERIALS.length + EXPANSION_MATERIALS.length})</h3>
          </div>
          <div class="cluster-subhead">Core Landscape Rocks</div>
          <div class="cluster-grid">
            {CORE_MATERIALS.map((item) => (
              <a 
                href={item.slug} 
                class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
              >
                <div class="cluster-card-content">
                  <div class="cluster-card-title-row">
                    <h4>{item.title}</h4>
                    <span class="cluster-tag">{item.badge}</span>
                  </div>
                  <p>{item.desc}</p>
                </div>
              </a>
            ))}
          </div>

          <div class="cluster-subhead mt-4">Specialty and Base Aggregates</div>
          <div class="cluster-grid">
            {EXPANSION_MATERIALS.map((item) => (
              <a 
                href={item.slug} 
                class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
              >
                <div class="cluster-card-content">
                  <div class="cluster-card-title-row">
                    <h4>{item.title}</h4>
                    <span class="cluster-tag alt">{item.badge}</span>
                  </div>
                  <p>{item.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Column 2: Conversion Calculators -->
        <div class="cluster-col">
          <div class="cluster-col-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10v10H7z"/></svg>
            <h3>Conversion Calculators ({GENERIC_CONVERSIONS.length + MATERIAL_CONVERSIONS.length})</h3>
          </div>
          <div class="cluster-subhead">Generic Volume and Weight</div>
          <div class="cluster-grid">
            {GENERIC_CONVERSIONS.map((item) => (
              <a 
                href={item.slug} 
                class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
              >
                <div class="cluster-card-content">
                  <div class="cluster-card-title-row">
                    <h4>{item.title}</h4>
                    <span class="cluster-tag alt">{item.badge}</span>
                  </div>
                  <p>{item.desc}</p>
                </div>
              </a>
            ))}
          </div>

          <div class="cluster-subhead mt-4">Material Specific Conversions</div>
          <div class="cluster-grid">
            {MATERIAL_CONVERSIONS.map((item) => (
              <a 
                href={item.slug} 
                class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
              >
                <div class="cluster-card-content">
                  <div class="cluster-card-title-row">
                    <h4>{item.title}</h4>
                    <span class="cluster-tag">{item.badge}</span>
                  </div>
                  <p>{item.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Column 3: Supporting Engineering Guides -->
        <div class="cluster-col">
          <div class="cluster-col-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <h3>Engineering Guides ({SUPPORTING_GUIDES.length})</h3>
          </div>
          <div class="cluster-subhead">Standards and Best Practices</div>
          <div class="cluster-grid">
            {SUPPORTING_GUIDES.map((item) => (
              <a 
                href={item.slug} 
                class={`cluster-card ${currentPage === item.slug ? 'active-spoke' : ''}`}
              >
                <div class="cluster-card-content">
                  <div class="cluster-card-title-row">
                    <h4>{item.title}</h4>
                    <span class="cluster-tag guide">{item.badge}</span>
                  </div>
                  <p>{item.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .topic-cluster-section {
    padding: var(--space-12) 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .badge-cluster {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    background: rgba(212, 168, 83, 0.1);
    border: 1px solid rgba(212, 168, 83, 0.25);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .cluster-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-8) auto;
  }

  .cluster-header h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .cluster-header p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Context Links Section */
  .context-links-wrapper {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px dashed var(--border-subtle);
  }

  .context-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-6) auto;
  }

  .context-header h2 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .context-header p {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .context-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .context-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .context-card.highlight {
    border-color: rgba(212, 168, 83, 0.35);
    background: rgba(212, 168, 83, 0.03);
  }

  .context-card-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-2);
  }

  .context-card-title h3 {
    font-size: var(--text-sm);
    font-weight: 700;
    margin: 0;
  }

  .context-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .context-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: all var(--transition-fast);
  }

  .context-link:hover {
    border-color: var(--accent-gold);
    transform: translateX(2px);
  }

  .link-name {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
  }

  .link-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    background: rgba(212, 168, 83, 0.15);
    color: var(--accent-gold);
    white-space: nowrap;
  }

  .link-badge.guide {
    background: rgba(80, 160, 240, 0.15);
    color: #50a0f0;
  }

  /* Three Column Directory */
  .cluster-columns-three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 1024px) {
    .cluster-columns-three {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .cluster-col-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-2);
  }

  .cluster-col-title h3 {
    font-size: var(--text-base);
    font-weight: 700;
    margin: 0;
  }

  .cluster-subhead {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: var(--space-3) 0 var(--space-2) 0;
  }

  .mt-4 {
    margin-top: var(--space-4);
  }

  .cluster-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cluster-card {
    display: flex;
    align-items: flex-start;
    padding: var(--space-2) var(--space-3);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
