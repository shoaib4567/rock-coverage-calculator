    icon: `<path d="M4 18h16l-3-10H7L4 18z"/><circle cx="10" cy="11" r="1.5"/><path d="M14 11l3 4"/>`
  },
  {
    title: 'River Rock Calculator',
    slug: '/river-rock-calculator',
    desc: '1-3", 2", and 3/4" rounded alluvial stone for swales, dry creeks, and splash basins.',
    density: '1.35 t/yd³',
    icon: `<ellipse cx="12" cy="12" rx="9" ry="6"/><ellipse cx="12" cy="12" rx="4" ry="2.5" opacity="0.5"/>`
  },
  {
    title: 'Decorative Rock Calculator',
    slug: '/decorative-rock-calculator',
    desc: 'Xeriscapes, lava rock, white marble, and premium architectural landscape accents.',
    density: '0.70-1.40 t/yd³',
    icon: `<polygon points="12,2 22,8.5 22,15.5 12,22 2,15.5 2,8.5"/><polyline points="2,8.5 12,15.5 22,8.5"/><line x1="12" y1="15.5" x2="12" y2="22"/>`
