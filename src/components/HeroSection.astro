---
/**
 * HeroSection Component - rockcoveragecalculator.com
 * Catchy, problem-solving, answerable headline and instant contractor rule.
 * Emotional & professional touch: eliminates the fear of running short or overpaying.
 */
---
<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="hero-gradient"></div>
    <div class="hero-particles" aria-hidden="true">
      {Array.from({length: 20}).map((_, i) => (
        <div class="rock-particle" style={`left: ${5 + (i * 4.7) % 90}%; bottom: ${(i * 3.3) % 30}%; animation-delay: ${(i * 0.2) % 3}s; animation-duration: ${2.5 + (i * 0.15) % 2}s; opacity: ${0.2 + (i * 0.03) % 0.4}`}></div>
      ))}
    </div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2L4 7.5V16.5L12 22L20 16.5V7.5L12 2Z"/>
      </svg>
      <span>Quarry-Calibrated Aggregate Estimator</span>
    </div>

    <h1 class="hero-title">
      Rock Coverage <span class="text-gold">Calculator</span>
    </h1>

    <p class="hero-subtitle">
      Never run short. Never overpay. Calculate exact cubic yards, tons, and bags for gravel, stone, and aggregate projects with quarry-grade precision before ordering.
    </p>

    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-value">12</span>
        <span class="hero-stat-label">Rock Types</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-value">6</span>
        <span class="hero-stat-label">Area Shapes</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-value">3D</span>
        <span class="hero-stat-label">Visualizer</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="hero-stat-value">ASTM</span>
        <span class="hero-stat-label">Calibrated</span>
      </div>
    </div>

    <div class="hero-cta-group">
      <a href="#calculator" class="hero-cta">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="3"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="9" y1="3" x2="9" y2="21"/>
        </svg>
        <span>Calculate My Project</span>
      </a>
      <a href="#rock-coverage-guide" class="hero-secondary-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span>View Density Guide</span>
      </a>
    </div>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M7 13l5 5 5-5"/>
      <path d="M7 7l5 5 5-5" opacity="0.4"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: var(--space-20) 0 var(--space-16);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(212, 168, 83, 0.12) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 20% 60%, rgba(106, 143, 170, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 60%, rgba(212, 168, 83, 0.06) 0%, transparent 60%);
  }

  .rock-particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--gold-500);
    border-radius: 50%;
    filter: blur(1px);
    animation: floatUp 4s infinite ease-in-out;
  }

  @keyframes floatUp {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.2; }
    50% { transform: translateY(-20px) rotate(180deg); opacity: 0.6; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--gold-glow);
    border: 1px solid rgba(212, 168, 83, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-6);
  }

  .hero-badge svg {
    color: var(--gold-500);
  }

  .hero-title {
    font-size: clamp(2.1rem, 5.5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin-bottom: var(--space-5);
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 1.4vw, 1.125rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 680px;
    margin: 0 auto var(--space-6);
  }


  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .hero-stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .hero-stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .hero-stat-divider {
    width: 1px;
    height: 28px;
    background: var(--slate-700);
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-8);
    background: linear-gradient(135deg, var(--gold-500), var(--gold-600));
    color: var(--text-inverse);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-gold);
    transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(212, 168, 83, 0.35);
    color: var(--text-inverse);
  }

  .hero-secondary-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    background: var(--surface-overlay);
    border: 1px solid var(--surface-glass-border);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-md);
    transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
  }

  .hero-secondary-cta:hover {
    background: var(--slate-700);
    border-color: var(--slate-500);
    color: var(--text-primary);
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-muted);
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 75vh;
      padding: var(--space-12) 0 var(--space-8);
    }

    .hero-stats {
      gap: var(--space-3);
    }

    .hero-stat-value {
      font-size: 1.15rem;
    }
  }
</style>
