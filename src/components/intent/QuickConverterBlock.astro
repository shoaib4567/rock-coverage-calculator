---
// Rapid Unit Conversion & Lookup Matrix Block
---
<section class="quick-converter-section">
  <div class="container">
    <div class="converter-card">
      <div class="converter-header">
        <div class="converter-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <polyline points="17 1 21 5 17 9"></polyline>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
            <polyline points="7 23 3 19 7 15"></polyline>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
          </svg>
        </div>
        <div>
          <span class="converter-badge">Instant Unit Equivalents</span>
          <h3>Quarry Scale, Volume & Bag Conversion Matrix</h3>
        </div>
      </div>

      <div class="conversion-matrix-grid">
        <div class="matrix-card">
          <div class="matrix-title">1 Cubic Yard (27 cu ft)</div>
          <div class="matrix-val">≈ 1.35 Short Tons</div>
          <div class="matrix-sub">2,700 lbs standard loose quarry weight</div>
          <div class="matrix-equiv">Equals <strong>54 bags</strong> (0.5 cu ft retail bags)</div>
        </div>

        <div class="matrix-card highlight">
          <div class="matrix-title">1 Short Ton (2,000 lbs)</div>
          <div class="matrix-val">≈ 0.74 Cubic Yards</div>
          <div class="matrix-sub">20.0 cu ft loose volume @ 1.35 t/yd³</div>
          <div class="matrix-equiv">Equals <strong>40 bags</strong> (0.5 cu ft retail bags)</div>
        </div>

        <div class="matrix-card">
          <div class="matrix-title">1 Retail Bag (0.5 cu ft)</div>
          <div class="matrix-val">≈ 50 – 52 lbs</div>
          <div class="matrix-sub">0.0185 cubic yards per bag</div>
          <div class="matrix-equiv">Covers <strong>2.0 sq ft</strong> at 3" installed depth</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .quick-converter-section {
    padding: var(--space-6) 0 var(--space-8) 0;
  }

  .converter-card {
    background: var(--bg-card);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .converter-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .converter-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #fbbf24;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .converter-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fbbf24;
    margin-bottom: 2px;
  }

  .converter-header h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .conversion-matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 860px) {
    .conversion-matrix-grid {
      grid-template-columns: 1fr;
    }
  }

  .matrix-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .matrix-card:hover {
    border-color: rgba(245, 158, 11, 0.4);
    transform: translateY(-2px);
  }

  .matrix-card.highlight {
    border-color: rgba(245, 158, 11, 0.5);
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.08) 0%, var(--bg-surface) 100%);
  }

  .matrix-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .matrix-val {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 800;
    color: #fbbf24;
    margin-bottom: 2px;
  }

  .matrix-sub {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .matrix-equiv {
    font-size: 12px;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-2);
  }

  .matrix-equiv strong {
    color: var(--text-primary);
  }
</style>
