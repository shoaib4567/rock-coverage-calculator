---
import IconRock from './icons/IconRock.astro';
---
<header class="site-header no-print">
  <div class="container">
    <nav class="header-nav">
      <a href="/" class="header-logo" aria-label="Rock Coverage Calculator Home">
        <IconRock size={28} class="logo-icon" />
        <span class="logo-text">
          <span class="logo-primary">Rock Coverage</span>
          <span class="logo-secondary">Calculator</span>
        </span>
      </a>
      <div class="header-actions">
        <div class="header-links">
          <a href="/#calculator" class="nav-link">Calculator</a>
          
          <div class="nav-dropdown-wrapper">
            <button class="nav-link dropdown-toggle" aria-haspopup="true">
              Materials
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="nav-dropdown-menu">
              <a href="/landscape-rock-calculator" class="dropdown-item">Landscape Rock Calculator</a>
              <a href="/river-rock-calculator" class="dropdown-item">River Rock Calculator</a>
              <a href="/decorative-rock-calculator" class="dropdown-item">Decorative Rock Calculator</a>
              <a href="/drain-rock-calculator" class="dropdown-item">Drain Rock Calculator</a>
              <a href="/cobblestone-calculator" class="dropdown-item">Cobblestone Calculator</a>
              <a href="/landscape-stone-calculator" class="dropdown-item">Landscape Stone Calculator</a>
              <a href="/gravel-calculator" class="dropdown-item">Gravel Calculator</a>
              <a href="/crushed-stone-calculator" class="dropdown-item">Crushed Stone Calculator</a>
              <a href="/pea-gravel-calculator" class="dropdown-item">Pea Gravel Calculator</a>
            </div>
          </div>

          <div class="nav-dropdown-wrapper">
            <button class="nav-link dropdown-toggle" aria-haspopup="true">
              Calculators & Tools
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="nav-dropdown-menu">
              <a href="/how-much-rock-do-i-need" class="dropdown-item">How Much Rock Do I Need?</a>
              <a href="/rock-calculator" class="dropdown-item">Rock Calculator</a>
              <a href="/rock-coverage-chart" class="dropdown-item">Rock Coverage Chart</a>
              <a href="/rock-coverage-calculator-yard" class="dropdown-item">Cubic Yard Calculator</a>
              <a href="/rock-tons-calculator" class="dropdown-item">Tons Calculator</a>
              <a href="/rock-bag-calculator" class="dropdown-item">Bag Calculator</a>
              <a href="/rock-square-foot-calculator" class="dropdown-item">Square Foot Calculator</a>
              <a href="/rock-yardage-calculator" class="dropdown-item">Yardage Calculator</a>
            </div>
          </div>

          <a href="/#rock-coverage-guide" class="nav-link">Guide</a>
          <a href="/#visualizer" class="nav-link">3D Preview</a>
          <a href="/about" class="nav-link">About</a>
          <a href="/contact" class="nav-link">Contact</a>
        </div>
        <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle light or dark mode" title="Toggle Light/Dark Theme">
          <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function() {
    function setupThemeToggle() {
      const btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const target = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', target);
        try {
          localStorage.setItem('theme', target);
        } catch (e) {}
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupThemeToggle);
    } else {
      setupThemeToggle();
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-overlay);
    background: var(--surface-glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--surface-glass-border);
    transition: background-color var(--duration-base) var(--ease-smooth), border-color var(--duration-base) var(--ease-smooth);
  }

  :global(html[data-theme="light"]) .site-header,
  :global([data-theme="light"]) .site-header {
    background: rgba(255, 255, 255, 0.96) !important;
    border-bottom: 1px solid rgba(148, 163, 184, 0.35) !important;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
  }

  :global(html[data-theme="light"]) .site-header .logo-primary,
  :global([data-theme="light"]) .site-header .logo-primary {
    color: #0f172a !important;
  }

  :global(html[data-theme="light"]) .site-header .logo-secondary,
  :global([data-theme="light"]) .site-header .logo-secondary {
    color: #64748b !important;
  }

  :global(html[data-theme="light"]) .site-header .nav-link,
  :global([data-theme="light"]) .site-header .nav-link {
    color: #334155 !important;
  }

  :global(html[data-theme="light"]) .site-header .nav-link:hover,
  :global([data-theme="light"]) .site-header .nav-link:hover {
    color: #0f172a !important;
  }

  :global(html[data-theme="light"]) .theme-toggle-btn,
  :global([data-theme="light"]) .theme-toggle-btn {
    background: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) 0;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
    transition: opacity 150ms ease;
  }

  .header-logo:hover {
    opacity: 0.85;
    color: var(--text-primary);
  }

  .logo-icon {
    color: var(--gold-400);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-primary {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .logo-secondary {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .header-links {
    display: flex;
    gap: var(--space-6);
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--surface-overlay);
    border: 1px solid var(--surface-glass-border);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-smooth);
    flex-shrink: 0;
  }

  .theme-toggle-btn:hover {
    color: var(--gold-400);
    border-color: var(--gold-500);
  }

  /* Sun/Moon Toggle Logic */
  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  :global([data-theme="light"]) .sun-icon {
    display: none;
  }

  :global([data-theme="light"]) .moon-icon {
    display: block;
  }

  .nav-link {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) 0;
    position: relative;
    transition: color 150ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gold-500);
    border-radius: 1px;
    transition: width 250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-dropdown-wrapper {
    position: relative;
    display: inline-block;
  }

  .dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .dropdown-toggle svg {
    transition: transform var(--duration-fast) var(--ease-smooth);
  }

  .nav-dropdown-wrapper:hover .dropdown-toggle svg {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 230px;
    background: var(--surface-overlay);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--surface-glass-border);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    padding: var(--space-2) 0;
    display: none;
    flex-direction: column;
    z-index: 100;
  }

  :global(html[data-theme="light"]) .nav-dropdown-menu {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12) !important;
  }

  .nav-dropdown-wrapper:hover .nav-dropdown-menu,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-menu {
    display: flex;
  }

  .dropdown-item {
    padding: var(--space-2) var(--space-4);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-smooth);
  }

  .dropdown-item:hover {
    color: var(--gold-400);
    background: rgba(212, 168, 83, 0.08);
  }

  :global(html[data-theme="light"]) .dropdown-item {
    color: #334155 !important;
  }

  :global(html[data-theme="light"]) .dropdown-item:hover {
    color: #0f172a !important;
    background: #f1f5f9 !important;
  }

  @media (max-width: 768px) {
    .header-links {
      gap: var(--space-3);
    }

    .nav-link {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 640px) {
    .header-links {
      display: none;
    }

    .logo-primary {
      font-size: 0.825rem;
    }
  }
</style>
