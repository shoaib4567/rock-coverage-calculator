---

---
<section class="section no-print" id="visualizer">
  <div class="container">
    <div class="section-header">
      <h2>Visual Project Preview</h2>
      <div class="section-divider"></div>
      <p>See your rock coverage calculation come to life with interactive 3D visualization, top-down blueprint, and depth cross-section.</p>
    </div>

    <div class="viz-grid">
      <!-- 3D Rock Scene -->
      <div class="viz-card viz-3d animate-fade-in-up">
        <div class="viz-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          <h3>3D Rock Pile</h3>
          <span class="viz-badge">Interactive</span>
        </div>
        <div class="rock-scene-wrapper" id="rock-scene-canvas" role="region" aria-label="3D Rock Bed Visualizer">
          <div class="rock-scene-fallback">
            <svg class="fallback-icon" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M12 2L4 7.5V16.5L12 22L20 16.5V7.5L12 2Z"/>
              <path d="M12 2L12 10"/><path d="M12 10L20 7.5"/><path d="M12 10L4 7.5"/>
            </svg>
            <span class="fallback-title">Loading 3D scene…</span>
            <span class="fallback-sub">Interactive simulation loads automatically as you scroll into view</span>
          </div>
        </div>
      </div>

      <!-- Blueprint SVG -->
      <div class="viz-card animate-fade-in-up animate-delay-1">
        <div class="viz-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9" opacity="0.3"/><line x1="9" y1="3" x2="9" y2="21" opacity="0.3"/></svg>
          <h3>Top-Down Blueprint</h3>
        </div>
        <div class="blueprint-container" id="blueprint-container">
          <!-- Rendered by visualizer.js -->
        </div>
      </div>

      <!-- Cross-Section -->
      <div class="viz-card animate-fade-in-up animate-delay-2">
        <div class="viz-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M3 17h18" opacity="0.4"/></svg>
          <h3>Depth Cross-Section</h3>
        </div>
        <div class="cross-section-container" id="cross-section-container">
          <!-- Rendered by visualizer.js -->
        </div>
      </div>

      <!-- Coverage Chart -->
      <div class="viz-card animate-fade-in-up animate-delay-3">
        <div class="viz-card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M7 17l4-8 4 4 5-10"/></svg>
          <h3>Depth vs. Volume Chart</h3>
        </div>
        <div class="chart-container">
          <canvas id="coverage-chart" style="width:100%; height:200px;"></canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .viz-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .viz-3d {
    grid-column: 1 / -1;
  }

  .viz-card {
    background: var(--surface-raised);
    border: 1px solid var(--surface-glass-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .viz-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--surface-glass-border);
  }

  .viz-card-header svg {
    color: var(--gold-400);
    flex-shrink: 0;
  }

  .viz-card-header h3 {
    font-size: 0.825rem;
    font-weight: 700;
  }

  .viz-badge {
    margin-left: auto;
    padding: 2px 8px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--river-teal);
    background: rgba(74,158,142,0.1);
    border: 1px solid rgba(74,158,142,0.2);
    border-radius: var(--radius-full);
  }

  @media (max-width: 768px) {
    .viz-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
