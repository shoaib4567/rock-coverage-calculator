---
import { ROCK_MATERIALS, getMaterialById } from '../scripts/materials-data.js';
const pea = getMaterialById('pea-gravel');
const lava = getMaterialById('lava-rock');
const faqs = [
  {
    question: "How many cubic yards of rock do I need?",
    answer: "Multiply square feet by depth in inches, then divide by 324. A 200 sq ft area at 3 inches needs 1.85 cubic yards before extra material. The calculator first finds the area of your selected shape, then applies the depth and allowance."
  },
  {
    question: "How much does a cubic yard of rock weigh?",
    answer: `It varies by material and supplier. This calculator starts at ${pea.tonsPerCuYd} short tons per cubic yard for pea gravel and ${lava.tonsPerCuYd} for lava rock, across ${ROCK_MATERIALS.length} selectable materials. These are planning factors; enter your supplier's loose bulk density for a better weight estimate.`
  },
  {
    question: "How deep should landscape rock be?",
    answer: "Choose a finished layer depth that suits the stone size and the job. A small decorative rock bed may start around 2 to 3 inches, but larger stone and structural layers need different designs. The calculator flags depths below its material-specific starting value; a project specification or supplier should guide construction work."
  },
  {
    question: "How many bags of rock do I need?",
    answer: "For bags labeled 0.5 cubic foot, divide the total cubic feet by 0.5 and round up: one cubic yard takes 54 bags. Check the package yield because bag sizes vary. Bag count follows volume, so changing the density input changes tonnage but not the number of volume-labeled bags."
  },
  {
    question: "What is the difference between cubic yards and tons?",
    answer: "Cubic yards measure space; short tons measure weight. Multiply cubic yards by the material's loose tons-per-yard factor to estimate weight. Suppliers may sell by either unit, so confirm the quote unit and conversion they use."
  },
  {
    question: "Should I add extra rock for waste and settling?",
    answer: "An allowance can cover irregular edges, low spots, and measurement uncertainty. The default is an editable 10%, not a guarantee. For a compacted base with fines, the optional separate compaction factor adds loose material to reach the planned finished layer."
  },
  {
    question: "How do I calculate rock for a circular area?",
    answer: "Use the formula: Area = pi x radius x radius. Measure the radius (half the diameter) of your circular bed. Our calculator handles circles, rings (donut shapes, like around a fire pit), and four other shapes. Simply select the Circle tab, enter your radius, and the calculator does the rest."
  },
  {
    question: "What is the most cost-effective way to buy rock?",
    answer: "Compare the total price for the same volume or weight, including bag yield, bulk minimum, delivery, and access. Bags can be simpler for a small repair, while bulk may suit a larger area. Check your vehicle payload before pickup."
  }
];
---
<section class="section" id="faq">
  <div class="container container-narrow">
    <div class="section-header">
      <h2>Frequently Asked Questions</h2>
      <div class="section-divider"></div>
      <p>Common questions about calculating rock coverage for landscaping and construction projects.</p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, i) => (
        <div class="faq-item animate-fade-in-up" style={`animation-delay: ${i * 0.05}s`}>
          <button class="faq-question" id={`faq-question-${i}`} aria-expanded="false" aria-controls={`faq-answer-${i}`}>
            <span>{faq.question}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq-answer" id={`faq-answer-${i}`} role="region" aria-labelledby={`faq-question-${i}`} hidden>
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ Schema -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
})} />

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--surface-raised);
    border: 1px solid var(--surface-glass-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 200ms ease;
  }

  .faq-item:hover {
    border-color: var(--slate-600);
  }

  .faq-item.open {
    border-color: var(--gold-500);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text-primary);
    text-align: left;
    cursor: pointer;
    transition: color 150ms ease;
    background: none;
    border: none;
  }

  .faq-question:hover {
    color: var(--gold-400);
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1), color 150ms ease;
  }

  .faq-item.open .faq-chevron {
    transform: rotate(180deg);
    color: var(--gold-400);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 400ms cubic-bezier(0.4, 0, 0.2, 1), padding 400ms cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0 var(--space-6);
  }

  .faq-item.open .faq-answer {
    max-height: 400px;
    padding: 0 var(--space-6) var(--space-6);
  }

  .faq-answer p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.8;
    border-top: 1px solid var(--surface-glass-border);
    padding-top: var(--space-4);
  }
</style>

<script>
  function setupFaq() {
    document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
      const button = item.querySelector<HTMLButtonElement>('.faq-question');
      const answer = item.querySelector<HTMLElement>('.faq-answer');
      if (!button || !answer || button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isOpen));
        item.classList.toggle('open', !isOpen);
        answer.hidden = isOpen;
      });
    });
  }

  document.addEventListener('astro:page-load', setupFaq);
  setupFaq();
</script>
