---
import IconRock from './icons/IconRock.astro';
---
<footer class="site-footer no-print">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <IconRock size={22} class="footer-icon" />
          <span>Rock Coverage Calculator</span>
        </div>
        <p class="footer-tagline">
          The contractor's go-to tool for calculating rock, gravel, and stone coverage. Built for precision and field-ready accuracy.
        </p>
      </div>
      <div class="footer-col">
        <h4>Material Calculators</h4>
        <ul>
          <li><a href="/landscape-rock-calculator">Landscape Rock Calculator</a></li>
          <li><a href="/river-rock-calculator">River Rock Calculator</a></li>
          <li><a href="/decorative-rock-calculator">Decorative Rock Calculator</a></li>
          <li><a href="/drain-rock-calculator">Drain Rock Calculator</a></li>
          <li><a href="/cobblestone-calculator">Cobblestone Calculator</a></li>
          <li><a href="/landscape-stone-calculator">Landscape Stone Calculator</a></li>
          <li><a href="/gravel-calculator">Gravel Calculator</a></li>
          <li><a href="/crushed-stone-calculator">Crushed Stone Calculator</a></li>
          <li><a href="/pea-gravel-calculator">Pea Gravel Calculator</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Calculators & Tools</h4>
        <ul>
          <li><a href="/how-much-rock-do-i-need">How Much Rock Do I Need?</a></li>
          <li><a href="/rock-calculator">Rock Calculator</a></li>
          <li><a href="/rock-coverage-chart">Rock Coverage Chart</a></li>
          <li><a href="/rock-cubic-yard-calculator">Rock Cubic Yard Calculator</a></li>
          <li><a href="/rock-tons-calculator">Rock Tons Calculator</a></li>
          <li><a href="/rock-bag-calculator">Rock Bag Calculator</a></li>
          <li><a href="/rock-square-foot-calculator">Rock Square Foot Calculator</a></li>
          <li><a href="/rock-yardage-calculator">Rock Yardage Calculator</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Engineering Resources</h4>
        <ul>
          <li><a href="/about">About & Engineering Standards</a></li>
          <li><a href="/#rock-coverage-guide">Aggregate Coverage Guide</a></li>
          <li><a href="/#density-reference-table">Aggregate Density Table</a></li>
          <li><a href="/#depth-guidelines">Depth Sizing Standards</a></li>
          <li><a href="/#how-it-works">How We Calculate</a></li>
          <li><a href="/#faq">Quarry & Contractor FAQ</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-legal-links">
        <span>&copy; {new Date().getFullYear()} rockcoveragecalculator.com</span>
        <span aria-hidden="true">&bull;</span>
        <a href="/about" style="color: inherit; text-decoration: underline;">About & ASTM Standards</a>
        <span aria-hidden="true">&bull;</span>
        <span>ASTM C29/C29M &amp; AASHTO T 19 Calibrated</span>
        <span aria-hidden="true">&bull;</span>
        <span>US Customary Units (Cubic Yards &amp; Short Tons)</span>
      </div>
      <p class="footer-disclaimer">
        Disclaimer: Calculations provide jobsite estimates based on nominal loose stockpile bulk densities. Actual quarry weights vary by regional geology, moisture content, and compaction methods. Always verify certified scale weights with your local material supplier before placing bulk orders.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-legal-links {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .footer-disclaimer {
    font-size: 0.725rem;
    color: var(--text-muted);
    opacity: 0.75;
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.5;
  }
  .site-footer {
    background: var(--slate-950);
    border-top: 1px solid rgba(107,122,141,0.1);
    padding: var(--space-16) 0 var(--space-8);
    margin-top: var(--space-20);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-10);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .footer-icon {
    color: var(--gold-400);
  }

  .footer-tagline {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-col h4 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-col a {
    font-size: 0.825rem;
    color: var(--text-muted);
    transition: color 150ms ease;
  }

  .footer-col a:hover {
    color: var(--gold-400);
  }

  .footer-bottom {
    border-top: 1px solid rgba(107,122,141,0.1);
    padding-top: var(--space-6);
  }

  .footer-bottom p {
    font-size: 0.725rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
