---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface EntityTag {
  label: string;
  value: string;
}

interface QuickStat {
  label: string;
  value: string;
  desc: string;
}

interface Props {
  title: string;
  highlightWord?: string;
  subtitle: string;
  badge: string;
  breadcrumbs: BreadcrumbItem[];
  entityTags?: EntityTag[];
  quickStats?: QuickStat[];
}

const {
  title,
  highlightWord,
  subtitle,
  badge,
  breadcrumbs,
  entityTags = [],
  quickStats = []
} = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <!-- Breadcrumb Navigation with Semantic Microdata -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol itemscope itemtype="https://schema.org/BreadcrumbList">
        {breadcrumbs.map((crumb, idx) => (
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {idx > 0 && <span class="crumb-separator">/</span>}
            {idx === breadcrumbs.length - 1 ? (
              <span itemprop="name" class="crumb-current" aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.url} itemprop="item" class="crumb-link">
                <span itemprop="name">{crumb.name}</span>
              </a>
            )}
            <meta itemprop="position" content={String(idx + 1)} />
          </li>
        ))}
      </ol>
    </nav>

    <!-- Main Header -->
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>{badge}</span>
      </div>

      <h1>
        {highlightWord ? (
          <>
            {title.replace(highlightWord, '').trim()}{' '}
            <span class="text-gold">{highlightWord}</span>
          </>
        ) : (
          title
        )}
      </h1>

      <p class="hero-lead">{subtitle}</p>

      <!-- Material Specifications & Physical Properties Tags -->
      {entityTags.length > 0 && (
        <div class="spec-tags-row">
          {entityTags.map(tag => {
            const cleanLabel = tag.label
              .replace(/Primary Entity/gi, 'Material')
              .replace(/Entity/gi, 'Classification')
              .replace(/Attributes/gi, 'Specifications');
            return (
              <div class="spec-tag-pill">
                <span class="tag-label">{cleanLabel}:</span>
                <span class="tag-val">{tag.value}</span>
              </div>
            );
          })}
        </div>
      )}

      <!-- Quick Technical Reference Stats -->
      {quickStats.length > 0 && (
        <div class="quick-stats-grid">
          {quickStats.map(stat => (
            <div class="quick-stat-card">
              <div class="stat-val">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
              <div class="stat-desc">{stat.desc}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding: var(--space-8) 0 var(--space-10);
    background: radial-gradient(circle at 50% 0%, rgba(212, 168, 83, 0.08) 0%, transparent 70%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .breadcrumb-nav ol {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    font-size: var(--text-xs);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .breadcrumb-nav li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .crumb-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .crumb-link:hover {
    color: var(--accent-gold);
  }

  .crumb-separator {
    color: var(--border-subtle);
  }

  .crumb-current {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: rgba(212, 168, 83, 0.12);
    border: 1px solid rgba(212, 168, 83, 0.25);
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-gold);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .hero-lead {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .spec-tags-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .spec-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
  }

  .tag-label {
    color: var(--text-muted);
    font-weight: 500;
  }

  .tag-val {
    color: var(--accent-gold);
    font-weight: 700;
  }

  .quick-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (max-width: 680px) {
    .quick-stats-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .quick-stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }

  .stat-val {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--accent-gold);
    margin-bottom: 2px;
  }

  .stat-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .stat-desc {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.4;
  }
</style>
