---
// Illustrative particle arrangements for the grade choices in CrushedStoneCalculator.
---
<section class="section no-print" id="crushed-visualizer">
  <div class="container">
    <div class="section-header">
      <h2>Compare crushed stone gradations</h2>
      <div class="section-divider"></div>
      <p>See how open-graded and dense-graded products differ in principle. The drawings are illustrative; the supplier's sieve analysis, wash status and project specification determine the material you receive.</p>
    </div>

    <div class="crushed-viz-grid">
      <!-- Illustrative particle arrangements -->
      <div class="crushed-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            <h3>Particle size and fines</h3>
          </div>
          <span class="status-badge" id="viz-sieve-badge">#57 clean stone</span>
        </div>

        <div class="sieve-grain-body">
          <div class="grain-display-wrap">
            <svg class="grain-svg" id="svg-grain-box" viewBox="0 0 380 200" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Illustrative particle arrangement for #57 clean stone">
              <!-- Rendered dynamically by JS -->
            </svg>
          </div>
          <p class="diagram-note">Concept sketch only. A size number alone does not establish particle shape, void space, permeability or bearing strength.</p>

          <div class="sieve-meters-grid">
            <div class="meter-node">
              <div class="m-head">
                <span>Drainage consideration</span>
                <span class="m-val" id="viz-flow-rate">Confirm low fines</span>
              </div>
            </div>

            <div class="meter-node">
              <div class="m-head">
                <span>Base consideration</span>
                <span class="m-val" id="viz-base-rate">Check project detail</span>
              </div>
            </div>
          </div>

          <div class="field-tips-box">
            <div class="tip-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Check the product, not just the name
            </div>
            <p id="viz-sieve-tip">
              For a drain, ask for a clean, suitably graded aggregate that matches the pipe and filter detail. #57 describes a size range; confirm the product's fines content and whether it is washed.
            </p>
          </div>
        </div>
      </div>

      <!-- Application questions -->
      <div class="crushed-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <h3>Match the stone to the job</h3>
          </div>
          <span class="status-badge">Product-specific</span>
        </div>

        <div class="suitability-body">
          <div class="app-row" id="app-drainage">
            <div class="app-icon">💧</div>
            <div class="app-info">
              <div class="app-title">Subsurface drain</div>
              <div class="app-sub">Check the drain detail for gradation, fines content and filter compatibility.</div>
            </div>
            <div class="app-tag tag-check" id="tag-drainage">Check product</div>
          </div>

          <div class="app-row" id="app-base">
            <div class="app-icon">🏗️</div>
            <div class="app-info">
              <div class="app-title">Driveway or patio base</div>
              <div class="app-sub">Match gradation and compacted thickness to soil, drainage and loading.</div>
            </div>
            <div class="app-tag tag-check" id="tag-base">Check design</div>
          </div>

          <div class="app-row" id="app-trackout">
            <div class="app-icon">🚜</div>
            <div class="app-info">
              <div class="app-title">Construction entrance</div>
              <div class="app-sub">Follow the site's erosion-control detail for stone size and pad maintenance.</div>
            </div>
            <div class="app-tag tag-check" id="tag-trackout">Check detail</div>
          </div>

          <!-- Information needed from the supplier -->
          <div class="specs-pill-box">
            <div class="sp-node">
              <span class="sp-k">Loose bulk weight:</span>
              <span class="sp-v">Ask the supplier for this product</span>
            </div>
            <div class="sp-node">
              <span class="sp-k">Shape and fines:</span>
              <span class="sp-v">Confirm on the product sheet</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  let currentSieve = '57';

  function renderGrains(type) {
    const svg = document.getElementById('svg-grain-box');
    if (!svg) return;

    let html = '<rect width="380" height="200" fill="#090d13" />';

    if (type === '57') {
      // An illustrative low-fines product; #57 is a size designation, not a wash or shape specification.
      html += '<defs><pattern id="clean-f57" width="40" height="40" patternUnits="userSpaceOnUse">';
      html += '<polygon points="8,10 24,6 28,22 14,28" fill="#94a3b8" stroke="#334155" stroke-width="1.2"/>';
      html += '<polygon points="26,24 38,20 36,36 22,34" fill="#64748b" stroke="#334155" stroke-width="1.2"/>';
      html += '<polygon points="4,28 16,30 12,40 2,36" fill="#cbd5e1" stroke="#334155" stroke-width="1.2"/>';
      html += '</pattern></defs>';
      html += '<rect width="380" height="200" fill="url(#clean-f57)"/>';
      // Arrows suggest possible flow paths, not a measured permeability.
      html += '<path d="M60 20 L60 80 M180 30 L180 120 M300 20 L300 90" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4,3"/>';
      html += '<text x="190" y="170" fill="#38bdf8" font-size="11" font-weight="700" text-anchor="middle">Low fines can leave open flow paths</text>';
    } else if (type === 'base') {
      // A conceptual dense-graded mix, independent of a regional trade name.
      html += '<rect width="380" height="200" fill="#475569" />'; // dense dust background
      // embedded angular stones
      for (let x = 30; x < 360; x += 45) {
        for (let y = 30; y < 180; y += 45) {
          const s = 14 + (x % 10);
          html += `<polygon points="${x},${y} ${x+s},${y-4} ${x+s+6},${y+s} ${x-2},${y+s}" fill="#94a3b8" stroke="#1e293b" stroke-width="1"/>`;
        }
      }
      html += '<text x="190" y="175" fill="#fef08a" font-size="11" font-weight="700" text-anchor="middle">Fines help fill gaps when compacted</text>';
    } else if (type === '4') {
      // Coarser clean stone; not a railroad ballast specification.
      for (let x = 40; x < 350; x += 75) {
        for (let y = 40; y < 170; y += 70) {
          html += `<polygon points="${x},${y} ${x+45},${y-12} ${x+55},${y+35} ${x-10},${y+40}" fill="#64748b" stroke="#334155" stroke-width="2"/>`;
        }
      }
      html += '<text x="190" y="175" fill="#cbd5e1" font-size="11" font-weight="700" text-anchor="middle">Coarse stone: check grade and fines</text>';
    } else {
      // Coarse numbered aggregate; riprap uses a separate project specification.
      html += '<polygon points="50,60 160,30 190,130 70,150" fill="#475569" stroke="#1e293b" stroke-width="2.5"/>';
      html += '<polygon points="180,50 310,40 330,140 200,160" fill="#64748b" stroke="#1e293b" stroke-width="2.5"/>';
      html += '<text x="190" y="180" fill="#cbd5e1" font-size="11" font-weight="700" text-anchor="middle">#1 size is not a riprap class</text>';
    }

    svg.innerHTML = html;
  }

  function syncCrushedVisualizer() {
    const activeBtn = document.querySelector('.sieve-btn.active');
    if (!activeBtn) return;
    const name = (activeBtn.dataset.name || '').toLowerCase();
    currentSieve = name.includes('#57') ? '57'
      : name.includes('crusher run') || name.includes('dense-graded') ? 'base'
      : name.includes('#4') ? '4' : '1';

    const details = {
      '57': {
        badge: '#57 clean stone', flow: 'Confirm low fines', base: 'Check the layer design',
        drainage: 'Check filter detail', foundation: 'Check base spec', entrance: 'Check site detail',
        tip: 'For drainage, select a suitably graded, low-fines product that matches the pipe and filter detail. #57 denotes a size range; it does not by itself mean washed, angular or free-draining.'
      },
      'base': {
        badge: 'Crusher run / dense-graded base', flow: 'Fines limit open flow', base: 'Compaction depends on mix',
        drainage: 'Use drainage grade', foundation: 'Common base type', entrance: 'Check site detail',
        tip: 'Crusher run blends larger particles with fines. It can make a compacted base when the gradation, moisture, lift thickness and subgrade suit the job. “#411” is a regional name; request the local product specification.'
      },
      '4': {
        badge: '#4 clean stone', flow: 'Confirm fines and filter', base: 'Check layer design',
        drainage: 'Check filter detail', foundation: 'Check base spec', entrance: 'Check site detail',
        tip: '#4 is a coarse aggregate size. A clean product may suit a specified drainage or stabilization layer, but size alone does not establish its void space, load capacity or use as railroad ballast.'
      },
      '1': {
        badge: '#1 large stone', flow: 'Confirm gradation', base: 'Check layer design',
        drainage: 'Not riprap by name', foundation: 'Check base spec', entrance: 'Check site detail',
        tip: '#1 is an aggregate size number, not a riprap design class. Erosion armor needs a separate stone gradation, thickness and filter specification.'
      }
    }[currentSieve];

    document.getElementById('viz-sieve-badge').textContent = details.badge;
    document.getElementById('viz-flow-rate').textContent = details.flow;
    document.getElementById('viz-base-rate').textContent = details.base;
    document.getElementById('tag-drainage').textContent = details.drainage;
    document.getElementById('tag-base').textContent = details.foundation;
    document.getElementById('tag-trackout').textContent = details.entrance;
    document.getElementById('viz-sieve-tip').textContent = details.tip;
    document.getElementById('svg-grain-box').setAttribute('aria-label', `Illustrative particle arrangement for ${details.badge}`);
    renderGrains(currentSieve);
  }

  document.querySelectorAll('.sieve-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setTimeout(syncCrushedVisualizer, 50);
    });
  });

  document.addEventListener('DOMContentLoaded', syncCrushedVisualizer);
  syncCrushedVisualizer();
})();
</script>

<style>
.crushed-viz-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-4);
}

@media (max-width: 900px) {
  .crushed-viz-grid {
    grid-template-columns: 1fr;
  }
}

.crushed-viz-card {
  background: var(--surface-raised);
  border: 1px solid var(--surface-glass-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--surface-glass-border);
  background: rgba(255, 255, 255, 0.02);
}

.header-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.header-title svg {
  color: var(--gold-400);
}

.header-title h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
}

.sieve-grain-body, .suitability-body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.grain-display-wrap {
  background: #090d13;
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  border: 1px solid var(--surface-glass-border);
  display: flex;
  justify-content: center;
}

.grain-svg {
  width: 100%;
  max-width: 380px;
  height: auto;
}

.diagram-note {
  color: var(--text-secondary);
  font-size: 0.75rem;
  line-height: 1.5;
  margin: 0;
}

.sieve-meters-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.meter-node {
  background: var(--surface-card);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
}

.m-head {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  margin-bottom: 6px;
}

.m-val {
  font-weight: 700;
  color: var(--gold-400);
}

.m-track {
  height: 8px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.m-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.app-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3);
  background: var(--surface-card);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
}

.app-icon {
  font-size: 1.4rem;
}

.app-info {
  flex: 1;
}

.app-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-primary);
}

.app-sub {
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.app-tag {
  font-size: 0.68rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.tag-opt {
  background: rgba(74, 222, 128, 0.15);
  color: #4ade80;
  border: 1px solid rgba(74, 222, 128, 0.3);
}

.tag-poor {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.tag-check {
  background: var(--surface-raised);
  color: var(--text-secondary);
  border: 1px solid var(--surface-glass-border);
}

.specs-pill-box {
  display: flex;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
  font-size: 0.75rem;
}

.sp-node {
  display: flex;
  flex-direction: column;
}

.sp-k {
  color: var(--text-tertiary);
  font-size: 0.68rem;
  text-transform: uppercase;
}

.sp-v {
  font-weight: 700;
  color: var(--text-primary);
}

.status-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: rgba(56, 189, 248, 0.12);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.status-badge.green {
  background: rgba(74, 222, 128, 0.12);
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.3);
}

.field-tips-box {
  background: rgba(234, 179, 8, 0.08);
  border: 1px solid rgba(234, 179, 8, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.tip-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: #fbbf24;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: var(--space-2);
}

.field-tips-box p {
  font-size: 0.78rem;
  line-height: 1.55;
  color: var(--text-secondary);
  margin: 0;
}
</style>
