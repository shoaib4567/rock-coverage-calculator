---
// Crushed Stone AASHTO Sieve Grading & Permeability Visualizer
---
<section class="section no-print" id="crushed-visualizer">
  <div class="container">
    <div class="section-header">
      <h2>Interactive AASHTO Sieve Sizer & Aggregate Grain Visualizer</h2>
      <div class="section-divider"></div>
      <p>Compare particle grain sizing, fine dust content, void ratio permeability, and structural compaction across #57 clean stone, #411 crusher run, and heavy ballast.</p>
    </div>

    <div class="crushed-viz-grid">
      <!-- Sieve Particle Grain Comparison -->
      <div class="crushed-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            <h3>Aggregate Grain Structure & Fines</h3>
          </div>
          <span class="status-badge" id="viz-sieve-badge">#57 Clean (3/4")</span>
        </div>

        <div class="sieve-grain-body">
          <div class="grain-display-wrap">
            <svg class="grain-svg" id="svg-grain-box" viewBox="0 0 380 200" preserveAspectRatio="xMidYMid meet">
              <!-- Rendered dynamically by JS -->
            </svg>
          </div>

          <div class="sieve-meters-grid">
            <div class="meter-node">
              <div class="m-head">
                <span>Hydraulic Permeability</span>
                <span class="m-val" id="viz-flow-rate">High (40% Void)</span>
              </div>
              <div class="m-track">
                <div class="m-fill flow-fill" id="viz-flow-fill" style="width: 85%;"></div>
              </div>
            </div>

            <div class="meter-node">
              <div class="m-head">
                <span>Compaction Rigidity (CBR)</span>
                <span class="m-val" id="viz-cbr-rate">Moderate (CBR 50%)</span>
              </div>
              <div class="m-track">
                <div class="m-fill cbr-fill" id="viz-cbr-fill" style="width: 45%;"></div>
              </div>
            </div>
          </div>

          <div class="field-tips-box">
            <div class="tip-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              The "Clean Stone vs Crusher Run" Disaster
            </div>
            <p id="viz-sieve-tip">
              Never use #411 Crusher Run in French drains or behind retaining walls. The limestone dust and rock fines turn into concrete-like sludge under moisture, permanently plugging the drainage holes. For drainage, always order #57 washed clean stone with zero fines.
            </p>
          </div>
        </div>
      </div>

      <!-- Application Suitability Matrix -->
      <div class="crushed-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <h3>Civil Application Suitability</h3>
          </div>
          <span class="status-badge green">AASHTO Standard</span>
        </div>

        <div class="suitability-body">
          <div class="app-row" id="app-drainage">
            <div class="app-icon">💧</div>
            <div class="app-info">
              <div class="app-title">Subsurface French Drains & Weeping Tiles</div>
              <div class="app-sub">Requires washed stone with zero fines to allow rapid water infiltration.</div>
            </div>
            <div class="app-tag tag-opt" id="tag-drainage">Optimal (#57)</div>
          </div>

          <div class="app-row" id="app-base">
            <div class="app-icon">🏗️</div>
            <div class="app-info">
              <div class="app-title">Driveway & Patio Structural Sub-Base</div>
              <div class="app-sub">Requires continuous fines to compact into a rigid, non-yielding foundation.</div>
            </div>
            <div class="app-tag tag-poor" id="tag-base">Poor (Shifts)</div>
          </div>

          <div class="app-row" id="app-trackout">
            <div class="app-icon">🚜</div>
            <div class="app-info">
              <div class="app-title">Construction Entrance Track-Out Pad</div>
              <div class="app-sub">Large ballast stones dislodge clay and mud from dump truck tires.</div>
            </div>
            <div class="app-tag tag-poor" id="tag-trackout">Too Small</div>
          </div>

          <!-- Quarry Weight Specs -->
          <div class="specs-pill-box">
            <div class="sp-node">
              <span class="sp-k">Quarry Bulk Density:</span>
              <span class="sp-v" id="viz-sieve-density">1.40 Tons / yd³ (2,800 lbs)</span>
            </div>
            <div class="sp-node">
              <span class="sp-k">Angular Interlock:</span>
              <span class="sp-v" style="color: #38bdf8;">Crushed Fractured Faces</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  let currentSieve = '57';

  function renderGrains(type) {
    const svg = document.getElementById('svg-grain-box');
    if (!svg) return;

    let html = '<rect width="380" height="200" fill="#090d13" />';

    if (type === '57') {
      // #57 Clean Stone (3/4" angular stones, zero fines, lots of open void space)
      html += '<defs><pattern id="clean-f57" width="40" height="40" patternUnits="userSpaceOnUse">';
      html += '<polygon points="8,10 24,6 28,22 14,28" fill="#94a3b8" stroke="#334155" stroke-width="1.2"/>';
      html += '<polygon points="26,24 38,20 36,36 22,34" fill="#64748b" stroke="#334155" stroke-width="1.2"/>';
      html += '<polygon points="4,28 16,30 12,40 2,36" fill="#cbd5e1" stroke="#334155" stroke-width="1.2"/>';
      html += '</pattern></defs>';
      html += '<rect width="380" height="200" fill="url(#clean-f57)"/>';
      // Flow arrows through open voids
      html += '<path d="M60 20 L60 80 M180 30 L180 120 M300 20 L300 90" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4,3"/>';
      html += '<text x="190" y="170" fill="#38bdf8" font-size="11" font-weight="700" text-anchor="middle">Open 40% Voids: Water Flows Freely</text>';
    } else if (type === '411') {
      // #411 Crusher run (angular stones embedded in a dense matrix of stone dust fines)
      html += '<rect width="380" height="200" fill="#475569" />'; // dense dust background
      // embedded angular stones
      for (let x = 30; x < 360; x += 45) {
        for (let y = 30; y < 180; y += 45) {
          const s = 14 + (x % 10);
          html += `<polygon points="${x},${y} ${x+s},${y-4} ${x+s+6},${y+s} ${x-2},${y+s}" fill="#94a3b8" stroke="#1e293b" stroke-width="1"/>`;
        }
      }
      html += '<text x="190" y="175" fill="#fef08a" font-size="11" font-weight="700" text-anchor="middle">Dense Fines Pack Solid: High Structural Base</text>';
    } else if (type === '4') {
      // #4 Ballast (1.5" - 2.5" large stones)
      for (let x = 40; x < 350; x += 75) {
        for (let y = 40; y < 170; y += 70) {
          html += `<polygon points="${x},${y} ${x+45},${y-12} ${x+55},${y+35} ${x-10},${y+40}" fill="#64748b" stroke="#334155" stroke-width="2"/>`;
        }
      }
      html += '<text x="190" y="175" fill="#cbd5e1" font-size="11" font-weight="700" text-anchor="middle">Heavy 2" Ballast: Resists Heavy Equipment Rutting</text>';
    } else {
      // Riprap (huge rocks)
      html += '<polygon points="50,60 160,30 190,130 70,150" fill="#475569" stroke="#1e293b" stroke-width="2.5"/>';
      html += '<polygon points="180,50 310,40 330,140 200,160" fill="#64748b" stroke="#1e293b" stroke-width="2.5"/>';
      html += '<text x="190" y="180" fill="#cbd5e1" font-size="11" font-weight="700" text-anchor="middle">3" - 6" Heavy Riprap: Erosion Dissipation</text>';
    }

    svg.innerHTML = html;
  }

  function syncCrushedVisualizer() {
    const activeBtn = document.querySelector('.sieve-btn.active');
    const badge = document.getElementById('viz-sieve-badge');
    const flowVal = document.getElementById('viz-flow-rate');
    const flowFill = document.getElementById('viz-flow-fill');
    const cbrVal = document.getElementById('viz-cbr-rate');
    const cbrFill = document.getElementById('viz-cbr-fill');
    const tip = document.getElementById('viz-sieve-tip');
    const densityEl = document.getElementById('viz-sieve-density');

    const tagDrainage = document.getElementById('tag-drainage');
    const tagBase = document.getElementById('tag-base');
    const tagTrackout = document.getElementById('tag-trackout');

    if (!activeBtn) return;
    const name = activeBtn.dataset.name || '';

    if (name.includes('#57')) {
      currentSieve = '57';
      if (badge) badge.textContent = '#57 Clean (3/4")';
      if (flowVal) flowVal.textContent = 'Maximum (40% Void)';
      if (flowFill) { flowFill.style.width = '90%'; flowFill.style.background = '#38bdf8'; }
      if (cbrVal) cbrVal.textContent = 'Moderate (CBR 50%)';
      if (cbrFill) { cbrFill.style.width = '50%'; cbrFill.style.background = '#f59e0b'; }
      if (densityEl) densityEl.textContent = '1.40 Tons / yd³ (2,800 lbs)';
      if (tagDrainage) { tagDrainage.textContent = 'Optimal (#1 Choice)'; tagDrainage.className = 'app-tag tag-opt'; }
      if (tagBase) { tagBase.textContent = 'Poor (Will Shift)'; tagBase.className = 'app-tag tag-poor'; }
      if (tagTrackout) { tagTrackout.textContent = 'Too Small'; tagTrackout.className = 'app-tag tag-poor'; }
      if (tip) tip.textContent = '#57 clean stone is washed to eliminate fines, preserving open void spaces for rapid subsurface water movement in French drains and behind retaining walls.';
    } else if (name.includes('#411')) {
      currentSieve = '411';
      if (badge) badge.textContent = '#411 Crusher Run';
      if (flowVal) flowVal.textContent = 'Zero (Impermeable)';
      if (flowFill) { flowFill.style.width = '10%'; flowFill.style.background = '#ef4444'; }
      if (cbrVal) cbrVal.textContent = 'Maximum (CBR 95%+)';
      if (cbrFill) { cbrFill.style.width = '95%'; cbrFill.style.background = '#10b981'; }
      if (densityEl) densityEl.textContent = '1.50 Tons / yd³ (3,000 lbs)';
      if (tagDrainage) { tagDrainage.textContent = 'Clogs Drains!'; tagDrainage.className = 'app-tag tag-poor'; }
      if (tagBase) { tagBase.textContent = 'Optimal (Rock-Hard)'; tagBase.className = 'app-tag tag-opt'; }
      if (tagTrackout) { tagTrackout.textContent = 'Tracks Dust'; tagTrackout.className = 'app-tag tag-poor'; }
      if (tip) tip.textContent = '#411 (Crusher Run) contains limestone rock flour. When compacted with a vibratory roller, it locks into a solid pavement base that does not rut under heavy vehicles.';
    } else if (name.includes('#4 Ballast')) {
      currentSieve = '4';
      if (badge) badge.textContent = '#4 Ballast (1.5"-2.5")';
      if (flowVal) flowVal.textContent = 'Very High (45% Void)';
      if (flowFill) { flowFill.style.width = '85%'; flowFill.style.background = '#38bdf8'; }
      if (cbrVal) cbrVal.textContent = 'Heavy Structural (CBR 80%)';
      if (cbrFill) { cbrFill.style.width = '80%'; cbrFill.style.background = '#10b981'; }
      if (densityEl) densityEl.textContent = '1.45 Tons / yd³ (2,900 lbs)';
      if (tagDrainage) { tagDrainage.textContent = 'Deep Footings'; tagDrainage.className = 'app-tag tag-opt'; }
      if (tagBase) { tagBase.textContent = 'Rough Sub-Base'; tagBase.className = 'app-tag tag-opt'; }
      if (tagTrackout) { tagTrackout.textContent = 'Optimal Spec'; tagTrackout.className = 'app-tag tag-opt'; }
      if (tip) tip.textContent = '#4 heavy ballast is the civil standard for construction entrance track-out pads and railroad ballast, shaking heavy mud off truck tires before exiting sites.';
    } else {
      currentSieve = '1';
      if (badge) badge.textContent = '#1 Heavy Riprap (3"-6")';
      if (flowVal) flowVal.textContent = 'Turbulent Dissipation';
      if (flowFill) { flowFill.style.width = '75%'; flowFill.style.background = '#38bdf8'; }
      if (cbrVal) cbrVal.textContent = 'Heavy Armor';
      if (cbrFill) { cbrFill.style.width = '85%'; cbrFill.style.background = '#10b981'; }
      if (densityEl) densityEl.textContent = '1.50 Tons / yd³ (3,000 lbs)';
      if (tagDrainage) { tagDrainage.textContent = 'Culvert Outfalls'; tagDrainage.className = 'app-tag tag-opt'; }
      if (tagBase) { tagBase.textContent = 'Too Large'; tagBase.className = 'app-tag tag-poor'; }
      if (tagTrackout) { tagTrackout.textContent = 'Entrance Base'; tagTrackout.className = 'app-tag tag-opt'; }
      if (tip) tip.textContent = '#1 riprap is engineered for shoreline armor, steep slope erosion control, and culvert discharge splash pads to slow down rushing stormwater.';
    }

    renderGrains(currentSieve);
  }

  document.querySelectorAll('.sieve-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setTimeout(syncCrushedVisualizer, 50);
    });
  });

  document.addEventListener('DOMContentLoaded', syncCrushedVisualizer);
  syncCrushedVisualizer();
})();
</script>

<style>
.crushed-viz-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-4);
}

@media (max-width: 900px) {
  .crushed-viz-grid {
    grid-template-columns: 1fr;
  }
}

.crushed-viz-card {
  background: var(--surface-raised);
  border: 1px solid var(--surface-glass-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--surface-glass-border);
  background: rgba(255, 255, 255, 0.02);
}

.header-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.header-title svg {
  color: var(--gold-400);
}

.header-title h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
}

.sieve-grain-body, .suitability-body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.grain-display-wrap {
  background: #090d13;
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  border: 1px solid var(--surface-glass-border);
  display: flex;
  justify-content: center;
}

.grain-svg {
  width: 100%;
  max-width: 380px;
  height: auto;
}

.sieve-meters-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.meter-node {
  background: var(--surface-card);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
}

.m-head {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  margin-bottom: 6px;
}

.m-val {
  font-weight: 700;
  color: var(--gold-400);
}

.m-track {
  height: 8px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.m-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
}

.app-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--surface-card);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
}

.app-icon {
  font-size: 1.4rem;
}

.app-info {
  flex: 1;
}

.app-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--text-primary);
}

.app-sub {
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.app-tag {
  font-size: 0.68rem;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-full);
  white-space: nowrap;
}

.tag-opt {
  background: rgba(74, 222, 128, 0.15);
  color: #4ade80;
  border: 1px solid rgba(74, 222, 128, 0.3);
}

.tag-poor {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.specs-pill-box {
  display: flex;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
  font-size: 0.75rem;
}

.sp-node {
  display: flex;
  flex-direction: column;
}

.sp-k {
  color: var(--text-tertiary);
  font-size: 0.68rem;
  text-transform: uppercase;
}

.sp-v {
  font-weight: 700;
  color: var(--text-primary);
}

.status-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: rgba(56, 189, 248, 0.12);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.status-badge.green {
  background: rgba(74, 222, 128, 0.12);
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.3);
}

.field-tips-box {
  background: rgba(234, 179, 8, 0.08);
  border: 1px solid rgba(234, 179, 8, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.tip-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: #fbbf24;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: var(--space-2);
}

.field-tips-box p {
  font-size: 0.78rem;
  line-height: 1.55;
  color: var(--text-secondary);
  margin: 0;
}
</style>
