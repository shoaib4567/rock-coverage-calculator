---
// French Drain Trench & Subsurface Hydraulic Visualizer
---
<section class="section no-print" id="drain-visualizer">
  <div class="container">
    <div class="section-header">
      <h2>Interactive French Drain Trench & Flow Visualizer</h2>
      <div class="section-divider"></div>
      <p>Inspect the complete geotextile burrito wrap cross-section, perforated pipe bedding, and gravity slope profile calibrated to your trench dimensions.</p>
    </div>

    <div class="drain-viz-grid">
      <!-- Cutaway Trench Profile -->
      <div class="drain-viz-card trench-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <h3>Trench Cross-Section ("Burrito Wrap" Spec)</h3>
          </div>
          <span class="status-badge" id="wrap-status-badge">ASTM C33 Compliant</span>
        </div>

        <div class="trench-display-area">
          <!-- Soil & Trench Cutaway SVG -->
          <svg class="trench-svg" viewBox="0 0 400 320" preserveAspectRatio="xMidYMid meet">
            <defs>
              <pattern id="soil-pattern" width="20" height="20" patternUnits="userSpaceOnUse">
                <circle cx="4" cy="4" r="1.5" fill="rgba(180, 140, 100, 0.25)" />
                <circle cx="14" cy="14" r="1" fill="rgba(180, 140, 100, 0.2)" />
                <path d="M0 10h5M12 5h6" stroke="rgba(180, 140, 100, 0.2)" stroke-width="1" />
              </pattern>
              <pattern id="gravel-pattern" width="16" height="16" patternUnits="userSpaceOnUse">
                <circle cx="4" cy="5" r="3" fill="rgba(210, 190, 160, 0.7)" stroke="#665544" stroke-width="0.8"/>
                <circle cx="12" cy="11" r="3.2" fill="rgba(190, 175, 150, 0.8)" stroke="#665544" stroke-width="0.8"/>
                <circle cx="11" cy="4" r="2.2" fill="rgba(220, 205, 180, 0.6)" stroke="#665544" stroke-width="0.8"/>
                <circle cx="4" cy="13" r="2.5" fill="rgba(175, 160, 140, 0.7)" stroke="#665544" stroke-width="0.8"/>
              </pattern>
              <linearGradient id="water-flow-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#0284c7" stop-opacity="0.9"/>
              </linearGradient>
            </defs>

            <!-- Native Ground / Soil -->
            <rect x="0" y="0" width="400" height="320" fill="url(#soil-pattern)" />
            <!-- Surface Turf Layer -->
            <rect x="0" y="0" width="400" height="26" fill="#1e3a1e" />
            <path d="M0 26 Q 50 24 100 26 T 200 26 T 300 26 T 400 26" stroke="#4ade80" stroke-width="3" fill="none" />
            <text x="20" y="18" fill="#86efac" font-size="11" font-weight="600">Native Turf / Topsoil</text>

            <!-- Excavated Trench Void -->
            <rect id="svg-trench-box" x="110" y="26" width="180" height="270" fill="#292018" rx="2" stroke="#453324" stroke-width="2" />

            <!-- Geotextile Fabric Envelope (Burrito Wrap) -->
            <rect id="svg-fabric-envelope" x="116" y="32" width="168" height="258" fill="#1c2430" stroke="#60a5fa" stroke-width="2.5" stroke-dasharray="6,3" />

            <!-- Clean #57 Washed Drain Stone Fill -->
            <rect id="svg-gravel-fill" x="120" y="36" width="160" height="250" fill="url(#gravel-pattern)" />

            <!-- Perforated Pipe (Bottom Invert) -->
            <g id="svg-pipe-group" transform="translate(200, 230)">
              <!-- Pipe Outer Wall -->
              <circle r="36" fill="#18181b" stroke="#38bdf8" stroke-width="3.5" />
              <!-- Pipe Inner Chamber -->
              <circle r="30" fill="#09090b" />
              <!-- Water in Pipe Invert -->
              <path d="M -26 15 Q 0 30 26 15 A 30 30 0 0 1 -26 15 Z" fill="url(#water-flow-grad)" />
              <!-- Perforation Holes on Bottom 1/3 (Downwards!) -->
              <circle cx="-16" cy="20" r="3" fill="#38bdf8" />
              <circle cx="0" cy="24" r="3" fill="#38bdf8" />
              <circle cx="16" cy="20" r="3" fill="#38bdf8" />
              <text x="0" y="-4" fill="#e0f2fe" font-size="11" font-weight="700" text-anchor="middle">4" Pipe</text>
              <text x="0" y="8" fill="#7dd3fc" font-size="8" text-anchor="middle">Holes Down</text>
            </g>

            <!-- 2" Bedding Stone Indicator -->
            <line x1="120" y1="266" x2="280" y2="266" stroke="#fbbf24" stroke-width="1.5" stroke-dasharray="3,3"/>
            <text x="200" y="280" fill="#fef08a" font-size="9" font-weight="600" text-anchor="middle">2" Washed Stone Bedding</text>

            <!-- Top Geotextile Overlap (12 inches) -->
            <rect x="116" y="32" width="168" height="12" fill="#2563eb" opacity="0.6"/>
            <text x="200" y="41" fill="#ffffff" font-size="8" font-weight="700" text-anchor="middle">12" Fabric Overlap</text>

            <!-- Water Filtration Droplets Animation -->
            <g class="filtration-droplets">
              <circle cx="150" cy="65" r="2.5" fill="#38bdf8" class="drop d1"/>
              <circle cx="200" cy="85" r="2.5" fill="#38bdf8" class="drop d2"/>
              <circle cx="250" cy="70" r="2.5" fill="#38bdf8" class="drop d3"/>
              <circle cx="170" cy="140" r="2.5" fill="#38bdf8" class="drop d4"/>
              <circle cx="230" cy="155" r="2.5" fill="#38bdf8" class="drop d5"/>
            </g>

            <!-- Dimension Callouts -->
            <line x1="100" y1="26" x2="100" y2="296" stroke="#94a3b8" stroke-width="1.5" marker-start="url(#arrow)" marker-end="url(#arrow)"/>
            <text x="92" y="165" fill="#cbd5e1" font-size="10" font-weight="600" text-anchor="end" transform="rotate(-90 92 165)" id="svg-depth-label">24" Depth</text>

            <line x1="110" y1="310" x2="290" y2="310" stroke="#94a3b8" stroke-width="1.5"/>
            <text x="200" y="306" fill="#cbd5e1" font-size="10" font-weight="600" text-anchor="middle" id="svg-width-label">12" Width</text>
          </svg>
        </div>

        <div class="trench-specs-bar">
          <div class="spec-node">
            <span class="spec-k">Fabric Spec:</span>
            <span class="spec-v">4 oz Non-Woven Geotextile</span>
          </div>
          <div class="spec-node">
            <span class="spec-k">Perforation Invert:</span>
            <span class="spec-v" style="color: #38bdf8;">Facing Down (4 & 8 o'clock)</span>
          </div>
          <div class="spec-node">
            <span class="spec-k">Void Ratio:</span>
            <span class="spec-v" style="color: #4ade80;">38% to 40% Open Flow</span>
          </div>
        </div>
      </div>

      <!-- Hydraulic Slope & Gravity Fall Profile -->
      <div class="drain-viz-card slope-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 20L21 4M3 20h18M21 20V4"/></svg>
            <h3>Gravity Slope & Fall Profile</h3>
          </div>
          <span class="status-badge green">1% Minimum Grade</span>
        </div>

        <div class="slope-calculator-body">
          <div class="slope-diagram-wrap">
            <svg class="slope-svg" viewBox="0 0 360 140" preserveAspectRatio="xMidYMid meet">
              <!-- Ground baseline -->
              <line x1="20" y1="30" x2="340" y2="30" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4,4"/>
              <text x="25" y="22" fill="#94a3b8" font-size="9">Horizontal Ground Surface</text>

              <!-- Sloping trench base -->
              <polygon points="20,45 340,95 340,115 20,65" fill="rgba(56, 189, 248, 0.12)" stroke="#0284c7" stroke-width="1.5"/>
              
              <!-- Sloping pipe line -->
              <line x1="20" y1="55" x2="340" y2="105" stroke="#38bdf8" stroke-width="4" stroke-linecap="round"/>

              <!-- Flow arrows -->
              <path d="M90 70 L110 73 L105 66" fill="none" stroke="#e0f2fe" stroke-width="2"/>
              <path d="M190 85 L210 88 L205 81" fill="none" stroke="#e0f2fe" stroke-width="2"/>

              <!-- Elevation Drop Dimension -->
              <line x1="345" y1="30" x2="345" y2="105" stroke="#f59e0b" stroke-width="1.5"/>
              <circle cx="345" cy="30" r="2.5" fill="#f59e0b"/>
              <circle cx="345" cy="105" r="2.5" fill="#f59e0b"/>
              <text x="350" y="72" fill="#fbbf24" font-size="11" font-weight="700" id="slope-drop-label">6.0" Total Fall</text>

              <!-- Inlet & Outlet Labels -->
              <text x="20" y="85" fill="#cbd5e1" font-size="9" font-weight="600">High Inlet End</text>
              <text x="280" y="130" fill="#38bdf8" font-size="9" font-weight="700">Daylight Emitter</text>
            </svg>
          </div>

          <div class="slope-metrics-grid">
            <div class="slope-metric">
              <span class="m-val" id="slope-run-ft">50 ft</span>
              <span class="m-lbl">Total Run Length</span>
            </div>
            <div class="slope-metric">
              <span class="m-val" id="slope-drop-in">6.0 in</span>
              <span class="m-lbl">Mandatory Fall</span>
            </div>
            <div class="slope-metric">
              <span class="m-val">1" per 8-10'</span>
              <span class="m-lbl">Contractor Pitch</span>
            </div>
          </div>

          <!-- Real-world Drainage Traps -->
          <div class="field-tips-box">
            <div class="tip-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Critical Contractor Rule: Why Holes Face Down
            </div>
            <p>
              Perforated French drain pipe holes must always face downward at the 4 o'clock and 8 o'clock positions. As groundwater rises from underneath into the gravel bed, it enters through the bottom holes and drains away immediately. If holes face up, water must fill the entire trench before entering the pipe, leaving your yard waterlogged.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  function syncDrainVisualizer() {
    const lengthInput = document.getElementById('drain-trench-length');
    const widthInput = document.getElementById('drain-trench-width');
    const depthInput = document.getElementById('drain-trench-depth');

    const length = lengthInput ? parseFloat(lengthInput.value) || 50 : 50;
    const width = widthInput ? parseFloat(widthInput.value) || 12 : 12;
    const depth = depthInput ? parseFloat(depthInput.value) || 24 : 24;

    // Update labels
    const depthLabel = document.getElementById('svg-depth-label');
    const widthLabel = document.getElementById('svg-width-label');
    if (depthLabel) depthLabel.textContent = depth + '" Depth';
    if (widthLabel) widthLabel.textContent = width + '" Width';

    // Calculate 1% gravity fall (1 inch fall per 8.33 feet = 0.12 in/ft)
    const totalDropInches = (length * 0.12).toFixed(1);
    const dropLabel = document.getElementById('slope-drop-label');
    const dropVal = document.getElementById('slope-drop-in');
    const runVal = document.getElementById('slope-run-ft');

    if (dropLabel) dropLabel.textContent = totalDropInches + '" Total Fall';
    if (dropVal) dropVal.textContent = totalDropInches + ' in';
    if (runVal) runVal.textContent = length + ' ft';
  }

  // Attach listener
  const inputs = ['drain-trench-length', 'drain-trench-width', 'drain-trench-depth'];
  inputs.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', syncDrainVisualizer);
      el.addEventListener('change', syncDrainVisualizer);
    }
  });

  // Observe active pipe buttons
  document.querySelectorAll('.pipe-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      setTimeout(syncDrainVisualizer, 50);
    });
  });

  document.addEventListener('DOMContentLoaded', syncDrainVisualizer);
  syncDrainVisualizer();
})();
</script>

<style>
.drain-viz-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-4);
}

@media (max-width: 900px) {
  .drain-viz-grid {
    grid-template-columns: 1fr;
  }
}

.drain-viz-card {
  background: var(--surface-raised);
  border: 1px solid var(--surface-glass-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--surface-glass-border);
  background: rgba(255, 255, 255, 0.02);
}

.header-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.header-title svg {
  color: var(--river-teal);
  flex-shrink: 0;
}

.header-title h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
}

.status-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: rgba(56, 189, 248, 0.12);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.status-badge.green {
  background: rgba(74, 222, 128, 0.12);
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.3);
}

.trench-display-area {
  padding: var(--space-4);
  background: #0d1117;
  display: flex;
  justify-content: center;
}

.trench-svg {
  width: 100%;
  max-width: 420px;
  height: auto;
  border-radius: var(--radius-md);
}

.filtration-droplets .drop {
  animation: drip 2.4s infinite linear;
  opacity: 0.85;
}

.filtration-droplets .d1 { animation-delay: 0s; }
.filtration-droplets .d2 { animation-delay: 0.6s; }
.filtration-droplets .d3 { animation-delay: 1.2s; }
.filtration-droplets .d4 { animation-delay: 1.8s; }
.filtration-droplets .d5 { animation-delay: 0.9s; }

@keyframes drip {
  0% { transform: translateY(0); opacity: 0; }
  20% { opacity: 0.9; }
  80% { opacity: 0.9; }
  100% { transform: translateY(120px); opacity: 0; }
}

.trench-specs-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: rgba(0, 0, 0, 0.3);
  border-top: 1px solid var(--surface-glass-border);
  font-size: 0.75rem;
}

@media (max-width: 600px) {
  .trench-specs-bar {
    grid-template-columns: 1fr;
  }
}

.spec-node {
  display: flex;
  flex-direction: column;
}

.spec-k {
  color: var(--text-tertiary);
  font-size: 0.68rem;
  text-transform: uppercase;
}

.spec-v {
  font-weight: 700;
  color: var(--text-primary);
}

.slope-calculator-body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.slope-diagram-wrap {
  background: #0d1117;
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  border: 1px solid var(--surface-glass-border);
}

.slope-svg {
  width: 100%;
  height: auto;
}

.slope-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.slope-metric {
  background: var(--surface-card);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  text-align: center;
  border: 1px solid var(--surface-glass-border);
}

.m-val {
  display: block;
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--gold-400);
}

.m-lbl {
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.field-tips-box {
  background: rgba(234, 179, 8, 0.08);
  border: 1px solid rgba(234, 179, 8, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.tip-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: #fbbf24;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: var(--space-2);
}

.field-tips-box p {
  font-size: 0.78rem;
  line-height: 1.55;
  color: var(--text-secondary);
  margin: 0;
}
</style>
