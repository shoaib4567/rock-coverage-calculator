---
// Rock Coverage Chart & Stepped Depth Matrix Visualizer
---
<section class="section no-print" id="coverage-chart-visualizer">
  <div class="container">
    <div class="section-header">
      <h2>Interactive Stepped Depth Matrix & Coverage Footprint Visualizer</h2>
      <div class="section-divider"></div>
      <p>Compare physical coverage footprint yields as layer depth increases from 1" to 6", showing how material volume and weight scale.</p>
    </div>

    <div class="chart-viz-grid">
      <!-- Stepped Depth Layer Comparison SVG -->
      <div class="chart-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 17l4-8 4 4 5-10"/></svg>
            <h3>Stepped Thickness Cross-Section (1" to 6")</h3>
          </div>
          <span class="status-badge gold">Depth Comparison</span>
        </div>

        <div class="stepped-body">
          <div class="stepped-svg-wrap">
            <svg class="stepped-svg" viewBox="0 0 380 200" preserveAspectRatio="xMidYMid meet">
              <!-- Ground Line -->
              <line x1="20" y1="160" x2="360" y2="160" stroke="#52525b" stroke-width="1.5"/>

              <!-- Step 1: 1 Inch Depth -->
              <rect x="40" y="145" width="45" height="15" fill="#38bdf8" rx="2" opacity="0.8"/>
              <text x="62" y="138" fill="#38bdf8" font-size="9" font-weight="700" text-anchor="middle">1"</text>
              <text x="62" y="175" fill="#94a3b8" font-size="8" text-anchor="middle">324 sq ft/yd</text>

              <!-- Step 2: 2 Inch Depth -->
              <rect x="95" y="130" width="45" height="30" fill="#38bdf8" rx="2" opacity="0.85"/>
              <text x="117" y="123" fill="#38bdf8" font-size="9" font-weight="700" text-anchor="middle">2"</text>
              <text x="117" y="175" fill="#94a3b8" font-size="8" text-anchor="middle">162 sq ft/yd</text>

              <!-- Step 3: 3 Inch Depth (Recommended Garden Bed) -->
              <rect x="150" y="115" width="45" height="45" fill="#f59e0b" rx="2"/>
              <text x="172" y="108" fill="#f59e0b" font-size="9" font-weight="800" text-anchor="middle">3" (Sweet)</text>
              <text x="172" y="175" fill="#fef08a" font-size="8" font-weight="700" text-anchor="middle">108 sq ft/yd</text>

              <!-- Step 4: 4 Inch Depth (Driveway) -->
              <rect x="205" y="100" width="45" height="60" fill="#10b981" rx="2" opacity="0.85"/>
              <text x="227" y="93" fill="#10b981" font-size="9" font-weight="700" text-anchor="middle">4"</text>
              <text x="227" y="175" fill="#94a3b8" font-size="8" text-anchor="middle">81 sq ft/yd</text>

              <!-- Step 5: 5 Inch Depth -->
              <rect x="260" y="85" width="45" height="75" fill="#6366f1" rx="2" opacity="0.8"/>
              <text x="282" y="78" fill="#6366f1" font-size="9" font-weight="700" text-anchor="middle">5"</text>
              <text x="282" y="175" fill="#94a3b8" font-size="8" text-anchor="middle">65 sq ft/yd</text>

              <!-- Step 6: 6 Inch Depth (Heavy Base / Swale) -->
              <rect x="315" y="70" width="45" height="90" fill="#ec4899" rx="2" opacity="0.8"/>
              <text x="337" y="63" fill="#ec4899" font-size="9" font-weight="700" text-anchor="middle">6"</text>
              <text x="337" y="175" fill="#94a3b8" font-size="8" text-anchor="middle">54 sq ft/yd</text>

              <!-- Top rule callout -->
              <text x="190" y="30" fill="#cbd5e1" font-size="10" font-weight="700" text-anchor="middle">Square Feet Covered per Cubic Yard</text>
            </svg>
          </div>

          <div class="field-tips-box">
            <div class="tip-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              The Inverse Coverage Rule
            </div>
            <p>
              Coverage area is inversely proportional to depth. Doubling your layer depth from 2 inches to 4 inches cuts your coverage square footage exactly in half, doubling your total project material and delivery freight cost.
            </p>
          </div>
        </div>
      </div>

      <!-- Live Coverage Footprint Shrinkage Simulator -->
      <div class="chart-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <h3>Live Coverage Footprint Shrinkage</h3>
          </div>
          <span class="status-badge green" id="viz-footprint-badge">1 Ton Yield</span>
        </div>

        <div class="footprint-body">
          <div class="slider-control-node">
            <div class="sc-head">
              <span>Interactive Layer Depth Slider:</span>
              <span class="sc-val" id="viz-slider-depth-txt">3.0 Inches</span>
            </div>
            <input type="range" id="viz-chart-depth-slider" min="1" max="6" value="3" step="0.5" class="custom-range"/>
          </div>

          <div class="footprint-display-box">
            <div class="fp-metric-card">
              <div class="fp-metric-val" id="viz-sqft-per-yard">108 sq ft</div>
              <div class="fp-metric-lbl">Coverage Per Cubic Yard</div>
            </div>
            <div class="fp-metric-card">
              <div class="fp-metric-val" id="viz-sqft-per-ton">80 sq ft</div>
              <div class="fp-metric-lbl">Coverage Per Ton (#57 Rock)</div>
            </div>
            <div class="fp-metric-card">
              <div class="fp-metric-val" id="viz-bags-per-100">50 bags</div>
              <div class="fp-metric-lbl">Bags per 100 Sq Ft</div>
            </div>
          </div>

          <div class="field-tips-box">
            <div class="tip-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              Contractor Depth Rule of Thumb
            </div>
            <p>
              - <strong>2" to 2.5"</strong>: Best for small pea gravel (3/8") and pathways.<br />
              - <strong>3" to 3.5"</strong>: Industry standard for 1"-3" river rock and landscape beds.<br />
              - <strong>4" to 6"</strong>: Mandatory structural depth for driveways and crushed stone bases.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  function updateFootprint() {
    const slider = document.getElementById('viz-chart-depth-slider');
    const depth = slider ? parseFloat(slider.value) || 3.0 : 3.0;

    const depthTxt = document.getElementById('viz-slider-depth-txt');
    if (depthTxt) depthTxt.textContent = depth.toFixed(1) + ' Inches';

    // 1 yd³ = 324 / depth
    const sqftPerYard = Math.round(324 / depth);
    // 1 ton (assuming 1.35 T/yd³ river rock) = sqftPerYard / 1.35
    const sqftPerTon = Math.round(sqftPerYard / 1.35);
    // Bags (0.5 cu ft) for 100 sq ft = (100 * (depth/12)) / 0.5
    const bagsPer100 = Math.ceil((100 * (depth / 12)) / 0.5);

    const yardVal = document.getElementById('viz-sqft-per-yard');
    const tonVal = document.getElementById('viz-sqft-per-ton');
    const bagVal = document.getElementById('viz-bags-per-100');

    if (yardVal) yardVal.textContent = sqftPerYard + ' sq ft';
    if (tonVal) tonVal.textContent = sqftPerTon + ' sq ft';
    if (bagVal) bagVal.textContent = bagsPer100 + ' bags';
  }

  const slider = document.getElementById('viz-chart-depth-slider');
  if (slider) {
    slider.addEventListener('input', updateFootprint);
    slider.addEventListener('change', updateFootprint);
  }

  document.addEventListener('DOMContentLoaded', updateFootprint);
  updateFootprint();
})();
</script>

<style>
.chart-viz-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-4);
}

@media (max-width: 900px) {
  .chart-viz-grid {
    grid-template-columns: 1fr;
  }
}

.chart-viz-card {
  background: var(--surface-raised);
  border: 1px solid var(--surface-glass-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--surface-glass-border);
  background: rgba(255, 255, 255, 0.02);
}

.header-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.header-title svg {
  color: var(--gold-400);
}

.header-title h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
}

.stepped-body, .footprint-body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.stepped-svg-wrap {
  background: #090d13;
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  border: 1px solid var(--surface-glass-border);
  display: flex;
  justify-content: center;
}

.stepped-svg {
  width: 100%;
  max-width: 380px;
  height: auto;
}

.slider-control-node {
  background: var(--surface-card);
  padding: var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
}

.sc-head {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: var(--space-2);
}

.sc-val {
  color: var(--gold-400);
}

.custom-range {
  width: 100%;
  accent-color: var(--gold-500);
  cursor: pointer;
}

.footprint-display-box {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.fp-metric-card {
  background: var(--surface-card);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  text-align: center;
  border: 1px solid var(--surface-glass-border);
}

.fp-metric-val {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--gold-400);
}

.fp-metric-lbl {
  font-size: 0.68rem;
  color: var(--text-secondary);
}

.status-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.status-badge.gold {
  background: rgba(234, 179, 8, 0.12);
  color: #fbbf24;
  border: 1px solid rgba(234, 179, 8, 0.3);
}

.status-badge.green {
  background: rgba(74, 222, 128, 0.12);
  color: #4ade80;
  border: 1px solid rgba(74, 222, 128, 0.3);
}

.field-tips-box {
  background: rgba(234, 179, 8, 0.08);
  border: 1px solid rgba(234, 179, 8, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.tip-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: #fbbf24;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: var(--space-2);
}

.field-tips-box p {
  font-size: 0.78rem;
  line-height: 1.55;
  color: var(--text-secondary);
  margin: 0;
}
</style>
