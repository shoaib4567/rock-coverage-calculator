---
// Rock Cubic Yard 3D Physical Scale & Hauler Visualizer
---
<section class="section no-print" id="cuyd-visualizer">
  <div class="container">
    <div class="section-header">
      <h2>Interactive 1-Cubic-Yard Physical Scale & Hauling Visualizer</h2>
      <div class="section-divider"></div>
      <p>Visualize the true physical scale of 1 cubic yard (27 cubic feet) compared to a human contractor, wheelbarrow loads, and dump truck capacities.</p>
    </div>

    <div class="cuyd-viz-grid">
      <!-- 1 Cubic Yard Human & Equipment Physical Scale -->
      <div class="cuyd-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <h3>Physical Scale: 1 Yard = 3' × 3' × 3' (27 cu ft)</h3>
          </div>
          <span class="status-badge gold">Human Scale</span>
        </div>

        <div class="scale-body">
          <div class="scale-svg-wrap">
            <svg class="scale-svg" viewBox="0 0 380 220" preserveAspectRatio="xMidYMid meet">
              <defs>
                <linearGradient id="cube-top-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#38bdf8"/>
                  <stop offset="100%" stop-color="#0284c7"/>
                </linearGradient>
                <linearGradient id="cube-left-grad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0369a1"/>
                  <stop offset="100%" stop-color="#0c4a6e"/>
                </linearGradient>
                <linearGradient id="cube-right-grad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0284c7"/>
                  <stop offset="100%" stop-color="#0369a1"/>
                </linearGradient>
              </defs>

              <!-- Ground Baseline -->
              <line x1="20" y1="180" x2="360" y2="180" stroke="#52525b" stroke-width="1.5"/>

              <!-- Human Contractor Silhouette (5' 10" = 70 inches) -->
              <g transform="translate(60, 65)">
                <!-- Head -->
                <circle cx="0" cy="0" r="9" fill="#94a3b8"/>
                <!-- Hardhat -->
                <path d="M -11 -2 Q 0 -14 11 -2 Z" fill="#f59e0b"/>
                <line x1="-13" y1="-2" x2="13" y2="-2" stroke="#f59e0b" stroke-width="2"/>
                <!-- Body -->
                <line x1="0" y1="9" x2="0" y2="60" stroke="#94a3b8" stroke-width="6"/>
                <!-- Arms -->
                <line x1="0" y1="20" x2="-14" y2="48" stroke="#94a3b8" stroke-width="4"/>
                <line x1="0" y1="20" x2="14" y2="48" stroke="#94a3b8" stroke-width="4"/>
                <!-- Legs -->
                <line x1="0" y1="60" x2="-12" y2="115" stroke="#94a3b8" stroke-width="4.5"/>
                <line x1="0" y1="60" x2="12" y2="115" stroke="#94a3b8" stroke-width="4.5"/>
                <text x="0" y="130" fill="#cbd5e1" font-size="8" font-weight="700" text-anchor="middle">5' 10" Person</text>
              </g>

              <!-- Isometric 1-Cubic-Yard Cube (3ft x 3ft x 3ft) -->
              <g transform="translate(190, 85)">
                <!-- Top Face -->
                <polygon points="0,-40 45,-15 0,10 -45,-15" fill="url(#cube-top-grad)" stroke="#0c4a6e" stroke-width="1.5"/>
                <!-- Left Face -->
                <polygon points="-45,-15 0,10 0,65 -45,40" fill="url(#cube-left-grad)" stroke="#0c4a6e" stroke-width="1.5"/>
                <!-- Right Face -->
                <polygon points="0,10 45,-15 45,40 0,65" fill="url(#cube-right-grad)" stroke="#0c4a6e" stroke-width="1.5"/>

                <!-- 3 ft Labels on Edges -->
                <text x="-32" y="5" fill="#fef08a" font-size="9" font-weight="700" transform="rotate(30 -32 5)">3 Feet</text>
                <text x="30" y="5" fill="#fef08a" font-size="9" font-weight="700" transform="rotate(-30 30 5)">3 Feet</text>
                <text x="5" y="42" fill="#fef08a" font-size="9" font-weight="700">3 Feet High</text>

                <!-- Center 27 Cu Ft Volume Badge -->
                <text x="0" y="-12" fill="#ffffff" font-size="11" font-weight="800" text-anchor="middle">1 CUBIC YARD</text>
                <text x="0" y="0" fill="#e0f2fe" font-size="8" text-anchor="middle">27 Cu Ft (3'×3'×3')</text>
              </g>

              <!-- Wheelbarrow Silhouette (6 cu ft) -->
              <g transform="translate(315, 135)">
                <!-- Wheel -->
                <circle cx="-25" cy="35" r="10" fill="#18181b" stroke="#71717a" stroke-width="2"/>
                <!-- Tub Tray -->
                <polygon points="-30,10 15,10 25,25 -25,25" fill="#475569" stroke="#334155" stroke-width="1.5"/>
                <!-- Rock in tub -->
                <path d="M -28 10 Q -5 -5 12 10 Z" fill="#94a3b8"/>
                <!-- Handles & Legs -->
                <line x1="15" y1="18" x2="35" y2="12" stroke="#71717a" stroke-width="3"/>
                <line x1="5" y1="25" x2="10" y2="45" stroke="#71717a" stroke-width="2.5"/>
                <text x="0" y="44" fill="#cbd5e1" font-size="8" font-weight="700" text-anchor="middle">6 cu ft Barrow</text>
                <text x="0" y="54" fill="#fbbf24" font-size="7" font-weight="700" text-anchor="middle">4.5 Trips / Yard</text>
              </g>
            </svg>
          </div>

          <div class="scale-stats-grid">
            <div class="sc-node">
              <span class="sc-val" id="viz-cuyd-total">0.0 yd³</span>
              <span class="sc-lbl">Total Cubic Yards</span>
            </div>
            <div class="sc-node">
              <span class="sc-val" id="viz-cuyd-barrow">0 trips</span>
              <span class="sc-lbl">Wheelbarrow Trips</span>
            </div>
            <div class="sc-node">
              <span class="sc-val">324 sq ft</span>
              <span class="sc-lbl">Rule of 324 @ 1"</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Dump Truck Class Capacities -->
      <div class="cuyd-viz-card">
        <div class="card-header">
          <div class="header-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 17h14v-5l-3-4H8L5 12v5z"/></svg>
            <h3>Dump Truck Class Delivery Capacities</h3>
          </div>
          <span class="status-badge green">Commercial Sizer</span>
        </div>

        <div class="truck-class-body">
          <div class="truck-tier-card active" id="tier-single">
            <div class="tier-head">
              <div class="tier-title">Single Axle Dump Truck</div>
              <span class="tier-cap">5 to 7 Cubic Yards</span>
            </div>
            <div class="tier-bar-track">
              <div class="tier-bar-fill" style="width: 35%; background: #38bdf8;"></div>
            </div>
            <p class="tier-desc">Standard residential delivery truck. Fits on narrow driveways and under lower overhead tree branches.</p>
          </div>

          <div class="truck-tier-card" id="tier-tandem">
            <div class="tier-head">
              <div class="tier-title">Tandem Axle Dump Truck</div>
              <span class="tier-cap">10 to 12 Cubic Yards</span>
            </div>
            <div class="tier-bar-track">
              <div class="tier-bar-fill" style="width: 70%; background: #f59e0b;"></div>
            </div>
            <p class="tier-desc">Most popular commercial quarry truck. Heavy payload (14 to 16 tons) requires firm, wide driveways.</p>
          </div>

          <div class="truck-tier-card" id="tier-tri">
            <div class="tier-head">
              <div class="tier-title">Tri-Axle / Quad Dump Truck</div>
              <span class="tier-cap">14 to 16+ Cubic Yards</span>
            </div>
            <div class="tier-bar-track">
              <div class="tier-bar-fill" style="width: 100%; background: #ef4444;"></div>
            </div>
            <p class="tier-desc">Large civil construction hauler. Unloads massive bulk orders; often requires street drop to prevent driveway damage.</p>
          </div>

          <div class="field-tips-box">
            <div class="tip-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              The "Split Load" Delivery Fee Warning
            </div>
            <p>
              Most landscape supply yards charge a flat delivery fee ($75 to $120) per truck trip. If your project requires 13 cubic yards and the supplier only runs single-axle trucks (max 7 yards), you will be charged for two separate delivery trips. Always verify truck capacity before ordering!
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function() {
  function syncCubicYardVisualizer() {
    const yardsEl = document.getElementById('kpi-total-yards');
    const barrowsEl = document.getElementById('kpi-wheelbarrows');

    const totalYards = yardsEl ? parseFloat(yardsEl.textContent) || 0 : 0;
    const barrowTrips = barrowsEl ? parseInt(barrowsEl.textContent) || 0 : 0;

    const totalYdsTxt = document.getElementById('viz-cuyd-total');
    const barrowTxt = document.getElementById('viz-cuyd-barrow');

    if (totalYdsTxt) totalYdsTxt.textContent = totalYards.toFixed(2) + ' yd³';
    if (barrowTxt) barrowTxt.textContent = barrowTrips + ' trips';

    // Highlight active truck tier
    const tSingle = document.getElementById('tier-single');
    const tTandem = document.getElementById('tier-tandem');
    const tTri = document.getElementById('tier-tri');

    if (tSingle) tSingle.className = 'truck-tier-card';
    if (tTandem) tTandem.className = 'truck-tier-card';
    if (tTri) tTri.className = 'truck-tier-card';

    if (totalYards <= 7) {
      if (tSingle) tSingle.className = 'truck-tier-card active';
    } else if (totalYards <= 12) {
      if (tTandem) tTandem.className = 'truck-tier-card active';
    } else {
      if (tTri) tTri.className = 'truck-tier-card active';
    }
  }

  const inputs = ['yd-length', 'yd-width', 'yd-depth', 'yd-waste', 'rev-yards', 'rev-depth'];
  inputs.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', syncCubicYardVisualizer);
      el.addEventListener('change', syncCubicYardVisualizer);
    }
  });

  document.querySelectorAll('.mat-btn, .mode-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      setTimeout(syncCubicYardVisualizer, 50);
    });
  });

  document.addEventListener('DOMContentLoaded', syncCubicYardVisualizer);
  syncCubicYardVisualizer();
})();
</script>

<style>
.cuyd-viz-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-4);
}

@media (max-width: 900px) {
  .cuyd-viz-grid {
    grid-template-columns: 1fr;
  }
}

.cuyd-viz-card {
  background: var(--surface-raised);
  border: 1px solid var(--surface-glass-border);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--surface-glass-border);
  background: rgba(255, 255, 255, 0.02);
}

.header-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.header-title svg {
  color: var(--gold-400);
}

.header-title h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin: 0;
}

.scale-body, .truck-class-body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.scale-svg-wrap {
  background: #090d13;
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  border: 1px solid var(--surface-glass-border);
  display: flex;
  justify-content: center;
}

.scale-svg {
  width: 100%;
  max-width: 380px;
  height: auto;
}

.scale-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.sc-node {
  background: var(--surface-card);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  text-align: center;
  border: 1px solid var(--surface-glass-border);
}

.sc-val {
  display: block;
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--gold-400);
}

.sc-lbl {
  font-size: 0.7rem;
  color: var(--text-secondary);
}

.truck-tier-card {
  background: var(--surface-card);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--surface-glass-border);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  transition: all 0.2s ease;
}

.truck-tier-card.active {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.06);
}

.tier-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tier-title {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text-primary);
}

.tier-cap {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--gold-400);
}

.tier-bar-track {
  height: 6px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.tier-bar-fill {
  height: 100%;
  border-radius: var(--radius-full);
}

.tier-desc {
  font-size: 0.72rem;
  color: var(--text-secondary);
  margin: 0;
  line-height: 1.4;
}

.status-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.status-badge.gold {
  background: rgba(234, 179, 8, 0.12);
  color: #fbbf24;
  border: 1px solid rgba(234, 179, 8, 0.3);
}

.status-badge.green {
  background: rgba(74, 222, 128, 0.12);
  color: #4ade80;
  border: 1px solid rgba(74, 222, 128, 0.3);
}

.field-tips-box {
  background: rgba(234, 179, 8, 0.08);
  border: 1px solid rgba(234, 179, 8, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.tip-title {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: #fbbf24;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: var(--space-2);
}

.field-tips-box p {
  font-size: 0.78rem;
  line-height: 1.55;
  color: var(--text-secondary);
  margin: 0;
}
</style>
