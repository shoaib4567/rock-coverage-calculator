<section class="section" id="bag-calc">
  <div class="container">
    <div class="section-header">
      <h2>Calculate bags from the volume on the label</h2>
      <div class="section-divider"></div>
      <p>Enter your coverage area, finished depth, and the cubic feet printed on your chosen bag. Add labeled weight, pallet quantity, and local prices when you have them.</p>
    </div>
    <div class="bag-grid">
      <div class="bag-panel">
        <h3>Measure the space</h3>
        <fieldset class="bag-choice">
          <legend>Area input</legend>
          <label><input type="radio" name="bag-area-mode" value="rectangle" checked /> Length × width</label>
          <label><input type="radio" name="bag-area-mode" value="known" /> Measured square feet</label>
        </fieldset>
        <div class="bag-fields" id="bag-rectangle-fields">
          <label>Length (ft)<input id="bag-length" type="number" value="10" min="0.01" step="any" inputmode="decimal" /></label>
          <label>Width (ft)<input id="bag-width" type="number" value="10" min="0.01" step="any" inputmode="decimal" /></label>
        </div>
        <label class="bag-single" id="bag-known-field" hidden>Measured area (sq ft)<input id="bag-area" type="number" min="0.01" step="any" inputmode="decimal" placeholder="Total area" /></label>
        <div class="bag-fields">
          <label>Finished layer depth (in)<input id="bag-depth" type="number" value="3" min="0.01" step="any" inputmode="decimal" /></label>
          <label>Extra allowance (%)<input id="bag-extra" type="number" value="0" min="0" max="100" step="any" inputmode="decimal" /></label>
        </div>
        <p class="bag-note">Zero extra suits an even surface. Add an allowance for known unevenness or handling loss; avoid counting a supplier's allowance twice.</p>

        <h3>Read the product label</h3>
        <div class="bag-fields">
          <label>Volume per bag (cu ft)<input id="bag-volume" type="number" value="0.5" min="0.01" step="any" inputmode="decimal" /></label>
          <label>Weight per bag (lb, optional)<input id="bag-weight" type="number" min="0.01" step="any" inputmode="decimal" placeholder="As labeled" /></label>
        </div>
        <label class="bag-single">Bags per pallet (optional)<input id="bag-pallet-size" type="number" min="1" step="1" inputmode="numeric" placeholder="Seller's pallet count" /></label>
        <p class="bag-note">A 50 lb bag does not imply a fixed volume. Find the volume or coverage printed for that specific product before estimating bags.</p>

        <h3>Compare local costs (optional)</h3>
        <div class="bag-fields">
          <label>Price per bag ($)<input id="bag-price" type="number" min="0" step="any" inputmode="decimal" placeholder="Store price" /></label>
          <label>All-in bulk quote ($)<input id="bag-bulk-quote" type="number" min="0" step="any" inputmode="decimal" placeholder="Same rock and quantity" /></label>
        </div>
        <p class="bag-note">Include the bulk minimum and delivery. Tax, your transport, and placement labor are outside this comparison unless included in both prices.</p>
        <p class="bag-error" id="bag-error" role="alert" hidden></p>
      </div>

      <div class="bag-panel bag-results" aria-live="polite" aria-atomic="true">
        <h3>Your bag plan</h3>
        <div class="bag-kpis">
          <div class="bag-kpi bag-primary"><strong id="bag-count">50</strong><span>Whole bags to buy</span><small id="bag-purchased">25 cu ft in purchased bags</small></div>
          <div class="bag-kpi"><strong id="bag-yards">0.93</strong><span>Planned cubic yards</span><small id="bag-planned">25 cu ft including 0% extra</small></div>
          <div class="bag-kpi"><strong id="bag-total-weight">—</strong><span>Total packaged weight</span><small>Needs labeled bag weight</small></div>
          <div class="bag-kpi"><strong id="bag-total-cost">—</strong><span>Bag material cost</span><small>Needs local bag price</small></div>
        </div>
        <div class="bag-detail"><h4>How the count works</h4><p id="bag-volume-line">100 sq ft × 3 in ÷ 12 = 25 cu ft installed.</p><p id="bag-count-line">25 cu ft ÷ 0.5 cu ft per bag = 50; buy 50 whole bags.</p><p id="bag-coverage-line">One 0.5 cu ft bag covers 2 sq ft at 3 in deep, by volume.</p></div>
        <div class="bag-detail"><h4>Handling and ordering</h4><p id="bag-pallet-line">Enter bags per pallet to see the whole-pallet and loose-bag split.</p><p id="bag-haul-line">Enter labeled weight to check the total load against your vehicle's actual payload label, allowing for passengers and other cargo.</p></div>
        <div class="bag-detail bag-quote"><h4>Bags versus a bulk quote</h4><p id="bag-compare-line">Enter a bag price and an all-in bulk quote for the same rock and volume to compare local material costs.</p></div>
      </div>
    </div>
  </div>
</section>

<style>
  .bag-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-6); margin-top:var(--space-6); align-items:start; }
  .bag-panel { min-width:0; background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:var(--space-6); }
  .bag-panel h3 { color:var(--text-primary); font-size:var(--text-lg); margin:0 0 var(--space-4); }
  .bag-panel h3:not(:first-child) { margin-top:var(--space-7); }
  .bag-choice { border:0; padding:0; margin:0 0 var(--space-4); display:flex; flex-wrap:wrap; gap:var(--space-3); }
  .bag-choice legend { color:var(--text-muted); font-size:var(--text-xs); margin-bottom:var(--space-2); }
  .bag-choice label { display:inline-flex; align-items:center; gap:6px; cursor:pointer; color:var(--text-secondary); font-size:var(--text-sm); }
  .bag-choice input { accent-color:var(--accent-gold); }
  .bag-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-3); margin-bottom:var(--space-3); }
  .bag-fields label, .bag-single { display:flex; flex-direction:column; gap:var(--space-1); color:var(--text-secondary); font-size:var(--text-xs); font-weight:600; margin-bottom:var(--space-3); }
  .bag-fields input, .bag-single input { width:100%; min-width:0; padding:.7rem .75rem; border:1px solid var(--border-subtle); border-radius:var(--radius-md); background:var(--bg-surface); color:var(--text-primary); font-size:var(--text-base); }
  .bag-fields input:focus, .bag-single input:focus { outline:2px solid var(--accent-gold); outline-offset:1px; }
  .bag-fields input[aria-invalid="true"], .bag-single input[aria-invalid="true"] { border-color:#dc2626; }
  .bag-note { color:var(--text-muted); font-size:var(--text-xs); line-height:1.55; margin:0 0 var(--space-4); }
  .bag-error { color:#b91c1c; border:1px solid #dc2626; border-radius:var(--radius-md); padding:var(--space-3); font-size:var(--text-sm); }
  [hidden] { display:none !important; }
  .bag-kpis { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-3); }
  .bag-kpi, .bag-detail { background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:var(--space-4); }
  .bag-primary { border-color:var(--accent-gold); }
  .bag-kpi strong { display:block; color:var(--accent-gold); font-size:var(--text-2xl); overflow-wrap:anywhere; }
  .bag-kpi span, .bag-kpi small { display:block; font-size:var(--text-xs); color:var(--text-secondary); }
  .bag-kpi small { margin-top:var(--space-1); color:var(--text-muted); }
  .bag-detail { margin-top:var(--space-3); color:var(--text-secondary); line-height:1.55; }
  .bag-detail h4 { color:var(--text-primary); font-size:var(--text-sm); margin:0 0 var(--space-2); }
  .bag-detail p { font-size:var(--text-sm); margin:var(--space-2) 0 0; overflow-wrap:anywhere; }
  .bag-quote { border-left:3px solid var(--accent-gold); }
  @media(max-width:900px) { .bag-grid { grid-template-columns:1fr; } }
  @media(max-width:520px) { .bag-fields, .bag-kpis { grid-template-columns:1fr; } }
</style>

<script>
  function initBagCalculator() {
    const input = (id: string) => document.getElementById(id) as HTMLInputElement;
    const output = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
    const number = (value: number, digits = 2) => new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
    const required = (element: HTMLInputElement, positive: boolean) => {
      const value = Number(element.value);
      const valid = element.value.trim() !== '' && element.validity.valid && Number.isFinite(value) && (positive ? value > 0 : value >= 0);
      element.setAttribute('aria-invalid', String(!valid));
      return valid ? value : NaN;
    };
    const optional = (element: HTMLInputElement, positive: boolean) => {
      if (element.value.trim() === '') { element.setAttribute('aria-invalid', 'false'); return null; }
      const value = Number(element.value);
      const valid = element.validity.valid && Number.isFinite(value) && (positive ? value > 0 : value >= 0);
      element.setAttribute('aria-invalid', String(!valid));
      return valid ? value : NaN;
    };
    const error = document.getElementById('bag-error') as HTMLElement;
    function calculate() {
      const known = (document.querySelector('input[name="bag-area-mode"]:checked') as HTMLInputElement)?.value === 'known';
      (document.getElementById('bag-rectangle-fields') as HTMLElement).hidden = known;
      (document.getElementById('bag-known-field') as HTMLElement).hidden = !known;
      const length = known ? NaN : required(input('bag-length'), true);
      const width = known ? NaN : required(input('bag-width'), true);
      const measured = known ? required(input('bag-area'), true) : NaN;
      (known ? [input('bag-length'), input('bag-width')] : [input('bag-area')]).forEach(element => element.setAttribute('aria-invalid', 'false'));
      const area = known ? measured : length * width;
      const depth = required(input('bag-depth'), true);
      const extra = required(input('bag-extra'), false);
      const bagVolume = required(input('bag-volume'), true);
      const bagWeight = optional(input('bag-weight'), true);
      const palletSize = optional(input('bag-pallet-size'), true);
      const bagPrice = optional(input('bag-price'), false);
      const bulkQuote = optional(input('bag-bulk-quote'), false);
      const messages: string[] = [];
      const coreValid = Number.isFinite(area) && area > 0 && Number.isFinite(depth) && Number.isFinite(extra) && Number.isFinite(bagVolume);
      if (!coreValid) messages.push('Enter a positive area, depth, and bag volume. Extra can be zero.');
      if (Number.isNaN(bagWeight)) messages.push('Bag weight must be positive or blank.');
      if (Number.isNaN(palletSize)) messages.push('Pallet quantity must be a whole positive number or blank.');
      if (Number.isNaN(bagPrice)) messages.push('Bag price must be zero or more, or blank.');
      if (Number.isNaN(bulkQuote)) messages.push('Bulk quote must be zero or more, or blank.');
      error.hidden = messages.length === 0;
      error.textContent = messages.join(' ');
      if (!coreValid) {
        ['bag-count','bag-purchased','bag-yards','bag-planned','bag-total-weight','bag-total-cost','bag-volume-line','bag-count-line','bag-coverage-line'].forEach(id => output(id, '—'));
        output('bag-pallet-line', 'Correct the measurements to calculate a pallet split.');
        output('bag-haul-line', 'Correct the measurements to calculate packaged weight.');
        output('bag-compare-line', 'Correct the measurements to compare costs.');
        return;
      }
      const installed = area * depth / 12;
      const planned = installed * (1 + extra / 100);
      const bags = Math.max(1, Math.ceil(planned / bagVolume - 1e-9));
      if (!Number.isSafeInteger(bags) || !Number.isFinite(planned)) {
        error.hidden = false;
        error.textContent = 'The entered quantity is too large to calculate a reliable bag count.';
        ['bag-count','bag-purchased','bag-yards','bag-planned','bag-total-weight','bag-total-cost','bag-volume-line','bag-count-line','bag-coverage-line'].forEach(id => output(id, '—'));
        output('bag-pallet-line', 'Reduce the input values to calculate a reliable pallet split.');
        output('bag-haul-line', 'Reduce the input values to calculate a reliable packaged weight.');
        output('bag-compare-line', 'Reduce the input values to compare costs.');
        return;
      }
      output('bag-count', number(bags, 0));
      output('bag-purchased', number(bags * bagVolume) + ' cu ft in purchased bags');
      output('bag-yards', number(planned / 27));
      output('bag-planned', number(planned) + ' cu ft including ' + number(extra) + '% extra');
      output('bag-total-weight', bagWeight === null || Number.isNaN(bagWeight) ? '—' : number(bags * bagWeight, 0) + ' lb');
      output('bag-total-cost', bagPrice === null || Number.isNaN(bagPrice) ? '—' : money.format(bags * bagPrice));
      output('bag-volume-line', number(area) + ' sq ft × ' + number(depth) + ' in ÷ 12 = ' + number(installed) + ' cu ft installed; ' + number(planned) + ' cu ft planned.');
      output('bag-count-line', number(planned) + ' cu ft ÷ ' + number(bagVolume) + ' cu ft per bag = ' + number(planned / bagVolume) + '; round up to ' + number(bags, 0) + ' bags.');
      output('bag-coverage-line', 'One ' + number(bagVolume) + ' cu ft bag covers ' + number(bagVolume * 12 / depth) + ' sq ft at ' + number(depth) + ' in deep, by volume.');
      if (palletSize !== null && !Number.isNaN(palletSize)) {
        const full = Math.floor(bags / palletSize);
        const loose = bags % palletSize;
        output('bag-pallet-line', number(full, 0) + ' full pallet' + (full === 1 ? '' : 's') + ' of ' + number(palletSize, 0) + ' bags, plus ' + number(loose, 0) + ' loose bag' + (loose === 1 ? '' : 's') + '. Confirm the seller allows a split order.');
      } else output('bag-pallet-line', 'Enter bags per pallet to see the whole-pallet and loose-bag split.');
      if (bagWeight !== null && !Number.isNaN(bagWeight)) output('bag-haul-line', number(bags, 0) + ' bags × ' + number(bagWeight) + ' lb = ' + number(bags * bagWeight, 0) + ' lb of packaged rock. Compare each trip with your vehicle’s doorjamb payload label after allowing for passengers and other cargo.');
      else output('bag-haul-line', 'Enter labeled weight to check the total load against your vehicle’s actual payload label, allowing for passengers and other cargo.');
      if (bagPrice !== null && bulkQuote !== null && !Number.isNaN(bagPrice) && !Number.isNaN(bulkQuote)) {
        const bagCost = bags * bagPrice;
        const difference = Math.abs(bagCost - bulkQuote);
        const result = difference < .005 ? 'The entered costs are equal.' : bagCost < bulkQuote ? 'Bags cost ' + money.format(difference) + ' less.' : 'The bulk quote costs ' + money.format(difference) + ' less.';
        output('bag-compare-line', number(bags, 0) + ' bags: ' + money.format(bagCost) + '. Bulk quote: ' + money.format(bulkQuote) + '. ' + result + ' Confirm that material, quantity, delivery, and taxes are comparable.');
      } else output('bag-compare-line', 'Enter a valid bag price and an all-in bulk quote for the same rock and volume to compare local material costs.');
    }
    document.querySelectorAll('#bag-calc input').forEach(element => { element.addEventListener('input', calculate); element.addEventListener('change', calculate); });
    calculate();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBagCalculator);
  else initBagCalculator();
</script>
