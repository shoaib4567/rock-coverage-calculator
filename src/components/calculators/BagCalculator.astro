---
// Rock Bag Calculator & Retail vs Bulk Savings Meter
---
<section class="section" id="bag-calc">
  <div class="container">
    <div class="section-header">
      <h2>Rock Bag & Pallet Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate exact bag counts for 0.5 cu ft, 1.0 cu ft, and 50 lb retail bags, with full pallet breakdowns and a live Bulk Delivery vs Bagged Cost Comparison Meter.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Coverage Area & Depth</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="bag-length">Area Length</label>
            <input type="number" id="bag-length" value="20" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="bag-width">Area Width</label>
            <input type="number" id="bag-width" value="10" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="bag-depth">Layer Depth</label>
            <input type="number" id="bag-depth" value="2.5" min="0.5" max="12" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="bag-waste">Overage Buffer</label>
            <input type="number" id="bag-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Bag Size Selector -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <h3>Retail Bag Size Specification</h3>
        </div>

        <div class="bag-select-grid" role="radiogroup">
          <button type="button" class="bag-btn active" data-type="volume" data-vol="0.5" data-weight="48" data-pallet="60">
            <div class="bag-btn-title">0.5 Cubic Foot Bag</div>
            <div class="bag-btn-spec">Most common retail size | 54 bags / cu yd | ~48 lbs</div>
          </button>
          <button type="button" class="bag-btn" data-type="volume" data-vol="1.0" data-weight="95" data-pallet="30">
            <div class="bag-btn-title">1.0 Cubic Foot Bag</div>
            <div class="bag-btn-spec">Large nursery bag | 27 bags / cu yd | ~95 lbs</div>
          </button>
          <button type="button" class="bag-btn" data-type="weight" data-vol="0.52" data-weight="50" data-pallet="56">
            <div class="bag-btn-title">50 lb Weight Bag</div>
            <div class="bag-btn-spec">Heavy aggregate bag | 40 bags / ton | ~0.52 cu ft</div>
          </button>
        </div>

        <!-- Pricing Comparison Inputs -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3>Retail vs Bulk Price Comparison</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="price-per-bag">Price Per Bag</label>
            <input type="number" id="price-per-bag" value="4.75" min="0" step="0.25" />
            <span class="unit-label">$ / bag</span>
          </div>
          <div class="input-field">
            <label for="price-bulk-yard">Bulk Yard Price</label>
            <input type="number" id="price-bulk-yard" value="65.00" min="0" step="5" />
            <span class="unit-label">$ / cu yd</span>
          </div>
        </div>

        <div class="input-field" style="margin-top: var(--space-2);">
          <label for="bulk-delivery-fee">Flat Bulk Delivery Drop Fee</label>
          <input type="number" id="bulk-delivery-fee" value="75.00" min="0" step="5" />
          <span class="unit-label">$ flat fee</span>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Bagged Material Breakdown</div>
          <div class="results-badge" id="bag-active-badge">0.5 Cu Ft Bags</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-bag-count">0</div>
            <div class="kpi-label">Total Bags to Purchase</div>
            <div class="kpi-subtext" id="kpi-bag-pallets">0 full pallets + 0 loose</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-bag-yards">0.00</div>
            <div class="kpi-label">Total Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-bag-cuft">0 cu ft net volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-bag-weight">0</div>
            <div class="kpi-label">Total Weight (Lbs)</div>
            <div class="kpi-subtext" id="kpi-bag-tons">0.00 tons total load</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-bag-cost">$0</div>
            <div class="kpi-label">Retail Bag Cost</div>
            <div class="kpi-subtext" id="kpi-bulk-cost">vs $0 bulk delivered</div>
          </div>
        </div>

        <!-- Retail vs Bulk Savings Meter -->
        <div class="savings-meter-card">
          <div class="meter-header">
            <span class="meter-title">Financial Decision Meter</span>
            <span class="meter-verdict" id="savings-verdict">Evaluating...</span>
          </div>
          <div class="meter-bar-track">
            <div class="meter-bar-fill" id="savings-bar-fill"></div>
          </div>
          <p class="meter-explanation" id="savings-explanation">
            Comparing retail bagged convenience against bulk quarry delivery economics.
          </p>
        </div>

        <!-- Breakdown List -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Coverage Area</span>
            <span class="breakdown-val" id="row-bag-area">200 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Single Bag Coverage (at current depth)</span>
            <span class="breakdown-val" id="row-bag-coverage">2.4 sq ft / bag</span>
          </div>
          <div class="breakdown-row">
            <span>Standard Pallet Weight</span>
            <span class="breakdown-val" id="row-pallet-weight">2,880 lbs / pallet (60 bags)</span>
          </div>
          <div class="breakdown-row">
            <span>SUV / Pickup Trunk Trips (at 1,000 lbs/trip)</span>
            <span class="breakdown-val" id="row-vehicle-trips">3 trips</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.bag-select-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.bag-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.bag-btn:hover {
  border-color: var(--color-primary-light);
}

.bag-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.bag-btn-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.bag-btn-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.savings-meter-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
}

.meter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}

.meter-title {
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
}

.meter-verdict {
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--color-primary);
}

.meter-bar-track {
  height: 8px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 9999px;
  overflow: hidden;
  margin-bottom: var(--space-2);
}

.meter-bar-fill {
  height: 100%;
  width: 50%;
  background: linear-gradient(90deg, #10b981, #f59e0b, #ef4444);
  transition: width var(--transition-normal);
}

.meter-explanation {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initBagCalculator() {
  const lengthInput = document.getElementById('bag-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('bag-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('bag-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('bag-waste') as HTMLInputElement | null;
  const priceBagInput = document.getElementById('price-per-bag') as HTMLInputElement | null;
  const priceBulkInput = document.getElementById('price-bulk-yard') as HTMLInputElement | null;
  const feeDeliveryInput = document.getElementById('bulk-delivery-fee') as HTMLInputElement | null;

  const bagBtns = document.querySelectorAll('.bag-btn');

  let activeBagVolCuFt = 0.5;
  let activeBagWeightLbs = 48;
  let activeBagsPerPallet = 60;
  let activeBagLabel = '0.5 Cu Ft Bags';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.25, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const pricePerBag = Math.max(0, parseFloat(priceBagInput?.value || '4.75') || 0);
    const pricePerBulkYard = Math.max(0, parseFloat(priceBulkInput?.value || '65.00') || 0);
    const deliveryFee = Math.max(0, parseFloat(feeDeliveryInput?.value || '75.00') || 0);

    const area = length * width;
    const depthFeet = depthInches / 12;
    const grossCuFt = area * depthFeet;
    const totalCuFt = grossCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    // Bag math
    const totalBags = Math.ceil(totalCuFt / activeBagVolCuFt);
    const pallets = Math.floor(totalBags / activeBagsPerPallet);
    const looseBags = totalBags % activeBagsPerPallet;

    // Weight math
    const totalLbs = totalBags * activeBagWeightLbs;
    const totalTons = totalLbs / 2000;

    // Pricing math
    const retailBagTotal = totalBags * pricePerBag;
    const bulkTotal = (totalYards * pricePerBulkYard) + deliveryFee;
    const priceDifference = retailBagTotal - bulkTotal;

    // Single Bag Coverage
    const singleBagSqFt = activeBagVolCuFt / depthFeet;

    // Vehicle trips (assuming average half-ton pickup / SUV payload = 1,000 lbs)
    const vehicleTrips = Math.ceil(totalLbs / 1000);

    // Update KPIs
    const kpiCount = document.getElementById('kpi-bag-count');
    const kpiPallets = document.getElementById('kpi-bag-pallets');
    const kpiYards = document.getElementById('kpi-bag-yards');
    const kpiCuFt = document.getElementById('kpi-bag-cuft');
    const kpiWeight = document.getElementById('kpi-bag-weight');
    const kpiTons = document.getElementById('kpi-bag-tons');
    const kpiBagCost = document.getElementById('kpi-bag-cost');
    const kpiBulkCost = document.getElementById('kpi-bulk-cost');
    const badge = document.getElementById('bag-active-badge');

    if (kpiCount) kpiCount.textContent = totalBags.toLocaleString();
    if (kpiPallets) {
      if (pallets > 0) {
        kpiPallets.textContent = `${pallets} pallet${pallets === 1 ? '' : 's'} + ${looseBags} loose bag${looseBags === 1 ? '' : 's'}`;
      } else {
        kpiPallets.textContent = `${looseBags} loose bags (No full pallet)`;
      }
    }
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft total volume`;
    if (kpiWeight) kpiWeight.textContent = `${Math.round(totalLbs).toLocaleString()}`;
    if (kpiTons) kpiTons.textContent = `${totalTons.toFixed(2)} tons total load`;
    if (kpiBagCost) kpiBagCost.textContent = `$${Math.round(retailBagTotal).toLocaleString()}`;
    if (kpiBulkCost) kpiBulkCost.textContent = `vs $${Math.round(bulkTotal).toLocaleString()} bulk delivered`;
    if (badge) badge.textContent = activeBagLabel;

    // Savings Decision Meter
    const verdictEl = document.getElementById('savings-verdict');
    const explanationEl = document.getElementById('savings-explanation');
    const fillEl = document.getElementById('savings-bar-fill');

    if (totalBags <= 25) {
      if (verdictEl) verdictEl.textContent = 'Buy Retail Bags (Smartest)';
      if (explanationEl) {
        explanationEl.textContent = `For small quantities (${totalBags} bags), buying bagged rock is more cost-effective because the $${deliveryFee.toFixed(0)} bulk dump truck drop fee exceeds any bulk material savings.`;
      }
      if (fillEl) fillEl.style.width = '25%';
    } else if (retailBagTotal <= bulkTotal) {
      if (verdictEl) verdictEl.textContent = 'Bags Competitive with Bulk';
      if (explanationEl) {
        explanationEl.textContent = `At ${totalBags} bags ($${Math.round(retailBagTotal)}), retail bags are roughly equal to bulk delivery ($${Math.round(bulkTotal)}). Bags offer cleaner site storage and zero driveway dump cleanup.`;
      }
      if (fillEl) fillEl.style.width = '50%';
    } else {
      const savings = retailBagTotal - bulkTotal;
      if (verdictEl) verdictEl.textContent = `Bulk Delivery Saves $${Math.round(savings).toLocaleString()}`;
      if (explanationEl) {
        explanationEl.textContent = `Switching to bulk quarry delivery will save you approximately $${Math.round(savings).toLocaleString()}! You need ${totalYards.toFixed(1)} cubic yards (${totalBags} bags), which justifies the flat freight fee.`;
      }
      if (fillEl) fillEl.style.width = '90%';
    }

    // Breakdown Rows
    const rowArea = document.getElementById('row-bag-area');
    const rowCoverage = document.getElementById('row-bag-coverage');
    const rowPallet = document.getElementById('row-pallet-weight');
    const rowTrips = document.getElementById('row-vehicle-trips');

    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowCoverage) rowCoverage.textContent = `${singleBagSqFt.toFixed(1)} sq ft / bag at ${depthInches}" depth`;
    if (rowPallet) rowPallet.textContent = `${(activeBagsPerPallet * activeBagWeightLbs).toLocaleString()} lbs / pallet (${activeBagsPerPallet} bags)`;
    if (rowTrips) rowTrips.textContent = `${vehicleTrips} vehicle trip${vehicleTrips === 1 ? '' : 's'} (based on 1,000 lbs/trip limit)`;
  }

  // Bag button selector
  bagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      bagBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeBagVolCuFt = parseFloat(btn.getAttribute('data-vol') || '0.5');
      activeBagWeightLbs = parseFloat(btn.getAttribute('data-weight') || '48');
      activeBagsPerPallet = parseInt(btn.getAttribute('data-pallet') || '60', 10);
      const titleEl = btn.querySelector('.bag-btn-title');
      if (titleEl) activeBagLabel = titleEl.textContent || 'Bags';
      calculate();
    });
  });

  // Input events
  [lengthInput, widthInput, depthInput, wasteInput, priceBagInput, priceBulkInput, feeDeliveryInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initBagCalculator);
</script>
