---
// Crushed landscape stone order estimator
import { getMaterialById } from '../../scripts/materials-data.js';

const cleanStoneDensity = getMaterialById('clean-stone-57').tonsPerCuYd;
const denseBaseDensity = getMaterialById('crusher-run-21a').tonsPerCuYd;
const decomposedGraniteDensity = getMaterialById('decomposed-granite').tonsPerCuYd;
---
<section class="section" id="stone-calc">
  <div class="container">
    <div class="section-header">
      <h2>Estimate the stone to order</h2>
      <div class="section-divider"></div>
      <p>Enter the area and finished layer depth. Select a stone, then replace the sample loose density and settlement allowance with numbers from your local supplier when available.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Choose a loose stone</h3>
        </div>

        <div class="stone-spec-grid" aria-label="Stone examples">
          <button type="button" class="spec-btn active" aria-pressed="true" data-type="clean" data-density={cleanStoneDensity} data-compaction="0" data-name="Clean #57 stone">
            <div class="spec-title">Clean #57 angular stone</div>
            <div class="spec-detail">Open graded; for drainage or a specified open graded base. Starts at 0% loose-to-placed loss.</div>
          </button>
          <button type="button" class="spec-btn" aria-pressed="false" data-type="dense" data-density={denseBaseDensity} data-compaction="15" data-name="Dense graded base">
            <div class="spec-title">Dense graded base / crusher run</div>
            <div class="spec-detail">Stone plus fines for a compacted base. Starts with an editable 15% loose-to-finished loss.</div>
          </button>
          <button type="button" class="spec-btn" aria-pressed="false" data-type="dg" data-density={decomposedGraniteDensity} data-compaction="10" data-name="Decomposed granite">
            <div class="spec-title">Decomposed granite (DG)</div>
            <div class="spec-detail">For a compacted path surface; stabilizers vary by product. Starts with an editable 10% loss.</div>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Measure the area</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="stone-length">Length</label>
            <input type="number" id="stone-length" value="20" min="0.1" step="any" inputmode="decimal" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="stone-width">Width</label>
            <input type="number" id="stone-width" value="20" min="0.1" step="any" inputmode="decimal" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="stone-compacted-depth">Finished Layer Depth</label>
            <input type="number" id="stone-compacted-depth" value="4" min="0.1" max="36" step="any" inputmode="decimal" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="stone-waste">Extra for Low Spots / Spillage</label>
            <input type="number" id="stone-waste" value="5" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <div class="input-field density-field">
          <label for="stone-density">Loose Bulk Density <span>(short tons per cubic yard)</span></label>
          <input type="number" id="stone-density" value={cleanStoneDensity} min="0.3" max="3" step="0.01" inputmode="decimal" />
          <p>Example only. Ask the yard for the weight of one loose cubic yard of your selected stone.</p>
        </div>

        <!-- Editable settlement allowance -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M8 5l4-3 4 3M8 19l4 3 4-3"/></svg>
          <h3>Loose-to-Finished Volume Loss</h3>
        </div>

        <div class="range-container">
          <div class="range-header">
            <label for="stone-compaction-slider">Estimated loss as material settles or compacts</label>
            <span class="range-val" id="compaction-display">0% (Clean #57 stone)</span>
          </div>
          <input type="range" id="stone-compaction-slider" min="0" max="30" value="0" step="1" />
          <p class="calc-assumption">This is a planning input, not a fixed property of #57, crusher run, or DG. A 20% loss means 1 loose yard becomes 0.8 finished yard; order volume is finished volume ÷ 0.8.</p>
          <p id="stone-input-error" class="calc-error" role="alert" hidden>Check the highlighted fields: use positive dimensions, a depth up to 36 in, a density from 0.3 to 3, and 0–25% extra.</p>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Order estimate</div>
          <div class="results-badge" id="stone-badge">Clean #57 stone · 0% loss</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-stone-tons">0.00</div>
            <div class="kpi-label">Estimated Short Tons to Order</div>
            <div class="kpi-subtext" id="kpi-stone-lbs">US short tons × 2,000 lb</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-loose-yards">0.00</div>
            <div class="kpi-label">Loose Cubic Yards to Order</div>
            <div class="kpi-subtext" id="kpi-loose-depth">Before placement</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-compacted-yards">0.00</div>
            <div class="kpi-label">Finished Layer Volume</div>
            <div class="kpi-subtext" id="kpi-shrinkage-loss">Includes voids between stones</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-stone-sqft">0</div>
            <div class="kpi-label">Surface Area (Sq Ft)</div>
            <div class="kpi-subtext" id="kpi-stone-geotextile">Length × width</div>
          </div>
        </div>

        <!-- Compaction Cross Section Diagram -->
        <div class="compaction-diagram-card">
          <div class="diagram-title">Placement depth at the selected loss</div>
          <div class="diagram-bars">
            <div class="bar-col">
              <div class="bar-fill loose-bar" id="bar-loose">
                <span id="bar-loose-text">Loose: 4.0"</span>
              </div>
              <div class="bar-caption">Before settling</div>
            </div>
            <div class="bar-arrow">→</div>
            <div class="bar-col">
              <div class="bar-fill compact-bar" id="bar-compact">
                <span id="bar-compact-text">Finished: 4.0"</span>
              </div>
              <div class="bar-caption">Finished layer</div>
            </div>
          </div>
          <p class="diagram-note">
            The extra percentage for low spots or spillage is included in the order quantity, not in the loose depth shown here. Check the actual layer with a grade stake as you place it.
          </p>
        </div>

        <!-- Breakdown List -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Finished Layer</span>
            <span class="breakdown-val" id="row-compact-cuft">133.3 cu ft (4.94 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Loose Before Extra</span>
            <span class="breakdown-val" id="row-base-loose">133.3 cu ft (4.94 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Loose Delivery Volume to Order</span>
            <span class="breakdown-val highlight-order" id="row-loose-cuft">140.0 cu ft (5.19 yd³)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field input[aria-invalid="true"] {
  border-color: #f87171;
  box-shadow: 0 0 0 1px #f87171;
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.density-field {
  margin: var(--space-3) 0 var(--space-5);
}

.density-field input {
  max-width: 12rem;
}

.density-field label span,
.density-field p,
.calc-assumption {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  line-height: 1.5;
}

.density-field p,
.calc-assumption {
  margin: var(--space-2) 0 0;
}

.calc-error {
  color: #fca5a5;
  font-size: var(--text-sm);
  margin: var(--space-3) 0 0;
}

.calc-error[hidden] { display: none; }

.stone-spec-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.spec-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.spec-btn:hover {
  border-color: var(--color-primary-light);
}

.spec-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.spec-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.spec-detail {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.range-container {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.range-header {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
}

.range-val {
  color: var(--color-primary);
  font-weight: 600;
}

.range-container input[type="range"] {
  width: 100%;
  accent-color: var(--color-primary);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

@media (max-width: 520px) {
  .kpi-grid { grid-template-columns: 1fr; }
  .kpi-card {
    display: grid;
    grid-template-columns: minmax(4rem, auto) 1fr;
    column-gap: var(--space-3);
    align-items: center;
    text-align: left;
  }
  .kpi-value { grid-row: 1 / span 2; }
  .kpi-label { margin-top: 0; }
  .kpi-subtext { grid-column: 2; line-height: 1.35; overflow-wrap: anywhere; }
}

.compaction-diagram-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.diagram-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-3);
}

.diagram-bars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  height: 90px;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 110px;
  height: 100%;
}

.bar-fill {
  width: 100%;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.65rem;
  font-weight: 700;
  transition: height var(--transition-normal);
}

.loose-bar {
  height: 65px;
  background: #f59e0b;
}

.compact-bar {
  height: 52px;
  background: #059669;
}

.bar-arrow {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  font-weight: 700;
}

.bar-caption {
  font-size: 0.7rem;
  color: var(--color-text-muted);
  margin-top: 4px;
}

.diagram-note {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin: var(--space-2) 0 0 0;
  line-height: 1.35;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
  gap: var(--space-3);
  flex-wrap: wrap;
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}

.highlight-order {
  color: var(--color-primary);
}
</style>

<script>
function initLandscapeStoneCalculator() {
  const lengthInput = document.getElementById('stone-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('stone-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('stone-compacted-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('stone-waste') as HTMLInputElement | null;
  const densityInput = document.getElementById('stone-density') as HTMLInputElement | null;
  const compactionSlider = document.getElementById('stone-compaction-slider') as HTMLInputElement | null;
  const compactionDisplay = document.getElementById('compaction-display');
  const error = document.getElementById('stone-input-error');

  const specBtns = document.querySelectorAll<HTMLButtonElement>('#stone-calc .spec-btn');
  let activeSpecName = 'Clean #57 stone';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput || !densityInput || !compactionSlider) return;

    const length = Number(lengthInput.value);
    const width = Number(widthInput.value);
    const finishedDepth = Number(depthInput.value);
    const extraPercent = Number(wasteInput.value);
    const density = Number(densityInput.value);
    const lossPercent = Number(compactionSlider.value);
    const numberInputs = [lengthInput, widthInput, depthInput, wasteInput, densityInput];
    const valid = numberInputs.map(input => {
      const inputValid = input.value !== '' && input.checkValidity() && Number.isFinite(Number(input.value));
      if (inputValid) {
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-describedby');
      } else {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', 'stone-input-error');
      }
      return inputValid;
    }).every(Boolean);
    if (error) error.hidden = valid;
    if (!valid) {
      const resetText: Record<string, string> = {
        'kpi-stone-tons': '—', 'kpi-stone-lbs': 'Enter valid inputs',
        'kpi-loose-yards': '—', 'kpi-loose-depth': 'Enter valid inputs',
        'kpi-compacted-yards': '—', 'kpi-shrinkage-loss': 'Enter valid inputs',
        'kpi-stone-sqft': '—', 'kpi-stone-geotextile': 'Enter valid inputs',
        'bar-loose-text': 'Loose: —', 'bar-compact-text': 'Finished: —',
        'row-compact-cuft': '—', 'row-base-loose': '—', 'row-loose-cuft': '—',
        'stone-badge': 'Check inputs'
      };
      Object.entries(resetText).forEach(([id, value]) => {
        const target = document.getElementById(id);
        if (target) target.textContent = value;
      });
      return;
    }

    if (compactionDisplay) {
      compactionDisplay.textContent = `${lossPercent}% (${activeSpecName})`;
    }

    const area = length * width;
    const finishedCuFt = area * finishedDepth / 12;
    const finishedYards = finishedCuFt / 27;
    // Loss describes the share of loose volume removed during placement:
    // finished = looseBeforeExtra × (1 - loss).
    const remainingFraction = 1 - lossPercent / 100;
    const looseBeforeExtraCuFt = finishedCuFt / remainingFraction;
    const orderCuFt = looseBeforeExtraCuFt * (1 + extraPercent / 100);
    const orderYards = orderCuFt / 27;
    const placementDepth = finishedDepth / remainingFraction;
    const tons = orderYards * density;

    const kpiTons = document.getElementById('kpi-stone-tons');
    const kpiLbs = document.getElementById('kpi-stone-lbs');
    const kpiLooseYds = document.getElementById('kpi-loose-yards');
    const kpiLooseDepth = document.getElementById('kpi-loose-depth');
    const kpiCompactYds = document.getElementById('kpi-compacted-yards');
    const kpiShrinkage = document.getElementById('kpi-shrinkage-loss');
    const kpiSqFt = document.getElementById('kpi-stone-sqft');
    const kpiFabric = document.getElementById('kpi-stone-geotextile');
    const badge = document.getElementById('stone-badge');

    if (kpiTons) kpiTons.textContent = tons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(tons * 2000).toLocaleString()} lb estimated at ${density.toFixed(2)} tons/yd³`;
    if (kpiLooseYds) kpiLooseYds.textContent = orderYards.toFixed(2);
    if (kpiLooseDepth) kpiLooseDepth.textContent = `About ${placementDepth.toFixed(1)}" placed loose, before the extra allowance`;
    if (kpiCompactYds) kpiCompactYds.textContent = finishedYards.toFixed(2) + ' yd³';
    if (kpiShrinkage) kpiShrinkage.textContent = `${finishedDepth.toFixed(1)}" finished depth`;
    if (kpiSqFt) kpiSqFt.textContent = Math.round(area).toLocaleString();
    if (kpiFabric) kpiFabric.textContent = `${length.toLocaleString()} ft × ${width.toLocaleString()} ft`;
    if (badge) badge.textContent = `${activeSpecName} · ${lossPercent}% loss`;

    const barLooseText = document.getElementById('bar-loose-text');
    const barCompactText = document.getElementById('bar-compact-text');
    if (barLooseText) barLooseText.textContent = `Loose: ${placementDepth.toFixed(1)}"`;
    if (barCompactText) barCompactText.textContent = `Finished: ${finishedDepth.toFixed(1)}"`;

    const rowCompact = document.getElementById('row-compact-cuft');
    const rowBaseLoose = document.getElementById('row-base-loose');
    const rowLoose = document.getElementById('row-loose-cuft');
    if (rowCompact) rowCompact.textContent = `${finishedCuFt.toFixed(1)} cu ft (${finishedYards.toFixed(2)} yd³)`;
    if (rowBaseLoose) rowBaseLoose.textContent = `${looseBeforeExtraCuFt.toFixed(1)} cu ft (${(looseBeforeExtraCuFt / 27).toFixed(2)} yd³)`;
    if (rowLoose) rowLoose.textContent = `${orderCuFt.toFixed(1)} cu ft (${orderYards.toFixed(2)} yd³)`;

    document.dispatchEvent(new CustomEvent('landscape-stone-calculated', { detail: {
      finishedDepth, placementDepth, lossPercent, finishedYards, looseBeforeExtraYards: looseBeforeExtraCuFt / 27, orderYards
    } }));
  }

  specBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      specBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      activeSpecName = btn.dataset.name || 'Stone';
      if (densityInput && btn.dataset.density) densityInput.value = btn.dataset.density;
      if (compactionSlider) compactionSlider.value = btn.dataset.compaction || '0';
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput, densityInput, compactionSlider].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initLandscapeStoneCalculator);
</script>
