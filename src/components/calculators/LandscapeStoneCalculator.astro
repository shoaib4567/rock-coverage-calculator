---
// Landscape Stone & Mechanical Compaction Shrinkage Calculator
---
<section class="section" id="stone-calc">
  <div class="container">
    <div class="section-header">
      <h2>Landscape Stone & Base Compaction Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate exact tonnage and loose quarry delivery volume for clean drainage stone vs dense-graded base (#411 / crusher run) accounting for 20% roller compaction shrinkage.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Stone Specification & Grading</h3>
        </div>

        <div class="stone-spec-grid" role="radiogroup">
          <button type="button" class="spec-btn active" data-type="clean" data-density="1.35" data-compaction="5">
            <div class="spec-title">#57 Clean Crushed Limestone (3/4")</div>
            <div class="spec-detail">Washed aggregate without dust / fines | 5% natural settlement</div>
          </button>
          <button type="button" class="spec-btn" data-type="dense" data-density="1.50" data-compaction="20">
            <div class="spec-title">#411 / Crusher Run (With Fines)</div>
            <div class="spec-detail">Structural base for driveways & patios | 20% plate roller compaction</div>
          </button>
          <button type="button" class="spec-btn" data-type="dg" data-density="1.45" data-compaction="18">
            <div class="spec-title">Decomposed Granite (Stabilized DG)</div>
            <div class="spec-detail">Pathways & pet runs | 18% compaction shrinkage</div>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Target Project Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="stone-length">Length</label>
            <input type="number" id="stone-length" value="30" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="stone-width">Width</label>
            <input type="number" id="stone-width" value="15" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="stone-compacted-depth">Finished Compacted Depth</label>
            <input type="number" id="stone-compacted-depth" value="4.0" min="1" max="18" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="stone-waste">Subgrade Irregularity Buffer</label>
            <input type="number" id="stone-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Compaction Slider -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M8 5l4-3 4 3M8 19l4 3 4-3"/></svg>
          <h3>Compaction Shrinkage Factor</h3>
        </div>

        <div class="range-container">
          <div class="range-header">
            <span>Compaction Loss Allowance</span>
            <span class="range-val" id="compaction-display">20% (Crusher Run)</span>
          </div>
          <input type="range" id="stone-compaction-slider" min="0" max="30" value="20" step="1" />
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Loose vs Compacted Order Specs</div>
          <div class="results-badge" id="stone-badge">Crusher Run (20% Compaction)</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-stone-tons">0.00</div>
            <div class="kpi-label">Quarry Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-stone-lbs">0 lbs total delivery</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-loose-yards">0.00</div>
            <div class="kpi-label">Loose Delivery (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-loose-depth">Pour 4.8" loose to get 4" compacted</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-compacted-yards">0.00</div>
            <div class="kpi-label">Compacted Solid Volume</div>
            <div class="kpi-subtext" id="kpi-shrinkage-loss">0.0 yd³ lost to compaction</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-stone-sqft">0</div>
            <div class="kpi-label">Surface Area (Sq Ft)</div>
            <div class="kpi-subtext" id="kpi-stone-geotextile">500 sq ft stabilization fabric</div>
          </div>
        </div>

        <!-- Compaction Cross Section Diagram -->
        <div class="compaction-diagram-card">
          <div class="diagram-title">Compaction Shrinkage Cross Section</div>
          <div class="diagram-bars">
            <div class="bar-col">
              <div class="bar-fill loose-bar" id="bar-loose">
                <span id="bar-loose-text">Loose Dump: 4.8"</span>
              </div>
              <div class="bar-caption">Uncompacted Pour</div>
            </div>
            <div class="bar-arrow">→</div>
            <div class="bar-col">
              <div class="bar-fill compact-bar" id="bar-compact">
                <span id="bar-compact-text">Finished Base: 4.0"</span>
              </div>
              <div class="bar-caption">After Plate Compactor</div>
            </div>
          </div>
          <p class="diagram-note">
            Dense graded stone with fines packs into microscopic air voids. Ordering only the theoretical compacted volume will leave your project short!
          </p>
        </div>

        <!-- Breakdown List -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Theoretical In-Place Volume</span>
            <span class="breakdown-val" id="row-compact-cuft">150.0 cu ft (5.5 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Loose Delivery Volume to Order</span>
            <span class="breakdown-val highlight-order" id="row-loose-cuft">187.5 cu ft (6.9 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Plate Compactor Equipment</span>
            <span class="breakdown-val">Reversible 3,000 to 5,000 lbf vibratory tamper</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.stone-spec-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.spec-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.spec-btn:hover {
  border-color: var(--color-primary-light);
}

.spec-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.spec-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.spec-detail {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.range-container {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.range-header {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
}

.range-val {
  color: var(--color-primary);
  font-weight: 600;
}

.range-container input[type="range"] {
  width: 100%;
  accent-color: var(--color-primary);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.compaction-diagram-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.diagram-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-3);
}

.diagram-bars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  height: 90px;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 110px;
  height: 100%;
}

.bar-fill {
  width: 100%;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.65rem;
  font-weight: 700;
  transition: height var(--transition-normal);
}

.loose-bar {
  height: 65px;
  background: #f59e0b;
}

.compact-bar {
  height: 52px;
  background: #059669;
}

.bar-arrow {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  font-weight: 700;
}

.bar-caption {
  font-size: 0.7rem;
  color: var(--color-text-muted);
  margin-top: 4px;
}

.diagram-note {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin: var(--space-2) 0 0 0;
  line-height: 1.35;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}

.highlight-order {
  color: var(--color-primary);
}
</style>

<script>
function initLandscapeStoneCalculator() {
  const lengthInput = document.getElementById('stone-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('stone-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('stone-compacted-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('stone-waste') as HTMLInputElement | null;
  const compactionSlider = document.getElementById('stone-compaction-slider') as HTMLInputElement | null;
  const compactionDisplay = document.getElementById('compaction-display');

  const specBtns = document.querySelectorAll('.spec-btn');

  let activeDensity = 1.35; // clean stone default
  let activeCompaction = 5; // clean stone default 5%
  let activeSpecName = '#57 Clean Stone';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const compactedDepthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    let compactionPercent = parseFloat(compactionSlider?.value || '20') || 0;
    if (compactionDisplay) {
      compactionDisplay.textContent = `${compactionPercent}% (${activeSpecName})`;
    }

    const area = length * width;
    
    // Theoretical compacted volume in place
    const compactedCuFt = area * (compactedDepthInches / 12);
    const compactedYards = compactedCuFt / 27;

    // Loose dump volume required:
    // When compacted, volume = Loose * (1 - compaction/100).
    // Therefore: Loose = Compacted / (1 - compaction/100)
    const compactionFactor = 1 - (compactionPercent / 100);
    const looseCuFtBeforeWaste = compactionFactor > 0 ? (compactedCuFt / compactionFactor) : compactedCuFt;
    
    // Add excavation irregularity / safety buffer
    const looseCuFt = looseCuFtBeforeWaste * (1 + wastePercent / 100);
    const looseYards = looseCuFt / 27;

    // Required loose pour depth to achieve target compacted depth
    const looseDepthInches = (compactedDepthInches / compactionFactor) * (1 + wastePercent / 100);

    // Tonnage (based on uncompacted quarry delivery density)
    const netTons = looseYards * activeDensity;
    const netLbs = netTons * 2000;

    // Volume lost to compaction
    const lostYards = Math.max(0, looseYards - compactedYards);

    // Update KPI displays
    const kpiTons = document.getElementById('kpi-stone-tons');
    const kpiLbs = document.getElementById('kpi-stone-lbs');
    const kpiLooseYds = document.getElementById('kpi-loose-yards');
    const kpiLooseDepth = document.getElementById('kpi-loose-depth');
    const kpiCompactYds = document.getElementById('kpi-compacted-yards');
    const kpiShrinkage = document.getElementById('kpi-shrinkage-loss');
    const kpiSqFt = document.getElementById('kpi-stone-sqft');
    const kpiFabric = document.getElementById('kpi-stone-geotextile');
    const badge = document.getElementById('stone-badge');

    if (kpiTons) kpiTons.textContent = netTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(netLbs).toLocaleString()} lbs net delivery`;
    if (kpiLooseYds) kpiLooseYds.textContent = looseYards.toFixed(2);
    if (kpiLooseDepth) kpiLooseDepth.textContent = `Pour ${looseDepthInches.toFixed(1)}" loose to achieve ${compactedDepthInches}" compacted`;
    if (kpiCompactYds) kpiCompactYds.textContent = compactedYards.toFixed(2) + ' yd³';
    if (kpiShrinkage) kpiShrinkage.textContent = `${lostYards.toFixed(2)} yd³ packed into void space`;
    if (kpiSqFt) kpiSqFt.textContent = Math.round(area).toLocaleString();
    if (kpiFabric) kpiFabric.textContent = `${Math.round(area * 1.10).toLocaleString()} sq ft stabilization fabric`;
    if (badge) badge.textContent = `${activeSpecName} (${compactionPercent}% Compaction)`;

    // Diagram updates
    const barLooseText = document.getElementById('bar-loose-text');
    const barCompactText = document.getElementById('bar-compact-text');
    if (barLooseText) barLooseText.textContent = `Loose Dump: ${looseDepthInches.toFixed(1)}"`;
    if (barCompactText) barCompactText.textContent = `Finished Base: ${compactedDepthInches.toFixed(1)}"`;

    // Row updates
    const rowCompact = document.getElementById('row-compact-cuft');
    const rowLoose = document.getElementById('row-loose-cuft');
    if (rowCompact) rowCompact.textContent = `${compactedCuFt.toFixed(1)} cu ft (${compactedYards.toFixed(2)} yd³) in place`;
    if (rowLoose) rowLoose.textContent = `${looseCuFt.toFixed(1)} cu ft (${looseYards.toFixed(2)} yd³) quarry order`;
  }

  specBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      specBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDensity = parseFloat(btn.getAttribute('data-density') || '1.35');
      activeCompaction = parseInt(btn.getAttribute('data-compaction') || '5', 10);
      const titleEl = btn.querySelector('.spec-title');
      if (titleEl) activeSpecName = titleEl.textContent || 'Stone';

      if (compactionSlider) {
        compactionSlider.value = activeCompaction.toString();
      }
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput, compactionSlider].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initLandscapeStoneCalculator);
</script>
