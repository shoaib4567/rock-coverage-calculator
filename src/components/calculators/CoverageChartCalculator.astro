---
// Interactive Rock Coverage Chart & Dynamic Depth Matrix Calculator
---
<section class="section" id="chart-calc">
  <div class="container">
    <div class="section-header">
      <h2>Interactive Rock Coverage Chart & Depth Matrix</h2>
      <div class="section-divider"></div>
      <p>Instant coverage lookup table showing square feet per cubic yard, square feet per ton, and exact material requirements across 1" to 6" depths for any custom project size.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Customize Your Coverage Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="chart-length">Area Length</label>
            <input type="number" id="chart-length" value="30" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="chart-width">Area Width</label>
            <input type="number" id="chart-width" value="10" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="chart-waste">Safety Buffer</label>
            <input type="number" id="chart-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
          <div class="input-field">
            <label for="chart-density-select">Rock Material</label>
            <select id="chart-density-select" class="custom-select" aria-label="Select rock material density">
              <option value="1.35">River Rock / Gravel (#57) (1.35 T/yd³)</option>
              <option value="1.40">Crushed Granite / Limestone (1.40 T/yd³)</option>
              <option value="1.50">Dense Graded Base with Fines (1.50 T/yd³)</option>
              <option value="0.75">Volcanic Lava Rock (0.75 T/yd³)</option>
            </select>
          </div>
        </div>

        <!-- Quick Summary Box -->
        <div class="quick-summary-box">
          <div class="summary-headline">Total Surface Area: <span id="chart-total-sqft">300</span> Sq Ft</div>
          <p class="summary-subtext">Review the live coverage table on the right to compare material volume and quarry weight at each installed layer thickness.</p>
        </div>
      </div>

      <!-- Output Panel: Live Dynamic Coverage Matrix Table -->
      <div class="calc-results-panel animate-fade-in-up" style="padding: var(--space-4);">
        <div class="results-header">
          <div class="results-title">Coverage Reference Table (Live)</div>
          <div class="results-badge" id="chart-density-badge">1.35 Tons/yd³</div>
        </div>

        <div class="chart-table-wrap">
          <table class="chart-table">
            <thead>
              <tr>
                <th>Depth</th>
                <th>Sq Ft / Yard</th>
                <th>Sq Ft / Ton</th>
                <th>Cubic Yards</th>
                <th>Quarry Tons</th>
                <th>0.5 ft³ Bags</th>
              </tr>
            </thead>
            <tbody id="chart-table-body">
              <!-- Dynamically rendered rows -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input, .custom-select {
  padding: 0.65rem 0.75rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input {
  padding-right: 3.5rem;
}

.input-field input:focus, .custom-select:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.quick-summary-box {
  background: rgba(202, 138, 4, 0.08);
  border: 1px solid rgba(202, 138, 4, 0.2);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  margin-top: var(--space-4);
}

.summary-headline {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-primary);
}

.summary-subtext {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin: var(--space-1) 0 0 0;
  line-height: 1.4;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.chart-table-wrap {
  overflow-x: auto;
}

.chart-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.75rem;
}

.chart-table th {
  text-align: left;
  padding: 8px 10px;
  border-bottom: 2px solid var(--color-border);
  color: var(--color-text-muted);
  font-weight: 600;
  white-space: nowrap;
}

.chart-table td {
  padding: 8px 10px;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text);
  white-space: nowrap;
}

.chart-table tr:hover td {
  background: rgba(202, 138, 4, 0.05);
}

.chart-table tr.highlight-depth td {
  background: rgba(202, 138, 4, 0.12);
  font-weight: 700;
  color: var(--color-primary);
}
</style>

<script>
function initCoverageChartCalculator() {
  const lengthInput = document.getElementById('chart-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('chart-width') as HTMLInputElement | null;
  const wasteInput = document.getElementById('chart-waste') as HTMLInputElement | null;
  const densitySelect = document.getElementById('chart-density-select') as HTMLSelectElement | null;

  const totalSqFtDisplay = document.getElementById('chart-total-sqft');
  const badgeDisplay = document.getElementById('chart-density-badge');
  const tbody = document.getElementById('chart-table-body');

  function calculate() {
    if (!lengthInput || !widthInput || !wasteInput || !tbody) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;
    const density = parseFloat(densitySelect?.value || '1.35') || 1.35;

    const area = length * width;
    if (totalSqFtDisplay) totalSqFtDisplay.textContent = Math.round(area).toLocaleString();
    if (badgeDisplay) badgeDisplay.textContent = `${density.toFixed(2)} Tons/yd³`;

    // Standard depths: 1", 1.5", 2", 2.5", 3", 3.5", 4", 6"
    const depthList = [1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 6.0];

    tbody.innerHTML = depthList.map(d => {
      // 1 yd³ = 324 sq ft at 1" depth
      const sqFtPerYard = (324 / d).toFixed(0);
      // 1 ton = (1 / density) yards
      const sqFtPerTon = ((324 / d) / density).toFixed(0);

      // Calculations for user's dimensions
      const netCuFt = area * (d / 12);
      const totalCuFt = netCuFt * (1 + wastePercent / 100);
      const totalYards = (totalCuFt / 27).toFixed(2);
      const totalTons = ((totalCuFt / 27) * density).toFixed(2);
      const bags = Math.ceil(totalCuFt / 0.5);

      const isDefaultDepth = d === 3.0;

      return `
        <tr class="${isDefaultDepth ? 'highlight-depth' : ''}">
          <td><strong>${d.toFixed(1)}" Depth</strong></td>
          <td>${sqFtPerYard} sq ft</td>
          <td>${sqFtPerTon} sq ft</td>
          <td><strong>${totalYards} yd³</strong></td>
          <td><strong>${totalTons} T</strong></td>
          <td>${bags.toLocaleString()} bags</td>
        </tr>
      `;
    }).join('');
  }

  [lengthInput, widthInput, wasteInput, densitySelect].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initCoverageChartCalculator);
</script>
