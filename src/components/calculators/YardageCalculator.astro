---
// Rock Yardage Calculator & Quarry Procurement Rounder
---
<section class="section" id="yardage-calc">
  <div class="container">
    <div class="section-header">
      <h2>Rock Yardage & Bulk Procurement Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate bulk yardage requirements with commercial quarry half-yard and full-yard rounding, delivery site clearances, and wheelbarrow hauling labor math.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          <h3>Project Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="yardage-length">Length</label>
            <input type="number" id="yardage-length" value="45" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="yardage-width">Width</label>
            <input type="number" id="yardage-width" value="12" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="yardage-depth">Depth</label>
            <input type="number" id="yardage-depth" value="3.0" min="0.5" max="18" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="yardage-waste">Quarry Safety Buffer</label>
            <input type="number" id="yardage-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Commercial Order Rounding Selector -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <h3>Quarry Order Rounding Increment</h3>
        </div>

        <div class="round-select-grid" role="radiogroup">
          <button type="button" class="round-btn active" data-round="0.5">
            <div class="round-title">Half Yard (0.5 yd³) Rounding</div>
            <div class="round-spec">Standard landscape yard loader bucket calibration</div>
          </button>
          <button type="button" class="round-btn" data-round="1.0">
            <div class="round-title">Full Yard (1.0 yd³) Rounding</div>
            <div class="round-spec">Commercial quarry dispatch minimum standard</div>
          </button>
          <button type="button" class="round-btn" data-round="0.0">
            <div class="round-title">Exact Theoretical Volume</div>
            <div class="round-spec">Raw unrounded volume for precision estimating</div>
          </button>
        </div>

        <!-- Hauling Equipment Selector -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 17h14v-5l-3-4H8L5 12v5z"/></svg>
          <h3>Site Hauling Method</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="wheelbarrow-type">Wheelbarrow Size</label>
            <select id="wheelbarrow-type" class="custom-select">
              <option value="6">6 cu ft Contractor Barrow</option>
              <option value="4">4 cu ft Homeowner Barrow</option>
              <option value="10">10 cu ft Power Motor Buggy</option>
            </select>
          </div>
          <div class="input-field">
            <label for="yard-mat-dens">Rock Material</label>
            <select id="yard-mat-dens" class="custom-select">
              <option value="1.35">River Rock (1.35 T/yd³)</option>
              <option value="1.40">Crushed Stone (1.40 T/yd³)</option>
              <option value="0.85">Lava Rock (0.85 T/yd³)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Procurement Order Specs</div>
          <div class="results-badge" id="procure-badge">Order: 5.5 Cubic Yards</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-order-yards">0.0</div>
            <div class="kpi-label">Commercial Order Quantity</div>
            <div class="kpi-subtext" id="kpi-exact-calc">Calculated: 0.00 yd³</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-procure-tons">0.00</div>
            <div class="kpi-label">Total Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-procure-lbs">0 lbs bulk weight</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-barrow-trips">0</div>
            <div class="kpi-label">Hauling Barrow Trips</div>
            <div class="kpi-subtext" id="kpi-barrow-spec">6 cu ft barrow loads</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-sqft-covered">0</div>
            <div class="kpi-label">Coverage Area (Sq Ft)</div>
            <div class="kpi-subtext" id="kpi-sqft-rate">1 yd³ = 108 sq ft @ 3"</div>
          </div>
        </div>

        <!-- Site Delivery Safety Checklist -->
        <div class="checklist-card">
          <div class="checklist-title">Quarry Dump Truck Site Safety Clearance</div>
          <div class="checklist-items">
            <div class="check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>Overhead Clearance:</strong> Verify minimum 14-foot vertical clearance free of tree limbs and utility cables.</span>
            </div>
            <div class="check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>Driveway Rating:</strong> Tandem haulers weigh over 40,000 lbs fully loaded; specify curbside drop if driveway is thin concrete.</span>
            </div>
            <div class="check-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>Ground Tarp Protection:</strong> Lay heavy 20×30 ft poly tarps before dumping to ensure 100% clean aggregate shoveling.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input, .custom-select {
  padding: 0.65rem 0.75rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input {
  padding-right: 3.5rem;
}

.input-field input:focus, .custom-select:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.round-select-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.round-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.round-btn:hover {
  border-color: var(--color-primary-light);
}

.round-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.round-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.round-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.checklist-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
}

.checklist-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-3);
}

.checklist-items {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
}

.check-item svg {
  flex-shrink: 0;
  margin-top: 2px;
}
</style>

<script>
function initYardageCalculator() {
  const lengthInput = document.getElementById('yardage-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('yardage-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('yardage-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('yardage-waste') as HTMLInputElement | null;
  const barrowSelect = document.getElementById('wheelbarrow-type') as HTMLSelectElement | null;
  const densitySelect = document.getElementById('yard-mat-dens') as HTMLSelectElement | null;

  const roundBtns = document.querySelectorAll('.round-btn');

  let activeRounding = 0.5; // default 0.5 yard

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.25, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const barrowCuFt = parseFloat(barrowSelect?.value || '6') || 6;
    const density = parseFloat(densitySelect?.value || '1.35') || 1.35;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const calculatedCuFt = netCuFt * (1 + wastePercent / 100);
    const calculatedYards = calculatedCuFt / 27;

    // Commercial Rounding
    let orderYards = calculatedYards;
    if (activeRounding === 0.5) {
      orderYards = Math.ceil(calculatedYards * 2) / 2;
    } else if (activeRounding === 1.0) {
      orderYards = Math.ceil(calculatedYards);
    }

    const orderCuFt = orderYards * 27;
    const totalTons = orderYards * density;
    const totalLbs = totalTons * 2000;

    // Hauling trips
    const trips = Math.ceil(orderCuFt / barrowCuFt);

    // Update KPI displays
    const kpiOrder = document.getElementById('kpi-order-yards');
    const kpiCalc = document.getElementById('kpi-exact-calc');
    const kpiTons = document.getElementById('kpi-procure-tons');
    const kpiLbs = document.getElementById('kpi-procure-lbs');
    const kpiTrips = document.getElementById('kpi-barrow-trips');
    const kpiSpec = document.getElementById('kpi-barrow-spec');
    const kpiSqFt = document.getElementById('kpi-sqft-covered');
    const badge = document.getElementById('procure-badge');

    if (kpiOrder) kpiOrder.textContent = orderYards.toFixed(1);
    if (kpiCalc) kpiCalc.textContent = `Calculated: ${calculatedYards.toFixed(2)} yd³`;
    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs net`;
    if (kpiTrips) kpiTrips.textContent = trips.toString();
    if (kpiSpec) kpiSpec.textContent = `${barrowCuFt} cu ft barrow loads`;
    if (kpiSqFt) kpiSqFt.textContent = Math.round(area).toLocaleString();
    if (badge) badge.textContent = `Order: ${orderYards.toFixed(1)} Cubic Yards`;
  }

  roundBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      roundBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeRounding = parseFloat(btn.getAttribute('data-round') || '0.5');
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput, barrowSelect, densitySelect].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initYardageCalculator);
</script>
