---
// The quantity math uses bulk volume, then an editable supplier weight per cubic yard.
---
<section class="section river-calculator" id="river-rock-calc" aria-labelledby="river-calc-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="river-calc-heading">Estimate river rock in cubic yards, tons, and bags</h2>
      <div class="section-divider"></div>
      <p>Measure the area you will actually cover, choose the installed depth, and add a small ordering allowance. Weight uses an editable bulk density because river rock varies by supplier.</p>
    </div>

    <div class="river-calc-grid">
      <div class="river-calc-card">
        <h3>1. Measure your space</h3>
        <p class="calc-help">For a rectangular bed, use its length and width. For an irregular bed, divide it into simple sections and add their results.</p>
        <div class="river-input-grid">
          <div class="river-field">
            <label for="river-length">Length <span>(feet)</span></label>
            <input id="river-length" type="number" min="0.1" step="0.1" value="30" inputmode="decimal" />
          </div>
          <div class="river-field">
            <label for="river-width">Width <span>(feet)</span></label>
            <input id="river-width" type="number" min="0.1" step="0.1" value="10" inputmode="decimal" />
          </div>
        </div>

        <h3>2. Pick stone size and depth</h3>
        <p class="calc-help">Sizes are supplier trade ranges, not exact sieve specifications. Depth buttons are starting points for a decorative bed; inspect a sample and adjust for the coverage you want.</p>
        <div class="river-size-grid" aria-label="River rock size">
          <button class="river-size" type="button" data-depth="2" aria-pressed="false">
            <strong>¾–1 in</strong><span>Small pebble · start at 2 in</span>
          </button>
          <button class="river-size is-active" type="button" data-depth="3" aria-pressed="true">
            <strong>1–3 in</strong><span>Mixed river rock · start at 3 in</span>
          </button>
          <button class="river-size" type="button" data-depth="4" aria-pressed="false">
            <strong>2–4 in</strong><span>Large stone · start at 4 in</span>
          </button>
          <button class="river-size" type="button" data-depth="5" aria-pressed="false">
            <strong>3–5 in</strong><span>Cobbles · estimate at 5 in</span>
          </button>
        </div>
        <div class="river-input-grid">
          <div class="river-field">
            <label for="river-depth">Installed layer depth <span>(inches)</span></label>
            <input id="river-depth" type="number" min="0.1" step="0.25" value="3" inputmode="decimal" />
          </div>
          <div class="river-field">
            <label for="river-extra">Extra to order <span>(percent)</span></label>
            <input id="river-extra" type="number" min="0" max="100" step="1" value="10" inputmode="decimal" />
          </div>
        </div>

        <h3>3. Match your supplier's units</h3>
        <div class="river-input-grid">
          <div class="river-field">
            <label for="river-density">Bulk weight <span>(US short tons per yd³)</span></label>
            <input id="river-density" type="number" min="0.1" max="3" step="0.01" value="1.35" inputmode="decimal" />
          </div>
          <div class="river-field">
            <label for="river-bag-volume">Bag volume <span>(ft³ per bag)</span></label>
            <input id="river-bag-volume" type="number" min="0.1" step="0.1" value="0.5" inputmode="decimal" />
          </div>
        </div>
        <p class="calc-help">The 1.35 short ton/yd³ default is an estimating assumption, not a product specification. Use the weight from your stone yard when available. For bagged stone, read the bag's labeled volume.</p>
      </div>

      <div class="river-calc-card river-results" aria-live="polite">
        <p class="result-eyebrow">Estimated order, including extra</p>
        <div class="river-result-grid">
          <div class="river-result main-result"><strong id="river-yards">3.06</strong><span>cubic yards</span></div>
          <div class="river-result"><strong id="river-tons">4.13</strong><span>US short tons</span></div>
          <div class="river-result"><strong id="river-bags">165</strong><span>bags at your entered size</span></div>
        </div>
        <p class="result-status" id="river-status">Based on 300 sq ft at 3 in depth, plus 10% extra.</p>
        <dl class="river-breakdown">
          <div><dt>Measured plan area</dt><dd id="river-area">300 sq ft</dd></div>
          <div><dt>Stone before extra</dt><dd id="river-net">2.78 yd³</dd></div>
          <div><dt>Order volume</dt><dd id="river-order-volume">82.5 ft³</dd></div>
          <div><dt>One ton covers at this depth</dt><dd id="river-yield">about 80 sq ft</dd></div>
        </dl>
        <div class="river-result-note">
          <strong>For a dry creek bed:</strong> measure the stone-lined surface across the bottom and both banks. This calculator does not size a channel for storm flow or prove that a chosen rock will stay in place.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .river-calculator { padding-top: var(--space-8); }
  .river-calc-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: var(--space-6); align-items: start; }
  .river-calc-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: var(--space-6); color: var(--text-secondary); }
  .river-calc-card h3 { color: var(--text-primary); font-size: var(--text-lg); margin: var(--space-5) 0 var(--space-2); }
  .river-calc-card h3:first-child { margin-top: 0; }
  .calc-help { font-size: var(--text-sm); line-height: 1.6; margin: 0 0 var(--space-4); }
  .river-input-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
  .river-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .river-field label { color: var(--text-primary); font-size: var(--text-sm); font-weight: 650; }
  .river-field label span { color: var(--text-muted); font-weight: 400; }
  .river-field input { width: 100%; min-width: 0; padding: .7rem .8rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-primary); font: inherit; }
  .river-field input:focus-visible, .river-size:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .river-size-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-2); margin-bottom: var(--space-4); }
  .river-size { text-align: left; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: .7rem; color: var(--text-secondary); cursor: pointer; }
  .river-size strong { display: block; color: var(--text-primary); font-size: var(--text-base); }
  .river-size span { font-size: var(--text-xs); }
  .river-size.is-active { border-color: var(--accent-gold); background: rgba(212, 168, 83, .1); }
  .river-results { position: sticky; top: 1rem; }
  .result-eyebrow { text-transform: uppercase; letter-spacing: .08em; color: var(--accent-gold); font-size: var(--text-xs); font-weight: 700; margin: 0 0 var(--space-3); }
  .river-result-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-3); }
  .river-result { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .river-result.main-result { grid-column: 1/-1; border-color: var(--accent-gold); }
  .river-result strong { display: block; color: var(--text-primary); font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.1; }
  .river-result span { font-size: var(--text-sm); color: var(--text-muted); }
  .result-status { font-size: var(--text-sm); margin: var(--space-4) 0; }
  .river-breakdown { margin: 0; }
  .river-breakdown div { display: flex; justify-content: space-between; gap: var(--space-3); border-top: 1px solid var(--border-subtle); padding: var(--space-3) 0; font-size: var(--text-sm); }
  .river-breakdown dd { margin: 0; font-weight: 700; color: var(--text-primary); text-align: right; }
  .river-result-note { background: rgba(212, 168, 83, .08); border-left: 3px solid var(--accent-gold); border-radius: var(--radius-sm); padding: var(--space-3); font-size: var(--text-sm); line-height: 1.6; margin-top: var(--space-3); }
  .river-result-note strong { color: var(--text-primary); }
  @media (max-width: 860px) { .river-calc-grid { grid-template-columns: 1fr; } .river-results { position: static; } }
  @media (max-width: 430px) { .river-input-grid, .river-size-grid { grid-template-columns: 1fr; } .river-calc-card { padding: var(--space-4); } }
</style>

<script>
  const number = (id: string) => Number((document.getElementById(id) as HTMLInputElement | null)?.value);
  const output = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };
  const inputs = ['river-length','river-width','river-depth','river-extra','river-density','river-bag-volume'];

  function updateRiverEstimate() {
    const length = number('river-length');
    const width = number('river-width');
    const depth = number('river-depth');
    const extra = number('river-extra');
    const density = number('river-density');
    const bagVolume = number('river-bag-volume');
    const valid = [length,width,depth,density,bagVolume].every(value => Number.isFinite(value) && value > 0)
      && Number.isFinite(extra) && extra >= 0 && extra <= 100 && density <= 3;
    if (!valid) {
      ['river-yards','river-tons','river-bags','river-area','river-net','river-order-volume','river-yield'].forEach(id => output(id,'—'));
      output('river-status','Enter positive dimensions, depth, bulk weight, and bag volume; extra must be 0–100%.');
      return;
    }
    const area = length * width;
    const netCubicFeet = area * depth / 12;
    const orderCubicFeet = netCubicFeet * (1 + extra / 100);
    const orderYards = orderCubicFeet / 27;
    const orderTons = orderYards * density;
    const bagRatio = orderCubicFeet / bagVolume;
    const nearestWholeBag = Math.round(bagRatio);
    const roundingTolerance = Number.EPSILON * Math.max(1, Math.abs(bagRatio)) * 8;
    const bags = Math.ceil(
      Math.abs(bagRatio - nearestWholeBag) <= roundingTolerance ? nearestWholeBag : bagRatio
    );
    const yieldPerTon = 324 / (density * depth);
    output('river-yards', orderYards.toFixed(2));
    output('river-tons', orderTons.toFixed(2));
    output('river-bags', bags.toLocaleString());
    output('river-area', area.toLocaleString(undefined,{maximumFractionDigits:1}) + ' sq ft');
    output('river-net', (netCubicFeet / 27).toFixed(2) + ' yd³');
    output('river-order-volume', orderCubicFeet.toFixed(1) + ' ft³');
    output('river-yield', 'about ' + Math.round(yieldPerTon).toLocaleString() + ' sq ft');
    output('river-status', 'Based on ' + area.toLocaleString(undefined,{maximumFractionDigits:1}) + ' sq ft at ' + depth + ' in depth, plus ' + extra + '% extra.');
  }

  inputs.forEach(id => document.getElementById(id)?.addEventListener('input',updateRiverEstimate));
  document.querySelectorAll<HTMLButtonElement>('.river-size').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.river-size').forEach(other => {
        other.classList.remove('is-active');
        other.setAttribute('aria-pressed','false');
      });
      button.classList.add('is-active');
      button.setAttribute('aria-pressed','true');
      const depthInput = document.getElementById('river-depth') as HTMLInputElement | null;
      if (depthInput) depthInput.value = button.dataset.depth || '3';
      updateRiverEstimate();
    });
  });
  updateRiverEstimate();
</script>
