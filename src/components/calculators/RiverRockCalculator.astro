---
import { getMaterialById } from '../../scripts/materials-data.js';

const river1to3 = getMaterialById('river-rock-1');
const river3to5 = getMaterialById('river-rock-3-5');
---
<section class="section river-calculator" id="river-rock-calc" aria-labelledby="river-calc-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="river-calc-heading">Estimate river rock in cubic yards, short tons, bags, or coverage</h2>
      <div class="section-divider"></div>
      <p>Switch between bed measurements, known square footage, or reverse coverage from stone you already have. Weight uses editable bulk density ({river1to3.tonsPerCuYd} short tons/yd³ for 1–3" cobble, {river3to5.tonsPerCuYd} for 3–5" rock).</p>
    </div>

    <div class="river-calc-grid">
      <div class="river-calc-card">
        <h3>1. Choose calculation mode</h3>
        <div class="river-mode-tabs" role="tablist" aria-label="River rock calculation mode">
          <button type="button" class="river-mode-btn is-active" role="tab" aria-selected="true" data-mode="dimensions">Length &times; Width</button>
          <button type="button" class="river-mode-btn" role="tab" aria-selected="false" data-mode="area">Known Sq Ft</button>
          <button type="button" class="river-mode-btn" role="tab" aria-selected="false" data-mode="reverse">Tons / Yards &rarr; Area</button>
        </div>

        <div id="river-panel-dimensions" class="river-input-grid">
          <div class="river-field">
            <label for="river-length">Length <span>(feet)</span></label>
            <input id="river-length" type="number" min="0.1" step="any" value="30" inputmode="decimal" />
          </div>
          <div class="river-field">
            <label for="river-width">Width <span>(feet)</span></label>
            <input id="river-width" type="number" min="0.1" step="any" value="10" inputmode="decimal" />
          </div>
        </div>

        <div id="river-panel-area" class="river-input-grid single" hidden>
          <div class="river-field">
            <label for="river-known-area">Covered surface area <span>(sq ft)</span></label>
            <input id="river-known-area" type="number" min="0.1" step="any" value="300" inputmode="decimal" />
          </div>
        </div>

        <div id="river-panel-reverse" class="river-input-grid" hidden>
          <div class="river-field">
            <label for="river-supply-qty">Available rock quantity</label>
            <input id="river-supply-qty" type="number" min="0.01" step="any" value="2" inputmode="decimal" />
          </div>
          <div class="river-field">
            <label for="river-supply-unit">Supply unit</label>
            <select id="river-supply-unit">
              <option value="tons">Short tons (2,000 lb)</option>
              <option value="yards">Cubic yards</option>
              <option value="bags">Bags (enter volume below)</option>
            </select>
          </div>
        </div>

        <h3>2. Pick stone size &amp; installed depth</h3>
        <p class="calc-help">Larger rounded stones create bigger voids and need deeper fill so base fabric stays hidden. Selecting a size updates suggested depth and planning bulk density.</p>
        <div class="river-size-grid" aria-label="River rock size">
          <button class="river-size" type="button" data-depth="2" data-density="1.35" aria-pressed="false">
            <strong>&frac34;&ndash;1 in</strong><span>Small pebble &middot; 2 in &middot; 1.35 t/yd³</span>
          </button>
          <button class="river-size is-active" type="button" data-depth="3" data-density={river1to3.tonsPerCuYd} aria-pressed="true">
            <strong>1&ndash;3 in</strong><span>River rock &middot; 3 in &middot; {river1to3.tonsPerCuYd} t/yd³</span>
          </button>
          <button class="river-size" type="button" data-depth="4" data-density={river1to3.tonsPerCuYd} aria-pressed="false">
            <strong>2&ndash;4 in</strong><span>Large stone &middot; 4 in &middot; {river1to3.tonsPerCuYd} t/yd³</span>
          </button>
          <button class="river-size" type="button" data-depth="5" data-density={river3to5.tonsPerCuYd} aria-pressed="false">
            <strong>3&ndash;5 in</strong><span>Cobbles &middot; 5 in &middot; {river3to5.tonsPerCuYd} t/yd³</span>
          </button>
        </div>

        <div class="river-input-grid">
          <div class="river-field">
            <label for="river-depth">Installed depth <span>(inches)</span></label>
            <input id="river-depth" type="number" min="0.1" step="any" value="3" inputmode="decimal" />
          </div>
          <div class="river-field" id="river-extra-wrap">
            <label for="river-extra">Extra to order <span>(percent)</span></label>
            <input id="river-extra" type="number" min="0" max="100" step="any" value="10" inputmode="decimal" />
          </div>
        </div>

        <h3>3. Match supplier bulk weight &amp; rounding</h3>
        <div class="river-input-grid three-col">
          <div class="river-field">
            <label for="river-density">Bulk weight <span>(short tons/yd³)</span></label>
            <input id="river-density" type="number" min="0.1" max="3" step="any" value={river1to3.tonsPerCuYd} inputmode="decimal" />
          </div>
          <div class="river-field">
            <label for="river-bag-volume">Bag volume <span>(ft³/bag)</span></label>
            <input id="river-bag-volume" type="number" min="0.05" step="any" value="0.5" inputmode="decimal" />
          </div>
          <div class="river-field" id="river-round-wrap">
            <label for="river-increment">Seller rounding</label>
            <select id="river-increment">
              <option value="0">Exact</option>
              <option value="0.25">0.25 yd³</option>
              <option value="0.5">0.50 yd³</option>
              <option value="1">1.00 yd³</option>
            </select>
          </div>
        </div>
        <p class="river-error" id="river-error" role="alert" hidden></p>
      </div>

      <div class="river-calc-card river-results" aria-live="polite">
        <p class="result-eyebrow" id="river-eyebrow">Estimated order, including extra</p>
        <div class="river-result-grid">
          <div class="river-result main-result"><strong id="river-yards">3.06</strong><span id="river-main-unit">cubic yards</span></div>
          <div class="river-result"><strong id="river-tons">4.05</strong><span id="river-sec1-unit">short tons</span></div>
          <div class="river-result"><strong id="river-bags">165</strong><span id="river-sec2-unit">bags at entered volume</span></div>
        </div>
        <p class="result-status" id="river-status">Based on 300 sq ft at 3 in depth, plus 10% extra.</p>
        <dl class="river-breakdown">
          <div><dt id="river-b1-lbl">Measured plan area</dt><dd id="river-area">300 sq ft</dd></div>
          <div><dt id="river-b2-lbl">Stone before extra</dt><dd id="river-net">2.78 yd³</dd></div>
          <div><dt id="river-b3-lbl">Order volume</dt><dd id="river-order-volume">82.5 ft³</dd></div>
          <div><dt id="river-b4-lbl">One ton covers at this depth</dt><dd id="river-yield">about 81 sq ft</dd></div>
        </dl>
        <div class="river-result-note">
          <strong>Dry creek &amp; swale tip:</strong> Measure stone-lined bottom and sloped banks combined; see our <a href="/dry-creek-bed">dry creek bed lining guide</a> for cross-section planning.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .river-calculator { padding-top: var(--space-8); }
  .river-calc-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: var(--space-6); align-items: start; }
  .river-calc-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: var(--space-6); color: var(--text-secondary); }
  .river-calc-card h3 { color: var(--text-primary); font-size: var(--text-lg); margin: var(--space-5) 0 var(--space-2); }
  .river-calc-card h3:first-child { margin-top: 0; }
  .calc-help { font-size: var(--text-sm); line-height: 1.6; margin: 0 0 var(--space-4); }
  .river-mode-tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
  .river-mode-btn { padding: .5rem .85rem; border-radius: 999px; border: 1px solid var(--border-subtle); background: var(--bg-surface); color: var(--text-secondary); font-size: var(--text-xs); font-weight: 700; cursor: pointer; }
  .river-mode-btn.is-active { background: var(--accent-gold); border-color: var(--accent-gold); color: var(--text-inverse); }
  .river-input-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
  .river-input-grid.single { grid-template-columns: 1fr; }
  .river-input-grid.three-col { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .river-input-grid[hidden], [hidden] { display: none !important; }
  .river-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .river-field label { color: var(--text-primary); font-size: var(--text-sm); font-weight: 650; }
  .river-field label span { color: var(--text-muted); font-weight: 400; }
  .river-field input, .river-field select { width: 100%; min-width: 0; padding: .7rem .8rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-primary); font: inherit; }
  .river-field input[aria-invalid="true"] { border-color: var(--color-error); }
  .river-field input:focus-visible, .river-field select:focus-visible, .river-size:focus-visible, .river-mode-btn:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .river-size-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-2); margin-bottom: var(--space-4); }
  .river-size { text-align: left; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: .7rem; color: var(--text-secondary); cursor: pointer; }
  .river-size strong { display: block; color: var(--text-primary); font-size: var(--text-base); }
  .river-size span { font-size: var(--text-xs); }
  .river-size.is-active { border-color: var(--accent-gold); background: rgba(212, 168, 83, .12); }
  .river-error { color: var(--color-error); font-size: var(--text-sm); font-weight: 600; margin: var(--space-2) 0 0; }
  .river-results { position: sticky; top: 1rem; }
  .result-eyebrow { text-transform: uppercase; letter-spacing: .08em; color: var(--accent-gold); font-size: var(--text-xs); font-weight: 700; margin: 0 0 var(--space-3); }
  .river-result-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-3); }
  .river-result { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .river-result.main-result { grid-column: 1/-1; border-color: var(--accent-gold); }
  .river-result strong { display: block; color: var(--text-primary); font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.1; }
  .river-result span { font-size: var(--text-sm); color: var(--text-muted); }
  .result-status { font-size: var(--text-sm); margin: var(--space-4) 0; }
  .river-breakdown { margin: 0; }
  .river-breakdown div { display: flex; justify-content: space-between; gap: var(--space-3); border-top: 1px solid var(--border-subtle); padding: var(--space-3) 0; font-size: var(--text-sm); }
  .river-breakdown dd { margin: 0; font-weight: 700; color: var(--text-primary); text-align: right; }
  .river-result-note { background: rgba(212, 168, 83, .08); border-left: 3px solid var(--accent-gold); border-radius: var(--radius-sm); padding: var(--space-3); font-size: var(--text-sm); line-height: 1.6; margin-top: var(--space-3); }
  .river-result-note strong { color: var(--text-primary); }
  .river-result-note a { color: var(--accent-gold); text-decoration: underline; }
  @media (max-width: 860px) { .river-calc-grid { grid-template-columns: 1fr; } .river-results { position: static; } .river-input-grid.three-col { grid-template-columns: 1fr; } }
  @media (max-width: 430px) { .river-input-grid, .river-size-grid { grid-template-columns: 1fr; } .river-calc-card { padding: var(--space-4); } }
</style>

<script>
  const el = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
  const num = (id: string) => {
    const f = el(id);
    if (!f || f.value.trim() === '') return NaN;
    return Number(f.value);
  };
  const out = (id: string, val: string) => { const n = document.getElementById(id); if (n) n.textContent = val; };
  let mode = 'dimensions';

  function syncSizeButtons() {
    const currentDepth = num('river-depth');
    document.querySelectorAll<HTMLButtonElement>('.river-size').forEach(btn => {
      const match = Number(btn.dataset.depth) === currentDepth;
      btn.classList.toggle('is-active', match);
      btn.setAttribute('aria-pressed', String(match));
    });
  }

  function updateRiverEstimate() {
    const depth = num('river-depth');
    const density = num('river-density');
    const bagVolume = num('river-bag-volume');
    const extra = num('river-extra');
    const increment = Number((el('river-increment') as HTMLSelectElement | null)?.value || 0);
    const errEl = document.getElementById('river-error');

    let valid = Number.isFinite(depth) && depth > 0 && depth <= 36
      && Number.isFinite(density) && density >= 0.1 && density <= 3
      && Number.isFinite(bagVolume) && bagVolume >= 0.05 && bagVolume <= 10;

    if (mode === 'reverse') {
      const qty = num('river-supply-qty');
      const unit = (el('river-supply-unit') as HTMLSelectElement | null)?.value || 'tons';
      valid = valid && Number.isFinite(qty) && qty > 0;
      el('river-supply-qty')?.setAttribute('aria-invalid', String(!(Number.isFinite(qty) && qty > 0)));
      el('river-depth')?.setAttribute('aria-invalid', String(!(Number.isFinite(depth) && depth > 0 && depth <= 36)));
      el('river-density')?.setAttribute('aria-invalid', String(!(Number.isFinite(density) && density >= 0.1 && density <= 3)));
      el('river-bag-volume')?.setAttribute('aria-invalid', String(!(Number.isFinite(bagVolume) && bagVolume >= 0.05 && bagVolume <= 10)));

      if (errEl) {
        errEl.hidden = valid;
        errEl.textContent = valid ? '' : 'Enter positive supply quantity, depth (<= 36 in), bulk weight (0.1–3.0 t/yd³), and bag volume.';
      }
      if (!valid) {
        ['river-yards', 'river-tons', 'river-bags', 'river-area', 'river-net', 'river-order-volume', 'river-yield'].forEach(i => out(i, '—'));
        return;
      }

      const cuFt = unit === 'tons' ? (qty / density) * 27 : unit === 'yards' ? qty * 27 : qty * bagVolume;
      const cuYd = cuFt / 27;
      const tons = cuYd * density;
      const sqFt = cuFt / (depth / 12);
      const yieldTon = 324 / (density * depth);

      out('river-eyebrow', 'Estimated coverage area from available stone');
      out('river-yards', Math.round(sqFt).toLocaleString('en'));
      out('river-main-unit', 'square feet covered');
      out('river-tons', cuYd.toFixed(2));
      out('river-sec1-unit', 'cubic yards');
      out('river-bags', tons.toFixed(2));
      out('river-sec2-unit', 'short tons');
      out('river-status', `${qty} ${unit} at ${depth} in installed depth covers about ${Math.round(sqFt).toLocaleString('en')} sq ft.`);
      out('river-b1-lbl', 'Volume represented');
      out('river-area', `${cuFt.toFixed(1)} ft³`);
      out('river-b2-lbl', 'Bags equivalent');
      out('river-net', `${Math.max(1, Math.ceil(cuFt / bagVolume - 1e-9)).toLocaleString('en')} bags`);
      out('river-b3-lbl', 'Per cubic yard at depth');
      out('river-order-volume', `about ${Math.round(324 / depth).toLocaleString('en')} sq ft`);
      out('river-b4-lbl', 'One short ton at depth');
      out('river-yield', `about ${Math.round(yieldTon).toLocaleString('en')} sq ft`);
      return;
    }

    const length = num('river-length');
    const width = num('river-width');
    const knownArea = num('river-known-area');
    const area = mode === 'area' ? knownArea : length * width;
    const areaOk = mode === 'area'
      ? Number.isFinite(knownArea) && knownArea > 0 && knownArea <= 1e7
      : Number.isFinite(length) && length > 0 && Number.isFinite(width) && width > 0 && Number.isFinite(area) && area <= 1e7;
    const extraOk = Number.isFinite(extra) && extra >= 0 && extra <= 100;
    valid = valid && areaOk && extraOk;

    el('river-length')?.setAttribute('aria-invalid', String(mode === 'dimensions' && !(Number.isFinite(length) && length > 0)));
    el('river-width')?.setAttribute('aria-invalid', String(mode === 'dimensions' && !(Number.isFinite(width) && width > 0)));
    el('river-known-area')?.setAttribute('aria-invalid', String(mode === 'area' && !(Number.isFinite(knownArea) && knownArea > 0)));
    el('river-depth')?.setAttribute('aria-invalid', String(!(Number.isFinite(depth) && depth > 0 && depth <= 36)));
    el('river-extra')?.setAttribute('aria-invalid', String(!extraOk));
    el('river-density')?.setAttribute('aria-invalid', String(!(Number.isFinite(density) && density >= 0.1 && density <= 3)));
    el('river-bag-volume')?.setAttribute('aria-invalid', String(!(Number.isFinite(bagVolume) && bagVolume >= 0.05 && bagVolume <= 10)));

    if (errEl) {
      errEl.hidden = valid;
      errEl.textContent = valid ? '' : 'Enter positive measurements, depth (<= 36 in), extra (0–100%), bulk weight (0.1–3.0), and bag volume.';
    }
    if (!valid) {
      ['river-yards', 'river-tons', 'river-bags', 'river-area', 'river-net', 'river-order-volume', 'river-yield'].forEach(i => out(i, '—'));
      out('river-status', 'Correct the highlighted inputs to calculate.');
      return;
    }

    const netCuFt = area * depth / 12;
    const rawOrderCuFt = netCuFt * (1 + extra / 100);
    const rawOrderYards = rawOrderCuFt / 27;
    const orderYards = increment > 0 ? Math.ceil((rawOrderYards - 1e-9) / increment) * increment : rawOrderYards;
    const orderTons = orderYards * density;
    const bags = Math.max(1, Math.ceil((orderYards * 27) / bagVolume - 1e-9));
    const yieldPerTon = 324 / (density * depth);

    out('river-eyebrow', increment > 0 ? `Order rounded to ${increment} yd³ step` : 'Estimated order, including extra');
    out('river-yards', orderYards.toFixed(2));
    out('river-main-unit', 'cubic yards');
    out('river-tons', orderTons.toFixed(2));
    out('river-sec1-unit', 'short tons');
    out('river-bags', bags.toLocaleString('en'));
    out('river-sec2-unit', `bags (${bagVolume} ft³)`);
    out('river-status', `Based on ${area.toLocaleString('en', { maximumFractionDigits: 1 })} sq ft at ${depth} in depth, plus ${extra}% extra.`);
    out('river-b1-lbl', 'Measured plan area');
    out('river-area', `${area.toLocaleString('en', { maximumFractionDigits: 1 })} sq ft`);
    out('river-b2-lbl', 'Stone before extra');
    out('river-net', `${(netCuFt / 27).toFixed(2)} yd³`);
    out('river-b3-lbl', 'Order volume');
    out('river-order-volume', `${(orderYards * 27).toFixed(1)} ft³`);
    out('river-b4-lbl', 'One short ton covers at this depth');
    out('river-yield', `about ${Math.round(yieldPerTon).toLocaleString('en')} sq ft`);
  }

  document.querySelectorAll<HTMLButtonElement>('.river-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      mode = btn.dataset.mode || 'dimensions';
      document.querySelectorAll<HTMLButtonElement>('.river-mode-btn').forEach(b => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      const dims = document.getElementById('river-panel-dimensions');
      const known = document.getElementById('river-panel-area');
      const rev = document.getElementById('river-panel-reverse');
      const extraWrap = document.getElementById('river-extra-wrap');
      const roundWrap = document.getElementById('river-round-wrap');
      if (dims) dims.hidden = mode !== 'dimensions';
      if (known) known.hidden = mode !== 'area';
      if (rev) rev.hidden = mode !== 'reverse';
      if (extraWrap) extraWrap.hidden = mode === 'reverse';
      if (roundWrap) roundWrap.hidden = mode === 'reverse';
      if (mode === 'area') {
        const areaCalc = num('river-length') * num('river-width');
        const ka = el('river-known-area');
        if (ka && Number.isFinite(areaCalc) && areaCalc > 0) ka.value = String(Math.round(areaCalc * 10) / 10);
      }
      updateRiverEstimate();
    });
  });

  ['river-length', 'river-width', 'river-known-area', 'river-supply-qty', 'river-depth', 'river-extra', 'river-density', 'river-bag-volume'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', () => {
      if (id === 'river-depth') syncSizeButtons();
      updateRiverEstimate();
    });
  });
  ['river-supply-unit', 'river-increment'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', updateRiverEstimate);
  });

  document.querySelectorAll<HTMLButtonElement>('.river-size').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.river-size').forEach(other => {
        other.classList.remove('is-active');
        other.setAttribute('aria-pressed', 'false');
      });
      button.classList.add('is-active');
      button.setAttribute('aria-pressed', 'true');
      const depthInput = el('river-depth');
      const densityInput = el('river-density');
      if (depthInput && button.dataset.depth) depthInput.value = button.dataset.depth;
      if (densityInput && button.dataset.density) densityInput.value = button.dataset.density;
      updateRiverEstimate();
    });
  });

  updateRiverEstimate();
</script>
