---
// Guided "How Much Rock Do I Need?" Interactive Estimator
---
<section class="section" id="how-much-calc">
  <div class="container">
    <div class="section-header">
      <h2>"How Much Rock Do I Need?" Guided Estimator</h2>
      <div class="section-divider"></div>
      <p>Select your landscape project type below to automatically configure the recommended rock size, depth, and safety overage for instant volume, tonnage, and bag counts.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <h3>Step 1: Select Your Landscape Project Type</h3>
        </div>

        <div class="project-preset-grid" role="radiogroup">
          <button type="button" class="preset-btn active" data-depth="3.0" data-dens="1.35" data-waste="10" data-name="Garden Bed Rock Mulch" data-stone="1-3&quot; River Rock">
            <div class="preset-title">Garden Bed Rock Mulch</div>
            <div class="preset-spec">1" - 3" River Rock | 3.0" Depth | Permanent weed control</div>
          </button>
          <button type="button" class="preset-btn" data-depth="4.0" data-dens="1.40" data-waste="12" data-name="Gravel Driveway Top Dressing" data-stone="#57 Crushed Stone">
            <div class="preset-title">Gravel Driveway Top Layer</div>
            <div class="preset-spec">#57 Crushed Stone | 4.0" Depth | Heavy vehicular load</div>
          </button>
          <button type="button" class="preset-btn" data-depth="2.5" data-dens="1.40" data-waste="10" data-name="Pea Gravel Patio / Fire Pit" data-stone="3/8&quot; Pea Gravel">
            <div class="preset-title">Pea Gravel Patio / Fire Pit</div>
            <div class="preset-spec">3/8" Pea Gravel | 2.5" Depth | Firm walkability</div>
          </button>
          <button type="button" class="preset-btn" data-depth="24.0" data-dens="1.35" data-waste="10" data-name="French Drain Water Trench" data-stone="#57 Washed Drain Rock">
            <div class="preset-title">French Drain Water Trench</div>
            <div class="preset-spec">#57 Washed Rock | 24" Depth | Deep drainage curtain</div>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Step 2: Enter Area Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="hm-length">Length</label>
            <input type="number" id="hm-length" value="30" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="hm-width">Width</label>
            <input type="number" id="hm-width" value="10" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="hm-depth">Recommended Depth</label>
            <input type="number" id="hm-depth" value="3.0" min="0.5" max="36" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="hm-waste">Safety Buffer</label>
            <input type="number" id="hm-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Instant Answers For Your Project</div>
          <div class="results-badge" id="hm-project-badge">Garden Bed Rock Mulch</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-hm-tons">0.00</div>
            <div class="kpi-label">How Many Tons You Need</div>
            <div class="kpi-subtext" id="kpi-hm-lbs">0 lbs bulk aggregate</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-hm-yards">0.00</div>
            <div class="kpi-label">How Many Yards You Need</div>
            <div class="kpi-subtext" id="kpi-hm-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-hm-bags">0</div>
            <div class="kpi-label">How Many Bags You Need</div>
            <div class="kpi-subtext" id="kpi-hm-pallets">0 full pallets (0.5 cu ft)</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-hm-barrows">0</div>
            <div class="kpi-label">Wheelbarrow Trips</div>
            <div class="kpi-subtext">6 cu ft contractor loads</div>
          </div>
        </div>

        <!-- Guided Project Recommendation -->
        <div class="project-advice-card">
          <div class="advice-title">Expert Contractor Installation Advice</div>
          <p class="advice-desc" id="hm-advice-text">
            For Garden Bed Rock Mulch, always install a heavy commercial-grade geotextile weed fabric before spreading stones. Lay stones 3 inches deep (Two-Stone Rule) to fully obscure the fabric from UV sunlight breakdown.
          </p>
        </div>

        <!-- Budget Estimator -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Surface Area Coverage</span>
            <span class="breakdown-val" id="row-hm-area">300 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Recommended Stone Specification</span>
            <span class="breakdown-val" id="row-hm-stone">1" - 3" River Rock</span>
          </div>
          <div class="breakdown-row">
            <span>Estimated Bulk Cost Range (Delivered)</span>
            <span class="breakdown-val" id="row-hm-cost">$250 - $420</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.project-preset-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.preset-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.preset-btn:hover {
  border-color: var(--color-primary-light);
}

.preset-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.preset-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.preset-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.project-advice-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.advice-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.advice-desc {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initHowMuchCalculator() {
  const lengthInput = document.getElementById('hm-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('hm-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('hm-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('hm-waste') as HTMLInputElement | null;

  const presetBtns = document.querySelectorAll('.preset-btn');

  let activeDensity = 1.35;
  let activeStoneSpec = '1" - 3" River Rock';
  let activeProjectName = 'Garden Bed Rock Mulch';

  const adviceMap: Record<string, string> = {
    'Garden Bed Rock Mulch': 'Install non-woven weed barrier fabric and lay stones 3" deep (Two-Stone Rule) to fully hide underlayment from UV degradation.',
    'Gravel Driveway Top Dressing': 'Driveway stone must be compacted crushed stone (#57 or #411) at 4" minimum to lock together under passenger vehicle wheel torque.',
    'Pea Gravel Patio / Fire Pit': 'Limit pea gravel to 2.0" - 2.5" depth. Exceeding 2.5" creates loose unstable footing where patio chairs sink like quicksand.',
    'French Drain Water Trench': 'Wrap the entire trench in 4 oz non-woven geotextile fabric. Bed a 4" perforated pipe with 2" of washed stone underneath, then backfill to grade.'
  };

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * activeDensity;
    const totalLbs = totalTons * 2000;

    const totalBags = Math.ceil(totalCuFt / 0.5);
    const pallets = (totalBags / 60).toFixed(1);

    const barrows = Math.ceil(totalCuFt / 6);

    // Estimated Delivered Bulk Cost Range ($55 - $85/ton delivered)
    const minCost = Math.round(totalTons * 55 + 60);
    const maxCost = Math.round(totalTons * 85 + 75);

    // Update KPIs
    const kpiTons = document.getElementById('kpi-hm-tons');
    const kpiLbs = document.getElementById('kpi-hm-lbs');
    const kpiYards = document.getElementById('kpi-hm-yards');
    const kpiCuFt = document.getElementById('kpi-hm-cuft');
    const kpiBags = document.getElementById('kpi-hm-bags');
    const kpiPallets = document.getElementById('kpi-hm-pallets');
    const kpiBarrows = document.getElementById('kpi-hm-barrows');
    const badge = document.getElementById('hm-project-badge');
    const adviceText = document.getElementById('hm-advice-text');

    const rowArea = document.getElementById('row-hm-area');
    const rowStone = document.getElementById('row-hm-stone');
    const rowCost = document.getElementById('row-hm-cost');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs bulk aggregate`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft volume`;
    if (kpiBags) kpiBags.textContent = totalBags.toLocaleString();
    if (kpiPallets) kpiPallets.textContent = `${pallets} pallets (60 bags/pl)`;
    if (kpiBarrows) kpiBarrows.textContent = barrows.toString();
    if (badge) badge.textContent = activeProjectName;
    if (adviceText) adviceText.textContent = adviceMap[activeProjectName] || '';

    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowStone) rowStone.textContent = activeStoneSpec;
    if (rowCost) rowCost.textContent = `$${minCost} - $${maxCost}`;
  }

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      presetBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const depth = parseFloat(btn.getAttribute('data-depth') || '3.0');
      activeDensity = parseFloat(btn.getAttribute('data-dens') || '1.35');
      const waste = parseFloat(btn.getAttribute('data-waste') || '10');
      activeProjectName = btn.getAttribute('data-name') || 'Project';
      activeStoneSpec = btn.getAttribute('data-stone') || 'Stone';

      if (depthInput) depthInput.value = depth.toFixed(1);
      if (wasteInput) wasteInput.value = waste.toString();

      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initHowMuchCalculator);
</script>
