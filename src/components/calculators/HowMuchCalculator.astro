---
// Guided "How Much Rock Do I Need?" Interactive Estimator
---
<section class="section" id="how-much-calc">
  <div class="container">
    <div class="section-header">
      <h2>Estimate rock by project area and depth</h2>
      <div class="section-divider"></div>
      <p>Choose a starting setup, measure the area, then adjust the finished depth, order allowance, and supplier density. Results show estimated order quantities.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <h3>Step 1: Choose a starting setup</h3>
        </div>

        <div class="project-preset-grid" role="group" aria-label="Project examples">
          <button type="button" class="preset-btn active" aria-pressed="true" data-depth="3" data-dens="1.35" data-waste="10" data-name="Decorative garden gravel" data-stone="Small decorative gravel">
            <div class="preset-title">Decorative garden gravel</div>
            <div class="preset-spec">Small gravel · 3 in starting depth · adjust for the site</div>
          </button>
          <button type="button" class="preset-btn" aria-pressed="false" data-depth="3" data-dens="1.35" data-waste="10" data-name="Driveway surface layer" data-stone="#57 clean crushed stone">
            <div class="preset-title">Driveway surface layer</div>
            <div class="preset-spec">#57 clean stone · 3 in example · base calculated separately</div>
          </button>
          <button type="button" class="preset-btn" aria-pressed="false" data-depth="2.5" data-dens="1.35" data-waste="10" data-name="Pea gravel sitting area" data-stone="3/8 in pea gravel">
            <div class="preset-title">Pea gravel sitting area</div>
            <div class="preset-spec">3/8 in rounded gravel · 2.5 in example · check footing</div>
          </button>
          <button type="button" class="preset-btn" aria-pressed="false" data-depth="12" data-dens="1.35" data-waste="10" data-name="Drain trench, gross volume" data-stone="#57 washed drain stone">
            <div class="preset-title">Drain trench, gross volume</div>
            <div class="preset-spec">#57 washed stone · 12 in example · subtract pipe space</div>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Step 2: Enter Area Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="hm-length">Length</label>
            <input type="number" id="hm-length" value="30" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="hm-width">Width</label>
            <input type="number" id="hm-width" value="10" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="hm-depth">Finished stone depth</label>
            <input type="number" id="hm-depth" value="3" min="0.5" max="36" step="0.1" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="hm-waste">Extra order allowance</label>
            <input type="number" id="hm-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>
        <div class="dim-grid">
          <div class="input-field">
            <label for="hm-density">Loose bulk density</label>
            <input type="number" id="hm-density" value="1.35" min="0.25" max="2.5" step="0.01" />
            <span class="unit-label">tons/yd³</span>
          </div>
        </div>
        <p class="calc-basis-note">Presets are examples, not project specifications. Use your supplier's loose bulk density and the depth suited to your material. For a drain trench, subtract pipe and other displaced volume separately.</p>
        <p id="hm-input-error" class="calc-input-error" role="status" hidden></p>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Estimated order quantities</div>
          <div class="results-badge" id="hm-project-badge">Decorative garden gravel</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-hm-tons">0.00</div>
            <div class="kpi-label">US short tons</div>
            <div class="kpi-subtext" id="kpi-hm-lbs">At selected planning density</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-hm-yards">0.00</div>
            <div class="kpi-label">Cubic yards to order</div>
            <div class="kpi-subtext" id="kpi-hm-cuft">Includes order allowance</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-hm-bags">0</div>
            <div class="kpi-label">0.5 cu ft bags</div>
            <div class="kpi-subtext" id="kpi-hm-pallets">Check the bag's printed volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-hm-net">0.00</div>
            <div class="kpi-label">Cubic yards in place</div>
            <div class="kpi-subtext">Before order allowance</div>
          </div>
        </div>

        <!-- Guided Project Recommendation -->
        <div class="project-advice-card">
          <div class="advice-title">Check before ordering</div>
          <p class="advice-desc" id="hm-advice-text">
            Rock can reduce some weed growth, but it will still need maintenance. In planting beds, choose underlayment for the site and plants rather than assuming fabric is required.
          </p>
        </div>

        <!-- Budget Estimator -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Surface Area Coverage</span>
            <span class="breakdown-val" id="row-hm-area">300 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Selected material example</span>
            <span class="breakdown-val" id="row-hm-stone">Small decorative gravel</span>
          </div>
          <div class="breakdown-row">
            <span>Price and delivery</span>
            <span class="breakdown-val">Request a local quote</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.project-preset-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.preset-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.preset-btn:hover {
  border-color: var(--color-primary-light);
}

.preset-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.preset-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.preset-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.calc-basis-note, .calc-input-error {
  margin: var(--space-2) 0 0;
  font-size: var(--text-xs);
  line-height: 1.5;
  color: var(--color-text-muted);
}

.calc-input-error { color: #b91c1c; }

.input-field input[aria-invalid="true"] { border-color: #b91c1c; }

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.project-advice-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.advice-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.advice-desc {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initHowMuchCalculator() {
  const lengthInput = document.getElementById('hm-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('hm-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('hm-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('hm-waste') as HTMLInputElement | null;
  const densityInput = document.getElementById('hm-density') as HTMLInputElement | null;
  const errorText = document.getElementById('hm-input-error');

  const presetBtns = document.querySelectorAll<HTMLButtonElement>('.preset-btn');

  let activeStoneSpec = 'Small decorative gravel';
  let activeProjectName = 'Decorative garden gravel';

  const adviceMap: Record<string, string> = {
    'Decorative garden gravel': 'A 3 in layer is a quantity example, not a weed-control guarantee. Rock can collect windblown soil and seeds. Match depth and underlayment to the material, plants, and maintenance plan.',
    'Driveway surface layer': 'This is the visible layer only. A driveway may also need a separately specified and compacted base; soil, traffic, and drainage determine its design.',
    'Pea gravel sitting area': 'Rounded pea gravel shifts under feet and furniture. Check the finished surface and edging before ordering; a stable patio may call for a different material.',
    'Drain trench, gross volume': 'This rectangle gives gross trench volume. Subtract pipe and other displaced space before ordering stone, and follow the drainage design for depth and outlet.'
  };

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput || !densityInput) return;

    const inputs = [lengthInput, widthInput, depthInput, wasteInput, densityInput];
    const invalid = inputs.filter(input => input.value.trim() === '' || !input.validity.valid || !Number.isFinite(Number(input.value)));
    inputs.forEach(input => input.setAttribute('aria-invalid', String(invalid.includes(input))));
    if (errorText) {
      errorText.hidden = invalid.length === 0;
      errorText.textContent = invalid.length ? 'Enter values within the shown input limits to update the estimate.' : '';
    }
    if (invalid.length) {
      ['kpi-hm-tons', 'kpi-hm-yards', 'kpi-hm-bags', 'kpi-hm-net', 'row-hm-area'].forEach(id => {
        const element = document.getElementById(id);
        if (element) element.textContent = '—';
      });
      return;
    }

    const length = Number(lengthInput.value);
    const width = Number(widthInput.value);
    const depthInches = Number(depthInput.value);
    const wastePercent = Number(wasteInput.value);
    const densityTonsPerYard = Number(densityInput.value);

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;
    const netYards = netCuFt / 27;
    const totalTons = totalYards * densityTonsPerYard;
    const totalLbs = totalTons * 2000;
    const totalBags = Math.ceil(totalCuFt / 0.5 - 1e-9);

    // Update KPIs
    const kpiTons = document.getElementById('kpi-hm-tons');
    const kpiLbs = document.getElementById('kpi-hm-lbs');
    const kpiYards = document.getElementById('kpi-hm-yards');
    const kpiCuFt = document.getElementById('kpi-hm-cuft');
    const kpiBags = document.getElementById('kpi-hm-bags');
    const kpiPallets = document.getElementById('kpi-hm-pallets');
    const kpiNet = document.getElementById('kpi-hm-net');
    const badge = document.getElementById('hm-project-badge');
    const adviceText = document.getElementById('hm-advice-text');

    const rowArea = document.getElementById('row-hm-area');
    const rowStone = document.getElementById('row-hm-stone');
    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `≈ ${Math.round(totalLbs).toLocaleString()} lb at ${densityTonsPerYard.toFixed(2)} tons/yd³`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft including allowance`;
    if (kpiBags) kpiBags.textContent = totalBags.toLocaleString();
    if (kpiPallets) kpiPallets.textContent = 'At 0.5 cu ft per bag; check the label';
    if (kpiNet) kpiNet.textContent = netYards.toFixed(2);
    if (badge) badge.textContent = activeProjectName;
    if (adviceText) adviceText.textContent = adviceMap[activeProjectName] || '';

    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowStone) rowStone.textContent = activeStoneSpec;
  }

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      presetBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      const depth = parseFloat(btn.getAttribute('data-depth') || '3.0');
      const density = parseFloat(btn.getAttribute('data-dens') || '1.35');
      const waste = parseFloat(btn.getAttribute('data-waste') || '10');
      activeProjectName = btn.getAttribute('data-name') || 'Project';
      activeStoneSpec = btn.getAttribute('data-stone') || 'Stone';

      if (depthInput) depthInput.value = depth.toFixed(1);
      if (wasteInput) wasteInput.value = waste.toString();
      if (densityInput) densityInput.value = density.toFixed(2);

      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput, densityInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initHowMuchCalculator);
</script>
