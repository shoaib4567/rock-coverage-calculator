---
// Gravel Driveway, Pathway, and Landscape Calculator
---
<section class="section" id="gravel-calc">
  <div class="container">
    <div class="section-header">
      <h2>Gravel Driveway & Pathway Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate exact tonnage for gravel driveways, garden pathways, and parking pads with base vs surface course dual-layer calculations and vehicular compaction allowances.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Application Intent & Traffic Load</h3>
        </div>

        <div class="unit-toggle mode-toggle" role="tablist">
          <button class="active" id="gravel-mode-drive" type="button">Driveway (Vehicular)</button>
          <button id="gravel-mode-walk" type="button">Walkway / Patio (Pedestrian)</button>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="gravel-length">Length</label>
            <input type="number" id="gravel-length" value="50" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="gravel-width">Width</label>
            <input type="number" id="gravel-width" value="12" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="gravel-depth">Gravel Depth</label>
            <input type="number" id="gravel-depth" value="4.0" min="1" max="18" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="gravel-waste">Compaction & Grade Buffer</label>
            <input type="number" id="gravel-waste" value="15" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Gravel Type Selector -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Gravel Aggregate Grade</h3>
        </div>

        <div class="gravel-type-grid" role="radiogroup">
          <button type="button" class="grv-btn active" data-density="1.40" data-name="#57 Crushed Gravel (3/4&quot;)">
            <div class="grv-title">#57 Crushed Gravel (3/4")</div>
            <div class="grv-spec">1.40 T/yd³ | Clean angular stone that locks under vehicle tires</div>
          </button>
          <button type="button" class="grv-btn" data-density="1.50" data-name="Crusher Run / Dense Graded Base">
            <div class="grv-title">Crusher Run Base (With Stone Dust)</div>
            <div class="grv-spec">1.50 T/yd³ | Packs rock-hard for driveway foundation base</div>
          </button>
          <button type="button" class="grv-btn" data-density="1.35" data-name="Round River Pea Gravel">
            <div class="grv-title">Smooth Pea Gravel (3/8")</div>
            <div class="grv-spec">1.35 T/yd³ | Barefoot friendly for garden paths and patios</div>
          </button>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Gravel Delivery Requirements</div>
          <div class="results-badge" id="gravel-badge">#57 Crushed Gravel</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-grv-tons">0.00</div>
            <div class="kpi-label">Quarry Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-grv-lbs">0 lbs bulk payload</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-grv-yards">0.00</div>
            <div class="kpi-label">Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-grv-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-grv-sqft">0</div>
            <div class="kpi-label">Surface Area (Sq Ft)</div>
            <div class="kpi-subtext" id="kpi-grv-rolls">2 rolls geotextile (3'x100')</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-grv-truck">1 Truck</div>
            <div class="kpi-label">Dump Truck Loads</div>
            <div class="kpi-subtext" id="kpi-grv-truck-spec">Tandem axle hauler</div>
          </div>
        </div>

        <!-- Driveway Construction Guide -->
        <div class="driveway-guide-card">
          <div class="guide-title">Contractor Driveway Layer Engineering</div>
          <p class="guide-text" id="gravel-guide-text">
            For long-lasting gravel driveways, install a 4" compacted sub-base of #411 Crusher Run over heavy geotextile fabric, followed by a 2" top surface layer of angular #57 clean stone. Angular stones lock together under vehicle tires, preventing ruts and stone displacement.
          </p>
        </div>

        <!-- Breakdown Rows -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Surface Coverage Dimensions</span>
            <span class="breakdown-val" id="row-grv-area">600 sq ft (50' × 12')</span>
          </div>
          <div class="breakdown-row">
            <span>Compaction & Void Fill Allowance</span>
            <span class="breakdown-val" id="row-grv-compaction">15% included in total</span>
          </div>
          <div class="breakdown-row">
            <span>Geotextile Driveway Underlayment</span>
            <span class="breakdown-val">6 oz woven stabilization fabric recommended</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.unit-toggle {
  display: flex;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 3px;
  margin-bottom: var(--space-4);
}

.unit-toggle button {
  flex: 1;
  padding: 0.5rem;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 600;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.unit-toggle button.active {
  background: var(--color-primary);
  color: #000;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.gravel-type-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.grv-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.grv-btn:hover {
  border-color: var(--color-primary-light);
}

.grv-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.grv-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.grv-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.driveway-guide-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.guide-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.guide-text {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initGravelCalculator() {
  const modeDriveBtn = document.getElementById('gravel-mode-drive');
  const modeWalkBtn = document.getElementById('gravel-mode-walk');

  const lengthInput = document.getElementById('gravel-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('gravel-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('gravel-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('gravel-waste') as HTMLInputElement | null;

  const grvBtns = document.querySelectorAll('.grv-btn');

  let activeDensity = 1.40;
  let activeGravelName = '#57 Crushed Gravel';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * activeDensity;
    const totalLbs = totalTons * 2000;

    const fabricSqFt = Math.ceil(area * 1.10);
    const rolls3x100 = Math.ceil(fabricSqFt / 300);

    const truckTrips = Math.ceil(totalTons / 15);

    // Update KPIs
    const kpiTons = document.getElementById('kpi-grv-tons');
    const kpiLbs = document.getElementById('kpi-grv-lbs');
    const kpiYards = document.getElementById('kpi-grv-yards');
    const kpiCuFt = document.getElementById('kpi-grv-cuft');
    const kpiSqFt = document.getElementById('kpi-grv-sqft');
    const kpiRolls = document.getElementById('kpi-grv-rolls');
    const kpiTruck = document.getElementById('kpi-grv-truck');
    const kpiTruckSpec = document.getElementById('kpi-grv-truck-spec');
    const badge = document.getElementById('gravel-badge');

    const rowArea = document.getElementById('row-grv-area');
    const rowCompaction = document.getElementById('row-grv-compaction');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs net delivery`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft volume`;
    if (kpiSqFt) kpiSqFt.textContent = Math.round(area).toLocaleString();
    if (kpiRolls) kpiRolls.textContent = `${rolls3x100} roll${rolls3x100 === 1 ? '' : 's'} geotextile (3'x100')`;
    if (kpiTruck) kpiTruck.textContent = `${truckTrips} Truck${truckTrips === 1 ? '' : 's'}`;
    if (kpiTruckSpec) kpiTruckSpec.textContent = totalTons <= 10 ? 'Single axle hauler' : 'Tandem axle hauler (15 T)';
    if (badge) badge.textContent = activeGravelName;

    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowCompaction) rowCompaction.textContent = `${wastePercent}% included for tire wheel compaction`;
  }

  if (modeDriveBtn && modeWalkBtn && depthInput && wasteInput) {
    modeDriveBtn.addEventListener('click', () => {
      modeDriveBtn.classList.add('active');
      modeWalkBtn.classList.remove('active');
      depthInput.value = '4.0';
      wasteInput.value = '15';
      const guideText = document.getElementById('gravel-guide-text');
      if (guideText) {
        guideText.textContent = 'For long-lasting gravel driveways, install a 4" compacted sub-base of #411 Crusher Run over heavy geotextile fabric, followed by a 2" top surface layer of angular #57 clean stone. Angular stones lock together under vehicle tires, preventing ruts and stone displacement.';
      }
      calculate();
    });

    modeWalkBtn.addEventListener('click', () => {
      modeWalkBtn.classList.add('active');
      modeDriveBtn.classList.remove('active');
      depthInput.value = '2.5';
      wasteInput.value = '10';
      const guideText = document.getElementById('gravel-guide-text');
      if (guideText) {
        guideText.textContent = 'For walkways and garden patios, a 2.5" depth provides comfortable pedestrian walkability without feeling spongy or deep. Use landscape edging to hold stones inside the path perimeter.';
      }
      calculate();
    });
  }

  grvBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      grvBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDensity = parseFloat(btn.getAttribute('data-density') || '1.40');
      const titleEl = btn.querySelector('.grv-title');
      if (titleEl) activeGravelName = titleEl.textContent || 'Gravel';
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initGravelCalculator);
</script>
