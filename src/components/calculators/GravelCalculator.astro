---
import { getMaterialById } from '../../scripts/materials-data.js';

const crushedDensity = getMaterialById('crushed-granite').tonsPerCuYd;
const baseDensity = getMaterialById('crusher-run-21a').tonsPerCuYd;
const peaDensity = getMaterialById('pea-gravel').tonsPerCuYd;
---
<section class="section" id="gravel-calc">
  <div class="container">
    <div class="section-header">
      <h2>Estimate one gravel layer</h2>
      <div class="section-divider"></div>
      <p>Enter dimensions for a finished layer, select a material, and adjust the allowance and bulk density to estimate what to order. Calculate base and surface layers separately.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Project starting point</h3>
        </div>

        <div class="unit-toggle mode-toggle" aria-label="Project starting point">
          <button class="active" aria-pressed="true" id="gravel-mode-drive" type="button">Driveway example</button>
          <button aria-pressed="false" id="gravel-mode-walk" type="button">Walkway example</button>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="gravel-length">Length</label>
            <input type="number" id="gravel-length" value="50" min="0.01" step="any" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="gravel-width">Width</label>
            <input type="number" id="gravel-width" value="12" min="0.01" step="any" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="gravel-depth">Finished layer depth</label>
            <input type="number" id="gravel-depth" value="4.0" min="0.01" step="any" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="gravel-waste">Order allowance</label>
            <input type="number" id="gravel-waste" value="15" min="0" step="any" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Gravel Type Selector -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Material and bulk density</h3>
        </div>

        <div class="gravel-type-grid" aria-label="Gravel material">
          <button type="button" class="grv-btn active" aria-pressed="true" data-density={crushedDensity} data-name="Crushed stone">
            <div class="grv-title">Crushed stone</div>
            <div class="grv-spec">Starts at {crushedDensity.toFixed(2)} US tons/yd³ | Check the supplier's size and fines</div>
          </button>
          <button type="button" class="grv-btn" aria-pressed="false" data-density={baseDensity} data-name="Crusher run / dense graded base">
            <div class="grv-title">Crusher run / dense graded base</div>
            <div class="grv-spec">Starts at {baseDensity.toFixed(2)} US tons/yd³ | Mix of stone sizes and fines</div>
          </button>
          <button type="button" class="grv-btn" aria-pressed="false" data-density={peaDensity} data-name="Pea gravel">
            <div class="grv-title">Pea gravel</div>
            <div class="grv-spec">Starts at {peaDensity.toFixed(2)} US tons/yd³ | Rounded path and patio gravel</div>
          </button>
        </div>
        <div class="input-field density-field">
          <label for="gravel-density">Bulk density (use supplier figure if known)</label>
          <input type="number" id="gravel-density" value={crushedDensity} min="0.01" step="any" />
          <span class="unit-label">tons/yd³</span>
        </div>
        <p class="input-note">Preset densities are planning estimates. Change this number if your supplier gives a conversion for your material.</p>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Estimated gravel order</div>
          <div class="results-badge" id="gravel-badge">Crushed stone</div>
        </div>
        <p id="gravel-input-error" class="input-note" role="alert" style="display: none;">Enter positive dimensions and density. The order allowance can be zero or more.</p>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-grv-tons">0.00</div>
            <div class="kpi-label">Order weight (US tons)</div>
            <div class="kpi-subtext" id="kpi-grv-lbs">0 lb estimated weight</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-grv-yards">0.00</div>
            <div class="kpi-label">Order volume (yd³)</div>
            <div class="kpi-subtext" id="kpi-grv-cuft">0 cu ft including allowance</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-grv-finished">0.00</div>
            <div class="kpi-label">Finished volume (yd³)</div>
            <div class="kpi-subtext">Before order allowance</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-grv-area">0</div>
            <div class="kpi-label">Surface area (sq ft)</div>
            <div class="kpi-subtext">Length × width</div>
          </div>
        </div>

        <!-- One-layer calculation note -->
        <div class="driveway-guide-card">
          <div class="guide-title">Use this estimate</div>
          <p class="guide-text" id="gravel-guide-text">
            This is one gravel layer. For a driveway with a separate base and surface, calculate each layer using its own depth, density, and allowance.
          </p>
        </div>

        <!-- Breakdown Rows -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Surface Coverage Dimensions</span>
            <span class="breakdown-val" id="row-grv-area">600 sq ft (50' × 12')</span>
          </div>
          <div class="breakdown-row">
            <span>Allowance applied to finished volume</span>
            <span class="breakdown-val" id="row-grv-compaction">15% included in order estimate</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.unit-toggle {
  display: flex;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 3px;
  margin-bottom: var(--space-4);
}

.unit-toggle button {
  flex: 1;
  padding: 0.5rem;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 600;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.unit-toggle button.active {
  background: var(--color-primary);
  color: #000;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.gravel-type-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.density-field {
  max-width: 260px;
  margin-bottom: var(--space-2);
}

.input-note {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  line-height: 1.5;
  margin: 0;
}

.grv-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.grv-btn:hover {
  border-color: var(--color-primary-light);
}

.grv-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.grv-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.grv-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.driveway-guide-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.guide-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.guide-text {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initGravelCalculator() {
  const modeDriveBtn = document.getElementById('gravel-mode-drive');
  const modeWalkBtn = document.getElementById('gravel-mode-walk');

  const lengthInput = document.getElementById('gravel-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('gravel-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('gravel-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('gravel-waste') as HTMLInputElement | null;
  const densityInput = document.getElementById('gravel-density') as HTMLInputElement | null;

  const grvBtns = document.querySelectorAll('.grv-btn');

  let activeGravelName = 'Crushed stone';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput || !densityInput) return;

    const inputs = [lengthInput, widthInput, depthInput, wasteInput, densityInput];
    const values = inputs.map(input => Number(input.value));
    const [length, width, depthInches, wastePercent, density] = values;
    const valid = inputs.every(input => input.value.trim() !== '' && input.validity.valid)
      && values.every(Number.isFinite) && length > 0 && width > 0 && depthInches > 0 && wastePercent >= 0 && density > 0;
    const error = document.getElementById('gravel-input-error');
    if (error) error.style.display = valid ? 'none' : 'block';
    if (!valid) {
      ['kpi-grv-tons', 'kpi-grv-lbs', 'kpi-grv-yards', 'kpi-grv-cuft', 'kpi-grv-finished', 'kpi-grv-area', 'row-grv-area', 'row-grv-compaction'].forEach(id => {
        const output = document.getElementById(id);
        if (output) output.textContent = '—';
      });
      return;
    }

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const finishedYards = netCuFt / 27;
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * density;
    const totalLbs = totalTons * 2000;

    // Update KPIs
    const kpiTons = document.getElementById('kpi-grv-tons');
    const kpiLbs = document.getElementById('kpi-grv-lbs');
    const kpiYards = document.getElementById('kpi-grv-yards');
    const kpiCuFt = document.getElementById('kpi-grv-cuft');
    const kpiFinished = document.getElementById('kpi-grv-finished');
    const kpiArea = document.getElementById('kpi-grv-area');
    const badge = document.getElementById('gravel-badge');

    const rowArea = document.getElementById('row-grv-area');
    const rowCompaction = document.getElementById('row-grv-compaction');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lb estimated weight`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft including allowance`;
    if (kpiFinished) kpiFinished.textContent = finishedYards.toFixed(2);
    if (kpiArea) kpiArea.textContent = Math.round(area).toLocaleString();
    if (badge) badge.textContent = activeGravelName;

    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowCompaction) rowCompaction.textContent = `${wastePercent}% included in order estimate`;
  }

  if (modeDriveBtn && modeWalkBtn && lengthInput && widthInput && depthInput && wasteInput) {
    modeDriveBtn.addEventListener('click', () => {
      modeDriveBtn.classList.add('active');
      modeWalkBtn.classList.remove('active');
      modeDriveBtn.setAttribute('aria-pressed', 'true');
      modeWalkBtn.setAttribute('aria-pressed', 'false');
      lengthInput.value = '50';
      widthInput.value = '12';
      depthInput.value = '4.0';
      wasteInput.value = '15';
      (grvBtns[0] as HTMLButtonElement | undefined)?.click();
      const guideText = document.getElementById('gravel-guide-text');
      if (guideText) {
        guideText.textContent = 'This is one gravel layer. For a driveway with a separate base and surface, calculate each layer using its own depth, density, and allowance.';
      }
      calculate();
    });

    modeWalkBtn.addEventListener('click', () => {
      modeWalkBtn.classList.add('active');
      modeDriveBtn.classList.remove('active');
      modeWalkBtn.setAttribute('aria-pressed', 'true');
      modeDriveBtn.setAttribute('aria-pressed', 'false');
      lengthInput.value = '30';
      widthInput.value = '4';
      depthInput.value = '2.5';
      wasteInput.value = '10';
      (grvBtns[2] as HTMLButtonElement | undefined)?.click();
      const guideText = document.getElementById('gravel-guide-text');
      if (guideText) {
        guideText.textContent = 'For a path or patio, use the finished depth you plan to install. Edging can help contain loose rounded stone; adjust the allowance for low spots and handling loss.';
      }
      calculate();
    });
  }

  grvBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      grvBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      if (densityInput) densityInput.value = btn.getAttribute('data-density') || densityInput.value;
      const titleEl = btn.querySelector('.grv-title');
      if (titleEl) activeGravelName = titleEl.textContent || 'Gravel';
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput, densityInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initGravelCalculator);
</script>
