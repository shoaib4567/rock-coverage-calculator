<section class="section" id="calculator" aria-labelledby="drain-calculator-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="drain-calculator-heading">Estimate the rock inside your drain trench</h2>
      <div class="section-divider"></div>
      <p>Enter the part of the trench that will actually contain stone. The tool removes the outside volume of a pipe, then shows the finished fill and an optional amount to order.</p>
    </div>

    <div class="calc-wrapper">
      <div class="calc-panel">
        <div class="calc-panel-title"><h3>Trench and material</h3></div>
        <div class="drain-input-grid">
          <div class="input-field">
            <label for="drain-length">Trench length (ft)</label>
            <input id="drain-length" type="number" value="50" min="0.1" step="0.1" />
          </div>
          <div class="input-field">
            <label for="drain-width">Trench width (in)</label>
            <input id="drain-width" type="number" value="12" min="1" step="0.5" />
          </div>
          <div class="input-field">
            <label for="drain-depth">Excavated depth (in)</label>
            <input id="drain-depth" type="number" value="18" min="1" step="0.5" />
          </div>
          <div class="input-field">
            <label for="drain-cover">Top cover without rock (in)</label>
            <input id="drain-cover" type="number" value="4" min="0" step="0.5" />
          </div>
          <div class="input-field">
            <label for="drain-pipe">Pipe outside diameter (in)</label>
            <input id="drain-pipe" type="number" value="4" min="0" step="0.25" />
            <small>Enter 0 for a stone-only trench. Use the actual outside diameter when known.</small>
          </div>
          <div class="input-field">
            <label for="drain-density">Supplier loose weight (lb/cu yd)</label>
            <input id="drain-density" type="number" value="2500" min="500" max="5000" step="25" />
            <small>2,500 is one washed drain-rock product example; replace it with your supplier's figure.</small>
          </div>
          <div class="input-field">
            <label for="drain-extra">Optional order allowance (%)</label>
            <input id="drain-extra" type="number" value="10" min="0" max="50" step="1" />
            <small>For uneven trench walls, handling, and site adjustments.</small>
          </div>
          <div class="input-field">
            <label for="drain-lap">Fabric overlap (in)</label>
            <input id="drain-lap" type="number" value="12" min="0" max="36" step="1" />
            <small>Used only for the optional fabric cut estimate.</small>
          </div>
        </div>
        <p class="drain-error" id="drain-error" role="alert" aria-live="polite" hidden></p>
      </div>

      <div class="calc-results-panel" aria-live="polite">
        <div class="calc-panel-title"><h3>Your stone takeoff</h3></div>
        <div class="drain-result-grid">
          <div class="drain-result main-result">
            <span>Finished stone fill</span>
            <strong id="drain-installed">2.00 cu yd</strong>
            <small id="drain-installed-cuft">53.97 cu ft, after pipe displacement</small>
          </div>
          <div class="drain-result">
            <span>Stone to order with allowance</span>
            <strong id="drain-order">2.20 cu yd</strong>
            <small id="drain-extra-caption">10% optional extra</small>
          </div>
          <div class="drain-result">
            <span>Estimated order weight</span>
            <strong id="drain-tons">2.75 US short tons</strong>
            <small id="drain-weight-caption">At 2,500 lb per cu yd; confirm with supplier</small>
          </div>
        </div>
        <dl class="drain-breakdown">
          <div><dt>Rock-filled height</dt><dd id="drain-fill-height">14 in</dd></div>
          <div><dt>Trench envelope</dt><dd id="drain-envelope">58.33 cu ft</dd></div>
          <div><dt>Pipe displacement</dt><dd id="drain-pipe-volume">4.36 cu ft</dd></div>
          <div><dt>Fabric cut width × run</dt><dd id="drain-fabric">5.33 ft × 50 ft</dd></div>
          <div><dt>Fabric area before seams</dt><dd id="drain-fabric-area">267 sq ft</dd></div>
        </dl>
        <p class="drain-note">Fabric is a cut-size estimate, not a roll count. Confirm fabric type, roll width, overlap, and outlet details for your site.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const drainIds = ['length', 'width', 'depth', 'cover', 'pipe', 'density', 'extra', 'lap'] as const;
  const fields = Object.fromEntries(drainIds.map(id => [id, document.getElementById(`drain-${id}`) as HTMLInputElement])) as Record<typeof drainIds[number], HTMLInputElement>;
  const error = document.getElementById('drain-error') as HTMLParagraphElement;
  const outputs = ['installed', 'installed-cuft', 'order', 'extra-caption', 'tons', 'weight-caption', 'fill-height', 'envelope', 'pipe-volume', 'fabric', 'fabric-area'] as const;
  const result = Object.fromEntries(outputs.map(id => [id, document.getElementById(`drain-${id}`) as HTMLElement])) as Record<typeof outputs[number], HTMLElement>;
  const qty = (n: number) => n < 0.01 && n > 0 ? n.toFixed(3) : n.toFixed(2);

  function updateDrain() {
    const values = Object.fromEntries(drainIds.map(id => [id, Number(fields[id].value)])) as Record<typeof drainIds[number], number>;
    const invalid = new Set<string>();
    drainIds.forEach(id => {
      const bad = fields[id].value.trim() === '' || !Number.isFinite(values[id]) || !fields[id].checkValidity();
      fields[id].setAttribute('aria-invalid', String(bad));
      if (bad) invalid.add(id);
    });
    const geometryIds = ['length', 'width', 'depth', 'cover', 'pipe'];
    const geometryInvalid = geometryIds.some(id => invalid.has(id));
    let message = '';
    const fill = values.depth - values.cover;
    if (!geometryInvalid && fill <= 0) {
      fields.cover.setAttribute('aria-invalid', 'true');
      message = 'Top cover must be smaller than excavated depth.';
    }
    if (!geometryInvalid && !message && values.pipe > Math.min(values.width, fill)) {
      fields.pipe.setAttribute('aria-invalid', 'true');
      message = 'The pipe outside diameter must fit inside the rock-filled width and height.';
    }
    if (geometryInvalid || message) {
      error.textContent = message || 'Enter valid trench and pipe dimensions to see the estimate.';
      error.hidden = false;
      outputs.forEach(id => result[id].textContent = '—');
      return;
    }
    if (invalid.size) {
      error.textContent = 'Check the highlighted optional fields; unaffected quantities remain available.';
      error.hidden = false;
    } else {
      error.hidden = true;
    }
    const envelope = values.length * values.width / 12 * fill / 12;
    const pipeVolume = values.length * Math.PI * (values.pipe / 24) ** 2;
    const stoneCuFt = envelope - pipeVolume;
    const installedYards = stoneCuFt / 27;
    const orderYards = invalid.has('extra') ? null : installedYards * (1 + values.extra / 100);
    const orderTons = orderYards === null || invalid.has('density') ? null : orderYards * values.density / 2000;
    const fabricWidth = invalid.has('lap') ? null : (2 * values.width + 2 * fill + values.lap) / 12;
    result.installed.textContent = `${qty(installedYards)} cu yd`;
    result['installed-cuft'].textContent = `${qty(stoneCuFt)} cu ft, after pipe displacement`;
    result.order.textContent = orderYards === null ? '—' : `${qty(orderYards)} cu yd`;
    result['extra-caption'].textContent = invalid.has('extra') ? 'Enter 0–50%' : `${values.extra}% optional extra`;
    result.tons.textContent = orderTons === null ? '—' : `${qty(orderTons)} US short tons`;
    result['weight-caption'].textContent = invalid.has('density') ? 'Enter a supplier weight' : `At ${values.density.toLocaleString()} lb per cu yd; confirm with supplier`;
    result['fill-height'].textContent = `${qty(fill)} in`;
    result.envelope.textContent = `${qty(envelope)} cu ft`;
    result['pipe-volume'].textContent = `${qty(pipeVolume)} cu ft`;
    result.fabric.textContent = fabricWidth === null ? '—' : `${qty(fabricWidth)} ft × ${qty(values.length)} ft`;
    result['fabric-area'].textContent = fabricWidth === null ? '—' : `${Math.ceil(fabricWidth * values.length)} sq ft`;
  }

  drainIds.forEach(id => fields[id]?.addEventListener('input', updateDrain));
  updateDrain();
</script>

<style>
  .drain-input-grid, .drain-result-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .drain-input-grid .input-field { min-width: 0; }
  .drain-input-grid small { display: block; color: var(--text-muted); font-size: var(--text-xs); line-height: 1.45; margin-top: var(--space-2); }
  .drain-input-grid input { width: 100%; }
  .drain-input-grid input[aria-invalid="true"] { border-color: #dc6b65; }
  .drain-error { margin: var(--space-4) 0 0; color: #f3a19a; }
  .drain-result { padding: var(--space-4); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); }
  .drain-result span, .drain-result small { display: block; color: var(--text-muted); }
  .drain-result strong { display: block; font-size: clamp(1.2rem, 2vw, 1.7rem); color: var(--text-primary); margin: var(--space-2) 0; }
  .drain-result.main-result { grid-column: 1 / -1; border-color: var(--accent-gold); }
  .drain-breakdown { margin: var(--space-6) 0 0; }
  .drain-breakdown div { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--border-subtle); }
  .drain-breakdown dt { color: var(--text-secondary); }
  .drain-breakdown dd { color: var(--text-primary); text-align: right; margin: 0; font-weight: 600; }
  .drain-note { color: var(--text-muted); font-size: var(--text-sm); line-height: 1.5; margin: var(--space-4) 0 0; }
  @media (max-width: 640px) { .drain-input-grid, .drain-result-grid { grid-template-columns: 1fr; } .drain-result.main-result { grid-column: auto; } }
</style>
