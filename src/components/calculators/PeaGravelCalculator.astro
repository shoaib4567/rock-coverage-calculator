---
// Pea Gravel Patio, Walkway, & Playground Calculator
---
<section class="section" id="pea-calc">
  <div class="container">
    <div class="section-header">
      <h2>Pea Gravel Patio & Walkway Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate exact tonnage and bag counts for 3/8" smooth pea gravel with walkability depth limiters (max 2.5" to prevent shoe sinkage) and linear edging containment.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Application Type & Depth Guard</h3>
        </div>

        <div class="unit-toggle mode-toggle" role="tablist">
          <button class="active" id="pea-mode-patio" type="button">Patio / Fire Pit / Path</button>
          <button id="pea-mode-play" type="button">Playground Cushion Fall Zone</button>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="pea-length">Length</label>
            <input type="number" id="pea-length" value="25" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="pea-width">Width</label>
            <input type="number" id="pea-width" value="16" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="pea-depth">Layer Depth</label>
            <input type="number" id="pea-depth" value="2.5" min="1" max="12" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="pea-waste">Safety Buffer</label>
            <input type="number" id="pea-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Walkability Advisory Alert -->
        <div id="pea-advisory-box" class="advisory-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="pea-advisory-text">Walkability Guard: 2.0" - 2.5" is the optimal depth. Exceeding 2.5" causes shoes and patio furniture to sink.</span>
        </div>

        <!-- Pea Gravel Size -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
          <h3>Pea Gravel Variety</h3>
        </div>

        <div class="pea-type-grid" role="radiogroup">
          <button type="button" class="pea-btn active" data-density="1.35" data-name="Natural Mixed Tan / Brown Pea Gravel">
            <div class="pea-btn-title">Natural River Pea Gravel (3/8")</div>
            <div class="pea-btn-spec">1.35 T/yd³ | Smooth river quartz pebbles | Most popular</div>
          </button>
          <button type="button" class="pea-btn" data-density="1.40" data-name="Grey / Blue Granite Pea Stone">
            <div class="pea-btn-title">Blue / Grey Pea Gravel (3/8")</div>
            <div class="pea-btn-spec">1.40 T/yd³ | Architectural neutral modern tone</div>
          </button>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Pea Gravel Requirements</div>
          <div class="results-badge" id="pea-badge">Patio Footing Compliant</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-pea-tons">0.00</div>
            <div class="kpi-label">Quarry Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-pea-lbs">0 lbs bulk payload</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-pea-yards">0.00</div>
            <div class="kpi-label">Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-pea-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-pea-bags">0</div>
            <div class="kpi-label">0.5 Cu Ft Retail Bags</div>
            <div class="kpi-subtext" id="kpi-pea-pallets">0 full pallets</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-pea-edging">0</div>
            <div class="kpi-label">Perimeter Edging (Ft)</div>
            <div class="kpi-subtext">Linear containment border</div>
          </div>
        </div>

        <!-- Containment Caution Box -->
        <div class="containment-card">
          <div class="containment-title">Containment & Edging Critical Rule</div>
          <p class="containment-text">
            Because 3/8" round pea gravel consists of spherical pebbles, it acts like ball bearings underfoot. Without a rigid 3" high landscape edging barrier (steel, aluminum, or Belgian block border), stones will migrate uncontrollably into adjacent lawn grass.
          </p>
        </div>

        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Patio Surface Footprint</span>
            <span class="breakdown-val" id="row-pea-area">400 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Non-Woven Underlayment Fabric</span>
            <span class="breakdown-val" id="row-pea-fabric">440 sq ft (2 rolls)</span>
          </div>
          <div class="breakdown-row">
            <span>Walkability Firmness Rating</span>
            <span class="breakdown-val" id="row-pea-firmness">Excellent (2.5" depth locked)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.unit-toggle {
  display: flex;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 3px;
  margin-bottom: var(--space-4);
}

.unit-toggle button {
  flex: 1;
  padding: 0.5rem;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 600;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.unit-toggle button.active {
  background: var(--color-primary);
  color: #000;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.advisory-box {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.5rem 0.75rem;
  background: rgba(202, 138, 4, 0.1);
  border: 1px solid rgba(202, 138, 4, 0.25);
  border-radius: var(--radius-md);
  font-size: var(--text-xs);
  color: var(--color-text);
  margin-bottom: var(--space-3);
}

.advisory-box svg {
  color: var(--color-primary);
  flex-shrink: 0;
}

.pea-type-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.pea-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.pea-btn:hover {
  border-color: var(--color-primary-light);
}

.pea-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.pea-btn-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.pea-btn-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.containment-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.containment-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.containment-text {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initPeaGravelCalculator() {
  const modePatioBtn = document.getElementById('pea-mode-patio');
  const modePlayBtn = document.getElementById('pea-mode-play');

  const lengthInput = document.getElementById('pea-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('pea-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('pea-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('pea-waste') as HTMLInputElement | null;

  const peaBtns = document.querySelectorAll('.pea-btn');

  let activeDensity = 1.35;
  let activeMode = 'patio';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * activeDensity;
    const totalLbs = totalTons * 2000;

    const totalBags = Math.ceil(totalCuFt / 0.5);
    const pallets = (totalBags / 60).toFixed(1);

    // Edging perimeter: 2 * (length + width)
    const edgingFt = Math.ceil(2 * (length + width));

    // Advisory check
    const advisoryText = document.getElementById('pea-advisory-text');
    const badge = document.getElementById('pea-badge');
    const firmnessRow = document.getElementById('row-pea-firmness');

    if (activeMode === 'patio') {
      if (depthInches > 2.5) {
        if (advisoryText) advisoryText.textContent = `Warning: ${depthInches}" is too deep for a walkway/patio. Excess pea gravel shifts like dry beach sand. Keep depth to 2.0" - 2.5".`;
        if (badge) badge.textContent = 'Caution: Sinking Risk';
        if (firmnessRow) firmnessRow.textContent = 'Spongy / Furniture Will Sink';
      } else {
        if (advisoryText) advisoryText.textContent = 'Optimal Walkability: 2.0" - 2.5" depth provides firm foot interlock without sinking.';
        if (badge) badge.textContent = 'Patio Footing Compliant';
        if (firmnessRow) firmnessRow.textContent = 'Firm & Stable (Walkable)';
      }
    } else {
      if (depthInches < 6.0) {
        if (advisoryText) advisoryText.textContent = 'Advisory: ASTM playground standards recommend at least 6" - 9" of pea gravel for child fall cushioning.';
        if (badge) badge.textContent = 'Cushioning Advisory';
      } else {
        if (advisoryText) advisoryText.textContent = 'Compliant: Meets child play area fall shock attenuation guidelines.';
        if (badge) badge.textContent = 'Play Area Compliant';
      }
      if (firmnessRow) firmnessRow.textContent = 'Shock Absorbing Cushion';
    }

    // Update KPIs
    const kpiTons = document.getElementById('kpi-pea-tons');
    const kpiLbs = document.getElementById('kpi-pea-lbs');
    const kpiYards = document.getElementById('kpi-pea-yards');
    const kpiCuFt = document.getElementById('kpi-pea-cuft');
    const kpiBags = document.getElementById('kpi-pea-bags');
    const kpiPallets = document.getElementById('kpi-pea-pallets');
    const kpiEdging = document.getElementById('kpi-pea-edging');

    const rowArea = document.getElementById('row-pea-area');
    const rowFabric = document.getElementById('row-pea-fabric');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs net`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft volume`;
    if (kpiBags) kpiBags.textContent = totalBags.toLocaleString();
    if (kpiPallets) kpiPallets.textContent = `${pallets} pallets (60 bags/pl)`;
    if (kpiEdging) kpiEdging.textContent = `${edgingFt} LF`;

    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowFabric) {
      const fab = Math.ceil(area * 1.10);
      const rolls = Math.ceil(fab / 300);
      rowFabric.textContent = `${fab.toLocaleString()} sq ft (${rolls} rolls 3'x100')`;
    }
  }

  if (modePatioBtn && modePlayBtn && depthInput) {
    modePatioBtn.addEventListener('click', () => {
      modePatioBtn.classList.add('active');
      modePlayBtn.classList.remove('active');
      activeMode = 'patio';
      depthInput.value = '2.5';
      calculate();
    });

    modePlayBtn.addEventListener('click', () => {
      modePlayBtn.classList.add('active');
      modePatioBtn.classList.remove('active');
      activeMode = 'play';
      depthInput.value = '6.0';
      calculate();
    });
  }

  peaBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      peaBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDensity = parseFloat(btn.getAttribute('data-density') || '1.35');
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initPeaGravelCalculator);
</script>
