---
// Pea gravel quantity estimator for rectangular areas
---
<section class="section" id="pea-calc">
  <div class="container">
    <div class="section-header">
      <h2>Estimate pea gravel for your area</h2>
      <div class="section-divider"></div>
      <p>Enter a rectangular footprint and the planned loose layer depth. Results include volume, an estimated bulk weight, half-cubic-foot bags, and the full perimeter if every side needs edging.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Project and dimensions</h3>
        </div>

        <div class="unit-toggle mode-toggle" role="group" aria-label="Project type">
          <button class="active" id="pea-mode-patio" type="button" aria-pressed="true">Patio / Path / Bed</button>
          <button id="pea-mode-play" type="button" aria-pressed="false">Play area</button>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="pea-length">Length</label>
            <input type="number" id="pea-length" value="25" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="pea-width">Width</label>
            <input type="number" id="pea-width" value="16" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="pea-depth">Loose gravel depth</label>
            <input type="number" id="pea-depth" value="2" min="0.5" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="pea-waste">Order allowance</label>
            <input type="number" id="pea-waste" value="10" min="0" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Walkability Advisory Alert -->
        <div id="pea-advisory-box" class="advisory-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="pea-advisory-text" role="status">For a patio or path, start with about 2 inches over a prepared base. Rounded stone still moves under feet and furniture.</span>
        </div>

        <!-- Pea Gravel Size -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
          <h3>Bulk density assumption</h3>
        </div>

        <div class="pea-type-grid" role="group" aria-label="Estimated material density">
          <button type="button" class="pea-btn active" aria-pressed="true" data-density="1.35">
            <div class="pea-btn-title">Typical estimate</div>
            <div class="pea-btn-spec">1.35 US short tons per cubic yard (2,700 lb/yd³)</div>
          </button>
          <button type="button" class="pea-btn" aria-pressed="false" data-density="1.40">
            <div class="pea-btn-title">Heavier estimate</div>
            <div class="pea-btn-spec">1.40 US short tons per cubic yard (2,800 lb/yd³)</div>
          </button>
        </div>
        <div class="input-field density-field">
          <label for="pea-density">Supplier loose bulk weight (US short tons per cubic yard)</label>
          <input type="number" id="pea-density" value="1.35" min="0.5" max="3" step="any" aria-describedby="pea-density-feedback" />
          <span class="unit-label">t/yd³</span>
        </div>
        <p class="calc-note" id="pea-density-feedback" role="status">Presets are planning assumptions. Enter your supplier’s weight if available; divide lb/yd³ by 2,000 to convert to US short tons/yd³.</p>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Pea Gravel Requirements</div>
          <div class="results-badge" id="pea-badge">Planning estimate</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-pea-tons">0.00</div>
            <div class="kpi-label">Estimated US Short Tons</div>
            <div class="kpi-subtext" id="kpi-pea-lbs">0 lb estimated weight</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-pea-yards">0.00</div>
            <div class="kpi-label">Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-pea-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-pea-bags">0</div>
            <div class="kpi-label">0.5 Cubic Foot Bags</div>
            <div class="kpi-subtext">Confirm the bag's labeled volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-pea-edging">0</div>
            <div class="kpi-label">Full Perimeter (Feet)</div>
            <div class="kpi-subtext">Subtract sides already contained</div>
          </div>
        </div>

        <!-- Containment Caution Box -->
        <div class="containment-card">
          <div class="containment-title">Before you order</div>
          <p class="containment-text">
            The allowance is applied to yards, tons, and bags. Pea gravel shifts because its rounded stones do not interlock; a secure edge helps keep it out of adjacent lawn or paving. The edging figure assumes all four sides of a rectangle need a border.
          </p>
        </div>

        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Measured footprint</span>
            <span class="breakdown-val" id="row-pea-area">400 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Optional separator fabric estimate</span>
            <span class="breakdown-val" id="row-pea-fabric">440 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Surface note</span>
            <span class="breakdown-val" id="row-pea-firmness">Rounded stone remains loose</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.unit-toggle {
  display: flex;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 3px;
  margin-bottom: var(--space-4);
}

.unit-toggle button {
  flex: 1;
  padding: 0.5rem;
  border: none;
  background: transparent;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  font-weight: 600;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.unit-toggle button.active {
  background: var(--color-primary);
  color: #000;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.advisory-box {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.5rem 0.75rem;
  background: rgba(202, 138, 4, 0.1);
  border: 1px solid rgba(202, 138, 4, 0.25);
  border-radius: var(--radius-md);
  font-size: var(--text-xs);
  color: var(--color-text);
  margin-bottom: var(--space-3);
}

.advisory-box svg {
  color: var(--color-primary);
  flex-shrink: 0;
}

.pea-type-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.pea-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.pea-btn:hover {
  border-color: var(--color-primary-light);
}

.pea-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.pea-btn-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.pea-btn-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.calc-note {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  line-height: 1.5;
  margin: 0;
}

.density-field {
  margin: var(--space-4) 0 var(--space-2);
}

.calc-note.error {
  color: #f87171;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.containment-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.containment-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.containment-text {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-3);
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
  text-align: right;
}
</style>

<script>
function initPeaGravelCalculator() {
  const modePatioBtn = document.getElementById('pea-mode-patio');
  const modePlayBtn = document.getElementById('pea-mode-play');

  const lengthInput = document.getElementById('pea-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('pea-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('pea-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('pea-waste') as HTMLInputElement | null;
  const densityInput = document.getElementById('pea-density') as HTMLInputElement | null;
  const densityFeedback = document.getElementById('pea-density-feedback');

  const peaBtns = document.querySelectorAll('.pea-btn');

  let activeMode = 'patio';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput || !densityInput) return;

    const length = Math.max(0, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0, parseFloat(depthInput.value) || 0);
    const wastePercent = Math.max(0, parseFloat(wasteInput.value) || 0);
    const density = Number(densityInput.value);
    const densityValid = densityInput.value.trim() !== '' && Number.isFinite(density) && density >= 0.5 && density <= 3;
    densityInput.setAttribute('aria-invalid', String(!densityValid));
    if (densityFeedback) {
      densityFeedback.textContent = densityValid
        ? 'Presets are planning assumptions. Enter your supplier’s weight if available; divide lb/yd³ by 2,000 to convert to US short tons/yd³.'
        : 'Enter a loose bulk weight from 0.5 to 3.0 US short tons per cubic yard.';
      densityFeedback.classList.toggle('error', !densityValid);
    }

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * density;
    const totalLbs = totalTons * 2000;

    // Ignore binary floating-point noise at exact half-cubic-foot boundaries.
    const totalBags = Math.ceil(totalCuFt / 0.5 - 1e-10);
    // Edging perimeter: 2 * (length + width)
    const edgingFt = length && width ? Math.ceil(2 * (length + width)) : 0;

    // Advisory check
    const advisoryText = document.getElementById('pea-advisory-text');
    const badge = document.getElementById('pea-badge');
    const firmnessRow = document.getElementById('row-pea-firmness');

    if (!length || !width || !depthInches) {
      if (advisoryText) advisoryText.textContent = 'Enter a positive length, width, and depth to estimate material.';
      if (badge) badge.textContent = 'Enter dimensions';
      if (firmnessRow) firmnessRow.textContent = 'Enter dimensions';
    } else if (activeMode === 'patio') {
      if (depthInches > 2.5) {
        if (advisoryText) advisoryText.textContent = 'A deep layer of rounded pea gravel can shift under shoes and chair legs. Consider a thinner decorative layer over a prepared, compacted base.';
        if (badge) badge.textContent = 'Deep loose layer';
        if (firmnessRow) firmnessRow.textContent = 'More movement likely';
      } else if (depthInches < 1.5) {
        if (advisoryText) advisoryText.textContent = 'A thin layer can be kicked aside and reveal the base. Check coverage after raking it level.';
        if (badge) badge.textContent = 'Thin loose layer';
        if (firmnessRow) firmnessRow.textContent = 'Base may show through';
      } else {
        if (advisoryText) advisoryText.textContent = 'About 1.5–2.5 inches is a practical starting range for a patio or path topping. Pea gravel stays loose; firmness depends on the base and use.';
        if (badge) badge.textContent = 'Patio / path estimate';
        if (firmnessRow) firmnessRow.textContent = 'Loose rounded surface';
      }
    } else {
      if (depthInches < 12) {
        if (advisoryText) advisoryText.textContent = 'CPSC Table 2 gives 12 inches at installation and 9 inches maintained for non-impact-tested pea gravel at a 5-foot critical height. This depth is below that initial fill figure.';
        if (badge) badge.textContent = 'Below initial fill guide';
      } else {
        if (advisoryText) advisoryText.textContent = 'CPSC Table 2 gives 12 inches installed and 9 inches maintained for non-impact-tested pea gravel at a 5-foot critical height. Quantity alone does not establish playground safety.';
        if (badge) badge.textContent = 'Quantity estimate only';
      }
      if (firmnessRow) firmnessRow.textContent = 'Check fall height and use zone';
    }
    if (badge && !densityValid && length && width && depthInches) badge.textContent = 'Check bulk weight';

    // Update KPIs
    const kpiTons = document.getElementById('kpi-pea-tons');
    const kpiLbs = document.getElementById('kpi-pea-lbs');
    const kpiYards = document.getElementById('kpi-pea-yards');
    const kpiCuFt = document.getElementById('kpi-pea-cuft');
    const kpiBags = document.getElementById('kpi-pea-bags');
    const kpiEdging = document.getElementById('kpi-pea-edging');

    const rowArea = document.getElementById('row-pea-area');
    const rowFabric = document.getElementById('row-pea-fabric');

    if (kpiTons) kpiTons.textContent = densityValid ? totalTons.toFixed(2) : '—';
    if (kpiLbs) kpiLbs.textContent = densityValid ? `${Math.round(totalLbs).toLocaleString()} lb incl. allowance` : 'Enter a valid bulk weight';
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft volume`;
    if (kpiBags) kpiBags.textContent = totalBags.toLocaleString();
    if (kpiEdging) kpiEdging.textContent = `${edgingFt} LF`;

    if (rowArea) rowArea.textContent = `${area.toLocaleString(undefined, { maximumFractionDigits: 2 })} sq ft (${length}' × ${width}')`;
    if (rowFabric) rowFabric.textContent = `${Math.ceil(area * 1.10).toLocaleString()} sq ft incl. 10% allowance`;
  }

  if (modePatioBtn && modePlayBtn && depthInput) {
    modePatioBtn.addEventListener('click', () => {
      modePatioBtn.classList.add('active');
      modePlayBtn.classList.remove('active');
      modePatioBtn.setAttribute('aria-pressed', 'true');
      modePlayBtn.setAttribute('aria-pressed', 'false');
      activeMode = 'patio';
      depthInput.value = '2';
      calculate();
    });

    modePlayBtn.addEventListener('click', () => {
      modePlayBtn.classList.add('active');
      modePatioBtn.classList.remove('active');
      modePlayBtn.setAttribute('aria-pressed', 'true');
      modePatioBtn.setAttribute('aria-pressed', 'false');
      activeMode = 'play';
      depthInput.value = '12';
      calculate();
    });
  }

  peaBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      peaBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      if (densityInput) densityInput.value = btn.getAttribute('data-density') || '1.35';
      calculate();
    });
  });

  if (densityInput) densityInput.addEventListener('input', () => {
    peaBtns.forEach(btn => {
      btn.classList.remove('active');
      btn.setAttribute('aria-pressed', 'false');
    });
    calculate();
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initPeaGravelCalculator);
</script>
