---
// Crushed Stone & Sieve Grade Sizer Calculator
---
<section class="section" id="crushed-calc">
  <div class="container">
    <div class="section-header">
      <h2>Crushed Stone Sieve Sizing & Tonnage Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate certified quarry tons and cubic yards across AASHTO standard sieve sizes: #57 clean stone, #411 dense graded aggregate, #4 ballast, and heavy riprap.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>AASHTO Sieve Specification</h3>
        </div>

        <div class="sieve-grid" role="radiogroup">
          <button type="button" class="sieve-btn active" data-density="1.40" data-comp="5" data-name="#57 Clean Crushed Stone (3/4&quot;)">
            <div class="sieve-title">#57 Clean Stone (1/2" - 1")</div>
            <div class="sieve-spec">1.40 T/yd³ | Washed drainage stone, retaining walls, top course</div>
          </button>
          <button type="button" class="sieve-btn" data-density="1.50" data-comp="20" data-name="#411 Dense Graded (Crusher Run)">
            <div class="sieve-title">#411 / DGA / Crusher Run</div>
            <div class="sieve-spec">1.50 T/yd³ | 3/4" stone mixed with limestone fines for solid base</div>
          </button>
          <button type="button" class="sieve-btn" data-density="1.45" data-comp="8" data-name="#4 Ballast Stone (1.5-2.5&quot;)">
            <div class="sieve-title">#4 Heavy Ballast (1.5" - 2.5")</div>
            <div class="sieve-spec">1.45 T/yd³ | Railroad ballast, construction entrance track-out pads</div>
          </button>
          <button type="button" class="sieve-btn" data-density="1.50" data-comp="5" data-name="#1 Heavy Rip-Rap (3-6&quot;)">
            <div class="sieve-title">#1 / Rip-Rap Stone (3" - 6")</div>
            <div class="sieve-spec">1.50 T/yd³ | Culvert outfalls, severe slope erosion control</div>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Excavation Area & Depth</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="crushed-length">Length</label>
            <input type="number" id="crushed-length" value="40" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="crushed-width">Width</label>
            <input type="number" id="crushed-width" value="12" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="crushed-depth">Depth</label>
            <input type="number" id="crushed-depth" value="4.0" min="1" max="24" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="crushed-waste">Compaction / Overage</label>
            <input type="number" id="crushed-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Crushed Aggregate Order Specs</div>
          <div class="results-badge" id="crushed-badge">#57 Clean Stone</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-crushed-tons">0.00</div>
            <div class="kpi-label">Certified Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-crushed-lbs">0 lbs total delivery</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-yards">0.00</div>
            <div class="kpi-label">Delivery Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-crushed-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-sqft">0</div>
            <div class="kpi-label">Surface Area (Sq Ft)</div>
            <div class="kpi-subtext">480 sq ft footprint</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-trips">0</div>
            <div class="kpi-label">Dump Truck Loads</div>
            <div class="kpi-subtext">Tri-axle or tandem hauler</div>
          </div>
        </div>

        <!-- Sieve Technical Spec Sheet -->
        <div class="sieve-spec-card">
          <div class="spec-card-title">Quarry Technical Sieve Breakdown</div>
          <div class="spec-table-wrap">
            <table class="spec-table">
              <tr>
                <td>Nominal Size Range:</td>
                <td id="spec-size-range">1/2" to 1" (12.5mm to 25mm)</td>
              </tr>
              <tr>
                <td>Void Ratio / Permeability:</td>
                <td id="spec-void-ratio">38% - 42% void space (Free Draining)</td>
              </tr>
              <tr>
                <td>Standard Sub-Base Application:</td>
                <td id="spec-app-use">Driveways, French drains, and paver bedding</td>
              </tr>
            </table>
          </div>
        </div>

        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Theoretical In-Place Solid Volume</span>
            <span class="breakdown-val" id="row-crushed-solid">160.0 cu ft (5.9 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Total Tonnage Order Buffer</span>
            <span class="breakdown-val" id="row-crushed-buffer">10% included for subgrade settlement</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.sieve-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.sieve-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.sieve-btn:hover {
  border-color: var(--color-primary-light);
}

.sieve-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.sieve-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.sieve-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.sieve-spec-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.spec-card-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.spec-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.75rem;
}

.spec-table td {
  padding: 4px 0;
  color: var(--color-text-muted);
}

.spec-table td:last-child {
  text-align: right;
  font-weight: 600;
  color: var(--color-text);
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initCrushedStoneCalculator() {
  const lengthInput = document.getElementById('crushed-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('crushed-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('crushed-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('crushed-waste') as HTMLInputElement | null;

  const sieveBtns = document.querySelectorAll('.sieve-btn');

  let activeDensity = 1.40;
  let activeName = '#57 Clean Stone';

  const specsMap: Record<string, { size: string; void: string; app: string }> = {
    '#57 Clean Crushed Stone (3/4")': {
      size: '1/2" to 1" (12.5mm to 25mm)',
      void: '38% - 42% void space (Free Draining)',
      app: 'Driveways, French drains, and paver bedding'
    },
    '#411 Dense Graded (Crusher Run)': {
      size: 'Dust up to 3/4" (0mm to 19mm)',
      void: '10% - 15% void space (Packs Solid)',
      app: 'Compacted paver base, asphalt driveway sub-base'
    },
    '#4 Heavy Ballast Stone (1.5-2.5")': {
      size: '1.5" to 2.5" (37mm to 63mm)',
      void: '45% void space (Heavy Interlocking)',
      app: 'Construction entrance track-out, railroad ballast'
    },
    '#1 Heavy Rip-Rap (3-6")': {
      size: '3" to 6" (75mm to 150mm)',
      void: '50% void space (Energy Dissipation)',
      app: 'Culvert outfalls, severe slope erosion defense'
    }
  };

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * activeDensity;
    const totalLbs = totalTons * 2000;

    const truckTrips = Math.ceil(totalTons / 15);

    // Update KPIs
    const kpiTons = document.getElementById('kpi-crushed-tons');
    const kpiLbs = document.getElementById('kpi-crushed-lbs');
    const kpiYards = document.getElementById('kpi-crushed-yards');
    const kpiCuFt = document.getElementById('kpi-crushed-cuft');
    const kpiSqFt = document.getElementById('kpi-crushed-sqft');
    const kpiTrips = document.getElementById('kpi-crushed-trips');
    const badge = document.getElementById('crushed-badge');

    const rowSolid = document.getElementById('row-crushed-solid');
    const rowBuffer = document.getElementById('row-crushed-buffer');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs net delivery`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft volume`;
    if (kpiSqFt) kpiSqFt.textContent = Math.round(area).toLocaleString();
    if (kpiTrips) kpiTrips.textContent = `${truckTrips} Load${truckTrips === 1 ? '' : 's'}`;
    if (badge) badge.textContent = activeName;

    if (rowSolid) rowSolid.textContent = `${netCuFt.toFixed(1)} cu ft (${(netCuFt / 27).toFixed(2)} yd³) in place`;
    if (rowBuffer) rowBuffer.textContent = `${wastePercent}% included for subgrade settlement`;

    // Spec card updates
    const spec = specsMap[activeName] || specsMap['#57 Clean Crushed Stone (3/4")'];
    const specSize = document.getElementById('spec-size-range');
    const specVoid = document.getElementById('spec-void-ratio');
    const specApp = document.getElementById('spec-app-use');

    if (specSize) specSize.textContent = spec.size;
    if (specVoid) specVoid.textContent = spec.void;
    if (specApp) specApp.textContent = spec.app;
  }

  sieveBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sieveBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDensity = parseFloat(btn.getAttribute('data-density') || '1.40');
      activeName = btn.getAttribute('data-name') || '#57 Clean Stone';
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initCrushedStoneCalculator);
</script>
