---
import { getMaterialById } from '../../scripts/materials-data.js';

const density57 = getMaterialById('clean-stone-57').tonsPerCuYd;
const densityBase = getMaterialById('crusher-run-21a').tonsPerCuYd;
const exampleCuFt = 40 * 12 * (4 / 12) * 1.10;
const exampleTons = exampleCuFt / 27 * density57;
---
<section class="section" id="crushed-calc">
  <div class="container">
    <div class="section-header">
      <h2>Estimate crushed stone yards, short tons, and delivery loads</h2>
      <div class="section-divider"></div>
      <p>Enter dimensions or measured square feet, select a standard aggregate grade, and replace the planning bulk density with your supplier’s figure when quoted.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Stone grade (ASTM D448 / base blends)</h3>
        </div>

        <div class="sieve-grid" aria-label="Stone grade">
          <button type="button" class="sieve-btn active" aria-pressed="true" data-density={density57} data-name="#57 clean stone">
            <span class="sieve-title">#57 clean stone (1"&ndash;#4)</span>
            <span class="sieve-spec">Low-fines drainage stone &middot; {density57.toFixed(2)} short tons/yd³</span>
          </button>
          <button type="button" class="sieve-btn" aria-pressed="false" data-density={densityBase} data-name="Crusher run / dense base">
            <span class="sieve-title">Crusher run / #411 / 21-A</span>
            <span class="sieve-spec">Compactable stone + fines &middot; {densityBase.toFixed(2)} short tons/yd³</span>
          </button>
          <button type="button" class="sieve-btn" aria-pressed="false" data-density="1.45" data-name="#4 clean stone">
            <span class="sieve-title">#4 clean stone (1&frac12;"&ndash;&frac34;")</span>
            <span class="sieve-spec">Coarse open aggregate &middot; 1.45 short tons/yd³</span>
          </button>
          <button type="button" class="sieve-btn" aria-pressed="false" data-density="1.50" data-name="#1 large stone">
            <span class="sieve-title">#1 large stone (3&frac12;"&ndash;1&frac12;")</span>
            <span class="sieve-spec">Heavy stabilization stone &middot; 1.50 short tons/yd³</span>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Area, finished depth &amp; rounding</h3>
        </div>

        <div class="unit-toggle" role="tablist" aria-label="Crushed stone input mode">
          <button type="button" class="active" role="tab" aria-selected="true" data-mode="rect">Length &times; Width</button>
          <button type="button" role="tab" aria-selected="false" data-mode="area">Known Sq Ft</button>
        </div>

        <div class="dim-grid" id="crushed-rect-fields">
          <div class="input-field">
            <label for="crushed-length">Length</label>
            <input type="number" id="crushed-length" value="40" min="0.01" step="any" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="crushed-width">Width</label>
            <input type="number" id="crushed-width" value="12" min="0.01" step="any" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid single" id="crushed-area-fields" hidden>
          <div class="input-field">
            <label for="crushed-known-area">Measured coverage area</label>
            <input type="number" id="crushed-known-area" value="480" min="0.01" step="any" />
            <span class="unit-label">sq ft</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="crushed-depth">Finished layer depth</label>
            <input type="number" id="crushed-depth" value="4.0" min="0.01" max="36" step="any" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="crushed-waste">Order allowance</label>
            <input type="number" id="crushed-waste" value="10" min="0" max="100" step="any" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="crushed-density">Loose bulk density</label>
            <input type="number" id="crushed-density" value={density57} min="0.01" max="3.5" step="any" />
            <span class="unit-label">tons/yd³</span>
          </div>
          <div class="input-field">
            <label for="crushed-increment">Seller yard rounding</label>
            <select id="crushed-increment">
              <option value="0">Exact decimal</option>
              <option value="0.25">Round up 0.25 yd³</option>
              <option value="0.5">Round up 0.50 yd³</option>
              <option value="1">Round up 1.00 yd³</option>
            </select>
          </div>
        </div>

        <details class="truck-details">
          <summary>Optional: Check truckloads (bed yd³ &amp; payload tons)</summary>
          <div class="dim-grid" style="margin-top: var(--space-3);">
            <div class="input-field">
              <label for="crushed-truck-yd">Truck bed volume</label>
              <input type="number" id="crushed-truck-yd" value="10" min="0.1" step="any" />
              <span class="unit-label">yd³</span>
            </div>
            <div class="input-field">
              <label for="crushed-truck-tons">Truck legal payload</label>
              <input type="number" id="crushed-truck-tons" value="12" min="0.1" step="any" />
              <span class="unit-label">tons</span>
            </div>
          </div>
        </details>

        <p class="calculator-note">The default 10% allowance is editable. Enter 0% when depth and compaction losses are already reflected in your measured thickness.</p>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Estimated order quantity</div>
          <div class="results-badge" id="crushed-badge">#57 clean stone</div>
        </div>
        <p id="crushed-input-error" class="calc-error" role="alert" hidden>Enter positive dimensions, depth (&le; 36 in), and density (0.01–3.5 tons/yd³). Extra must be 0–100%.</p>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-crushed-tons">{exampleTons.toFixed(2)}</div>
            <div class="kpi-label">Estimated short tons</div>
            <div class="kpi-subtext" id="kpi-crushed-lbs">{Math.round(exampleTons * 2000).toLocaleString('en')} lb estimated</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-yards">6.52</div>
            <div class="kpi-label">Order volume (cubic yards)</div>
            <div class="kpi-subtext" id="kpi-crushed-cuft">176.0 cu ft including allowance</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-sqft">480</div>
            <div class="kpi-label">Measured area (sq ft)</div>
            <div class="kpi-subtext" id="kpi-crushed-area-note">Length &times; width</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-loads">1 load</div>
            <div class="kpi-label">Estimated truckloads</div>
            <div class="kpi-subtext" id="kpi-crushed-effective">Effective cap: 8.89 yd³/load</div>
          </div>
        </div>

        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Finished volume before extra</span>
            <span class="breakdown-val" id="row-crushed-solid">160.0 cu ft (5.93 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Order allowance &amp; rounding</span>
            <span class="breakdown-val" id="row-crushed-buffer">10% added</span>
          </div>
          <div class="breakdown-row">
            <span>1 short ton covers at depth</span>
            <span class="breakdown-val" id="row-crushed-yield">60 sq ft</span>
          </div>
        </div>
        <p class="calculator-note">Confirm loose bulk weight and hauler payload capacity before ordering; scale weight on delivery determines billed tonnage.</p>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); margin-top: var(--space-6); }
@media (max-width: 900px) { .calc-wrapper { grid-template-columns: 1fr; } }
.calc-panel, .calc-results-panel { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-6); }
.calc-panel-title { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); color: var(--color-text); }
.calc-panel-title svg { color: var(--color-primary); }
.calc-panel-title h3 { font-size: var(--text-base); font-weight: 600; margin: 0; }
.sieve-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
@media (max-width: 520px) { .sieve-grid { grid-template-columns: 1fr; } }
.sieve-btn { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 0.65rem 0.75rem; text-align: left; cursor: pointer; display: flex; flex-direction: column; gap: 2px; transition: all var(--transition-fast); }
.sieve-btn:hover { border-color: var(--color-primary-light); }
.sieve-btn.active { border-color: var(--color-primary); background: rgba(202, 138, 4, 0.1); }
.sieve-title { font-size: var(--text-xs); font-weight: 700; color: var(--color-text); }
.sieve-spec { font-size: 0.7rem; color: var(--color-text-muted); }
.unit-toggle { display: flex; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 3px; margin-bottom: var(--space-4); }
.unit-toggle button { flex: 1; padding: 0.45rem; border: none; background: transparent; color: var(--color-text-muted); font-size: var(--text-xs); font-weight: 600; border-radius: var(--radius-sm); cursor: pointer; }
.unit-toggle button.active { background: var(--color-primary); color: var(--text-inverse); }
.dim-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-3); }
.dim-grid.single { grid-template-columns: 1fr; }
.dim-grid[hidden], [hidden] { display: none !important; }
.input-field { position: relative; display: flex; flex-direction: column; }
.input-field label { font-size: var(--text-xs); font-weight: 600; color: var(--color-text-muted); margin-bottom: var(--space-1); }
.input-field input, .input-field select { padding: 0.65rem 0.75rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-size: var(--text-base); font-weight: 600; outline: none; }
.input-field input { padding-right: 4.5rem; }
.input-field input[aria-invalid="true"] { border-color: var(--color-error); }
.input-field input:focus, .input-field select:focus { border-color: var(--color-primary); }
.input-field .unit-label { position: absolute; right: 0.75rem; bottom: 0.68rem; font-size: var(--text-xs); color: var(--color-text-muted); pointer-events: none; }
.truck-details { margin: var(--space-2) 0 var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); background: var(--color-bg); }
.truck-details summary { font-size: var(--text-xs); font-weight: 600; color: var(--color-text); cursor: pointer; }
.calculator-note { color: var(--color-text-muted); font-size: var(--text-xs); line-height: 1.55; margin: var(--space-3) 0 0; }
.calc-error { color: var(--color-error); font-size: var(--text-sm); font-weight: 600; margin: 0 0 var(--space-3); }
.results-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
.results-title { font-size: var(--text-base); font-weight: 600; color: var(--color-text); }
.results-badge { font-size: var(--text-xs); padding: 0.25rem 0.6rem; background: rgba(202, 138, 4, 0.14); color: var(--color-primary); border-radius: 9999px; font-weight: 600; }
.kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-4); }
.kpi-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4); }
.kpi-card.highlight { border-color: var(--color-primary); background: rgba(202, 138, 4, 0.06); }
.kpi-value { font-size: var(--text-2xl); font-weight: 700; color: var(--color-primary); line-height: 1.1; }
.kpi-label { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-1); }
.kpi-subtext { font-size: 0.72rem; color: var(--color-text); opacity: 0.82; margin-top: 0.15rem; }
.breakdown-list { display: flex; flex-direction: column; gap: var(--space-2); }
.breakdown-row { display: flex; justify-content: space-between; font-size: var(--text-xs); padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); }
.breakdown-val { font-weight: 600; color: var(--color-text); }
</style>

<script>
function initCrushedStoneCalculator() {
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#crushed-calc .unit-toggle button'));
  const rectPanel = document.getElementById('crushed-rect-fields');
  const areaPanel = document.getElementById('crushed-area-fields');
  const lengthInput = document.getElementById('crushed-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('crushed-width') as HTMLInputElement | null;
  const knownAreaInput = document.getElementById('crushed-known-area') as HTMLInputElement | null;
  const depthInput = document.getElementById('crushed-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('crushed-waste') as HTMLInputElement | null;
  const densityInput = document.getElementById('crushed-density') as HTMLInputElement | null;
  const incSelect = document.getElementById('crushed-increment') as HTMLSelectElement | null;
  const truckYdInput = document.getElementById('crushed-truck-yd') as HTMLInputElement | null;
  const truckTonsInput = document.getElementById('crushed-truck-tons') as HTMLInputElement | null;
  const sieveBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.sieve-btn'));

  let activeMode = 'rect';
  let activeName = '#57 clean stone';
  const setText = (id: string, txt: string) => { const n = document.getElementById(id); if (n) n.textContent = txt; };

  function calculate() {
    if (!lengthInput || !widthInput || !knownAreaInput || !depthInput || !wasteInput || !densityInput) return;

    const l = Number(lengthInput.value);
    const w = Number(widthInput.value);
    const kArea = Number(knownAreaInput.value);
    const depth = Number(depthInput.value);
    const extra = Number(wasteInput.value);
    const density = Number(densityInput.value);
    const inc = Number(incSelect?.value || 0);
    const area = activeMode === 'area' ? kArea : l * w;

    const areaOk = activeMode === 'area'
      ? knownAreaInput.value.trim() !== '' && Number.isFinite(kArea) && kArea > 0 && kArea <= 1e7
      : lengthInput.value.trim() !== '' && widthInput.value.trim() !== '' && Number.isFinite(l) && l > 0 && Number.isFinite(w) && w > 0 && Number.isFinite(area) && area <= 1e7;
    const depthOk = depthInput.value.trim() !== '' && Number.isFinite(depth) && depth > 0 && depth <= 36;
    const extraOk = wasteInput.value.trim() !== '' && Number.isFinite(extra) && extra >= 0 && extra <= 100;
    const densOk = densityInput.value.trim() !== '' && Number.isFinite(density) && density >= 0.01 && density <= 3.5;

    lengthInput.setAttribute('aria-invalid', String(activeMode === 'rect' && !(Number.isFinite(l) && l > 0)));
    widthInput.setAttribute('aria-invalid', String(activeMode === 'rect' && !(Number.isFinite(w) && w > 0)));
    knownAreaInput.setAttribute('aria-invalid', String(activeMode === 'area' && !(Number.isFinite(kArea) && kArea > 0)));
    depthInput.setAttribute('aria-invalid', String(!depthOk));
    wasteInput.setAttribute('aria-invalid', String(!extraOk));
    densityInput.setAttribute('aria-invalid', String(!densOk));

    const valid = areaOk && depthOk && extraOk && densOk;
    const errorEl = document.getElementById('crushed-input-error');
    if (errorEl) errorEl.hidden = valid;

    if (!valid) {
      ['kpi-crushed-tons', 'kpi-crushed-lbs', 'kpi-crushed-yards', 'kpi-crushed-cuft', 'kpi-crushed-sqft', 'kpi-crushed-loads', 'kpi-crushed-effective', 'row-crushed-solid', 'row-crushed-buffer', 'row-crushed-yield'].forEach(id => setText(id, '—'));
      return;
    }

    const netCuFt = area * (depth / 12);
    const rawOrderYards = (netCuFt * (1 + extra / 100)) / 27;
    const orderYards = inc > 0 ? Math.ceil((rawOrderYards - 1e-9) / inc) * inc : rawOrderYards;
    const orderCuFt = orderYards * 27;
    const totalTons = orderYards * density;
    const totalLbs = totalTons * 2000;

    setText('kpi-crushed-tons', totalTons.toFixed(2));
    setText('kpi-crushed-lbs', `${Math.round(totalLbs).toLocaleString('en')} lb estimated`);
    setText('kpi-crushed-yards', orderYards.toFixed(2));
    setText('kpi-crushed-cuft', `${orderCuFt.toFixed(1)} cu ft${inc > 0 ? ` (${inc} yd³ step)` : ' incl. allowance'}`);
    setText('kpi-crushed-sqft', Math.round(area).toLocaleString('en'));
    setText('kpi-crushed-area-note', activeMode === 'area' ? 'Entered area' : `${l}' × ${w}'`);
    setText('crushed-badge', activeName);
    setText('row-crushed-solid', `${netCuFt.toFixed(1)} cu ft (${(netCuFt / 27).toFixed(2)} yd³)`);
    setText('row-crushed-buffer', inc > 0 ? `${extra}% extra, rounded to ${inc} yd³` : `${extra}% added`);
    setText('row-crushed-yield', `${Math.round(324 / (depth * density)).toLocaleString('en')} sq ft`);

    const bedYd = Number(truckYdInput?.value);
    const payT = Number(truckTonsInput?.value);
    if (Number.isFinite(bedYd) && bedYd > 0 && Number.isFinite(payT) && payT > 0) {
      const effectiveYd = Math.min(bedYd, payT / density);
      const loads = Math.ceil(orderYards / effectiveYd - 1e-9);
      setText('kpi-crushed-loads', `${loads} ${loads === 1 ? 'load' : 'loads'}`);
      setText('kpi-crushed-effective', `Cap: ${effectiveYd.toFixed(2)} yd³/load`);
    } else {
      setText('kpi-crushed-loads', '—');
      setText('kpi-crushed-effective', 'Enter positive truck limits');
    }
  }

  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeMode = btn.dataset.mode || 'rect';
      modeBtns.forEach(b => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      if (rectPanel) rectPanel.hidden = activeMode !== 'rect';
      if (areaPanel) areaPanel.hidden = activeMode !== 'area';
      if (activeMode === 'area' && lengthInput && widthInput && knownAreaInput) {
        const a = Number(lengthInput.value) * Number(widthInput.value);
        if (Number.isFinite(a) && a > 0) knownAreaInput.value = String(Math.round(a * 10) / 10);
      }
      calculate();
    });
  });

  sieveBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sieveBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      if (densityInput) densityInput.value = btn.getAttribute('data-density') || densityInput.value;
      activeName = btn.getAttribute('data-name') || '#57 clean stone';
      calculate();
    });
  });

  densityInput?.addEventListener('input', () => {
    sieveBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
    activeName = 'Custom bulk density';
    calculate();
  });

  [lengthInput, widthInput, knownAreaInput, depthInput, wasteInput, truckYdInput, truckTonsInput].forEach(inp => inp?.addEventListener('input', calculate));
  incSelect?.addEventListener('change', calculate);
  calculate();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCrushedStoneCalculator);
} else {
  initCrushedStoneCalculator();
}
</script>
