---
import { getMaterialById } from '../../scripts/materials-data.js';

const density57 = getMaterialById('clean-stone-57').tonsPerCuYd;
const densityBase = getMaterialById('crusher-run-21a').tonsPerCuYd;
const exampleCuFt = 40 * 12 * (4 / 12) * 1.10;
const exampleTons = exampleCuFt / 27 * density57;
---
<section class="section" id="crushed-calc">
  <div class="container">
    <div class="section-header">
      <h2>Estimate crushed stone yards and tons</h2>
      <div class="section-divider"></div>
      <p>Enter the finished dimensions, select a common grade, and replace the sample bulk density with your supplier’s value when you have it. Results are estimates; the delivery scale ticket gives actual tons.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Stone grade</h3>
        </div>

        <div class="sieve-grid" aria-label="Stone grade">
          <button type="button" class="sieve-btn active" aria-pressed="true" data-density={density57} data-name="#57 clean stone">
            <span class="sieve-title">#57 clean stone</span>
            <span class="sieve-spec">Low-fines drainage aggregate · planning {density57.toFixed(2)} US short tons/yd³</span>
          </button>
          <button type="button" class="sieve-btn" aria-pressed="false" data-density={densityBase} data-name="Crusher run / dense-graded base">
            <span class="sieve-title">Crusher run / dense-graded base</span>
            <span class="sieve-spec">Stone with fines for a compacted base · planning {densityBase.toFixed(2)} US short tons/yd³</span>
          </button>
          <button type="button" class="sieve-btn" aria-pressed="false" data-density="1.45" data-name="#4 clean stone">
            <span class="sieve-title">#4 clean stone</span>
            <span class="sieve-spec">Coarse stone, roughly 2 in. to 3/4 in. · sample 1.45 US short tons/yd³</span>
          </button>
          <button type="button" class="sieve-btn" aria-pressed="false" data-density="1.50" data-name="#1 large stone">
            <span class="sieve-title">#1 large stone</span>
            <span class="sieve-spec">Large gradation, roughly 3½ in. to 1½ in. · sample 1.50 US short tons/yd³</span>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Area, finished depth and order allowance</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="crushed-length">Length</label>
            <input type="number" id="crushed-length" value="40" min="0.01" step="any" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="crushed-width">Width</label>
            <input type="number" id="crushed-width" value="12" min="0.01" step="any" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="crushed-depth">Finished layer depth</label>
            <input type="number" id="crushed-depth" value="4.0" min="0.01" step="any" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="crushed-waste">Order allowance</label>
            <input type="number" id="crushed-waste" value="10" min="0" step="any" />
            <span class="unit-label">% extra</span>
          </div>
        </div>
        <div class="input-field density-field">
          <label for="crushed-density">Loose bulk density (ask your supplier)</label>
          <input type="number" id="crushed-density" value={density57} min="0.01" step="any" />
          <span class="unit-label">short tons/yd³</span>
        </div>
        <p class="calculator-note">The default 10% is an editable planning allowance. Use 0% if your measured depth and supplier quantity already account for compaction and irregular ground.</p>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Estimated order quantity</div>
          <div class="results-badge" id="crushed-badge">#57 clean stone</div>
        </div>
        <p id="crushed-input-error" class="calculator-note" role="alert" style="display: none;">Enter positive dimensions and density. The order allowance can be zero or more.</p>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-crushed-tons">{exampleTons.toFixed(2)}</div>
            <div class="kpi-label">Estimated US short tons</div>
            <div class="kpi-subtext" id="kpi-crushed-lbs">{Math.round(exampleTons * 2000).toLocaleString('en-US')} lbs estimated</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-yards">6.52</div>
            <div class="kpi-label">Order volume (cubic yards)</div>
            <div class="kpi-subtext" id="kpi-crushed-cuft">176.0 cu ft including allowance</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-crushed-sqft">480</div>
            <div class="kpi-label">Measured area (sq ft)</div>
            <div class="kpi-subtext">Length × width</div>
          </div>
        </div>

        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Finished layer volume before allowance</span>
            <span class="breakdown-val" id="row-crushed-solid">160.0 cu ft (5.93 yd³)</span>
          </div>
          <div class="breakdown-row">
            <span>Order allowance</span>
            <span class="breakdown-val" id="row-crushed-buffer">10% added</span>
          </div>
        </div>
        <p class="calculator-note">Confirm the quarry’s loose density and the hauler’s load capacity. The estimate cannot certify the delivered weight.</p>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.sieve-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.sieve-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.sieve-btn:hover {
  border-color: var(--color-primary-light);
}

.sieve-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.sieve-title {
  display: block;
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.sieve-spec {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card:last-child { grid-column: 1 / -1; }

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-2);
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}

.density-field { margin-bottom: var(--space-3); }
.density-field input { padding-right: 8.5rem; }
.calculator-note {
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  line-height: 1.55;
  margin: var(--space-3) 0 0;
}
</style>

<script>
function initCrushedStoneCalculator() {
  const lengthInput = document.getElementById('crushed-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('crushed-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('crushed-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('crushed-waste') as HTMLInputElement | null;
  const densityInput = document.getElementById('crushed-density') as HTMLInputElement | null;

  const sieveBtns = document.querySelectorAll('.sieve-btn');

  let activeName = '#57 clean stone';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput || !densityInput) return;

    const values = [lengthInput, widthInput, depthInput, wasteInput, densityInput].map(input => Number(input.value));
    const [length, width, depthInches, wastePercent, density] = values;
    const valid = [lengthInput, widthInput, depthInput, wasteInput, densityInput].every(input => input.value.trim() !== '' && input.validity.valid)
      && values.every(Number.isFinite) && length > 0 && width > 0 && depthInches > 0 && wastePercent >= 0 && density > 0;
    const error = document.getElementById('crushed-input-error');
    if (error) error.style.display = valid ? 'none' : 'block';
    if (!valid) {
      ['kpi-crushed-tons', 'kpi-crushed-lbs', 'kpi-crushed-yards', 'kpi-crushed-cuft', 'kpi-crushed-sqft', 'row-crushed-solid', 'row-crushed-buffer'].forEach(id => {
        const output = document.getElementById(id);
        if (output) output.textContent = '—';
      });
      return;
    }

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * density;
    const totalLbs = totalTons * 2000;

    // Update KPIs
    const kpiTons = document.getElementById('kpi-crushed-tons');
    const kpiLbs = document.getElementById('kpi-crushed-lbs');
    const kpiYards = document.getElementById('kpi-crushed-yards');
    const kpiCuFt = document.getElementById('kpi-crushed-cuft');
    const kpiSqFt = document.getElementById('kpi-crushed-sqft');
    const badge = document.getElementById('crushed-badge');

    const rowSolid = document.getElementById('row-crushed-solid');
    const rowBuffer = document.getElementById('row-crushed-buffer');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs estimated`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft including allowance`;
    if (kpiSqFt) kpiSqFt.textContent = Math.round(area).toLocaleString();
    if (badge) badge.textContent = activeName;

    if (rowSolid) rowSolid.textContent = `${netCuFt.toFixed(1)} cu ft (${(netCuFt / 27).toFixed(2)} yd³)`;
    if (rowBuffer) rowBuffer.textContent = `${wastePercent}% added`;
  }

  sieveBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      sieveBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      if (densityInput) densityInput.value = btn.getAttribute('data-density') || densityInput.value;
      activeName = btn.getAttribute('data-name') || '#57 clean stone';
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput, densityInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCrushedStoneCalculator);
} else {
  initCrushedStoneCalculator();
}
</script>
