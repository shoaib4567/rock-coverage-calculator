---
// Decorative Rock & Ornamental Stone Calculator
---
<section class="section" id="decorative-calc">
  <div class="container">
    <div class="section-header">
      <h2>Decorative Rock & Xeriscape Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate exact tonnage and retail bag requirements for premium decorative rock: Mexican Beach Pebble, Red Lava Rock, White Marble Chips, and Colorado Cobble.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Decorative Rock Material Selection</h3>
        </div>

        <div class="rock-select-grid" role="radiogroup">
          <button type="button" class="rock-btn active" data-density="1.40" data-min="2.5" data-name="Mexican Beach Pebble (Black)">
            <div class="rock-title">Mexican Beach Pebble (Black)</div>
            <div class="rock-spec">Premium volcanic unglazed | 1.40 T/yd³ | Min 2.5" depth</div>
          </button>
          <button type="button" class="rock-btn" data-density="0.85" data-min="2.0" data-name="Volcanic Red Lava Rock">
            <div class="rock-title">Volcanic Red Lava Rock</div>
            <div class="rock-spec">Ultra lightweight porous | 0.85 T/yd³ | High coverage yield</div>
          </button>
          <button type="button" class="rock-btn" data-density="1.35" data-name="Royal White Marble Chips">
            <div class="rock-title">White Marble Chips</div>
            <div class="rock-spec">High reflective sparkle | 1.35 T/yd³ | Min 2.0" depth</div>
          </button>
          <button type="button" class="rock-btn" data-density="1.35" data-name="Colorado Rainbow River Rock">
            <div class="rock-title">Colorado Rainbow Cobble</div>
            <div class="rock-spec">Multi-color pastels | 1.35 T/yd³ | Min 3.0" depth</div>
          </button>
        </div>

        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Landscape Bed Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="deco-length">Bed Length</label>
            <input type="number" id="deco-length" value="25" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="deco-width">Bed Width</label>
            <input type="number" id="deco-width" value="10" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="deco-depth">Depth</label>
            <input type="number" id="deco-depth" value="2.5" min="1" max="12" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="deco-waste">Safety Buffer</label>
            <input type="number" id="deco-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Decorative Coverage Yield</div>
          <div class="results-badge" id="deco-mat-badge">Mexican Beach Pebble</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-deco-tons">0.00</div>
            <div class="kpi-label">Required Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-deco-lbs">0 lbs bulk weight</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-deco-yards">0.00</div>
            <div class="kpi-label">Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-deco-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-deco-bags">0</div>
            <div class="kpi-label">0.5 Cu Ft Retail Bags</div>
            <div class="kpi-subtext" id="kpi-deco-pallets">0 full pallets</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-deco-fabric">0</div>
            <div class="kpi-label">Weed Barrier (Sq Ft)</div>
            <div class="kpi-subtext" id="kpi-deco-rolls">0 rolls (3' x 100')</div>
          </div>
        </div>

        <!-- Comparative Density Insight -->
        <div class="comparison-yield-card">
          <div class="yield-title">Density & Yield Comparison Insight</div>
          <p class="yield-desc" id="yield-comparison-text">
            Mexican Beach Pebble weighs 1.40 tons/yd³. Switching to lightweight Volcanic Lava Rock (0.85 tons/yd³) would reduce your total delivery freight weight by ~39% while covering the exact same 250 sq ft area.
          </p>
        </div>

        <!-- Landscape Guide Note -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Surface Coverage Area</span>
            <span class="breakdown-val" id="row-deco-area">250 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Recommended Edging Trench Depth</span>
            <span class="breakdown-val">3.5 inches (prevent stone scatter)</span>
          </div>
          <div class="breakdown-row">
            <span>Sub-Base Requirement</span>
            <span class="breakdown-val">Commercial non-woven needle punched fabric</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.rock-select-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.rock-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.rock-btn:hover {
  border-color: var(--color-primary-light);
}

.rock-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.rock-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.rock-spec {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.comparison-yield-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.yield-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.yield-desc {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  line-height: 1.4;
  margin: 0;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initDecorativeCalculator() {
  const lengthInput = document.getElementById('deco-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('deco-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('deco-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('deco-waste') as HTMLInputElement | null;

  const rockBtns = document.querySelectorAll('.rock-btn');

  let activeDensity = 1.40; // Mexican beach pebble
  let activeMatName = 'Mexican Beach Pebble (Black)';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * activeDensity;
    const totalLbs = totalTons * 2000;

    const totalBags = Math.ceil(totalCuFt / 0.5);
    const pallets = (totalBags / 60).toFixed(1);

    const fabricSqFt = Math.ceil(area * 1.10);
    const rolls3x100 = Math.ceil(fabricSqFt / 300);

    // Update KPI displays
    const kpiTons = document.getElementById('kpi-deco-tons');
    const kpiLbs = document.getElementById('kpi-deco-lbs');
    const kpiYards = document.getElementById('kpi-deco-yards');
    const kpiCuFt = document.getElementById('kpi-deco-cuft');
    const kpiBags = document.getElementById('kpi-deco-bags');
    const kpiPallets = document.getElementById('kpi-deco-pallets');
    const kpiFabric = document.getElementById('kpi-deco-fabric');
    const kpiRolls = document.getElementById('kpi-deco-rolls');
    const badge = document.getElementById('deco-mat-badge');
    const yieldText = document.getElementById('yield-comparison-text');
    const rowArea = document.getElementById('row-deco-area');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs net`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft total`;
    if (kpiBags) kpiBags.textContent = totalBags.toLocaleString();
    if (kpiPallets) kpiPallets.textContent = `${pallets} pallets (60 bags/pl)`;
    if (kpiFabric) kpiFabric.textContent = Math.round(area).toLocaleString();
    if (kpiRolls) kpiRolls.textContent = `${rolls3x100} roll${rolls3x100 === 1 ? '' : 's'} (3' x 100')`;
    if (badge) badge.textContent = activeMatName;
    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;

    if (yieldText) {
      if (activeDensity === 0.85) {
        yieldText.textContent = `Volcanic Lava Rock is ultra-lightweight (0.85 tons/yd³). You require only ${totalTons.toFixed(2)} tons. A traditional gravel would weigh ${((totalTons / 0.85) * 1.35).toFixed(2)} tons, saving significant hauling energy.`;
      } else {
        const lavaTons = ((totalTons / activeDensity) * 0.85).toFixed(2);
        yieldText.textContent = `${activeMatName} has a density of ${activeDensity.toFixed(2)} T/yd³. For this ${Math.round(area)} sq ft area, it requires ${totalTons.toFixed(2)} tons. Switching to Volcanic Lava Rock would only require ${lavaTons} tons.`;
      }
    }
  }

  rockBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rockBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDensity = parseFloat(btn.getAttribute('data-density') || '1.40');
      const minDepth = parseFloat(btn.getAttribute('data-min') || '2.0');
      const titleEl = btn.querySelector('.rock-title');
      if (titleEl) activeMatName = titleEl.textContent || 'Decorative Rock';

      if (depthInput && parseFloat(depthInput.value) < minDepth) {
        depthInput.value = minDepth.toFixed(1);
      }
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initDecorativeCalculator);
</script>
