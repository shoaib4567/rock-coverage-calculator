---
// Quantity is driven by finished depth; weight and bag count use editable supplier assumptions.
---
<section class="section deco-calculator" id="decorative-calc" aria-labelledby="deco-calc-title">
  <div class="container">
    <div class="section-header">
      <h2 id="deco-calc-title">Estimate your decorative rock order</h2>
      <div class="section-divider"></div>
      <p>Measure the area, choose a finished layer depth, then match the weight and bag volume to the product you plan to buy.</p>
    </div>

    <div class="deco-layout">
      <div class="deco-panel">
        <fieldset class="deco-materials">
          <legend>Choose a starting material</legend>
          <p class="deco-help">These weights are planning examples for loose rock. The number on your supplier's quote takes priority.</p>
          <div class="deco-material-grid">
            <button class="deco-material active" type="button" aria-pressed="true" data-name="Mixed decorative stone" data-density="1.30" data-bag-volume="0.5" data-tone="mixed">
              <strong>Mixed decorative stone</strong><span>1.30 US tons / yd³ example</span>
            </button>
            <button class="deco-material" type="button" aria-pressed="false" data-name="White marble chips" data-density="1.35" data-bag-volume="0.5" data-tone="marble">
              <strong>White marble chips</strong><span>1.35 US tons / yd³ example</span>
            </button>
            <button class="deco-material" type="button" aria-pressed="false" data-name="Red lava rock" data-density="0.75" data-bag-volume="0.5" data-tone="lava">
              <strong>Red lava rock</strong><span>0.75 US tons / yd³ example</span>
            </button>
            <button class="deco-material" type="button" aria-pressed="false" data-name="Beach pebbles" data-density="1.35" data-bag-volume="0.25" data-tone="pebble">
              <strong>Beach pebbles</strong><span>1.35 US tons / yd³ placeholder</span>
            </button>
          </div>
        </fieldset>

        <div class="deco-input-grid">
          <label>Length <span>feet</span><input id="deco-length" type="number" inputmode="decimal" min="0.01" step="any" value="10" /></label>
          <label>Width <span>feet</span><input id="deco-width" type="number" inputmode="decimal" min="0.01" step="any" value="10" /></label>
          <label>Finished depth <span>inches</span><input id="deco-depth" type="number" inputmode="decimal" min="0.25" step="any" value="3" /></label>
          <label>Extra for edges / spill <span>%</span><input id="deco-extra" type="number" inputmode="decimal" min="0" max="100" step="any" value="0" /></label>
          <label>Loose bulk weight <span>US tons / yd³</span><input id="deco-density" type="number" inputmode="decimal" min="0.01" step="any" value="1.30" /></label>
          <label>Bag volume on label <span>ft³ / bag</span><input id="deco-bag-size" type="number" inputmode="decimal" min="0.01" step="any" value="0.5" /></label>
        </div>
        <p class="deco-help" id="deco-bag-hint">The 0.5 ft³ bag is a starting example. Enter the volume printed on the product you will buy; bag count does not come from pounds.</p>
        <p class="deco-help">US short ton = 2,000 lb. Only add an allowance you actually need.</p>
      </div>

      <div class="deco-panel deco-result" aria-live="polite">
        <p class="deco-result-kicker">For <span id="deco-material-name">mixed decorative stone</span></p>
        <p class="deco-error" id="deco-error" hidden>Correct the highlighted inputs. Dimensions must be at least 0.01 ft, depth at least 0.25 in, weight and bag size at least 0.01, and extra 0–100%.</p>
        <div class="deco-result-grid">
          <div class="deco-result-main"><strong id="deco-yards">0.93</strong><span>cubic yards to order</span></div>
          <div><strong id="deco-tons">1.20</strong><span>US short tons, estimated</span></div>
          <div><strong id="deco-bags">50</strong><span>bags at your labeled volume</span></div>
        </div>
        <dl class="deco-breakdown">
          <div><dt>Area</dt><dd id="deco-area">100 sq ft</dd></div>
          <div><dt>Base volume</dt><dd id="deco-base">25.0 ft³</dd></div>
          <div><dt>Extra volume</dt><dd id="deco-extra-volume">0.0 ft³</dd></div>
          <div><dt>Total volume</dt><dd id="deco-total">25.0 ft³</dd></div>
          <div><dt>Estimated load weight</dt><dd id="deco-pounds">2,407 lb</dd></div>
        </dl>
        <p class="deco-formula">Area × depth in feet = cubic feet. Divide by 27 for cubic yards; multiply by your supplier's tons per yard for weight. Divide total cubic feet by labeled bag volume and round up.</p>
        <p class="deco-order-note">Compare the bulk quote, delivery charge, bag label and vehicle payload before purchasing. For a small accent patch, bags may be easier to place; a larger bed may favor delivery.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const decoRoot = document.querySelector<HTMLElement>('.deco-calculator');
  if (decoRoot) {
    const input = (id: string) => decoRoot.querySelector<HTMLInputElement>('#' + id)!;
    const output = (id: string) => decoRoot.querySelector<HTMLElement>('#' + id)!;
    const materialButtons = Array.from(decoRoot.querySelectorAll<HTMLButtonElement>('.deco-material'));
    const numericInputs = ['deco-length', 'deco-width', 'deco-depth', 'deco-extra', 'deco-density', 'deco-bag-size'].map(input);
    const bagField = input('deco-bag-size');
    let bagVolumeEdited = false;
    const display = (value: number, digits = 2) => value.toLocaleString('en-US', { maximumFractionDigits: digits, minimumFractionDigits: digits });
    const empty = ['deco-area', 'deco-base', 'deco-extra-volume', 'deco-total', 'deco-yards', 'deco-tons', 'deco-bags', 'deco-pounds'];

    function calculate() {
      const length = input('deco-length').valueAsNumber;
      const width = input('deco-width').valueAsNumber;
      const depth = input('deco-depth').valueAsNumber;
      const extra = input('deco-extra').valueAsNumber;
      const density = input('deco-density').valueAsNumber;
      const bagSize = input('deco-bag-size').valueAsNumber;
      const checks: Record<string, boolean> = {
        'deco-length': Number.isFinite(length) && length >= 0.01,
        'deco-width': Number.isFinite(width) && width >= 0.01,
        'deco-depth': Number.isFinite(depth) && depth >= 0.25,
        'deco-extra': Number.isFinite(extra) && extra >= 0 && extra <= 100,
        'deco-density': Number.isFinite(density) && density >= 0.01,
        'deco-bag-size': Number.isFinite(bagSize) && bagSize >= 0.01
      };
      numericInputs.forEach(field => field.setAttribute('aria-invalid', String(!checks[field.id])));
      output('deco-error').hidden = Object.values(checks).every(Boolean);
      const geometryValid = checks['deco-length'] && checks['deco-width'] && checks['deco-depth'] && checks['deco-extra'];
      if (!geometryValid) {
        empty.forEach(id => output(id).textContent = '—');
        return;
      }

      const area = length * width;
      const base = area * depth / 12;
      const extraVolume = base * extra / 100;
      const total = base + extraVolume;
      const yards = total / 27;
      output('deco-area').textContent = display(area, 1) + ' sq ft';
      output('deco-base').textContent = display(base, 1) + ' ft³';
      output('deco-extra-volume').textContent = display(extraVolume, 1) + ' ft³';
      output('deco-total').textContent = display(total, 1) + ' ft³';
      output('deco-yards').textContent = display(yards);
      const tons = checks['deco-density'] ? yards * density : NaN;
      output('deco-tons').textContent = Number.isFinite(tons) ? display(tons) : '—';
      output('deco-pounds').textContent = Number.isFinite(tons) ? Math.round(tons * 2000).toLocaleString('en-US') + ' lb' : '—';
      output('deco-bags').textContent = checks['deco-bag-size'] ? Math.ceil(total / bagSize - 1e-10).toLocaleString('en-US') : '—';
    }

    function updateBagHint(tone: string) {
      output('deco-bag-hint').textContent = bagVolumeEdited
        ? 'Using the bag volume you entered. Check it against the exact product label before buying.'
        : tone === 'pebble'
          ? 'The 0.25 ft³ bag is one beach-pebble product example. Replace it with the volume printed on your bag.'
          : 'The 0.5 ft³ bag is a starting example. Enter the volume printed on the product you will buy; bag count does not come from pounds.';
    }

    materialButtons.forEach(button => button.addEventListener('click', () => {
      materialButtons.forEach(other => {
        const active = other === button;
        other.classList.toggle('active', active);
        other.setAttribute('aria-pressed', String(active));
      });
      input('deco-density').value = button.dataset.density || '1.30';
      if (!bagVolumeEdited) bagField.value = button.dataset.bagVolume || '0.5';
      updateBagHint(button.dataset.tone || 'mixed');
      output('deco-material-name').textContent = (button.dataset.name || 'decorative stone').toLowerCase();
      calculate();
    }));
    numericInputs.filter(field => field !== bagField).forEach(field => field.addEventListener('input', calculate));
    bagField.addEventListener('input', () => {
      bagVolumeEdited = true;
      const selected = materialButtons.find(button => button.getAttribute('aria-pressed') === 'true');
      updateBagHint(selected?.dataset.tone || 'mixed');
      calculate();
    });
    calculate();
  }
</script>

<style>
  .deco-layout { display:grid; grid-template-columns: minmax(0,1.15fr) minmax(0,0.85fr); gap:var(--space-6); align-items:start; }
  .deco-panel { padding:var(--space-6); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); background:var(--bg-card); color:var(--text-primary); }
  .deco-materials { border:0; margin:0 0 var(--space-5); padding:0; }
  .deco-materials legend { font-weight:700; font-size:1.1rem; padding:0; }
  .deco-help { margin:var(--space-2) 0 var(--space-4); color:var(--text-muted); font-size:.87rem; line-height:1.55; }
  .deco-material-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-3); }
  .deco-material { text-align:left; color:var(--text-primary); border:1px solid var(--border-subtle); background:var(--bg-surface); border-radius:var(--radius-md); padding:var(--space-3); cursor:pointer; }
  .deco-material.active { border-color:var(--accent-gold); box-shadow:0 0 0 1px var(--accent-gold) inset; }
  .deco-material strong,.deco-material span { display:block; }
  .deco-material strong { font-size:.9rem; margin-bottom:.35rem; }
  .deco-material span { color:var(--text-muted); font-size:.75rem; line-height:1.35; }
  .deco-input-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); }
  .deco-input-grid label { display:flex; flex-direction:column; font-size:.85rem; font-weight:650; gap:.3rem; }
  .deco-input-grid label span { color:var(--text-muted); font-weight:400; font-size:.75rem; }
  .deco-input-grid input { min-width:0; width:100%; border:1px solid var(--border-subtle); border-radius:var(--radius-md); color:var(--text-primary); background:var(--bg-surface); padding:.7rem .8rem; font:inherit; }
  .deco-input-grid input:focus-visible,.deco-material:focus-visible { outline:2px solid var(--accent-gold); outline-offset:2px; }
  .deco-input-grid input[aria-invalid="true"] { border-color:#dc2626; box-shadow:0 0 0 1px #dc2626 inset; }
  .deco-result-kicker { margin:0 0 var(--space-5); color:var(--text-muted); font-size:.8rem; letter-spacing:.05em; text-transform:uppercase; }
  .deco-result-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-3); }
  .deco-result-grid > div { background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:var(--space-4); }
  .deco-result-grid .deco-result-main { grid-column:1/-1; border-color:var(--accent-gold); }
  .deco-result-grid strong,.deco-result-grid span { display:block; }
  .deco-result-grid strong { color:var(--text-primary); font-size:clamp(1.7rem,3vw,2.4rem); line-height:1.1; }
  .deco-result-grid span { margin-top:.4rem; color:var(--text-muted); font-size:.8rem; }
  .deco-breakdown { margin:var(--space-5) 0; }
  .deco-breakdown div { display:flex; justify-content:space-between; gap:var(--space-4); border-bottom:1px solid var(--border-subtle); padding:.55rem 0; font-size:.85rem; }
  .deco-breakdown dt { color:var(--text-muted); }
  .deco-breakdown dd { margin:0; font-weight:650; text-align:right; }
  .deco-formula,.deco-order-note { color:var(--text-muted); font-size:.83rem; line-height:1.55; margin:var(--space-3) 0 0; }
  .deco-order-note { border-left:3px solid var(--accent-gold); padding-left:var(--space-3); }
  .deco-error { color:#f87171; margin:0 0 var(--space-4); font-size:.85rem; }
  @media(max-width:850px) { .deco-layout { grid-template-columns:1fr; } }
  @media(max-width:520px) { .deco-panel { padding:var(--space-4); } .deco-material-grid { grid-template-columns:1fr; } }
</style>
