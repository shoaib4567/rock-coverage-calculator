---
// Landscape Rock & Weed Barrier Fabric Calculator
---
<section class="section" id="landscape-rock-calc">
  <div class="container">
    <div class="section-header">
      <h2>Landscape Rock & Stone Mulch Calculator</h2>
      <div class="section-divider"></div>
      <p>Calculate bulk tonnage, weed fabric rolls, landscape staples, and long-term cost savings when replacing organic wood mulch with permanent decorative stone.</p>
    </div>

    <div class="calc-wrapper">
      <!-- Input Panel -->
      <div class="calc-panel animate-fade-in-up">
        <div class="calc-panel-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h3>Landscape Bed Dimensions</h3>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="land-length">Total Bed Length</label>
            <input type="number" id="land-length" value="40" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
          <div class="input-field">
            <label for="land-width">Average Bed Width</label>
            <input type="number" id="land-width" value="8" min="1" step="0.5" />
            <span class="unit-label">feet</span>
          </div>
        </div>

        <div class="dim-grid">
          <div class="input-field">
            <label for="land-depth">Stone Mulch Depth</label>
            <input type="number" id="land-depth" value="3.0" min="1" max="8" step="0.5" />
            <span class="unit-label">inches</span>
          </div>
          <div class="input-field">
            <label for="land-waste">Grade Settling Buffer</label>
            <input type="number" id="land-waste" value="10" min="0" max="25" step="1" />
            <span class="unit-label">% extra</span>
          </div>
        </div>

        <!-- Stone Variety -->
        <div class="calc-panel-title" style="margin-top: var(--space-4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <h3>Landscape Rock Spec</h3>
        </div>

        <div class="stone-opt-grid" role="radiogroup">
          <button type="button" class="land-btn active" data-density="1.35" data-name="River Rock Mulch (1-3&quot;)">
            <div class="land-btn-title">1" - 3" River Rock Mulch</div>
            <div class="land-btn-desc">1.35 T/yd³ | Classic rounded garden bed groundcover</div>
          </button>
          <button type="button" class="land-btn" data-density="1.40" data-name="Crushed Granite Chips">
            <div class="land-btn-title">Crushed Granite / Traprock</div>
            <div class="land-btn-desc">1.40 T/yd³ | Sharp interlocking angular stone</div>
          </button>
          <button type="button" class="land-btn" data-density="0.85" data-name="Porous Volcanic Lava Rock">
            <div class="land-btn-title">Volcanic Red/Black Lava</div>
            <div class="land-btn-desc">0.85 T/yd³ | Lightweight, excellent moisture retention</div>
          </button>
        </div>
      </div>

      <!-- Output Panel -->
      <div class="calc-results-panel animate-fade-in-up">
        <div class="results-header">
          <div class="results-title">Project Material Requirements</div>
          <div class="results-badge" id="land-badge">1" - 3" River Rock</div>
        </div>

        <div class="kpi-grid">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-land-tons">0.00</div>
            <div class="kpi-label">Quarry Weight (Tons)</div>
            <div class="kpi-subtext" id="kpi-land-lbs">0 lbs bulk weight</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-land-yards">0.00</div>
            <div class="kpi-label">Volume (Cubic Yards)</div>
            <div class="kpi-subtext" id="kpi-land-cuft">0 cu ft volume</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-land-fabric">0</div>
            <div class="kpi-label">Weed Fabric (Sq Ft)</div>
            <div class="kpi-subtext" id="kpi-land-rolls">0 rolls (3' x 100')</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-land-staples">0</div>
            <div class="kpi-label">Fabric Anchor Staples</div>
            <div class="kpi-subtext">6" steel anchor pins</div>
          </div>
        </div>

        <!-- Rock vs Wood Mulch 5-Year Cost ROI -->
        <div class="roi-card">
          <div class="roi-title">5-Year Permanent Rock vs Wood Mulch Payback</div>
          <div class="roi-stats">
            <div class="roi-item">
              <span class="roi-lbl">Annual Wood Mulch Cost (5 Yrs):</span>
              <span class="roi-val wood" id="roi-wood-cost">$0</span>
            </div>
            <div class="roi-item">
              <span class="roi-lbl">One-Time Stone Mulch Investment:</span>
              <span class="roi-val stone" id="roi-stone-cost">$0</span>
            </div>
          </div>
          <p class="roi-explanation" id="roi-explanation">
            Permanent landscape stone eliminates the annual chore and expense of buying 40 bags of decaying wood mulch every spring.
          </p>
        </div>

        <!-- Breakdown List -->
        <div class="breakdown-list">
          <div class="breakdown-row">
            <span>Plant Bed Surface Area</span>
            <span class="breakdown-val" id="row-land-area">320 sq ft</span>
          </div>
          <div class="breakdown-row">
            <span>Thermal Plant Protection</span>
            <span class="breakdown-val">Keep stone 3" away from shrub stems to prevent heat stress</span>
          </div>
          <div class="breakdown-row">
            <span>0.5 Cu Ft Bag Equivalent</span>
            <span class="breakdown-val" id="row-land-bags">176 bags</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.calc-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  margin-top: var(--space-6);
}

@media (max-width: 900px) {
  .calc-wrapper {
    grid-template-columns: 1fr;
  }
}

.calc-panel, .calc-results-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
}

.calc-panel-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-3);
  color: var(--color-text);
}

.calc-panel-title svg {
  color: var(--color-primary);
}

.calc-panel-title h3 {
  font-size: var(--text-base);
  font-weight: 600;
  margin: 0;
}

.dim-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.input-field {
  position: relative;
  display: flex;
  flex-direction: column;
}

.input-field label {
  font-size: var(--text-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
}

.input-field input {
  padding: 0.65rem 0.75rem;
  padding-right: 3.5rem;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: var(--text-base);
  font-weight: 600;
  outline: none;
  transition: border-color var(--transition-fast);
}

.input-field input:focus {
  border-color: var(--color-primary);
}

.input-field .unit-label {
  position: absolute;
  right: 0.75rem;
  bottom: 0.65rem;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  pointer-events: none;
}

.stone-opt-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.land-btn {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0.6rem 0.8rem;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.land-btn:hover {
  border-color: var(--color-primary-light);
}

.land-btn.active {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.08);
}

.land-btn-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}

.land-btn-desc {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  padding-bottom: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.results-title {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
}

.results-badge {
  font-size: var(--text-xs);
  padding: 0.25rem 0.6rem;
  background: rgba(202, 138, 4, 0.12);
  color: var(--color-primary);
  border-radius: 9999px;
  font-weight: 600;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.kpi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
}

.kpi-card.highlight {
  border-color: var(--color-primary);
  background: rgba(202, 138, 4, 0.05);
}

.kpi-value {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}

.kpi-label {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.kpi-subtext {
  font-size: 0.75rem;
  color: var(--color-text);
  opacity: 0.8;
  margin-top: 0.15rem;
}

.roi-card {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

.roi-title {
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.roi-stats {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin-bottom: var(--space-2);
}

.roi-item {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
}

.roi-val.wood {
  color: #ef4444;
  font-weight: 700;
}

.roi-val.stone {
  color: #10b981;
  font-weight: 700;
}

.roi-explanation {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  margin: 0;
  line-height: 1.35;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xs);
  padding: var(--space-2) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

.breakdown-row:last-child {
  border-bottom: none;
}

.breakdown-val {
  font-weight: 600;
  color: var(--color-text);
}
</style>

<script>
function initLandscapeRockCalculator() {
  const lengthInput = document.getElementById('land-length') as HTMLInputElement | null;
  const widthInput = document.getElementById('land-width') as HTMLInputElement | null;
  const depthInput = document.getElementById('land-depth') as HTMLInputElement | null;
  const wasteInput = document.getElementById('land-waste') as HTMLInputElement | null;

  const landBtns = document.querySelectorAll('.land-btn');

  let activeDensity = 1.35;
  let activeRockName = '1" - 3" River Rock Mulch';

  function calculate() {
    if (!lengthInput || !widthInput || !depthInput || !wasteInput) return;

    const length = Math.max(0.5, parseFloat(lengthInput.value) || 0);
    const width = Math.max(0.5, parseFloat(widthInput.value) || 0);
    const depthInches = Math.max(0.5, parseFloat(depthInput.value) || 0);
    const wastePercent = parseFloat(wasteInput.value) || 0;

    const area = length * width;
    const netCuFt = area * (depthInches / 12);
    const totalCuFt = netCuFt * (1 + wastePercent / 100);
    const totalYards = totalCuFt / 27;

    const totalTons = totalYards * activeDensity;
    const totalLbs = totalTons * 2000;

    // Fabric & staples: 1 staple every 3 feet along seams + perimeter
    const fabricSqFt = Math.ceil(area * 1.10);
    const rolls3x100 = Math.ceil(fabricSqFt / 300);
    const staplesCount = Math.ceil((length * 2 + width * 2) / 3 + (area / 10));

    // 0.5 cu ft bags
    const totalBags = Math.ceil(totalCuFt / 0.5);

    // 5-Year Wood Mulch vs Rock ROI calculation:
    // Organic mulch requires 3" every year (or top up 2" every year) = ~60% volume annually.
    // Average bag of wood mulch = $4.00 (2 cu ft bag).
    const annualMulchBags = Math.ceil((area * (2 / 12)) / 2);
    const annualMulchCost = annualMulchBags * 4.25;
    const fiveYearWoodCost = annualMulchCost * 5;

    // One-time rock mulch delivery (~$70/ton delivered + fabric)
    const oneTimeRockCost = (totalTons * 75) + (rolls3x100 * 45) + 60;

    // Update KPIs
    const kpiTons = document.getElementById('kpi-land-tons');
    const kpiLbs = document.getElementById('kpi-land-lbs');
    const kpiYards = document.getElementById('kpi-land-yards');
    const kpiCuFt = document.getElementById('kpi-land-cuft');
    const kpiFabric = document.getElementById('kpi-land-fabric');
    const kpiRolls = document.getElementById('kpi-land-rolls');
    const kpiStaples = document.getElementById('kpi-land-staples');
    const badge = document.getElementById('land-badge');
    const rowArea = document.getElementById('row-land-area');
    const rowBags = document.getElementById('row-land-bags');

    const roiWood = document.getElementById('roi-wood-cost');
    const roiStone = document.getElementById('roi-stone-cost');
    const roiExplanation = document.getElementById('roi-explanation');

    if (kpiTons) kpiTons.textContent = totalTons.toFixed(2);
    if (kpiLbs) kpiLbs.textContent = `${Math.round(totalLbs).toLocaleString()} lbs bulk weight`;
    if (kpiYards) kpiYards.textContent = totalYards.toFixed(2);
    if (kpiCuFt) kpiCuFt.textContent = `${totalCuFt.toFixed(1)} cu ft volume`;
    if (kpiFabric) kpiFabric.textContent = Math.round(area).toLocaleString();
    if (kpiRolls) kpiRolls.textContent = `${rolls3x100} roll${rolls3x100 === 1 ? '' : 's'} (3' x 100')`;
    if (kpiStaples) kpiStaples.textContent = `${staplesCount} pins`;
    if (badge) badge.textContent = activeRockName;
    if (rowArea) rowArea.textContent = `${Math.round(area).toLocaleString()} sq ft (${length}' × ${width}')`;
    if (rowBags) rowBags.textContent = `${totalBags.toLocaleString()} bags`;

    if (roiWood) roiWood.textContent = `$${Math.round(fiveYearWoodCost).toLocaleString()} ($${Math.round(annualMulchCost)}/yr)`;
    if (roiStone) roiStone.textContent = `$${Math.round(oneTimeRockCost).toLocaleString()} (Permanent)`;
    if (roiExplanation) {
      if (fiveYearWoodCost > oneTimeRockCost) {
        roiExplanation.textContent = `Permanent stone pays for itself in under ${(oneTimeRockCost / annualMulchCost).toFixed(1)} years, saving you $${Math.round(fiveYearWoodCost - oneTimeRockCost).toLocaleString()} over 5 years!`;
      } else {
        roiExplanation.textContent = `Stone mulch provides permanent weed and erosion control without yearly decomposing or blowing away in storms.`;
      }
    }
  }

  landBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      landBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDensity = parseFloat(btn.getAttribute('data-density') || '1.35');
      const titleEl = btn.querySelector('.land-btn-title');
      if (titleEl) activeRockName = titleEl.textContent || 'Landscape Rock';
      calculate();
    });
  });

  [lengthInput, widthInput, depthInput, wasteInput].forEach(input => {
    if (input) {
      input.addEventListener('input', calculate);
    }
  });

  calculate();
}

document.addEventListener('DOMContentLoaded', initLandscapeRockCalculator);
</script>
