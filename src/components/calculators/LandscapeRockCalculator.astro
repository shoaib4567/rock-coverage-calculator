---
// Landscape bed quantity estimator. Density presets are editable assumptions.
---
<section class="section" id="landscape-rock-calc" aria-labelledby="land-calc-title">
  <div class="container">
    <div class="section-header">
      <h2 id="land-calc-title">Estimate landscape rock for your bed</h2>
      <div class="section-divider"></div>
      <p>Enter the rock-covered length, average width, and finished depth. The estimate includes cubic yards, short tons, and 0.5-cubic-foot bags.</p>
    </div>

    <div class="calc-wrapper">
      <div class="calc-panel">
        <h3>Bed measurements</h3>
        <p class="panel-help">For a curved bed, split it into sections or use its average width. Enter only the area you will cover with rock.</p>
        <div class="dim-grid">
          <div class="input-field">
            <label for="land-length">Bed length</label>
            <input type="number" id="land-length" value="40" min="0.1" step="any" required />
            <span class="unit-label">ft</span>
          </div>
          <div class="input-field">
            <label for="land-width">Average bed width</label>
            <input type="number" id="land-width" value="8" min="0.1" step="any" required />
            <span class="unit-label">ft</span>
          </div>
        </div>
        <div class="dim-grid">
          <div class="input-field">
            <label for="land-depth">Finished rock depth</label>
            <input type="number" id="land-depth" value="3" min="0.5" max="8" step="any" required aria-describedby="depth-help" />
            <span class="unit-label">in</span>
          </div>
          <div class="input-field">
            <label for="land-waste">Extra material allowance</label>
            <input type="number" id="land-waste" value="10" min="0" max="25" step="any" required aria-describedby="allowance-help" />
            <span class="unit-label">%</span>
          </div>
        </div>
        <p class="field-note" id="depth-help">Start around 2–3 inches for many rock mulches, then check coverage with your chosen stone.</p>
        <p class="field-note" id="allowance-help">Optional room for uneven ground and trimming. Set to 0% to see the measured volume alone.</p>

        <h3 class="material-heading">Rock type and bulk density</h3>
        <div class="stone-opt-grid" aria-label="Example landscape rock densities">
          <button type="button" class="land-btn active" data-density="1.35" aria-pressed="true">
            <span class="land-btn-title">Rounded river rock</span>
            <span class="land-btn-desc">Example: 1.35 short tons/yd³</span>
          </button>
          <button type="button" class="land-btn" data-density="1.40" aria-pressed="false">
            <span class="land-btn-title">Angular crushed stone</span>
            <span class="land-btn-desc">Example: 1.40 short tons/yd³</span>
          </button>
          <button type="button" class="land-btn" data-density="0.85" aria-pressed="false">
            <span class="land-btn-title">Lava rock</span>
            <span class="land-btn-desc">Example: 0.85 short tons/yd³</span>
          </button>
        </div>
        <div class="density-field">
          <div class="input-field">
            <label for="land-density">Bulk density to use</label>
            <input type="number" id="land-density" value="1.35" min="0.1" max="3" step="any" required aria-describedby="density-help" />
            <span class="unit-label">t/yd³</span>
          </div>
          <p class="field-note" id="density-help">Presets are rough examples. Enter your supplier's figure for a better ton estimate; volume does not change.</p>
        </div>
        <p class="input-error" id="land-error" role="alert" hidden>Enter positive bed dimensions, a depth from 0.5 to 8 inches, allowance from 0 to 25%, and density from 0.1 to 3.</p>
      </div>

      <div class="calc-results-panel">
        <div class="results-header">
          <h3>Material to order</h3>
          <span class="results-badge" id="land-badge">Rounded river rock</span>
        </div>
        <div class="kpi-grid" aria-live="polite">
          <div class="kpi-card highlight">
            <div class="kpi-value" id="kpi-land-yards">3.26</div>
            <div class="kpi-label">Cubic yards</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-land-tons">4.40</div>
            <div class="kpi-label">Estimated short tons</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-land-bags">176</div>
            <div class="kpi-label">0.5-cu-ft bags</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-value" id="kpi-land-area">320</div>
            <div class="kpi-label">Square feet covered</div>
          </div>
        </div>
        <div class="breakdown-list" aria-label="Quantity breakdown">
          <div class="breakdown-row"><span>Measured volume</span><strong id="row-land-net">2.96 yd³</strong></div>
          <div class="breakdown-row"><span>Extra material</span><strong id="row-land-extra">0.30 yd³ (10%)</strong></div>
          <div class="breakdown-row"><span>Total loose rock volume</span><strong id="row-land-cuft">88.0 cu ft</strong></div>
          <div class="breakdown-row"><span>Bulk density used</span><strong id="row-land-density">1.35 short tons/yd³</strong></div>
        </div>
        <p class="result-note">These are planning quantities. Suppliers may sell by whole or partial yards, by scale weight, or in bags with a different volume. Check the product listing and round to the supplier's selling increment.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-wrapper { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); margin-top: var(--space-6); }
  .calc-panel, .calc-results-panel { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-6); }
  .calc-panel h3, .calc-results-panel h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); color: var(--color-text); }
  .panel-help, .field-note, .result-note { color: var(--color-text-muted); line-height: 1.5; font-size: var(--text-sm); }
  .panel-help { margin: 0 0 var(--space-4); }
  .field-note { margin: var(--space-1) 0 var(--space-2); font-size: var(--text-xs); }
  .dim-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-3); }
  .input-field { position: relative; display: flex; flex-direction: column; }
  .input-field label { font-size: var(--text-xs); font-weight: 600; color: var(--color-text-muted); margin-bottom: var(--space-1); }
  .input-field input { width: 100%; padding: .65rem 4.5rem .65rem .75rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-size: var(--text-base); font-weight: 600; }
  .input-field input:focus-visible, .land-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .unit-label { position: absolute; right: .8rem; bottom: .65rem; font-size: var(--text-xs); color: var(--color-text-muted); pointer-events: none; }
  .material-heading { margin-top: var(--space-5) !important; }
  .stone-opt-grid { display: grid; gap: var(--space-2); }
  .land-btn { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: .65rem .8rem; text-align: left; cursor: pointer; }
  .land-btn:hover, .land-btn.active { border-color: var(--color-primary); }
  .land-btn.active { background: rgba(202, 138, 4, .08); }
  .land-btn-title, .land-btn-desc { display: block; }
  .land-btn-title { font-size: var(--text-sm); font-weight: 700; color: var(--color-text); }
  .land-btn-desc { font-size: var(--text-xs); color: var(--color-text-muted); }
  .density-field { margin-top: var(--space-4); }
  .input-error { color: #dc2626; font-size: var(--text-sm); font-weight: 600; }
  .results-header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
  .results-header h3 { margin: 0; }
  .results-badge { font-size: var(--text-xs); padding: .25rem .6rem; background: rgba(202, 138, 4, .12); color: var(--color-primary); border-radius: 999px; font-weight: 700; }
  .kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-5); }
  .kpi-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); }
  .kpi-card.highlight { border-color: var(--color-primary); background: rgba(202, 138, 4, .05); }
  .kpi-value { font-size: var(--text-2xl); font-weight: 800; color: var(--color-primary); line-height: 1.1; }
  .kpi-label { font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-1); }
  .breakdown-list { display: grid; gap: var(--space-2); }
  .breakdown-row { display: flex; justify-content: space-between; gap: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted); }
  .breakdown-row strong { color: var(--color-text); text-align: right; }
  .result-note { border-left: 3px solid var(--color-primary); padding-left: var(--space-3); margin: var(--space-5) 0 0; }
  @media (max-width: 900px) { .calc-wrapper { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .dim-grid { grid-template-columns: 1fr; } }
</style>

<script>
  function initLandscapeRockCalculator() {
    const lengthInput = document.getElementById('land-length') as HTMLInputElement | null;
    const widthInput = document.getElementById('land-width') as HTMLInputElement | null;
    const depthInput = document.getElementById('land-depth') as HTMLInputElement | null;
    const allowanceInput = document.getElementById('land-waste') as HTMLInputElement | null;
    const densityInput = document.getElementById('land-density') as HTMLInputElement | null;
    const error = document.getElementById('land-error');
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.land-btn'));
    if (!lengthInput || !widthInput || !depthInput || !allowanceInput || !densityInput) return;

    function setText(id: string, value: string) {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    }

    function calculate() {
      const inputs = [lengthInput!, widthInput!, depthInput!, allowanceInput!, densityInput!];
      const valid = inputs.every(input => input.validity.valid && Number.isFinite(input.valueAsNumber));
      if (error) error.hidden = valid;
      if (!valid) return;

      const length = lengthInput!.valueAsNumber;
      const width = widthInput!.valueAsNumber;
      const depth = depthInput!.valueAsNumber;
      const allowance = allowanceInput!.valueAsNumber;
      const density = densityInput!.valueAsNumber;
      const area = length * width;
      const netCuFt = area * depth / 12;
      const totalCuFt = netCuFt * (1 + allowance / 100);
      const netYards = netCuFt / 27;
      const totalYards = totalCuFt / 27;
      const extraYards = totalYards - netYards;
      const tons = totalYards * density;
      const bags = Math.ceil(totalCuFt / 0.5 - 1e-9);

      setText('kpi-land-yards', totalYards.toFixed(2));
      setText('kpi-land-tons', tons.toFixed(2));
      setText('kpi-land-bags', bags.toLocaleString());
      setText('kpi-land-area', area.toLocaleString(undefined, { maximumFractionDigits: 1 }));
      setText('row-land-net', netYards.toFixed(2) + ' yd³');
      setText('row-land-extra', extraYards.toFixed(2) + ' yd³ (' + allowance + '%)');
      setText('row-land-cuft', totalCuFt.toFixed(1) + ' cu ft');
      setText('row-land-density', density.toFixed(2) + ' short tons/yd³');
    }

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        buttons.forEach(option => {
          option.classList.remove('active');
          option.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');
        densityInput!.value = button.dataset.density || '1.35';
        setText('land-badge', button.querySelector('.land-btn-title')?.textContent || 'Landscape rock');
        calculate();
      });
    });

    densityInput.addEventListener('input', () => {
      buttons.forEach(option => {
        option.classList.remove('active');
        option.setAttribute('aria-pressed', 'false');
      });
      setText('land-badge', 'Custom density');
      calculate();
    });

    [lengthInput, widthInput, depthInput, allowanceInput].forEach(input => input.addEventListener('input', calculate));
    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLandscapeRockCalculator);
  } else {
    initLandscapeRockCalculator();
  }
</script>
