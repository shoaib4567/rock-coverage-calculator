<style>
  .cobble-calculator .calc-panel-title { margin: var(--space-5) 0 var(--space-3); }
  .cobble-calculator .calc-panel-title:first-child { margin-top: 0; }
  .cobble-options { display: flex; flex-wrap: wrap; gap: .65rem; margin: 0 0 1.1rem; }
  .cobble-options .choice { flex: 1 1 12rem; display: flex; flex-direction: column; gap: .2rem; text-align: left; padding: .8rem 1rem; color: var(--text-primary); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); cursor: pointer; }
  .cobble-options .choice.active, .cobble-options .choice:focus-visible { border-color: var(--accent-gold); background: rgba(212, 168, 83, .1); outline-offset: 2px; }
  .cobble-options small { color: var(--text-muted); }
  .cobble-calculator [hidden] { display: none !important; }
  .field-note { color: var(--text-muted); font-size: .88rem; line-height: 1.55; margin: .55rem 0 1.1rem; }
  .cobble-kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; }
  .cobble-kpi { min-width: 0; display: flex; flex-direction: column; padding: 1rem; border-radius: var(--radius-md); background: var(--bg-surface); border: 1px solid var(--border-subtle); }
  .cobble-kpi.main-kpi { border-color: var(--accent-gold); }
  .cobble-kpi span { font-size: .82rem; color: var(--text-secondary); }
  .cobble-kpi strong { font-size: clamp(1.45rem, 3vw, 2rem); color: var(--text-primary); overflow-wrap: anywhere; }
  .cobble-kpi small { color: var(--text-muted); }
  .result-details { margin: 1rem 0; }
  .result-details div { display: flex; justify-content: space-between; gap: 1rem; padding: .65rem 0; border-bottom: 1px solid var(--border-subtle); }
  .result-details dt { color: var(--text-secondary); }
  .result-details dd { margin: 0; color: var(--text-primary); text-align: right; font-weight: 600; overflow-wrap: anywhere; }
  .calc-error { padding: .75rem; border: 1px solid #b84c4c; border-radius: var(--radius-md); color: #ffd1d1; }
  @media (max-width: 650px) { .cobble-kpis { grid-template-columns: 1fr; } .result-details div { display: block; } .result-details dd { text-align: left; } }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('cobble-calc');
    if (!root) return;
    var get = function (id) { return document.getElementById(id); };
    var mode = 'paving';
    var sizes = { regular: [9, 5], cube: [4, 4], jumbo: [10, 7] };
    var modeButtons = root.querySelectorAll('[data-cobble-mode]');
    var stoneButtons = root.querySelectorAll('[data-cobble-stone]');
    var ids = ['cobble-length', 'cobble-width', 'cobble-run', 'cobble-face-length', 'cobble-face-width', 'cobble-joint', 'cobble-extra', 'cobble-piece-weight', 'cobble-pallet-size', 'cobble-direction'];
    var formatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 });
    var whole = new Intl.NumberFormat('en-US');
    function val(id) { return Number(get(id).value); }
    function valid(id, optional) {
      var el = get(id);
      var empty = el.value.trim() === '';
      if (optional && empty) { el.removeAttribute('aria-invalid'); return true; }
      var ok = !empty && el.validity.valid && Number.isFinite(Number(el.value));
      el.setAttribute('aria-invalid', String(!ok));
      return ok;
    }
    function output(id, value) { get(id).textContent = value; }
    function clear() {
      ['cobble-order', 'cobble-layout', 'cobble-rate', 'cobble-measure', 'cobble-module'].forEach(function (id) { output(id, '—'); });
      output('cobble-weight', '—');
      output('cobble-pallets', '—');
      output('cobble-pallet-weight', '—');
    }
    function calculate() {
      var active = mode === 'paving' ? ['cobble-length', 'cobble-width'] : ['cobble-run'];
      var required = active.concat(['cobble-face-length', 'cobble-face-width', 'cobble-joint', 'cobble-extra']);
      var geometryOk = required.map(function (id) { return valid(id, false); }).every(Boolean);
      var optionalWeightOk = valid('cobble-piece-weight', true);
      var optionalPalletOk = valid('cobble-pallet-size', true);
      var error = get('cobble-error');
      if (!geometryOk) {
        error.textContent = 'Enter valid positive dimensions, a joint from 0 to 3 inches, and an extra allowance from 0% to 50%.';
        error.hidden = false;
        clear();
        return;
      }
      var faceLength = val('cobble-face-length');
      var faceWidth = val('cobble-face-width');
      var joint = val('cobble-joint');
      var extra = val('cobble-extra') / 100;
      var raw;
      if (mode === 'paving') {
        var area = val('cobble-length') * val('cobble-width');
        raw = area * 144 / ((faceLength + joint) * (faceWidth + joint));
        output('cobble-rate', formatter.format(144 / ((faceLength + joint) * (faceWidth + joint))));
        output('cobble-rate-unit', 'pieces per sq ft');
        output('cobble-measure', formatter.format(area) + ' sq ft');
      } else {
        var run = val('cobble-run');
        var along = get('cobble-direction').value === 'width' ? faceWidth : faceLength;
        raw = (run * 12 + joint) / (along + joint);
        output('cobble-rate', formatter.format(12 / (along + joint)));
        output('cobble-rate-unit', 'pieces per linear ft');
        output('cobble-measure', formatter.format(run) + ' linear ft, one run');
      }
      var layout = Math.ceil(raw);
      var order = Math.ceil(raw * (1 + extra));
      output('cobble-layout', whole.format(layout));
      output('cobble-order', whole.format(order));
      output('cobble-module', formatter.format(faceLength) + ' × ' + formatter.format(faceWidth) + ' in face; ' + formatter.format(joint) + ' in joint');
      var pieceWeight = get('cobble-piece-weight').value.trim();
      var palletSize = get('cobble-pallet-size').value.trim();
      output('cobble-weight', !pieceWeight ? 'Enter piece weight' : optionalWeightOk ? whole.format(Math.round(order * val('cobble-piece-weight'))) + ' lb / ' + formatter.format(order * val('cobble-piece-weight') / 2000) + ' US short tons' : 'Check piece weight');
      var fullPallets = palletSize && optionalPalletOk ? Math.ceil(order / val('cobble-pallet-size')) : 0;
      var fullPalletPieces = fullPallets ? fullPallets * val('cobble-pallet-size') : 0;
      output('cobble-pallets', !palletSize ? 'Enter pieces per pallet' : optionalPalletOk ? whole.format(fullPallets) + ' whole pallets (' + whole.format(fullPalletPieces) + ' pieces)' : 'Check pallet quantity');
      var palletStoneWeight = fullPalletPieces * val('cobble-piece-weight');
      output('cobble-pallet-weight', !pieceWeight || !palletSize ? 'Enter weight and pallet capacity' : optionalWeightOk && optionalPalletOk ? whole.format(Math.round(palletStoneWeight)) + ' lb / ' + formatter.format(palletStoneWeight / 2000) + ' US short tons' : 'Check supplier inputs');
      error.textContent = !optionalWeightOk || !optionalPalletOk ? 'Stone count is ready. Correct the optional supplier field to see its estimate.' : '';
      error.hidden = optionalWeightOk && optionalPalletOk;
    }
    modeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        mode = button.dataset.cobbleMode;
        modeButtons.forEach(function (item) {
          var selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        get('cobble-paving-fields').hidden = mode !== 'paving';
        get('cobble-edging-fields').hidden = mode !== 'edging';
        calculate();
      });
    });
    stoneButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var size = sizes[button.dataset.cobbleStone];
        get('cobble-face-length').value = size[0];
        get('cobble-face-width').value = size[1];
        stoneButtons.forEach(function (item) {
          var selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        calculate();
      });
    });
    ids.forEach(function (id) {
      get(id).addEventListener('input', calculate);
      get(id).addEventListener('change', calculate);
    });
    calculate();
  });
</script>
