---
import TopicClusterNav from '../components/TopicClusterNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gravel Trade Names by State', url: '/gravel-trade-names-by-state' }
];

const title = "Gravel & Aggregate Trade Names by State - Regional Cross-Reference Guide";
const metaDescription = "Complete state-by-state directory of gravel, base aggregate, and crushed stone trade names. Translate 21-A, CA-6, #304, #53, Item 4, QP, and ABC to civil ASTM/AASHTO specs.";

const tradeData = [
  {
    "state": "Virginia",
    "terms": "21-A / 21A; 21-B / 21B; aggregate base",
    "check": "Confirm the specified type, size designation and current grading. The similar names do not make 21A and 21B identical.",
    "url": "https://www.vdot.virginia.gov/doing-business/technical-guidance-and-support/technical-guidance-documents/road-and-bridge-specifications/",
    "calcSlug": "/crusher-run-calculator"
  },
  {
    "state": "Pennsylvania",
    "terms": "2A; 2RC; open-graded subbase (OGS); DSA",
    "check": "Identify the actual PennDOT or supplier product. These are different product classes, not interchangeable names for one blend.",
    "url": "https://www.pa.gov/agencies/penndot/programs-and-doing-business/construction/aggregate-plant-book",
    "calcSlug": "/gravel-calculator"
  },
  {
    "state": "Illinois",
    "terms": "CA-6 / CA 6; CA-10 / CA 10; coarse aggregate",
    "check": "Read the complete IDOT designation and approved source information rather than substituting one CA number for another.",
    "url": "https://idot.illinois.gov/doing-business/materials-marketplace/aggregate.html",
    "calcSlug": "/gravel-calculator"
  },
  {
    "state": "Ohio",
    "terms": "Item 304; #304 aggregate base; Item 411",
    "check": "Check the item and grading in the contract or supplier quote. A base item is not a universal finished driveway section.",
    "url": "https://www.transportation.ohio.gov/business/publications/pdm",
    "calcSlug": "/crusher-run-calculator"
  },
  {
    "state": "Minnesota",
    "terms": "Class 5; Class 5Q; base and surface aggregate",
    "check": "Confirm the exact class and specification edition, including crushing and grading requirements.",
    "url": "https://www.dot.state.mn.us/materials/gbforms.html",
    "calcSlug": "/gravel-calculator"
  },
  {
    "state": "New York",
    "terms": "Item 4; subbase course; granular subbase",
    "check": "A local Item 4 name needs the actual subbase specification and source; do not equate every bank-run product with a processed base.",
    "url": "https://www.dot.ny.gov/portal/pls/portal/MEXIS_APP.EI_EB_DOC_DETAILS.show?p_arg_names=doc_id&p_arg_values=10291",
    "calcSlug": "/gravel-calculator"
  },
  {
    "state": "New Jersey",
    "terms": "DGA; dense-graded aggregate; quarry process (QP)",
    "check": "Ask for the specified DGA or actual QP grading. A trade phrase alone does not establish compliance with an agency specification.",
    "url": "https://nj.gov/transportation/eng/documents/BDC/pdf/attachmentbdc07s03.pdf",
    "calcSlug": "/crusher-run-calculator"
  }
];
---

<BaseLayout title={title} metaDescription={metaDescription} canonicalPath="/gravel-trade-names-by-state">
  <Header />

  <main id="main-content">
    <PageHero
      title="Regional Gravel & Aggregate Trade Names by State"
      subtitle="The same structural aggregate goes by dozens of local names: 21-A, CA-6, #304, #53, Item 4, QP, ABC, and Flexbase. Find your state's exact DOT specification."
      badge="Civil Engineering Specification Hub"
      breadcrumbs={breadcrumbs}
      theme="civil"
    />

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <!-- Interactive Search & Filter Bar -->
        <div class="trade-search-card">
          <div class="trade-search-inner">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input 
              type="text" 
              id="trade-search-input" 
              placeholder="Search these regional examples by state or name, such as Virginia, CA-6, Item 4 or Class 5"
              aria-label="Filter aggregate trade names by state or code"
            />
            <button type="button" id="btn-clear-trade-search" class="btn-clear-search" style="display: none;" aria-label="Clear search input">&times;</button>
          </div>
          <div class="search-stats-row">
            <span id="search-count-label">Showing {tradeData.length} regional examples</span>
            <div class="quick-tags">{['21-A','CA-6','304','Class 5','2A','Item 4','DGA'].map(term=><button type="button" class="btn-tag" data-tag={term}>{term}</button>)}</div>
          </div>
        </div>

        <!-- Master Directory Table -->
        <div class="trade-table-card">
          <div class="table-responsive">
            <table class="trade-table" id="trade-table"><caption>Selected regional name examples and source checks; this is not a directory of every state or an equivalence table.</caption>
<thead><tr><th scope="col">State</th><th scope="col">Names you may encounter</th><th scope="col">Check before ordering</th><th scope="col">Reference and quantity tool</th></tr></thead>
<tbody id="trade-table-body">{tradeData.map(item=><tr class="trade-row" data-search={(item.state+' '+item.terms+' '+item.check).toLowerCase()}>
<th scope="row">{item.state}</th><td class="quarry-name-cell">{item.terms}</td><td>{item.check}</td>
<td><a href={item.url}>Read the agency reference</a><br/><a href={item.calcSlug}>Estimate the selected material</a></td>
</tr>)}</tbody></table>
          </div>
        </div>

<article class="editorial-box" style="margin-top: var(--space-10);">
<h2>A familiar trade name is a starting question</h2>
<p>Names such as crusher run, quarry process and road base often refer to locally sold aggregate blends. Agency designations identify requirements in a particular specification. Similar applications do not establish that two named products have the same grading, recycled content, fines, durability or placement requirements.</p>
<p>The table lists selected examples supported by the linked agency material and specification references. Some references document historical terminology. Use the governing edition, supplements and project detail for an actual job; this page does not certify a source or replace a supplier’s product sheet.</p>
<h2>Keep four product attributes separate</h2>
<ol><li><strong>Designation and grading:</strong> ask for the actual product and complete size distribution, including fines.</li><li><strong>Layer purpose:</strong> base, surface, fill and drain materials have different requirements.</li><li><strong>Loose bulk weight:</strong> obtain a product-specific pounds-per-yard or short-tons-per-yard conversion.</li><li><strong>Placement allowance:</strong> define whether the figure is extra loose material or a reduction from loose to finished volume.</li></ol>
<p>No state name establishes one loose density or a fixed compaction percentage. A 20% loose-order increase multiplies by 1.20; a stated 20% loss from loose volume would require division by 0.80. Apply the supplier or project’s actual definition.</p>
<h2>Take the product details to the calculator</h2>
<p>Once the grading and layer are selected, use the <a href="/gravel-calculator">gravel calculator</a> with the actual loose weight, or the <a href="/crusher-run-calculator">base-layer calculator</a> with a clearly defined loose-order increase. Estimate separate driveway courses with the <a href="/driveway-rock-calculator">driveway calculator</a>. The <a href="/gravel-sizes">size guide</a> explains why numbered grading, washing and mineral type are separate attributes.</p>
</article>
      </div>
    </section>
  <TopicClusterNav />
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
(function() {
  const searchInput = document.getElementById('trade-search-input');
  const clearBtn = document.getElementById('btn-clear-trade-search');
  const countLabel = document.getElementById('search-count-label');
  const rows = document.querySelectorAll('.trade-row');
  const tagButtons = document.querySelectorAll('.btn-tag');

  function filterTable(query) {
    const q = query.trim().toLowerCase();
    let visibleCount = 0;

    rows.forEach(row => {
      const text = row.dataset.search || '';
      const match = q === '' || text.includes(q);
      row.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    if (clearBtn) {
      clearBtn.style.display = q ? 'inline-block' : 'none';
    }

    if (countLabel) {
      countLabel.textContent = `Showing ${visibleCount} of ${rows.length} regional name examples`;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      filterTable(e.target.value);
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      filterTable('');
      searchInput?.focus();
    });
  }

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag || '';
      if (searchInput) {
        searchInput.value = tag;
        filterTable(tag);
      }
    });
  });
})();
</script>

<style>
  .trade-search-card {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: var(--shadow-lg);
  }

  .trade-search-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--slate-950);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--duration-fast);
  }

  .trade-search-inner:focus-within {
    border-color: var(--gold-400);
    box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.15);
  }

  .search-icon {
    color: var(--gold-400);
    flex-shrink: 0;
  }

  .trade-search-inner input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.95rem;
    width: 100%;
  }

  .trade-search-inner input::placeholder {
    color: var(--text-muted);
  }

  .btn-clear-search {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 var(--space-2);
  }

  .btn-clear-search:hover {
    color: var(--text-primary);
  }

  .search-stats-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  #search-count-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .quick-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .btn-tag {
    background: var(--slate-850);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .btn-tag:hover {
    border-color: var(--gold-400);
    color: var(--gold-400);
    background: var(--slate-800);
  }

  /* Table styling */
  .trade-table-card {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .trade-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .trade-table th {
    background: var(--slate-850);
    padding: var(--space-4);
    color: var(--text-primary);
    font-weight: 600;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .trade-table td {
    padding: var(--space-4);
    border-bottom: 1px solid rgba(107, 122, 141, 0.15);
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .trade-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .dot-badge {
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.25);
    color: #60a5fa;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.775rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .quarry-name-cell {
    font-weight: 600;
    color: var(--text-primary);
  }

  .density-cell {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--gold-300);
    white-space: nowrap;
  }

  .compaction-badge {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Editorial Box */
  .editorial-box {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .editorial-box h2 {
    font-size: 1.35rem;
    color: var(--text-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .editorial-box p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .specs-callout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .specs-callout-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .callout-card {
    background: var(--slate-850);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .callout-card h3 {
    font-size: 1rem;
    color: var(--gold-400);
    margin: 0 0 var(--space-2) 0;
  }

  .callout-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
