---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { groups } from '../lib/site-navigation';
---
<BaseLayout title="Rock Calculators and Project Guides" canonicalPath="/calculators">
  <Header />
  <main id="main-content" class="container tool-library">
    <Breadcrumbs compact />
    <header class="library-heading">
      <h1>Rock calculators and project guides</h1>
      <p>Choose a material, the unit your supplier sells, or the project you are planning. Start with the <a href="/">main rock coverage calculator</a> for six area shapes, or use the <a href="/which-rock-should-i-use">material selection helper</a> to compare candidates.</p>
      <p>Calculate separate layers separately. Volume comes from area and depth; tons also need a product-specific weight, and bags need the package’s labeled yield. Read <a href="/about">how the estimates work</a> before turning a planning quantity into an order.</p>
    </header>
    <nav class="topic-jump" aria-label="Browse calculator topics"><ul>{groups.map(group => <li><a href={'#topic-' + group.id}>{group.title}</a></li>)}</ul></nav>
    {groups.map(group => <section class="library-topic" id={'topic-' + group.id} aria-labelledby={'heading-' + group.id}>
      <h2 id={'heading-' + group.id}>{group.title}</h2>
      <p class="topic-intro">{group.intro}</p>
      <ul class="tool-cards">{group.tools.map(tool => <li>
        <h3><a href={tool.slug}>{tool.title}</a></h3>
        <p>{tool.desc}</p>
      </li>)}</ul>
    </section>)}
  </main>
  <Footer />
</BaseLayout>
<style>
  .tool-library { padding-bottom: var(--space-12); max-width: 1200px; }
  .library-heading { max-width: 850px; margin-block: var(--space-6) var(--space-8); }
  h1 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin-bottom: var(--space-5); }
  p { line-height: 1.7; color: var(--text-secondary); }
  .library-heading p + p { margin-top: var(--space-4); }
  a { color: var(--text-primary); text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 4px; }
  .topic-jump { padding: var(--space-5); background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .topic-jump ul { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  .library-topic { margin-top: var(--space-12); scroll-margin-top: 6rem; }
  h2 { font-size: var(--text-2xl); margin-bottom: var(--space-3); }
  .topic-intro { max-width: 800px; margin-bottom: var(--space-5); }
  .tool-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-4); }
  .tool-cards li { min-width: 0; padding: var(--space-5); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--bg-card); }
  h3 { font-size: var(--text-lg); line-height: 1.35; margin: 0 0 var(--space-3); }
  h3 a { overflow-wrap: anywhere; }
  .tool-cards p { font-size: var(--text-sm); margin: 0; }
</style>
