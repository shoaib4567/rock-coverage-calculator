---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Decomposed Granite Coverage Calculator';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Decomposed Granite Calculator', url: '/decomposed-granite-calculator' },
  { name: pageTitle, url: '/decomposed-granite-coverage-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Decomposed granite with fines' },
  { label: 'Measure', value: 'Finished square feet' },
  { label: 'Order Unit', value: 'Loose cubic yard or U.S. short ton' },
  { label: 'Default Allowance', value: '20% extra material (editable)' }
];

const quickStats = [
  { value: '72 sq ft', label: 'Per short ton at 3 in', desc: 'With 20% extra material and 1.25 short tons per loose cubic yard' },
  { value: '90 sq ft', label: 'Per loose yard at 3 in', desc: 'Finished surface area at the same depth and allowance' },
  { value: '3 in', label: 'Example finish depth', desc: 'Measure the DG layer after compaction; size the base separately' }
];

const faqItems = [
  {
    q: 'How many square feet does a ton of decomposed granite cover?',
    a: 'With a 20% extra-material allowance and a planning density of 1.25 U.S. short tons per loose cubic yard, one short ton covers about 108 square feet at 2 inches finished depth, 72 square feet at 3 inches, or 54 square feet at 4 inches. A different supplier density or ordering allowance changes the yield.'
  },
  {
    q: 'How much area does one cubic yard of decomposed granite cover?',
    a: 'Under the same 20% allowance, one loose cubic yard covers about 135 square feet at 2 inches finished depth, 90 square feet at 3 inches, or 67.5 square feet at 4 inches. These are planning yields for a finished layer, not guaranteed field coverage.'
  },
  {
    q: 'How many tons do I need for a 300-square-foot DG patio?',
    a: 'At 3 inches finished depth, 300 square feet is 2.78 cubic yards of finished layer. With 20% extra material, order about 3.33 loose cubic yards. At 1.25 short tons per loose cubic yard, that is about 4.17 short tons. Confirm the product density and order increment with the yard.'
  },
  {
    q: 'Is a 20% allowance the same as 20% volume loss during compaction?',
    a: 'No. This calculator adds 20% to the finished geometric volume for an estimated loose order. If a product actually loses 20% of its loose volume during compaction, you divide finished volume by 0.80, which requires 25% extra. Use the supplier or project specification when it gives a measured reduction.'
  },
  {
    q: 'Should the road base be included in DG coverage?',
    a: 'No. Enter only the finished decomposed granite surface thickness here. Calculate any crushed-stone base as a separate layer with its own area, depth, and density.'
  }
];

const upLinks = [
  { title: 'Decomposed Granite Calculator', slug: '/decomposed-granite-calculator', badge: 'Material' },
  { title: 'Rock Square Foot Calculator', slug: '/rock-square-foot-calculator', badge: 'Area' },
  { title: 'Rock Coverage Chart', slug: '/rock-coverage-chart', badge: 'Reference' }
];

const lateralLinks = [
  { title: 'Decomposed Granite Tons Calculator', slug: '/decomposed-granite-tons-calculator', badge: 'Tons' },
  { title: 'Pea Gravel Coverage Calculator', slug: '/pea-gravel-coverage-calculator', badge: 'Pea Gravel' },
  { title: 'Crushed Granite Calculator', slug: '/crushed-granite-calculator', badge: 'Granite' }
];

const bridgeLinks = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Installation' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Material' }
];

const supportGuides = [
  { title: 'Decomposed Granite Calculator', slug: '/decomposed-granite-calculator', badge: 'Yards' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'Density' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' }
];
---

<BaseLayout
  title={pageTitle}
  metaDescription="Find how many square feet decomposed granite covers per loose cubic yard or short ton. Adjust finished depth, ordering allowance, and supplier density."
  canonicalPath="/decomposed-granite-coverage-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/decomposed-granite-coverage-calculator',
      description: 'Estimates finished decomposed granite square-foot coverage from loose cubic yards or U.S. short tons, depth, order allowance, and loose bulk density.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Coverage"
      badge="Square feet from yards or tons"
      subtitle="At 3 inches finished depth, one loose cubic yard of DG covers about 90 square feet; one U.S. short ton covers about 72. These planning yields use 20% extra material and 1.25 short tons per loose cubic yard, both adjustable below."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="utility"
    />

    <section class="tool-intro" aria-label="How to use this coverage calculator">
      <div class="container">
        <p>Enter how much decomposed granite you have or plan to buy, then set the <strong>finished, compacted DG thickness</strong>. The result shows the surface it can cover and compares that amount with your project area. Keep any road base out of the DG depth.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="coverage-tool-heading">
      <div class="container">
        <h2 id="coverage-tool-heading" class="sr-only">Calculate decomposed granite coverage</h2>
        <div class="calc-wrapper">
          <div class="calc-panel">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
              <h3>Material and finished layer</h3>
            </div>
            <div class="dim-grid">
              <div class="input-field">
                <label for="dgc-quantity">Material amount</label>
                <input type="number" id="dgc-quantity" value="1" min="0.01" step="any" required inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="dgc-unit">Amount unit</label>
                <select id="dgc-unit">
                  <option value="tons">Short tons</option>
                  <option value="yards">Loose yd³</option>
                </select>
                <small>One U.S. short ton is 2,000 lb.</small>
              </div>
              <div class="input-field">
                <label for="dgc-depth">Finished DG depth (inches)</label>
                <input type="number" id="dgc-depth" value="3" min="0.5" max="12" step="any" required inputmode="decimal" aria-describedby="dgc-depth-hint" />
                <small id="dgc-depth-hint">Measure after compaction; exclude the base layer.</small>
              </div>
              <div class="input-field">
                <label for="dgc-extra">Extra material over finished volume (%)</label>
                <input type="number" id="dgc-extra" value="20" min="0" max="50" step="any" required inputmode="decimal" aria-describedby="dgc-extra-hint" />
                <small id="dgc-extra-hint">Planning allowance; adjust to the product and site.</small>
              </div>
              <div class="input-field">
                <label for="dgc-density">Loose density (short tons/yd³)</label>
                <input type="number" id="dgc-density" value="1.25" min="0.3" max="3" step="any" required inputmode="decimal" aria-describedby="dgc-density-hint" />
                <small id="dgc-density-hint">Ask your supplier for its loose yard to ton conversion.</small>
              </div>
              <div class="input-field">
                <label for="dgc-area">Your project area (sq ft)</label>
                <input type="number" id="dgc-area" value="300" min="1" step="any" required inputmode="decimal" />
              </div>
            </div>
            <p id="dgc-input-error" class="calc-error" role="alert" hidden>Enter a positive amount and area, a depth from 0.5 to 12 inches, an allowance from 0 to 50%, and a loose density from 0.3 to 3 short tons per cubic yard.</p>
          </div>

          <div class="calc-results-panel">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h3>Finished square-foot coverage</h3>
            </div>
            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <div class="kpi-value" id="kpi-dgc-cover" aria-live="polite" aria-atomic="true">72</div>
                <div class="kpi-label">Square feet your amount covers</div>
                <div class="kpi-subtext" id="kpi-dgc-amount">From 1 short ton at 3 in finished depth</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="kpi-dgc-ton-yield">72</div>
                <div class="kpi-label">Sq ft per short ton</div>
                <div class="kpi-subtext">Uses the loose density entered</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="kpi-dgc-yard-yield">90</div>
                <div class="kpi-label">Sq ft per loose cubic yard</div>
                <div class="kpi-subtext">Independent of the ton conversion</div>
              </div>
            </div>
            <div class="project-check">
              <span class="eyebrow">Check against your project</span>
              <p id="dgc-project-result">For 300 sq ft, plan for 3.33 loose yd³ or 4.17 short tons with these settings.</p>
              <p class="small-note">The project total includes the entered extra-material allowance. Confirm delivery units and rounding with your supplier.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <article class="content-guide-section">
      <div class="container">
        <section class="content-card reference-card" aria-labelledby="coverage-chart-heading">
          <div>
            <span class="eyebrow">Planning reference</span>
            <h2 id="coverage-chart-heading">DG coverage by finished depth</h2>
            <p>These yields assume <strong>20% extra loose material</strong> beyond the finished layer volume. The per-ton column also assumes <strong>1.25 U.S. short tons per loose cubic yard</strong>. Change either input in the calculator for your material.</p>
          </div>
          <p class="table-hint">Scroll sideways to see how each depth is used.</p>
          <div class="table-scroll">
            <table>
              <caption>Finished surface area from one loose cubic yard or one U.S. short ton of decomposed granite, using the stated planning assumptions.</caption>
              <thead>
                <tr>
                  <th scope="col">Finished DG depth</th>
                  <th scope="col">Sq ft per loose yd³</th>
                  <th scope="col">Sq ft per short ton</th>
                  <th scope="col">How to use this row</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">2 in</th>
                  <td>135</td>
                  <td>108</td>
                  <td>Use only where the chosen product and application allow a thin layer.</td>
                </tr>
                <tr class="featured-row">
                  <th scope="row">3 in</th>
                  <td>90</td>
                  <td>72</td>
                  <td>Pedestrian pathway example for some standard or stabilized mixes.</td>
                </tr>
                <tr>
                  <th scope="row">4 in</th>
                  <td>67.5</td>
                  <td>54</td>
                  <td>Vehicular surface example only with a properly designed base.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="small-note">Depth is product specific. For example, <a href="https://www.kafkagranite.com/blog/how-much-aggregate-you-should-order-for-your-pathway/" rel="noopener noreferrer">Kafka Granite distinguishes its 2-inch wax polymer path from its 3-inch standard or stabilized pedestrian path and 4-inch vehicular surface</a>. Follow the specification for the mix you buy.</p>
        </section>

        <section class="content-card diagram-card" aria-labelledby="measure-depth-heading">
          <div class="diagram-copy">
            <span class="eyebrow">Measure the right layer</span>
            <h2 id="measure-depth-heading">Finished DG thickness is the depth to enter</h2>
            <p>Measure from the top of the compacted base to the final DG walking surface. The base may also need compaction, but it has a different material and volume; adding its thickness here would overstate the DG order.</p>
            <p>On uneven ground, measure at several spots and use a depth that reflects the actual cross section. A low area that needs extra DG should be measured rather than hidden inside a generic allowance.</p>
          </div>
          <figure class="layer-figure">
            <svg viewBox="0 0 600 290" role="img" aria-labelledby="layer-title layer-desc">
              <title id="layer-title">Finished decomposed granite layer above a separate base layer</title>
              <desc id="layer-desc">A three-layer cross section labels the decomposed granite finish, crushed-stone base, and subgrade. An arrow measures only the finished DG layer.</desc>
              <rect x="112" y="52" width="440" height="65" rx="4" fill="#b99362" />
              <rect x="112" y="117" width="440" height="72" fill="#6d7882" />
              <rect x="112" y="189" width="440" height="54" fill="#5c5047" />
              <path d="M112 52H552 M112 117H552 M112 189H552" stroke="#e7d6b9" stroke-width="2" />
              <g fill="#e7d6b9" opacity=".7"><circle cx="160" cy="75" r="3"/><circle cx="215" cy="94" r="2"/><circle cx="280" cy="67" r="3"/><circle cx="349" cy="87" r="2"/><circle cx="405" cy="71" r="3"/><circle cx="495" cy="95" r="2"/></g>
              <g fill="#aeb7bf" opacity=".7"><circle cx="162" cy="144" r="10"/><circle cx="232" cy="165" r="7"/><circle cx="312" cy="139" r="10"/><circle cx="403" cy="165" r="9"/><circle cx="488" cy="143" r="8"/></g>
              <path d="M76 53V116 M66 53H86 M66 116H86" stroke="#f1c36c" stroke-width="3" />
              <text x="15" y="37" fill="#f1c36c" font-size="16" font-weight="700">Enter this</text>
              <text x="15" y="137" fill="#f1c36c" font-size="15">finished depth</text>
              <text x="330" y="91" fill="#22201c" font-size="20" font-weight="700" text-anchor="middle">Decomposed granite finish</text>
              <text x="330" y="160" fill="#fff" font-size="19" font-weight="700" text-anchor="middle">Base — calculate separately</text>
              <text x="330" y="223" fill="#fff" font-size="19" font-weight="700" text-anchor="middle">Compacted subgrade</text>
            </svg>
            <figcaption>The coverage result is for the DG finish layer only.</figcaption>
          </figure>
        </section>

        <section class="content-card" aria-labelledby="coverage-math-heading">
          <span class="eyebrow">Show the math</span>
          <h2 id="coverage-math-heading">From delivered amount to finished area</h2>
          <p>A cubic yard contains 27 cubic feet, and depth is entered in inches, so the conversion factor is <strong>324</strong> (27 × 12). The tool treats the allowance as extra material added to the finished geometric volume. It does not claim that every DG product shrinks by the same percentage.</p>
          <div class="formula-box">
            <p>Finished area (sq ft) = loose yards × 324 ÷ [finished depth (in) × (1 + extra % ÷ 100)]</p>
            <p>Loose yards from tons = short tons ÷ loose density (short tons/yd³)</p>
          </div>
          <h3>A 300-square-foot example</h3>
          <ol class="math-steps">
            <li><strong>Finished layer:</strong> 300 sq ft × 3 in ÷ 324 = 2.78 yd³.</li>
            <li><strong>Loose order:</strong> 2.78 yd³ × 1.20 = 3.33 loose yd³.</li>
            <li><strong>Estimated weight:</strong> 3.33 loose yd³ × 1.25 short tons/yd³ = 4.17 short tons.</li>
          </ol>
          <p>For the same inputs, a single short ton is 0.80 loose yd³ and covers <strong>72 finished sq ft</strong>. If you already know your project's length and width, use <a href="/decomposed-granite-calculator">the main decomposed granite calculator</a> for the order volume or <a href="/decomposed-granite-tons-calculator">the DG tons page</a> for a weight-focused estimate.</p>
        </section>

        <section class="content-card" aria-labelledby="field-check-heading">
          <span class="eyebrow">Before ordering</span>
          <h2 id="field-check-heading">Three checks that change real-world coverage</h2>
          <div class="checks-grid">
            <div>
              <h3>Confirm the product</h3>
              <p>“Decomposed granite” can mean different gradations and blends. A stabilized pathway mix can have its own base, moisture, lift, and finished-depth specification. Match the estimate to the exact material on the quote.</p>
            </div>
            <div>
              <h3>Confirm the density</h3>
              <p>The 1.25-short-ton preset is a planning value. <a href="https://www.gravelshop.com/shop/calculate-cubic-yard-feet-ton.asp?groupid=30&amp;productid=819" rel="noopener noreferrer">Gravelshop lists 2,410 lb/yd³ for one ½-inch-minus product</a>, while <a href="https://centraltexasmaterials.com/materials/crushed-granite" rel="noopener noreferrer">Central Texas Materials lists 2,700 lb/yd³ for its DG</a>. Product, source, and moisture can change the delivered weight; ask your yard which figure it uses.</p>
            </div>
            <div>
              <h3>Check the grade and base</h3>
              <p>Measure low spots and planned slope before buying. A thick base or extra material to bring up grade belongs in a separate estimate. Field questions about soft DG after rain often trace back to site preparation, drainage, and compaction, not the square-foot conversion alone.</p>
            </div>
          </div>
        </section>

        <section class="content-card faq-card" aria-labelledby="coverage-faq-heading">
          <h2 id="coverage-faq-heading">Decomposed granite coverage questions</h2>
          <div class="faq-list">
            {faqItems.map(item => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/decomposed-granite-coverage-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateDGC() {
      const quantityInput = document.getElementById('dgc-quantity') as HTMLInputElement | null;
      const unitInput = document.getElementById('dgc-unit') as HTMLSelectElement | null;
      const depthInput = document.getElementById('dgc-depth') as HTMLInputElement | null;
      const extraInput = document.getElementById('dgc-extra') as HTMLInputElement | null;
      const densityInput = document.getElementById('dgc-density') as HTMLInputElement | null;
      const areaInput = document.getElementById('dgc-area') as HTMLInputElement | null;
      if (!quantityInput || !unitInput || !depthInput || !extraInput || !densityInput || !areaInput) return;

      const coverageEl = document.getElementById('kpi-dgc-cover');
      const perTonEl = document.getElementById('kpi-dgc-ton-yield');
      const perYardEl = document.getElementById('kpi-dgc-yard-yield');
      const amountEl = document.getElementById('kpi-dgc-amount');
      const projectEl = document.getElementById('dgc-project-result');
      const errorEl = document.getElementById('dgc-input-error');
      const valid = [quantityInput, depthInput, extraInput, densityInput, areaInput]
        .every(input => input.value !== '' && input.checkValidity());
      if (errorEl) errorEl.hidden = valid;
      if (!valid) {
        for (const el of [coverageEl, perTonEl, perYardEl]) {
          if (el) el.textContent = '—';
        }
        if (amountEl) amountEl.textContent = 'Correct the inputs to calculate coverage';
        if (projectEl) projectEl.textContent = 'Enter valid values to compare with your project.';
        return;
      }

      const quantity = Number(quantityInput.value);
      const depth = Number(depthInput.value);
      const extra = Number(extraInput.value);
      const density = Number(densityInput.value);
      const projectArea = Number(areaInput.value);
      const factor = 1 + extra / 100;
      const looseYards = unitInput.value === 'tons' ? quantity / density : quantity;
      const coverage = looseYards * 324 / (depth * factor);
      const perYard = 324 / (depth * factor);
      const perTon = perYard / density;
      const projectYards = projectArea * depth * factor / 324;
      const projectTons = projectYards * density;
      const formatArea = (value: number) => new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 }).format(value);

      if (coverageEl) coverageEl.textContent = formatArea(coverage);
      if (perTonEl) perTonEl.textContent = formatArea(perTon);
      if (perYardEl) perYardEl.textContent = formatArea(perYard);
      const amountUnit = unitInput.value === 'tons' ? (quantity === 1 ? 'short ton' : 'short tons') : 'loose yd³';
      if (amountEl) amountEl.textContent = 'From ' + quantity.toLocaleString() + ' ' + amountUnit + ' at ' + depth + ' in finished depth';
      if (projectEl) projectEl.textContent = 'For ' + projectArea.toLocaleString() + ' sq ft, plan for ' + projectYards.toFixed(2) + ' loose yd³ or ' + projectTons.toFixed(2) + ' short tons with these settings.';
    }

    ['dgc-quantity', 'dgc-unit', 'dgc-depth', 'dgc-extra', 'dgc-density', 'dgc-area'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateDGC);
      document.getElementById(id)?.addEventListener('change', updateDGC);
    });
    updateDGC();
  </script>
</BaseLayout>

<style>
  .tool-intro { padding: var(--space-6) 0 0; }
  .tool-intro p { max-width: 850px; margin: 0 auto; color: var(--text-secondary); line-height: 1.7; text-align: center; }
  .tool-intro strong { color: var(--text-primary); }
  .section { padding: var(--space-8) 0 var(--space-12); }
  .calc-panel .input-field input, .calc-panel .input-field select { flex: 0 0 auto; min-height: 44px; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .project-check { border-top: 1px solid var(--border-subtle); padding-top: var(--space-5); margin-top: var(--space-6); }
  .project-check p { color: var(--text-primary); line-height: 1.5; margin: var(--space-2) 0 0; }
  .eyebrow { color: var(--accent-gold); font-size: var(--text-xs); font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .small-note, .project-check .small-note { font-size: var(--text-sm); color: var(--text-muted); }
  .content-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: var(--space-8); margin-bottom: var(--space-8); line-height: 1.7; color: var(--text-secondary); }
  .content-card h2 { color: var(--text-primary); font-size: var(--text-2xl); line-height: 1.25; margin: var(--space-2) 0 var(--space-4); }
  .content-card h3 { color: var(--text-primary); font-size: var(--text-lg); margin: var(--space-5) 0 var(--space-2); }
  .content-card p { margin: 0 0 var(--space-4); }
  .content-card p:last-child { margin-bottom: 0; }
  .content-card a { color: var(--accent-gold); text-decoration: underline; text-underline-offset: 2px; }
  .reference-card { border-color: rgba(212, 168, 83, .4); }
  .table-hint { display: none; }
  .table-scroll { overflow-x: auto; margin: var(--space-5) 0; }
  table { width: 100%; min-width: 650px; border-collapse: collapse; font-size: var(--text-sm); }
  caption { text-align: left; font-size: var(--text-xs); color: var(--text-muted); margin-bottom: var(--space-2); }
  th, td { padding: var(--space-3); border-bottom: 1px solid var(--border-subtle); text-align: left; vertical-align: top; }
  thead th { color: var(--text-primary); border-bottom: 2px solid var(--accent-gold); }
  tbody th { color: var(--text-primary); white-space: nowrap; }
  .featured-row { background: rgba(212, 168, 83, .08); }
  .diagram-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(330px, 1.15fr); gap: var(--space-6); align-items: center; }
