---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import SquareFootCalculator from '../components/calculators/SquareFootCalculator.astro';
import SquareFootVisualizer from '../components/visualizers/SquareFootVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quantity & Conversion', url: '/rock-coverage-calculator-yard' },
  { name: 'Rock Square Foot Calculator', url: '/rock-square-foot-calculator' }
];

const entityTags = [
  {
    "label": "Input",
    "value": "Known square feet or four measured beds"
  },
  {
    "label": "Volume formula",
    "value": "Square feet × inches ÷ 324"
  },
  {
    "label": "Weight",
    "value": "Editable material assumption"
  },
  {
    "label": "Separate layers",
    "value": "Calculate each product and depth separately"
  }
];

const quickStats = [
  {
    "value": "4 beds",
    "label": "Area addition",
    "desc": "Combine measured areas using the same material and depth"
  },
  {
    "value": "108 sq ft",
    "label": "One yard at 3 inches",
    "desc": "Geometric coverage before allowances"
  },
  {
    "value": "Separate",
    "label": "Different layers",
    "desc": "Do not combine products into one weight estimate"
  }
];

const faqItems = [
  {
    "q": "How much rock covers 500 square feet at 3 inches?",
    "a": "The net volume is 500 × 3 ÷ 324 = 4.63 cubic yards. With a selected 10% extra order allowance it is 5.09 cubic yards. Estimated weight then depends on the chosen loose bulk density."
  },
  {
    "q": "Does this tool measure curved beds?",
    "a": "It accepts known square footage or adds four entered bed areas. Measure curves separately or use the main calculator for its supported shapes. Irregular boundaries remain field estimates; an automatic extra percentage cannot correct every measurement error."
  },
  {
    "q": "How much rock covers 1,000 square feet?",
    "a": "At an example 3-inch depth, the net volume is 9.26 cubic yards. A selected 10% order increase makes 10.19 cubic yards, about 13.75 US short tons at an example 1.35 short tons per yard."
  },
  {
    "q": "Can I combine beds with different depths or products?",
    "a": "Calculate those separately. Adding areas is valid here when all included areas use the same depth, material weight assumption and allowance."
  }
];
---

<BaseLayout
  title="Rock Coverage Calculator Square Feet - Area to Tons & Yards"
  description="Calculate rock coverage by square feet into cubic yards, tons, and bags. Solve multi-shape landscape beds with depth thickness rules and coverage charts."
  canonicalPath="/rock-square-foot-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Rock Coverage Calculator Square Feet",
      "url": "https://rockcoveragecalculator.com/rock-square-foot-calculator",
      "description": "Converts a known square-foot area or four entered bed areas into cubic yards, estimated US short tons and half-cubic-foot bag equivalents.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "about": {
        "@type": "Thing",
        "name": "Rock Coverage Square Feet"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Rock Coverage Calculator Square Feet"
      highlightWord="Square Feet"
      badge="Geometric Area Sizing & Depth Thickness"
      subtitle="Solve rock coverage from known square footage or calculate complex multi-shape landscape beds into cubic yards, tons, and bags."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <SquareFootCalculator />

    <SquareFootVisualizer />

    <!-- Technical Guide on Square Footage Calculations -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Start with the area that will actually receive rock</h2><p>This tool converts a known footprint to a layer quantity. Enter one measured area, or add up to four bed areas. Deduct large planting gaps, paving, structures and other uncovered spaces before entering the total. Keep the measured area separate from an order allowance so the reason for extra material stays visible.</p><h3>One depth and product per calculation</h3><p>Adding four beds is useful when they use the same product and thickness. A 2-inch decorative bed and a 6-inch base layer need separate calculations, even on the same property. The base and finish course of one project are separate volumes, too; use the <a href="/layered-project-calculator">layered project calculator</a> for a course-by-course plan.</p><h3>Example: 500 square feet at different depths</h3><div class="table-wrapper"><table class="guide-table"><caption>Net geometric volume for 500 sq ft, before extra; these are comparison depths</caption><thead><tr><th scope="col">Entered depth</th><th scope="col">Net cubic yards</th></tr></thead><tbody><tr><th scope="row">1 in</th><td>1.54 yd³</td></tr><tr><th scope="row">2 in</th><td>3.09 yd³</td></tr><tr><th scope="row">3 in</th><td>4.63 yd³</td></tr><tr><th scope="row">4 in</th><td>6.17 yd³</td></tr><tr><th scope="row">6 in</th><td>9.26 yd³</td></tr></tbody></table></div><p>At 3 inches the net result is 4.63 yd³. Adding 10% gives 5.09 yd³. These figures describe a selected layer, not a recommended construction depth. Choose thickness for the actual stone size, intended use and project requirements.</p><h3>Convert volume to an order unit</h3><p>Multiply cubic yards by the supplier’s loose bulk weight to estimate US short tons. Bag count instead comes from package volume: cubic yards × 27 ÷ labeled cubic feet per bag, rounded up. A bag’s weight alone does not establish its volume without a product-specific conversion. The calculator’s half-cubic-foot bag output is a comparison unit; use the <a href="/rock-bag-calculator">bag calculator</a> for the package being purchased.</p><h3>When the area is not known yet</h3><p>Split an irregular footprint into measurable shapes or use a plan. For a curved strip, measure perpendicular widths at regular stations and approximate each section with the average of its two end widths times its length. More sections help around tight curves. Deduct exclusions and keep a note of the measurements; a blanket 10% addition cannot make an inaccurate footprint precise.</p><p>The <a href="/">main calculator</a> includes rectangle, circle, ring, triangle, trapezoid and L-shape inputs. Use the <a href="/rock-coverage-calculator-yard">cubic-yard tool</a> to work backward from known volume, or the <a href="/rock-yardage-calculator">yardage planner</a> for ordering increments and handling estimates.</p></div><div class="content-card faq-card"><h2>Questions about this calculation</h2><div class="faq-accordion">{faqItems.map((item,index)=><details class="faq-detail" open={index===0}><summary class="faq-summary">{item.q}</summary><div class="faq-answer"><p>{item.a}</p></div></details>)}</div></div></div></article>

    <TopicClusterNav currentPage="/rock-square-foot-calculator" category="quantity" />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .guide-table th, .guide-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-table th {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
  }

  .guide-table tr:hover td {
    background: rgba(212, 168, 83, 0.04);
  }

  .steps-list {
    padding-left: var(--space-6);
    margin: var(--space-4) 0;
  }

  .steps-list li {
    margin-bottom: var(--space-3);
  }

  .faq-detail {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary svg {
    transition: transform var(--transition-fast);
  }

  .faq-detail[open] .faq-summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
