---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Pea Gravel Cubic Yard Calculator';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pea Gravel Calculator', url: '/pea-gravel-calculator' },
  { name: 'Pea Gravel Cubic Yard Calculator', url: '/pea-gravel-cubic-yard-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Rounded pea gravel' },
  { label: 'Unit', value: '1 cubic yard = 27 cubic feet' },
  { label: 'At 2 in', value: '162 sq ft per cubic yard' },
  { label: 'Order by', value: 'Yards or supplier-quoted short tons' }
];

const quickStats = [
  { value: '1.48 yd³', label: '20 × 12 ft at 2 in', desc: 'Measured layer volume before extra material' },
  { value: '162 sq ft', label: 'One yard at 2 in', desc: 'Geometric coverage before site allowance' },
  { value: '27 ft³', label: 'One cubic yard', desc: '54 half-cubic-foot bags by volume' }
];

const faqItems = [
  {
    q: 'How many cubic yards of pea gravel do I need for a 15 × 15 ft area?',
    a: 'At 2 inches deep, 225 square feet needs 1.39 cubic yards for the measured layer. If you choose 10% extra for low spots and handling, the estimate becomes 1.53 cubic yards. A supplier selling only half-yard increments would round that to 2 cubic yards.'
  },
  {
    q: 'How do you calculate cubic yards of pea gravel?',
    a: 'For a rectangle, multiply length in feet by width in feet by the desired layer depth in inches, then divide by 324. This is the same as converting inches to feet and cubic feet to cubic yards. Add any site allowance after calculating the layer volume.'
  },
  {
    q: 'How much area does one cubic yard of pea gravel cover?',
    a: 'Before any ordering allowance, one cubic yard covers 216 square feet at 1½ inches, 162 square feet at 2 inches, 108 square feet at 3 inches, or 81 square feet at 4 inches. Divide 324 by the depth in inches for another depth.'
  },
  {
    q: 'How many tons is a cubic yard of pea gravel?',
    a: 'There is no fixed conversion. A planning value of 2,700 pounds per cubic yard equals 1.35 US short tons, but suppliers list different weights for their pea gravel. Use the density on your seller’s quote when ordering by weight.'
  },
  {
    q: 'Is the extra percentage a compaction factor?',
    a: 'No. Rounded pea gravel does not compact into a firm, interlocking layer. The optional extra percentage covers uncertain depth, low spots, handling, and edges. Set it to zero if your measured volume already accounts for those conditions.'
  }
];

const upLinks = [
  { title: 'Pea Gravel Calculator (Material Parent)', slug: '/pea-gravel-calculator', badge: 'Material' },
  { title: 'Rock Coverage Calculator Yard (Unit Parent)', slug: '/rock-coverage-calculator-yard', badge: 'Unit' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Pea Gravel Tons Calculator', slug: '/pea-gravel-tons-calculator', badge: 'Tons' },
  { title: 'Pea Gravel Bag Calculator', slug: '/pea-gravel-bag-calculator', badge: 'Bags' },
  { title: 'Gravel Cubic Yards Calculator', slug: '/gravel-cubic-yard-calculator', badge: 'Gravel Yards' }
];

const bridgeLinks = [
  { title: 'Pea Gravel Patio Calculator', slug: '/pea-gravel-patio-calculator', badge: 'Patio' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' }
];

const supportGuides = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Gravel Size and Sieve Guide', slug: '/gravel-sizes', badge: 'Gradations' },
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Installation' }
];
---

<BaseLayout
  title={pageTitle}
  metaDescription="Find pea gravel cubic yards from area and depth, then plan a bulk order with an optional allowance, supplier increment, and editable weight per yard."
  canonicalPath="/pea-gravel-cubic-yard-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": pageTitle,
      "url": "https://rockcoveragecalculator.com/pea-gravel-cubic-yard-calculator",
      "description": "Estimates the layer and bulk order volume of pea gravel from length, width, depth, and optional extra material.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Patio Installers, Landscape Designers, Homeowners"
      },
      "about": {
        "@type": "Thing",
        "name": "Pea Gravel Volume Calculation"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title={pageTitle}
      highlightWord="Cubic Yard"
      badge="Bulk volume planner"
      subtitle="A 20 × 12 ft area at 2 inches deep takes 1.48 cubic yards of pea gravel for the measured layer, or 1.63 cubic yards with 10% extra for low spots and handling. Enter your dimensions to plan a supplier order."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <section class="section" aria-labelledby="yard-tool-title">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h2 id="yard-tool-title">Measure your pea gravel layer</h2>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="pgy-length">Length (ft)</label>
              <input type="number" id="pgy-length" value="20" min="0.01" step="any" inputmode="decimal" />
            </div>
            <div class="input-field">
              <label for="pgy-width">Width (ft)</label>
              <input type="number" id="pgy-width" value="12" min="0.01" step="any" inputmode="decimal" />
            </div>
            <div class="input-field">
              <label for="pgy-depth">Pea gravel layer depth (in)</label>
              <input type="number" id="pgy-depth" value="2" min="0.1" max="24" step="any" inputmode="decimal" />
            </div>
            <div class="input-field">
              <label for="pgy-waste">Extra for site variation (%)</label>
              <input type="number" id="pgy-waste" value="10" min="0" max="50" step="any" inputmode="decimal" />
            </div>
            <div class="input-field">
              <label for="pgy-increment">Supplier yard increment</label>
              <select id="pgy-increment">
                <option value="0">No rounding</option>
                <option value="0.25">¼ cubic yard</option>
                <option value="0.5">½ cubic yard</option>
                <option value="1">Whole cubic yard</option>
              </select>
            </div>
            <div class="input-field">
              <label for="pgy-density">Supplier weight (lb/yd³)</label>
              <input type="number" id="pgy-density" value="2700" min="1" max="10000" step="any" inputmode="decimal" />
            </div>
          </div>
          <p class="tool-note">Defaults: 10% extra and 2,700 lb/yd³. Replace them with your site measurement and supplier quote. Rounding applies only if you select your seller’s yard increment.</p>
          <p class="calc-error" id="pgy-error" role="status" aria-live="polite" hidden></p>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h2>Layer and order volumes</h2>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card">
              <div class="kpi-value" id="kpi-pgy-net">1.48</div>
              <div class="kpi-label">Measured layer (yd³)</div>
              <div class="kpi-subtext" id="kpi-pgy-area">240 sq ft × 2 in</div>
            </div>
            <div class="kpi-card highlight">
              <div class="kpi-value" id="kpi-pgy-yards">1.63</div>
              <div class="kpi-label">Plan to order (yd³)</div>
              <div class="kpi-subtext" id="kpi-pgy-cuft">44 cu ft, plus 10% extra</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-pgy-purchase">1.63</div>
              <div class="kpi-label">At supplier increment (yd³)</div>
              <div class="kpi-subtext" id="kpi-pgy-round-note">No rounding selected</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-pgy-tons">2.20</div>
              <div class="kpi-label">Approx. US short tons</div>
              <div class="kpi-subtext" id="kpi-pgy-lbs">Based on 2,700 lb/yd³</div>
            </div>
            </div>
            <p class="result-note">Weight uses the displayed order volume above. If your yard sells by weight, confirm its density and ton-order rules before buying.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="content-guide-section">
      <div class="container">
        <section class="content-card measure-card">
          <div class="measure-copy">
            <h2>Turn a measured layer into a yard order</h2>
            <p>A cubic yard is a <strong>volume</strong>, not a square-foot coverage promise. Measure the footprint first, choose the depth of the pea gravel itself, and keep a separate estimate for any compacted base. The calculator reports the layer volume, optional extra material, seller rounding, and an approximate weight.</p>
            <div class="formula-box"><code>Pea gravel yd³ = length (ft) × width (ft) × layer depth (in) ÷ 324</code></div>
            <p>The divisor comes from 12 inches per foot × 27 cubic feet per cubic yard. For an irregular bed, split the footprint into rectangles, calculate each part, and add their yardages. For a circular area or several shapes, use the <a href="/pea-gravel-calculator">main pea gravel calculator</a>.</p>
          </div>
          <figure class="yard-figure">
            <div class="diagram-scroll"><img src="/pea-gravel-yard-volume-diagram.svg" width="720" height="460" loading="lazy" alt="Diagram showing a 20 by 12 foot pea gravel footprint, a 2 inch layer, and the formula 20 times 12 times 2 divided by 324 equals 1.48 cubic yards" /></div>
            <figcaption>Use the depth of the pea gravel layer, measured after grading the ground or base. On a narrow screen, scroll the diagram sideways to read its labels.</figcaption>
          </figure>
        </section>

        <section class="content-card">
          <h2>One cubic yard: coverage at different depths</h2>
          <p>These are geometric yields from <strong>27 cubic feet per yard</strong>. They exclude optional extra material, supplier rounding, and variations in the grade beneath the stone.</p>
          <div class="table-scroll" role="region" aria-label="Pea gravel cubic yard coverage by depth" tabindex="0">
            <table>
              <thead><tr><th scope="col">Pea gravel depth</th><th scope="col">Area from 1 yd³</th><th scope="col">For every 100 sq ft</th></tr></thead>
              <tbody>
                <tr><td>1½ in</td><td>216 sq ft</td><td>0.46 yd³</td></tr>
                <tr><td>2 in</td><td>162 sq ft</td><td>0.62 yd³</td></tr>
                <tr><td>2½ in</td><td>About 130 sq ft</td><td>0.77 yd³</td></tr>
                <tr><td>3 in</td><td>108 sq ft</td><td>0.93 yd³</td></tr>
                <tr><td>4 in</td><td>81 sq ft</td><td>1.23 yd³</td></tr>
              </tbody>
            </table>
          </div>
          <p class="table-note">For another depth: <strong>coverage in sq ft = 324 ÷ depth in inches</strong>. If you already have a yardage and need the area it will cover, use the <a href="/pea-gravel-coverage-calculator">pea gravel coverage calculator</a>.</p>
        </section>

        <section class="content-card">
          <h2>Example: 20 × 12 ft with a 2 inch surface</h2>
          <ol class="order-steps">
            <li><span class="step-number">1</span><div><strong>Measure the layer:</strong> 20 × 12 = 240 square feet. At 2 inches, 240 × 2 ÷ 324 = <strong>1.48 yd³</strong>.</div></li>
            <li><span class="step-number">2</span><div><strong>Add only the extra you need:</strong> a chosen 10% for low spots, uneven edges, and handling brings the estimate to <strong>1.63 yd³</strong>. This is not a fixed compaction percentage.</div></li>
            <li><span class="step-number">3</span><div><strong>Match the seller’s unit:</strong> quarter-yard increments mean ordering <strong>1.75 yd³</strong>; half-yard increments mean <strong>2 yd³</strong>. With no rounding, 1.63 yd³ at the example 2,700 lb/yd³ weighs about <strong>2.20 short tons</strong>.</div></li>
          </ol>
          <p><a href="https://www.skynursery.com/bulk-calculator/" rel="noopener noreferrer">Sky Nursery</a> lists half-yard pickup increments and whole-yard delivery increments, while <a href="https://www.sutherlandscape.com/products/pea-gravel/" rel="noopener noreferrer">Sutherland</a> sells quarter-yard quantities. Your seller may use different steps, minimums, or delivery rules, so check before rounding.</p>
        </section>

        <section class="content-card split-card">
          <div>
            <h2>Choose the right depth and surface</h2>
            <p>Two inches is a useful starting measurement for a small garden path or decorative surface, not a universal specification. A <a href="https://ucanr.edu/sites/default/files/2020-03/321522.pdf" rel="noopener noreferrer">University of California garden pathway guide</a> calls two inches a practical minimum and notes that rounded pea gravel shifts rather than packing into a solid surface. Edging helps contain it; furniture and frequent walking may call for larger stepping stones or an angular surface.</p>
            <p>This calculator measures <strong>only the pea gravel finish</strong>. If your patio also needs a compacted base, measure that layer separately in the <a href="/pea-gravel-patio-calculator">pea gravel patio calculator</a>. For different uses and depths, see the <a href="/rock-depth-guide">rock depth guide</a>.</p>
          </div>
          <aside class="fit-note">
            <h3>Play areas need a separate plan</h3>
            <p>Do not use a decorative 2–3 inch estimate for a fall zone beneath play equipment. The <a href="https://www.cpsc.gov/safety-education/safety-guides/playgrounds/public-playground-safety-checklist" rel="noopener noreferrer">CPSC public playground checklist</a> calls for at least 12 inches of loose fill around equipment, plus an adequate use zone. Follow the applicable equipment and surfacing guidance.</p>
          </aside>
        </section>

        <section class="content-card">
          <h2>What to confirm before ordering bulk pea gravel</h2>
          <ul class="buying-checklist">
            <li><strong>Product:</strong> ask for the stone size and a sample. “Pea gravel” is a retail description; colors, grading, and roundedness differ by source.</li>
            <li><strong>Weight:</strong> ask for pounds per loose cubic yard if buying by short ton. <a href="https://www.skynursery.com/bulk-calculator/" rel="noopener noreferrer">Sky Nursery lists 2,500–2,700 lb/yd³</a> for its pea gravel, while <a href="https://www.sutherlandscape.com/products/pea-gravel/" rel="noopener noreferrer">Sutherland lists 2,540 lb/yd³</a> for another product. The tool’s 2,700 lb/yd³ is an editable planning value.</li>
            <li><strong>Sales unit:</strong> confirm the smallest yard increment, delivery minimum, and whether the quote is by cubic yard or scale weight. The displayed tons use the selected increment volume.</li>
            <li><strong>Delivery:</strong> confirm where the truck can safely dump and whether your vehicle can carry the quoted weight if collecting it. For a small order, compare <a href="/pea-gravel-bag-calculator">bag counts</a> with a bulk delivery.</li>
          </ul>
        </section>

        <section class="content-card faq-card">
          <h2>Frequently Asked Questions About Pea Gravel Yardage</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/pea-gravel-cubic-yard-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updatePGY() {
      const ids = ['pgy-length', 'pgy-width', 'pgy-depth', 'pgy-waste', 'pgy-density'] as const;
      const fields = ids.map(id => document.getElementById(id) as HTMLInputElement);
      const [length, width, depth, extra, density] = fields.map(field => field.valueAsNumber);
      const incrementSelect = document.getElementById('pgy-increment') as HTMLSelectElement;
      const increment = Number(incrementSelect.value);
      const valid = Number.isFinite(length) && length > 0 &&
        Number.isFinite(width) && width > 0 &&
        Number.isFinite(depth) && depth > 0 && depth <= 24 &&
        Number.isFinite(extra) && extra >= 0 && extra <= 50 &&
        Number.isFinite(density) && density > 0 && density <= 10000 &&
        [0, 0.25, 0.5, 1].includes(increment);
      const error = document.getElementById('pgy-error') as HTMLElement;
      error.hidden = valid;
      error.textContent = valid ? '' : 'Enter a positive length, width, depth (up to 24 in), and supplier weight; extra material must be 0–50%.';
      fields.forEach((field, index) => {
        const value = [length, width, depth, extra, density][index];
        const fieldValid = Number.isFinite(value) && (index === 3 ? value >= 0 && value <= 50 : value > 0) && (index !== 2 || value <= 24) && (index !== 4 || value <= 10000);
        field.setAttribute('aria-invalid', String(!fieldValid));
      });

      const outputIds = ['kpi-pgy-net', 'kpi-pgy-yards', 'kpi-pgy-purchase', 'kpi-pgy-tons'];
      if (!valid) {
        outputIds.forEach(id => { const el = document.getElementById(id); if (el) el.textContent = '—'; });
        ['kpi-pgy-area', 'kpi-pgy-cuft', 'kpi-pgy-round-note', 'kpi-pgy-lbs'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = 'Check the inputs'; });
        return;
      }

      const area = length * width;
      const netYards = area * depth / 324;
      const orderYards = netYards * (1 + extra / 100);
      const purchaseYards = increment ? Math.ceil(orderYards / increment - 1e-10) * increment : orderYards;
      const pounds = purchaseYards * density;
      const set = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
      set('kpi-pgy-net', netYards.toFixed(2));
      set('kpi-pgy-yards', orderYards.toFixed(2));
      set('kpi-pgy-purchase', purchaseYards.toFixed(2));
      set('kpi-pgy-tons', (pounds / 2000).toFixed(2));
      set('kpi-pgy-area', `${area.toLocaleString(undefined, { maximumFractionDigits: 1 })} sq ft × ${depth.toLocaleString()} in`);
      set('kpi-pgy-cuft', `${Math.round(orderYards * 27).toLocaleString()} cu ft, plus ${extra.toLocaleString()}% extra`);
      set('kpi-pgy-round-note', increment ? `Rounded up in ${incrementSelect.selectedOptions[0].textContent?.toLowerCase()} steps` : 'No rounding selected');
      set('kpi-pgy-lbs', `≈${Math.round(pounds).toLocaleString()} lb at ${density.toLocaleString()} lb/yd³`);
    }

    ['pgy-length', 'pgy-width', 'pgy-depth', 'pgy-waste', 'pgy-density'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updatePGY);
    });
    document.getElementById('pgy-increment')?.addEventListener('change', updatePGY);
    updatePGY();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .calc-panel-title h2 { font-size: var(--text-lg); line-height: 1.3; margin: 0; }
  .tool-note, .result-note { color: var(--text-muted); font-size: var(--text-sm); line-height: 1.55; margin: var(--space-4) 0 0; }
  .calc-error { color: #f5b8b8; font-size: var(--text-sm); margin: var(--space-3) 0 0; }
  .calc-error[hidden] { display: none; }
  .input-field [aria-invalid='true'] { border-color: #dc7777; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .content-card h3 { color: var(--text-primary); }
  .content-card p { margin-bottom: var(--space-4); }
  .content-card a { color: var(--accent-gold); text-decoration: underline; text-underline-offset: 3px; }
  .measure-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(290px, 0.9fr); gap: var(--space-8); align-items: center; }
  .measure-copy, .yard-figure { min-width: 0; }
  .yard-figure { margin: 0; }
  .yard-figure img { display: block; width: 100%; height: auto; border-radius: var(--radius-md); }
  .diagram-scroll { max-width: 100%; overflow-x: auto; }
  .yard-figure figcaption { color: var(--text-muted); font-size: var(--text-xs); line-height: 1.5; margin-top: var(--space-2); }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .table-scroll { overflow-x: auto; margin: var(--space-5) 0; }
  .table-scroll table { width: 100%; min-width: 500px; border-collapse: collapse; text-align: left; }
  .table-scroll th, .table-scroll td { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border-subtle); }
  .table-scroll th { color: var(--accent-gold); font-size: var(--text-sm); }
  .table-scroll td { color: var(--text-secondary); }
  .table-note { font-size: var(--text-sm); }
  .order-steps { list-style: none; padding: 0; margin: var(--space-6) 0; display: grid; gap: var(--space-4); }
  .order-steps li { display: flex; gap: var(--space-4); align-items: flex-start; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .step-number { flex: 0 0 2rem; width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; color: var(--bg-body); background: var(--accent-gold); font-weight: 800; }
  .split-card { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(230px, 0.7fr); gap: var(--space-8); }
  .fit-note { background: var(--bg-surface); border-left: 3px solid var(--accent-gold); border-radius: var(--radius-md); padding: var(--space-5); align-self: start; }
  .fit-note h3 { margin: 0 0 var(--space-3); font-size: var(--text-lg); }
  .fit-note p { margin: 0; font-size: var(--text-sm); }
  .buying-checklist { padding-left: var(--space-6); margin: 0; }
  .buying-checklist li { margin-bottom: var(--space-3); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
