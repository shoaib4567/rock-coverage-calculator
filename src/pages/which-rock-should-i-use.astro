---
import TopicClusterNav from '../components/TopicClusterNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Which Rock Should I Use? Helper', url: '/which-rock-should-i-use' }
];

const title = "Which Rock Should I Use? - Interactive Material Recommender Wizard";
const metaDescription = "Find the best landscape rock, gravel, or crushed stone for your project. 4-question decision helper matching traffic, slope, drainage, and budget with example depth and ordering guidance.";
---

<BaseLayout title={title} metaDescription={metaDescription} canonicalPath="/which-rock-should-i-use">
  <Header />

  <main id="main-content">
    <PageHero
      title="Which Rock Should I Use?"
      subtitle="Compare material options for your use, traffic, slope and preferred appearance. Recommendations are starting points to confirm with the supplier and installation plan."
      badge="Project Decision Helper"
      breadcrumbs={breadcrumbs}
      theme="decorative"
    />

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <!-- Interactive Recommender Wizard Card -->
        <div class="wizard-card animate-fade-in-up">
          <div class="wizard-progress-bar">
            <div class="wizard-progress-fill" id="wizard-progress" style="width: 25%;"></div>
          </div>

          <div class="wizard-steps-container">
            <!-- Step 1: Project Type -->
            <div class="wizard-step active" data-step="1" id="wizard-step-1">
              <div class="step-badge">Step 1 of 4</div>
              <h2 class="step-question">What type of project are you building?</h2>
              <p class="step-instruction">Select the primary functional purpose of your rock coverage area:</p>

              <div class="options-grid">
                <button type="button" class="wizard-option-btn" data-field="project" data-val="driveway">
                  <div class="option-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 17h10M7 7h10M7 12h10"/></svg>
                  </div>
                  <div class="option-text">
                    <strong>Driveway / Parking Pad</strong>
                    <span>Vehicular traffic, heavy wheel loads, turning tires</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="project" data-val="walkway">
                  <div class="option-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                  </div>
                  <div class="option-text">
                    <strong>Walkway, Path, or Patio</strong>
                    <span>Foot traffic, outdoor patio chairs, wheelbarrows</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="project" data-val="drainage">
                  <div class="option-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v6m0 8v6M4.93 4.93l4.24 4.24m5.66 5.66l4.24 4.24M2 12h6m8 0h6M4.93 19.07l4.24-4.24m5.66-5.66l4.24-4.24"/></svg>
                  </div>
                  <div class="option-text">
                    <strong>French Drain / Downspout Trench</strong>
                    <span>Subsurface drainage, water diversion, weeping tile</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="project" data-val="garden">
                  <div class="option-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><path d="M12 6v6l4 2"/></svg>
                  </div>
                  <div class="option-text">
                    <strong>Flower Bed / Mulch Replacement</strong>
                    <span>Decorative beds, weed suppression, foundation border</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="project" data-val="firepit">
                  <div class="option-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2c1.5 3 4 5 4 8a4 4 0 0 1-8 0c0-3 2.5-5 4-8z"/><path d="M12 18v4M4.93 19.07l2.83-2.83M19.07 19.07l-2.83-2.83"/></svg>
                  </div>
                  <div class="option-text">
                    <strong>Fire Pit / Outdoor Seating Area</strong>
                    <span>Heat proximity, outdoor furniture, casual entertaining</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="project" data-val="dogrun">
                  <div class="option-icon-box">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                  </div>
                  <div class="option-text">
                    <strong>Dog Run / Pet Play Area</strong>
                    <span>Paw comfort, rapid drainage, easy waste sanitization</span>
                  </div>
                </button>
              </div>
            </div>

            <!-- Step 2: Traffic Level -->
            <div class="wizard-step" data-step="2" id="wizard-step-2" style="display: none;">
              <div class="step-badge">Step 2 of 4</div>
              <h2 class="step-question">What traffic level must it handle?</h2>
              <p class="step-instruction">Traffic and access needs help narrow the questions to ask about firmness, movement and support:</p>

              <div class="options-grid">
                <button type="button" class="wizard-option-btn" data-field="traffic" data-val="vehicular">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
                  <div class="option-text">
                    <strong>Heavy Vehicular Traffic</strong>
                    <span>Trucks, SUVs, trailers; requires compaction and mechanical interlock</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="traffic" data-val="pedestrian">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="7" r="4"/><path d="M5.5 21v-3.5L9 14l2.5 3 2.5-3 3.5 3.5V21"/></svg></div>
                  <div class="option-text">
                    <strong>Regular Foot Traffic (With Shoes)</strong>
                    <span>Check surface firmness, wheel movement and patio furniture stability</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="traffic" data-val="barefoot">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a5 5 0 0 1 5 5v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V7a5 5 0 0 1 5-5z"/></svg></div>
                  <div class="option-text">
                    <strong>Barefoot or pet use to evaluate</strong>
                    <span>Inspect the actual sample and consider comfort, movement and maintenance</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="traffic" data-val="none">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg></div>
                  <div class="option-text">
                    <strong>Zero Foot Traffic (Visual Only)</strong>
                    <span>Decorative cover; planting, runoff and upkeep still matter</span>
                  </div>
                </button>
              </div>

              <div class="step-nav-row">
                <button type="button" class="btn btn-ghost btn-wizard-back">&larr; Back to Step 1</button>
              </div>
            </div>

            <!-- Step 3: Slope & Runoff -->
            <div class="wizard-step" data-step="3" id="wizard-step-3" style="display: none;">
              <div class="step-badge">Step 3 of 4</div>
              <h2 class="step-question">What are the slope and water runoff conditions?</h2>
              <p class="step-instruction">Slope and water concentration affect loose material. Choose the description closest to your site:</p>

              <div class="options-grid">
                <button type="button" class="wizard-option-btn" data-field="slope" data-val="flat">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"/></svg></div>
                  <div class="option-text">
                    <strong>Little visible slope</strong>
                    <span>Lower slope does not eliminate runoff or drainage concerns</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="slope" data-val="moderate-slope">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/></svg></div>
                  <div class="option-text">
                    <strong>Sloping ground or hillside</strong>
                    <span>Prone to gravel migration during heavy downpours</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="slope" data-val="water-channel">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg></div>
                  <div class="option-text">
                    <strong>Active Water Channel / Swale / Trench</strong>
                    <span>High-volume stormwater runoff, downspout splash zones</span>
                  </div>
                </button>
              </div>

              <div class="step-nav-row">
                <button type="button" class="btn btn-ghost btn-wizard-back">&larr; Back to Step 2</button>
              </div>
            </div>

            <!-- Step 4: Aesthetic & Budget -->
            <div class="wizard-step" data-step="4" id="wizard-step-4" style="display: none;">
              <div class="step-badge">Step 4 of 4</div>
              <h2 class="step-question">What is your aesthetic and budget priority?</h2>
              <p class="step-instruction">Choose the appearance that matches your home and landscape design:</p>

              <div class="options-grid">
                <button type="button" class="wizard-option-btn" data-field="aesthetic" data-val="natural-earth">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12a4 4 0 0 0 8 0"/></svg></div>
                  <div class="option-text">
                    <strong>Natural Earth Tones (Tan, Buff, Gray)</strong>
                    <span>River rock, pea gravel, decomposed granite; classic landscaping look</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="aesthetic" data-val="modern-crisp">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 22 22 22"/></svg></div>
                  <div class="option-text">
                    <strong>High-Contrast Modern (White Marble, Black Pebble)</strong>
                    <span>Bold architectural statement, clean edges, striking contrast</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="aesthetic" data-val="budget-utility">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                  <div class="option-text">
                    <strong>Compare local delivered prices</strong>
                    <span>Crushed limestone (#57), crusher run base, local quarry blend</span>
                  </div>
                </button>

                <button type="button" class="wizard-option-btn" data-field="aesthetic" data-val="volcanic">
                  <div class="option-icon-box"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                  <div class="option-text">
                    <strong>Lightweight Porous (Red/Black Lava Rock)</strong>
                    <span>Compare the landscape product’s texture, color, weight and planting suitability</span>
                  </div>
                </button>
              </div>

              <div class="step-nav-row">
                <button type="button" class="btn btn-ghost btn-wizard-back">&larr; Back to Step 3</button>
              </div>
            </div>

            <!-- Recommendation Result Card -->
            <div class="wizard-step" id="wizard-result" style="display: none;">
              <div class="result-header">
                <div class="result-badge-row">
                  <span class="result-tag" id="rec-tag">Options to investigate</span>
                  <button type="button" class="btn btn-ghost btn-sm" id="btn-restart-wizard">Start Over</button>
                </div>
                <h2 id="rec-material-title" class="rec-title">Compare local landscape rock products</h2>
                <p id="rec-material-summary" class="rec-summary">Choose a product sample for the appearance and use you want, then confirm grading and the installation plan.</p>
              </div>

              <div class="rec-specs-grid">
                <div class="spec-card">
                  <div class="spec-label">Layer depth check</div>
                  <div class="spec-val" id="rec-depth">Check the finished layer specification</div>
                  <div class="spec-note" id="rec-depth-note">Use the thickness selected for the actual product and site. Particle size is not automatically the layer depth.</div>
                </div>

                <div class="spec-card">
                  <div class="spec-label">Base preparation check</div>
                  <div class="spec-val" id="rec-base">Confirm preparation for this use</div>
                  <div class="spec-note" id="rec-base-note">Soil support, drainage and loading determine whether a separate prepared base is needed.</div>
                </div>

                <div class="spec-card">
                  <div class="spec-label">Separation / Stabilization Detail</div>
                  <div class="spec-val" id="rec-fabric">Check separation and filter requirements</div>
                  <div class="spec-note" id="rec-fabric-note">Fabric is a site and product choice; it does not guarantee weed control or load capacity.</div>
                </div>

                <div class="spec-card">
                  <div class="spec-label">Supplier weight check</div>
                  <div class="spec-val" id="rec-density">Use the supplier’s loose bulk weight</div>
                  <div class="spec-note" id="rec-density-note">A material name does not establish one density. Enter a quoted or measured product value in the calculator.</div>
                </div>
              </div>

              <div class="rec-pitfalls-box">
                <div class="pitfall-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  <span>Critical Installation Warnings</span>
                </div>
                <p id="rec-pitfalls">Check product size, fines, containment, maintenance and the actual quote before ordering.</p>
              </div>

              <div class="rec-cta-row">
                <a id="rec-calc-btn" href="/crushed-stone-calculator" class="btn btn-primary btn-lg">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                  Open Calculator with These Specs
                </a>
                <a href="/layered-project-calculator" class="btn btn-secondary btn-lg">
                  Plan Layered Base &amp; Edging
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Master Aggregate Selection Matrix Table -->
        <div class="section-header" style="margin-top: var(--space-12);">
          <h2>Compare material characteristics</h2>
          <div class="section-divider"></div>
          <p>Compare the engineering properties, barefoot comfort, shear stability, and best uses across all primary landscape rocks.</p>
        </div>

        <div class="matrix-table-card">
          <div class="table-responsive">
            <table class="data-table"><caption>Material characteristics to check against the actual product and project</caption>
<thead><tr><th scope="col">Material</th><th scope="col">Physical characteristics</th><th scope="col">Often considered for</th><th scope="col">Check before estimating</th></tr></thead>
<tbody>
<tr><th scope="row">Clean crushed stone</th><td>Angular particles; specified size distribution and fines content</td><td>Drainage or construction layers where specified</td><td>A size such as #57 does not establish washing, mineral type or load capacity.</td></tr>
<tr><th scope="row">Crusher run / dense-graded base</th><td>A blend of particle sizes and fines</td><td>Specified compacted base or surface courses</td><td>Actual grading, finished thickness, compaction procedure and loose ordering factor</td></tr>
<tr><th scope="row">Pea gravel</th><td>Small rounded particles that remain loose</td><td>Contained decorative or pedestrian areas</td><td>Movement under furniture and wheels, edging, actual feel and product yield</td></tr>
<tr><th scope="row">Decomposed granite</th><td>Fine granite particles; natural and binder-stabilized products differ</td><td>Paths or patios with the appropriate preparation</td><td>Manufacturer instructions, drainage, firmness, dust and actual access needs</td></tr>
<tr><th scope="row">River rock / egg rock</th><td>Rounded stones in supplier-specific grades</td><td>Decorative beds and specified stone linings</td><td>Size, selected depth, containment and loose bulk weight</td></tr>
<tr><th scope="row">Beach pebbles</th><td>Decorative rounded or flattened products</td><td>Borders, planters and architectural beds</td><td>Sample appearance, bag volume and the spread needed for the desired finish</td></tr>
<tr><th scope="row">Landscape lava rock</th><td>Porous volcanic landscape stone with variable bulk weight</td><td>Decorative mulch where suitable for the planting</td><td>Texture, bag yield and product specification; landscape stone is not automatically fire-appliance media.</td></tr>
<tr><th scope="row">Marble chips</th><td>Angular decorative marble products</td><td>Selected decorative beds and borders</td><td>Chip size, soil and plant requirements, upkeep and package yield</td></tr>
<tr><th scope="row">Riprap</th><td>Specified large-stone gradation and quality</td><td>Designed erosion-control and armor layers</td><td>Project-specific stone size, thickness, filter and placement detail before calculating quantity</td></tr>
</tbody></table>
          </div>
        </div>
      </div>
    </section>
<section class="container section"><h2>Use the recommendation as a starting point</h2><p>The four answers cannot establish structural bearing capacity, accessibility, drainage performance or a fabric specification. Compare an actual product sample and confirm the material, layer depths and preparation appropriate to your site. Use the <a href="/layered-project-calculator">layered planner</a> for separate quantities and <a href="/rock-depth-guide">depth guide</a> for planning questions.</p></section>
  <TopicClusterNav />
  </main>

  <Footer />
</BaseLayout>

<script>
  import {getMaterialCandidate} from '../lib/material-choice.mjs';
  const answers: Record<string,string|null> = {project:null,traffic:null,slope:null,aesthetic:null};
  const steps = ['wizard-step-1','wizard-step-2','wizard-step-3','wizard-step-4','wizard-result'].map(id=>document.getElementById(id));
  const setText=(id:string,value:string)=>{const node=document.getElementById(id);if(node)node.textContent=value;};
  function showStep(index:number) {
    steps.forEach((step,i)=>{if(step)step.style.display=i===index?'block':'none';});
    const bar=document.getElementById('wizard-progress');
    if(bar)bar.style.width=(index>=4?100:(index+1)*25)+'%';
    if(index===4) {
      const rec=getMaterialCandidate({project:answers.project,traffic:answers.traffic,slope:answers.slope,aesthetic:answers.aesthetic});
      const output: Record<string,string> = {'rec-tag':rec.tag,'rec-material-title':rec.title,'rec-material-summary':rec.summary,'rec-depth':rec.depth,'rec-depth-note':rec.depthNote,'rec-base':rec.base,'rec-base-note':rec.baseNote,'rec-fabric':rec.fabric,'rec-fabric-note':rec.fabricNote,'rec-density':rec.density,'rec-density-note':rec.densityNote,'rec-pitfalls':rec.pitfalls};
      Object.entries(output).forEach(([id,value])=>setText(id,value));
      const link=document.getElementById('rec-calc-btn');if(link instanceof HTMLAnchorElement)link.href=rec.calcUrl;
    }
    const heading=steps[index]?.querySelector('h2');if(heading){heading.tabIndex=-1;heading.focus();}
  }
  document.querySelectorAll<HTMLButtonElement>('.wizard-option-btn').forEach(button=>button.addEventListener('click',()=>{
    const {field,val}=button.dataset;if(!field||!val||!(field in answers))return;
    answers[field]=val;
    document.querySelectorAll<HTMLButtonElement>('.wizard-option-btn').forEach(option=>{if(option.dataset.field===field)option.setAttribute('aria-pressed',String(option===button));});
    showStep(field==='project'?1:field==='traffic'?2:field==='slope'?3:4);
  }));
  document.querySelectorAll<HTMLButtonElement>('.btn-wizard-back').forEach(button=>button.addEventListener('click',()=>{
    const current=steps.findIndex(step=>step?.style.display==='block');if(current>0)showStep(current-1);
  }));
  document.getElementById('btn-restart-wizard')?.addEventListener('click',()=>{
    Object.keys(answers).forEach(key=>answers[key]=null);
    document.querySelectorAll('.wizard-option-btn').forEach(button=>button.setAttribute('aria-pressed','false'));
    showStep(0);
  });
</script>

<style>
  .wizard-card {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    margin-bottom: var(--space-8);
  }

  .wizard-progress-bar {
    height: 6px;
    background: var(--slate-800);
    width: 100%;
  }

  .wizard-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold-500), #10b981);
    transition: width var(--duration-base) var(--ease-smooth);
  }

  .wizard-steps-container {
    padding: var(--space-8) var(--space-6);
  }

  @media (min-width: 768px) {
    .wizard-steps-container {
      padding: var(--space-10) var(--space-12);
    }
  }

  .step-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--gold-400);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .step-question {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .step-instruction {
    font-size: 0.925rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .options-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .options-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .wizard-option-btn {
    background: var(--slate-850);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    text-align: left;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-smooth);
    color: inherit;
    width: 100%;
  }

  .wizard-option-btn:hover {
    background: var(--slate-800);
    border-color: var(--gold-400);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
