---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Decomposed Granite Calculator', url: '/decomposed-granite-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Decomposed Granite (DG)' },
  { label: 'Gradation', value: '3/8" or 1/4"-minus granite particles with fines' },
  { label: 'Loose Density Preset', value: '1.25 short t/yd³ (2,500 lb/yd³ editable)' },
  { label: 'Order Allowance', value: '20% starting estimate (editable)' }
];

const quickStats = [
  { value: '1/4"–3/8" Minus', label: 'Typical gradation', desc: 'Contains angular stone particles and natural fines' },
  { value: '1.25 t/yd³', label: 'Loose density preset', desc: 'Planning estimate of 2,500 lb/yd³; verify with supplier' },
  { value: '20% Extra', label: 'Compaction / order buffer', desc: 'Editable down to 0% for exact geometric coverage' }
];

const faqItems = [
  {
    q: 'How much decomposed granite do I need for a 10 × 20 foot patio?',
    a: 'A 10 × 20 foot patio is 200 square feet. At a 3-inch finished depth, the geometric volume is 1.85 cubic yards. With the calculator’s editable 20% order allowance, plan for 2.22 loose cubic yards. At 1.25 short tons per cubic yard, that is about 2.78 short tons or 120 half-cubic-foot bags.'
  },
  {
    q: 'How much square footage does 1 ton or 1 yard of decomposed granite cover?',
    a: 'At 3 inches thick before extra allowance, 1 cubic yard covers 108 square feet and 1 short ton (at 1.25 t/yd³) covers about 86.4 square feet. Switch the calculator above to Reverse: Stock → Area to compute coverage for any quantity in yards, short tons, or bags.'
  },
  {
    q: 'What is the difference between standard DG and stabilized DG?',
    a: 'Standard DG contains granite particles and natural mineral fines that compact into a natural-looking surface. Stabilized products blend an organic or synthetic binder; their mixing, base, moisture, and plate-compaction requirements vary by manufacturer. A stabilizer improves erosion resistance, though proper crown and drainage remain essential.'
  },
  {
    q: 'Can decomposed granite be installed without a plate compactor?',
    a: 'Follow the directions for the DG product and project scale. A manufacturer typically specifies a vibratory plate compactor or roller over moistened lifts for pathways and patios, while a heavy hand tamper suits small touch-up patches. Foot traffic alone will not achieve uniform density.'
  }
];
---

<BaseLayout
  title="Decomposed Granite Calculator"
  description="Estimate cubic yards, short tons, and 0.5-cu-ft bags of decomposed granite for paths and patios, or reverse-calculate coverage from existing stock."
  canonicalPath="/decomposed-granite-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Decomposed Granite Calculator",
      "url": "https://rockcoveragecalculator.com/decomposed-granite-calculator",
      "description": "Calculates finished decomposed granite layer volume, estimated loose order yards, short tons, bags, and reverse coverage area for paths and patios.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "audience": {
        "@type": "Audience",
        "audienceType": "Landscape Contractors, Masons, Homeowners, Civil Estimators"
      },
      "about": {
        "@type": "Thing",
        "name": "Decomposed Granite"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Decomposed Granite Calculator"
      highlightWord="Calculator"
      badge="Pathways & Compacted Patio Engine"
      subtitle="Estimate cubic yards, short tons, and bags for a finished DG path or patio—or switch to Reverse mode to see how much area existing bulk stock or bags will cover."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <!-- Specialized Decomposed Granite Interactive Calculator -->
    <section class="section" id="dg-calc">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
              <h2>Decomposed Granite Project Setup</h2>
            </div>

            <div class="unit-toggle" role="group" aria-label="Calculation mode">
              <button class="active" id="dg-mode-dims" type="button" aria-pressed="true">Dimensions (L &times; W)</button>
              <button id="dg-mode-sqft" type="button" aria-pressed="false">Known Sq Ft</button>
              <button id="dg-mode-reverse" type="button" aria-pressed="false">Reverse: Stock &rarr; Area</button>
            </div>

            <div id="dg-dims-group" class="dim-grid">
              <div class="input-field">
                <label for="dg-length">Length (Feet)</label>
                <input type="number" id="dg-length" value="30" min="0.1" step="any" />
              </div>
              <div class="input-field">
                <label for="dg-width">Width (Feet)</label>
                <input type="number" id="dg-width" value="10" min="0.1" step="any" />
              </div>
            </div>

            <div id="dg-sqft-group" class="dim-grid single-col" style="display: none;">
              <div class="input-field">
                <label for="dg-area">Coverage Area (Sq Ft)</label>
                <input type="number" id="dg-area" value="300" min="1" step="any" />
              </div>
            </div>

            <div id="dg-reverse-group" class="dim-grid" style="display: none;">
              <div class="input-field">
                <label for="dg-reverse-qty">Available DG Quantity</label>
                <input type="number" id="dg-reverse-qty" value="3" min="0.05" step="any" />
              </div>
              <div class="input-field">
                <label for="dg-reverse-unit">Stock Unit</label>
                <select id="dg-reverse-unit">
                  <option value="yards">Cubic yards (yd&sup3;)</option>
                  <option value="tons">Short tons (2,000 lb)</option>
                  <option value="bags">0.5 cu ft bags</option>
                </select>
              </div>
            </div>

            <div class="dim-grid">
              <div class="input-field">
                <label for="dg-depth">Target Compacted Depth (Inches)</label>
                <input type="number" id="dg-depth" value="3.0" min="0.5" max="12" step="any" />
              </div>
              <div class="input-field">
                <label for="dg-compaction">Compaction / Extra Material (%)</label>
                <input type="number" id="dg-compaction" value="20" min="0" max="50" step="any" />
              </div>
              <div class="input-field">
                <label for="dg-density">Loose Bulk Density (Short Tons/Yd&sup3;)</label>
                <input type="number" id="dg-density" value="1.25" min="0.3" max="3" step="any" inputmode="decimal" aria-describedby="dg-density-hint" />
                <small id="dg-density-hint">Divide lb/yd&sup3; by 2,000 (e.g., 2,500 lb = 1.25 t/yd&sup3;).</small>
              </div>
              <div class="input-field" id="dg-rounding-wrap">
                <label for="dg-rounding">Supplier Bulk Increment</label>
                <select id="dg-rounding">
                  <option value="0">Exact calculated yards</option>
                  <option value="0.25">Round up to 0.25 yd&sup3;</option>
                  <option value="0.5">Round up to 0.50 yd&sup3;</option>
                  <option value="1">Round up to 1.00 yd&sup3;</option>
                </select>
              </div>
            </div>
            <p id="dg-input-error" class="calc-error" role="alert" hidden>Enter positive dimensions or quantity, depth from 0.5 to 12 in, 0–50% extra material, and loose density from 0.3 to 3.0 short tons/yd&sup3;.</p>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h2 id="dg-results-heading">Required Material Totals</h2>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <span class="kpi-value" id="kpi-dg-primary">0.00</span>
                <div class="kpi-label" id="label-dg-primary">Order Volume (Cubic Yards)</div>
                <div class="kpi-subtext" id="kpi-dg-loose">Includes 20% extra material</div>
              </div>
              <div class="kpi-card">
                <span class="kpi-value" id="kpi-dg-tons">0.00</span>
                <div class="kpi-label" id="label-dg-tons">Estimated Weight (Short Tons)</div>
                <div class="kpi-subtext" id="kpi-dg-density">At 1.25 t/yd&sup3; loose density</div>
              </div>
              <div class="kpi-card">
                <span class="kpi-value" id="kpi-dg-bags">0</span>
                <div class="kpi-label" id="label-dg-bags">0.5 cu ft Bags</div>
                <div class="kpi-subtext" id="kpi-dg-bags-sub">54 bags per cubic yard</div>
              </div>
              <div class="kpi-card">
                <span class="kpi-value" id="kpi-dg-fourth">300 sq ft</span>
                <div class="kpi-label" id="label-dg-fourth">Covered Surface Area</div>
                <div class="kpi-subtext" id="kpi-dg-fourth-sub">At target compacted depth</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide on Decomposed Granite -->
    <article class="content-guide-section">
      <div class="container">

        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="Decomposed Granite Sizing Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">Decomposed Granite Sizing Reference</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Finished Layer Volume</span>
              <span class="aeo-quick-value">Yards = (Area [sq ft] &times; Depth [in]) / 324</span>
              <p class="aeo-quick-desc">The geometric space occupied by the compacted finished layer.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Compaction Allowance</span>
              <span class="aeo-quick-value">Order Yards = Finished Yards &times; 1.20</span>
              <p class="aeo-quick-desc">The default adds 20% for vibratory plate compaction and grading. Set to 0% for raw volume.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Loose Bulk Density</span>
              <span class="aeo-quick-value">1.25 t/yd&sup3; (2,500 lb/yd&sup3;)</span>
              <p class="aeo-quick-desc">Editable loose-density planning preset. Typical quarried DG ranges from 2,400 to 3,000 lb/yd&sup3;.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Finished Depth</span>
              <span class="aeo-quick-value">2.5–3.0 in (Paths) · 4.0+ in (Patios)</span>
              <p class="aeo-quick-desc">Traffic load, soil, and base design govern lift thickness and stabilizer choice.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>Keep finished DG volume and the loose order separate</h2>
          <p>
            <strong>Decomposed granite (DG)</strong> is weathered granitic material sold as a mixture of angular stone particles and natural fines. Gradation varies by quarry and binder type, so verify the particle size and stabilizer specs before installation.
          </p>
          <p>
            Unlike <a href="/crushed-granite-calculator">clean coarse crushed granite</a>, DG includes fine particles that lock together when moistened and compacted into a firm pedestrian surface. For structural driveways or sub-bases under pavers, compare <a href="/crusher-run-calculator">crusher run dense-graded aggregate</a>.
          </p>

          <figure class="dg-figure">
            <img src="/dg-tons-order-path.svg" width="880" height="390" loading="lazy" alt="Diagram showing the order calculation workflow from compacted DG area and depth to loose cubic yards and short tons." />
            <figcaption>From finished path dimensions to loose order cubic yards and short tons. Use Reverse mode above when working backward from a supplier quote.</figcaption>
          </figure>

          <div class="formula-box">
            <code>Compacted Layer Volume (yd&sup3;) = [Area (sq ft) &times; Finished Depth (in)] / 324</code>
            <br />
            <code>Estimated Loose Order (yd&sup3;) = Compacted Volume &times; (1 + Extra % &divide; 100)</code>
            <br />
            <code>Estimated Short Tons = Loose Order (yd&sup3;) &times; Loose Density (short t/yd&sup3;)</code>
          </div>

          <p>The calculator starts at <strong>1.25 short tons per loose cubic yard</strong> (2,500 lb/yd&sup3;). <a href="https://store.astm.org/c0029_c0029m-23.html" rel="noopener noreferrer">ASTM C29/C29M</a> defines how unit weight is tested in the lab, while published supplier specs vary by moisture and fines (<a href="https://www.gravelshop.com/shop/calculate-cubic-yard-feet-ton.asp?groupid=30&amp;productid=819" rel="noopener noreferrer">2,410 lb/yd&sup3;</a> for 1/2-inch-minus DG up to <a href="https://centraltexasmaterials.com/materials/crushed-granite" rel="noopener noreferrer">2,700 lb/yd&sup3;</a>). Update the density input whenever your quarry provides a scale weight.</p>

          <div class="table-wrap">
            <table class="dg-table">
              <caption>Reference loose DG order quantities at 3 in finished depth (includes 20% compaction buffer at 1.25 t/yd&sup3;)</caption>
              <thead>
                <tr>
                  <th scope="col">Footprint</th>
                  <th scope="col">Finished Volume</th>
                  <th scope="col">Loose Order (+20%)</th>
                  <th scope="col">Short Tons</th>
                  <th scope="col">0.5 cu ft Bags</th>
                </tr>
              </thead>
              <tbody>
                <tr><th scope="row">100 sq ft</th><td>0.93 yd&sup3;</td><td>1.11 yd&sup3;</td><td>1.39 t</td><td>60 bags</td></tr>
                <tr><th scope="row">200 sq ft (10 &times; 20)</th><td>1.85 yd&sup3;</td><td>2.22 yd&sup3;</td><td>2.78 t</td><td>120 bags</td></tr>
                <tr><th scope="row">300 sq ft (30 &times; 10)</th><td>2.78 yd&sup3;</td><td>3.33 yd&sup3;</td><td>4.17 t</td><td>180 bags</td></tr>
                <tr><th scope="row">500 sq ft</th><td>4.63 yd&sup3;</td><td>5.56 yd&sup3;</td><td>6.94 t</td><td>300 bags</td></tr>
              </tbody>
            </table>
          </div>

          <h3>Planning a DG Pathway Installation</h3>
          <p>Follow the specification sheet for your exact product (<a href="https://www.kafkagranite.com/wp-content/uploads/2023/04/Standard_Pathway_Spec.pdf" rel="noopener noreferrer">typical pathway installation guidelines</a> define lift thickness, subbase, and moisture control):</p>
          <ol class="steps-list">
            <li><strong>Set the finished grade:</strong> Excavate for the compacted DG thickness plus any required angular base, sloping slightly (1–2%) away from buildings for runoff.</li>
            <li><strong>Install sturdy edging:</strong> Steel, composite, or concrete bender-board containment keeps compacted path shoulders from raveling into lawn or planted beds.</li>
            <li><strong>Place and moisten in thin lifts:</strong> Spread DG uniformly (2 to 3 inches maximum per lift), lightly water until evenly damp—not muddy—before compacting.</li>
            <li><strong>Compact mechanically:</strong> Make 3–4 passes with a vibratory plate compactor, then re-check grade stakes and top up low depressions before final rolling.</li>
          </ol>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Decomposed Granite</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </article>

    <TopicClusterNav />
  </main>

  <Footer />

  <script>
    function updateDG() {
      const dimsBtn = document.getElementById('dg-mode-dims');
      const sqftBtn = document.getElementById('dg-mode-sqft');
      const revBtn = document.getElementById('dg-mode-reverse');
      const dimsGroup = document.getElementById('dg-dims-group');
      const sqftGroup = document.getElementById('dg-sqft-group');
      const revGroup = document.getElementById('dg-reverse-group');
      const roundingWrap = document.getElementById('dg-rounding-wrap');

      const lengthInput = document.getElementById('dg-length') as HTMLInputElement | null;
      const widthInput = document.getElementById('dg-width') as HTMLInputElement | null;
      const areaInput = document.getElementById('dg-area') as HTMLInputElement | null;
      const revQtyInput = document.getElementById('dg-reverse-qty') as HTMLInputElement | null;
      const revUnitSelect = document.getElementById('dg-reverse-unit') as HTMLSelectElement | null;
      const depthInput = document.getElementById('dg-depth') as HTMLInputElement | null;
      const extraInput = document.getElementById('dg-compaction') as HTMLInputElement | null;
      const densityInput = document.getElementById('dg-density') as HTMLInputElement | null;
      const roundingSelect = document.getElementById('dg-rounding') as HTMLSelectElement | null;

      let activeMode: 'dims' | 'sqft' | 'reverse' = 'dims';

      function readPos(el: HTMLInputElement | null, min: number, max = Infinity): number {
        if (!el || el.value.trim() === '') {
          el?.setAttribute('aria-invalid', 'true');
          return NaN;
        }
        const v = Number(el.value);
        const ok = Number.isFinite(v) && v >= min && v <= max;
        el.setAttribute('aria-invalid', String(!ok));
        return ok ? v : NaN;
      }

      function render() {
        const headingEl = document.getElementById('dg-results-heading');
        const pEl = document.getElementById('kpi-dg-primary');
        const pLabelEl = document.getElementById('label-dg-primary');
        const looseEl = document.getElementById('kpi-dg-loose');
        const tEl = document.getElementById('kpi-dg-tons');
        const tLabelEl = document.getElementById('label-dg-tons');
        const densEl = document.getElementById('kpi-dg-density');
        const bEl = document.getElementById('kpi-dg-bags');
        const bLabelEl = document.getElementById('label-dg-bags');
        const bSubEl = document.getElementById('kpi-dg-bags-sub');
        const fEl = document.getElementById('kpi-dg-fourth');
        const fLabelEl = document.getElementById('label-dg-fourth');
        const fSubEl = document.getElementById('kpi-dg-fourth-sub');
        const errorEl = document.getElementById('dg-input-error');

        const d = readPos(depthInput, 0.5, 12);
        const extra = readPos(extraInput, 0, 50);
        const density = readPos(densityInput, 0.3, 3);

        if (activeMode === 'reverse') {
          lengthInput?.removeAttribute('aria-invalid');
          widthInput?.removeAttribute('aria-invalid');
          areaInput?.removeAttribute('aria-invalid');
          const qty = readPos(revQtyInput, 0.05);
          const unit = revUnitSelect?.value || 'yards';
          const valid = [qty, d, extra, density].every(Number.isFinite);
          if (errorEl) errorEl.hidden = valid;
          if (headingEl) headingEl.textContent = 'Coverage Yield from DG Stock';
          if (pLabelEl) pLabelEl.textContent = 'Planned Coverage (Sq Ft)';
          if (tLabelEl) tLabelEl.textContent = 'Bulk Volume (Cubic Yards)';
          if (bLabelEl) bLabelEl.textContent = 'Estimated Weight (Short Tons)';
          if (fLabelEl) fLabelEl.textContent = '0.5 cu ft Bag Equivalent';

          if (!valid) {
            [pEl, tEl, bEl, fEl].forEach(el => { if (el) el.textContent = '—'; });
            if (looseEl) looseEl.textContent = 'Check inputs';
            if (densEl) densEl.textContent = '—';
            if (bSubEl) bSubEl.textContent = '—';
            if (fSubEl) fSubEl.textContent = '—';
            return;
          }

          let yards = qty;
          if (unit === 'tons') yards = qty / density;
          if (unit === 'bags') yards = (qty * 0.5) / 27;

          const totalCuFt = yards * 27;
          const rawArea = (yards * 324) / d;
          const plannedArea = rawArea / (1 + extra / 100);
          const tons = yards * density;
          const bags = totalCuFt > 0 ? Math.ceil(totalCuFt / 0.5 - 1e-10) : 0;

          if (pEl) pEl.textContent = Math.round(plannedArea).toLocaleString();
          if (looseEl) looseEl.textContent = `${Math.round(rawArea).toLocaleString()} sq ft max before ${extra}% extra`;
          if (tEl) tEl.textContent = yards.toFixed(2);
          if (densEl) densEl.textContent = `${totalCuFt.toFixed(1)} cu ft total volume`;
          if (bEl) bEl.textContent = tons.toFixed(2);
          if (bSubEl) bSubEl.textContent = `At ${density.toFixed(2)} short t/yd³`;
          if (fEl) fEl.textContent = bags.toLocaleString();
          if (fSubEl) fSubEl.textContent = `At ${d} in compacted depth`;
          return;
        }

        let area = NaN;
        if (activeMode === 'dims') {
          areaInput?.removeAttribute('aria-invalid');
          const l = readPos(lengthInput, 0.1);
          const w = readPos(widthInput, 0.1);
          area = l * w;
        } else {
          lengthInput?.removeAttribute('aria-invalid');
          widthInput?.removeAttribute('aria-invalid');
          area = readPos(areaInput, 1);
        }
        revQtyInput?.removeAttribute('aria-invalid');

        const valid = [area, d, extra, density].every(Number.isFinite) && area > 0;
        if (errorEl) errorEl.hidden = valid;
        if (headingEl) headingEl.textContent = 'Required Material Totals';
        if (pLabelEl) pLabelEl.textContent = 'Order Volume (Cubic Yards)';
        if (tLabelEl) tLabelEl.textContent = 'Estimated Weight (Short Tons)';
        if (bLabelEl) bLabelEl.textContent = '0.5 cu ft Bags';
        if (bSubEl) bSubEl.textContent = '54 bags per cubic yard';
        if (fLabelEl) fLabelEl.textContent = 'Covered Surface Area';
        if (fSubEl) fSubEl.textContent = `At ${d || 3} in target compacted depth`;

        if (!valid) {
          [pEl, tEl, bEl, fEl].forEach(el => { if (el) el.textContent = '—'; });
          if (looseEl) looseEl.textContent = 'Check inputs';
          if (densEl) densEl.textContent = '—';
          return;
        }

        const netYards = (area * d) / 324;
        const rawOrderYards = netYards * (1 + extra / 100);
        const inc = parseFloat(roundingSelect?.value || '0') || 0;
        const orderYards = inc > 0 ? Math.ceil(rawOrderYards / inc - 1e-10) * inc : rawOrderYards;
        const tons = orderYards * density;
        const rawCuFt = rawOrderYards * 27;
        const bags = rawCuFt > 0 ? Math.ceil(rawCuFt / 0.5 - 1e-10) : 0;

        if (pEl) pEl.textContent = orderYards.toFixed(2);
        if (looseEl) looseEl.textContent = inc > 0
          ? `Raw order: ${rawOrderYards.toFixed(2)} yd³ (${extra}% allowance)`
          : `Includes ${extra}% extra (${netYards.toFixed(2)} yd³ finished)`;
        if (tEl) tEl.textContent = tons.toFixed(2);
        if (densEl) densEl.textContent = `At ${density.toFixed(2)} t/yd³ loose density`;
        if (bEl) bEl.textContent = bags.toLocaleString();
        if (fEl) fEl.textContent = `${Math.round(area).toLocaleString()} sq ft`;
      }

      function setMode(mode: 'dims' | 'sqft' | 'reverse') {
        activeMode = mode;
        const items: [HTMLElement | null, boolean][] = [
          [dimsBtn, mode === 'dims'],
          [sqftBtn, mode === 'sqft'],
          [revBtn, mode === 'reverse']
        ];
        items.forEach(([el, active]) => {
          el?.classList.toggle('active', active);
          el?.setAttribute('aria-pressed', String(active));
        });
        if (dimsGroup) dimsGroup.style.display = mode === 'dims' ? '' : 'none';
        if (sqftGroup) sqftGroup.style.display = mode === 'sqft' ? '' : 'none';
        if (revGroup) revGroup.style.display = mode === 'reverse' ? '' : 'none';
        if (roundingWrap) roundingWrap.style.display = mode === 'reverse' ? 'none' : '';
        render();
      }

      dimsBtn?.addEventListener('click', () => setMode('dims'));
      sqftBtn?.addEventListener('click', () => setMode('sqft'));
      revBtn?.addEventListener('click', () => setMode('reverse'));

      ['dg-length', 'dg-width', 'dg-area', 'dg-reverse-qty', 'dg-depth', 'dg-compaction', 'dg-density'].forEach(id => {
        document.getElementById(id)?.addEventListener('input', render);
      });
      ['dg-reverse-unit', 'dg-rounding'].forEach(id => {
        document.getElementById(id)?.addEventListener('change', render);
      });

      render();
    }
    updateDG();
  </script>
</BaseLayout>

