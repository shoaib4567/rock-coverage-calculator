---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Decomposed Granite Calculator', url: '/decomposed-granite-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Decomposed Granite (DG)' },
  { label: 'Particle Caliper', value: '1/4" Minus with Granite Fines' },
  { label: 'Loose Density Preset', value: '1.25 short t/yd³ (editable)' },
  { label: 'Order Allowance', value: '20% starting estimate (editable)' }
];

const quickStats = [
  { value: '1/4" Minus', label: 'Gradation', desc: 'Crushed granite blended with natural mineral rock flour' },
  { value: '1.25 t/yd³', label: 'Loose Density Preset', desc: 'Planning estimate of 2,500 lb/yd³; verify with your supplier' },
  { value: '20% Extra', label: 'Order Allowance', desc: 'Adjust for your product and finished depth' }
];

const faqItems = [
  {
    q: 'How much decomposed granite do I need for a 10x20 foot patio?',
    a: 'A 10x20 foot patio is 200 square feet. At a 3-inch finished depth, the geometric volume is 1.85 cubic yards. With the calculator’s editable 20% order allowance, plan for 2.22 loose cubic yards. At the editable 1.25-short-ton-per-yard planning density, that is about 2.78 short tons. Confirm the density and allowance for the DG you buy.'
  },
  {
    q: 'What is the difference between standard DG and stabilized DG?',
    a: 'Standard decomposed granite is natural crushed stone with fines that packs firmly when watered and tamped. Stabilized DG includes a blended organic or polymer binding agent that hardens like soft sandstone, preventing mud tracking and erosive rain runoff on sloped paths.'
  },
  {
    q: 'How deep should decomposed granite be installed for pathways?',
    a: 'For pedestrian garden walkways, install decomposed granite at a finished compacted depth of 2.0 to 3.0 inches over a firm subgrade. For vehicular driveways, install a 2-inch DG wearing course over a 4-inch compacted crushed stone base.'
  },
  {
    q: 'Can decomposed granite be installed without a plate compactor?',
    a: 'No. Hand tamping or foot walking does not generate sufficient downward pressure to pack the granite fines into the void spaces. Always use a gas-powered vibratory plate compactor, moistening the DG in thin 1.5-inch lifts to achieve a rock-hard, non-shifting surface.'
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'How Much Rock Do I Need? (Intent Hub)', slug: '/how-much-rock-do-i-need', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Crushed Granite Calculator', slug: '/crushed-granite-calculator', badge: '1.40 t/yd³' },
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: '1.40 t/yd³' },
  { title: 'Landscape Stone Calculator', slug: '/landscape-stone-calculator', badge: '1.40 t/yd³' }
];

const bridgeLinks = [
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Square Foot Calculator', slug: '/rock-square-foot-calculator', badge: 'Sq Ft' },
  { title: 'Rock Coverage Calculator Yard', slug: '/rock-coverage-calculator-yard', badge: 'Volume' }
];

const supportGuides = [
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech' },
  { title: 'How Deep Should Rock Be?', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="Decomposed Granite Calculator"
  metaDescription="Estimate cubic yards and short tons of decomposed granite for paths and patios. Adjust finished depth, loose bulk density, and extra material before ordering."
  canonicalPath="/decomposed-granite-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Decomposed Granite Calculator",
      "url": "https://rockcoveragecalculator.com/decomposed-granite-calculator",
      "description": "Calculates decomposed granite volume, compaction allowances, and quarry scale tons for pathways and patios.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Landscape Contractors, Masons, Homeowners, Civil Estimators"
      },
      "about": {
        "@type": "Thing",
        "name": "Decomposed Granite"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Decomposed Granite Calculator"
      highlightWord="Calculator"
      badge="Pathways & Compacted Patio Engine"
      subtitle="Estimate cubic yards and short tons for a finished DG path or patio. Adjust the loose density and extra material to match your supplier’s product."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <!-- Specialized Decomposed Granite Interactive Calculator -->
    <section class="section">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h3>Decomposed Granite Dimensions</h3>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="dg-length">Length (Feet)</label>
              <input type="number" id="dg-length" value="30" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="dg-width">Width (Feet)</label>
              <input type="number" id="dg-width" value="10" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="dg-depth">Target Compacted Depth (Inches)</label>
              <input type="number" id="dg-depth" value="3.0" min="1" max="12" step="0.5" />
            </div>
            <div class="input-field">
              <label for="dg-compaction">Extra Material for Ordering (%)</label>
              <input type="number" id="dg-compaction" value="20" min="0" max="50" step="1" />
            </div>
            <div class="input-field">
              <label for="dg-density">Loose Bulk Density (Short Tons/Yard³)</label>
              <input type="number" id="dg-density" value="1.25" min="0.3" max="3" step="0.01" inputmode="decimal" aria-describedby="dg-density-hint" />
              <small id="dg-density-hint">Use your supplier’s tons per loose cubic yard when available.</small>
            </div>
          </div>
          <p id="dg-input-error" class="calc-error" role="alert" hidden>Enter positive dimensions, 0–50% extra material, and a loose density from 0.3 to 3 short tons per cubic yard.</p>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h3>Required Material Totals</h3>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
              <div class="kpi-value" id="kpi-dg-yards">0.00</div>
              <div class="kpi-label">Order Volume (Cubic Yards)</div>
              <div class="kpi-subtext" id="kpi-dg-loose">Includes 20% extra material</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-dg-tons">0.00</div>
              <div class="kpi-label">Estimated Weight (Short Tons)</div>
              <div class="kpi-subtext" id="kpi-dg-density">At 1.25 t/yd³ loose density</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-dg-bags">0</div>
              <div class="kpi-label">0.5 cu ft Bags</div>
              <div class="kpi-subtext">54 bags per cubic yard</div>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide on Decomposed Granite -->
    <article class="content-guide-section">
      <div class="container">

        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="Decomposed Granite Sizing Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">Decomposed Granite Sizing Reference</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Finished Layer Volume</span>
              <span class="aeo-quick-value">Yards = (Area [sq ft] × Depth [in]) / 324</span>
              <p class="aeo-quick-desc">The geometric space occupied by the target finished layer.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Order Allowance</span>
              <span class="aeo-quick-value">Order Yards = Finished Yards × 1.20</span>
              <p class="aeo-quick-desc">The default adds 20% of finished volume. Enter a different allowance for your product and site.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Bulk Density</span>
              <span class="aeo-quick-value">1.25 t/yd³ (2,500 lb/yd³)</span>
              <p class="aeo-quick-desc">Editable loose-density planning preset. ASTM C29 is a test method, not a prescribed DG density.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Standard Depth</span>
              <span class="aeo-quick-value">2" Path | 3" Patio | 4" Drive</span>
              <p class="aeo-quick-desc">Always compact in thin 1.5-inch moist lifts with a plate tamper or heavy hand tamper.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>Engineering Mechanics of Decomposed Granite</h2>
          <p>
            <strong>Decomposed Granite (DG)</strong> is natural granitic rock that has weathered through geological time to the point where it fractures easily into a mixture of small stone flakes (up to 1/4 inch) and microscopic rock flour.
          </p>
          <p>
            Unlike washed crushed granite stone, DG includes fine particles as well as small angular grains. Moistening and compacting a suitable product can form a firmer walking surface. Drainage, erosion resistance, and installation steps depend on the DG gradation, stabilizer, base, and site slope.
          </p>

          <div class="formula-box">
            <code>Target Compacted Volume (yd³) = [Area (sq ft) × Finished Depth (in)] / 324</code>
            <br />
            <code>Estimated Loose Order (yd³) = Finished Volume × (1 + Extra Material % ÷ 100)</code>
            <br />
            <code>Estimated Short Tons = Loose Order (yd³) × Entered Loose Density (short t/yd³)</code>
          </div>

          <p>The calculator starts at <strong>1.25 short tons per loose cubic yard</strong>, or 2,500 lb/yd³. It is a planning estimate, not a value set by <a href="https://store.astm.org/c0029_c0029m-23.html" rel="noopener noreferrer">ASTM C29/C29M</a>. That standard describes how to measure aggregate bulk density. Published seller figures show why the density is editable: <a href="https://www.gravelshop.com/shop/calculate-cubic-yard-feet-ton.asp?groupid=30&amp;productid=819" rel="noopener noreferrer">Gravelshop lists one ½-inch-minus DG at 2,410 lb/yd³</a>, while <a href="https://www.outdoorwarehousesupply.com/product/decomposed-granite/" rel="noopener noreferrer">Outdoor Warehouse Supply lists its ¼-inch-minus DG at 2,700–3,000 lb/yd³</a>. Ask your supplier for the loose conversion and product-specific installation guidance before ordering.</p>

          <h3>Planning a DG Pathway Installation</h3>
          <ol class="steps-list">
            <li>
              <strong>Set the finished grade:</strong> Mark the path edges and finished elevation, then excavate enough for the DG layer and any base your site requires. Keep the surface graded so water does not collect against a building.
            </li>
            <li>
              <strong>Check the subgrade:</strong> Firm up soft or wet spots before placing material. Use a separation fabric only when the soil and base design call for one; follow the fabric maker's overlap and anchoring directions.
            </li>
            <li>
              <strong>Place manageable lifts:</strong> Spread the DG at the thickness recommended for your product and compactor. Some stabilized blends have their own mixing and moisture instructions.
            </li>
            <li>
              <strong>Compact as specified:</strong> Follow the product and equipment guidance for moisture, passes, and finished thickness. Check the grade after compacting rather than assuming a fixed percentage of volume loss.
            </li>
            <li>
              <strong>Finish and remeasure:</strong> Add material to low areas, compact again as needed, and measure the finished layer at several points. Keep loose DG from spilling into drains or planting beds.
            </li>
          </ol>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Decomposed Granite</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </article>

    <TopicClusterNav
      currentPage="/decomposed-granite-calculator"
      category="material"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateDG() {
      const lengthInput = document.getElementById('dg-length') as HTMLInputElement | null;
      const widthInput = document.getElementById('dg-width') as HTMLInputElement | null;
      const depthInput = document.getElementById('dg-depth') as HTMLInputElement | null;
      const extraInput = document.getElementById('dg-compaction') as HTMLInputElement | null;
      const densityInput = document.getElementById('dg-density') as HTMLInputElement | null;
      if (!lengthInput || !widthInput || !depthInput || !extraInput || !densityInput) return;

      const yEl = document.getElementById('kpi-dg-yards');
      const tEl = document.getElementById('kpi-dg-tons');
      const bEl = document.getElementById('kpi-dg-bags');
      const errorEl = document.getElementById('dg-input-error');
      const valid = [lengthInput, widthInput, depthInput, extraInput, densityInput]
        .every(input => input.value !== '' && input.checkValidity());
      if (errorEl) errorEl.hidden = valid;
      if (!valid) {
        if (yEl) yEl.textContent = '—';
        if (tEl) tEl.textContent = '—';
        if (bEl) bEl.textContent = '—';
        return;
      }

      const l = Number(lengthInput.value);
      const w = Number(widthInput.value);
      const d = Number(depthInput.value);
      const extra = Number(extraInput.value);
      const density = Number(densityInput.value);

      const netYards = (l * w * d) / 324;
      const orderYards = netYards * (1 + extra / 100);
      const tons = orderYards * density;
      const bags = Math.ceil(orderYards * 54);

      if (yEl) yEl.textContent = orderYards.toFixed(2);
      if (tEl) tEl.textContent = tons.toFixed(2);
      if (bEl) bEl.textContent = bags.toLocaleString();
      const extraEl = document.getElementById('kpi-dg-loose');
      const densityEl = document.getElementById('kpi-dg-density');
      if (extraEl) extraEl.textContent = `Includes ${extra}% extra material`;
      if (densityEl) densityEl.textContent = `At ${density.toFixed(2)} t/yd³ loose density`;
    }

    ['dg-length', 'dg-width', 'dg-depth', 'dg-compaction', 'dg-density'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateDG);
    });
    updateDG();
  </script>
</BaseLayout>

<style>
  .section {
    padding: var(--space-8) 0;
  }

  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }

  .aeo-quick-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--accent-gold);
  }

  .aeo-quick-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .aeo-quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .aeo-quick-item {
    background: var(--bg-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .aeo-quick-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-gold);
    margin-bottom: 2px;
  }

  .aeo-quick-value {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .aeo-quick-desc {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.35;
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .steps-list {
    padding-left: var(--space-6);
    margin: var(--space-4) 0;
  }

  .steps-list li {
    margin-bottom: var(--space-3);
  }

  .faq-card {
    margin-top: var(--space-8);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .faq-item h3 {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .faq-item p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }
</style>
