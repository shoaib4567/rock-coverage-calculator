---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
const email = 'rockcoveragecalculator@gmail.com';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }];
---
<BaseLayout title="Contact | Rock Coverage Calculator" description="Email Rock Coverage Calculator with a calculation question, correction, or website issue. Include the page and the inputs you used." canonicalPath="/contact">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'ContactPage',
      name: 'Contact Rock Coverage Calculator', url: 'https://rockcoveragecalculator.com/contact',
      mainEntity: { '@type': 'Organization', name: 'Rock Coverage Calculator',
        url: 'https://rockcoveragecalculator.com', email }
    })} />
  </Fragment>
  <Header />
  <main id="main-content">
    <PageHero title="Contact Rock Coverage Calculator" highlightWord="Contact" badge="Questions and corrections" subtitle="Send a calculation question, report a problem, or suggest an improvement." breadcrumbs={breadcrumbs} />
    <article class="contact-content container">
      <section class="contact-card" aria-labelledby="email-title">
        <h2 id="email-title">Email your question</h2>
        <p><a href={'mailto:' + email} class="email-link">{email}</a></p>
        <p>The email link opens your email app. Write and send your message there. If no app opens, copy the address into your email service.</p>
        <a href={'mailto:' + email + '?subject=Rock%20Coverage%20Calculator%20question'} class="btn btn-primary">Open email app</a>
      </section>
      <section aria-labelledby="details-title">
        <h2 id="details-title">What to include</h2>
        <ul>
          <li>The page address and the result you are asking about.</li>
          <li>Your measurements, units, selected material, density, and extra allowance.</li>
          <li>What you expected to see and what the calculator showed.</li>
          <li>For a product correction, a supplier link or bag label with the stated weight or volume.</li>
        </ul>
        <p>Supplier values can vary by product, grading, and moisture. See <a href="/about#engineering-standards">our formulas and assumptions</a> for how the estimates work.</p>
      </section>
      <section aria-labelledby="scope-title">
        <h2 id="scope-title">Project-specific questions</h2>
        <p>These tools estimate material quantities. Ask your supplier about product weight, bag yield, availability, and delivery. Ask a qualified local professional about structural, drainage, or accessibility requirements for your site.</p>
        <p>See our <a href="/privacy">privacy policy</a> and <a href="/terms">terms of use</a>.</p>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
<style>
  .contact-content { max-width: 860px; padding-block: var(--space-12); }
  .contact-content section { margin-bottom: var(--space-10); }
  .contact-content h2 { color: var(--color-text-heading); margin-bottom: var(--space-4); }
  .contact-content p, .contact-content li { line-height: 1.7; margin-bottom: var(--space-3); }
  .contact-content ul { padding-left: var(--space-6); }
  .contact-card { padding: var(--space-6); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .email-link { overflow-wrap: anywhere; }
  .contact-content a:not(.btn) { text-decoration: underline; }
</style>
