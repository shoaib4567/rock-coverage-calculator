---
import TopicClusterNav from '../components/TopicClusterNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const email = 'rockcoveragecalculator@gmail.com';
const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact' }];
---

<BaseLayout title="Contact | Rock Coverage Calculator" description="Email Rock Coverage Calculator with a calculation question, correction, or website issue. Include the page and the inputs you used." canonicalPath="/contact" hideAds>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: 'Contact Rock Coverage Calculator',
      url: 'https://rockcoveragecalculator.com/contact',
      description: 'Direct email channel for calculation corrections, supplier density links, bug reports, and accessibility feedback.',
      inLanguage: 'en'
    })} />
  </Fragment>

  <Header />
  <main id="main-content">
    <PageHero title="Contact Rock Coverage Calculator" highlightWord="Contact" badge="Questions and corrections" subtitle="Send a calculation question, supplier label correction, or technical issue." breadcrumbs={breadcrumbs} />
    <article class="contact-content container">
      <section class="contact-card" aria-labelledby="email-title">
        <h2 id="email-title">Email the editorial team</h2>
        <p><a href={'mailto:' + email} class="email-link">{email}</a></p>
        <p>Messages are read directly by the site maintainer when reviewing feedback; response timing depends on inbox volume. Use the email button below or copy the address into your mail service.</p>
        <a href={'mailto:' + email + '?subject=Rock%20Coverage%20Calculator%20question'} class="btn btn-primary">Open email app</a>
      </section>

      <section aria-labelledby="details-title">
        <h2 id="details-title">Helpful details to include</h2>
        <ul>
          <li>The page URL and the calculator result or table row you are asking about.</li>
          <li>Your entered measurements, depth, material selection, supplier weight, and extra percentage.</li>
          <li>What you expected to calculate and what the page displayed.</li>
          <li>For product density or bag-yield updates, a quarry sheet or bag label photo/link with the stated weight and volume.</li>
        </ul>
        <p>Bulk weight varies by gradation, moisture, and mineral source. Review <a href="/about#engineering-standards">our formulas and assumptions</a> or check the <a href="/rock-density-chart">density reference chart</a> for baseline conversion math.</p>
      </section>

      <section aria-labelledby="scope-title">
        <h2 id="scope-title">Project, privacy &amp; policy inquiries</h2>
        <p>Our tools estimate material volume and approximate weights. Contact your local quarry or landscape yard regarding current pricing, loose vs. scale weight, stock availability, and dump-truck clearance. Consult a qualified civil engineer or contractor for structural base design, drainage permits, or accessibility specifications.</p>
        <p>You can also email the address above for privacy inquiries, advertising-disclosure questions, broken-link reports, or feedback on embedded calculator behavior. Review our <a href="/privacy">privacy policy</a> and <a href="/terms">terms of use</a> before submitting sensitive project details.</p>
      </section>
    </article>
    <TopicClusterNav />
  </main>
  <Footer />
</BaseLayout>

<style>
  .contact-content { max-width: 860px; padding-block: var(--space-12); }
  .contact-content section { margin-bottom: var(--space-10); }
  .contact-content h2 { color: var(--color-text-heading); margin-bottom: var(--space-4); }
  .contact-content p, .contact-content li { line-height: 1.7; margin-bottom: var(--space-3); color: var(--text-secondary); }
  .contact-content ul { padding-left: var(--space-6); }
  .contact-card { padding: var(--space-6); background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .email-link { overflow-wrap: anywhere; font-weight: 700; color: var(--accent-gold); }
  .contact-content a:not(.btn) { color: var(--accent-gold); text-decoration: underline; }
</style>
