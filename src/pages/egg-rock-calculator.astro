---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Egg Rock Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Landscape Rock Calculator', url: '/landscape-rock-calculator' },
  { name: pageTitle, url: '/egg-rock-calculator' }
];
const entityTags = [
  { label: 'Material', value: 'Rounded egg rock or egg stone' },
  { label: 'Buying units', value: 'Cubic yards, US short tons, or labeled bags' },
  { label: 'Supplier weight example', value: '2,800 lb/cu yd; editable' }
];
const quickStats = [
  { value: '0.93 cu yd', label: '100 sq ft at 3 in', desc: 'Finished volume before any optional extra.' },
  { value: '50 bags', label: '0.5 cu ft each', desc: 'Whole bags for that 100 sq ft example.' },
  { value: '108 sq ft', label: 'Per cu yd at 3 in', desc: 'Geometric yield; appearance depends on stone size.' }
];
const faqItems = [
  {
    q: 'How much egg rock do I need for 100 square feet?',
    a: 'At a 3-inch finished depth, 100 square feet needs 25 cubic feet, or 0.93 cubic yard, before extra. That is 50 bags labeled 0.5 cubic foot. At an example loose bulk weight of 2,800 pounds per cubic yard, the same volume is about 1.30 US short tons. Replace the weight and bag volume with your product details.'
  },
  {
    q: 'How many square feet does a ton of egg rock cover?',
    a: 'At 3 inches deep and an example weight of 2,800 pounds per cubic yard, one US short ton is about 0.71 cubic yard and covers about 77 square feet by volume. A supplier listing 2,400 pounds per cubic yard would yield about 90 square feet at the same depth. Actual visible coverage can change with size, voids, and the bed surface.'
  },
  {
    q: 'How many bags of egg rock are in a cubic yard?',
    a: 'One cubic yard is 27 cubic feet, so it takes 54 bags if each bag holds 0.5 cubic foot. Check the volume printed on the bag; a 50-pound label alone is not enough to calculate a reliable bag count across different stone products.'
  },
  {
    q: 'Is egg rock the same as river rock or Mexican beach pebble?',
    a: 'Egg rock usually describes rounded decorative stone, and sellers do not all use the name the same way. Some group Mexican beach pebbles under egg rock; others sell them separately. Check the actual size, finish, package volume, and supplier weight before substituting products.'
  },
  {
    q: 'Does egg rock need landscape fabric?',
    a: 'A permeable separator can help keep stone and soil apart in some beds. It is optional, and it will not make the surface weed-free: leaves and windblown soil can collect between the rocks. Consider the planting plan, soil, maintenance access, and local conditions before installing it.'
  }
];
const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'Main tool' },
  { title: 'Landscape Rock Calculator', slug: '/landscape-rock-calculator', badge: 'Material hub' }
];
const lateralLinks = [
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: 'Rounded stone family' },
  { title: 'Beach Pebble Calculator', slug: '/beach-pebble-calculator', badge: 'Different finish' },
  { title: 'Garden Rock Calculator', slug: '/garden-rock-calculator', badge: 'Planting context' }
];
const bridgeLinks = [
  { title: 'River Rock Coverage Calculator', slug: '/river-rock-coverage-calculator', badge: 'Area from supply' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Buying choice' },
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Supplier weights' }
];
const supportGuides = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Layer depth' },
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Site preparation' },
  { title: 'Angular vs Rounded Rock', slug: '/angular-vs-rounded-rock', badge: 'Stone behavior' }
];
---

<BaseLayout
  title={pageTitle}
  metaDescription="Estimate egg rock cubic yards, US short tons, and whole bags from area and depth. Adjust supplier weight, bag volume, and allowance; compare grades and practical uses."
  canonicalPath="/egg-rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/egg-rock-calculator',
      description: 'Estimates rounded egg rock bed volume, supplier-specific bulk weight, and whole bags by labeled volume.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question', name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Calculator"
      badge="Rounded landscape stone planner"
      subtitle="For 100 sq ft of egg rock at a 3 in finished depth, plan 25 cu ft (0.93 cu yd) before extra. That is 50 half-cubic-foot bags, or about 1.30 US short tons at the editable 2,800 lb/cu yd supplier example."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="decorative"
    />

    <section class="egg-tool" id="calculator" aria-labelledby="egg-tool-title">
      <div class="container">
        <div class="egg-heading">
          <div><p class="egg-kicker">Measure the bed</p><h2 id="egg-tool-title">Turn your finished layer into an order</h2></div>
          <p>Measure the space inside the edging and choose the depth you want after spreading. The tool keeps volume, supplier weight, and bag volume separate so you can match the product you actually buy.</p>
        </div>
        <div class="egg-tool-grid">
          <div class="egg-panel egg-inputs">
            <fieldset class="egg-modes">
              <legend>How do you know the area?</legend>
              <label><input type="radio" name="egg-mode" value="dimensions" checked /> Length × width</label>
              <label><input type="radio" name="egg-mode" value="area" /> Total square feet</label>
            </fieldset>
            <div class="egg-fields" id="egg-dimensions-fields">
              <div class="egg-field"><label for="egg-length">Length <span>(ft)</span></label><input id="egg-length" type="number" value="20" min="0.01" step="any" inputmode="decimal" /></div>
              <div class="egg-field"><label for="egg-width">Width <span>(ft)</span></label><input id="egg-width" type="number" value="5" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="egg-fields" id="egg-area-fields" hidden>
              <div class="egg-field"><label for="egg-area">Stone area <span>(sq ft)</span></label><input id="egg-area" type="number" value="100" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="egg-fields">
              <div class="egg-field"><label for="egg-depth">Finished depth <span>(in)</span></label><input id="egg-depth" type="number" value="3" min="0.25" max="12" step="any" inputmode="decimal" /></div>
              <div class="egg-field"><label for="egg-extra">Optional order extra <span>(%)</span></label><input id="egg-extra" type="number" value="0" min="0" max="100" step="any" inputmode="decimal" aria-describedby="egg-extra-help" /></div>
            </div>
            <p class="egg-help" id="egg-extra-help">Add extra only for measured low spots, spillage, or another site reason. It is not an automatic compaction factor.</p>
            <div class="egg-input-divider"></div>
            <div class="egg-fields">
              <div class="egg-field"><label for="egg-density">Supplier loose bulk weight <span>(lb/cu yd)</span></label><input id="egg-density" type="number" value="2800" min="100" max="10000" step="any" inputmode="decimal" aria-describedby="egg-density-help" /></div>
              <div class="egg-field"><label for="egg-bag">Volume printed on bag <span>(cu ft)</span></label><input id="egg-bag" type="number" value="0.5" min="0.01" max="100" step="any" inputmode="decimal" aria-describedby="egg-bag-help" /></div>
            </div>
            <p class="egg-help" id="egg-density-help">2,800 lb/cu yd is one egg rock supplier's listed figure. A different product lists about 2,400.</p>
            <p class="egg-help" id="egg-bag-help">The 0.5-cu-ft example matches one retail egg rock listing. Bag count uses volume, not a presumed 50-lb weight.</p>
            <p class="egg-error" id="egg-error" role="status" aria-live="polite"></p>
          </div>
          <div class="egg-panel egg-results">
            <p class="egg-kicker">Your measured layer</p>
            <div class="egg-primary"><output id="egg-finished-yards">0.93</output><span>cu yd installed</span></div>
            <p class="egg-result-help"><output id="egg-finished-feet">25.00</output> cu ft before optional extra</p>
            <div class="egg-result-grid">
              <div><span>Bulk order volume</span><strong><output id="egg-order-yards">0.93</output> cu yd</strong></div>
              <div><span>Estimated US short tons</span><strong><output id="egg-order-tons">1.30</output> tons</strong></div>
              <div><span>Whole retail bags</span><strong><output id="egg-order-bags">50</output> bags</strong></div>
              <div><span>One ton covers at this depth</span><strong><output id="egg-ton-coverage">77</output> sq ft</strong></div>
            </div>
            <p class="egg-result-help" id="egg-result-context">Based on 100 sq ft, 3 in, 2,800 lb/cu yd, and 0.5 cu ft per bag. Bulk sellers may round to available order increments.</p>
            <p class="visually-hidden" id="egg-result-summary" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </section>

    <article class="egg-guide">
      <div class="container">
        <section class="egg-feature" aria-labelledby="egg-example-title">
          <div>
            <p class="egg-kicker">The worked example</p>
            <h2 id="egg-example-title">What a 100-square-foot result means</h2>
            <p>A 20 × 5 ft bed is 100 sq ft. At 3 in deep, the finished layer occupies <strong>25 cu ft</strong> (100 × 3 ÷ 12), or <strong>0.93 cu yd</strong>. With no optional extra, 25 ÷ 0.5 means <strong>50 bags</strong> labeled half a cubic foot. At <a href="https://mainslandscapesupply.com/product/egg-rock/">Main's example weight of 2,800 lb per cubic yard</a>, 0.93 yard is about <strong>2,593 lb, or 1.30 US short tons</strong>. Your supplier's weight changes the tons; it does not change the geometric volume.</p>
            <div class="egg-formula" aria-label="Egg rock calculation formulas">
              <p><strong>Finished cu ft</strong> = area (sq ft) × depth (in) ÷ 12</p>
              <p><strong>Order cu yd</strong> = finished cu ft × (1 + optional extra ÷ 100) ÷ 27</p>
              <p><strong>US short tons</strong> = order cu yd × supplier lb/cu yd ÷ 2,000</p>
            </div>
          </div>
          <figure class="egg-figure">
            <div class="egg-figure-scroll" tabindex="0" aria-label="Scroll egg rock layer diagram"><img src="/egg-rock-layer-and-order.svg" width="760" height="490" loading="lazy" alt="A 20 by 5 foot egg rock bed at 3 inches deep has a 25 cubic foot layer; a separate order step converts that volume to supplier tons or labeled bags." /></div>
            <figcaption>Measure the rock layer, then convert the volume using the supplier's unit. <span>Swipe to see the full diagram on a narrow screen.</span></figcaption>
          </figure>
        </section>

        <section class="egg-card" aria-labelledby="egg-grade-title">
          <h2 id="egg-grade-title">Choose the stone before choosing its depth</h2>
          <p>“Egg rock” describes a rounded appearance, not a uniform national gradation. <a href="https://mainslandscapesupply.com/product/egg-rock/">Main's lists a 1–3 in rounded grade</a>, while a <a href="https://www.lowes.com/pd/American-Countryside-0-5-cu-ft-Egg-Rock/50409166">Lowe's bag lists stones larger than 3 in</a>. Inspect a sample or product photo with a scale. Larger cobbles leave wider visible gaps at the same depth; a small test patch shows whether the soil or separator appears through the layer.</p>
          <div class="egg-choice-grid">
            <div><h3>Contained accent bed</h3><p>Rounded stone gives a soft edge around a dry creek or planting border. Measure only the area receiving stone, and check the grade against edging height and adjacent pavement.</p></div>
            <div><h3>Walking surface</h3><p>Egg-sized, smooth pieces shift underfoot and do not lock together like angular aggregate. For a regularly used path or accessible route, evaluate a stable surface design instead of assuming a deeper egg rock layer will firm up.</p></div>
            <div><h3>Drainage feature</h3><p>Visible stone can finish a swale or dry stream. A working drain also depends on slope, outlet, filter, and base design. The coverage tool sizes only the visible stone layer, not a French drain or structural base.</p></div>
          </div>
        </section>

        <section class="egg-card" aria-labelledby="egg-yield-title">
          <h2 id="egg-yield-title">See how depth changes the order</h2>
          <p>One cubic yard is 27 cubic feet, so its <em>geometric</em> coverage is 324 divided by depth in inches. The examples below have no extra and use 0.5-cu-ft bags. They are volume equivalents, not promises of visual opacity or a supplier's delivered yield.</p>
          <div class="egg-table-scroll"><table><caption>Egg rock volume for 100 sq ft at three finished depths</caption><thead><tr><th scope="col">Depth</th><th scope="col">Finished cu yd</th><th scope="col">Whole 0.5-cu-ft bags</th><th scope="col">Area per cu yd</th></tr></thead><tbody><tr><th scope="row">2 in</th><td>0.62</td><td>34</td><td>162 sq ft</td></tr><tr><th scope="row">3 in</th><td>0.93</td><td>50</td><td>108 sq ft</td></tr><tr><th scope="row">4 in</th><td>1.23</td><td>67</td><td>81 sq ft</td></tr></tbody></table></div>
           <p>A 3-in layer has 50% more volume than a 2-in layer on the same area. <a href="https://mainslandscapesupply.com/product/egg-rock/">Main's product page</a> also posts a 70-sq-ft coverage figure at 3 in without stating whether that is per ton or per yard; its rounded ton-to-yard shortcut differs slightly from its 2,800-lb/yd³ weight. The table above is volume math, so ask the seller what unit and field allowance its coverage figure uses. Confirm the grade in a sample patch. For a top-up, measure only the missing depth.</p>
        </section>

        <section class="egg-card" aria-labelledby="egg-buy-title">
          <h2 id="egg-buy-title">Match the result to the way your seller quotes</h2>
          <div class="egg-buy-grid">
            <div><h3>Bulk by cubic yard or ton</h3><p><a href="https://cumminlandscapesupply.com/Egg-Rock">Cummin lists roughly 2,400 lb per cubic yard</a> for its 1.5–2 in egg rock. <a href="https://mainslandscapesupply.com/product/egg-rock/">Main's lists 2,800 lb</a> for a 1–3 in grade. Enter the weight from the yard that will supply your stone. Loose stockpiles, grading, and moisture affect a weight conversion; <a href="https://store.astm.org/c0029_c0029m-23.html">ASTM C29/C29M</a> is a method for measuring bulk density, not a universal egg rock weight.</p></div>
            <div><h3>Retail bags or bulk sacks</h3><p>A <a href="https://www.lowes.com/pd/American-Countryside-0-5-cu-ft-Egg-Rock/50409166">retail egg rock listing</a> specifies 0.5 cu ft and 50 lb, while <a href="https://www.lowes.com/pd/Longleaf-Packaging-1-3-Cu-Yd-Bulk-Egg-Rock/1002553768">another product is a 0.33-cu-yd, 900-lb bulk bag</a>. Read the package volume before counting bags. Compare the complete local price including delivery or pickup, and ask about minimums and yard increments; a fixed bag-versus-bulk crossover will not hold for every seller.</p></div>
          </div>
        </section>

        <section class="egg-card" aria-labelledby="egg-site-title">
          <h2 id="egg-site-title">Plan for the bed after installation</h2>
          <div class="egg-site-grid">
            <div><h3>Keep the layer in place</h3><p>Rounded pieces can migrate from a sloped or uncontained bed, especially toward a lawn or walk. Grade the surface and use an edge suited to the site. If runoff crosses the area, address its route rather than treating loose cobbles as the only erosion control.</p></div>
            <div><h3>Keep soil and plants in mind</h3><p><a href="https://yardandgarden.extension.iastate.edu/how-to/using-mulch-garden">Iowa State Extension</a> notes that a separator under rock can keep it from mixing with soil, while windblown organic matter can support weeds above it. Fabric is a site choice, not a weed guarantee. Rock can warm a sunny bed and supplies no organic matter; keep stone off plant stems and tree trunks, and choose mulch that suits the plants.</p></div>
            <div><h3>Maintain the visible surface</h3><p>Remove leaves and soil before they settle into gaps. If the bed contains plants, keep access for watering, weeding, and future changes. <a href="https://gardeningsolutions.ifas.ufl.edu/care/planting/mulch/">UF/IFAS advises limiting rock mulch around garden plants</a> and points to dry creek beds and downspout areas as better uses in its climate.</p></div>
          </div>
        </section>

        <section class="egg-card egg-faq" aria-labelledby="egg-faq-title">
          <h2 id="egg-faq-title">Egg rock questions</h2>
          {faqItems.map(item => <div><h3>{item.q}</h3><p>{item.a}</p></div>)}
        </section>

        <section class="egg-sources" aria-labelledby="egg-sources-title">
          <h2 id="egg-sources-title">Sources and scope</h2>
          <p>Product sizes, bag labels, and supplier weights above come from the linked sellers. For planting and maintenance, see <a href="https://yardandgarden.extension.iastate.edu/how-to/using-mulch-garden">Iowa State Extension</a>, <a href="https://ipm.ucanr.edu/home-and-landscape/weed-management-in-landscapes/">UC IPM</a>, and <a href="https://gardeningsolutions.ifas.ufl.edu/care/planting/mulch/">UF/IFAS</a>. Their climate and plant advice may differ. This tool estimates the volume of a decorative surface layer; confirm local product yield, site design, and delivered quantities with the supplier or installer.</p>
        </section>
      </div>
    </article>

    <TopicClusterNav currentPage="/egg-rock-calculator" category="material" upLinks={upLinks} lateralLinks={lateralLinks} bridgeLinks={bridgeLinks} supportGuides={supportGuides} />
  </main>
  <Footer />

  <script>
    const eggInput = (id) => document.getElementById(id);
    const eggSet = (id, value) => { const node = document.getElementById(id); if (node) node.textContent = value; };
    const eggRead = (id, min, max, active = true) => {
      const field = eggInput(id);
      const number = Number(field.value);
      const valid = !active || (field.value.trim() !== '' && Number.isFinite(number) && number >= min && number <= max);
      field.setAttribute('aria-invalid', String(!valid));
      return valid && active ? number : NaN;
    };
    const eggClear = (ids) => ids.forEach(id => eggSet(id, '—'));
    function updateEggRock() {
      const mode = document.querySelector('input[name="egg-mode"]:checked').value;
      const dimensions = mode === 'dimensions';
      eggInput('egg-dimensions-fields').hidden = !dimensions;
      eggInput('egg-area-fields').hidden = dimensions;
      const length = eggRead('egg-length', 0.01, 100000, dimensions);
      const width = eggRead('egg-width', 0.01, 100000, dimensions);
      const enteredArea = eggRead('egg-area', 0.01, 100000000, !dimensions);
      const area = dimensions ? length * width : enteredArea;
      const depth = eggRead('egg-depth', 0.25, 12);
      const extra = eggRead('egg-extra', 0, 100);
      const density = eggRead('egg-density', 100, 10000);
      const bag = eggRead('egg-bag', 0.01, 100);
      const error = eggInput('egg-error');
      const resultIds = ['egg-finished-yards', 'egg-finished-feet', 'egg-order-yards', 'egg-order-tons', 'egg-order-bags', 'egg-ton-coverage'];
      if (!Number.isFinite(area) || area <= 0 || !Number.isFinite(depth) || !Number.isFinite(extra)) {
        eggClear(resultIds);
        error.textContent = 'Enter a positive area, a 0.25–12 in finished depth, and 0–100% optional extra.';
        eggSet('egg-result-context', 'Correct the highlighted measurement fields to calculate.');
        eggSet('egg-result-summary', 'Egg rock calculation needs valid measurements.');
        return;
      }
      const finishedFeet = area * depth / 12;
      const orderFeet = finishedFeet * (1 + extra / 100);
      const orderYards = orderFeet / 27;
      eggSet('egg-finished-yards', (finishedFeet / 27).toFixed(2));
      eggSet('egg-finished-feet', finishedFeet.toFixed(2));
      eggSet('egg-order-yards', orderYards.toFixed(2));
      const tons = Number.isFinite(density) ? orderYards * density / 2000 : NaN;
      const coverage = Number.isFinite(density) ? 2000 / density * 324 / depth : NaN;
      const bags = Number.isFinite(bag) ? Math.max(1, Math.ceil(orderFeet / bag - 1e-10)) : NaN;
      eggSet('egg-order-tons', Number.isFinite(tons) ? tons.toFixed(2) : '—');
      eggSet('egg-ton-coverage', Number.isFinite(coverage) ? Math.round(coverage).toLocaleString() : '—');
      eggSet('egg-order-bags', Number.isFinite(bags) ? bags.toLocaleString() : '—');
      error.textContent = !Number.isFinite(density) || !Number.isFinite(bag) ? 'Volume is ready. Correct the highlighted supplier weight or bag volume to calculate its separate result.' : '';
      eggSet('egg-result-context', 'Based on ' + area.toLocaleString(undefined, { maximumFractionDigits: 1 }) + ' sq ft, ' + depth + ' in, ' + extra + '% extra, ' + (Number.isFinite(density) ? density.toLocaleString() + ' lb/cu yd' : 'supplier weight needed') + ', and ' + (Number.isFinite(bag) ? bag + ' cu ft per bag.' : 'bag volume needed.'));
      eggSet('egg-result-summary', 'Order ' + orderYards.toFixed(2) + ' cubic yards' + (Number.isFinite(tons) ? ', approximately ' + tons.toFixed(2) + ' US short tons' : '') + (Number.isFinite(bags) ? ', or ' + bags + ' whole bags.' : '.'));
    }
    document.querySelectorAll('#calculator input').forEach(field => field.addEventListener('input', updateEggRock));
    document.querySelectorAll('input[name="egg-mode"]').forEach(field => field.addEventListener('change', updateEggRock));
    updateEggRock();
  </script>
</BaseLayout>

<style>
  .egg-tool { padding: var(--space-10) 0; background: linear-gradient(150deg, rgba(212,168,83,.08), transparent 62%); border-bottom: 1px solid var(--border-subtle); }
  .egg-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-8); align-items: end; margin-bottom: var(--space-6); }
  .egg-heading h2, .egg-guide h2 { color: var(--text-primary); line-height: 1.18; }
  .egg-heading p:last-child { color: var(--text-secondary); line-height: 1.65; margin: 0; }
  .egg-kicker { margin: 0 0 var(--space-2); color: var(--accent-gold); font-size: var(--text-xs); font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .egg-tool-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: var(--space-5); align-items: stretch; }
  .egg-panel, .egg-card, .egg-feature { min-width: 0; background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: 0 12px 35px rgba(0,0,0,.08); }
  .egg-panel { padding: clamp(1rem, 2.5vw, 1.8rem); }
  .egg-modes { border: 0; padding: 0; margin: 0 0 var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .egg-modes legend { margin-bottom: var(--space-2); color: var(--text-primary); font-weight: 700; }
  .egg-modes label { display: inline-flex; align-items: center; gap: .45rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: .55rem .75rem; color: var(--text-secondary); cursor: pointer; }
  .egg-modes input { accent-color: var(--accent-gold); }
  .egg-fields { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: var(--space-4); margin-bottom: var(--space-4); }
  .egg-fields[hidden] { display: none; }
  .egg-field { min-width: 0; }
  .egg-field label { display: block; color: var(--text-primary); font-size: var(--text-sm); font-weight: 700; margin-bottom: .4rem; }
  .egg-field label span { color: var(--text-muted); font-weight: 500; }
  .egg-field input { display: block; width: 100%; min-width: 0; padding: .7rem .8rem; background: var(--bg-surface); color: var(--text-primary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font: inherit; }
  .egg-field input:focus { outline: 2px solid var(--accent-gold); outline-offset: 1px; }
  .egg-field input[aria-invalid="true"] { border-color: #d75c5c; }
  .egg-help { margin: calc(-1 * var(--space-2)) 0 var(--space-4); color: var(--text-muted); font-size: var(--text-xs); line-height: 1.55; }
  .egg-input-divider { border-top: 1px solid var(--border-subtle); margin: var(--space-5) 0; }
