---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Bag Weight & Price Database', url: '/rock-bag-weight-and-price-guide' }
];

const title = "What Bags of Rock Actually Weigh & Cost - Retail Bag Weight & Price Database";
const metaDescription = "Actual scale weights, volumes, and price-per-ton equivalents for 0.5 cu ft bagged rock at Home Depot, Lowe's, and Menards. Vehicle hauling limits and wet moisture data.";

const bagData = [
  {
