---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const title = 'Rock Bag Weight and Price Guide';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: title, url: '/rock-bag-weight-and-price-guide' }
];
const productExamples = [
  {
    product: 'Vigoro Bagged Creek Landscape Rock',
    volume: '0.5 ft³',
    weight: '40 lb',
    url: 'https://www.homedepot.com/p/302985371'
  },
  {
    product: 'EARTHESSENTIALS by QUIKRETE River Rock',
    volume: '0.5 ft³',
    weight: '50 lb',
    url: 'https://www.lowes.com/pd/earthessentials-by-quikrete-0-5-cu-ft-50-lb-multiple-colors-finishes-river-rock/50437590'
  }
];
---

<BaseLayout
  title={title}
  description="Use a rock bag's labeled volume, weight, and local price to calculate bag count, material cost, and a vehicle load that fits its remaining rated payload."
  canonicalPath="/rock-bag-weight-and-price-guide"
>
  <Header />
  <main id="main-content">
    <PageHero
      title={title}
      badge="Buying and hauling bags"
      subtitle="By volume, a 0.5 ft³ bag would cover 2 square feet at a perfectly even 3-inch depth. A product's stated coverage may differ, as will its weight and price. Check the label before comparing the full bag order with a local bulk quote."
      breadcrumbs={breadcrumbs}
      theme="utility"
    />

    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="payload-card">
          <div class="payload-header">
            <div class="payload-title-group">
              <h2>Estimate bags, cost, and trips from your labels</h2>
              <p>Enter planned rock volume after any extra allowance. The starting values are an example, not a store price or vehicle rating.</p>
            </div>
          </div>
          <div class="bag-guide-controls">
            <label>Planned volume <span>(ft³)</span><input id="guide-volume" type="number" min="0.01" step="any" value="50" inputmode="decimal" /></label>
            <label>Bag volume <span>(ft³/bag)</span><input id="guide-bag-volume" type="number" min="0.01" step="any" value="0.5" inputmode="decimal" /></label>
            <label>Price per bag <span>($)</span><input id="guide-price" type="number" min="0" step="0.01" value="5" inputmode="decimal" /></label>
            <label>Weight per bag <span>(lb)</span><input id="guide-weight" type="number" min="0.01" step="any" value="50" inputmode="decimal" /></label>
            <label>Remaining vehicle payload <span>(lb)</span><input id="guide-payload" type="number" min="0" step="any" value="300" inputmode="decimal" /></label>
          </div>
          <div class="payload-result-banner" id="guide-output" aria-live="polite">
            100 bags · $500.00 before tax · up to 6 bags per trip; about 17 trips at this payload.
          </div>
          <p class="bag-guide-note">Use the tire and loading label on your vehicle for the combined occupant and cargo limit. Subtract passengers, tools, and other cargo before entering the remaining payload. <a href="https://www.nhtsa.gov/interpretations/gf004408" target="_blank" rel="noopener noreferrer">NHTSA explains the vehicle capacity label</a>.</p>
        </div>

        <div class="section-header" style="margin-top: var(--space-12);">
          <h2>Why bag weight cannot be inferred from volume</h2>
          <div class="section-divider"></div>
          <p>These retailer listings show two 0.5 ft³ river rock products with different labeled weights. Product sizes, stone types, and packaging vary; check the actual bag before calculating a load.</p>
        </div>
        <div class="bag-table-card">
          <div class="table-responsive">
            <table class="bag-table">
              <caption>Examples from retailer product listings; availability and specifications may change</caption>
              <thead><tr><th scope="col">Product</th><th scope="col">Labeled volume</th><th scope="col">Labeled weight</th><th scope="col">Product listing</th></tr></thead>
              <tbody>
                {productExamples.map((item) => (
                  <tr>
                    <td><strong>{item.product}</strong></td>
                    <td>{item.volume}</td>
                    <td>{item.weight}</td>
                    <td><a href={item.url} target="_blank" rel="noopener noreferrer">Check label</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="editorial-box" style="margin-top: var(--space-12);">
          <h2>Compare prices for the same amount of stone</h2>
          <div class="findings-grid">
            <div class="finding-card">
              <h3>1. Calculate the bag order</h3>
              <p>Divide planned cubic feet by the bag's labeled cubic feet and round up. For a 50 ft³ project, 0.5 ft³ bags give 100 bags. Multiply that whole bag count by the current local price, then include tax or delivery.</p>
            </div>
            <div class="finding-card">
              <h3>2. Ask for a bulk quote</h3>
              <p>Divide the same planned volume by 27 for cubic yards. Ask the yard about its selling increment, minimum order, delivery fee, stone size, and unloading location. If it sells by weight, use its product-specific loose bulk density.</p>
            </div>
            <div class="finding-card">
              <h3>3. Plan how the load arrives</h3>
              <p>Multiply bags per trip by the bag's labeled weight. The vehicle's remaining rated payload sets the upper limit; a full pallet is not automatically safe to carry. If your site is hard to reach, account for hand-carrying loose rock from the drop point.</p>
            </div>
          </div>
          <p class="bag-guide-note">For material-specific estimates, use the <a href="/river-rock-bag-calculator">river rock bag calculator</a>, <a href="/pea-gravel-bag-calculator">pea gravel bag calculator</a>, or <a href="/bulk-vs-bagged-rock">bulk versus bagged rock guide</a>. Current local quotes decide which purchase is cheaper.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  (() => {
    const ids = ['guide-volume', 'guide-bag-volume', 'guide-price', 'guide-weight', 'guide-payload'];
    const inputs = ids.map(id => document.getElementById(id));
    const output = document.getElementById('guide-output');
    const update = () => {
      const [volume, bagVolume, price, weight, payload] = inputs.map(input => Number(input.value));
      if (inputs.some(input => input.value.trim() === '') || !Number.isFinite(volume) || !Number.isFinite(bagVolume) || !Number.isFinite(price) || !Number.isFinite(weight) || !Number.isFinite(payload) || volume <= 0 || bagVolume <= 0 || price < 0 || weight <= 0 || payload < 0) {
        output.textContent = 'Enter positive volume and bag weight, with nonnegative price and remaining payload.';
        return;
      }
      const bags = Math.ceil(volume / bagVolume - 1e-10);
      const perTrip = Math.floor(payload / weight);
      const trips = perTrip > 0 ? Math.ceil(bags / perTrip) : 0;
      const cost = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(bags * price);
      output.textContent = bags.toLocaleString('en-US') + ' bags · ' + cost + ' before tax · ' + (perTrip > 0 ? 'up to ' + perTrip + ' bags per trip; about ' + trips + ' trips at this payload.' : 'remaining payload is less than one bag; arrange another way to move the stone.');
    };
    inputs.forEach(input => input.addEventListener('input', update));
    update();
  })();
</script>
<style>
  .payload-card {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
  }

  .payload-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .payload-header svg {
    color: var(--gold-400);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .payload-title-group h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-1) 0;
  }

  .payload-title-group p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .vehicle-picker-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .vehicle-picker-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .vehicle-picker-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .btn-vehicle {
    background: var(--slate-850);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-align: left;
    cursor: pointer;
    transition: all var(--duration-fast);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .btn-vehicle:hover {
    border-color: var(--gold-400);
    background: var(--slate-800);
  }

  .btn-vehicle.active {
    background: rgba(212, 168, 83, 0.12);
    border-color: var(--gold-400);
  }

  .v-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .v-cap {
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  .v-bags {
    font-size: 1.1rem;
    color: var(--gold-400);
    margin-top: 2px;
    font-family: var(--font-mono);
  }

  .payload-result-banner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .payload-result-banner svg {
    color: #60a5fa;
    flex-shrink: 0;
  }

  .payload-result-banner strong {
    color: var(--text-primary);
  }

  /* Table */
  .bag-table-card {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .bag-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
  }

  .bag-table th {
    background: var(--slate-850);
    padding: var(--space-4);
    color: var(--text-primary);
    font-weight: 600;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .bag-table td {
    padding: var(--space-4);
    border-bottom: 1px solid rgba(107, 122, 141, 0.15);
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .bag-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .weight-cell {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .weight-cell.wet {
    color: #60a5fa;
    font-weight: 600;
  }

  .price-cell {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--gold-400);
  }

  .ton-equiv-cell {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #f87171;
  }

  /* Editorial Box */
  .editorial-box {
    background: var(--slate-900);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .editorial-box > h2 {
    font-size: 1.35rem;
    color: var(--text-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .editorial-box p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .findings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .findings-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .finding-card {
    background: var(--slate-850);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .finding-card h3 {
    font-size: 0.95rem;
    color: var(--gold-400);
    margin: 0 0 var(--space-2) 0;
  }

  .finding-card p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .finding-card strong {
    color: var(--text-primary);
  }
  .bag-guide-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin: 1rem 0; }
  .bag-guide-controls label { display: flex; flex-direction: column; gap: .35rem; font-weight: 700; }
  .bag-guide-controls label span { font-size: .75rem; font-weight: 400; }
  .bag-guide-controls input { width: 100%; padding: .65rem .75rem; border: 1px solid var(--border-subtle); border-radius: .5rem; background: var(--bg-surface); color: var(--text-primary); font: inherit; }
  .bag-guide-note { margin-top: 1rem; line-height: 1.6; }
</style>
