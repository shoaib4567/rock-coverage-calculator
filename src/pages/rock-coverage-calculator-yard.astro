---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import CubicYardCalculator from '../components/calculators/CubicYardCalculator.astro';
import CubicYardVisualizer from '../components/visualizers/CubicYardVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Rock Coverage Calculator Yard', url: '/rock-coverage-calculator-yard' }
];

const entityTags = [
  {
    "label": "Volume unit",
    "value": "1 cubic yard = 27 cubic feet"
  },
  {
    "label": "Forward calculation",
    "value": "Area × inches ÷ 324"
  },
  {
    "label": "Reverse calculation",
    "value": "Yards × 324 ÷ inches"
  },
  {
    "label": "Delivery checks",
    "value": "Usable volume and available payload"
  }
];

const quickStats = [
  {
    "value": "27 cu ft",
    "label": "One cubic yard",
    "desc": "Volume conversion, independent of rock type"
  },
  {
    "value": "108 sq ft",
    "label": "At 3 inches",
    "desc": "Geometric coverage of one cubic yard"
  },
  {
    "value": "Your limits",
    "label": "Delivery estimate",
    "desc": "Use the actual vehicle volume and payload"
  }
];

const faqItems = [
  {
    q: 'How do you calculate cubic yards of rock by hand?',
    a: 'Multiply the length of the area in feet by the width in feet to find total square feet. Next, multiply that area by the depth in inches, and divide the final product by 324. For example, a 20x10 foot area at 3 inches depth is: (20 × 10 × 3) / 324 = 600 / 324 = 1.85 cubic yards.'
  },
  {
    q: 'How much area does 1 cubic yard of rock cover at 2 inches and 3 inches?',
    a: 'At a depth of 2 inches, 1 cubic yard covers exactly 162 square feet. At a depth of 3 inches, 1 cubic yard covers exactly 108 square feet. At 4 inches, it covers 81 square feet.'
  },
  {
    q: 'Why do you divide by 324 when calculating cubic yards of rock?',
    a: 'One cubic yard equals 27 cubic feet. When depth is measured in inches, you must divide depth by 12 to convert it to feet. Combining the two conversion steps: 27 cubic feet multiplied by 12 inches per foot equals 324. Dividing square feet multiplied by inches by 324 directly yields cubic yards.'
  },
  {
    q: 'How many cubic yards of rock can a standard pickup truck carry?',
    a: 'Check the actual vehicle’s remaining rated payload after occupants and other cargo, along with the supplier’s loading policy. Multiply the order volume by the product’s loose weight. A vehicle class name does not establish how much rock it may carry.'
  }
];
---

<BaseLayout
  title="Rock Coverage Calculator Yard - Cubic Yards & Truckload Sizing"
  description="Calculate rock coverage in cubic yards for landscaping, driveways, and gardens. Mathematical derivation, depth-to-coverage tables, and dump truck capacities."
  canonicalPath="/rock-coverage-calculator-yard"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Rock Coverage Calculator Yard",
      "url": "https://rockcoveragecalculator.com/rock-coverage-calculator-yard",
      "description": "Converts rectangular layer dimensions to cubic yards or known yards to coverage, with editable loose bulk weight and delivery limits.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "about": {
        "@type": "Thing",
        "name": "Rock Coverage Yards"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Rock Coverage Calculator Yard"
      highlightWord="Yard"
      badge="Volumetric Conversion & Hauling Capacity"
      subtitle="Convert square footage, radius, or custom irregular area dimensions into exact cubic yards for quarry ordering and bulk dump truck deliveries."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <CubicYardCalculator />

    <CubicYardVisualizer />

    <!-- Technical Guide on Cubic Yard Sizing -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Convert a layer to yards, or yards to a covered area</h2><p>Use the forward mode when you know a rectangular footprint and finished depth. Use reverse mode when a supplier has quoted a volume or you already have material. The calculation treats the layer as uniform; large stones, irregular ground and placement losses can change actual coverage.</p><h3>Forward example: a 40 × 15 ft bed</h3><p>The 600-sq-ft footprint at 3 inches contains <strong>600 × 3 ÷ 324 = 5.56 cubic yards</strong> before extra. A selected 10% order increase gives 6.11 yd³. At the example loose bulk weight of 1.35 US short tons per yard, that order weighs about 8.25 short tons. Changing density changes estimated weight, not geometric volume.</p><div class="formula-box"><code>Net yd³ = area in sq ft × depth in inches ÷ 324</code><br/><code>Order yd³ = net yd³ × (1 + extra percent ÷ 100)</code><br/><code>Estimated short tons = order yd³ × supplier short tons per yd³</code></div><h3>Reverse example: five cubic yards</h3><p>At 3 inches, 5 × 324 ÷ 3 = <strong>540 sq ft</strong>. At 2 inches the same volume geometrically covers 810 sq ft. Reverse mode spreads the entered volume itself and does not add the forward mode’s extra percentage.</p><h3>Read depth comparisons as quantity examples</h3><div class="table-wrapper"><table class="guide-table"><caption>Geometric coverage of one cubic yard; no installation depth is prescribed</caption><thead><tr><th scope="col">Depth</th><th scope="col">Coverage</th></tr></thead><tbody><tr><th scope="row">1 in</th><td>324 sq ft</td></tr><tr><th scope="row">1.5 in</th><td>216 sq ft</td></tr><tr><th scope="row">2 in</th><td>162 sq ft</td></tr><tr><th scope="row">2.5 in</th><td>129.6 sq ft</td></tr><tr><th scope="row">3 in</th><td>108 sq ft</td></tr><tr><th scope="row">4 in</th><td>81 sq ft</td></tr><tr><th scope="row">6 in</th><td>54 sq ft</td></tr></tbody></table></div><p>Choose the depth for the actual product and project. The decimal result at 2.5 inches is 129.6 sq ft per yard. A rounded table value is a display convenience; it does not change the conversion constant.</p><h3>Check both delivery limits</h3><p>Delivery count is the larger of the volume-based and weight-based counts, rounded up. For example, 13 yd³ requires at least two trips in a vehicle with 7 yd³ usable volume, even if its payload could carry the whole order. Actual available payload, product weight, loading policy and site access still need confirmation. A vehicle class name alone cannot establish capacity.</p><p>For order increments and handling, use the <a href="/rock-yardage-calculator">yardage order planner</a>. For known square footage or separate beds, use the <a href="/rock-square-foot-calculator">square-foot calculator</a>. For six footprint shapes, start with the <a href="/">main rock calculator</a>. <a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/" target="_blank" rel="noopener noreferrer">Penn State’s materials calculator</a> explains why finished volume and loose material weight need separate assumptions.</p></div><div class="content-card faq-card"><h2>Questions about this calculation</h2><div class="faq-accordion">{faqItems.map((item,index)=><details class="faq-detail" open={index===0}><summary class="faq-summary">{item.q}</summary><div class="faq-answer"><p>{item.a}</p></div></details>)}</div></div></div></article>

    <TopicClusterNav currentPage="/rock-coverage-calculator-yard" category="quantity" />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .guide-table th, .guide-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-table th {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
  }

  .guide-table tr:hover td {
    background: rgba(212, 168, 83, 0.04);
  }

  .steps-list {
    padding-left: var(--space-6);
    margin: var(--space-4) 0;
  }

  .steps-list li {
    margin-bottom: var(--space-3);
  }

  .faq-detail {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary svg {
    transition: transform var(--transition-fast);
  }

  .faq-detail[open] .faq-summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
