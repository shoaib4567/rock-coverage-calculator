---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import YardageCalculator from '../components/calculators/YardageCalculator.astro';
import YardageVisualizer from '../components/visualizers/YardageVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quantity & Conversion', url: '/rock-coverage-calculator-yard' },
  { name: 'Rock Yardage Calculator', url: '/rock-yardage-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Quarry Yardage Logistics' },
  { label: 'Order Increments', value: 'Half-Yard and Full-Yard Units' },
  { label: 'Safety Margin', value: '10% Compaction and Raking Allowance' },
  { label: 'Delivery Vehicles', value: 'Single-Axle, Tandem, and Tri-Axle Haulers' }
];

const quickStats = [{"value":"Editable extra","label":"Order allowance","desc":"Use the needs of the actual project"},{"value":"Seller increment","label":"Order rounding","desc":"Ask how the supplier sells loose yards"},{"value":"Actual vehicle","label":"Delivery access","desc":"Confirm payload and clearance with the operator"}];

const faqItems = [
  {
    "q": "Is yardage the same as cubic yards?",
    "a": "Yes. The volume unit is the same. This tool adds optional order rounding and handling estimates; the cubic-yard tool focuses on converting area, depth and volume."
  },
  {
    "q": "Should I always add 10%?",
    "a": "No. It is an editable example allowance. Use actual measurements and product-specific placement guidance, and avoid counting the same allowance twice."
  },
  {
    "q": "How many yards can a truck carry?",
    "a": "Ask the supplier for both allowable payload and usable volume for the actual truck. Multiply loose cubic yards by the product’s tons per yard to check weight; do not infer capacity solely from axle count."
  },
  {
    "q": "Can plywood protect a driveway from any delivery truck?",
    "a": "No. Plywood is not a structural assessment. Agree on a suitable delivery location with the operator before the truck arrives."
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Rock Coverage Calculator Yard (Pure Volume)', slug: '/rock-coverage-calculator-yard', badge: 'Volume' },
  { title: 'Rock Tons Calculator (Quarry Weight)', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Bag Calculator (Retail Bags)', slug: '/rock-bag-calculator', badge: 'Bags' }
];

const bridgeLinks = [
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: 'Gravel' },
  { title: 'Crusher Run Calculator', slug: '/crusher-run-calculator', badge: 'Road Base' },
  { title: 'Crushed Stone Yardage Calculator', slug: '/crushed-stone-yardage-calculator', badge: 'Delivery Sizing' }
];

const supportGuides = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: 'How Deep Should Rock Be?', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="Rock Yardage Calculator - Dump Truck Loads & Quarry Logistics"
  description="Calculate exact yardage of rock needed for landscape beds and driveways. Field-tested quarry ordering rules, dump truck clearances, and wheelbarrow sizing."
  canonicalPath="/rock-yardage-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Rock Yardage Calculator",
      "url": "https://rockcoveragecalculator.com/rock-yardage-calculator",
      "description": "Calculates commercial rock yardage requirements, quarry order buffers, and dump truck site delivery logistics.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Landscape Contractors, Estimators, Homeowners, Dump Truck Haulers"
      },
      "about": {
        "@type": "Thing",
        "name": "Dump Truck Capacity and Aggregate Yardage Procurement"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Rock Yardage Calculator"
      highlightWord="Calculator"
      badge="Quarry Procurement & Site Logistics"
      subtitle="Plan a bulk-yard order with optional extra, seller increments and handling estimates."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <YardageCalculator />

    <YardageVisualizer />

    <!-- Technical Guide on Yardage Procurement -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Turn measured volume into a supplier order</h2><p>This tool focuses on optional extra material, seller yard increments and moving a bulk load. For a direct forward or reverse volume conversion, use the <a href="/rock-coverage-calculator-yard">cubic-yard calculator</a>. A cubic yard is 27 cubic feet; it is not a fixed weight or a guaranteed truckload.</p><h2>Keep three quantities separate</h2><ol><li>Finished layer: area × depth in inches ÷ 324.</li><li>Loose order: apply only the allowance appropriate to the material and job.</li><li>Supplier order: round to the increment the actual seller uses.</li></ol><p>For 200 sq ft at 3 inches, the measured volume is 1.85 yd³. Selecting 10% extra gives 2.04 yd³. A seller using half-yard increments would round that to 2.5 yd³. Another seller may accept a different amount; confirm before buying.</p><h2>Ask about delivery rather than assuming a truck size</h2><p>Payload depends on the particular vehicle, loading policy and route limits. Bed capacity also matters. A truck can reach its allowable weight before its bed is full. Truck classes and example loads in this tool are planning illustrations; request the supplier’s actual tons-per-load figure and access requirements.</p><p>Agree on the unloading location, turning space, ground conditions and overhead obstructions with the supplier. A blanket clearance number or plywood sheet cannot establish whether a loaded truck can safely enter or tip on your property. Follow the delivery operator’s site assessment.</p><h2>Plan hand movement separately</h2><p>Wheelbarrow runs depend on usable tray volume and how much weight the person and route can manage. Divide the order’s cubic feet by the practical volume per trip, rounding up. Do not assume every tray is carried full. Include any difficult gates, stairs, slopes and carry distances in the delivery plan.</p><p>The <a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/">Penn State materials calculator</a> distinguishes loose shipped quantity from finished depth. Check <a href="/bulk-vs-bagged-rock">bulk versus bagged cost</a> if multiple small orders or difficult access affect the decision.</p><h2>Questions before ordering</h2>{faqItems.map(item=><section><h3>{item.q}</h3><p>{item.a}</p></section>)}</div></div></article>

    <TopicClusterNav 
      currentPage="/rock-yardage-calculator" 
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }

  .aeo-quick-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--accent-gold);
  }

  .aeo-quick-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .aeo-quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .aeo-quick-item {
    background: var(--bg-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .aeo-quick-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-gold);
    margin-bottom: 2px;
  }

  .aeo-quick-value {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .aeo-quick-desc {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.35;
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .guide-table th, .guide-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-table th {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
  }

  .guide-table tr:hover td {
    background: rgba(212, 168, 83, 0.04);
  }

  .steps-list {
    padding-left: var(--space-6);
    margin: var(--space-4) 0;
  }

  .steps-list li {
    margin-bottom: var(--space-3);
  }

  .faq-detail {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary svg {
    transition: transform var(--transition-fast);
  }

  .faq-detail[open] .faq-summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
