---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Landscape Rock Calculator', url: '/landscape-rock-calculator' },
  { name: 'Garden Rock Calculator', url: '/garden-rock-calculator' }
];

const entityTags = [
  { label: 'Use', value: 'Planted beds and garden borders' },
  { label: 'Measure', value: 'Net area × finished depth' },
  { label: 'Order by', value: 'Cubic yard, short ton, or bag volume' },
  { label: 'Plant care', value: 'Keep rock clear of crowns and stems' }
];

const quickStats = [
  { value: '108 sq ft', label: 'Per cubic yard at 3 in', desc: 'Geometric coverage before an optional site allowance' },
  { value: 'Editable', label: 'Supplier weight', desc: 'The local product controls the tons estimate' },
  { value: 'By volume', label: 'Bag count', desc: 'Use the cubic feet printed on the bag' }
];

const faqItems = [
  {
    q: 'How much garden rock do I need for a 240 square foot bed?',
    a: 'At a measured 3-inch layer, 240 square feet needs 60 cubic feet, or 2.22 cubic yards, before any site allowance. At an example supplier weight of 2,700 pounds per cubic yard, that is about 3.00 US short tons. A labeled 0.5-cubic-foot bag would take 120 bags. Change the depth, supplier weight, and bag volume to match your project.'
  },
  {
    q: 'Should I subtract planting holes from the rock area?',
    a: 'Subtract large areas that will remain completely bare, such as a planting island, large planter, path, or patio inset. Small openings around individual stems often make little difference to a bulk order, but leave the finished rock pulled back from every crown and trunk.'
  },
  {
    q: 'Is fabric required under rock in a flower bed?',
    a: 'No single fabric detail suits every bed. Permeable landscape fabric can separate stone from soil and suppress some existing weeds, but windblown soil and seeds can still collect above it. It also complicates adding plants. Avoid impermeable plastic over roots and decide based on the bed, soil, and future planting plan.'
  },
  {
    q: 'Is garden rock better than wood mulch around plants?',
    a: 'Small gravel can help water soak in and reduce evaporation in some dry landscapes; larger decorative stone mainly changes the appearance of a bed. Rock can transfer heat into soil, while wood chips insulate and add organic matter as they break down. Match the cover to plant needs, climate, and maintenance, then keep either material away from stems.'
  },
  {
    q: 'Can I estimate bags from the weight printed on a bag?',
    a: 'Use the labeled cubic-foot volume for coverage. A 50-pound bag does not establish a universal volume because rock type and packing vary. If only weight is given, ask the seller for bag yield or volume before using a bag count.'
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'Main tool' },
  { title: 'Landscape Rock Calculator', slug: '/landscape-rock-calculator', badge: 'Material hub' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'Planning' }
];

const lateralLinks = [
  { title: 'Egg Rock Calculator', slug: '/egg-rock-calculator', badge: 'Rounded stone' },
  { title: 'Beach Pebble Calculator', slug: '/beach-pebble-calculator', badge: 'Pebbles' },
  { title: 'Pea Gravel Calculator', slug: '/pea-gravel-calculator', badge: 'Small stone' },
  { title: 'Lava Rock Calculator', slug: '/lava-rock-calculator', badge: 'Lightweight rock' }
];

const bridgeLinks = [
  { title: 'Rock vs Mulch Calculator', slug: '/rock-vs-mulch-calculator', badge: 'Compare covers' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'Retail bags' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' }
];

const supportGuides = [
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Installation' },
  { title: 'How to Stop Weeds in Landscape Rock', slug: '/how-to-stop-weeds-in-landscape-rock', badge: 'Upkeep' },
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Weights' }
];
---

<BaseLayout
  title="Garden Rock Calculator"
  metaDescription="Estimate garden bed rock in cubic yards, short tons, and bags. Subtract uncovered areas, enter your supplier's weight and bag volume, and plan around living plants."
  canonicalPath="/garden-rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Garden Rock Calculator",
      "url": "https://rockcoveragecalculator.com/garden-rock-calculator",
      "description": "Estimates garden rock for planted beds from net area, layer depth, supplier weight, and labeled bag volume.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Garden Rock Calculator"
      highlightWord="Garden Rock"
      badge="Planted bed quantity planner"
      subtitle="A 240-square-foot bed at 3 inches takes 2.22 cubic yards of rock before extra material. Enter your bed and the product you can buy to see tons and bags too."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <section class="garden-intro" aria-label="Garden rock planning overview">
      <div class="garden-wrap intro-grid">
        <p><strong>Measure the surface the rock will actually cover.</strong> Multiply area by finished depth to get cubic feet, then divide by 27 for cubic yards. Subtract large bare planting pockets or hardscape first. The calculator below uses an editable local weight for tons and the bag's labeled cubic feet for whole bags.</p>
        <a class="intro-jump" href="#calculator">Plan my garden bed <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="section garden-calculator" id="calculator" aria-labelledby="garden-calc-heading">
      <div class="container">
        <div class="section-header">
          <h2 id="garden-calc-heading">Estimate rock for your planted bed</h2>
          <div class="section-divider"></div>
          <p>Start with a material example, then replace its depth and supplier weight with the values for your bed.</p>
        </div>

        <div class="calc-wrapper">
          <div class="calc-panel">
            <div class="calc-panel-title"><h3>Bed and product details</h3></div>
            <div class="input-field">
              <label for="garden-rock-type">Rock example</label>
              <select id="garden-rock-type" class="garden-select">
                <option value="river" selected>Rounded river pebble</option>
                <option value="pea">Pea gravel</option>
                <option value="lava">Lava rock</option>
                <option value="other">Other garden stone</option>
              </select>
              <p class="field-help">A selection fills example depth and weight; your supplier's product takes priority.</p>
            </div>

            <div class="mode-tabs" role="group" aria-label="Area measurement method">
              <button type="button" class="tab-btn active" id="tab-dims" aria-pressed="true" aria-controls="dims-subgrid">Length × width</button>
              <button type="button" class="tab-btn" id="tab-sqft" aria-pressed="false" aria-controls="sqft-subgrid">Known area</button>
            </div>
            <div id="dims-subgrid" class="garden-grid">
              <div class="input-field">
                <label for="garden-length">Bed length (ft)</label>
                <input type="number" id="garden-length" value="30" min="0.1" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="garden-width">Average width (ft)</label>
                <input type="number" id="garden-width" value="8" min="0.1" step="any" inputmode="decimal" />
              </div>
            </div>
            <div id="sqft-subgrid" class="garden-grid" hidden>
              <div class="input-field">
                <label for="garden-area">Measured bed area (sq ft)</label>
                <input type="number" id="garden-area" value="240" min="0.1" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="garden-grid">
              <div class="input-field">
                <label for="garden-openings">Area left bare (sq ft)</label>
                <input type="number" id="garden-openings" value="0" min="0" step="any" inputmode="decimal" />
                <p class="field-help">Subtract large planting islands or paving, not soil beneath the rock.</p>
              </div>
              <div class="input-field">
                <label for="garden-depth">Finished rock depth (in)</label>
                <input type="number" id="garden-depth" value="3" min="0.5" max="12" step="any" inputmode="decimal" />
                <p class="field-help" id="garden-depth-hint">3 in is a planning example; confirm the visual coverage you want.</p>
              </div>
              <div class="input-field">
                <label for="garden-density">Supplier weight (lb per yd³)</label>
                <input type="number" id="garden-density" value="2700" min="1" step="any" inputmode="decimal" />
                <p class="field-help">Example only; ask the yard for its loose bulk weight.</p>
              </div>
              <div class="input-field">
                <label for="garden-bag-volume">Bag volume (ft³ per bag)</label>
                <input type="number" id="garden-bag-volume" value="0.5" min="0.01" step="any" inputmode="decimal" />
                <p class="field-help">Use volume on the bag label, even when it also lists pounds.</p>
              </div>
              <div class="input-field">
                <label for="garden-extra">Optional site allowance (%)</label>
                <input type="number" id="garden-extra" value="0" min="0" max="25" step="any" inputmode="decimal" />
                <p class="field-help">Add only for measured uneven ground, spillage, or another job-specific reason.</p>
              </div>
            </div>
            <p class="garden-error" id="garden-error" role="status" aria-live="polite" hidden></p>
          </div>

          <div class="calc-results-panel" aria-live="polite">
            <div class="calc-panel-title"><h3>Material estimate</h3></div>
            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <div class="kpi-value" id="res-garden-yards">2.22</div>
                <div class="kpi-label">Cubic yards to plan</div>
                <div class="kpi-subtext">Includes chosen site allowance</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="res-garden-tons">3.00</div>
                <div class="kpi-label">US short tons</div>
                <div class="kpi-subtext">Based on editable supplier weight</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="res-garden-bags">120</div>
                <div class="kpi-label">Whole bags</div>
                <div class="kpi-subtext">Based on labeled bag volume</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="res-garden-sqft">240</div>
                <div class="kpi-label">Rock-covered area (sq ft)</div>
                <div class="kpi-subtext">After bare-area subtraction</div>
              </div>
            </div>
            <p class="result-detail" id="garden-volume-detail">60.00 ft³ installed; 60.00 ft³ planned.</p>
            <div class="purchase-card">
              <div class="purchase-content">
                <div class="purchase-title">Before you buy</div>
                <p class="purchase-desc" id="garden-purchase-advice">Compare the delivered bulk quote with 120 labeled 0.5-ft³ bags, including fees and pickup effort.</p>
              </div>
            </div>
            <p class="formula-note"><strong>How it works:</strong> (covered sq ft × depth in ÷ 12) × (1 + allowance %) = planned ft³. Divide by 27 for yd³, multiply by supplier lb/yd³ and divide by 2,000 for US short tons. Divide planned ft³ by labeled bag ft³ and round up for whole bags.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="garden-guide">
      <div class="garden-wrap">
        <div class="guide-lede">
          <span class="guide-eyebrow">Measure first</span>
          <h2>Count the rock surface, then protect the living bed</h2>
          <p>A flower bed is rarely a perfect rectangle. Break curved borders into short sections, measure an average width for each, and add their areas. Subtract sizable spaces you will leave uncovered. Keep stems and plant crowns visible when you spread the stone.</p>
        </div>

         <figure class="garden-figure" tabindex="0" role="region" aria-label="Scrollable garden bed measurement diagram">
          <img src="/garden-rock-bed-plan.svg" width="900" height="380" loading="lazy" decoding="async" alt="Top view of a 20 by 6 foot garden bed with a 2 by 2 foot uncovered planting island. The rock area is 116 square feet." />
           <figcaption>Worked measurement: 20 × 6 ft bed minus a 2 × 2 ft bare island leaves 116 sq ft of rock surface. Swipe or scroll sideways on a narrow screen to see the full diagram.</figcaption>
        </figure>

        <div class="worked-example">
          <h3>Worked example: a bed with an uncovered planting island</h3>
          <ol>
            <li><strong>Net area:</strong> (20 × 6) − (2 × 2) = 116 sq ft.</li>
            <li><strong>Installed volume at 2.5 in:</strong> 116 × 2.5 ÷ 12 = 24.17 ft³ = 0.90 yd³.</li>
            <li><strong>With no added allowance:</strong> an example 2,700 lb/yd³ river pebble is about 1.21 US short tons, or 49 whole 0.5-ft³ bags.</li>
          </ol>
          <p>If you need a site allowance, apply it to the measured volume before converting to supplier units. A yard that sells in half-yard steps may round the final order differently.</p>
        </div>

        <h2>Choose the surface for the plants, not just the color</h2>
        <div class="choice-grid">
          <div class="choice-card">
            <h3>Where stone fits</h3>
             <p>Small gravel can work as mulch in some dry landscapes, supporting water infiltration and reducing evaporation. Larger cobbles are chiefly a visual surface: their open gaps can expose soil and catch leaf litter. Choose a stone size that fits both the plants and future maintenance.</p>
          </div>
          <div class="choice-card">
            <h3>Where organic mulch may fit better</h3>
             <p>In densely planted or frequently replanted beds, bark or wood chips are easier to move and add organic matter as they break down. Colorado State University Extension notes that gravel can warm soil beneath it, while wood chips insulate against temperature swings. The useful choice depends on plant, climate, and stone size.</p>
          </div>
        </div>
         <p class="source-note">Planting guidance: <a href="https://extension.colostate.edu/resource/mulching/">Colorado State University Extension's mulching guide</a> and <a href="https://extension.psu.edu/planting-ornamentals">Penn State Extension planting ornamentals guidance</a>.</p>

        <h2>Depth and weight are separate decisions</h2>
        <p>Choose a finished depth that hides the soil to your eye without burying plants. Stone size, contrast with the soil, and expected movement all affect that choice; no one depth is correct for every garden. Depth sets cubic yards. Product weight changes only the estimated tons, so replace the example weight when your supplier gives one.</p>
        <div class="garden-table-wrap">
          <table>
            <caption>Illustrative garden rock settings; each supplier and bed can differ</caption>
            <thead><tr><th>Material example</th><th>Planning depth</th><th>Example loose weight</th><th>Check before ordering</th></tr></thead>
            <tbody>
              <tr><th scope="row">Rounded river pebble</th><td>3 in</td><td>2,700 lb/yd³</td><td>Local size, color, and weight</td></tr>
              <tr><th scope="row">Pea gravel</th><td>2 in</td><td>2,700 lb/yd³</td><td>Movement at bed edges</td></tr>
              <tr><th scope="row">Lava rock</th><td>2.5 in</td><td>1,500 lb/yd³</td><td>Product size and fragile pieces</td></tr>
            </tbody>
          </table>
        </div>
         <p class="source-note">Weight examples come from Hello Gravel's separate <a href="https://hellogravel.com/products/river-rock/">river rock</a> and <a href="https://hellogravel.com/products/38-natural-pea-gravel/">pea gravel</a> listings, plus <a href="https://www.kentuckylawncare.com/product/lava-rock-bulk-landscape-material/">Kentucky Lawn Care's one-yard lava rock listing</a>. They are product examples, not standard densities.</p>

        <h2>Fabric, irrigation, and future maintenance</h2>
        <div class="care-steps">
           <div><span>01</span><h3>Prepare the planting soil</h3><p>Finish soil amendments and irrigation layout before covering the bed. Fabric guidance differs by planting context: CSU discourages weed fabric under mulch in planted landscapes; if you use a permeable separator, check water and air access and leave room to maintain plants. Avoid solid plastic over roots.</p></div>
          <div><span>02</span><h3>Leave breathing room</h3><p>Pull stone back a few inches from trunks and stems; keep crowns exposed. Check irrigation reaches the soil below the rock, especially in sunny beds where stone can add heat.</p></div>
          <div><span>03</span><h3>Plan to remove debris</h3><p>Fabric can separate soil and rock, but it cannot stop all future weeds: dust, leaves, and seed collect among stones. Clear debris before it forms a rooting layer, and expect some hand weeding.</p></div>
        </div>
         <p class="source-note">See <a href="https://extension.colostate.edu/resource/mulching/">CSU Extension on mulch and barriers</a>, <a href="https://extension.usu.edu/yardandgarden/research/using-mulches-in-utah-landscapes-and-gardens">Utah State University Extension on permeable fabric</a>, <a href="https://extension.oregonstate.edu/catalog/em-9125-conserving-water-your-yard-garden">Oregon State University Extension on stem clearance</a>, and <a href="https://extension.psu.edu/planting-ornamentals">Penn State Extension on weeds above fabric</a>.</p>

        <h2>Buying bags or ordering bulk</h2>
        <p>The bag result uses volume, then rounds up; the tons result uses the editable supplier weight. They are two ways to buy the same planned volume, not quantities to add together. For a small top-up, check the package's cubic feet. A <a href="https://www.homedepot.com/p/100558618">Vigoro river-pebble bag lists 0.5 ft³ and 50 lb</a>, but other rock bags can differ. For a larger bed, compare the complete delivered bulk quote with bags, including delivery, loading, and your ability to place the material.</p>

        <h2>Garden rock questions</h2>
        <div class="faq-list">
          {faqItems.map(item => (
            <div class="faq-item">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/garden-rock-calculator"
      category="material"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>
  <Footer />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const $ = (id) => document.getElementById(id);
      const controls = {
        type: $('garden-rock-type'), length: $('garden-length'), width: $('garden-width'),
        area: $('garden-area'), openings: $('garden-openings'), depth: $('garden-depth'),
        density: $('garden-density'), bag: $('garden-bag-volume'), extra: $('garden-extra')
      };
      const results = {
        yards: $('res-garden-yards'), tons: $('res-garden-tons'), bags: $('res-garden-bags'),
        sqft: $('res-garden-sqft'), detail: $('garden-volume-detail'),
        advice: $('garden-purchase-advice'), error: $('garden-error')
      };
      const presets = {
        river: { depth: 3, density: 2700, note: '3 in is a planning example; confirm the visual coverage you want.' },
        pea: { depth: 2, density: 2700, note: '2 in is a planning example; check movement at bed edges.' },
        lava: { depth: 2.5, density: 1500, note: '2.5 in is a planning example; check your product and visible coverage.' }
      };
      let mode = 'dimensions';

      function setMode(next) {
        mode = next;
        $('dims-subgrid').hidden = next !== 'dimensions';
        $('sqft-subgrid').hidden = next !== 'area';
        $('tab-dims').classList.toggle('active', next === 'dimensions');
        $('tab-sqft').classList.toggle('active', next === 'area');
        $('tab-dims').setAttribute('aria-pressed', String(next === 'dimensions'));
        $('tab-sqft').setAttribute('aria-pressed', String(next === 'area'));
        calculate();
      }
      $('tab-dims').addEventListener('click', () => setMode('dimensions'));
      $('tab-sqft').addEventListener('click', () => setMode('area'));

      controls.type.addEventListener('change', () => {
        const preset = presets[controls.type.value];
        if (preset) {
          controls.depth.value = String(preset.depth);
          controls.density.value = String(preset.density);
          $('garden-depth-hint').textContent = preset.note;
        } else {
          $('garden-depth-hint').textContent = 'Enter a depth that achieves the finish you want.';
        }
        calculate();
      });

      function read(input, min, max) {
        const value = Number(input.value);
        const valid = input.value.trim() !== '' && Number.isFinite(value) && value >= min && value <= max;
        input.setAttribute('aria-invalid', String(!valid));
        return valid ? value : null;
      }
      function clearInactiveErrors() {
        (mode === 'dimensions' ? controls.area : controls.length).setAttribute('aria-invalid', 'false');
        if (mode === 'area') controls.width.setAttribute('aria-invalid', 'false');
      }
      function emptyResults(message) {
        [results.yards, results.tons, results.bags, results.sqft].forEach(node => { node.textContent = '—'; });
        results.detail.textContent = 'Enter valid measurements to see a material estimate.';
        results.advice.textContent = 'Check the marked fields before comparing buying options.';
        results.error.textContent = message;
        results.error.hidden = false;
      }
      function calculate() {
        const length = mode === 'dimensions' ? read(controls.length, 0.1, 100000) : null;
        const width = mode === 'dimensions' ? read(controls.width, 0.1, 100000) : null;
        const areaInput = mode === 'area' ? read(controls.area, 0.1, 100000000) : null;
        clearInactiveErrors();
        const openings = read(controls.openings, 0, 100000000);
        const depth = read(controls.depth, 0.5, 12);
        const density = read(controls.density, 1, 100000);
        const bag = read(controls.bag, 0.01, 1000);
        const extra = read(controls.extra, 0, 25);
        const gross = mode === 'dimensions' && length !== null && width !== null ? length * width : areaInput;
        if (gross === null || openings === null || depth === null || extra === null) {
          emptyResults('Enter positive bed dimensions, a valid depth, and an allowance from 0–25%.');
          return;
        }
        if (openings >= gross) {
          controls.openings.setAttribute('aria-invalid', 'true');
          emptyResults('Area left bare must be smaller than the measured bed area.');
          return;
        }
        controls.openings.setAttribute('aria-invalid', 'false');
        const netArea = gross - openings;
        const installedFeet = netArea * depth / 12;
        const plannedFeet = installedFeet * (1 + extra / 100);
        const yards = plannedFeet / 27;
        const shortTons = density === null ? null : yards * density / 2000;
        const wholeBags = bag === null ? null : Math.max(1, Math.ceil(plannedFeet / bag - 1e-9));
        results.yards.textContent = yards.toFixed(2);
        results.tons.textContent = shortTons === null ? '—' : shortTons.toFixed(2);
        results.bags.textContent = wholeBags === null ? '—' : wholeBags.toLocaleString();
        results.sqft.textContent = netArea.toLocaleString(undefined, { maximumFractionDigits: 2 });
        results.detail.textContent = installedFeet.toFixed(2) + ' ft³ installed; ' + plannedFeet.toFixed(2) + ' ft³ planned.';
        results.error.hidden = shortTons !== null && wholeBags !== null;
        results.error.textContent = results.error.hidden ? '' : 'Volume is ready. Correct the highlighted supplier weight or bag volume for its separate result.';
        results.advice.textContent = 'Ask for a delivered quote for ' + yards.toFixed(2) + ' yd³' + (shortTons === null ? '' : ' (about ' + shortTons.toFixed(2) + ' short tons)') + (wholeBags === null ? '.' : '; compare it with ' + wholeBags.toLocaleString() + ' labeled ' + bag.toLocaleString() + '-ft³ bags.');
      }
      Object.values(controls).forEach(control => {
        if (control !== controls.type) control.addEventListener('input', calculate);
      });
      calculate();
    });
  </script>
</BaseLayout>

<style>
  .garden-wrap { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }
  .garden-intro { border-bottom: 1px solid var(--border-subtle); background: var(--bg-surface); }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.5rem; align-items: center; padding-block: 1.25rem; }
  .intro-grid p { margin: 0; line-height: 1.65; color: var(--text-secondary); }
  .intro-grid strong { color: var(--text-primary); }
  .intro-jump { display: inline-flex; align-items: center; gap: .5rem; padding: .75rem 1rem; border: 1px solid var(--accent-gold); border-radius: var(--radius-md); color: var(--accent-gold); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .garden-calculator { scroll-margin-top: 4rem; }
