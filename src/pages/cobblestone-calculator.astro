---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Calculator from '../components/Calculator.astro';
import Visualizer from '../components/Visualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Material Calculators', url: '/landscape-rock-calculator' },
  { name: 'Cobblestone Calculator', url: '/cobblestone-calculator' }
];

const entityTags = [
  { label: 'Primary Entity', value: 'Cobblestone' },
  { label: 'Standard Dimensions', value: 'Belgian Block (4x4x4" & 5x5x9")' },
  { label: 'Bulk Density', value: '1.45 Tons/yd³ (2,900 lbs)' },
  { label: 'Unit Calculation', value: 'Square Feet & Piece Counts' }
];

const quickStats = [
  { value: '9 Pieces', label: 'Cubes per Sq Ft', desc: 'Standard 4" × 4" × 4" granite cobblestones including joints' },
  { value: '31 lbs', label: 'Regulation Block Weight', desc: 'Average weight of individual 5" × 5" × 9" Belgian stone' },
  { value: '100 Linear Ft', label: 'Curbing Calculation', desc: 'Requires 133 regulation blocks laid end-to-end' }
];

const faqItems = [
  {
    q: 'How many 4x4 inch cobblestones do I need for 100 square feet?',
    a: 'For 100 square feet paved with standard 4" × 4" × 4" granite cobblestone cubes (with a 3/8-inch joint allowance), you need approximately 900 individual blocks. Factoring in a 7% cutting and sorting allowance for fractured pieces, order 965 blocks, which weigh approximately 4.3 tons.'
  },
  {
    q: 'What is the difference between Belgian block and cobblestone?',
    a: 'Historically, true cobblestones were naturally rounded river rocks collected from stream beds. Today in North American construction, the terms are used interchangeably, with "Belgian block" specifically designating hand-split rectangular granite blocks quarried with rough textured faces.'
  },
  {
    q: 'How many jumbo Belgian blocks do I need for 50 linear feet of driveway edging?',
    a: 'Jumbo blocks measure 4" × 7" × 10". When laid end-to-end as a 4-inch wide driveway border with 1/2-inch mortar joints, each block covers 10.5 inches of run. For 50 linear feet (600 inches), you need approximately 58 jumbo blocks, weighing roughly 1.2 tons.'
  },
  {
    q: 'What type of bedding base is required beneath cobblestone pavers?',
    a: 'Driveway cobblestone aprons require an 8-inch compacted sub-base of dense graded crushed stone (quarry process / #411 limestone), followed by a 1-inch setting bed of coarse concrete sand or a 2-inch semi-dry mortar bed. Never set heavy vehicle cobblestone directly on organic dirt.'
  }
];
---

<BaseLayout
  title="Cobblestone Calculator - Belgian Block & Granite Cobble Unit Counts"
  description="Calculate exact unit piece counts, square footage coverage, and tonnage for Belgian blocks, granite cobblestones, and driveway border edging."
  canonicalPath="/cobblestone-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Cobblestone Calculator",
      "url": "https://rockcoveragecalculator.com/cobblestone-calculator",
      "description": "Calculates cobblestone piece counts, linear curbing requirements, and bulk tonnage for Belgian blocks and granite pavers.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "about": {
        "@type": "Thing",
        "name": "Cobblestone"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Cobblestone Calculator"
      highlightWord="Calculator"
      badge="Belgian Block & Unit Paving Engine"
      subtitle="Accurate piece counts, linear edging quantities, and weight calculations for authentic hand-split granite Belgian blocks and decorative cobblestones."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <Calculator 
      initialMaterial="crushed-granite" 
      initialDepth={4} 
      headline="Cobblestone & Belgian Block Calculator"
      subtitle="Calculate paving area, driveway curbing runs, and quarry pallet requirements."
    />

    <Visualizer />

    <!-- Technical Guide on Cobblestones & Belgian Block -->
    <article class="content-guide-section">
      <div class="container">
        <div class="content-card">
          <h2>Standard Belgian Block Dimensional Specifications</h2>
          <p>
            Unlike loose aggregate materials that are poured and raked to depth, cobblestones and Belgian blocks are discrete, hand-split natural granite units. Estimating cobblestone requires two distinct mathematical approaches: <strong>Piece Count Geometry</strong> for paved coursing or linear borders, and <strong>Volumetric Tonnage</strong> for quarry freight shipping.
          </p>

          <div class="block-types-grid">
            <div class="block-card">
              <div class="block-badge">Cubes</div>
              <h3>Standard Cube</h3>
              <div class="block-dim">Dimensions: 4" × 4" × 4"</div>
              <p>Ideal for fan pattern coursing, decorative courtyard rings, and pedestrian garden walkways. Extremely versatile for tight radii curves.</p>
              <div class="block-spec">9.0 pieces / sq ft | 9 lbs / piece</div>
            </div>
            <div class="block-card active-block">
              <div class="block-badge featured">Standard</div>
              <h3>Regulation Belgian Block</h3>
              <div class="block-dim">Dimensions: 5" × 5" × 9"</div>
              <p>The standard choice for residential driveway aprons and raised garden border curbing. Excellent balance of surface scale and structural mass.</p>
              <div class="block-spec">3.2 pieces / sq ft | 31 lbs / piece</div>
            </div>
            <div class="block-card">
              <div class="block-badge">Heavy Duty</div>
              <h3>Jumbo Belgian Block</h3>
              <div class="block-dim">Dimensions: 4" × 7" × 10"</div>
              <p>Engineered for high-traffic roadway curbs, estate entrance aprons, and retaining wall coping stones. Heavy ballast resists snowplow impacts.</p>
              <div class="block-spec">2.1 pieces / sq ft | 42 lbs / piece</div>
            </div>
          </div>

          <h3>Linear Driveway Edging Calculation Formula</h3>
          <p>
            When using regulation or jumbo Belgian block as a continuous driveway border curb, blocks are typically installed with their longest face running parallel to the asphalt:
          </p>
          <div class="formula-box">
            <code>Blocks Needed = [Total Run (Feet) × 12 Inches] / [Block Length (Inches) + Joint Width (Inches)]</code>
          </div>
          <p>
            For a 100-foot regulation block border (9-inch block length + 0.5-inch mortar joint = 9.5-inch pitch), the calculation is: <code>(100 × 12) / 9.5 = 126.3 blocks</code>. Always add 5% to 8% to account for field cutting at corners and driveway terminals.
          </p>

          <div class="table-wrapper">
            <table class="guide-table">
              <thead>
                <tr>
                  <th>Block Designation</th>
                  <th>Nominal Dimensions</th>
                  <th>Average Weight</th>
                  <th>Pieces per Pallet</th>
                  <th>Pallet Weight</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Mini Cobblestone Cube</td><td>4" × 4" × 4"</td><td>9 lbs</td><td>350 - 400 pcs</td><td>3,400 lbs (1.7 tons)</td></tr>
                <tr><td>Regulation Belgian Block</td><td>5" × 5" × 9"</td><td>31 lbs</td><td>100 - 110 pcs</td><td>3,250 lbs (1.6 tons)</td></tr>
                <tr><td>Jumbo Belgian Block</td><td>4" × 7" × 10"</td><td>42 lbs</td><td>70 - 75 pcs</td><td>3,100 lbs (1.55 tons)</td></tr>
                <tr><td>Landscape Cobble Paver</td><td>6" × 6" × 6"</td><td>18 lbs</td><td>160 pcs</td><td>2,880 lbs (1.44 tons)</td></tr>
              </tbody>
            </table>
          </div>

          <h3>Sub-Base Installation Standards for Driveway Cobblestone</h3>
          <ol class="steps-list">
            <li>
              <strong>Excavation Depth:</strong> Excavate 14 inches below finished driveway grade. Compact the subgrade soil with a heavy plate vibratory compactor until reaching 95% standard Proctor density.
            </li>
            <li>
              <strong>Structural Aggregate Base:</strong> Spread 8 inches of dense graded aggregate (#411 limestone or crushed road base) in two 4-inch lifts, compacting each lift thoroughly with water misting.
            </li>
            <li>
              <strong>Setting Bed:</strong> Place a 2-inch bed of moist setting mortar (1 part Type M Portland cement to 3 parts coarse masonry sand) or a 1-inch screeded bed of sharp bedding sand.
            </li>
            <li>
              <strong>Setting and Jointing:</strong> Tap each granite block into the setting bed with a dead-blow rubber mallet to establish a level surface. Infill joints with high-strength polymeric paver sand or an engineered cementitious grout.
            </li>
          </ol>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Cobblestones</h2>
          <div class="faq-accordion">
            {faqItems.map((item, index) => (
              <details class="faq-detail" open={index === 0}>
                <summary class="faq-summary">
                  <span>{item.q}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </article>

    <TopicClusterNav currentPage="/cobblestone-calculator" />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .block-types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  @media (max-width: 850px) {
    .block-types-grid {
      grid-template-columns: 1fr;
    }
  }

  .block-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .block-card.active-block {
    border-color: var(--accent-gold);
    background: rgba(212, 168, 83, 0.04);
  }

  .block-badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(139, 157, 168, 0.15);
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
  }

  .block-badge.featured {
    background: rgba(212, 168, 83, 0.2);
    color: var(--accent-gold);
  }

  .block-card h3 {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .block-dim {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  .block-card p {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .block-spec {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .guide-table th, .guide-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-table th {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
  }

  .guide-table tr:hover td {
    background: rgba(212, 168, 83, 0.04);
  }

  .steps-list {
    padding-left: var(--space-6);
    margin: var(--space-4) 0;
  }

  .steps-list li {
    margin-bottom: var(--space-3);
  }

  .faq-detail {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary svg {
    transition: transform var(--transition-fast);
  }

  .faq-detail[open] .faq-summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
