  </main>
  <Footer />

  <script>
    type InputId = 'lrb-length' | 'lrb-width' | 'lrb-area' | 'lrb-depth' | 'lrb-capacity' | 'lrb-extra' | 'lrb-price' | 'lrb-weight';
    const input = (id: InputId) => document.getElementById(id) as HTMLInputElement;
    const output = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };
    const value = (id: InputId) => {
      const raw = input(id).value.trim();
      return raw === '' ? NaN : Number(raw);
    };
    const valid = (id: InputId) => {
      const field = input(id);
      const number = value(id);
      const minimum = Number(field.min);
      const maximum = field.max === '' ? Infinity : Number(field.max);
      return Number.isFinite(number) && number >= minimum && number <= maximum;
    };
    const fmt = (number: number, digits = 2) => number.toLocaleString('en-US', { maximumFractionDigits: digits });
    const money = (number: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(number);
    let areaMode: 'dimensions' | 'square-feet' = 'dimensions';

    function updateLRB() {
      const required: InputId[] = areaMode === 'dimensions'
        ? ['lrb-length', 'lrb-width', 'lrb-depth', 'lrb-capacity', 'lrb-extra']
        : ['lrb-area', 'lrb-depth', 'lrb-capacity', 'lrb-extra'];
      const optional: InputId[] = ['lrb-price', 'lrb-weight'];
      const invalidRequired = required.find(id => !valid(id));
      [...required, ...optional].forEach(id => {
        const field = input(id);
        const isOptionalEmpty = optional.includes(id) && field.value.trim() === '';
        if (!valid(id) && !isOptionalEmpty) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      });

      const error = document.getElementById('lrb-error') as HTMLElement;
      const results = document.getElementById('lrb-results') as HTMLElement;
      const invalidResults = document.getElementById('lrb-invalid-results') as HTMLElement;
      if (invalidRequired) {
        const label = document.querySelector('label[for="' + invalidRequired + '"]')?.textContent?.trim() || 'the highlighted field';
        error.textContent = 'Enter a valid value for ' + label + '.';
        error.hidden = false;
        results.hidden = true;
        invalidResults.hidden = false;
        return;
      }

      const area = areaMode === 'dimensions' ? value('lrb-length') * value('lrb-width') : value('lrb-area');
      const depth = value('lrb-depth');
      const capacity = value('lrb-capacity');
      const net = area * depth / 12;
      const planned = net * (1 + value('lrb-extra') / 100);
      const bags = Math.ceil(planned / capacity - 1e-10);
      const purchased = bags * capacity;
      if (![area, net, planned, bags, purchased].every(Number.isFinite) || !Number.isSafeInteger(bags) || bags < 1) {
        error.textContent = 'Use smaller project values to calculate a reliable whole-bag order.';
        error.hidden = false;
        results.hidden = true;
        invalidResults.hidden = false;
        return;
      }
      error.hidden = true;
      results.hidden = false;
      invalidResults.hidden = true;
      output('lrb-bags', fmt(bags, 0));
      output('lrb-bag-size', 'at ' + fmt(capacity, 3) + ' ft³ per bag');
      output('lrb-area-result', fmt(area) + ' sq ft');
      output('lrb-net', fmt(net) + ' ft³');
      output('lrb-planned', fmt(planned) + ' ft³');
      output('lrb-purchased', fmt(purchased) + ' ft³');
      output('lrb-yards', fmt(planned / 27) + ' yd³');
      output('lrb-coverage', fmt(capacity * 12 / depth) + ' sq ft');
      output('lrb-cost', input('lrb-price').value.trim() === '' ? 'Add price' : valid('lrb-price') ? money(bags * value('lrb-price')) : 'Check price');
      output('lrb-total-weight', input('lrb-weight').value.trim() === '' ? 'Add label weight' : valid('lrb-weight') ? fmt(bags * value('lrb-weight'), 1) + ' lb' : 'Check weight');
      output('lrb-summary', fmt(bags, 0) + ' whole lava rock bags for ' + fmt(area) + ' square feet at ' + fmt(depth) + ' inches.');
      const optionalNote = document.getElementById('lrb-optional-note') as HTMLElement;
      const invalidOptional = optional.filter(id => input(id).value.trim() !== '' && !valid(id));
      optionalNote.hidden = invalidOptional.length === 0;
      optionalNote.textContent = invalidOptional.length ? 'Check the highlighted optional ' + (invalidOptional.length === 1 ? 'field' : 'fields') + '. Your whole-bag count remains valid.' : '';
    }

    function setMode(next: 'dimensions' | 'square-feet') {
      areaMode = next;
      const dimensions = next === 'dimensions';
      (document.getElementById('lrb-dim-fields') as HTMLElement).hidden = !dimensions;
      (document.getElementById('lrb-area-fields') as HTMLElement).hidden = dimensions;
      const dimsButton = document.getElementById('lrb-mode-dims') as HTMLButtonElement;
      const areaButton = document.getElementById('lrb-mode-area') as HTMLButtonElement;
      dimsButton.classList.toggle('active', dimensions);
      areaButton.classList.toggle('active', !dimensions);
      dimsButton.setAttribute('aria-pressed', String(dimensions));
      areaButton.setAttribute('aria-pressed', String(!dimensions));
      updateLRB();
    }

    document.getElementById('lrb-mode-dims')?.addEventListener('click', () => setMode('dimensions'));
    document.getElementById('lrb-mode-area')?.addEventListener('click', () => setMode('square-feet'));
    (['lrb-length', 'lrb-width', 'lrb-area', 'lrb-depth', 'lrb-capacity', 'lrb-extra', 'lrb-price', 'lrb-weight'] as InputId[]).forEach(id => {
      input(id).addEventListener('input', updateLRB);
    });
    updateLRB();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0 var(--space-12); }
  .section-intro { max-width: 760px; margin: 0 0 var(--space-6); }
  .section-intro h2 { color: var(--text-primary); font-size: clamp(1.45rem, 3vw, 2rem); margin-bottom: var(--space-2); }
  .section-intro p { color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .mode-tabs { display: flex; gap: var(--space-2); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .mode-btn { border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-secondary); padding: .6rem .85rem; font: inherit; font-size: .84rem; font-weight: 700; cursor: pointer; }
  .mode-btn.active { background: rgba(212, 168, 83, .14); color: var(--accent-gold); border-color: var(--accent-gold); }
  .mode-btn:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  #lrb-area-fields[hidden], #lrb-dim-fields[hidden], #lrb-results[hidden], #lrb-invalid-results[hidden], #lrb-error[hidden], #lrb-optional-note[hidden] { display: none; }
  .field-note { margin: calc(var(--space-4) * -1) 0 var(--space-5); color: var(--text-muted); font-size: .82rem; line-height: 1.5; }
  .optional-heading { color: var(--text-primary); font-size: .88rem; margin: var(--space-5) 0 var(--space-3); }
  .optional-grid { margin-bottom: var(--space-6); }
  .input-field input[aria-invalid="true"] { border-color: #dc2626; }
