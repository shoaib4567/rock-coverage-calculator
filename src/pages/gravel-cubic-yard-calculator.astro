---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Gravel Cubic Yard Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gravel Calculator', url: '/gravel-calculator' },
  { name: pageTitle, url: '/gravel-cubic-yard-calculator' }
];
const entityTags = [
  { label: 'Order unit', value: 'Loose cubic yards' },
  { label: 'Measured quantity', value: 'Area × finished depth' },
  { label: 'Volume conversion', value: '27 ft³ = 1 yd³' }
];
const faqItems = [
  {
    q: 'How many cubic yards of gravel do I need for a 20 × 20 ft area?',
    a: 'A 20 × 20 ft area is 400 sq ft. At 3 in finished depth, it needs 3.70 cubic yards in place (400 × 3 ÷ 324). With a 10% allowance, the estimate is 4.07 cubic yards before any supplier rounding.'
  },
  {
    q: 'How many square feet does one cubic yard of gravel cover?',
    a: 'One cubic yard covers 162 sq ft at 2 in, 108 sq ft at 3 in, or 81 sq ft at 4 in, assuming an even layer. Divide 324 by the depth in inches for another depth.'
  },
  {
    q: 'Does gravel type change the number of cubic yards?',
    a: 'The area-and-depth volume formula is the same, but gravel type changes how the material is placed and how much it weighs. A compacted dense-graded base may need a different loose-to-finished allowance from a clean drainage stone or loose decorative gravel. Ask the supplier about the selected product’s yield.'
  },
  {
    q: 'How do I convert gravel cubic yards to US short tons?',
    a: 'Multiply cubic yards by the selected gravel’s loose bulk weight in pounds per cubic yard, then divide by 2,000. The calculator starts at 2,800 lb per cubic yard as an editable planning example, not a fixed weight for all gravel.'
  },
  {
    q: 'Should I calculate a gravel top-up from the full driveway depth?',
    a: 'No. Measure the average thickness still needed to reach the finished level. If an existing sound layer is 2 in below the desired surface, calculate 2 in of new material and handle deeper ruts as separate areas.'
  }
];
const upLinks = [
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: 'Material' },
  { title: 'Rock Coverage Calculator Yard', slug: '/rock-coverage-calculator-yard', badge: 'Unit' },
  { title: 'Rock Coverage Chart', slug: '/rock-coverage-chart', badge: 'Chart' }
];
const lateralLinks = [
  { title: 'Gravel Tons Calculator', slug: '/gravel-tons-calculator', badge: 'Tons' },
  { title: 'Gravel Bag Calculator', slug: '/gravel-bag-calculator', badge: 'Bags' },
  { title: 'Crushed Stone Yardage Calculator', slug: '/crushed-stone-yardage-calculator', badge: 'Stone yards' }
];
const bridgeLinks = [
  { title: 'Driveway Rock Calculator', slug: '/driveway-rock-calculator', badge: 'Project' },
  { title: 'Drain Rock Calculator', slug: '/drain-rock-calculator', badge: 'Drainage' },
  { title: 'Pea Gravel Cubic Yard Calculator', slug: '/pea-gravel-cubic-yard-calculator', badge: 'Rounded gravel' }
];
const supportGuides = [
  { title: 'Gravel Sizes', slug: '/gravel-sizes', badge: 'Gradation' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Weight' }
];
---

<BaseLayout
  title={pageTitle}
  description="Estimate gravel cubic yards from dimensions or square footage and finished depth. Separate installed volume, optional extra, supplier rounding, and editable ton and bag conversions."
  canonicalPath="/gravel-cubic-yard-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/gravel-cubic-yard-calculator',
      description: 'Estimates gravel cubic yards from measured area and finished depth, with editable bulk order assumptions.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Cubic Yard"
      badge="Bulk gravel order worksheet"
      subtitle="A 40 × 12 ft area at 3 in finished depth needs 4.44 cubic yards of gravel in place. Add 10% extra and the estimate is 4.89 yards; a seller using half-yard increments would round that to 5 yards. Measure your own area below."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
    />

    <section class="gy-tool" aria-labelledby="gy-tool-heading">
      <div class="container">
        <div class="gy-heading">
          <p class="gy-eyebrow">From site measurements to an order</p>
          <h2 id="gy-tool-heading">Find the gravel yards your area needs</h2>
          <p>Enter the <em>finished layer depth</em>. The calculator keeps that measured volume separate from extra material and the seller’s yard increment.</p>
        </div>
        <div class="gy-tool-grid">
          <div class="gy-panel gy-inputs">
            <h3>Measure the footprint</h3>
            <div class="gy-field">
              <label for="gy-method">How did you measure it?</label>
              <select id="gy-method">
                <option value="dimensions">Length × width</option>
                <option value="area">Known square footage</option>
              </select>
            </div>
            <div class="gy-field-pair" id="gy-dimensions">
              <div class="gy-field">
                <label for="gy-length">Length (ft)</label>
                <input id="gy-length" type="number" value="40" min="0.1" step="any" inputmode="decimal" />
              </div>
              <div class="gy-field">
                <label for="gy-width">Width (ft)</label>
                <input id="gy-width" type="number" value="12" min="0.1" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="gy-field" id="gy-area-field" hidden>
              <label for="gy-area">Measured area (sq ft)</label>
              <input id="gy-area" type="number" value="480" min="0.1" step="any" inputmode="decimal" />
            </div>
            <div class="gy-field-pair">
              <div class="gy-field">
                <label for="gy-depth">Finished gravel depth (in)</label>
                <input id="gy-depth" type="number" value="3" min="0.5" max="24" step="any" inputmode="decimal" />
              </div>
              <div class="gy-field">
                <label for="gy-extra">Extra for this job (%)</label>
                <input id="gy-extra" type="number" value="10" min="0" max="50" step="any" inputmode="decimal" />
              </div>
            </div>
            <p class="gy-help">Set extra to 0% for the measured volume alone. For a compacted base, ask the seller how much loose product yields your finished depth; 10% is only a planning choice.</p>
            <details class="gy-assumptions">
              <summary>Supplier units and order increment</summary>
              <div class="gy-field-pair">
                <div class="gy-field">
                  <label for="gy-density">Loose weight (lb/yd³)</label>
                  <input id="gy-density" type="number" value="2800" min="500" max="6000" step="any" inputmode="decimal" />
                </div>
                <div class="gy-field">
                  <label for="gy-bag">Bag volume (ft³)</label>
                  <input id="gy-bag" type="number" value="0.5" min="0.1" max="4" step="any" inputmode="decimal" />
                </div>
              </div>
              <div class="gy-field">
                <label for="gy-increment">If sold by the yard, round up to</label>
                <select id="gy-increment">
                  <option value="0">No rounding</option>
                  <option value="0.25">Next ¼ cubic yard</option>
                  <option value="0.5" selected>Next ½ cubic yard</option>
                  <option value="1">Next whole cubic yard</option>
                </select>
              </div>
              <p class="gy-help">The 2,800 lb/yd³ weight is an example. Replace it with the loose bulk weight for the exact gravel your supplier sells. Confirm its minimum delivery and available increments.</p>
            </details>
          </div>

          <div class="gy-panel gy-results" aria-labelledby="gy-results-heading">
            <p class="gy-eyebrow">Your estimate</p>
            <h3 id="gy-results-heading">Gravel to plan for</h3>
            <p class="gy-context" id="gy-context">For 480 sq ft at 3 in finished depth.</p>
            <div class="gy-primary-result"><span>Yards with selected extra</span><strong id="gy-adjusted">4.89 yd³</strong></div>
            <dl class="gy-results-list">
              <div><dt>Measured finished volume</dt><dd id="gy-installed">4.44 yd³</dd></div>
              <div><dt>Bulk order at selected increment</dt><dd id="gy-rounded">5.00 yd³</dd></div>
              <div><dt>Approx. US short tons before yard rounding</dt><dd id="gy-tons">6.84 tons</dd></div>
              <div><dt id="gy-bag-label">0.5 ft³ bags before yard rounding</dt><dd id="gy-bags">264 bags</dd></div>
            </dl>
            <p class="gy-volume-line" id="gy-volume">Finished: 120 ft³. With extra: 132 ft³.</p>
            <p class="gy-result-note">A seller charging by cubic yard can use the rounded bulk number. For a price by ton, use the ton estimate with their actual weight per yard. Bag count uses the volume before bulk yard rounding.</p>
            <p class="gy-feedback" id="gy-feedback" role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </section>

    <article class="gy-guide">
      <div class="container">
        <nav class="gy-jump" aria-label="On this page">
          <strong>Plan a gravel order</strong>
          <a href="#gy-formula">Formula</a>
          <a href="#gy-depth-guide">Coverage</a>
          <a href="#gy-yield">Product and yield</a>
          <a href="#gy-site">Site measurements</a>
          <a href="#gy-quote">Supplier checklist</a>
        </nav>

        <section class="gy-card gy-formula-grid" id="gy-formula" aria-labelledby="gy-formula-heading">
          <div>
            <p class="gy-eyebrow">The yardage calculation</p>
            <h2 id="gy-formula-heading">Convert the finished space to cubic yards</h2>
            <p>A cubic yard is <strong>27 cubic feet</strong>. Multiply area in square feet by finished depth in inches, then divide by <strong>324</strong>. That divisor combines 12 inches per foot with 27 cubic feet per yard. <a href="https://www.wa-rock.com/how-many-cubic-yards-do-i-need/" target="_blank" rel="noopener noreferrer">Washington Rock Quarries</a> uses the same volume-first approach for a real drain-rock top-up.</p>
            <div class="gy-formula"><code>finished yd³ = area (ft²) × depth (in) ÷ 324</code><code>yards with extra = finished yd³ × (1 + extra % ÷ 100)</code></div>
            <p><strong>Worked example:</strong> A 40 × 12 ft area is 480 sq ft. At 3 in, it needs 480 × 3 ÷ 324 = <strong>4.44 yd³</strong> in place. Ten percent extra makes <strong>4.89 yd³</strong>. If the supplier sells half yards, round up to <strong>5.00 yd³</strong>. The exact yardage comes from geometry; the extra and sales increment are separate decisions.</p>
          </div>
          <figure class="gy-figure">
            <img src="/gravel-yard-order-diagram.svg" width="840" height="560" loading="lazy" alt="A 40 by 12 foot area at 3 inches depth uses 4.44 cubic yards in place; with 10 percent extra it is 4.89 yards, rounded to a 5 yard half-yard bulk order." />
            <figcaption><span class="gy-mobile-hint">Swipe to read the diagram. </span>The finished volume, planning allowance, and rounded order are three different numbers.</figcaption>
          </figure>
        </section>

        <section class="gy-card" id="gy-depth-guide" aria-labelledby="gy-depth-heading">
          <p class="gy-eyebrow">Depth changes coverage</p>
          <h2 id="gy-depth-heading">How far does one cubic yard of gravel spread?</h2>
          <p>At an even depth, <strong>1 yd³ covers 324 ÷ depth in inches square feet</strong>. Choose depth for the material and job before using a coverage chart. A thin decorative refresh, a drainage layer, and a compacted driveway base have different requirements; a stone’s size label alone does not specify an installation depth.</p>
          <div class="gy-table-wrap">
            <table>
              <caption>Gravel volume before extra or supplier rounding</caption>
              <thead><tr><th scope="col">Finished depth</th><th scope="col">Area covered by 1 yd³</th><th scope="col">Yards for 400 sq ft</th></tr></thead>
              <tbody>
                <tr><th scope="row">2 in</th><td>162 sq ft</td><td>2.47 yd³</td></tr>
                <tr><th scope="row">3 in</th><td>108 sq ft</td><td>3.70 yd³</td></tr>
                <tr><th scope="row">4 in</th><td>81 sq ft</td><td>4.94 yd³</td></tr>
                <tr><th scope="row">6 in</th><td>54 sq ft</td><td>7.41 yd³</td></tr>
              </tbody>
            </table>
          </div>
          <p>If a project uses a base and a surface layer, calculate each at its own depth and with its own product. The <a href="/driveway-rock-calculator">driveway rock calculator</a> helps plan a driveway, while the <a href="/drain-rock-calculator">drain rock calculator</a> addresses drainage material.</p>
        </section>

        <section class="gy-card" id="gy-yield" aria-labelledby="gy-yield-heading">
          <p class="gy-eyebrow">The material matters after the volume calculation</p>
          <h2 id="gy-yield-heading">Keep loose order volume, compacted yield, and weight distinct</h2>
          <div class="gy-scenarios">
            <div><h3>Dense-graded base</h3><p>Fines between angular stones help a base compact. Specify the <em>finished compacted</em> depth, then ask how many loose yards of that product are needed to achieve it. <a href="https://www.wa-rock.com/clean-v-minus-questions-answered/" target="_blank" rel="noopener noreferrer">Washington Rock’s clean-versus-minus guide</a> explains why the products behave differently.</p></div>
            <div><h3>Clean drainage gravel</h3><p>Open-graded stone without fines serves a different job. Do not apply a dense-base compaction factor automatically. Measure the trench or bed volume, then confirm the selected grade and delivery unit with the seller.</p></div>
            <div><h3>Decorative or pea gravel</h3><p>A surface layer is often planned by visible finished depth. If you are topping up existing gravel, measure only what is missing. For rounded material, use the <a href="/pea-gravel-cubic-yard-calculator">pea gravel cubic yard calculator</a>.</p></div>
          </div>
          <p>The tool’s 2,800 lb/yd³ default is a planning example, close to the 1.4-ton-per-yard figure used in one <a href="https://www.wa-rock.com/how-many-cubic-yards-do-i-need/" target="_blank" rel="noopener noreferrer">Washington Rock project example</a>. It is not a certified weight for every gravel. <a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> is a method for measuring aggregate bulk density and voids, including loose and compacted conditions; it does not prescribe a universal 1.40-ton value. Moisture and stockpile conditions can also affect the weight of a delivered load.</p>
        </section>

        <section class="gy-card" id="gy-site" aria-labelledby="gy-site-heading">
          <p class="gy-eyebrow">Measure the space you will fill</p>
          <h2 id="gy-site-heading">Handle curves, ruts, and top-ups before ordering</h2>
          <ol class="gy-steps">
            <li><strong>Map the footprint.</strong> Divide a curved path or tapered driveway into smaller rectangles. Add their square footage and use the tool’s “known square footage” setting.</li>
            <li><strong>Measure the missing depth.</strong> Check several points. For a top-up, calculate only the new thickness needed above a sound existing layer, not the whole finished structure.</li>
            <li><strong>Separate unequal depths.</strong> A deep rut or trench should have its own area × depth calculation; add its cubic yards to the surface layer instead of assuming the deepest point represents the whole site.</li>
            <li><strong>Choose the extra deliberately.</strong> Set 0% to see the geometric volume, then add a site-specific amount for uneven grades, handling loss, or supplier-advised compacted yield.</li>
          </ol>
        </section>

        <section class="gy-card gy-quote" id="gy-quote" aria-labelledby="gy-quote-heading">
          <p class="gy-eyebrow">Before placing the order</p>
          <h2 id="gy-quote-heading">Give the supplier a quantity it can actually quote</h2>
          <p>Say what gravel product and gradation you want, your calculated yards, and whether the depth is loose or finished after compaction. Then ask:</p>
          <ul>
            <li>Is this product sold by <strong>cubic yard</strong> or <strong>US short ton</strong>, and what loose tons-per-yard figure should I use?</li>
            <li>What are the smallest order increment and delivery minimum? A calculator’s half-yard rounding is only an example.</li>
            <li>For a compacted base, what loose quantity will yield the specified finished depth?</li>
            <li>Can the truck reach the drop point, and where can the load be tipped safely?</li>
          </ul>
          <p>If the quote is by weight, use the <a href="/gravel-tons-calculator">gravel tons calculator</a>. For a broader material estimate, return to the <a href="/gravel-calculator">gravel calculator</a>.</p>
        </section>

        <section class="gy-card gy-faq" aria-labelledby="gy-faq-heading">
          <h2 id="gy-faq-heading">Gravel cubic yard questions</h2>
          <div class="gy-faq-list">
            {faqItems.map(item => <div><h3>{item.q}</h3><p>{item.a}</p></div>)}
          </div>
        </section>
      </div>
    </article>

    <TopicClusterNav currentPage="/gravel-cubic-yard-calculator" category="quantity" upLinks={upLinks} lateralLinks={lateralLinks} bridgeLinks={bridgeLinks} supportGuides={supportGuides} />
  </main>
  <Footer />

  <script>
    const field = (id: string) => document.getElementById(id) as HTMLInputElement;
    const output = (id: string, value: string) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    };
    function numberFrom(id: string): number {
      const input = field(id);
      if (!input.value.trim() || !input.checkValidity()) return NaN;
      return Number(input.value);
    }
    function updateGravelYards() {
      const method = (document.getElementById('gy-method') as HTMLSelectElement).value;
      const area = method === 'area' ? numberFrom('gy-area') : numberFrom('gy-length') * numberFrom('gy-width');
      const depth = numberFrom('gy-depth');
      const extra = numberFrom('gy-extra');
      const density = numberFrom('gy-density');
      const bag = numberFrom('gy-bag');
      const increment = Number((document.getElementById('gy-increment') as HTMLSelectElement).value);
      const valid = Number.isFinite(area) && area > 0 && Number.isFinite(depth) && depth > 0 &&
        Number.isFinite(extra) && extra >= 0 && Number.isFinite(density) && density > 0 &&
        Number.isFinite(bag) && bag > 0;
      const installed = area * depth / 324;
      const adjusted = installed * (1 + extra / 100);
      if (!valid || !Number.isFinite(adjusted)) {
        ['gy-adjusted', 'gy-installed', 'gy-rounded', 'gy-tons', 'gy-bags', 'gy-volume'].forEach(id => output(id, '—'));
        output('gy-context', 'Enter valid, positive measurements.');
        output('gy-feedback', 'Check the highlighted measurement or supplier assumption.');
        return;
      }
      const rounded = increment > 0 ? Math.ceil((adjusted - 1e-9) / increment) * increment : adjusted;
      output('gy-context', `For ${area.toLocaleString(undefined, { maximumFractionDigits: 1 })} sq ft at ${depth.toLocaleString()} in finished depth.`);
      output('gy-installed', `${installed.toFixed(2)} yd³`);
      output('gy-adjusted', `${adjusted.toFixed(2)} yd³`);
      output('gy-rounded', `${rounded.toFixed(2)} yd³`);
      output('gy-tons', `${(adjusted * density / 2000).toFixed(2)} tons`);
      output('gy-bag-label', `${bag.toLocaleString()} ft³ bags before yard rounding`);
      output('gy-bags', `${Math.ceil(adjusted * 27 / bag).toLocaleString()} bags`);
      output('gy-volume', `Finished: ${(installed * 27).toLocaleString(undefined, { maximumFractionDigits: 1 })} ft³. With extra: ${(adjusted * 27).toLocaleString(undefined, { maximumFractionDigits: 1 })} ft³.`);
      output('gy-feedback', '');
    }
    const methodSelect = document.getElementById('gy-method') as HTMLSelectElement;
    methodSelect.addEventListener('change', () => {
      const byArea = methodSelect.value === 'area';
      (document.getElementById('gy-dimensions') as HTMLElement).hidden = byArea;
      (document.getElementById('gy-area-field') as HTMLElement).hidden = !byArea;
      updateGravelYards();
    });
    ['gy-length', 'gy-width', 'gy-area', 'gy-depth', 'gy-extra', 'gy-density', 'gy-bag', 'gy-increment'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateGravelYards);
      document.getElementById(id)?.addEventListener('change', updateGravelYards);
    });
    updateGravelYards();
  </script>
</BaseLayout>

<style>
  .gy-tool { padding: var(--space-8) 0 var(--space-12); }
  .gy-guide { padding: var(--space-12) 0; background: var(--bg-body); }
  .gy-eyebrow { margin: 0 0 var(--space-2); color: var(--accent-gold); font-size: var(--text-xs); font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .gy-heading { max-width: 720px; margin-bottom: var(--space-6); }
  .gy-heading h2, .gy-card h2 { color: var(--text-primary); font-size: clamp(1.55rem, 2.4vw, 2.1rem); line-height: 1.18; margin: 0 0 var(--space-4); }
  .gy-heading p, .gy-card p { color: var(--text-secondary); line-height: 1.7; }
  .gy-tool-grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: var(--space-5); align-items: start; }
  .gy-panel, .gy-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: 0 10px 30px rgba(0,0,0,.035); }
  .gy-panel { padding: clamp(1.25rem, 3vw, 2rem); }
  .gy-panel h3 { margin: 0 0 var(--space-5); color: var(--text-primary); font-size: var(--text-xl); }
  .gy-field-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .gy-field { margin-bottom: var(--space-4); }
  .gy-field label { display: block; margin-bottom: var(--space-2); color: var(--text-primary); font-weight: 650; font-size: var(--text-sm); }
  .gy-field input, .gy-field select { width: 100%; min-height: 46px; padding: .65rem .8rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--text-primary); font: inherit; }
  .gy-field input:focus-visible, .gy-field select:focus-visible, .gy-assumptions summary:focus-visible, .gy-jump a:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .gy-field input:invalid { border-color: #b34840; }
  .gy-help { margin: 0 0 var(--space-4); color: var(--text-muted); font-size: var(--text-sm); line-height: 1.55; }
  .gy-assumptions { border-top: 1px solid var(--border-subtle); padding-top: var(--space-4); }
  .gy-assumptions summary { color: var(--text-primary); cursor: pointer; font-weight: 700; margin-bottom: var(--space-4); }
  .gy-assumptions .gy-help { margin-bottom: 0; }
  .gy-results { background: linear-gradient(145deg, var(--bg-card), var(--bg-surface)); }
  .gy-results h3 { margin-bottom: var(--space-2); }
  .gy-context { color: var(--text-secondary); margin: 0 0 var(--space-5); }
  .gy-primary-result { padding: var(--space-5); border-radius: var(--radius-md); background: var(--text-primary); color: var(--bg-card); display: flex; flex-direction: column; gap: .25rem; }
  .gy-primary-result span { font-size: var(--text-sm); }
  .gy-primary-result strong { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; }
  .gy-results-list { margin: var(--space-5) 0; }
  .gy-results-list div { display: flex; justify-content: space-between; gap: var(--space-4); padding: .8rem 0; border-bottom: 1px solid var(--border-subtle); }
  .gy-results-list dt { color: var(--text-secondary); }
  .gy-results-list dd { margin: 0; color: var(--text-primary); font-weight: 800; text-align: right; white-space: nowrap; }
  .gy-volume-line { font-weight: 700; color: var(--text-primary); }
  .gy-result-note { color: var(--text-muted); font-size: var(--text-sm); line-height: 1.55; }
  .gy-feedback:not(:empty) { border-left: 3px solid #b34840; padding: .6rem .8rem; color: var(--text-primary); }
