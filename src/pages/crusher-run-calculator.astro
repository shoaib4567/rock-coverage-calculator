---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import { getMaterialById } from '../scripts/materials-data.js';

const baseDensity = getMaterialById('crusher-run-21a').tonsPerCuYd;
const ca6Density = getMaterialById('base-gravel-21a').tonsPerCuYd;
const clean57Density = getMaterialById('clean-stone-57').tonsPerCuYd;
const dgDensity = getMaterialById('decomposed-granite').tonsPerCuYd;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crusher Run Calculator', url: '/crusher-run-calculator' }
];

const entityTags = [
  { label: 'Blends', value: '21-A / #411 / QP / CA-6 / Class 2 Road Base / Clean #57' },
  { label: 'Calculation modes', value: 'Loose Order Increase % or Compaction Shrinkage %' },
  { label: 'Default density', value: `${baseDensity.toFixed(2)} short tons/yd³ (2,900 lb/yd³ editable)` }
];

const quickStats = [
  { value: '1.45 t/yd³', label: 'Dense graded preset', desc: 'Compacted stone + fines blend; verify supplier weight' },
  { value: '20%', label: 'Starting allowance', desc: 'Compare Add-Extra % vs Loose-to-Finished shrinkage' },
  { value: 'AASHTO M147', label: 'Base gradation class', desc: 'Supports compacted driveway, patio, and shed bases' }
];

const faqItems = [
  {
    q: 'How much crusher run do I need for a 12 × 24 ft driveway?',
    a: 'At a 4-inch finished depth, the compacted volume is 3.56 yd³. Adding a 20% loose-order allowance yields 4.27 yd³ (~6.19 short tons at 1.45 t/yd³). If instead your spec calls for 20% compaction shrinkage (loose depth 5.0 in compressing down to 4.0 in), divide 3.56 by 0.80 to order 4.44 loose yd³ (~6.44 short tons).'
  },
  {
    q: 'Are crusher run, QP, 21-A, CA-6, and Class 2 Base the same?',
    a: 'All are regional names for dense-graded base aggregates containing fractured rock plus rock dust (fines) designed to compact mechanically. Specific sieve curves vary by state DOT spec—always check your local quarry ticket for weight and top stone size.'
  },
  {
    q: 'What is the difference between Extra Order % and Compaction Shrinkage %?',
    a: 'An order increase adds a percentage onto finished volume (Finished × 1.20 = 1.20×). Compaction volume loss divides by the remaining fraction after shrinkage (Finished ÷ 0.80 = 1.25×, meaning 5 inches placed loose settles to 4 inches finished).'
  },
  {
    q: 'Can crusher run be used as a finished driveway surface?',
    a: 'Yes—21-A, #411, and CA-6 are widely used both under pavers and as self-binding gravel driveways. Because fines retain some moisture when dust settles, ensure clean edge drainage and crown the driveway center.'
  }
];
---

<BaseLayout
  title="Crusher Run Calculator: Road Base, 21-A, QP & Landscape Stone"
  description="Estimate loose cubic yards and short tons for crusher run, 21-A, QP, CA-6 road base, or structural landscape stone. Switch between order allowance and compaction shrinkage math."
  canonicalPath="/crusher-run-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Crusher Run Calculator",
      "url": "https://rockcoveragecalculator.com/crusher-run-calculator",
      "description": "Calculates dense-graded crusher run, 21-A, QP, CA-6 road base, and compacted landscape stone loose cubic yards and short tons.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "audience": {
        "@type": "Audience",
        "audienceType": "Paving Installers, Hardscape Masons, Civil Contractors, Estimators"
      },
      "about": {
        "@type": "Thing",
        "name": "Crusher Run and Base Rock Coverage"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Crusher Run Calculator"
      highlightWord="Crusher Run"
      badge="Dense-Graded Road Base & Hardscape Stone"
      subtitle="Calculate loose cubic yards and short tons for crusher run, 21-A, #411, quarry process (QP), CA-6 road base, or structural base stone using either extra-order % or compaction shrinkage math."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="civil"
    />

    <!-- Interactive Crusher Run Calculator Tool -->
    <section class="section" id="crusher-calc">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
              <h2>Base Layer &amp; Gradation</h2>
            </div>

            <div class="preset-grid" role="group" aria-label="Gradation presets">
              <button type="button" class="preset-btn active" aria-pressed="true" data-density={baseDensity} data-loss="20" data-name="Crusher Run / #411 / 21-A">
                <strong>Crusher Run / 21-A / #411</strong>
                <span>{baseDensity.toFixed(2)} t/yd&sup3; &middot; Mixed stone + fines</span>
              </button>
              <button type="button" class="preset-btn" aria-pressed="false" data-density={ca6Density} data-loss="20" data-name="CA-6 / Class 2 Road Base">
                <strong>CA-6 / Class 2 Road Base</strong>
                <span>{ca6Density.toFixed(2)} t/yd&sup3; &middot; Structural highway base</span>
              </button>
              <button type="button" class="preset-btn" aria-pressed="false" data-density={clean57Density} data-loss="0" data-name="Clean #57 Open-Graded">
                <strong>Clean #57 Angular Stone</strong>
                <span>{clean57Density.toFixed(2)} t/yd&sup3; &middot; Open-graded drainage base</span>
              </button>
              <button type="button" class="preset-btn" aria-pressed="false" data-density={dgDensity} data-loss="15" data-name="Decomposed Granite">
                <strong>Decomposed Granite Base</strong>
                <span>{dgDensity.toFixed(2)} t/yd&sup3; &middot; Fine path stone</span>
              </button>
            </div>

            <div class="unit-toggle" role="group" aria-label="Area measurement mode">
              <button class="active" id="crusher-area-dims" type="button" aria-pressed="true">Dimensions (L &times; W)</button>
              <button id="crusher-area-sqft" type="button" aria-pressed="false">Known Sq Ft</button>
            </div>

            <div id="crusher-dims-fields" class="dim-grid">
              <div class="input-field">
                <label for="crusher-length">Length (Feet)</label>
                <input type="number" id="crusher-length" value="40" min="0.1" step="any" />
              </div>
              <div class="input-field">
                <label for="crusher-width">Width (Feet)</label>
                <input type="number" id="crusher-width" value="12" min="0.1" step="any" />
              </div>
            </div>

            <div id="crusher-sqft-field" class="dim-grid single-col" style="display: none;">
              <div class="input-field">
                <label for="crusher-area">Measured Area (Sq Ft)</label>
                <input type="number" id="crusher-area" value="480" min="1" step="any" />
              </div>
            </div>

            <div class="dim-grid">
              <div class="input-field">
                <label for="crusher-depth">Target Compacted Depth (Inches)</label>
                <input type="number" id="crusher-depth" value="4.0" min="0.25" max="24" step="any" />
              </div>
              <div class="input-field">
                <label for="crusher-density">Loose Bulk Weight (Short Tons/Yd&sup3;)</label>
                <input type="number" id="crusher-density" value={baseDensity} min="0.3" max="5" step="any" aria-describedby="crusher-assumptions" />
              </div>
            </div>

            <div class="unit-toggle" role="group" aria-label="Adjustment method">
              <button class="active" id="crusher-method-extra" type="button" aria-pressed="true">Order Increase % (+Extra)</button>
              <button id="crusher-method-shrink" type="button" aria-pressed="false">Compaction Loss % (Shrinkage)</button>
            </div>

            <div class="dim-grid single-col">
              <div class="input-field">
                <label for="crusher-compaction" id="crusher-factor-label">Loose-Order Increase (%)</label>
                <input type="number" id="crusher-compaction" value="20" min="0" max="40" step="any" aria-describedby="crusher-assumptions" />
              </div>
            </div>

            <p id="crusher-assumptions">Order Increase multiplies finished volume by (1 + %). Compaction Loss divides by (1 &minus; %) to show deeper loose fill needed before plate-compacting down to target thickness.</p>
            <p id="crusher-error" class="calc-error" role="alert" hidden></p>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h2>Required Material Totals</h2>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <span class="kpi-value" id="kpi-crusher-yards">0.00</span>
                <div class="kpi-label">Loose Order Volume (Cubic Yards)</div>
                <div class="kpi-subtext" id="kpi-crusher-loose">Includes adjustment</div>
              </div>
              <div class="kpi-card">
                <span class="kpi-value" id="kpi-crusher-tons">0.00</span>
                <div class="kpi-label">Estimated Short Tons</div>
                <div class="kpi-subtext" id="crusher-weight-note">At entered loose bulk weight</div>
              </div>
              <div class="kpi-card">
                <span class="kpi-value" id="kpi-crusher-finished">0.00</span>
                <div class="kpi-label">Finished Compacted Volume (Yd&sup3;)</div>
                <div class="kpi-subtext" id="kpi-crusher-area-sub">480 sq ft footprint</div>
              </div>
              <div class="kpi-card">
                <span class="kpi-value" id="kpi-crusher-loads">0.0</span>
                <div class="kpi-label">15-Ton Truck Equivalents</div>
                <div class="kpi-subtext">Arithmetic planning reference</div>
              </div>
            </div>

            <div class="compaction-diagram-card">
              <div class="diagram-title">Loose vs. Finished Layer Thickness</div>
              <div class="diagram-bars">
                <div class="bar-col">
                  <div class="bar-fill loose-bar" id="bar-loose"><span id="bar-loose-text">Loose: 4.8"</span></div>
                  <div class="bar-caption">Loose order depth</div>
                </div>
                <div class="bar-arrow">&rarr;</div>
                <div class="bar-col">
                  <div class="bar-fill compact-bar" id="bar-compact"><span id="bar-compact-text">Finished: 4.0"</span></div>
                  <div class="bar-caption">Finished base depth</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide on Crusher Run -->
    <article class="content-guide-section">
      <div class="container">
        <div class="content-card">
          <h2>Estimate the specified base layer</h2>
          <p>Crusher run and dense-graded aggregate (DGA) contain crushed stone mixed with mineral fines. When spread in moistened lifts and compacted, fines fill void space so the base locks rigidly under pavers, slabs, and driveways. Use the finished target thickness in the calculator above; switch between Order Increase % and Compaction Loss % depending on how your engineer or quarry specifies expansion.</p>

          <h2>Keep finished volume and loose order separate</h2>
          <p>Finished cubic yards = area (sq ft) &times; finished depth (in) &divide; 324. An order increase of 20% multiplies finished volume by 1.20. A shrinkage loss of 20% from loose to compacted thickness divides finished volume by (1 &minus; 0.20) = 0.80, giving a 1.25&times; multiplier (5.0 loose inches compacting to 4.0 finished inches).</p>

          <div class="table-wrap">
            <table class="base-table">
              <caption>Dense-graded base vs. open-graded clean stone comparison</caption>
              <thead>
                <tr>
                  <th scope="col">Product Name / Spec</th>
                  <th scope="col">Fines Content</th>
                  <th scope="col">Compaction Behavior</th>
                  <th scope="col">Best Structural Use</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">21-A / #411 / QP</th>
                  <td>High (stone dust to 3/4"–1")</td>
                  <td>High interlock &amp; dry density</td>
                  <td>Paver base, patio sub-base, gravel driveway cap</td>
                </tr>
                <tr>
                  <th scope="row">CA-6 / Class 2 Base</th>
                  <td>Controlled DOT blend</td>
                  <td>Structural engineered compaction</td>
                  <td>Heavy driveway aprons, shed pads, road base</td>
                </tr>
                <tr>
                  <th scope="row">Clean #57 Stone</th>
                  <td>Washed / &lt; 2% fines</td>
                  <td>Requires mechanical confinement</td>
                  <td>Open-graded French drains, permeable paver base</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2>Plan base and surface layers independently</h2>
          <p>Do not mix top decorative stone thickness into your compacted base calculation. Use our <a href="/layered-project-calculator">multi-layer project planner</a> when calculating both base rock and bedding sand/top stone in one order, or inspect regional base terminology in our <a href="/gravel-trade-names-by-state">aggregate trade names guide</a> and <a href="/gravel-sizes#57-stone">gravel sizes chart</a>.</p>

          <p><a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/">Penn State’s Center for Dirt and Gravel Road Studies</a> distinguishes loose shipped quantities from finished dimensions. Confirm the local supplier’s delivered weight per cubic yard and truck payload before scheduling dump deliveries.</p>

          <h2>Crusher run questions</h2>
          <div class="faq-list">
            {faqItems.map(item => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>

    <TopicClusterNav />
  </main>

  <Footer />

  <script>
    function initCrusherCalculator() {
      let areaMode: 'dims' | 'sqft' = 'dims';
      let factorMode: 'extra' | 'shrink' = 'extra';

      const dimsBtn = document.getElementById('crusher-area-dims');
      const sqftBtn = document.getElementById('crusher-area-sqft');
      const dimsFields = document.getElementById('crusher-dims-fields');
      const sqftField = document.getElementById('crusher-sqft-field');

      const extraBtn = document.getElementById('crusher-method-extra');
      const shrinkBtn = document.getElementById('crusher-method-shrink');
      const factorLabel = document.getElementById('crusher-factor-label');

      const presetBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset-btn'));
      const lengthEl = document.getElementById('crusher-length') as HTMLInputElement | null;
      const widthEl = document.getElementById('crusher-width') as HTMLInputElement | null;
      const areaEl = document.getElementById('crusher-area') as HTMLInputElement | null;
      const depthEl = document.getElementById('crusher-depth') as HTMLInputElement | null;
      const densityEl = document.getElementById('crusher-density') as HTMLInputElement | null;
      const factorEl = document.getElementById('crusher-compaction') as HTMLInputElement | null;
      const errorEl = document.getElementById('crusher-error');

      const set = (id: string, val: string) => {
        const node = document.getElementById(id);
        if (node) node.textContent = val;
      };

      function readNum(el: HTMLInputElement | null, min: number, max: number): number {
        if (!el || el.value.trim() === '') {
          el?.setAttribute('aria-invalid', 'true');
          return NaN;
        }
        const n = Number(el.value);
        const ok = Number.isFinite(n) && n >= min && n <= max;
        el.setAttribute('aria-invalid', String(!ok));
        return ok ? n : NaN;
      }

      function updateCrusher() {
        const depth = readNum(depthEl, 0.25, 24);
        const density = readNum(densityEl, 0.3, 5);
        const pct = readNum(factorEl, 0, factorMode === 'shrink' ? 40 : 100);

        let area = NaN;
        if (areaMode === 'dims') {
          areaEl?.removeAttribute('aria-invalid');
          const l = readNum(lengthEl, 0.1, 10000);
          const w = readNum(widthEl, 0.1, 10000);
          area = l * w;
        } else {
          lengthEl?.removeAttribute('aria-invalid');
          widthEl?.removeAttribute('aria-invalid');
          area = readNum(areaEl, 1, 10000000);
        }

        const valid = [area, depth, density, pct].every(Number.isFinite) && area > 0;
        if (errorEl) {
          errorEl.hidden = valid;
          errorEl.textContent = valid ? '' : 'Enter positive area, depth (0.25–24 in), loose bulk weight (0.3–5 t/yd³), and valid percentage.';
        }

        if (!valid) {
          ['kpi-crusher-yards', 'kpi-crusher-tons', 'kpi-crusher-finished', 'kpi-crusher-loads'].forEach(id => set(id, '—'));
          set('kpi-crusher-loose', 'Check inputs');
          return;
        }

        const finishedYards = (area * depth) / 324;
        const multiplier = factorMode === 'shrink'
          ? 1 / (1 - pct / 100)
          : 1 + pct / 100;
        const orderYards = finishedYards * multiplier;
        const tons = orderYards * density;
        const looseDepth = depth * multiplier;

        set('kpi-crusher-yards', orderYards.toFixed(2));
        set('kpi-crusher-tons', tons.toFixed(2));
        set('kpi-crusher-finished', finishedYards.toFixed(2));
        set('kpi-crusher-loads', (tons / 15).toFixed(1));
        set('kpi-crusher-loose', factorMode === 'shrink'
          ? `÷ ${(1 - pct / 100).toFixed(2)} for ${pct}% compaction shrinkage`
          : `+${pct}% loose-order allowance`);
        set('crusher-weight-note', `At ${density.toFixed(2)} short tons/yd³ loose density`);
        set('kpi-crusher-area-sub', `${Math.round(area).toLocaleString()} sq ft footprint`);

        set('bar-loose-text', `Loose: ${looseDepth.toFixed(1)}"`);
        set('bar-compact-text', `Finished: ${depth.toFixed(1)}"`);
        const looseBar = document.getElementById('bar-loose') as HTMLElement | null;
        const compactBar = document.getElementById('bar-compact') as HTMLElement | null;
        if (looseBar && compactBar) {
          looseBar.style.height = '100px';
          const ratio = Math.max(45, Math.min(100, (depth / looseDepth) * 100));
          compactBar.style.height = `${ratio.toFixed(0)}px`;
        }
      }

      presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          presetBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          if (densityEl && btn.dataset.density) densityEl.value = btn.dataset.density;
          if (factorEl && btn.dataset.loss) factorEl.value = btn.dataset.loss;
          updateCrusher();
        });
      });

      dimsBtn?.addEventListener('click', () => {
        areaMode = 'dims';
        dimsBtn.classList.add('active');
        dimsBtn.setAttribute('aria-pressed', 'true');
        sqftBtn?.classList.remove('active');
        sqftBtn?.setAttribute('aria-pressed', 'false');
        if (dimsFields) dimsFields.style.display = '';
        if (sqftField) sqftField.style.display = 'none';
        updateCrusher();
      });

      sqftBtn?.addEventListener('click', () => {
        areaMode = 'sqft';
        sqftBtn.classList.add('active');
        sqftBtn.setAttribute('aria-pressed', 'true');
        dimsBtn?.classList.remove('active');
        dimsBtn?.setAttribute('aria-pressed', 'false');
        if (dimsFields) dimsFields.style.display = 'none';
        if (sqftField) sqftField.style.display = '';
        updateCrusher();
      });

      extraBtn?.addEventListener('click', () => {
        factorMode = 'extra';
        extraBtn.classList.add('active');
        extraBtn.setAttribute('aria-pressed', 'true');
        shrinkBtn?.classList.remove('active');
        shrinkBtn?.setAttribute('aria-pressed', 'false');
        if (factorLabel) factorLabel.textContent = 'Loose-Order Increase (%)';
        if (factorEl) factorEl.max = '100';
        updateCrusher();
      });

      shrinkBtn?.addEventListener('click', () => {
        factorMode = 'shrink';
        shrinkBtn.classList.add('active');
        shrinkBtn.setAttribute('aria-pressed', 'true');
        extraBtn?.classList.remove('active');
        extraBtn?.setAttribute('aria-pressed', 'false');
        if (factorLabel) factorLabel.textContent = 'Compaction Shrinkage Loss (%)';
        if (factorEl) factorEl.max = '40';
        updateCrusher();
      });

      [lengthEl, widthEl, areaEl, depthEl, densityEl, factorEl].forEach(el => {
        el?.addEventListener('input', () => {
          if (el === densityEl) {
            presetBtns.forEach(b => {
              b.classList.remove('active');
              b.setAttribute('aria-pressed', 'false');
            });
          }
          updateCrusher();
        });
      });

      updateCrusher();
    }
    initCrusherCalculator();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .calc-panel-title h2 { margin: 0; color: var(--text-primary); font-size: var(--text-lg); font-weight: 700; }
  .preset-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-bottom: var(--space-4); }
  .preset-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.55rem 0.7rem;
    text-align: left;
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .preset-btn strong { display: block; font-size: var(--text-xs); color: var(--text-primary); }
  .preset-btn span { display: block; font-size: 11px; color: var(--text-muted); margin-top: 2px; }
  .preset-btn.active { border-color: var(--accent-gold); background: rgba(212, 168, 83, 0.1); }
  .unit-toggle {
    display: flex;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 3px;
    margin-bottom: var(--space-3);
    gap: 2px;
  }
  .unit-toggle button {
    flex: 1;
    padding: 0.5rem 0.35rem;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .unit-toggle button.active { background: var(--accent-gold); color: #000; }
  .dim-grid.single-col { grid-template-columns: 1fr; }
  .calc-panel .input-field input {
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-weight: 600;
  }
  .calc-error { color: var(--color-error); font-size: var(--text-xs); font-weight: 600; margin-top: var(--space-3); }
  .compaction-diagram-card {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
