---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import CivilStructuralBlock from '../components/intent/CivilStructuralBlock.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crusher Run Calculator', url: '/crusher-run-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Base Rock Coverage' },
  { label: 'Gradation Standard', value: 'AASHTO M147 Dense-Graded Base' },
  { label: 'Particle Caliper', value: '3/4" Minus Blended with Stone Flour' },
  { label: 'Bulk Density', value: '1.45 t/yd³ Loose | 1.65 t/yd³ Compacted' }
];

const quickStats = [
  { value: 'AASHTO M147', label: 'Base Standard', desc: 'Consolidates Quarry Process (QP), 21-A, and road base specifications' },
  { value: '1.45 t/yd³', label: 'Quarry Density', desc: 'ASTM C29 loose stockpile weight (2,900 lbs per cubic yard)' },
  { value: '20% Compaction', label: 'Plate Tamp Drop', desc: 'Volume loss as fine stone flour packs into larger aggregate voids' }
];

const faqItems = [
  {
    "q": "How much base is needed for a 12 × 24 ft area?",
    "a": "At a 4-inch finished depth the volume is 3.56 yd³. A selected 20% loose-order increase gives 4.27 yd³, about 6.19 US short tons at the example 1.45 tons per yard. Confirm both allowance and weight with the supplier."
  },
  {
    "q": "Are crusher run, QP and 21-A interchangeable?",
    "a": "They are regional product names that may refer to dense-graded blends, but do not guarantee the same grading, mineral source or approval. Ask for the actual product specification."
  },
  {
    "q": "Is one compaction percentage suitable everywhere?",
    "a": "No. The extra percentage in this tool is an order allowance above the finished volume. A measured loose-to-finished loss requires a different calculation; follow the product and project requirements."
  },
  {
    "q": "Can crusher run be used as a surface?",
    "a": "Some products are used for driveway surfaces as well as bases. Choose the grading and layer thickness for the planned use, drainage and ground conditions rather than the name alone."
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'How Much Rock Do I Need? (Intent Hub)', slug: '/how-much-rock-do-i-need', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: '1.40 t/yd³' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: '1.40 t/yd³' },
  { title: 'Landscape Stone Calculator', slug: '/landscape-stone-calculator', badge: '1.40 t/yd³' }
];

const bridgeLinks = [
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Yardage' },
  { title: 'Crushed Stone Tons Calculator', slug: '/crushed-stone-tons-calculator', badge: 'Tons Solver' }
];

const supportGuides = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Gravel Size Chart Explained', slug: '/gravel-sizes', badge: 'AASHTO M43' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech' }
];
---

<BaseLayout
  title="Crusher Run & Base Rock Coverage Calculator - Road Base & QP Tonnage"
  metaDescription="Calculate cubic yards, scale tons, and coverage of crusher run, base rock, quarry process (QP), and 21-A road base. AASHTO M147 compaction math for driveways and patios."
  canonicalPath="/crusher-run-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Crusher Run & Base Rock Coverage Calculator",
      "url": "https://rockcoveragecalculator.com/crusher-run-calculator",
      "description": "Calculates dense-graded crusher run, base rock, QP, and road base volume, compaction factors, and quarry scale tons.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Paving Installers, Hardscape Masons, Civil Contractors, Estimators"
      },
      "about": {
        "@type": "Thing",
        "name": "Base Rock Coverage"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Crusher Run & Base Rock Coverage Calculator"
      highlightWord="Base Rock"
      badge="AASHTO M147 Dense Base Engine"
      subtitle="Accurate volume and quarry scale tonnage calculations for crusher run, base rock, quarry process (QP), dense graded aggregate (DGA), and 21-A road base."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="civil"
    />

    <!-- Interactive Crusher Run Calculator Tool -->
    <section class="section">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h2>Crusher Run Base Dimensions</h2>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="crusher-length">Length (Feet)</label>
              <input type="number" id="crusher-length" value="40" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="crusher-width">Width (Feet)</label>
              <input type="number" id="crusher-width" value="12" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="crusher-depth">Target Compacted Depth (Inches)</label>
              <input type="number" id="crusher-depth" value="4.0" min="1" max="18" step="0.5" />
            </div>
            <div class="input-field">
              <label for="crusher-compaction">Compaction Factor (%)</label>
              <input type="number" id="crusher-compaction" value="20" min="10" max="30" step="1" />
            </div>
          </div>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h2>Required Material Totals</h2>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
              <div class="kpi-value" id="kpi-crusher-yards">0.00</div>
              <div class="kpi-label">Order Volume (Cubic Yards)</div>
              <div class="kpi-subtext" id="kpi-crusher-loose">Includes 20% compaction buffer</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-crusher-tons">0.00</div>
              <div class="kpi-label">Quarry Weight (Tons)</div>
              <div class="kpi-subtext">At 1.45 t/yd³ (2,900 lbs/yd³)</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-crusher-loads">0.0</div>
              <div class="kpi-label">Tri-Axle Truckloads</div>
              <div class="kpi-subtext">15 tons per load</div>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Civil Truckload Logistics & Subgrade Stabilization Block -->
    <CivilStructuralBlock />

    <!-- Technical Guide on Crusher Run -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Estimate the specified base layer</h2><p>Crusher run and other dense-graded base products contain a mix of particle sizes and fines. Actual grading and placement requirements vary. Use the material and finished thickness selected for the project; this calculator does not establish structural support or drainage performance.</p><h2>Keep finished volume and loose order separate</h2><p>Finished cubic yards = length × width × depth in inches ÷ 324. The order allowance then increases that quantity. A 20% extra order multiplies by 1.20. If a supplier instead specifies a 20% reduction from loose to finished volume, divide by 0.80, giving a 1.25 multiplier. These are different assumptions.</p><p>For a 12 × 24 ft area at 4 inches, the finished volume is 3.56 yd³. With a chosen 20% order increase and the example 1.45 US tons per loose yard, the estimate is 4.27 yd³ or 6.19 tons. Ask for your actual product’s loose bulk weight and allowance.</p><h2>Plan base and surface independently</h2><p>Do not include a separate decorative surface in the base depth. Use the <a href="/layered-project-calculator">multi-layer planner</a> for a base, top stone and optional supplies. Material names and numbered gradings do not automatically specify the soil separation, moisture conditioning, lift thickness or compaction procedure needed on site.</p><p><a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/">Penn State’s materials calculator</a> distinguishes loose shipped quantities from finished dimensions. Confirm the actual supplier product before using a generic factor.</p><h2>Crusher run questions</h2>{faqItems.map(item=><section><h3>{item.q}</h3><p>{item.a}</p></section>)}</div></div></article>

    <TopicClusterNav
      currentPage="/crusher-run-calculator"
      category="material"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateCrusher() {
      const l = parseFloat((document.getElementById('crusher-length') as HTMLInputElement)?.value) || 0;
      const w = parseFloat((document.getElementById('crusher-width') as HTMLInputElement)?.value) || 0;
      const d = parseFloat((document.getElementById('crusher-depth') as HTMLInputElement)?.value) || 0;
      const c = parseFloat((document.getElementById('crusher-compaction') as HTMLInputElement)?.value) || 20;

      const netYards = (l * w * d) / 324;
      const orderYards = netYards * (1 + c / 100);
      const tons = orderYards * 1.45;
      const loads = tons / 15;

      const yEl = document.getElementById('kpi-crusher-yards');
      const tEl = document.getElementById('kpi-crusher-tons');
      const lEl = document.getElementById('kpi-crusher-loads');

      if (yEl) yEl.innerText = orderYards.toFixed(2);
      if (tEl) tEl.innerText = tons.toFixed(2);
      if (lEl) lEl.innerText = loads.toFixed(1);
    }

    ['crusher-length', 'crusher-width', 'crusher-depth', 'crusher-compaction'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateCrusher);
    });
    updateCrusher();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }
  .aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--accent-gold); }
  .aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .aeo-quick-item { background: var(--bg-surface); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); margin-bottom: 2px; }
  .aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .aeo-quick-desc { font-size: 11px; color: var(--text-muted); margin: 0; line-height: 1.35; }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .content-card h3 { font-size: var(--text-xl); color: var(--text-primary); margin: var(--space-6) 0 var(--space-3) 0; }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .steps-list { padding-left: var(--space-6); margin: var(--space-4) 0; }
  .steps-list li { margin-bottom: var(--space-3); }
  .faq-card { margin-top: var(--space-8); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-item h3 { font-size: var(--text-base); color: var(--text-primary); margin: 0 0 var(--space-2) 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--text-muted); margin: 0; }
</style>
