  <Footer />

  <script>
    const lavaIds = ['lava-length', 'lava-width', 'lava-area', 'lava-depth', 'lava-extra', 'lava-density', 'lava-bag'];
    const lavaInput = (id: string) => document.getElementById(id) as HTMLInputElement;
    const lavaOut = (id: string, value: string) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    };
    const lavaNumber = (id: string, min: number, max: number) => {
      const field = lavaInput(id);
      const value = Number(field.value);
      const valid = field.value.trim() !== '' && Number.isFinite(value) && value >= min && value <= max;
      field.setAttribute('aria-invalid', String(!valid));
      return valid ? value : NaN;
    };
    function updateLavaRock() {
      const mode = (document.querySelector('input[name="lava-mode"]:checked') as HTMLInputElement)?.value || 'rectangle';
      const rectangle = document.getElementById('lava-rectangle-fields') as HTMLElement;
      const areaFields = document.getElementById('lava-area-fields') as HTMLElement;
      rectangle.hidden = mode !== 'rectangle';
      areaFields.hidden = mode !== 'area';
      for (const id of mode === 'rectangle' ? ['lava-area'] : ['lava-length', 'lava-width']) {
        lavaInput(id).removeAttribute('aria-invalid');
      }
      const area = mode === 'rectangle' ? lavaNumber('lava-length', 0.01, 100000) * lavaNumber('lava-width', 0.01, 100000) : lavaNumber('lava-area', 0.01, 100000000);
      const depth = lavaNumber('lava-depth', 0.25, 12);
      const extra = lavaNumber('lava-extra', 0, 100);
      const density = lavaNumber('lava-density', 100, 10000);
      const bag = lavaNumber('lava-bag', 0.01, 100);
      const valid = [area, depth, extra, density, bag].every(Number.isFinite) && area <= 100000000;
      const error = document.getElementById('lava-error') as HTMLElement;
      error.textContent = valid ? '' : 'Enter positive measurements and product values within the shown ranges.';
      if (!valid) {
        for (const id of ['lava-installed-yards', 'lava-installed-feet', 'lava-order-yards', 'lava-order-tons', 'lava-order-bags', 'lava-result-area']) lavaOut(id, '—');
        lavaOut('lava-result-summary', '');
        return;
      }
      const installedFeet = area * depth / 12;
      const installedYards = installedFeet / 27;
      const orderFeet = installedFeet * (1 + extra / 100);
      const orderYards = orderFeet / 27;
      const tons = orderYards * density / 2000;
      const bags = Math.max(1, Math.ceil(orderFeet / bag - 1e-10));
      lavaOut('lava-installed-yards', installedYards.toFixed(2));
      lavaOut('lava-installed-feet', installedFeet.toFixed(2));
      lavaOut('lava-order-yards', orderYards.toFixed(2));
      lavaOut('lava-order-tons', tons < 0.01 ? tons.toFixed(3) : tons.toFixed(2));
      lavaOut('lava-order-bags', bags.toLocaleString());
      lavaOut('lava-result-area', area.toLocaleString(undefined, { maximumFractionDigits: 2 }));
      lavaOut('lava-assumptions', 'At ' + density.toLocaleString() + ' lb/cu yd and ' + bag.toLocaleString() + ' cu ft per bag. Bulk sellers may round to a minimum or delivery increment.');
      lavaOut('lava-result-summary', 'Estimate: ' + orderYards.toFixed(2) + ' cubic yards to order, about ' + tons.toFixed(2) + ' US short tons or ' + bags.toLocaleString() + ' whole bags.');
    }
    lavaIds.forEach(id => lavaInput(id)?.addEventListener('input', updateLavaRock));
    document.querySelectorAll('input[name="lava-mode"]').forEach(input => input.addEventListener('change', updateLavaRock));
    updateLavaRock();
  </script>
</BaseLayout>

