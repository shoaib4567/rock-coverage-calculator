const supportGuides = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Layer depth' },
  { title: 'How to Stop Weeds in Landscape Rock', slug: '/how-to-stop-weeds-in-landscape-rock', badge: 'Maintenance' }
];
