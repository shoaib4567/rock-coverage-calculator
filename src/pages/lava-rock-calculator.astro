import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Lava Rock Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: pageTitle, url: '/lava-rock-calculator' }
];
const entityTags = [
  { label: 'Material', value: 'Landscape lava rock (scoria)' },
  { label: 'Order units', value: 'Cubic yards, US short tons, whole bags' },
  { label: 'Key detail', value: 'Check the supplier weight and bag volume' }
];
const faqItems = [
  {
    q: 'How much lava rock do I need for a 10 × 10 foot bed?',
    a: 'At 2 inches deep, a 100-square-foot bed needs 16.67 cubic feet, or 0.62 cubic yard, before extra. That is 34 whole bags if each bag holds 0.5 cubic foot. At the example loose bulk weight of 1,500 pounds per cubic yard, the net volume weighs about 0.46 US short ton.'
  },
  {
    q: 'How many cubic yards are in one ton of lava rock?',
    a: 'It depends on the actual loose bulk weight. At an example 1,500 pounds per cubic yard, one US short ton is about 1.33 cubic yards. At 1,250 pounds per yard it is 1.60 yards. Ask the supplier for the weight of the product and size you will receive.'
  },
  {
    q: 'What depth should I enter for a lava rock bed?',
    a: 'Enter the finished depth you want on the ground. A 2-inch example is useful for a decorative layer, but the right depth depends on stone size, site, and planting. Measure the surface after grading; if the bed is uneven, add an allowance based on your site rather than assuming a universal percentage.'
  },
  {
    q: 'Does lava rock stop weeds or cool plant roots?',
    a: 'A maintained rock layer can reduce light at the soil, but windblown soil and leaves can collect between stones and support new weeds. Dark rock can warm soil in strong sun. Keep rock away from plant crowns, remove debris, and decide whether fabric is useful for your planting plan.'
  },
  {
    q: 'Can I put landscaping lava rock in a gas fire pit?',
    a: 'Do not assume a landscaping bag is approved for a burner. Some retail landscape-lava products explicitly exclude fire-pit use. Choose media approved by the appliance maker and follow its fill-depth, vent, moisture, and lighting instructions. Wet fire media can pop.'
  }
];
const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'All materials' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'Measuring' }
];
const lateralLinks = [
  { title: 'Lava Rock Coverage Calculator', slug: '/lava-rock-coverage-calculator', badge: 'Area from supply' },
  { title: 'Lava Rock Bag Calculator', slug: '/lava-rock-bag-calculator', badge: 'Whole bags' }
];
const bridgeLinks = [
  { title: 'Decorative Rock Calculator', slug: '/decorative-rock-calculator', badge: 'Compare materials' },
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Bulk weight' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Buying' }
