---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Lava Rock Calculator: Yards, Bags & Coverage Area';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Lava Rock Calculator', url: '/lava-rock-calculator' }
];
const entityTags = [
  { label: 'Material', value: 'Vesicular volcanic scoria (red or black lava rock)' },
  { label: 'Order units', value: 'Cubic yards, short tons (2,000 lb), whole bags, reverse coverage' },
  { label: 'Bulk density', value: '1,250–1,500 lb/cu yd typical (editable)' }
];
const faqItems = [
  {
    q: 'How much lava rock do I need for a 10 × 10 foot bed?',
    a: 'At 2 inches deep, a 100-square-foot bed needs 16.67 cubic feet, or 0.62 cubic yard, before extra. That is 34 whole bags if each bag holds 0.5 cubic foot. At an example loose bulk weight of 1,500 pounds per cubic yard, the net volume weighs about 0.46 short ton.'
  },
  {
    q: 'How many cubic yards or square feet are in one ton of lava rock?',
    a: 'At 1,500 pounds per cubic yard, one short ton yields 1.33 cubic yards and covers about 216 square feet at 2 inches deep. At 1,250 pounds per yard it yields 1.60 cubic yards (259 sq ft at 2 in). Switch the calculator mode above to Reverse: Stock → Area to check your exact quantity.'
  },
  {
    q: 'What depth should I enter for a lava rock bed?',
    a: 'Enter the finished depth you want on the ground. Two inches works well for standard 3/4- to 1.5-inch landscape lava rock; larger decorative cobble scoria needs 3 inches so fabric stays hidden. Measure after grading.'
  },
  {
    q: 'Does lava rock stop weeds or warm soil around plants?',
    a: 'A clean rock layer blocks sunlight, though windblown dust and leaves eventually collect in the voids and allow surface weeds to sprout. Dark basaltic or red lava rock absorbs solar heat—keep stones a few inches back from plant crowns and trunks.'
  },
  {
    q: 'Can I put landscaping lava rock in a gas fire pit?',
    a: 'Do not assume a retail landscape bag is approved for a gas burner. Many landscaping lava products explicitly exclude fire-pit use. Only use fire-rated media specified by your appliance manufacturer and never burn wet volcanic stone, which can trap moisture and spall.'
  }
];
---

<BaseLayout
  title={pageTitle}
  description="How many bags or yards of lava rock? Measure any landscape bed to get 0.5-cu-ft bags, cubic yards, and weight at 1,250–1,500 lb/yd³, or calculate coverage from existing stock."
  canonicalPath="/lava-rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/lava-rock-calculator',
      description: 'Estimates landscape lava rock volume, short tons, whole-bag count, and reverse square-foot coverage from existing bulk or bagged stock.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>
  <Header />
  <main id="main-content">
    <PageHero
      title={pageTitle}
      highlightWord="Calculator:"
      badge="Landscape lava rock & reverse coverage"
      subtitle="A 10 × 10 ft bed at 2 in deep takes 16.67 cu ft (0.62 yd³ or 34 half-cubic-foot bags). Calculate forward from your bed measurements or switch to Reverse mode to see how far existing yards, short tons, or bags will spread."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      theme="decorative"
    />

    <section class="lava-section" id="lava-tool" aria-labelledby="lava-tool-title">
      <div class="container">
        <div class="lava-heading">
          <div>
            <p class="lava-eyebrow">From bed to order</p>
            <h2 id="lava-tool-title">Measure your bed or check coverage from stock</h2>
          </div>
          <p>Volume depends on square footage and finished depth. Because vesicular scoria weighs much less per cubic yard than dense river rock or limestone, confirm your supplier’s loose bulk weight before buying by the short ton.</p>
        </div>
        <div class="lava-tool-grid">
          <div class="lava-card lava-inputs">
            <fieldset class="lava-mode">
              <legend>Calculation mode</legend>
              <label><input type="radio" name="lava-mode" value="rectangle" checked /> Length &times; width</label>
              <label><input type="radio" name="lava-mode" value="area" /> Square feet</label>
              <label><input type="radio" name="lava-mode" value="reverse" /> Stock &rarr; Area</label>
            </fieldset>
            <div class="lava-fields" id="lava-rectangle-fields">
              <div class="lava-field"><label for="lava-length">Length <span>(ft)</span></label><input id="lava-length" type="number" value="10" min="0.01" step="any" inputmode="decimal" /></div>
              <div class="lava-field"><label for="lava-width">Width <span>(ft)</span></label><input id="lava-width" type="number" value="10" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="lava-fields" id="lava-area-fields" hidden>
              <div class="lava-field"><label for="lava-area">Measured area <span>(sq ft)</span></label><input id="lava-area" type="number" value="100" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="lava-fields" id="lava-reverse-fields" hidden>
              <div class="lava-field"><label for="lava-reverse-qty">Available stock</label><input id="lava-reverse-qty" type="number" value="2" min="0.01" step="any" inputmode="decimal" /></div>
              <div class="lava-field">
                <label for="lava-reverse-unit">Stock unit</label>
                <select id="lava-reverse-unit">
                  <option value="yards">Cubic yards (yd&sup3;)</option>
                  <option value="tons">Short tons (2,000 lb)</option>
                  <option value="bags">Bags (using bag volume)</option>
                </select>
              </div>
            </div>
            <div class="lava-fields">
              <div class="lava-field"><label for="lava-depth">Finished layer depth <span>(in)</span></label><input id="lava-depth" type="number" value="2" min="0.25" max="12" step="any" inputmode="decimal" /></div>
              <div class="lava-field"><label for="lava-extra">Optional extra <span>(%)</span></label><input id="lava-extra" type="number" value="0" min="0" max="100" step="any" inputmode="decimal" aria-describedby="lava-extra-help" /></div>
            </div>
            <p class="lava-help" id="lava-extra-help">Use extra only for uneven ground, spillage, or another site-specific reason. In Stock &rarr; Area mode, set to 0% for raw theoretical coverage.</p>
            <div class="lava-divider"></div>
            <div class="lava-fields">
              <div class="lava-field"><label for="lava-density">Supplier loose bulk weight <span>(lb/cu yd)</span></label><input id="lava-density" type="number" value="1500" min="100" max="10000" step="any" inputmode="decimal" aria-describedby="lava-density-help" /></div>
              <div class="lava-field"><label for="lava-bag">Volume on bag label <span>(cu ft)</span></label><input id="lava-bag" type="number" value="0.5" min="0.01" max="100" step="any" inputmode="decimal" /></div>
            </div>
            <p class="lava-help" id="lava-density-help">1,500 lb/cu yd is a planning midpoint across suppliers ranging from 1,250 to 1,500 lb/cu yd.</p>
            <p class="lava-error" id="lava-error" role="status" aria-live="polite"></p>
          </div>
          <div class="lava-card lava-results">
            <p class="lava-eyebrow" id="lava-result-eyebrow">Your measured layer</p>
            <div class="lava-primary"><output id="lava-primary-val">0.62</output><span id="lava-primary-unit">cu yd installed</span></div>
            <p class="lava-result-note" id="lava-secondary-note"><output id="lava-installed-feet">16.67</output> cu ft before optional extra</p>
            <div class="lava-result-grid">
              <div><span id="lava-g1-label">Planned bulk volume</span><strong><output id="lava-order-yards">0.62</output> <span id="lava-g1-unit">cu yd</span></strong></div>
              <div><span id="lava-g2-label">Estimated short tons</span><strong><output id="lava-order-tons">0.46</output> <span id="lava-g2-unit">tons</span></strong></div>
              <div><span id="lava-g3-label">Whole bags</span><strong><output id="lava-order-bags">34</output> <span id="lava-g3-unit">bags</span></strong></div>
              <div><span id="lava-g4-label">Measured area</span><strong><output id="lava-result-area">100</output> <span id="lava-g4-unit">sq ft</span></strong></div>
            </div>
            <p class="lava-result-note" id="lava-assumptions">At 1,500 lb/cu yd and 0.5 cu ft per bag. Bulk sellers may round to a minimum or delivery increment.</p>
            <p class="lava-screen-reader" id="lava-result-summary" aria-live="polite"></p>
            <a href="/lava-rock-bag-calculator">Plan bag cost, pallet count, and carrying weight &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <article class="lava-guide">
      <div class="container">
        <section class="lava-guide-grid" aria-labelledby="lava-example-title">
          <div class="lava-prose">
            <p class="lava-eyebrow">Work through the order</p>
            <h2 id="lava-example-title">What the 10 &times; 10 foot example means</h2>
            <p>First measure the <em>clear stone area</em>. Subtract large planters, paths, and other spaces that will stay uncovered. Multiply 100 square feet by a 2-inch layer (2 &divide; 12 foot) to get 16.67 cubic feet. Divide by 27 to get 0.62 cubic yard. That volume stays the same whether the stone is red or black, though bulk weight changes with particle size, vesicle porosity, and moisture.</p>
            <p>At 1,500 lb/cu yd, 0.62 cubic yard weighs about 926 lb, or 0.46 short ton. Half-cubic-foot bags need whole-number rounding: 16.67 &divide; 0.5 = 33.33, so buy 34 before any chosen extra. Bulk yards frequently sell in half-yard or whole-yard steps, so confirm minimum delivery increments.</p>
            <div class="lava-formula" aria-label="Lava rock volume formulas">
              <p><strong>Cubic feet</strong> = area (sq ft) &times; depth (in) &divide; 12</p>
              <p><strong>Cubic yards</strong> = cubic feet &divide; 27</p>
              <p><strong>Short tons</strong> = order yards &times; supplier lb/yd&sup3; &divide; 2,000</p>
            </div>
          </div>
          <figure class="lava-figure">
            <img src="/lava-rock-bed-depth.svg" width="880" height="390" loading="lazy" alt="Diagram of a 10 by 10 foot lava-rock bed with a 2 inch layer, equal to 16.67 cubic feet." />
            <figcaption>Measure the finished stone layer after preparing the bed. Size the layer by volume before converting it to weight or bags.</figcaption>
          </figure>
        </section>

        <section class="lava-info" aria-labelledby="lava-material-title">
          <h2 id="lava-material-title">Choose landscape lava rock for the job</h2>
          <div class="lava-info-grid">
            <div>
              <h3>Scoria and product size</h3>
              <p>Landscape “lava rock” is usually vesicular volcanic stone (scoria). Its air pockets make it roughly half the weight per cubic yard of dense basalt or river rock. Check the gradation size range: coarse 3/4–1.5 inch decorative scoria needs a deeper bed than fine lava cinders.</p>
            </div>
            <div>
              <h3>Depth and uneven beds</h3>
              <p>Match bed depth to the largest piece diameter so underlying fabric stays hidden. Divide curved beds into rectangles or measure square footage directly, using Reverse mode above whenever you are splitting an existing bulk delivery across multiple beds.</p>
            </div>
            <div>
              <h3>Plants and upkeep</h3>
              <p>Rock does not decompose like bark mulch, but leaves and blown soil accumulate in its pockets and support weeds. Rinse or blow foliage off the stones periodically and leave a bare mulched clearance collar around sensitive stems and roots.</p>
            </div>
            <div>
              <h3>Fire features need approved media</h3>
              <p>This calculator sizes a <strong>landscape bed</strong>, not burner pan media. Retail landscape lava bags frequently warn against fire-pit use. Only install manufacturer-approved dry fire stone or lava glass in gas burners and follow the appliance’s venting instructions.</p>
            </div>
          </div>
        </section>

        <section class="lava-paths" aria-labelledby="lava-next-title">
          <h2 id="lava-next-title">Continue your project</h2>
          <div class="lava-path-grid">
            <a href="/lava-rock-bag-calculator"><strong>Buying retail bags?</strong><span>Use bag label volume and weight to count bags, estimate pallets, and plan transport.</span></a>
            <a href="/decorative-rock-calculator"><strong>Compare decorative stone</strong><span>Check quantities across marble chips, beach pebbles, river rock, and scoria.</span></a>
            <a href="/rock-density-chart"><strong>Buying by weight?</strong><span>Compare loose bulk weights per cubic yard across all stone types.</span></a>
          </div>
        </section>

        <section class="lava-faq" aria-labelledby="lava-faq-title">
          <h2 id="lava-faq-title">Lava rock planning questions</h2>
          {faqItems.map(item => <div><h3>{item.q}</h3><p>{item.a}</p></div>)}
        </section>

        <section class="lava-sources" aria-labelledby="lava-sources-title">
          <h2 id="lava-sources-title">Product and field references</h2>
          <p>Bulk weights draw from published supplier specifications: <a href="https://www.landscapecentre.com/products/bulk-materials/lava-rock">Landscape Centre (1,250 lb/yd&sup3;)</a>, <a href="https://www.palmercokingcoal.com/products/lava-rock">Palmer Coking Coal (1,300–1,500 lb/yd&sup3;)</a>, and <a href="https://www.sutherlandscape.com/products/lava-rock-black/">Sutherland's black lava (1,420 lb/yd&sup3;)</a>. <a href="https://yardandgarden.extension.iastate.edu/how-to/using-mulch-garden">Iowa State Extension</a> documents rock mulch soil heat and organic maintenance considerations.</p>
        </section>
      </div>
    </article>

    <TopicClusterNav />
  </main>
  <Footer />

  <script>
    const lavaIds = ['lava-length', 'lava-width', 'lava-area', 'lava-reverse-qty', 'lava-depth', 'lava-extra', 'lava-density', 'lava-bag'];
    const lavaInput = (id: string) => document.getElementById(id) as HTMLInputElement;
    const lavaOut = (id: string, value: string) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    };
    const formatTons = (t: number) => (t > 0 && t < 0.01 ? t.toFixed(3) : t.toFixed(2));
    const lavaNumber = (id: string, min: number, max: number) => {
      const field = lavaInput(id);
      const value = Number(field.value);
      const valid = field.value.trim() !== '' && Number.isFinite(value) && value >= min && value <= max;
      field.setAttribute('aria-invalid', String(!valid));
      return valid ? value : NaN;
    };
    function updateLavaRock() {
      const mode = (document.querySelector('input[name="lava-mode"]:checked') as HTMLInputElement)?.value || 'rectangle';
      const rectangle = document.getElementById('lava-rectangle-fields') as HTMLElement;
      const areaFields = document.getElementById('lava-area-fields') as HTMLElement;
      const revFields = document.getElementById('lava-reverse-fields') as HTMLElement;
      rectangle.hidden = mode !== 'rectangle';
      areaFields.hidden = mode !== 'area';
      revFields.hidden = mode !== 'reverse';

      if (mode !== 'rectangle') ['lava-length', 'lava-width'].forEach(id => lavaInput(id)?.removeAttribute('aria-invalid'));
      if (mode !== 'area') lavaInput('lava-area')?.removeAttribute('aria-invalid');
      if (mode !== 'reverse') lavaInput('lava-reverse-qty')?.removeAttribute('aria-invalid');

      const depth = lavaNumber('lava-depth', 0.25, 12);
      const extra = lavaNumber('lava-extra', 0, 100);
      const density = lavaNumber('lava-density', 100, 10000);
      const bag = lavaNumber('lava-bag', 0.01, 100);
      const error = document.getElementById('lava-error') as HTMLElement;

      if (mode === 'reverse') {
        const qty = lavaNumber('lava-reverse-qty', 0.01, 1000000);
        const unit = (document.getElementById('lava-reverse-unit') as HTMLSelectElement)?.value || 'yards';
        const valid = [qty, depth, extra, density, bag].every(Number.isFinite);
        error.textContent = valid ? '' : 'Enter positive stock quantity and product values within the shown ranges.';

        lavaOut('lava-result-eyebrow', 'Estimated Coverage Area');
        lavaOut('lava-primary-unit', 'sq ft covered');
        lavaOut('lava-g1-label', 'Bulk volume');
        lavaOut('lava-g1-unit', 'cu yd');
        lavaOut('lava-g2-label', 'Estimated short tons');
        lavaOut('lava-g2-unit', 'tons');
        lavaOut('lava-g3-label', 'Bag equivalent');
        lavaOut('lava-g3-unit', 'bags');
        lavaOut('lava-g4-label', 'Max theoretical area');
        lavaOut('lava-g4-unit', 'sq ft');

        if (!valid) {
          ['lava-primary-val', 'lava-order-yards', 'lava-order-tons', 'lava-order-bags', 'lava-result-area'].forEach(id => lavaOut(id, '—'));
          lavaOut('lava-secondary-note', 'Check inputs to estimate coverage.');
          lavaOut('lava-result-summary', '');
          return;
        }

        let yards = qty;
        if (unit === 'tons') yards = (qty * 2000) / density;
        if (unit === 'bags') yards = (qty * bag) / 27;

        const cuFt = yards * 27;
        const maxArea = (cuFt * 12) / depth;
        const plannedArea = maxArea / (1 + extra / 100);
        const tons = (yards * density) / 2000;
        const bags = Math.max(1, Math.ceil(cuFt / bag - 1e-10));

        lavaOut('lava-primary-val', Math.round(plannedArea).toLocaleString());
        lavaOut('lava-secondary-note', `${cuFt.toFixed(1)} cu ft stock at ${depth} in depth (${extra}% allowance)`);
        lavaOut('lava-order-yards', yards.toFixed(2));
        lavaOut('lava-order-tons', formatTons(tons));
        lavaOut('lava-order-bags', bags.toLocaleString());
        lavaOut('lava-result-area', Math.round(maxArea).toLocaleString());
        lavaOut('lava-assumptions', `At ${density.toLocaleString()} lb/cu yd and ${bag.toLocaleString()} cu ft per bag.`);
        lavaOut('lava-result-summary', `Estimate: covers about ${Math.round(plannedArea).toLocaleString()} square feet at ${depth} inches deep.`);
        return;
      }

      lavaOut('lava-result-eyebrow', 'Your measured layer');
      lavaOut('lava-primary-unit', 'cu yd installed');
      lavaOut('lava-g1-label', 'Planned bulk volume');
      lavaOut('lava-g1-unit', 'cu yd');
      lavaOut('lava-g2-label', 'Estimated short tons');
      lavaOut('lava-g2-unit', 'tons');
      lavaOut('lava-g3-label', 'Whole bags');
      lavaOut('lava-g3-unit', 'bags');
      lavaOut('lava-g4-label', 'Measured area');
      lavaOut('lava-g4-unit', 'sq ft');

      const area = mode === 'rectangle'
        ? lavaNumber('lava-length', 0.01, 100000) * lavaNumber('lava-width', 0.01, 100000)
        : lavaNumber('lava-area', 0.01, 100000000);
      const valid = [area, depth, extra, density, bag].every(Number.isFinite) && area <= 100000000;
      error.textContent = valid ? '' : 'Enter positive measurements and product values within the shown ranges.';
      if (!valid) {
        for (const id of ['lava-primary-val', 'lava-installed-feet', 'lava-order-yards', 'lava-order-tons', 'lava-order-bags', 'lava-result-area']) lavaOut(id, '—');
        lavaOut('lava-secondary-note', 'Check inputs to calculate.');
        lavaOut('lava-result-summary', '');
        return;
      }
      const installedFeet = area * depth / 12;
      const installedYards = installedFeet / 27;
      const orderFeet = installedFeet * (1 + extra / 100);
      const orderYards = orderFeet / 27;
      const tons = orderYards * density / 2000;
      const bags = Math.max(1, Math.ceil(orderFeet / bag - 1e-10));
      lavaOut('lava-primary-val', installedYards.toFixed(2));
      lavaOut('lava-secondary-note', `${installedFeet.toFixed(2)} cu ft before optional extra`);
      lavaOut('lava-order-yards', orderYards.toFixed(2));
      lavaOut('lava-order-tons', formatTons(tons));
      lavaOut('lava-order-bags', bags.toLocaleString());
      lavaOut('lava-result-area', area.toLocaleString(undefined, { maximumFractionDigits: 2 }));
      lavaOut('lava-assumptions', `At ${density.toLocaleString()} lb/cu yd and ${bag.toLocaleString()} cu ft per bag. Bulk sellers may round to a minimum or delivery increment.`);
      lavaOut('lava-result-summary', `Estimate: ${orderYards.toFixed(2)} cubic yards to order, about ${formatTons(tons)} short tons or ${bags.toLocaleString()} whole bags.`);
    }
    lavaIds.forEach(id => lavaInput(id)?.addEventListener('input', updateLavaRock));
    document.getElementById('lava-reverse-unit')?.addEventListener('change', updateLavaRock);
    document.querySelectorAll('input[name="lava-mode"]').forEach(input => input.addEventListener('change', updateLavaRock));
    updateLavaRock();
  </script>
</BaseLayout>

<style>
  .lava-section, .lava-guide { padding: clamp(2.5rem, 5vw, 5rem) 0; }
  .lava-section { background: linear-gradient(180deg, #15232a, #1d2b32); }
  .lava-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end; margin-bottom: 1.5rem; }
  .lava-heading h2 { color: #fff; font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.16; }
  .lava-heading > p { color: #d4e0e1; line-height: 1.7; }
  .lava-eyebrow { color: #f2a97a; font-size: .78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; margin: 0 0 .6rem; }
  .lava-tool-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 1.25rem; }
  .lava-card { border: 1px solid #405961; border-radius: 20px; padding: clamp(1.2rem, 3vw, 2rem); background: #21333a; color: #f5f8f6; min-width: 0; }
  .lava-mode { border: 0; margin: 0 0 1.35rem; padding: 0; display: flex; gap: .75rem; flex-wrap: wrap; }
  .lava-mode legend { font-weight: 750; padding-bottom: .6rem; }
  .lava-mode label { display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .7rem; border: 1px solid #60777c; border-radius: 999px; cursor: pointer; font-size: .9rem; }
  .lava-mode input { accent-color: #f2a97a; }
  .lava-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; margin-bottom: .85rem; }
  .lava-fields[hidden] { display: none; }
  .lava-field { min-width: 0; }
  .lava-field label { display: block; font-size: .89rem; font-weight: 700; margin-bottom: .35rem; }
  .lava-field label span { font-weight: 400; color: #b9cbcc; }
  .lava-field input, .lava-field select { box-sizing: border-box; width: 100%; min-height: 2.9rem; padding: .6rem .75rem; border-radius: 9px; border: 1px solid #8ca0a0; background: #f9fbfa; color: #16282b; font: inherit; }
  .lava-field input[aria-invalid="true"] { outline: 2px solid #ff9b82; border-color: #ff9b82; }
  .lava-help { color: #c1d1d2; font-size: .82rem; line-height: 1.5; margin: -.2rem 0 1.05rem; }
  .lava-divider { border-top: 1px solid #577077; margin: 1.2rem 0; }
  .lava-error { min-height: 1.2rem; color: #ffd1c4; font-weight: 700; margin: 0; }
  .lava-results { background: #fff8ed; color: #263438; border-color: #ddbda3; display: flex; flex-direction: column; }
  .lava-primary { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; margin: .4rem 0; }
  .lava-primary output { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 850; line-height: 1; color: #983f2e; }
  .lava-primary span { font-weight: 800; }
  .lava-result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin: 1.2rem 0; }
