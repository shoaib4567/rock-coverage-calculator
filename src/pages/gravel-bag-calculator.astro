---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Gravel Bag Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gravel Calculator', url: '/gravel-calculator' },
  { name: pageTitle, url: '/gravel-bag-calculator' }
];
const entityTags = [
  { label: 'Measure', value: 'Area × finished depth' },
  { label: 'Read the bag', value: 'Cubic feet, weight, gravel type' },
  { label: 'Buy', value: 'Whole bags at your local price' }
];
const faqItems = [
  {
    q: 'How many bags of gravel cover 100 square feet?',
    a: 'At 2 inches deep, 100 square feet needs 16.67 cubic feet. That is 34 whole bags if each bag contains 0.5 cubic foot, before extra. At 3 inches deep, the same area needs 50 such bags. Read your product’s volume label and change the calculator if its bag size differs.'
  },
  {
    q: 'How much does one bag of gravel cover?',
    a: 'A 0.5-cubic-foot bag covers 3 square feet at 2 inches deep, 2 square feet at 3 inches, or 1.5 square feet at 4 inches, by volume. Divide the cubic feet printed on another bag by your depth in feet to find its coverage.'
  },
  {
    q: 'Are all 50 lb gravel bags 0.5 cubic foot?',
    a: 'No. Weight alone does not establish volume. A Vigoro all-purpose decorative stone listing gives 0.5 cubic foot and 48 lb, while a Sakrete pea gravel data sheet gives approximately 0.6 cubic foot for a 50 lb bag. Use the cubic-foot yield or coverage stated for the specific product.'
  },
  {
    q: 'How many gravel bags are in a cubic yard?',
    a: 'One cubic yard is 27 cubic feet. It equals 54 bags only when each bag contains 0.5 cubic foot. For 0.6-cubic-foot bags, the same volume is 45 bags. This is a volume conversion, not a fixed number of pounds or a pallet count.'
  },
  {
    q: 'When should I switch from bagged gravel to bulk delivery?',
    a: 'There is no reliable bag-count cutoff. Multiply the rounded-up bag count by the local price, then compare it with a delivered bulk quote for enough of a comparable gravel, including minimums and fees. Consider where the material can be unloaded and how you will move it.'
  }
];
const upLinks = [
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: 'Material' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'All bags' },
  { title: 'Rock Coverage Chart', slug: '/rock-coverage-chart', badge: 'Reference' }
];
const lateralLinks = [
  { title: 'Gravel Tons Calculator', slug: '/gravel-tons-calculator', badge: 'Tons' },
  { title: 'Gravel Cubic Yards Calculator', slug: '/gravel-cubic-yard-calculator', badge: 'Yards' },
  { title: 'Pea Gravel Bag Calculator', slug: '/pea-gravel-bag-calculator', badge: 'Rounded' }
];
const bridgeLinks = [
  { title: 'Crushed Stone Bag Calculator', slug: '/crushed-stone-bag-calculator', badge: 'Angular' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Buying' },
  { title: 'Gravel Sizes', slug: '/gravel-sizes', badge: 'Choose grade' }
];
const supportGuides = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'Rock Bag Weight and Price Guide', slug: '/rock-bag-weight-and-price-guide', badge: 'Hauling' }
];
---

<BaseLayout
  title={pageTitle}
  description="Find whole gravel bags from measured area, finished depth, and the cubic feet on your product label. Check coverage, hauling weight, local cost, and a bulk quote."
  canonicalPath="/gravel-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/gravel-bag-calculator',
      description: 'Counts whole gravel bags from project area, installed depth, and labeled bag volume; optional inputs estimate packaged weight and local cost.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main id="main-content">
    <PageHero
      title={pageTitle}
      highlightWord="Bag Calculator"
      badge="Bagged gravel buying planner"
      subtitle="A 10 × 10 ft area at 2 in deep takes 34 bags when each holds 0.5 cu ft, before extra. The bag's printed volume sets the count; its weight and your store price help plan the trip. Enter your product details below."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
    />

    <section class="gb-tool" id="gravel-bag-tool" aria-labelledby="gb-tool-heading">
      <div class="container">
        <div class="gb-section-heading">
          <div>
            <p class="gb-eyebrow">Take a count to the store</p>
            <h2 id="gb-tool-heading">Size the layer, then read the bag</h2>
          </div>
          <p>Use the finished thickness you want on the ground. If the surface is uneven or the gravel must compact, set an extra allowance using the product or supplier's guidance.</p>
        </div>

        <div class="gb-workspace">
          <div class="gb-input-panel">
            <h3><span>01</span> Measure the gravel-covered area</h3>
            <fieldset class="gb-area-choice">
              <legend>How is your area measured?</legend>
              <label><input type="radio" name="gb-area-mode" value="rectangle" checked /> Length × width</label>
              <label><input type="radio" name="gb-area-mode" value="known" /> Total square feet</label>
            </fieldset>
            <div class="gb-fields" id="gb-rectangle-fields">
              <div class="gb-field"><label for="gb-length">Length (ft)</label><input id="gb-length" type="number" value="10" min="0.01" step="any" inputmode="decimal" /></div>
              <div class="gb-field"><label for="gb-width">Average width (ft)</label><input id="gb-width" type="number" value="10" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="gb-field" id="gb-known-field" hidden><label for="gb-area">Measured area (sq ft)</label><input id="gb-area" type="number" value="100" min="0.01" step="any" inputmode="decimal" /></div>
            <div class="gb-fields">
              <div class="gb-field"><label for="gb-depth">Finished gravel depth (in)</label><input id="gb-depth" type="number" value="2" min="0.01" max="24" step="any" inputmode="decimal" /></div>
              <div class="gb-field"><label for="gb-extra">Extra to order (%)</label><input id="gb-extra" type="number" value="0" min="0" max="100" step="any" inputmode="decimal" /></div>
            </div>
            <p class="gb-hint">Zero extra is the measured layer only. Add an allowance for known low spots or handling loss; don't add the same allowance twice.</p>

            <h3><span>02</span> Copy the package details</h3>
            <div class="gb-fields">
              <div class="gb-field"><label for="gb-volume">Volume per bag (cu ft)</label><input id="gb-volume" type="number" value="0.5" min="0.01" step="any" inputmode="decimal" /></div>
              <div class="gb-field"><label for="gb-weight">Weight per bag (lb, optional)</label><input id="gb-weight" type="number" min="0.01" step="any" inputmode="decimal" placeholder="Read the label" /></div>
              <div class="gb-field"><label for="gb-price">Price per bag ($, optional)</label><input id="gb-price" type="number" min="0" step="any" inputmode="decimal" placeholder="Your store price" /></div>
              <div class="gb-field"><label for="gb-bag-fees">Bag trip and fees ($, optional)</label><input id="gb-bag-fees" type="number" min="0" step="any" inputmode="decimal" placeholder="Added once" /></div>
              <div class="gb-field"><label for="gb-bulk">Delivered bulk quote ($, optional)</label><input id="gb-bulk" type="number" min="0" step="any" inputmode="decimal" placeholder="Same gravel and volume" /></div>
            </div>
            <p class="gb-hint">The starting 0.5 cu ft is an example, not a size for every 50 lb bag. Add bag trip costs once; the bulk quote should include its minimum, delivery, and fees. Compare taxes consistently.</p>
            <p class="gb-error" id="gb-error" role="alert" hidden></p>
          </div>

          <div class="gb-results" aria-live="polite" aria-atomic="false">
            <div class="gb-result-header"><p class="gb-eyebrow">Your shopping list</p><h3><strong id="gb-bags">34</strong> whole bags</h3><p id="gb-coverage">Each 0.5 cu ft bag covers 3 sq ft at 2 in deep.</p></div>
            <dl class="gb-metrics">
              <div><dt>Installed layer</dt><dd id="gb-installed">16.67 cu ft</dd></div>
              <div><dt>Volume to order</dt><dd id="gb-planned">16.67 cu ft (0.62 yd³)</dd></div>
              <div><dt>Volume in whole bags</dt><dd id="gb-purchased">17 cu ft</dd></div>
              <div><dt>Packaged weight</dt><dd id="gb-total-weight">Add bag weight</dd></div>
              <div><dt>Bag cost</dt><dd id="gb-cost">Add local price</dd></div>
            </dl>
            <div class="gb-receipt"><h4>How this count is built</h4><p id="gb-volume-line">100 sq ft × 2 in ÷ 12 = 16.67 cu ft installed.</p><p id="gb-bag-line">16.67 cu ft ÷ 0.5 cu ft per bag = 33.33; round up to 34 bags.</p></div>
            <div class="gb-compare"><h4>Bagged or loose?</h4><p id="gb-compare-line">Add a bag price and an all-in delivered quote to compare the same gravel and required volume.</p></div>
          </div>
        </div>
      </div>
    </section>

    <article class="gb-guide">
      <div class="container">
        <nav class="gb-jumps" aria-label="On this page">
          <strong>Plan the purchase</strong>
          <a href="#gb-label">Read the label</a>
          <a href="#gb-math">Check the math</a>
          <a href="#gb-material">Match the gravel</a>
          <a href="#gb-order">Make the trip</a>
          <a href="#gb-faq">Questions</a>
        </nav>

        <section class="gb-guide-panel gb-label-panel" id="gb-label" aria-labelledby="gb-label-heading">
          <div>
            <p class="gb-eyebrow">First check at the shelf</p>
            <h2 id="gb-label-heading">Cubic feet set coverage; pounds set the load</h2>
            <p>Find the bag's <strong>cubic-foot volume</strong> or a stated coverage area at a stated depth. That number tells you how many packages fill the space. The <strong>weight</strong> helps plan lifting and vehicle trips. A bag labeled only in pounds cannot give an exact square-foot yield without its volume or a product-specific bulk density.</p>
            <p>Product listings show the difference. <a href="https://www.homedepot.com/p/202026926" target="_blank" rel="noopener noreferrer">Vigoro all-purpose decorative stone</a> lists 0.5 cu ft and 48 lb. A <a href="https://ezmixinc.com/assets/docs-technical/SAKPeaGravelTDS.pdf" target="_blank" rel="noopener noreferrer">Sakrete pea gravel data sheet</a> states that its 50 lb bag yields approximately 0.6 cu ft. Check the actual product rather than converting every 50 lb bag to 0.5 cu ft.</p>
            <p class="gb-fineprint">The examples are different products, not interchangeable gravel choices. <a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> is a method for measuring aggregate bulk density in loose or compacted condition; it does not supply one universal bag weight.</p>
          </div>
          <figure class="gb-figure"><img src="/gravel-bag-label-guide.svg" width="760" height="560" loading="lazy" alt="Illustrated gravel bag label showing volume for bag count, weight for hauling, and stone type and size for choosing the right product." /><figcaption>Check these three parts of the package before calculating or loading a vehicle.</figcaption></figure>
        </section>

        <section class="gb-guide-panel" id="gb-math" aria-labelledby="gb-math-heading">
          <p class="gb-eyebrow">The calculation</p>
          <h2 id="gb-math-heading">Convert the finished layer to whole bags</h2>
          <p>Multiply the area by the finished depth in feet to get installed cubic feet. Apply any chosen extra <em>before</em> dividing by the labeled bag volume, then round up once. The rounded purchase may contain a little more gravel than the calculated layer.</p>
          <div class="gb-formula"><code>installed cu ft = area (sq ft) × depth (in) ÷ 12</code><code>whole bags = ⌈installed cu ft × (1 + extra % ÷ 100) ÷ cu ft per bag⌉</code></div>
          <p>For a 10 × 10 ft patch, the depth changes the purchase more than many shoppers expect. The table uses 0.5-cubic-foot bags and no added allowance. Actual packages may have another yield.</p>
          <div class="gb-table-wrap"><table><caption>Whole 0.5 cu ft bags for 100 sq ft, before extra</caption><thead><tr><th scope="col">Finished depth</th><th scope="col">Installed volume</th><th scope="col">Coverage per bag</th><th scope="col">Whole bags</th></tr></thead><tbody><tr><th scope="row">2 in</th><td>16.67 cu ft</td><td>3 sq ft</td><td>34</td></tr><tr><th scope="row">3 in</th><td>25 cu ft</td><td>2 sq ft</td><td>50</td></tr><tr><th scope="row">4 in</th><td>33.33 cu ft</td><td>1.5 sq ft</td><td>67</td></tr></tbody></table></div>
          <p>One cubic yard is 27 cubic feet, so it equals <strong>54 half-cubic-foot bags</strong> or <strong>45 bags of 0.6 cubic foot</strong> by volume. Neither number specifies a pallet count. For an irregular area, split it into rectangles, subtract large uncovered spaces, and enter the sum using “Total square feet.”</p>
        </section>

        <section class="gb-guide-panel" id="gb-material" aria-labelledby="gb-material-heading">
          <p class="gb-eyebrow">Buy the right bag</p>
          <h2 id="gb-material-heading">“Gravel” on the shelf can mean different jobs</h2>
          <p>The bag count measures space, but the stone inside still has to suit the project. Check the size range, whether the pieces are rounded or angular, and whether the mix contains fines. A coverage estimate cannot turn a decorative bag into a compactable base or a washed drainage aggregate.</p>
          <div class="gb-material-grid">
            <div><h3>Clean angular stone</h3><p>Check the grade and whether it is washed when you need open spaces for drainage. See the <a href="/drain-rock-calculator">drain rock calculator</a> for a drainage layer and <a href="/crushed-stone-bag-calculator">crushed stone bags</a> for small repairs.</p></div>
            <div><h3>Graded gravel with fines</h3><p>A base mix includes small particles that fill voids when compacted. Choose the specified base material and account for its compacted yield; the <a href="/crusher-run-calculator">crusher run calculator</a> handles that planning.</p></div>
            <div><h3>Rounded pea gravel</h3><p>Small smooth pieces give a different walking and edging feel from angular stone. Use the <a href="/pea-gravel-bag-calculator">pea gravel bag calculator</a> when that is the product you will buy.</p></div>
          </div>
          <p class="gb-fineprint">The <a href="/gravel-sizes">gravel size guide</a> helps name the material before you ask a store or landscape yard for a matching quote. Follow the project specification and the chosen product's installation guidance for layer depth.</p>
        </section>

        <section class="gb-guide-panel gb-order-panel" id="gb-order" aria-labelledby="gb-order-heading">
          <p class="gb-eyebrow">Before checkout</p>
          <h2 id="gb-order-heading">Turn the bag number into an order you can move</h2>
          <ol class="gb-steps">
            <li><span>1</span><div><h3>Compare equivalent material and volume</h3><p>Multiply the rounded bag count by your local bag price. Ask the bulk yard for an all-in delivered quote that covers at least your planned cubic feet, with its minimum and unloading location. There is no universal “20 bag” price crossover; access and local charges decide. See <a href="/bulk-vs-bagged-rock">bulk versus bagged rock</a> for the wider tradeoff.</p></div></li>
            <li><span>2</span><div><h3>Check the vehicle's actual capacity</h3><p>Use the product's labeled pounds per bag to calculate the total packaged load. Then read the occupants-and-cargo limit on your own vehicle's tire and loading placard, allowing for passengers and other cargo. <a href="https://www.nhtsa.gov/interpretations/gf004408" target="_blank" rel="noopener noreferrer">NHTSA explains that placard</a>; a car or pickup class name does not tell you how many gravel bags it can carry.</p></div></li>
            <li><span>3</span><div><h3>Keep layers and spaces separate</h3><p>For a path or patio, calculate each material layer with its own specified finished depth and product yield. Don't count a crushed base and decorative surface as one bag type. Keep edging, fabric, and any delivery or placement labor outside the stone volume.</p></div></li>
          </ol>
        </section>

        <section class="gb-guide-panel" id="gb-faq" aria-labelledby="gb-faq-heading">
          <p class="gb-eyebrow">Common questions</p>
          <h2 id="gb-faq-heading">Gravel bags, coverage, and buying</h2>
          <div class="gb-faq-list">{faqItems.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
        </section>
      </div>
    </article>

    <TopicClusterNav currentPage="/gravel-bag-calculator" category="quantity" upLinks={upLinks} lateralLinks={lateralLinks} bridgeLinks={bridgeLinks} supportGuides={supportGuides} />
  </main>
  <Footer />

  <script>
    function initGravelBagCalculator() {
      const input = (id: string) => document.getElementById(id) as HTMLInputElement;
      const put = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };
      const fmt = (value: number, digits = 2) => new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
      const usd = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
      const read = (element: HTMLInputElement, positive: boolean): number => {
        const value = Number(element.value);
        const valid = element.value.trim() !== '' && element.validity.valid && Number.isFinite(value) && (positive ? value > 0 : value >= 0);
        element.setAttribute('aria-invalid', String(!valid));
        return valid ? value : NaN;
      };
      const readOptional = (element: HTMLInputElement, positive: boolean): number | null => {
        if (element.value.trim() === '') { element.setAttribute('aria-invalid', 'false'); return null; }
        return read(element, positive);
      };
      const error = document.getElementById('gb-error') as HTMLElement;

      function update() {
        const known = (document.querySelector('input[name="gb-area-mode"]:checked') as HTMLInputElement)?.value === 'known';
        (document.getElementById('gb-rectangle-fields') as HTMLElement).hidden = known;
        (document.getElementById('gb-known-field') as HTMLElement).hidden = !known;
        const length = known ? NaN : read(input('gb-length'), true);
        const width = known ? NaN : read(input('gb-width'), true);
        const measured = known ? read(input('gb-area'), true) : NaN;
        (known ? [input('gb-length'), input('gb-width')] : [input('gb-area')]).forEach(element => element.setAttribute('aria-invalid', 'false'));
        const area = known ? measured : length * width;
        const depth = read(input('gb-depth'), true);
        const extra = read(input('gb-extra'), false);
        const volume = read(input('gb-volume'), true);
        const weight = readOptional(input('gb-weight'), true);
        const price = readOptional(input('gb-price'), false);
        const bagFees = readOptional(input('gb-bag-fees'), false);
        const bulk = readOptional(input('gb-bulk'), false);
        const messages: string[] = [];
        const coreValid = Number.isFinite(area) && area > 0 && Number.isFinite(depth) && Number.isFinite(extra) && Number.isFinite(volume);
        if (!coreValid) messages.push('Enter a positive area, finished depth, and bag volume. Extra may be zero.');
        if (weight !== null && Number.isNaN(weight)) messages.push('Bag weight must be positive or blank.');
        if (price !== null && Number.isNaN(price)) messages.push('Bag price must be zero or more, or blank.');
        if (bagFees !== null && Number.isNaN(bagFees)) messages.push('Bag trip and fees must be zero or more, or blank.');
        if (bulk !== null && Number.isNaN(bulk)) messages.push('Bulk quote must be zero or more, or blank.');
        error.hidden = messages.length === 0;
        error.textContent = messages.join(' ');
        if (!coreValid) {
          ['gb-bags', 'gb-coverage', 'gb-installed', 'gb-planned', 'gb-purchased', 'gb-total-weight', 'gb-cost', 'gb-volume-line', 'gb-bag-line', 'gb-compare-line'].forEach(id => put(id, '—'));
          return;
        }
        const installed = area * depth / 12;
        const planned = installed * (1 + extra / 100);
        const quotient = planned / volume;
        const bags = Math.max(1, Math.ceil(quotient - 1e-9));
        if (!Number.isFinite(installed) || !Number.isFinite(planned) || !Number.isSafeInteger(bags)) {
          error.hidden = false;
          error.textContent = 'These measurements are too large to calculate a reliable whole-bag order.';
          ['gb-bags', 'gb-coverage', 'gb-installed', 'gb-planned', 'gb-purchased', 'gb-total-weight', 'gb-cost', 'gb-volume-line', 'gb-bag-line', 'gb-compare-line'].forEach(id => put(id, '—'));
          return;
        }
        put('gb-bags', fmt(bags, 0));
        put('gb-coverage', 'Each ' + fmt(volume) + ' cu ft bag covers ' + fmt(volume * 12 / depth) + ' sq ft at ' + fmt(depth) + ' in deep, by volume.');
        put('gb-installed', fmt(installed) + ' cu ft');
        put('gb-planned', fmt(planned) + ' cu ft (' + fmt(planned / 27) + ' yd³)');
        put('gb-purchased', fmt(bags * volume) + ' cu ft');
        put('gb-total-weight', weight === null || Number.isNaN(weight) ? 'Add bag weight' : fmt(bags * weight, 0) + ' lb');
        put('gb-cost', price === null || Number.isNaN(price) || Number.isNaN(bagFees) ? 'Add local price' : usd(bags * price + (bagFees ?? 0)));
        put('gb-volume-line', fmt(area) + ' sq ft × ' + fmt(depth) + ' in ÷ 12 = ' + fmt(installed) + ' cu ft installed; ' + fmt(planned) + ' cu ft with ' + fmt(extra) + '% extra.');
        put('gb-bag-line', fmt(planned) + ' cu ft ÷ ' + fmt(volume) + ' cu ft per bag = ' + fmt(quotient) + '; round up to ' + fmt(bags, 0) + ' whole bags.');
        if (price !== null && bulk !== null && !Number.isNaN(price) && !Number.isNaN(bagFees) && !Number.isNaN(bulk)) {
          const bagCost = bags * price + (bagFees ?? 0);
          const difference = Math.abs(bagCost - bulk);
          const outcome = difference < .005 ? 'The entered costs are equal.' : bagCost < bulk ? 'Bags cost ' + usd(difference) + ' less.' : 'The bulk quote costs ' + usd(difference) + ' less.';
          put('gb-compare-line', fmt(bags, 0) + ' bags with entered trip and fees: ' + usd(bagCost) + '. Delivered bulk quote: ' + usd(bulk) + '. ' + outcome + ' Confirm that the quote covers the same material and at least ' + fmt(planned) + ' cu ft.');
        } else put('gb-compare-line', 'Add a valid bag price and an all-in delivered quote to compare the same gravel and required volume.');
      }

      document.querySelectorAll('#gravel-bag-tool input').forEach(element => { element.addEventListener('input', update); element.addEventListener('change', update); });
      update();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initGravelBagCalculator);
    else initGravelBagCalculator();
  </script>
</BaseLayout>

<style>
  .gb-tool, .gb-guide { padding: var(--space-10) 0; background: var(--bg-body); }
  .gb-eyebrow { color: var(--accent-gold); text-transform: uppercase; letter-spacing: .09em; font-weight: 800; font-size: var(--text-xs); margin: 0 0 var(--space-2); }
  .gb-section-heading { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: end; margin-bottom: var(--space-6); }
  .gb-section-heading h2, .gb-guide-panel h2 { color: var(--text-primary); margin: 0; font-size: var(--text-2xl); line-height: 1.18; }
  .gb-section-heading > p { color: var(--text-secondary); margin: 0; line-height: 1.6; }
  .gb-workspace { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: start; }
  .gb-input-panel, .gb-results, .gb-guide-panel { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: var(--space-6); min-width: 0; }
  .gb-input-panel h3 { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-lg); color: var(--text-primary); margin: 0 0 var(--space-4); }
  .gb-input-panel h3:not(:first-child) { margin-top: var(--space-7); }
  .gb-input-panel h3 span { color: var(--accent-gold); font-size: var(--text-sm); font-weight: 800; }
  .gb-area-choice { border: 0; padding: 0; margin: 0 0 var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .gb-area-choice legend { color: var(--text-muted); font-size: var(--text-xs); margin-bottom: var(--space-2); }
  .gb-area-choice label { display: inline-flex; align-items: center; gap: 6px; color: var(--text-secondary); font-size: var(--text-sm); cursor: pointer; }
  .gb-area-choice input { accent-color: var(--accent-gold); }
  .gb-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
