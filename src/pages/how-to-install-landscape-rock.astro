  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-content h3 {
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .step-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }
</style>
