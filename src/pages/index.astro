---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import Calculator from '../components/Calculator.astro';
import Visualizer from '../components/Visualizer.astro';
import HomeContent from '../components/HomeContent.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQ from '../components/FAQ.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Rock Coverage Calculator';
---
<BaseLayout
  title={pageTitle}
  description="Measure a rock bed in any shape or square footage, choose a material and depth, and estimate cubic yards, short tons, and 0.5-cubic-foot bags."
  canonicalPath="/"
  ogType="website"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": pageTitle,
      "url": "https://rockcoveragecalculator.com/",
      "description": "Multi-shape rock, gravel, and stone coverage calculator converting project footprint, finished depth, and editable loose bulk density into cubic yards, short tons (2,000 lb), and 0.5-cubic-foot bags.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en",
      "featureList": [
        "Rectangle, circle, ring, triangle, trapezoid, L-shape, and known square-foot area inputs",
        "Editable loose bulk density presets synchronized with aggregate density chart",
        "Optional order allowance and compactable-base loose-order multiplier",
        "2D scaled blueprint and interactive 3D layer preview",
        "Multi-zone project saver and CSV / printable specification export"
      ]
    })} />
  </Fragment>
  <Header />
  <main id="main-content">
    <HeroSection title={pageTitle} />
    <Calculator />
    <Visualizer />
    <HomeContent />
    <HowItWorks />
    <FAQ />
    <TopicClusterNav currentPage="/" />
  </main>
  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>
