---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import Calculator from '../components/Calculator.astro';
import Visualizer from '../components/Visualizer.astro';
import HomeContent from '../components/HomeContent.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FAQ from '../components/FAQ.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Rock Coverage Calculator';
---
<BaseLayout 
  title={pageTitle}
  description="Measure a rock bed, choose a material and depth, and estimate cubic yards, tons, and 0.5-cubic-foot bags. Six area shapes and editable supplier density."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Calculate Landscape Rock Coverage in Cubic Yards and Tons",
      "description": "Estimate cubic yards, tons, and bags of rock from measured area and planned depth.",
      "totalTime": "PT2M",
      "tool": {
        "@type": "HowToTool",
        "name": "Rock Coverage Calculator"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Measure Project Area",
          "text": "Measure the length and width of your area in feet (or radius for circular beds). Multiply length by width to find total square footage.",
          "url": "https://rockcoveragecalculator.com/#calculator"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Determine Required Layer Depth",
          "text": "Enter the planned finished layer depth in inches. Choose it for the actual stone size, use, and site conditions; calculate compacted base layers separately.",
          "url": "https://rockcoveragecalculator.com/#depth-guidelines"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Calculate Cubic Yards",
          "text": "Divide the product of area and depth by 324 (12 inches per foot x 27 cubic feet per cubic yard): Volume (cu yd) = (Square Feet x Depth in Inches) / 324.",
          "url": "https://rockcoveragecalculator.com/#mathematical-derivation"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Convert Volume to Commercial Quarry Tons",
          "text": "Multiply cubic yards by the selected material's estimated loose bulk density. Replace the default with a supplier-provided value when available.",
          "url": "https://rockcoveragecalculator.com/#density-reference-table"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Choose an Extra Material Allowance",
          "text": "Select an allowance for measurement uncertainty and low spots. Dense-graded materials can require a separate compaction adjustment; confirm the amount with the supplier or project specification.",
          "url": "https://rockcoveragecalculator.com/#compaction-factors"
        }
      ]
    })} />
  </Fragment>
  <Header />
  <main>
    <HeroSection title={pageTitle} />
    <Calculator />
    <Visualizer />
    <HomeContent />
    <HowItWorks />
    <FAQ />
    <TopicClusterNav currentPage="/" />
  </main>
  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>
