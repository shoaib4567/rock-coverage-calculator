---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TonsCalculator from '../components/calculators/TonsCalculator.astro';
import TonsVisualizer from '../components/visualizers/TonsVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quantity & Conversion', url: '/rock-coverage-calculator-yard' },
  { name: 'Rock Tons Calculator', url: '/rock-tons-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Tonnage (Weight)' },
  { label: 'Unit of Measure', value: 'US Short Ton (2,000 lbs)' },
  { label: 'Scale Formula', value: 'Tons = Cubic Yards × Bulk Density' },
  { label: 'Density Range', value: '0.75 to 1.60 Tons per yd³' }
];

const quickStats = [{"value":"2,000 lb","label":"US short ton","desc":"Weight conversion"},{"value":"Supplier value","label":"Loose bulk weight","desc":"Presets are examples"},{"value":"Optional","label":"Moisture scenario","desc":"Avoid counting moisture twice"}];

const faqItems = [
  {
    "q": "How many tons are needed for 500 sq ft at 3 inches?",
    "a": "The geometric volume is 4.63 yd³. At the example 1.35 US short tons per yard, that is 6.25 tons before any extra order allowance."
  },
  {
    "q": "How do I convert cubic yards to US short tons?",
    "a": "Multiply loose cubic yards by the product’s loose tons per cubic yard. If the supplier gives pounds per cubic yard, multiply by yards and divide the pounds by 2,000."
  },
  {
    "q": "Is the result a certified weight?",
    "a": "No. It is an estimate based on your inputs. A scale ticket measures the actual net weight of a load; the calculator does not certify a shipment."
  },
  {
    "q": "Should I add moisture to every estimate?",
    "a": "No. Only use an additional adjustment when appropriate to the density basis. Leave it at zero when your supplier’s weight factor already reflects the delivered product."
  }
];
---

<BaseLayout
  title="Rock Tons Calculator - Convert Cubic Yards to Scale Tonnage"
  description="Convert rock and gravel cubic yards into estimated US short tons. Features bulk density charts for 10 aggregates, moisture adjustments, and scale ticket verification."
  canonicalPath="/rock-tons-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Rock Tons Calculator",
      "url": "https://rockcoveragecalculator.com/rock-tons-calculator",
      "description": "Quarry tonnage calculator converting landscape dimensions and cubic yard volume into estimated US short tons for bulk stone purchasing.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "about": {
        "@type": "Thing",
        "name": "Tonnage"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Rock Tons Calculator"
      highlightWord="Calculator"
      badge="Quarry Weight & Scale Ticket Conversion"
      subtitle="Estimate US short tons from loose cubic yards and material bulk weight. Actual delivery weight is measured on a scale."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <TonsCalculator />

    <TonsVisualizer />

    <!-- Technical Guide on Tonnage Conversions -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Estimate weight from loose volume</h2><p>US short tons = loose cubic yards × tons per cubic yard. A short ton is 2,000 pounds. Bulk density varies with product, grading, moisture and packing; the calculator presets are examples. Use the supplier’s loose weight conversion when ordering.</p><h2>Keep the estimate separate from a scale ticket</h2><p>The calculator does not measure or certify a delivery. A weight-based sale may include a scale ticket: gross is the loaded vehicle weight, tare is its empty weight, and net is gross minus tare. Net pounds divided by 2,000 gives US short tons. Check the unit and material description on the quote and ticket.</p><h2>A worked conversion</h2><p>A 500 sq ft layer at 3 inches holds 4.63 yd³. At an example 1.35 tons per yard, that is 6.25 tons before extra material. A chosen 8% order allowance gives 6.75 tons. Use a different factor if your supplier’s stone has a different loose weight.</p><h2>Use moisture adjustments deliberately</h2><p>Moisture can change bulk weight. The extra moisture slider is an optional scenario adjustment, not a measured stockpile value. Leave it at zero if the supplier’s density already describes the product as sold; adding another factor would double-count that effect. A fixed percentage cannot predict the condition of every load.</p><p>The <a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/">Penn State materials calculator</a> distinguishes finished dimensions from shipped loose quantities. Compare the <a href="/rock-density-chart">planning density reference</a>, and use the material-specific tonnage tools for product-focused guidance.</p><h2>Questions before ordering</h2>{faqItems.map(item=><section><h3>{item.q}</h3><p>{item.a}</p></section>)}</div></div></article>

    <TopicClusterNav currentPage="/rock-tons-calculator" category="quantity" />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .guide-table th, .guide-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-table th {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
  }

  .guide-table tr:hover td {
    background: rgba(212, 168, 83, 0.04);
  }

  .faq-detail {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary svg {
    transition: transform var(--transition-fast);
  }

  .faq-detail[open] .faq-summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
