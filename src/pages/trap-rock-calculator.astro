  .trap-section-head h2, .trap-guide h2 { color: var(--trap-ink); line-height: 1.14; }
  .trap-section-head h2 { font-size: clamp(1.8rem, 3vw, 2.65rem); margin: .35rem 0 0; }
  .trap-section-head p:last-child { color: var(--text-secondary); margin: 0; line-height: 1.7; }
  .trap-eyebrow { margin: 0; color: var(--gold-400); font-size: .75rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .trap-tool-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 1rem; }
  .trap-panel, .trap-reverse, .trap-card, .trap-buying, .trap-figure { border: 1px solid var(--trap-edge); border-radius: 20px; background: var(--surface-raised); }
  .trap-panel { padding: clamp(1.2rem, 2.5vw, 2rem); min-width: 0; }
  .trap-inputs { display: grid; gap: 1rem; align-content: start; }
  .trap-modes { display: flex; gap: .55rem; flex-wrap: wrap; border: 0; padding: 0; margin: 0; }
  .trap-modes legend { color: var(--text-secondary); font-size: .9rem; font-weight: 700; margin-bottom: .5rem; }
  .trap-modes label { display: inline-flex; gap: .5rem; align-items: center; padding: .6rem .85rem; border-radius: 10px; border: 1px solid var(--trap-edge); cursor: pointer; color: var(--trap-ink); }
  .trap-modes input { accent-color: var(--gold-500); }
  .trap-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  [hidden] { display: none !important; }
