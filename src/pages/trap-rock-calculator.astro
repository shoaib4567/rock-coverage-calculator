const pageTitle = 'Trap Rock Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crushed Stone Calculator', url: '/crushed-stone-calculator' },
  { name: pageTitle, url: '/trap-rock-calculator' }
];
const entityTags = [
  { label: 'Rock family', value: 'Basalt and diabase trap rock' },
  { label: 'Buying units', value: 'Cubic yards or US short tons' },
  { label: 'Weight example', value: '2,600 lb/cu yd; editable' }
];
const quickStats = [
  { value: '0.93 cu yd', label: '100 sq ft at 3 in', desc: 'Finished layer volume before optional extra.' },
  { value: '1.20 tons', label: 'Same example', desc: 'At Dresser Trap Rock’s 2,600 lb/cu yd average.' },
  { value: '83 sq ft', label: 'Per short ton at 3 in', desc: 'Changes when the supplier’s bulk weight changes.' }
];
const faqItems = [
  {
    q: 'How much trap rock do I need for 100 square feet?',
    a: 'At a finished depth of 3 inches, 100 square feet requires 25 cubic feet, or 0.93 cubic yard, before any optional order extra. Using Dresser Trap Rock’s average 2,600 pounds per cubic yard, that volume is about 1.20 US short tons. Ask your supplier for the loose bulk weight of the exact gradation you are buying.'
  },
  {
    q: 'How many square feet will one ton of trap rock cover?',
    a: 'At 3 inches deep and an example loose bulk weight of 2,600 pounds per cubic yard, one US short ton covers about 83 square feet by volume. At 2 inches it covers about 125 square feet; at 4 inches, about 62. Product weight, finished depth, grading, and uneven ground change the estimate.'
  },
  {
    q: 'How much does a cubic yard of trap rock weigh?',
    a: 'There is no single weight for every trap-rock gradation. Dresser Trap Rock lists an average of 1.3 US short tons (2,600 pounds) per cubic yard. Fick Supply lists 2,700 pounds per cubic yard for its 3/4- to 1-inch trap rock. Enter the weight given by your seller before converting cubic yards to tons.'
  },
  {
    q: 'Is clean trap rock the same as trap-rock driveway base?',
    a: 'No. Clean crushed trap rock has little fine material and is sold for uses such as drainage and decorative beds. Minus or Class 5 base contains a range of smaller particles that can compact into a firmer layer. Dresser lists these as separate products. Select the gradation for the intended layer, then use its own supplier weight.'
  },
  {
    q: 'Can I use trap rock in a French drain?',
    a: 'A clean, open-graded trap-rock product can be used where the drain design calls for that size and grading. A dense-graded driveway base containing fines is a different product and can obstruct the open spaces that carry water. For a pipe trench, use the Drain Rock Calculator to account for pipe displacement and the actual stone envelope.'
  }
];
const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'Main tool' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: 'Material hub' }
];
const lateralLinks = [
  { title: 'Crusher Run Calculator', slug: '/crusher-run-calculator', badge: 'Graded base' },
  { title: 'Crushed Granite Calculator', slug: '/crushed-granite-calculator', badge: 'Other quarried stone' },
  { title: 'Driveway Rock Calculator', slug: '/driveway-rock-calculator', badge: 'Surface planning' }
];
const bridgeLinks = [
  { title: 'Drain Rock Calculator', slug: '/drain-rock-calculator', badge: 'Clean stone trench' },
  { title: 'Riprap Calculator', slug: '/riprap-calculator', badge: 'Larger erosion stone' },
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Bulk weight' }
];
const supportGuides = [
  { title: 'Angular vs Rounded Rock', slug: '/angular-vs-rounded-rock', badge: 'Stone shape' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Layer depth' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'Measuring' }
];
