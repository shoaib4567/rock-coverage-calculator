---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import DrainCalculator from '../components/calculators/DrainCalculator.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Drain Rock Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crushed Stone Calculator', url: '/crushed-stone-calculator' },
  { name: pageTitle, url: '/drain-rock-calculator' }
];
const entityTags = [
  { label: 'Material', value: 'Clean, graded drain rock' },
  { label: 'Use', value: 'French drain stone takeoff' },
  { label: 'Supplier weight example', value: '2,500 lb/cu yd; editable' }
];
const quickStats = [
  { value: '2.00 cu yd', label: '50 ft example', desc: '12 in wide × 18 in deep, with 4 in top cover and 4 in pipe.' },
  { value: '4.36 cu ft', label: 'Pipe space', desc: 'Approximate outside volume of a 4 in pipe over 50 ft.' },
  { value: '2.75 tons', label: 'Example order', desc: 'With 10% extra at 2,500 lb per cubic yard.' }
];
const faqItems = [
  {
    q: 'How much drain rock do I need for a 50-foot French drain?',
    a: 'A 50-foot trench that is 12 inches wide and 18 inches deep needs about 2.00 cubic yards of installed stone if 4 inches at the top are reserved for cover and a 4-inch outside-diameter pipe runs the full length. A 10% optional allowance brings the example order to 2.20 cubic yards. Change the dimensions to match the part of your trench actually filled with rock.'
  },
  {
    q: 'Should I subtract the pipe and the voids between the rocks?',
    a: 'Subtract the outside volume of a pipe that lies within the rock-filled zone. Do not subtract the air spaces between stones: a supplier cubic yard of loose drain rock already includes those spaces. Void space matters to drainage storage and flow design, which this quantity estimator does not calculate.'
  },
  {
    q: 'What is the best rock for a French drain?',
    a: 'Look for a clean, appropriately graded, free-draining product specified for your trench and pipe. Washed angular stone and washed rounded drain gravel are both sold for this use. Confirm size, fines content, and any project specification with the supplier; crusher run with fines is a different product.'
  },
  {
    q: 'How much does a cubic yard of drain rock weigh?',
    a: 'There is no single weight for every drain-rock product. For example, South Bay Materials lists 2,500 pounds per cubic yard for its 3/4-inch drain rock, while Three Z lists about 1.4 US short tons, or 2,800 pounds, per cubic yard for its #57 washed gravel. Use the weight quoted for the stone you will buy.'
  }
];
const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'Main tool' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: 'Aggregate hub' }
];
const lateralLinks = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'Gradation' },
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: 'Rounded option' },
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: 'Broader material' }
];
const bridgeLinks = [
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Supplier weights' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'General method' }
];
---

<BaseLayout
  title={pageTitle}
  metaDescription="Estimate clean drain rock for a French drain by trench fill, top cover and pipe outside diameter. See installed cubic yards, optional order amount, tons and fabric cut size."
  canonicalPath="/drain-rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/drain-rock-calculator',
      description: 'Estimates drain-rock fill, order volume and weight from trench dimensions, top cover and pipe outside diameter.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question', name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Drain Rock"
      badge="French drain material takeoff"
      subtitle="A 50-foot trench, 12 inches wide and 18 inches deep, uses about 2.00 cubic yards of installed drain rock when 4 inches are left for top cover and a 4-inch pipe is inside the stone. Add 10% for an example order of 2.20 cubic yards; enter your own trench and supplier weight below."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="drainage"
    />

    <DrainCalculator />

    <article class="drain-guide">
      <div class="container">
        <section class="guide-block lead-block" aria-labelledby="where-rock-goes">
          <div>
            <p class="eyebrow">Read the trench before ordering</p>
            <h2 id="where-rock-goes">Measure the rock envelope, not just the excavation</h2>
            <p>If soil or sod will cover the drain, that top layer is not drain rock. Enter the full excavated depth and the planned cover separately. The calculator takes the pipe's outside volume out of the remaining stone zone. A trench with no pipe can use a zero pipe diameter.</p>
            <p>The sketch shows the default inputs. The gravel-colored zone includes the gaps between stones. You buy the whole loose rock volume; the gaps are not a second deduction.</p>
          </div>
          <figure>
            <img src="/images/drain-rock-trench-section.svg" width="720" height="410" loading="lazy" alt="Cross-section of a 12-inch-wide French drain trench with 4 inches of top cover, 14 inches of rock fill, a 4-inch pipe, and fabric around the stone" />
            <figcaption>Example section for the calculator defaults. Swipe across the sketch on a narrow screen. The slope and outlet are separate design decisions.</figcaption>
          </figure>
        </section>

        <section class="guide-block" aria-labelledby="drain-math">
          <p class="eyebrow">The takeoff method</p>
          <h2 id="drain-math">From trench dimensions to a supplier order</h2>
          <ol class="method-grid">
            <li><strong>Find the stone height.</strong><span>Excavated depth − non-rock top cover. For the example, 18 − 4 = 14 inches.</span></li>
            <li><strong>Calculate the envelope.</strong><span>Length × width × stone height after converting inches to feet. Here: 50 × 1 × 14/12 = 58.33 cubic feet.</span></li>
            <li><strong>Remove the pipe.</strong><span>For a 4-inch outside diameter, length × π × (4/24)² = 4.36 cubic feet. The finished stone fill is 53.97 cubic feet, or 2.00 cubic yards.</span></li>
            <li><strong>Plan the purchase.</strong><span>Apply any chosen site allowance to the stone volume. At 10% extra and 2,500 lb per cubic yard, the example is 2.20 cubic yards or 2.75 US short tons.</span></li>
          </ol>
          <p class="note">A 4-inch nominal pipe can have a different outside diameter by product. Replace the default with the manufacturer's actual dimension when it matters. The estimate assumes the entire pipe cross-section is within the rock zone.</p>
        </section>

        <section class="guide-block" aria-labelledby="choose-drain-stone">
          <p class="eyebrow">Choose the actual product</p>
          <h2 id="choose-drain-stone">Clean stone, gradation, and supplier weight</h2>
          <p>“Drain rock” describes a job, not one universal rock type. A yard may sell washed, rounded gravel or clean, angular crushed stone under the same name. <a href="/57-stone-size-guide">#57 stone</a> is one common graded option, but check the product's stated size and whether it includes fines. A dense <a href="/crusher-run-calculator">crusher run</a> base includes fines and serves a different purpose.</p>
          <div class="source-table-wrap">
            <table>
              <caption>Published product examples; weights are for those products, not every drain rock.</caption>
              <thead><tr><th scope="col">Supplier product</th><th scope="col">Published loose weight</th><th scope="col">Why it matters</th></tr></thead>
              <tbody>
                <tr><td>South Bay 3/4-inch washed round drain rock</td><td>2,500 lb/cu yd</td><td>The calculator's editable starting value.</td></tr>
                <tr><td>Three Z #57 washed rounded gravel</td><td>About 2,800 lb/cu yd</td><td>The same volume produces a higher ton estimate.</td></tr>
              </tbody>
            </table>
          </div>
          <p>Ask whether your yard sells by cubic yard or by scale ton, and use its weight for that specific product. If you are comparing with <a href="/rock-density-chart">other rock weights</a>, keep pounds per cubic yard and US short tons separate from metric tonnes.</p>
        </section>

        <section class="guide-block" aria-labelledby="before-digging">
          <p class="eyebrow">Beyond the material count</p>
          <h2 id="before-digging">Check the outlet, soil, and fabric plan</h2>
          <div class="practice-grid">
            <div><h3>Follow the water</h3><p>A subsurface drain needs a route to an appropriate outlet. Check the site grade and where water can discharge before fixing the trench size. The stone calculator cannot establish drainage capacity or an allowable discharge location.</p></div>
            <div><h3>Keep soil out of the stone</h3><p>A filter fabric or specified drain envelope can separate soil from the aggregate. The tool estimates one full-wrap cut width: twice the trench width, twice the stone height, plus your selected top overlap. It does not select a fabric or count rolls; soil and project specifications control that choice.</p></div>
            <div><h3>Match the installation</h3><p>Foundation, retaining-wall, and engineered stormwater drains may call for a particular stone gradation, pipe, filter, and outlet. Follow the project detail. For a simple garden drain, still check nearby utilities before digging and avoid directing water onto another property.</p></div>
          </div>
        </section>

        <section class="guide-block faq-block" aria-labelledby="drain-faq">
          <h2 id="drain-faq">Drain rock questions</h2>
          {faqItems.map(item => (
            <details><summary>{item.q}</summary><p>{item.a}</p></details>
          ))}
        </section>

        <section class="source-block" aria-labelledby="drain-sources">
          <h2 id="drain-sources">Sources and product checks</h2>
          <ul>
            <li><a href="https://www.ndspro.com/us/en/resources/articles/what-is-a-french-drain">NDS: French drain components and outlet planning</a></li>
            <li><a href="https://www.ndspro.com/media/wysiwyg/files/principles-of-exterior-drainage.pdf">NDS: Principles of Exterior Drainage</a> (trench rock quantity and soil separation)</li>
            <li><a href="https://extension.umn.edu/natural-resources/conservation/shoreland-watersheds-and-wetlands/stabilizing-shoreland-property-to-prevent-erosion">University of Minnesota Extension: French drain and outlet context</a></li>
            <li><a href="https://southbaymaterials.com/drain-rock-3-4">South Bay Materials: 3/4-inch drain rock product weight</a></li>
            <li><a href="https://shop.three-z.com/index.php?product_id=58&amp;route=product%2Fproduct">Three Z: #57 washed gravel product weight</a></li>
          </ul>
        </section>
      </div>
    </article>

    <TopicClusterNav currentPage="/drain-rock-calculator" category="material" upLinks={upLinks} lateralLinks={lateralLinks} bridgeLinks={bridgeLinks} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .drain-guide { background: var(--bg-body); padding: var(--space-10) 0; }
  .guide-block, .source-block { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: clamp(1.2rem, 3vw, 2.3rem); margin-bottom: var(--space-6); color: var(--text-secondary); line-height: 1.7; }
  .guide-block h2, .source-block h2 { color: var(--text-primary); font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.25; margin: 0 0 var(--space-4); }
  .guide-block h3 { color: var(--text-primary); font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .guide-block p, .source-block p { margin: 0 0 var(--space-4); }
  .eyebrow { color: var(--gold-400); text-transform: uppercase; letter-spacing: .09em; font-size: var(--text-xs); font-weight: 700; }
  .lead-block { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: var(--space-8); align-items: center; }
  figure { min-width: 0; margin: 0; overflow-x: auto; }
  figure img { display: block; width: 100%; min-width: 600px; height: auto; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  figcaption { font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-2); }
  .method-grid { list-style: none; padding: 0; margin: var(--space-5) 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); counter-reset: steps; }
  .method-grid li { min-width: 0; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); counter-increment: steps; }
  .method-grid li::before { content: counter(steps, decimal-leading-zero); display: block; color: var(--gold-400); font-weight: 700; margin-bottom: var(--space-2); }
  .method-grid strong, .method-grid span { display: block; }
  .method-grid strong { color: var(--text-primary); }
  .note { border-left: 3px solid var(--gold-400); padding-left: var(--space-4); }
  .source-table-wrap { overflow-x: auto; margin: var(--space-5) 0; }
  table { width: 100%; border-collapse: collapse; min-width: 580px; }
  caption { text-align: left; color: var(--text-muted); font-size: var(--text-sm); margin-bottom: var(--space-2); }
  th, td { text-align: left; border-bottom: 1px solid var(--border-subtle); padding: var(--space-3); vertical-align: top; }
  th { color: var(--text-primary); }
  .practice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .practice-grid > div { min-width: 0; border-top: 2px solid var(--gold-400); background: var(--bg-surface); padding: var(--space-4); border-radius: var(--radius-sm); }
  .practice-grid p { margin-bottom: 0; }
  .faq-block details { border-top: 1px solid var(--border-subtle); padding: var(--space-3) 0; }
  .faq-block summary { color: var(--text-primary); font-weight: 600; cursor: pointer; }
  .faq-block details p { padding: var(--space-3) 0 0; margin: 0; }
  .source-block { font-size: var(--text-sm); }
  .source-block ul { padding-left: 1.25rem; margin: 0; }
  .source-block li { margin-bottom: var(--space-2); }
  .drain-guide a { color: var(--gold-400); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .lead-block, .method-grid, .practice-grid { grid-template-columns: 1fr; } }
</style>
