---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import { getMaterialById } from '../scripts/materials-data.js';

const pageTitle = 'Crushed Stone Tons Calculator';
const density57 = getMaterialById('clean-stone-57').tonsPerCuYd;
const densityBase = getMaterialById('crusher-run-21a').tonsPerCuYd;
const exampleYards = 30 * 12 * 3 / 324;
const exampleTons = exampleYards * density57;
const exampleOrderTons = exampleTons * 1.10;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crushed Stone Calculator', url: '/crushed-stone-calculator' },
  { name: pageTitle, url: '/crushed-stone-tons-calculator' }
];
const entityTags = [
  { label: 'Order unit', value: 'US short tons (2,000 lb)' },
  { label: 'Grade', value: '#57 clean stone or dense-graded base' },
  { label: 'Weight', value: 'Editable loose bulk tons per cubic yard' }
];
const faqItems = [
  { q: 'How many tons of crushed stone do I need for a 12 × 30 ft driveway?', a: `At 3 inches of finished depth, 360 square feet requires ${exampleYards.toFixed(2)} cubic yards in place. At the sample #57 loose bulk weight of ${density57.toFixed(2)} US short tons per cubic yard, that is ${exampleTons.toFixed(2)} tons before extra. Adding an optional 10% order allowance gives ${exampleOrderTons.toFixed(2)} tons. Confirm the layer depth and supplier weight for your job.` },
  { q: 'How do I convert crushed stone cubic yards to tons?', a: 'Multiply cubic yards by the loose bulk weight of the exact stone in US short tons per cubic yard. Three cubic yards at 1.35 short tons per yard is an estimated 4.05 short tons. A short ton is 2,000 pounds; a metric tonne is a different unit.' },
  { q: 'How much area does one ton of #57 stone cover?', a: 'At the 1.35 short tons per cubic yard planning weight, one ton covers about 120 square feet at 2 inches deep, 80 square feet at 3 inches, or 60 square feet at 4 inches. These are level-layer estimates before any order allowance. Your quarry’s stone may have a different bulk weight.' },
  { q: 'Is #57 stone the same as crusher run?', a: '#57 names a coarse aggregate size designation commonly sold as clean stone for drainage. Crusher run is a dense blend of crushed stone and fines used where a compacted base is specified. Product names and gradations vary by supplier; ask for the grading sheet when the choice matters.' },
  { q: 'Does the calculator tell me the certified scale weight?', a: 'No. It estimates an order from measured volume and an assumed loose bulk weight. The delivery scale ticket records the actual net weight. Check its material description and whether the quoted tons are US short tons or metric tonnes.' }
];
---

<BaseLayout title={pageTitle} metaDescription="Estimate US short tons of crushed stone from area and finished depth. Adjust loose bulk weight and order allowance, then compare #57 stone with compactable base." canonicalPath="/crushed-stone-tons-calculator">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebApplication', name: pageTitle, url: 'https://rockcoveragecalculator.com/crushed-stone-tons-calculator', description: 'Estimates US short tons of crushed stone from measured area, installed depth, editable loose bulk density and ordering allowance.', applicationCategory: 'UtilityApplication', operatingSystem: 'Web', inLanguage: 'en-US' })} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) })} />
  </Fragment>
  <Header />
  <main>
    <PageHero title={pageTitle} highlightWord="Tons" badge="Plan an order by quarry weight" subtitle={`A 30 × 12 ft area at 3 in deep needs ${exampleTons.toFixed(2)} US short tons of #57 stone at the sample ${density57.toFixed(2)} tons-per-yard weight. Add 10% extra and the order estimate is ${exampleOrderTons.toFixed(2)} tons. Enter your actual measurements and supplier weight below.`} breadcrumbs={breadcrumbs} entityTags={entityTags} theme="civil" />

    <section class="cst-tool" id="cst-calculator" aria-labelledby="cst-tool-heading">
      <div class="container">
        <div class="cst-section-heading"><p class="cst-eyebrow">Estimate a tonnage order</p><h2 id="cst-tool-heading">How many short tons should you ask for?</h2><p>Measure the area and the depth you want <em>after placement</em>. The calculator converts that volume to tons with a loose bulk weight you can replace with your quarry’s value.</p></div>
        <div class="cst-tool-grid">
          <div class="cst-card cst-input-card">
            <fieldset class="cst-mode"><legend>How have you measured the area?</legend><label><input type="radio" name="cst-measure-mode" value="rectangle" checked /> Length × width</label><label><input type="radio" name="cst-measure-mode" value="area" /> Square feet known</label></fieldset>
            <div class="cst-fields" id="cst-rectangle-fields">
              <div class="cst-field"><label for="cst-length">Length <span>(feet)</span></label><input id="cst-length" type="number" value="30" min="0.01" step="any" inputmode="decimal" /></div>
              <div class="cst-field"><label for="cst-width">Width <span>(feet)</span></label><input id="cst-width" type="number" value="12" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="cst-fields" id="cst-area-fields" hidden><div class="cst-field"><label for="cst-area">Measured area <span>(square feet)</span></label><input id="cst-area" type="number" value="360" min="0.01" step="any" inputmode="decimal" /></div></div>
            <div class="cst-fields cst-core-fields">
              <div class="cst-field"><label for="cst-depth">Finished layer depth <span>(inches)</span></label><input id="cst-depth" type="number" value="3" min="0.01" step="any" inputmode="decimal" aria-describedby="cst-depth-help" /></div>
              <div class="cst-field"><label for="cst-density">Loose bulk weight <span>(short tons/yd³)</span></label><input id="cst-density" type="number" value={density57} min="0.01" step="any" inputmode="decimal" aria-describedby="cst-density-help" /></div>
              <div class="cst-field"><label for="cst-extra">Extra to order <span>(%)</span></label><input id="cst-extra" type="number" value="10" min="0" max="100" step="any" inputmode="decimal" aria-describedby="cst-extra-help" /></div>
            </div>
            <div class="cst-help">
              <p id="cst-depth-help"><strong>Depth:</strong> enter the finished layer thickness. A label such as “#57” names the stone grade, not the installation depth.</p>
              <p id="cst-density-help"><strong>Weight:</strong> {density57.toFixed(2)} is a #57 planning value equal to 2,700 lb/yd³. Use the loose bulk weight from the supplier of your actual stone.</p>
              <p id="cst-extra-help"><strong>Extra:</strong> optional material for low spots, handling or a supplier-provided loose-to-finished factor. Use 0% when your quantities already include these needs.</p>
            </div>
            <p id="cst-error" class="cst-error" role="alert" hidden></p>
          </div>
          <div class="cst-card cst-result-card" aria-live="polite">
            <p class="cst-eyebrow">Estimated amount to order</p><div class="cst-main-result"><strong id="cst-order-tons">{exampleOrderTons.toFixed(2)}</strong><span>US short tons</span></div><p class="cst-caption" id="cst-caption">360 sq ft at 3 in depth, with 10% extra</p>
            <dl class="cst-breakdown">
              <div><dt>Layer before extra</dt><dd id="cst-net-tons">{exampleTons.toFixed(2)} tons</dd></div>
              <div><dt>Finished layer volume</dt><dd id="cst-net-yards">{exampleYards.toFixed(2)} yd³</dd></div>
              <div><dt>Volume with extra</dt><dd id="cst-order-yards">{(exampleYards * 1.10).toFixed(2)} yd³</dd></div>
              <div><dt>Estimated order weight</dt><dd id="cst-order-pounds">{Math.round(exampleOrderTons * 2000).toLocaleString('en-US')} lb</dd></div>
              <div><dt>One ton covers at this depth</dt><dd id="cst-ton-coverage">80 sq ft</dd></div>
            </dl>
            <p class="cst-result-note">The coverage figure describes a level layer before extra. The quarry scale ticket, rather than this estimate, gives the delivered weight.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="cst-guide"><div class="container">
      <nav class="cst-jumps" aria-label="On this page"><strong>Plan the purchase</strong><a href="#cst-math">Follow the math</a><a href="#cst-material">Choose the stone</a><a href="#cst-coverage">Compare depths</a><a href="#cst-ticket">Check the delivery</a><a href="#cst-questions">Questions</a></nav>
      <section class="cst-panel cst-math-panel" id="cst-math" aria-labelledby="cst-math-heading">
        <div><p class="cst-eyebrow">Area → volume → weight</p><h2 id="cst-math-heading">Keep the measured layer and the order allowance separate</h2><p>Length times width gives square feet. Multiplying by finished depth gives volume; only then does the stone’s <em>loose bulk weight</em> turn cubic yards into short tons. Bulk weight includes air between stones, so it is different from the density of a solid piece of limestone or granite.</p><div class="cst-formula"><code>cubic yards = area (sq ft) × depth (in) ÷ 324</code><code>order tons = cubic yards × (1 + extra ÷ 100) × loose tons/yd³</code></div><p>For the 30 × 12 ft example, <strong>360 × 3 ÷ 324 = 3.33 yd³</strong> in place. At {density57.toFixed(2)} short tons/yd³, that is <strong>4.50 tons</strong> before extra. A chosen 10% allowance raises the order estimate to <strong>3.67 yd³ or 4.95 tons</strong>.</p><p class="cst-fine">The divisor 324 combines 12 inches per foot with 27 cubic feet per cubic yard. The calculator keeps full precision internally, then rounds the displayed result.</p></div>
        <figure><img src="/crushed-stone-tons-order-path.svg" width="900" height="520" loading="lazy" alt="Crushed stone tonnage path: 360 square feet at 3 inches is 3.33 cubic yards, which is 4.50 short tons at a sample 1.35 tons per cubic yard; 10 percent extra gives a 4.95-ton order estimate." /><figcaption><span class="cst-mobile-hint">Swipe to read the diagram. </span>Volume, stone weight and extra are different decisions.</figcaption></figure>
      </section>
      <section class="cst-panel" id="cst-material" aria-labelledby="cst-material-heading"><p class="cst-eyebrow">Choose the material before the multiplier</p><h2 id="cst-material-heading">Clean #57 and crusher run answer different needs</h2><p>For a drainage layer, ask for clean, low-fines stone in the specified gradation. For a base meant to compact, ask about a dense-graded blend with fines. The quarry’s names can be regional, and a size number alone does not specify a material’s bulk weight.</p><div class="cst-choice-grid"><div><span>Open-graded</span><strong>#57 clean stone</strong><p>Coarser particles leave connected spaces for water. The {density57.toFixed(2)}-ton/yd³ default is a planning weight for the tool, not a standard assigned by ASTM.</p><a href="/57-stone-size-guide">Check #57 size and uses →</a></div><div><span>Dense-graded</span><strong>Crusher run / road base</strong><p>Smaller particles and fines fill many voids. Our <a href="/crushed-stone-calculator">material calculator</a> uses {densityBase.toFixed(2)} tons/yd³ as an editable starting weight for this separate product.</p><a href="/crusher-run-calculator">Estimate crusher run →</a></div></div><p><a href="https://store.astm.org/d0448-12r22.html" target="_blank" rel="noopener noreferrer">ASTM D448</a> classifies aggregate size designations for roads and bridges. It does not make every quarry’s #57 a single weight. <a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> describes how bulk density and voids are measured; it also distinguishes dry test results from moist stockpiles and hauled loads.</p></section>
      <section class="cst-panel" id="cst-coverage" aria-labelledby="cst-coverage-heading"><p class="cst-eyebrow">Depth changes the yield</p><h2 id="cst-coverage-heading">How far will one ton go?</h2><p>The same ton covers half as much area when depth doubles. This reference assumes a flat layer of the sample #57 stone at {density57.toFixed(2)} short tons/yd³, before any extra. It is useful for checking a takeoff; it does not prescribe a suitable construction depth.</p><div class="cst-table-wrap"><table><caption>Geometric coverage at the sample #57 loose bulk weight</caption><thead><tr><th scope="col">Finished depth</th><th scope="col">One cubic yard covers</th><th scope="col">One short ton covers</th></tr></thead><tbody><tr><th scope="row">2 in</th><td>162 sq ft</td><td>120 sq ft</td></tr><tr><th scope="row">3 in</th><td>108 sq ft</td><td>80 sq ft</td></tr><tr><th scope="row">4 in</th><td>81 sq ft</td><td>60 sq ft</td></tr><tr><th scope="row">6 in</th><td>54 sq ft</td><td>40 sq ft</td></tr></tbody></table></div><p>A trench, driveway, and permeable pavement may each call for different stone and layer designs. <a href="https://extension.oregonstate.edu/catalog/pub/em-9210-porous-pavement-low-impact-development-fact-sheet" target="_blank" rel="noopener noreferrer">Oregon State University Extension</a>, for example, describes washed uniform aggregate and project-specific depths for porous pavement. Follow the project specification or local installer’s design rather than treating a calculator default as a construction rule.</p></section>
      <section class="cst-panel" id="cst-ticket" aria-labelledby="cst-ticket-heading"><p class="cst-eyebrow">Before and after the truck arrives</p><h2 id="cst-ticket-heading">Match the quote and scale ticket to your estimate</h2><p>Supplier listings show why the weight field stays editable: <a href="https://ottrsupply.com/products/57-stone" target="_blank" rel="noopener noreferrer">Ottr Supply’s #57 granite</a> lists roughly 2,700 lb/yd³, while <a href="https://hellogravel.com/products/57-crushed-stone/" target="_blank" rel="noopener noreferrer">Hello Gravel’s #57 listing</a> uses roughly 2,800 lb/yd³. For the same 360 sq ft example at 3 inches with 10% extra, those inputs produce 4.95 versus 5.13 short tons. They are examples from different suppliers, not a universal range.</p><ol class="cst-checklist"><li><strong>Confirm the grade and loose weight.</strong> Tell the yard whether you need clean stone or material with fines. Ask what weight it uses to convert yards to tons.</li><li><strong>Confirm the sales unit.</strong> A US short ton is 2,000 lb. If the quote is in metric tonnes, convert the unit before comparing prices or quantities.</li><li><strong>Ask about delivery.</strong> The usable payload depends on the actual truck and route. Ask the hauler how many tons can be delivered to your site and where the pile can be tipped.</li><li><strong>Read the ticket.</strong> If sold by weight, compare the material and <em>net load weight</em> with the quote. Gross minus tare gives net; a photo of a conical pile cannot establish its tonnage. <a href="https://ia.iowadot.gov/erl/archiveapril2026/IM/content/508ab.htm" target="_blank" rel="noopener noreferrer">Iowa DOT’s aggregate scale guidance</a> identifies these ticket fields.</li></ol><p>Ordering by cubic yard? Use the <a href="/crushed-stone-yardage-calculator">crushed stone yardage calculator</a>. Buying retail bags for a small repair? Use the <a href="/crushed-stone-bag-calculator">crushed stone bag calculator</a>. For a broader comparison of stone grades, return to the <a href="/crushed-stone-calculator">crushed stone calculator</a>.</p></section>
      <section class="cst-panel" id="cst-questions" aria-labelledby="cst-questions-heading"><h2 id="cst-questions-heading">Crushed stone tonnage questions</h2><div class="cst-faq">{faqItems.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
    </div></article>
    <TopicClusterNav currentPage="/crushed-stone-tons-calculator" category="quantity" />
  </main>
  <Footer />
  <script>
    const input = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    const readNumber = (id: string) => { const value = input(id)?.value.trim(); return value ? Number(value) : NaN; };
    const output = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
    const numberIds = ['cst-length', 'cst-width', 'cst-area', 'cst-depth', 'cst-density', 'cst-extra'];
    const resultIds = ['cst-order-tons', 'cst-net-tons', 'cst-net-yards', 'cst-order-yards', 'cst-order-pounds', 'cst-ton-coverage'];
    function updateCrushedStoneTons() {
      const mode = (document.querySelector('input[name="cst-measure-mode"]:checked') as HTMLInputElement | null)?.value || 'rectangle';
      const rectangle = document.getElementById('cst-rectangle-fields');
      const knownArea = document.getElementById('cst-area-fields');
      if (rectangle) rectangle.hidden = mode !== 'rectangle';
      if (knownArea) knownArea.hidden = mode !== 'area';
      const length = readNumber('cst-length'), width = readNumber('cst-width'), enteredArea = readNumber('cst-area');
      const depth = readNumber('cst-depth'), density = readNumber('cst-density'), extra = readNumber('cst-extra');
      const area = mode === 'area' ? enteredArea : length * width;
      const areaValid = mode === 'area' ? Number.isFinite(enteredArea) && enteredArea > 0 : [length, width].every(value => Number.isFinite(value) && value > 0);
      const depthValid = Number.isFinite(depth) && depth > 0;
      const densityValid = Number.isFinite(density) && density > 0;
      const extraValid = Number.isFinite(extra) && extra >= 0 && extra <= 100;
      const geometryValid = areaValid && Number.isFinite(area) && area > 0 && depthValid;
      const error = document.getElementById('cst-error');
      const validById: Record<string, boolean> = { 'cst-length': mode !== 'rectangle' || Number.isFinite(length) && length > 0, 'cst-width': mode !== 'rectangle' || Number.isFinite(width) && width > 0, 'cst-area': mode !== 'area' || Number.isFinite(enteredArea) && enteredArea > 0, 'cst-depth': depthValid, 'cst-density': densityValid, 'cst-extra': extraValid };
      numberIds.forEach(id => input(id)?.setAttribute('aria-invalid', validById[id] ? 'false' : 'true'));
      if (!geometryValid) {
        resultIds.forEach(id => output(id, '—'));
        output('cst-caption', 'Enter a positive area and finished depth.');
        if (error) { error.textContent = 'Enter positive measurements for the selected area method and a positive finished depth.'; error.hidden = false; }
        return;
      }
      const installedYards = area * depth / 324;
      output('cst-net-yards', installedYards.toFixed(2) + ' yd³');
      if (densityValid) {
        output('cst-net-tons', (installedYards * density).toFixed(2) + ' tons');
        output('cst-ton-coverage', Math.round(324 / (depth * density)).toLocaleString('en-US') + ' sq ft');
      } else {
        ['cst-net-tons', 'cst-ton-coverage'].forEach(id => output(id, '—'));
      }
      if (extraValid) output('cst-order-yards', (installedYards * (1 + extra / 100)).toFixed(2) + ' yd³');
      else output('cst-order-yards', '—');
      if (densityValid && extraValid) {
        const orderTons = installedYards * (1 + extra / 100) * density;
        output('cst-order-tons', orderTons.toFixed(2));
        output('cst-order-pounds', Math.round(orderTons * 2000).toLocaleString('en-US') + ' lb');
        output('cst-caption', area.toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' sq ft at ' + depth + ' in depth, with ' + extra + '% extra');
        if (error) error.hidden = true;
      } else {
        ['cst-order-tons', 'cst-order-pounds'].forEach(id => output(id, '—'));
        output('cst-caption', 'Volume is shown; check the weight or extra field.');
        if (error) { error.textContent = 'Enter a positive loose bulk weight and an extra percentage from 0 to 100.'; error.hidden = false; }
      }
    }
    numberIds.forEach(id => input(id)?.addEventListener('input', updateCrushedStoneTons));
    document.querySelectorAll<HTMLInputElement>('input[name="cst-measure-mode"]').forEach(item => item.addEventListener('change', updateCrushedStoneTons));
    updateCrushedStoneTons();
  </script>
</BaseLayout>

<style>
  .cst-tool { padding: var(--space-8) 0; }
  .cst-section-heading { max-width: 760px; margin-bottom: var(--space-6); }
  .cst-section-heading h2, .cst-panel h2 { color: var(--text-primary); font-size: var(--text-2xl); line-height: 1.25; margin: 0 0 var(--space-3); }
  .cst-section-heading p, .cst-panel p { color: var(--text-secondary); line-height: 1.7; }
  .cst-eyebrow { color: var(--accent-gold) !important; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; font-size: var(--text-xs); margin: 0 0 var(--space-2); }
  .cst-tool-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: var(--space-5); align-items: start; }
  .cst-card, .cst-panel { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: var(--space-8); }
  .cst-mode { border: 0; padding: 0; margin: 0 0 var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cst-mode legend { color: var(--text-primary); font-weight: 700; padding: 0 0 var(--space-2); }
  .cst-mode label { color: var(--text-secondary); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); display: inline-flex; align-items: center; gap: var(--space-2); cursor: pointer; }
  .cst-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4); }
  .cst-fields[hidden] { display: none; }
  .cst-field { min-width: 0; }
  .cst-field label { display: block; color: var(--text-primary); font-weight: 700; margin-bottom: var(--space-2); }
  .cst-field label span { color: var(--text-muted); font-weight: 400; }
  .cst-field input { width: 100%; min-width: 0; color: var(--text-primary); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-3); font: inherit; }
  .cst-field input[aria-invalid="true"] { border-color: #d87468; }
  .cst-field input:focus-visible, .cst-mode input:focus-visible, .cst-jumps a:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .cst-help { border-top: 1px solid var(--border-subtle); padding-top: var(--space-3); }
  .cst-help p { color: var(--text-muted); line-height: 1.5; font-size: var(--text-sm); margin: var(--space-2) 0; }
  .cst-help strong { color: var(--text-primary); }
  .cst-error { color: #f1a098; font-size: var(--text-sm); margin: var(--space-3) 0 0; }
  .cst-result-card { border-top: 3px solid var(--accent-gold); }
  .cst-main-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); color: var(--text-primary); }
  .cst-main-result strong { font-size: clamp(2.8rem, 6vw, 4.5rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .cst-main-result span { font-size: var(--text-lg); }
  .cst-caption { color: var(--text-muted); margin: var(--space-3) 0 var(--space-6); }
  .cst-breakdown { margin: 0; }
  .cst-breakdown div { display: flex; justify-content: space-between; gap: var(--space-3); border-top: 1px solid var(--border-subtle); padding: var(--space-3) 0; }
  .cst-breakdown dt { color: var(--text-secondary); }
  .cst-breakdown dd { margin: 0; color: var(--text-primary); font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
  .cst-result-note { color: var(--text-muted); font-size: var(--text-sm); line-height: 1.5; margin: var(--space-4) 0 0; }
  .cst-guide { padding: var(--space-8) 0 var(--space-12); background: var(--bg-body); }
  .cst-jumps { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-5); }
  .cst-jumps strong { color: var(--text-primary); margin-right: var(--space-2); }
  .cst-jumps a { color: var(--accent-gold); font-size: var(--text-sm); }
  .cst-panel { margin-bottom: var(--space-5); }
  .cst-panel p:last-child { margin-bottom: 0; }
  .cst-math-panel { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: var(--space-6); align-items: center; }
  .cst-math-panel > * { min-width: 0; }
  .cst-formula { background: var(--bg-surface); border-left: 3px solid var(--accent-gold); padding: var(--space-4); margin: var(--space-4) 0; overflow-x: auto; }
  .cst-formula code { display: block; color: var(--text-primary); font-size: var(--text-sm); white-space: nowrap; }
  .cst-formula code + code { margin-top: var(--space-2); }
  .cst-math-panel figure { margin: 0; }
