---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy' }
];

const entityTags = [
  { label: 'Policy Type', value: 'Data Privacy & Transparency' },
  { label: 'Effective Date', value: 'January 2026' },
  { label: 'Last Updated', value: 'September 2026' },
  { label: 'Storage Standard', value: 'Client-Side LocalStorage' }
];

const quickStats = [
  { value: 'Zero Tracking', label: 'Personal Data', desc: 'No personal identification collected or sold' },
  { value: 'Local Only', label: 'Saved Projects', desc: 'All dimensions and project estimates stay on your device' },
  { value: '100% Free', label: 'Open Access', desc: 'No registration, accounts, or mandatory logins required' }
];
---

<BaseLayout
  title="Privacy Policy - Rock Coverage Calculator"
  metaDescription="Read our transparent privacy policy. Learn how Rock Coverage Calculator handles local browser storage, analytics, and data protection."
  canonicalPath="/privacy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Privacy Policy - Rock Coverage Calculator",
      "url": "https://rockcoveragecalculator.com/privacy",
      "description": "Privacy policy and client-side data protection disclosure for Rock Coverage Calculator.",
      "publisher": {
        "@type": "Organization",
        "name": "Rock Coverage Calculator",
        "url": "https://rockcoveragecalculator.com"
      }
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Privacy Policy"
      highlightWord="Policy"
      badge="Transparency & User Rights"
      subtitle="At Rock Coverage Calculator, we believe calculations should be fast, private, and secure. We do not require accounts, harvest personal data, or sell user records."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <article class="guide-content">
      <div class="guide-container">

        <div class="aeo-quick-card">
          <div class="aeo-badge">Key Privacy Summary</div>
          <h3>Your Estimations Stay on Your Device</h3>
          <p>
            Rock Coverage Calculator runs directly in your web browser. When you input measurements, select aggregates, or save project zones, that data is processed client-side and saved into your browser's private local storage. We do not maintain user accounts or store your jobsite estimates on our servers.
          </p>
        </div>

        <h2>1. Information We Do Not Collect</h2>
        <p>
          We do not require you to create an account, register, or provide personal credentials to use any of our 56+ calculation engines. We do not collect:
        </p>
        <ul>
          <li>Names, home or business addresses, or phone numbers</li>
          <li>Credit card numbers or payment processing information</li>
          <li>Proprietary project blueprints, property locations, or contractor client records</li>
          <li>User passwords or account credentials</li>
        </ul>

        <h2>2. Browser Local Storage (Client-Side Storage)</h2>
        <p>
          To enhance your user experience, this website uses standard HTML5 <code>localStorage</code> technology. This allows your browser to remember:
        </p>
        <ul>
          <li><strong>Saved Project Zones:</strong> Your active multi-zone project list, including dimensions, rock materials, and cost parameters.</li>
          <li><strong>Theme Preferences:</strong> Whether you prefer dark mode or light mode.</li>
          <li><strong>Measurement Units:</strong> Your preferred default input unit (Feet, Inches, Yards, or Meters).</li>
        </ul>
        <p>
          This data remains exclusively within your local browser sandbox. It is never transmitted across the network to our servers. You may erase this data at any time by clicking "Clear All" in the Saved Projects drawer or by clearing your browser's site data and cookies.
        </p>

        <h2>3. Google AdSense, Cookies & Advertising Technologies</h2>
        <p>
          We use third-party advertising partners, including <strong>Google AdSense</strong>, to serve advertisements when you visit our website. These advertising companies may collect and use information (not including your name, address, email address, or telephone number) about your visits to this and other websites in order to provide advertisements about goods and services of interest to you.
        </p>
        <ul>
          <li>
            <strong>Third-Party Vendors & Google Cookies:</strong> Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites across the Internet.
          </li>
          <li>
            <strong>Advertising & DoubleClick Cookies:</strong> Google's use of advertising cookies enables it and its partners to serve ads to users based on their visit to Rock Coverage Calculator and/or other sites on the Internet.
          </li>
          <li>
            <strong>Opting Out of Personalized Advertising:</strong> You may opt out of personalized advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-gold">Google Ads Settings</a>. Alternatively, you may opt out of a third-party vendor's use of cookies for personalized advertising by visiting <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-gold">www.aboutads.info</a> or the Network Advertising Initiative opt-out page at <a href="https://optout.networkadvertising.org" target="_blank" rel="noopener noreferrer" class="text-gold">optout.networkadvertising.org</a>.
          </li>
          <li>
            <strong>Managing Browser Cookies:</strong> You can choose to disable or selectively turn off third-party cookies in your browser settings. However, this can affect how you interact with this site as well as other websites.
          </li>
        </ul>

        <h2>4. Server Logs & Anonymous Web Analytics</h2>
        <p>
          Like virtually all standard web servers, our hosting infrastructure may record basic technical request information when you load a web page. This includes:
        </p>
        <ul>
          <li>Your internet protocol (IP) address</li>
          <li>Browser type, device classification, and operating system</li>
          <li>Referring URLs, pages visited, and timestamps</li>
        </ul>
        <p>
          These technical logs are used solely for diagnosing network performance, detecting distributed denial-of-service (DDoS) traffic, and optimizing page load speeds. They are not linked to identifiable individuals.
        </p>

        <h2>5. Third-Party Services & External Links</h2>
        <p>
          Our guides and calculators may contain informational links to trusted technical standards organizations, such as ASTM International, AASHTO, state Departments of Transportation (DOT), and the National Stone, Sand & Gravel Association (NSSGA).
        </p>
        <p>
          We have no control over the privacy practices of external websites. When you click an outbound link to an external resource, we encourage you to review that third party's privacy policy.
        </p>

        <h2>6. European Economic Area (EEA), UK & Swiss Privacy (GDPR & Consent Framework)</h2>
        <p>
          For users residing within the European Economic Area (EEA), the United Kingdom, or Switzerland:
        </p>
        <ul>
          <li>
            Under the General Data Protection Regulation (GDPR) and the ePrivacy Directive, you have the right to grant or deny consent for the storage and accessing of cookies or other information on your device.
          </li>
          <li>
            Where required by law, we implement a Google-certified Consent Management Platform (CMP) that adheres to the IAB Europe Transparency and Consent Framework (TCF v2.2) to obtain explicit consent for personalized advertising and non-essential cookies.
          </li>
          <li>
            You can modify or withdraw your consent preferences at any time through our on-site cookie settings or through your browser settings.
          </li>
        </ul>

        <h2>7. California Consumer Privacy Rights (CCPA / CPRA)</h2>
        <p>
          Under the California Consumer Privacy Act (CCPA), as amended by the California Privacy Rights Act (CPRA), California residents have specific rights regarding their personal information:
        </p>
        <ul>
          <li><strong>Right to Know & Access:</strong> You have the right to know what personal information is collected, used, shared, or sold.</li>
          <li><strong>Right to Delete:</strong> You have the right to request deletion of personal information collected from you.</li>
          <li><strong>Right to Opt-Out of Sale or Sharing:</strong> We do not sell your personal identifying information for monetary consideration. However, under California law, sharing data with third-party advertising partners for cross-context behavioral advertising may be considered a "sale" or "share." You may exercise your right to opt out of personalized ad targeting using the <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-gold">Google Ads Settings</a> or <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-gold">AboutAds.info</a> opt-out tools.</li>
          <li><strong>Non-Discrimination:</strong> We will not discriminate against you for exercising any of your CCPA/CPRA rights.</li>
        </ul>

        <h2>8. Children's Privacy (COPPA Compliance)</h2>
        <p>
          Rock Coverage Calculator is designed for commercial contractors, landscape architects, civil estimators, and adult property owners. We do not knowingly collect or solicit any personal information from children under the age of 13.
        </p>

        <h2>9. Contacting Us Regarding Privacy</h2>
        <p>
          If you have questions, feedback, or concerns regarding our privacy practices or advertising disclosures, please contact our editorial and compliance team:
        </p>
        <div class="contact-box">
          <p><strong>Rock Coverage Calculator — Compliance & Privacy Desk</strong></p>
          <p>Email: <a href="mailto:privacy@rockcoveragecalculator.com" class="text-gold">privacy@rockcoveragecalculator.com</a></p>
          <p>Website: <a href="https://rockcoveragecalculator.com" class="text-gold">rockcoveragecalculator.com</a></p>
        </div>

      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .guide-content {
    padding: var(--space-12) var(--space-4);
  }

  .guide-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .aeo-quick-card {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-left: 4px solid #10b981;
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .aeo-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #10b981;
    margin-bottom: var(--space-2);
  }

  .aeo-quick-card h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.15rem;
    color: var(--text-bright);
  }

  .aeo-quick-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .guide-content h2 {
    font-size: 1.35rem;
    color: var(--text-bright);
    margin: var(--space-8) 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-content p, .guide-content li {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .guide-content ul {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .guide-content li {
    margin-bottom: var(--space-2);
  }

  .contact-box {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-top: var(--space-4);
  }

  .contact-box p {
    margin: var(--space-1) 0;
  }

  .text-gold {
    color: var(--gold-400, #d97706);
    text-decoration: underline;
  }
</style>
