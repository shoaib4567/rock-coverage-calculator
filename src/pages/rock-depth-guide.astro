  { title: 'Pea Gravel Calculator', slug: '/pea-gravel-calculator', badge: 'Paths', desc: 'Price a shallow pea gravel finish separately from its compacted base.' },
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: 'River stone', desc: 'Estimate a bed using the actual stone size and a depth checked in a trial patch.' }
