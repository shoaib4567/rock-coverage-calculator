  guideSubtitle="A complete field reference for aggregate depth. Avoid exposed fabric, walking fatigue, and material shortages with application-specific standards."
  standardBadge="Field Engineering Specification"
  readingTime="7 min read"
  lastUpdated="September 2026"
  calculatorsSupported={calculatorsSupported}
