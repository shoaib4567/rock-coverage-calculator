---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import CoverageChartCalculator from '../components/calculators/CoverageChartCalculator.astro';
import CoverageChartVisualizer from '../components/visualizers/CoverageChartVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import QuickConverterBlock from '../components/intent/QuickConverterBlock.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Rock Coverage Chart', url: '/rock-coverage-chart' }
];

const entityTags = [
  {
    "label": "Coverage formula",
    "value": "324 ÷ depth in inches = sq ft per yd³"
  },
  {
    "label": "Weight conversion",
    "value": "Divide yard coverage by short tons per yd³"
  },
  {
    "label": "Bag coverage",
    "value": "Bag cu ft × 12 ÷ inches"
  },
  {
    "label": "Depths",
    "value": "Comparison inputs, not design standards"
  }
];

const quickStats = [
  {
    "value": "162 sq ft",
    "label": "One yard at 2 inches",
    "desc": "Geometric coverage, before placement losses"
  },
  {
    "value": "108 sq ft",
    "label": "One yard at 3 inches",
    "desc": "Volume-based comparison"
  },
  {
    "value": "80 sq ft",
    "label": "One short ton at 3 inches",
    "desc": "Only at the example 1.35 short tons per yd³"
  }
];

const faqItems = [
  {
    "q": "How many square feet does one cubic yard cover?",
    "a": "Divide 324 by depth in inches: 162 square feet at 2 inches, 108 at 3 inches and 81 at 4 inches. These geometric figures exclude allowances and do not select an installation depth."
  },
  {
    "q": "How many square feet does one ton cover?",
    "a": "For a short ton (2,000 lb), divide 324 by depth in inches and by the supplier’s short tons per cubic yard. At 3 inches and an example 1.35 short tons per yard, the result is 80 square feet. Different loose weights produce different coverage."
  },
  {
    "q": "Does stone size change the volume formula?",
    "a": "No. Size can affect a practical layer thickness, voids and loose weight. The geometric formula stays the same. Confirm the selected product and depth instead of treating a size name as a density."
  },
  {
    "q": "How do I estimate a 500-square-foot order from the chart?",
    "a": "At 3 inches and an example 1.35 short tons per yard, 500 ÷ 80 = 6.25 short tons before extra. A selected 10% increase gives about 6.88 short tons. Use unrounded inputs for the final order calculation."
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'How Much Rock Do I Need? (Intent Hub)', slug: '/how-much-rock-do-i-need', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Square Foot Calculator', slug: '/rock-square-foot-calculator', badge: 'Sq Ft' },
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Yards' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'Bags' }
];

const bridgeLinks = [
  { title: 'Pea Gravel Coverage Calculator', slug: '/pea-gravel-coverage-calculator', badge: 'Pea Gravel' },
  { title: 'Gravel Tons Calculator', slug: '/gravel-tons-calculator', badge: 'Gravel Tons' },
  { title: 'Crushed Stone Tons Calculator', slug: '/crushed-stone-tons-calculator', badge: 'Crushed Stone' },
  { title: 'River Rock Tons Calculator', slug: '/river-rock-tons-calculator', badge: 'River Rock' }
];

const supportGuides = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech' },
  { title: 'Gravel Size and Sieve Guide', slug: '/gravel-sizes', badge: 'AASHTO M43' }
];
---

<BaseLayout
  title="Rock Coverage Chart"
  metaDescription="Master rock coverage chart and dynamic calculator. Lookup exact square foot yields per cubic yard and ton across 1 to 6 inch depths for all landscaping stones."
  canonicalPath="/rock-coverage-chart"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Rock Coverage Chart",
      "url": "https://rockcoveragecalculator.com/rock-coverage-chart",
      "description": "Interactive rock coverage chart and depth matrix calculator for landscape aggregates.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en",
      "about": {
        "@type": "Thing",
        "name": "Rock Coverage Chart"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Rock Coverage Chart"
      highlightWord="Chart"
      badge="Civil Reference & Yield Matrix"
      subtitle="Compare geometric coverage at different depths using example loose bulk weights. Choose the actual depth and supplier weight for your product."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="utility"
    />

    <CoverageChartCalculator />

    <CoverageChartVisualizer />

    <!-- Instant Unit Equivalents Block -->
    <QuickConverterBlock />

    <!-- Engineering Guide Section -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Read the unit before using a coverage figure</h2><p>This chart compares geometric coverage at different depths. A cubic yard is a volume; a short ton is 2,000 pounds of weight. Their coverage figures can be compared only after stating a loose bulk density. Metric tonnes and long tons are different units and should not be substituted into the short-ton column.</p><h3>Three coverage formulas</h3><div class="formula-box"><code>Sq ft per cubic yard = 324 ÷ depth in inches</code><br/><code>Sq ft per short ton = 324 ÷ depth ÷ short tons per yd³</code><br/><code>Sq ft per bag = bag volume in cu ft × 12 ÷ depth</code></div><div class="table-wrapper"><table class="guide-table"><caption>Coverage before extra, using an example loose weight of 1.35 short tons per yd³ and a 0.5-cu-ft bag</caption><thead><tr><th scope="col">Depth</th><th scope="col">Sq ft per yd³</th><th scope="col">Sq ft per short ton</th><th scope="col">Sq ft per bag</th></tr></thead><tbody><tr><th scope="row">1 in</th><td>324</td><td>240</td><td>6</td></tr><tr><th scope="row">1.5 in</th><td>216</td><td>160</td><td>4</td></tr><tr><th scope="row">2 in</th><td>162</td><td>120</td><td>3</td></tr><tr><th scope="row">2.5 in</th><td>129.6</td><td>96</td><td>2.4</td></tr><tr><th scope="row">3 in</th><td>108</td><td>80</td><td>2</td></tr><tr><th scope="row">4 in</th><td>81</td><td>60</td><td>1.5</td></tr><tr><th scope="row">6 in</th><td>54</td><td>40</td><td>1</td></tr></tbody></table></div><h3>Density changes weight coverage, not yard coverage</h3><p>At 3 inches one yard geometrically covers 108 sq ft regardless of the selected weight. At 1.35 short tons per yard, one short ton corresponds to 80 sq ft. At a lighter example 0.75 short tons per yard it corresponds to 144 sq ft. These are conversion examples, not certified weights for every stone sold under a material name. Ask for the quoted product’s loose weight or labeled bag yield.</p><h3>Keep rounding and extra separate</h3><p>At 2.5 inches the exact geometric yard figure is 129.6 sq ft. A display rounded to 130 is useful for a quick comparison; use unrounded calculations for an order. Divide your actual area by the applicable coverage figure, then apply a chosen extra allowance once. Do not add another allowance if the supplier’s quote already includes it.</p><h3>Example: 500 sq ft at 3 inches</h3><p>The net layer is 125 cu ft or 4.63 yd³. A selected 10% order increase gives 137.5 cu ft or 5.09 yd³: 275 half-cubic-foot bags, or about 6.88 short tons at the example 1.35 density. Rounding whole bags and rounding a bulk order are separate purchasing decisions.</p><p>Use the <a href="/rock-depth-guide">depth guide</a> to review thickness questions, the <a href="/rock-density-chart">density reference</a> to understand loose weights, and the <a href="/rock-square-foot-calculator">square-foot calculator</a> for a known area. The <a href="/rock-coverage-calculator-yard">cubic-yard calculator</a> also works backward from volume. A coverage table does not determine a drainage or load-bearing design.</p></div><div class="content-card faq-card"><h2>Questions about this calculation</h2><div class="faq-accordion">{faqItems.map((item,index)=><details class="faq-detail" open={index===0}><summary class="faq-summary">{item.q}</summary><div class="faq-answer"><p>{item.a}</p></div></details>)}</div></div></div></article>

    <TopicClusterNav />
  </main>

  <Footer />
</BaseLayout>

<style>
.content-guide-section {
  padding: var(--space-12) 0;
  background: var(--color-bg);
}

.aeo-quick-card {
  background: var(--color-surface);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  margin-bottom: var(--space-8);
  box-shadow: 0 4px 20px rgba(202, 138, 4, 0.08);
}
.aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--color-primary); }
.aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
.aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
.aeo-quick-item { background: var(--color-bg); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--color-border); }
.aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary); margin-bottom: 2px; }
.aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--color-text); margin-bottom: 2px; }
.aeo-quick-desc { font-size: 11px; color: var(--color-text-muted); margin: 0; line-height: 1.35; }

.content-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  margin-bottom: var(--space-8);
}

.content-card h2 {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}

.content-card h3 {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  margin: var(--space-6) 0 var(--space-3) 0;
}

.content-card p {
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: var(--space-4);
}

.content-card ul {
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: var(--space-4);
  padding-left: var(--space-6);
}

.content-card li {
  margin-bottom: var(--space-2);
}

.table-container {
  overflow-x: auto;
  margin: var(--space-4) 0;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}

th {
  text-align: left;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg);
  color: var(--color-text);
  border-bottom: 2px solid var(--color-border);
  font-weight: 600;
}

td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

tr:hover td {
  background: rgba(202, 138, 4, 0.04);
}

.formula-box { background: var(--color-bg); border-left: 3px solid var(--color-primary); padding: var(--space-4); border-radius: 0 var(--radius-md) var(--radius-md) 0; margin: var(--space-4) 0; font-family: var(--font-mono); color: var(--color-primary); font-size: var(--text-sm); line-height: 1.8; }
.table-wrapper { overflow-x: auto; margin: var(--space-5) 0; }
.guide-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
.guide-table caption { text-align: left; font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--space-2); }
.faq-accordion { display: flex; flex-direction: column; gap: var(--space-3); }
.faq-detail { border-bottom: 1px solid var(--color-border); padding: var(--space-3) 0; }
.faq-summary { font-weight: 600; color: var(--color-text); cursor: pointer; }
.faq-answer p { margin: var(--space-2) 0 0; }
.faq-card {
  margin-top: var(--space-8);
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-top: var(--space-4);
}

.faq-item {
  padding: var(--space-4);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.faq-item h3 {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
  margin: 0 0 var(--space-2) 0;
}

.faq-item p {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
  margin: 0;
}
</style>
