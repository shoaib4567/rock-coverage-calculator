---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import CivilStructuralBlock from '../components/intent/CivilStructuralBlock.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gravel Calculator', url: '/gravel-calculator' },
  { name: 'Driveway Rock Calculator', url: '/driveway-rock-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Driveway Rock Coverage' },
  { label: 'Standard Sieve', value: 'ASTM D448 #57 Surface & #4 Base' },
  { label: 'Bulk Density', value: '1.40 t/yd³ (2,800 lbs/yd³)' },
  { label: 'Compaction Factor', value: '15% to 20% Vehicular Settling' }
];

const quickStats = [
  { value: '1.40 t/yd³', label: 'Quarry Density', desc: 'Standard bulk density for fractured angular driveway stone' },
  { value: '15% Factor', label: 'Compaction', desc: 'Volume allowance for vehicle rolling and wheel rut displacement' },
  { value: '15 Tons', label: 'Tri-Axle Load', desc: 'Standard commercial payload for residential driveway delivery' }
];

const faqItems = [
  {
    "q": "How much rock does a 12 × 50 ft driveway need?",
    "a": "For one 3-inch layer, the measured volume is 5.56 cubic yards. A selected 15% allowance gives 6.39 yards and about 8.94 US short tons at the example 1.40 tons per yard. Base and surface layers must be estimated separately."
  },
  {
    "q": "Does every driveway need the same depth?",
    "a": "No. Use the layer thicknesses selected for the ground, drainage, traffic and material. A surface top-up and a new driveway base are different jobs."
  },
  {
    "q": "Does the calculator specify fabric or a base?",
    "a": "No. Choose subgrade treatment, separator and base from the installation plan. The tool estimates quantities from dimensions; it does not assess bearing capacity."
  },
  {
    "q": "Is 15 tons a standard truck capacity?",
    "a": "No. It is an illustrative load used in this estimate. Confirm actual payload, volume and access with the supplier."
  }
];

const upLinks = [
  { title: 'Gravel Calculator (Material Parent)', slug: '/gravel-calculator', badge: 'Material' },
  { title: 'Rock Tons Calculator (Unit Parent)', slug: '/rock-tons-calculator', badge: 'Unit' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Gravel Tons Calculator', slug: '/gravel-tons-calculator', badge: 'Tons' },
  { title: 'Crushed Granite Calculator', slug: '/crushed-granite-calculator', badge: 'Granite' },
  { title: 'Crusher Run Calculator', slug: '/crusher-run-calculator', badge: 'Road Base' }
];

const bridgeLinks = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' }
];

const supportGuides = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="Driveway Rock Calculator - Rock Coverage Calculator for Driveways"
  metaDescription="Calculate estimated tons and cubic yards of driveway rock, #57 stone, and crusher run. Calibrated for vehicle compaction, sub-base depths, and truckloads."
  canonicalPath="/driveway-rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Driveway Rock Calculator",
      "url": "https://rockcoveragecalculator.com/driveway-rock-calculator",
      "description": "Calculates tons and cubic yards of driveway stone, gravel, and base aggregate with vehicle compaction allowances.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Paving Contractors, Homeowners, Civil Estimators"
      },
      "about": {
        "@type": "Thing",
        "name": "Driveway Rock Coverage Calculation"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Driveway Rock Calculator"
      highlightWord="Driveway"
      badge="Heavy Vehicular Sizing Engine"
      subtitle="Estimate one driveway layer from area, finished depth and an optional order allowance. Confirm the material and delivery with your supplier."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="civil"
    />

    <!-- Interactive Driveway Rock Calculator Tool -->
    <section class="section">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h2>Driveway Dimensions and Specifications</h2>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="dwr-length">Driveway Length (Feet)</label>
              <input type="number" id="dwr-length" value="50" min="1" step="1" />
            </div>
            <div class="input-field">
              <label for="dwr-width">Driveway Width (Feet)</label>
              <input type="number" id="dwr-width" value="12" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="dwr-depth">Installed Depth (Inches)</label>
              <input type="number" id="dwr-depth" value="3.0" min="1" max="18" step="0.5" />
            </div>
            <div class="input-field">
              <label for="dwr-compaction">Compaction Allowance (%)</label>
              <input type="number" id="dwr-compaction" value="15" min="0" max="30" step="1" />
            </div>
          </div>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h2>Required Material Totals</h2>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
              <div class="kpi-value" id="kpi-dwr-tons">0.00</div>
              <div class="kpi-label">Quarry Weight (Tons)</div>
              <div class="kpi-subtext" id="kpi-dwr-lbs">0 lbs total weight</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-dwr-yards">0.00</div>
              <div class="kpi-label">Volume (Cubic Yards)</div>
              <div class="kpi-subtext">Includes 15% compaction</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-dwr-loads">0.0</div>
              <div class="kpi-label">Example Truckloads</div>
              <div class="kpi-subtext">15-ton example; confirm payload</div>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Civil Truckload Logistics & Subgrade Stabilization Block -->
    <CivilStructuralBlock />

    <!-- Technical Guide on Driveway Rock Coverage -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Estimate one driveway layer at a time</h2><p>Enter the footprint and finished depth for the selected layer. This tool uses an example 1.40 US short tons per loose cubic yard. Its extra-material input increases the order volume; the starting percentage is not a universal compaction requirement.</p><p>Use the <a href="/layered-project-calculator">layered planner</a> for separate base and surface orders. A driveway’s required aggregate, grading, thickness and compaction depend on the soil, drainage, traffic and applicable design. The quantity calculation does not establish load capacity.</p><h2>Work through an example</h2><p>A 12 × 50 ft footprint has 600 sq ft. A 3-inch layer occupies 600 × 3 ÷ 324 = 5.56 yd³ before extra. With a chosen 15% allowance, the order estimate is 6.39 yd³, or 8.94 US short tons at 1.40 tons per yard. Calculate another layer separately if the plan includes a base.</p><h2>Choose the actual material</h2><p>Clean angular stone and dense-graded base are different products. A size designation such as #57 does not establish mineral type, fines content or structural suitability. Ask for the specified grading and local loose bulk weight. A rounded decorative surface may shift under turning tires; do not select a wearing layer solely by color.</p><h2>Check the order and delivery</h2><p>Tell the supplier the material, separate layer quantities, selling unit, order increment and delivery location. The displayed 15-ton load is an example used for dividing the estimated tons, not a standard tri-axle rating. Actual payload, clearances, access and surface suitability must come from the supplier.</p><p>For editable supplier bulk weight use the <a href="/gravel-calculator">gravel calculator</a>. The <a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/">Penn State materials calculator</a> also distinguishes compacted finished dimensions from loose shipped quantities.</p><h2>Questions before ordering</h2>{faqItems.map(item=><section><h2>{item.q}</h2><p>{item.a}</p></section>)}</div></div></article>

    <TopicClusterNav
      currentPage="/driveway-rock-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateDWR() {
      const l = parseFloat((document.getElementById('dwr-length') as HTMLInputElement)?.value) || 0;
      const w = parseFloat((document.getElementById('dwr-width') as HTMLInputElement)?.value) || 0;
      const d = parseFloat((document.getElementById('dwr-depth') as HTMLInputElement)?.value) || 0;
      const comp = parseFloat((document.getElementById('dwr-compaction') as HTMLInputElement)?.value) || 0;

      const netYards = (l * w * d) / 324;
      const totalYards = netYards * (1 + comp / 100);
      const tons = totalYards * 1.40;
      const lbs = tons * 2000;
      const loads = tons / 15;

      const tEl = document.getElementById('kpi-dwr-tons');
      const yEl = document.getElementById('kpi-dwr-yards');
      const lEl = document.getElementById('kpi-dwr-loads');
      const lbsEl = document.getElementById('kpi-dwr-lbs');

      if (tEl) tEl.innerText = tons.toFixed(2);
      if (yEl) yEl.innerText = totalYards.toFixed(2);
      if (lEl) lEl.innerText = loads.toFixed(1);
      if (lbsEl) lbsEl.innerText = Math.round(lbs).toLocaleString() + ' lbs total weight';
    }

    ['dwr-length', 'dwr-width', 'dwr-depth', 'dwr-compaction'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateDWR);
    });
    updateDWR();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }
  .aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--accent-gold); }
  .aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .aeo-quick-item { background: var(--bg-surface); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); margin-bottom: 2px; }
  .aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .aeo-quick-desc { font-size: 11px; color: var(--text-muted); margin: 0; line-height: 1.35; }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .faq-card { margin-top: var(--space-8); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-item h3 { font-size: var(--text-base); color: var(--text-primary); margin: 0 0 var(--space-2) 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--text-muted); margin: 0; }
</style>
