---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'River Rock Calculator', url: '/river-rock-calculator' },
  { name: 'River Rock Coverage Calculator', url: '/river-rock-coverage-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'River Rock Coverage' },
  { label: 'Yield at 3"', value: '80 sq ft per Ton (108 sq ft / Yd³)' },
  { label: 'Yield at 4"', value: '60 sq ft per Ton (81 sq ft / Yd³)' },
  { label: 'Bulk Density', value: '1.35 t/yd³ (2,700 lbs/yd³)' }
];

const quickStats = [
  { value: '80 sq ft', label: 'Per Ton at 3"', desc: 'Square foot coverage per ton of 1-3 inch medium river stone' },
  { value: '60 sq ft', label: 'Per Ton at 4"', desc: 'Square foot coverage per ton of 3-5 inch large river cobbles' },
  { value: '3.0 Inches', label: 'Optimum Depth', desc: 'Minimum depth to ensure 100% soil and fabric opacity' }
];

const faqItems = [
  {
    q: 'How many square feet does 1 ton of river rock cover?',
    a: 'One ton of 1-inch to 3-inch river rock covers approximately 120 square feet at 2 inches depth, 80 square feet at 3 inches depth, and 60 square feet at 4 inches depth. For larger 3-inch to 5-inch cobbles installed at 4 inches depth, one ton covers 60 square feet.'
  },
  {
    q: 'How much river rock do I need for 400 square feet?',
    a: 'For 400 square feet at a standard 3-inch depth, you need 3.70 cubic yards of river rock. Multiplying by 1.35 tons per yard and adding a 10 percent safety buffer yields approximately 5.50 short tons (11,000 lbs).'
  },
  {
    q: 'Why does river rock require deeper installation than crushed stone?',
    a: 'Because river rocks have smooth, rounded shapes, they roll against each other and leave larger natural gaps. To prevent underlying weed barrier fabric or bare soil from showing through, install at a depth equal to at least 1.5 to 2 times the maximum stone diameter.'
  },
  {
    q: 'How many cubic yards of river rock do I need for 1,000 square feet?',
    a: 'For 1,000 square feet at 3 inches depth, you need 9.26 cubic yards (approximately 12.5 tons). At 4 inches depth, you need 12.35 cubic yards (approximately 16.7 tons).'
  }
];

const upLinks = [
  { title: 'River Rock Calculator (Material Parent)', slug: '/river-rock-calculator', badge: 'Material' },
  { title: 'Rock Square Foot Calculator (Unit Parent)', slug: '/rock-square-foot-calculator', badge: 'Unit' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'River Rock Tons Calculator', slug: '/river-rock-tons-calculator', badge: 'Tons' },
  { title: 'River Rock Cubic Yard Calculator', slug: '/river-rock-cubic-yard-calculator', badge: 'Yards' },
  { title: 'Pea Gravel Coverage Calculator', slug: '/pea-gravel-coverage-calculator', badge: 'Pea Gravel' }
];

const bridgeLinks = [
  { title: 'Dry Creek Bed Guide', slug: '/dry-creek-bed', badge: 'Drainage' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech' }
];

const supportGuides = [
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Dry Creek Bed Guide', slug: '/dry-creek-bed', badge: 'Drainage' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="River Rock Coverage Calculator - Square Feet per Ton & Yard"
  metaDescription="Calculate exact square foot coverage per ton and cubic yard for 1-3 inch and 3-5 inch river rock. Coverage tables, depth rules, and ton solvers."
  canonicalPath="/river-rock-coverage-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "River Rock Coverage Calculator",
      "url": "https://rockcoveragecalculator.com/river-rock-coverage-calculator",
      "description": "Calculates square foot coverage yields per ton and cubic yard for smooth river stone and cobbles.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Landscape Designers, Gardeners, Homeowners"
      },
      "about": {
        "@type": "Thing",
        "name": "River Rock Coverage Calculation"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="River Rock Coverage Calculator"
      highlightWord="Coverage"
      badge="Coverage Yield Engine"
      subtitle="Calculate square foot yields per ton and cubic yard for 1-3 inch and 3-5 inch smooth river stone."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <!-- Interactive River Rock Coverage Calculator Tool -->
    <section class="section" id="rrc-calculator-tool">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
              <h3>River Rock Project Dimensions</h3>
            </div>

            <div class="dim-grid single-col">
              <div class="input-field">
                <label for="rrc-area">Project Area (Square Feet)</label>
                <input type="number" id="rrc-area" value="350" min="1" step="10" />
              </div>
              <div class="input-field">
                <label for="rrc-depth">Layer Depth (Inches)</label>
                <input type="number" id="rrc-depth" value="3.0" min="1" max="12" step="0.5" />
              </div>
              <div class="input-field">
                <label for="rrc-waste">Safety Buffer (%)</label>
                <input type="number" id="rrc-waste" value="10" min="0" max="25" step="1" />
              </div>
            </div>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h3>Required Material Totals</h3>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <div class="kpi-value" id="kpi-rrc-tons">0.00</div>
                <div class="kpi-label">Quarry Weight (Tons)</div>
                <div class="kpi-subtext" id="kpi-rrc-lbs">0 lbs total weight</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="kpi-rrc-yards">0.00</div>
                <div class="kpi-label">Volume (Cubic Yards)</div>
                <div class="kpi-subtext" id="kpi-rrc-yield">0 sq ft / ton</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="kpi-rrc-bags">0</div>
                <div class="kpi-label">0.5 Cu Ft Bags</div>
                <div class="kpi-subtext">50 lbs each</div>
              </div>
            </div>

            <!-- Material Purchasing Tip -->
            <div class="purchase-card" style="margin-top: var(--space-6);">
              <div class="purchase-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <div class="purchase-content">
                <div class="purchase-title">Delivery Recommendation</div>
                <div class="purchase-desc">Bulk dump truck delivery is recommended for orders over 1.5 tons (approx. 1 cubic yard) to avoid retail bag markup.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide on River Rock Coverage -->
    <article class="content-guide-section">
      <div class="container">

        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="River Rock Coverage Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">River Rock Coverage Reference</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Coverage at 3"</span>
              <span class="aeo-quick-value">80 sq ft / Ton (108 sq ft / Yd)</span>
              <p class="aeo-quick-desc">Standard depth for 1-inch to 3-inch medium river stone.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Coverage at 4"</span>
              <span class="aeo-quick-value">60 sq ft / Ton (81 sq ft / Yd)</span>
              <p class="aeo-quick-desc">Recommended depth for 3-inch to 5-inch large river cobbles.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Rule of 324</span>
              <span class="aeo-quick-value">Sq Ft per Yard = 324 / Depth (in)</span>
              <p class="aeo-quick-desc">Multiply yard yield by 0.741 to calculate sq ft per short ton.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Depth Rule</span>
              <span class="aeo-quick-value">1.5x to 2x Stone Caliper</span>
              <p class="aeo-quick-desc">Prevents bare soil and weed barrier fabric show-through.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>River Rock Square Footage Coverage Chart</h2>
          <p>
            Because river rock has a certified bulk density of approximately <strong>1.35 tons per cubic yard (2,700 lbs/yd³)</strong>, one ton equals 0.741 cubic yards. Below is the reference coverage matrix:
          </p>

          <div style="overflow-x: auto; margin: var(--space-6) 0;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: var(--text-sm);">
              <thead>
                <tr style="border-bottom: 2px solid var(--border-subtle); color: var(--accent-gold);">
                  <th style="padding: 10px;">Depth (Inches)</th>
                  <th style="padding: 10px;">Sq Ft per Cubic Yard</th>
                  <th style="padding: 10px;">Sq Ft per Short Ton</th>
                  <th style="padding: 10px;">Sq Ft per 0.5 cu ft Bag</th>
                  <th style="padding: 10px;">Recommended Stone Caliper</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border-subtle);">
                  <td style="padding: 10px; font-weight: 600;">2.0"</td>
                  <td style="padding: 10px;">162 sq ft</td>
                  <td style="padding: 10px;">120 sq ft</td>
                  <td style="padding: 10px;">3.0 sq ft</td>
                  <td style="padding: 10px;">Small 3/8" to 3/4" river pebbles</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border-subtle); background: rgba(212, 168, 83, 0.05);">
                  <td style="padding: 10px; font-weight: 600;">3.0"</td>
                  <td style="padding: 10px;">108 sq ft</td>
                  <td style="padding: 10px;">80 sq ft</td>
                  <td style="padding: 10px;">2.0 sq ft</td>
                  <td style="padding: 10px;">Medium 1" to 3" river rock (Standard)</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border-subtle); background: rgba(212, 168, 83, 0.1);">
                  <td style="padding: 10px; font-weight: 600;">4.0"</td>
                  <td style="padding: 10px;">81 sq ft</td>
                  <td style="padding: 10px;">60 sq ft</td>
                  <td style="padding: 10px;">1.5 sq ft</td>
                  <td style="padding: 10px;">Large 3" to 5" river cobbles</td>
                </tr>
                <tr>
                  <td style="padding: 10px; font-weight: 600;">6.0"</td>
                  <td style="padding: 10px;">54 sq ft</td>
                  <td style="padding: 10px;">40 sq ft</td>
                  <td style="padding: 10px;">1.0 sq ft</td>
                  <td style="padding: 10px;">Dry creek bed channels and drainage swales</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About River Rock Coverage</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </article>

    <TopicClusterNav
      currentPage="/river-rock-coverage-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateRRC() {
      const a = parseFloat((document.getElementById('rrc-area') as HTMLInputElement)?.value) || 0;
      const d = parseFloat((document.getElementById('rrc-depth') as HTMLInputElement)?.value) || 0;
      const waste = parseFloat((document.getElementById('rrc-waste') as HTMLInputElement)?.value) || 0;

      const netYards = (a * d) / 324;
      const totalYards = netYards * (1 + waste / 100);
      const tons = totalYards * 1.35;
      const lbs = tons * 2000;
      const bags = Math.ceil(totalYards * 54);
      const yieldPerTon = d > 0 ? ((324 / d) / 1.35) : 0;

      const tEl = document.getElementById('kpi-rrc-tons');
      const yEl = document.getElementById('kpi-rrc-yards');
      const bEl = document.getElementById('kpi-rrc-bags');
      const lbsEl = document.getElementById('kpi-rrc-lbs');
      const yieldEl = document.getElementById('kpi-rrc-yield');

      if (tEl) tEl.innerText = tons.toFixed(2);
      if (yEl) yEl.innerText = totalYards.toFixed(2);
      if (bEl) bEl.innerText = bags.toLocaleString();
      if (lbsEl) lbsEl.innerText = Math.round(lbs).toLocaleString() + ' lbs';
      if (yieldEl) yieldEl.innerText = Math.round(yieldPerTon) + ' sq ft / ton yield';
    }

    ['rrc-area', 'rrc-depth', 'rrc-waste'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateRRC);
    });
    updateRRC();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }
  .aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--accent-gold); }
  .aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .aeo-quick-item { background: var(--bg-surface); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); margin-bottom: 2px; }
  .aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .aeo-quick-desc { font-size: 11px; color: var(--text-muted); margin: 0; line-height: 1.35; }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .faq-card { margin-top: var(--space-8); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-item h3 { font-size: var(--text-base); color: var(--text-primary); margin: 0 0 var(--space-2) 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--text-muted); margin: 0; }
</style>
