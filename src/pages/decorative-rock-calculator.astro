---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import DecorativeCalculator from '../components/calculators/DecorativeCalculator.astro';
import DecorativeVisualizer from '../components/visualizers/DecorativeVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const title = 'Decorative Rock Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: title, url: '/decorative-rock-calculator' }
];
const entityTags = [
  { label: 'Use', value: 'Visible stone beds & borders' },
  { label: 'Order units', value: 'Cubic yards, US tons & bags' },
  { label: 'Key input', value: 'Finished layer depth' }
];
const quickStats = [
  { value: '108 sq ft', label: 'One cubic yard at 3 in', desc: 'Geometric coverage before extra material' },
  { value: '27 ft³', label: 'One cubic yard', desc: 'Volume stays the same when stone type changes' },
  { value: '2,000 lb', label: 'One US short ton', desc: 'Use your supplier weight for a tonnage quote' }
];
const faqItems = [
  {
    q: 'How much decorative rock do I need for 100 square feet?',
    a: 'At a finished depth of 3 inches, 100 square feet needs 25 cubic feet, or about 0.93 cubic yard, before any extra material. At the mixed-stone planning weight of 1.30 US tons per cubic yard, that is about 1.20 US tons. A 0.5-cubic-foot bag count is 50; verify the actual bag label.'
  },
  {
    q: 'Does one ton of lava rock cover the same area as one ton of marble chips?',
    a: 'Usually no. Area and depth set the volume, while loose bulk weight determines how many tons fill that volume. The calculator uses editable examples of 0.75 US ton per cubic yard for lava rock and 1.35 for marble chips. Supplier figures can differ.'
  },
  {
    q: 'Can I assume every decorative rock bag is 0.5 cubic foot?',
    a: 'No. Bags are sold in different volumes and weights. Enter the cubic-foot volume from the product label. If only square-foot coverage is listed, use it to cross-check the result at the label’s stated depth; do not assume that a 20-pound bag contains the same volume as a 50-pound bag.'
  },
  {
    q: 'Will rock and landscape fabric stop all weeds?',
    a: 'No. A suitable rock layer can reduce light reaching the soil, and fabric may help in some sites, but windblown soil and organic debris can collect above the rock and support new weeds. Plan to remove debris and inspect edges.'
  }
];
---
<BaseLayout
  title={title}
  description="Estimate decorative rock in cubic yards, US tons and bags from your bed dimensions and depth. Compare marble chips, lava rock and beach pebbles with editable supplier weight and bag volume."
  canonicalPath="/decorative-rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: title,
      url: 'https://rockcoveragecalculator.com/decorative-rock-calculator',
      description: 'Estimates decorative stone volume, loose weight and labeled-volume bags for a chosen area and depth.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main id="main-content">
    <PageHero
      title={title}
      highlightWord="Calculator"
      badge="Garden beds · borders · accent stone"
      subtitle="For a 100 sq ft bed at 3 inches deep, plan on 25 cubic feet, or 0.93 cubic yard of decorative rock before an allowance. That is 50 bags if each bag contains 0.5 cubic foot. The tons depend on the actual stone you buy."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="decorative"
    />

    <DecorativeCalculator />
    <DecorativeVisualizer />

    <article class="deco-guide">
      <div class="container">
        <section class="deco-card" aria-labelledby="choose-heading">
          <p class="deco-eyebrow">Choose the finish</p>
          <h2 id="choose-heading">Which decorative rock belongs in this space?</h2>
          <p>Decorative rock is a visible finish, so start with the place it will be seen and touched. Size, shape and color affect how the bed looks and behaves; those details also determine the depth you should confirm with the seller. The calculator handles the order quantity after you choose that depth.</p>
          <div class="deco-choice-grid">
            <div>
              <h3>Marble chips</h3>
              <p>Angular, light-colored chips give strong contrast in a border or modern bed. Check the actual chip size and bag volume, and expect to remove leaves if you want the light surface to stay clean.</p>
              <a href="/marble-chips-calculator">Calculate marble chips →</a>
            </div>
            <div>
              <h3>Lava rock</h3>
              <p>Porous red or black pieces give a different texture and often a lighter load for the same bed volume. The loose weight varies widely between products, so confirm it before ordering by the ton.</p>
              <a href="/lava-rock-calculator">Calculate lava rock →</a>
            </div>
            <div>
              <h3>Beach pebbles</h3>
              <p>Smooth, rounded pebbles suit a contained accent area or water feature. Check the size grade and the seller's coverage chart. Rounded stones may move under frequent footsteps.</p>
              <a href="/beach-pebble-calculator">Calculate beach pebbles →</a>
            </div>
          </div>
          <p class="deco-note">For a mixed, naturally rounded look, compare <a href="/river-rock-calculator">river rock</a>. For a broader material estimate across bed shapes, use the <a href="/landscape-rock-calculator">landscape rock calculator</a>.</p>
        </section>

        <section class="deco-card" aria-labelledby="measure-heading">
          <p class="deco-eyebrow">Measure the bed</p>
          <h2 id="measure-heading">Turn surface area into an order quantity</h2>
          <ol class="deco-steps">
            <li><strong>Measure the stone footprint.</strong> Use length × width for a rectangle. Split an L-shaped border into smaller rectangles and add them. Subtract paving or other ground you will leave uncovered; a shrub canopy alone does not remove the ground beneath it.</li>
            <li><strong>Choose the installed depth.</strong> A 2–3 inch layer is a common starting range for inorganic mulch, but larger stones and the exact look you want may call for a different depth. Check the product's coverage guidance. For an existing bed, enter only the <em>missing</em> depth of a top-up.</li>
            <li><strong>Calculate volume, then ordering units.</strong> Square feet × inches ÷ 12 gives cubic feet; divide by 27 for cubic yards. Enter the supplier's loose weight to estimate US tons. Divide cubic feet by the bag's labeled cubic-foot volume and round up.</li>
            <li><strong>Compare the quote.</strong> Ask whether the yard sells by cubic yard, short ton, bag or pallet; check its minimum increment and delivery charge. Check your vehicle's payload before choosing pickup.</li>
          </ol>
          <p class="deco-note">At 100 sq ft and 3 in, base volume is 25 ft³ = 0.93 yd³. With a 10% allowance it becomes 27.5 ft³ = 1.02 yd³, or 55 bags at 0.5 ft³ each. At the editable 1.35 ton/yd³ example, the buffered load is about 1.38 US tons. A bag labeled 0.25 ft³ would require 110 bags for that same buffered volume.</p>
          <p>Depth guidance: <a href="https://extension.usu.edu/yardandgarden/research/water-wise-landscaping-mulch.pdf">Utah State University Extension recommends 2–3 inches for inorganic mulch</a>; <a href="https://beachpebblesdirect.com/pages/beach-pebbles-coverage-chart">Beach Pebbles Direct uses 2 inches for most of its pebble projects</a>. See the <a href="/rock-depth-guide">rock depth guide</a> for a closer look at stone size and use.</p>
        </section>

        <section class="deco-card" aria-labelledby="weight-heading">
          <p class="deco-eyebrow">Understand the estimate</p>
          <h2 id="weight-heading">Why a weight preset is only a starting point</h2>
          <p>The same 0.93 cubic yard fills a 100 sq ft bed at 3 inches no matter which stone is selected. The tonnage changes with the product's loose bulk weight. The calculator starts at 1.30 US tons per cubic yard for mixed decorative rock, 1.35 for marble chips (2,700 lb) and 0.75 for lava rock (1,500 lb), all editable. <a href="https://sunshinecoastmaterials.com/materials/decorative-stone/">Sunshine Coast Materials gives a 1.30–1.45 tons-per-yard range for its decorative stone</a>. <a href="https://cumminlandscapesupply.com/marblechips-gravel">Cummin Landscape Supply lists about 2,700 lb per cubic yard for its marble chips</a>. Lava rock is lighter and varies too: <a href="https://www.landscapecentre.com/products/bulk-materials/lava-rock">Landscape Centre lists 1,250 lb per yard</a>, while <a href="https://www.kentuckylawncare.com/product/lava-rock-bulk-landscape-material/">Kentucky Lawn Care lists 1,500 lb</a>. Replace each preset with the loose weight for the product on your quote.</p>
          <p>Bag volume is equally product-specific. <a href="https://www.homedepot.com/p/100583677">Vigoro marble chips are labeled 0.5 ft³ and 50 lb</a>; a <a href="https://www.lowes.com/pd/Rain-Forest-20-lb-Gray-Mexican-Beach-Pebbles/1000491537">Rain Forest beach pebble bag is labeled 0.25 ft³ and 20 lb</a>. Those labels describe different products. If a package only gives square-foot coverage at a stated depth, use that exact product coverage to check the quantity before purchase.</p>
        </section>

        <section class="deco-card" aria-labelledby="install-heading">
          <p class="deco-eyebrow">Plan the finished bed</p>
          <h2 id="install-heading">Where the stone goes matters as much as how much you buy</h2>
          <div class="deco-practice-grid">
            <div><h3>Keep it contained</h3><p>Use a defined edge where rock meets lawn, paving or loose soil. Place and level the material in sections so the finished layer matches the depth you entered, rather than piling all material near the delivery point.</p></div>
            <div><h3>Give plants room</h3><p>Keep the rock off stems and trunks. Rock can heat a planted bed in full sun, and a stone layer does not add organic matter. <a href="https://extension.colostate.edu/resource/mulching/">Colorado State University Extension discusses site-dependent rock mulch effects</a>; <a href="https://extension.usu.edu/forestry/trees-cities-towns/tree-care/mulching-tree-health">Utah State recommends organic mulch around trees</a>.</p></div>
            <div><h3>Expect maintenance</h3><p>Rock reduces some light at the soil surface but cannot guarantee a weed-free bed. Remove fallen leaves and soil that collect in gaps, especially along edges. <a href="https://ipm.ucanr.edu/pdf/pestnotes/pnweedmanagement.pdf">UC IPM notes that weeds can exploit fabric gaps</a>. See <a href="/how-to-stop-weeds-in-landscape-rock">weed control for rock beds</a>.</p></div>
          </div>
          <p class="deco-note">Building a path or vehicle surface? Decorative top stone is only one layer. Use the <a href="/driveway-rock-calculator">driveway calculator</a> for a load-bearing project. For the complete bed sequence, see <a href="/how-to-install-landscape-rock">how to install landscape rock</a>.</p>
        </section>

        <section class="deco-card" aria-labelledby="specific-heading">
          <h2 id="specific-heading">Continue with the material-specific guide</h2>
          <nav class="deco-links" aria-label="Related decorative stone calculators">
            <a href="/marble-chips-calculator">Marble chip coverage and care</a>
            <a href="/marble-chips-bag-calculator">Marble chip bags</a>
            <a href="/lava-rock-calculator">Lava rock quantities</a>
            <a href="/lava-rock-coverage-calculator">Lava rock coverage</a>
            <a href="/beach-pebble-calculator">Beach pebble sizes and quantities</a>
            <a href="/rock-vs-mulch-calculator">Rock versus mulch</a>
          </nav>
        </section>

        <section class="deco-card" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Decorative rock questions</h2>
          <div class="deco-faq">
            {faqItems.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
          </div>
        </section>
      </div>
    </article>
    <TopicClusterNav currentPage="/decorative-rock-calculator" />
  </main>
  <Footer />
</BaseLayout>

<style>
  .deco-guide { padding:var(--space-10) 0; background:var(--bg-body); }
  .deco-card { background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); padding:var(--space-8); margin-bottom:var(--space-6); color:var(--text-secondary); line-height:1.7; }
  .deco-card h2 { color:var(--text-primary); font-size:var(--text-2xl); line-height:1.2; margin:0 0 var(--space-4); }
  .deco-card h3 { color:var(--text-primary); font-size:var(--text-lg); line-height:1.3; margin:0 0 var(--space-2); }
  .deco-card p { margin:0 0 var(--space-4); }
  .deco-card p:last-child { margin-bottom:0; }
  .deco-card a { color:var(--accent-gold); text-underline-offset:3px; }
  .deco-eyebrow { color:var(--accent-gold); font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; margin:0 0 var(--space-2) !important; }
  .deco-choice-grid,.deco-practice-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-4); margin:var(--space-5) 0; }
  .deco-choice-grid > div,.deco-practice-grid > div { padding:var(--space-5); background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-md); }
  .deco-choice-grid p,.deco-practice-grid p { font-size:.9rem; }
  .deco-note { border-left:3px solid var(--accent-gold); background:var(--bg-surface); padding:var(--space-4); border-radius:0 var(--radius-md) var(--radius-md) 0; }
  .deco-steps { padding-left:1.4rem; }
  .deco-steps li { margin-bottom:var(--space-4); padding-left:.25rem; }
  .deco-steps strong { color:var(--text-primary); }
  .deco-links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-3); }
  .deco-links a { display:block; background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:var(--radius-md); padding:var(--space-3) var(--space-4); }
  .deco-faq details { border-top:1px solid var(--border-subtle); padding:var(--space-3) 0; }
  .deco-faq summary { color:var(--text-primary); font-weight:650; cursor:pointer; }
  .deco-faq p { margin:var(--space-3) 0 0; }
  @media(max-width:850px) { .deco-choice-grid,.deco-practice-grid { grid-template-columns:1fr; } }
  @media(max-width:600px) { .deco-card { padding:var(--space-5); } .deco-links { grid-template-columns:1fr; } }
</style>
