<GuideLayout
  title="Gravel Sizes & #57 Stone Sieve Guide"
  metaDescription="Distinguish nominal stone sizes, ASTM D448 / AASHTO M43 sieve designations (#1, #4, #57, #67, #78, #8, #89), fines, and local trade names before ordering."
  canonicalPath="/gravel-sizes"
  guideTitle="Gravel Sizes & Gradation: Read the Product Spec"
  guideSubtitle="Distinguish nominal stone sizes, ASTM D448 sieve designations (#57, #67, #8), fines, and regional names before choosing a material quantity tool."
  standardBadge="ASTM D448 / AASHTO M43 gradation context"
