---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import BagCalculator from '../components/calculators/BagCalculator.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Quantity & Conversion', url: '/rock-coverage-calculator-yard' },
  { name: 'Rock Bag Calculator', url: '/rock-bag-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Bagged Landscape Rock' },
  { label: 'Count From', value: 'Labeled Cubic Feet (0.25, 0.4, 0.5, 1.0 ft³)' },
  { label: 'Compare', value: 'Pallet Splits, Vehicle Trips & Bulk Quotes' }
];

const quickStats = [
  { value: '54', label: 'Half-cubic-foot bags per yd³', desc: '27 cu ft ÷ 0.5 cu ft; an exact volume conversion' },
  { value: '2 sq ft', label: 'Coverage per 0.5 cu ft bag', desc: 'At a 3-inch finished depth before allowance' },
  { value: '40 × 50 lb', label: 'Bags per short ton (2,000 lb)', desc: 'Weight only; verify cubic-foot yield per product' }
];

const faqItems = [
  {
    q: 'How many 0.5 cubic foot bags of rock do I need for 100 square feet?',
    a: 'At a 3-inch finished depth, 100 square feet takes 25 cubic feet of rock. Divide by the bag’s 0.5-cubic-foot label to get 50 whole bags before any extra allowance (55 bags with 10% extra).'
  },
  {
    q: 'How many 50 lb bags of rock make one ton?',
    a: 'Forty 50 lb bags weigh one short ton (2,000 lb). That weight count does not automatically tell you ground coverage—porous lava rock holds more volume per 50 lb than dense granite or creek pebble. Always size your project using printed cubic feet.'
  },
  {
    q: 'Is there a bag count where bulk rock is always cheaper?',
    a: 'No fixed bag number fits every yard. Enter your local retail price per bag and your supplier’s delivered bulk quote (including minimum order and unloading fees) into the comparison fields above to find the exact break-even cost for your location.'
  },
  {
    q: 'How many rock bags can I safely carry in my vehicle?',
    a: 'Multiply bag count by labeled bag weight, then enter your vehicle’s doorjamb tire-and-loading payload capacity minus passengers and cargo in the calculator above to get maximum safe bags per trip.'
  }
];
---

<BaseLayout
  title="Rock Bag Calculator: Bag Count, Pallet Split & Weight Guide"
  description="Count whole bags of landscape rock from area, depth, and labeled bag cubic feet. Check pallet splits, safe vehicle payload trips, and bag-vs-bulk retail price break-even."
  canonicalPath="/rock-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Rock Bag Calculator",
      "url": "https://rockcoveragecalculator.com/rock-bag-calculator",
      "description": "Calculates whole rock bags from area, depth, and labeled bag volume, with pallet count, vehicle payload trip estimator, and local bulk cost comparison.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "about": { "@type": "Thing", "name": "Retail Rock Bags" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Rock Bag Calculator"
      highlightWord="Calculator"
      badge="Bagged Rock, Weight Guide & Bulk Comparison"
      subtitle="A 100-square-foot bed at 3 inches takes 25 cubic feet (50 half-cubic-foot bags). Calculate whole bags, split full pallets, check safe vehicle trips by payload weight, and compare local bag vs. bulk prices."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <BagCalculator />

    <!-- Technical Guide on Bag Calculations -->
    <article class="content-guide-section">
      <div class="container">
        <section class="content-card" id="bag-math">
          <h2>How to turn a rock layer into a bag count</h2>
          <p>First find the cubic feet needed to fill the space, then divide by the <strong>cubic feet per bag</strong> printed on the product packaging and round up to whole bags.</p>
          <div class="formula-box">
            <code>Installed cu ft = area (sq ft) &times; depth (in) &divide; 12</code><br />
            <code>Planned cu ft = installed cu ft &times; (1 + extra % &divide; 100)</code><br />
            <code>Whole bags = round up (planned cu ft &divide; labeled cu ft per bag)</code>
          </div>
          <p>For a 10 &times; 10 ft bed at 3 inches (<strong>25 cu ft</strong>, ~0.93 yd&sup3;), a half-cubic-foot bag covers 2 sq ft—requiring 50 half-cubic-foot bags, 100 quarter-cubic-foot bags, or 25 one-cubic-foot bags.</p>
          <figure class="bag-figure">
            <svg viewBox="0 0 720 225" role="img" aria-labelledby="bag-figure-title bag-figure-desc" xmlns="http://www.w3.org/2000/svg">
              <title id="bag-figure-title">One volume, three bag sizes</title>
              <desc id="bag-figure-desc">A 100-square-foot area at 3 inches deep needs 25 cubic feet: 100 bags of 0.25 cu ft, 50 bags of 0.5 cu ft, or 25 bags of 1 cu ft.</desc>
              <rect x="2" y="2" width="716" height="221" rx="16" fill="#111c27" stroke="#42566b" />
              <text x="360" y="37" text-anchor="middle" fill="#f8fafc" font-size="21" font-weight="700">100 sq ft &times; 3 in &divide; 12 = 25 cu ft</text>
              <path d="M360 51v24M118 75h484" fill="none" stroke="#eab95c" stroke-width="2" />
              <path d="M118 75v15M360 75v15M602 75v15" fill="none" stroke="#eab95c" stroke-width="2" />
              <rect x="24" y="96" width="188" height="99" rx="12" fill="#24384a" />
              <rect x="266" y="96" width="188" height="99" rx="12" fill="#24384a" />
              <rect x="508" y="96" width="188" height="99" rx="12" fill="#24384a" />
              <text x="118" y="132" text-anchor="middle" fill="#f8fafc" font-size="17">0.25 cu ft/bag</text>
              <text x="360" y="132" text-anchor="middle" fill="#f8fafc" font-size="17">0.5 cu ft/bag</text>
              <text x="602" y="132" text-anchor="middle" fill="#f8fafc" font-size="17">1 cu ft/bag</text>
              <text x="118" y="174" text-anchor="middle" fill="#eab95c" font-size="30" font-weight="700">100 bags</text>
              <text x="360" y="174" text-anchor="middle" fill="#eab95c" font-size="30" font-weight="700">50 bags</text>
              <text x="602" y="174" text-anchor="middle" fill="#eab95c" font-size="30" font-weight="700">25 bags</text>
            </svg>
            <figcaption>Equal installed volume, different package counts. Check the cubic-foot volume printed on the product you plan to buy.</figcaption>
          </figure>
        </section>

        <section class="content-card" id="bag-weights-guide">
          <h2>Retail bag weight, volume &amp; pallet reference guide</h2>
          <p>Pounds measure carrying strain; cubic feet measure square-foot coverage. Even identically sized 0.5-cu-ft bags vary in weight by mineral density (porosity vs. dense natural stone):</p>
          <div class="table-wrapper">
            <table class="guide-table">
              <caption>Typical retail rock bag sizes and per-yard equivalents (verify store labels before ordering)</caption>
              <thead>
                <tr>
                  <th scope="col">Product Style</th>
                  <th scope="col">Typical Labeled Volume</th>
                  <th scope="col">Typical Label Weight</th>
                  <th scope="col">Bags per Cubic Yard</th>
                  <th scope="col">Coverage per Bag (@ 2")</th>
                </tr>
              </thead>
              <tbody>
                <tr><th scope="row">Pea gravel / river rock / marble chips</th><td>0.50 cu ft</td><td>~48–50 lb</td><td>54 bags</td><td>3.0 sq ft</td></tr>
                <tr><th scope="row">All-purpose gravel / clean crushed stone</th><td>0.50 cu ft</td><td>~50 lb</td><td>54 bags</td><td>3.0 sq ft</td></tr>
                <tr><th scope="row">Crushed brick / porous scoria lava rock</th><td>0.50 cu ft</td><td>~24–30 lb</td><td>54 bags</td><td>3.0 sq ft</td></tr>
                <tr><th scope="row">Oversized decorative cobble / river pebble</th><td>0.40 cu ft</td><td>~40 lb</td><td>68 bags</td><td>2.4 sq ft</td></tr>
                <tr><th scope="row">Large multi-purpose utility gravel bag</th><td>1.00 cu ft</td><td>~95–100 lb</td><td>27 bags</td><td>6.0 sq ft</td></tr>
              </tbody>
            </table>
          </div>
          <p><strong>Why weight-only labels mislead:</strong> Forty 50 lb bags equal one short ton (2,000 lb), yet 50 lb of scoria lava fills nearly twice the bed space of 50 lb of marble or granite chips (<a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> explains how loose unit weight differs across mineral types).</p>
        </section>

        <section class="content-card" id="bag-order">
          <h2>Turn the count into a workable pickup or delivery plan</h2>
          <ol class="bag-checklist">
            <li><strong>Check pallet quantities:</strong> Most pallets hold 42 to 63 bags (~2,000–3,000 lb). Confirm whether your store splits pallets or sells partial loads.</li>
            <li><strong>Protect your vehicle suspension:</strong> Add up passengers, hitch hardware, and toolboxes before comparing packaged rock weight against the vehicle doorjamb sticker (<a href="https://www.nhtsa.gov/vehicle-safety/tires" target="_blank" rel="noopener noreferrer">NHTSA loading and tire limits</a>). A half-ton pickup badge does not guarantee a 1,000+ lb cargo rating.</li>
            <li><strong>Use material-specific bag calculators:</strong> Switch directly to the <a href="/gravel-bag-calculator">gravel bag calculator</a>, <a href="/crushed-stone-bag-calculator">crushed stone bag calculator</a>, <a href="/river-rock-bag-calculator">river rock bag calculator</a>, <a href="/pea-gravel-bag-calculator">pea gravel bag calculator</a>, <a href="/marble-chips-bag-calculator">marble chips bag calculator</a>, or <a href="/lava-rock-bag-calculator">lava rock bag calculator</a>, or compare delivery economics in our <a href="/bulk-vs-bagged-rock">bulk versus bagged rock guide</a>.</li>
          </ol>
        </section>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Bagged Rock</h2>
          <div class="faq-accordion">
            {faqItems.map((item, index) => (
              <details class="faq-detail" open={index === 0}>
                <summary class="faq-summary">
                  <span>{item.q}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="faq-answer"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </article>

    <TopicClusterNav />
  </main>

  <Footer />
</BaseLayout>

<style>
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .content-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: var(--space-8); margin-bottom: var(--space-8); line-height: 1.7; color: var(--text-secondary); }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .content-card h3 { font-size: var(--text-xl); color: var(--text-primary); margin: var(--space-6) 0 var(--space-3) 0; }
  .formula-box { background: var(--bg-surface); border-left: 3px solid var(--accent-gold); padding: var(--space-4); border-radius: 0 var(--radius-md) var(--radius-md) 0; margin: var(--space-4) 0; font-family: var(--font-mono); color: var(--accent-gold); font-size: var(--text-sm); }
  .bag-figure { margin: var(--space-6) 0; overflow-x: auto; }
  .bag-figure svg { display: block; width: 100%; min-width: 580px; height: auto; border-radius: var(--radius-md); }
  .bag-figure figcaption { color: var(--text-muted); font-size: var(--text-xs); margin-top: var(--space-2); }
  .bag-checklist { padding-left: 1.4rem; }
  .bag-checklist li { margin-bottom: var(--space-3); }
  .content-card a { color: var(--accent-gold); text-decoration: underline; text-underline-offset: 3px; }
  .table-wrapper { overflow-x: auto; margin: var(--space-6) 0; }
  .guide-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); text-align: left; }
  .guide-table caption { text-align: left; font-size: var(--text-xs); color: var(--text-muted); margin-bottom: var(--space-2); }
  .guide-table th, .guide-table td { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border-subtle); }
  .guide-table th { background: var(--bg-surface); color: var(--text-primary); font-weight: 700; }
  .guide-table tr:hover td { background: rgba(212, 168, 83, 0.04); }
  .faq-detail { border-bottom: 1px solid var(--border-subtle); padding: var(--space-4) 0; }
  .faq-summary { display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-weight: 600; color: var(--text-primary); font-size: var(--text-base); list-style: none; }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary svg { transition: transform var(--transition-fast); }
  .faq-detail[open] .faq-summary svg { transform: rotate(180deg); }
  .faq-answer { padding-top: var(--space-3); color: var(--text-muted); font-size: var(--text-sm); line-height: 1.6; }
</style>
