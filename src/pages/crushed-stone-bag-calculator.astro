---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crushed Stone Calculator', url: '/crushed-stone-calculator' },
  { name: 'Crushed Stone Bag Calculator', url: '/crushed-stone-bag-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Bagged Crushed Stone' },
  { label: 'Standard Sieve', value: 'ASTM D448 #57 (1/2" to 1")' },
  { label: 'Bag Volume', value: '0.5 Cubic Feet per Bag' },
  { label: 'Bag Weight', value: '50 to 52 lbs per Bag' }
];

const quickStats = [
  { value: '54 Bags', label: 'Per Cubic Yard', desc: 'Exact bag multiplier based on 27 cubic feet per yard' },
  { value: '2.0 sq ft', label: 'Yield at 3"', desc: 'Ground coverage per 0.5 cu ft bag at standard 3-inch depth' },
  { value: '20 Bags', label: 'Tipping Point', desc: 'Threshold where bulk quarry delivery becomes cheaper than retail bags' }
];

const faqItems = [
  {
    q: 'How many bags of crushed stone do I need for a 10x10 foot area?',
    a: 'A 10x10 foot area equals 100 square feet. At a standard 3-inch depth for a stable crushed stone base, you need 25 cubic feet of stone, which equals exactly 50 bags of 0.5 cubic feet each (2,550 lbs total weight).'
  },
  {
    q: 'How many bags of crushed stone make a cubic yard?',
    a: 'There are exactly 54 bags of 0.5 cubic feet in one cubic yard (27 cubic feet / 0.5 cu ft = 54 bags). At 50 to 52 pounds per bag, one cubic yard of bagged crushed stone weighs approximately 2,750 to 2,800 pounds (1.40 tons).'
  },
  {
    q: 'How much does a 0.5 cu ft bag of #57 crushed stone cover?',
    a: 'One standard 0.5 cubic foot bag covers 3.0 square feet at 2 inches depth, 2.0 square feet at 3 inches depth, and 1.5 square feet at 4 inches depth.'
  },
  {
    q: 'How many bags of crushed stone do I need to set a 4x4 fence post?',
    a: 'A standard post hole (10 inches wide by 30 inches deep) requires approximately 1/2 to 1 full bag of crushed stone at the bottom for drainage before pouring concrete or tamping stone.'
  }
];

const upLinks = [
  { title: 'Crushed Stone Calculator (Material Parent)', slug: '/crushed-stone-calculator', badge: 'Material' },
  { title: 'Rock Bag Calculator (Unit Parent)', slug: '/rock-bag-calculator', badge: 'Unit' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Crushed Stone Tons Calculator', slug: '/crushed-stone-tons-calculator', badge: 'Tons' },
  { title: 'Crushed Stone Yardage Calculator', slug: '/crushed-stone-yardage-calculator', badge: 'Yards' },
  { title: 'Gravel Bag Calculator', slug: '/gravel-bag-calculator', badge: 'Gravel Bags' }
];

const bridgeLinks = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' }
];

const supportGuides = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="Crushed Stone Bag Calculator - 0.5 Cu Ft Sizing & Cost Analysis"
  metaDescription="Calculate exact 0.5 cu ft bags of crushed stone and #57 gravel needed for drainage, pads, and post holes. Sizing formulas, coverage yields, and bulk costs."
  canonicalPath="/crushed-stone-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Crushed Stone Bag Calculator",
      "url": "https://rockcoveragecalculator.com/crushed-stone-bag-calculator",
      "description": "Calculates 0.5 cu ft retail bags of crushed stone and #57 gravel needed based on dimensions.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Contractors, Fencing Installers, DIY Landscapers, Homeowners"
      },
      "about": {
        "@type": "Thing",
        "name": "Bagged Crushed Stone Calculation"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Crushed Stone Bag Calculator"
      highlightWord="Bags"
      badge="Retail Bag Sizing Engine"
      subtitle="Calculate exact 0.5 cu ft bags of #57 crushed limestone and granite for shed pads, post holes, and French drains."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <!-- Interactive Crushed Stone Bag Calculator Tool -->
    <section class="section">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h3>Crushed Stone Area Dimensions</h3>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="csb-length">Length (Feet)</label>
              <input type="number" id="csb-length" value="16" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="csb-width">Width (Feet)</label>
              <input type="number" id="csb-width" value="10" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="csb-depth">Depth (Inches)</label>
              <input type="number" id="csb-depth" value="3.0" min="1" max="12" step="0.5" />
            </div>
            <div class="input-field">
              <label for="csb-price">Price per Bag ($)</label>
              <input type="number" id="csb-price" value="4.85" min="1" step="0.25" />
            </div>
          </div>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h3>Required Material Totals</h3>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
              <div class="kpi-value" id="kpi-csb-bags">0</div>
              <div class="kpi-label">0.5 Cu Ft Bags Needed</div>
              <div class="kpi-subtext" id="kpi-csb-lbs">0 lbs total weight</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-csb-yards">0.00</div>
              <div class="kpi-label">Volume (Cubic Yards)</div>
              <div class="kpi-subtext" id="kpi-csb-cuft">0 cu ft</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-csb-cost">$0.00</div>
              <div class="kpi-label">Estimated Material Cost</div>
              <div class="kpi-subtext" id="kpi-csb-bulk-save">Bulk comparison</div>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide on Bagged Crushed Stone -->
    <article class="content-guide-section">
      <div class="container">

        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="Crushed Stone Bag Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">Crushed Stone Bag Reference</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Master Formula</span>
              <span class="aeo-quick-value">Bags = [Area (sq ft) × Depth (in) / 12] × 2</span>
              <p class="aeo-quick-desc">Converts cubic feet into 0.5 cu ft commercial retail bags.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Yield at 3"</span>
              <span class="aeo-quick-value">2.0 sq ft per Bag</span>
              <p class="aeo-quick-desc">Standard depth for stable equipment pads and pathway sub-bases.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Bags per Yard</span>
              <span class="aeo-quick-value">54 Bags (27 cu ft)</span>
              <p class="aeo-quick-desc">Exact cubic yard volume equivalent for standard 0.5 cu ft bags.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Bulk Tipping Point</span>
              <span class="aeo-quick-value">20 Bags ($95 to $115)</span>
              <p class="aeo-quick-desc">Threshold where bulk quarry delivery becomes more economical.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>Calculating Bags of Crushed Stone and #57 Gravel</h2>
          <p>
            Crushed stone consists of angular, fractured limestone or granite (conforming to <strong>ASTM D448 #57</strong>). Retail bags sold at big-box home improvement stores contain <strong>0.5 cubic feet</strong> and weigh between <strong>50 and 52 pounds</strong>:
          </p>

          <div class="formula-box">
            <code>Total Cubic Feet = [Length (ft) × Width (ft) × Depth (in)] / 12</code>
            <br />
            <code>Number of 0.5 cu ft Bags = Total Cubic Feet × 2</code>
          </div>

          <h3>Common Residential Uses for Bagged Crushed Stone</h3>
          <ul>
            <li><strong>Shed & AC Unit Pads:</strong> Install at 3.0 to 4.0 inches depth over compacted earth. A 0.5 cu ft bag covers 1.5 to 2.0 sq ft.</li>
            <li><strong>Fence Post Footings:</strong> Add 6 inches of crushed stone to the bottom of the hole for water drainage (1 bag per 2 holes).</li>
            <li><strong>French Drain Spot Repairs:</strong> 0.5 cu ft bags allow precise backfilling around 4-inch perforated pipes without buying an entire dump truck load.</li>
          </ul>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Bagged Crushed Stone</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </article>

    <TopicClusterNav
      currentPage="/crushed-stone-bag-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateCSB() {
      const l = parseFloat((document.getElementById('csb-length') as HTMLInputElement)?.value) || 0;
      const w = parseFloat((document.getElementById('csb-width') as HTMLInputElement)?.value) || 0;
      const d = parseFloat((document.getElementById('csb-depth') as HTMLInputElement)?.value) || 0;
      const price = parseFloat((document.getElementById('csb-price') as HTMLInputElement)?.value) || 0;

      const cuft = (l * w * (d / 12));
      const bags = Math.ceil(cuft * 2);
      const yards = cuft / 27;
      const totalWeight = bags * 51;
      const totalCost = bags * price;

      const bEl = document.getElementById('kpi-csb-bags');
      const yEl = document.getElementById('kpi-csb-yards');
      const cEl = document.getElementById('kpi-csb-cost');
      const lbsEl = document.getElementById('kpi-csb-lbs');
      const cuftEl = document.getElementById('kpi-csb-cuft');
      const saveEl = document.getElementById('kpi-csb-bulk-save');

      if (bEl) bEl.innerText = bags.toLocaleString();
      if (yEl) yEl.innerText = yards.toFixed(2);
      if (cEl) cEl.innerText = '$' + totalCost.toFixed(2);
      if (lbsEl) lbsEl.innerText = totalWeight.toLocaleString() + ' lbs (~' + (totalWeight / 2000).toFixed(2) + ' tons)';
      if (cuftEl) cuftEl.innerText = cuft.toFixed(1) + ' cu ft net volume';

      if (saveEl) {
        if (bags >= 20) {
          const bulkCost = yards * 55 + 75; // $55/yd + $75 delivery
          const savings = totalCost - bulkCost;
          if (savings > 0) {
            saveEl.innerText = 'Bulk saves approx $' + Math.round(savings) + ' vs bags';
            saveEl.style.color = 'var(--accent-gold)';
          } else {
            saveEl.innerText = 'Bags are comparable in price';
            saveEl.style.color = 'var(--text-muted)';
          }
        } else {
          saveEl.innerText = 'Bags are more economical for this size';
          saveEl.style.color = 'var(--text-muted)';
        }
      }
    }

    ['csb-length', 'csb-width', 'csb-depth', 'csb-price'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateCSB);
    });
    updateCSB();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }
  .aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--accent-gold); }
  .aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .aeo-quick-item { background: var(--bg-surface); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); margin-bottom: 2px; }
  .aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .aeo-quick-desc { font-size: 11px; color: var(--text-muted); margin: 0; line-height: 1.35; }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .faq-card { margin-top: var(--space-8); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-item h3 { font-size: var(--text-base); color: var(--text-primary); margin: 0 0 var(--space-2) 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--text-muted); margin: 0; }
</style>
