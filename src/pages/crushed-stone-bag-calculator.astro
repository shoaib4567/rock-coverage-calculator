---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Crushed Stone Bag Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Crushed Stone Calculator', url: '/crushed-stone-calculator' },
  { name: pageTitle, url: '/crushed-stone-bag-calculator' }
];
const entityTags = [
  { label: 'Measure', value: 'Area and finished layer depth' },
  { label: 'Read the bag', value: 'Cubic feet for quantity, pounds for loading' },
  { label: 'Choose', value: 'Clean drainage stone or dense paver base' }
];
const faqItems = [
  {
    q: 'How many bags cover 100 square feet at 3 inches deep?',
    a: 'The installed volume is 100 × 3 ÷ 12 = 25 cubic feet. At 0.5 cubic foot per bag, divide 25 by 0.5 to get 50 whole bags before any extra allowance. At 0.25 cubic foot per bag, the same layer needs 100 bags. Use the volume printed on the product you will buy.'
  },
  {
    q: 'How many 0.5 cubic foot bags make a cubic yard?',
    a: 'One cubic yard is 27 cubic feet. Divide 27 by 0.5 to get 54 bags by volume. That conversion does not say that every 54 bags have the same weight or gradation as a cubic yard from a quarry.'
  },
  {
    q: 'Can I use a 50 lb bag weight to calculate coverage?',
    a: 'Not reliably. Bag weight is for lifting and vehicle loading; the package volume or manufacturer coverage is the useful number for area. Stone type, particle size, fines, and moisture can change pounds per cubic foot.'
  },
  {
    q: 'Should I use bagged #57 stone or bagged paver base?',
    a: 'Check the product description and gradation. Clean, low-fines stone is used where an open drainage layer is specified. Paver base commonly includes smaller particles and fines so it can compact. A bag called “gravel” is not automatically interchangeable with either one.'
  },
  {
    q: 'When does bulk crushed stone cost less than bags?',
    a: 'There is no dependable bag-count cutoff. Multiply your whole-bag count by your local bag price, then compare it with an all-in quote for a comparable bulk stone and quantity. Include the supplier minimum, delivery, bag transport, and where you can unload.'
  }
];
const upLinks = [
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: 'Material' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'All Stone' },
  { title: 'Rock Coverage Chart', slug: '/rock-coverage-chart', badge: 'Reference' }
];
const lateralLinks = [
  { title: 'Crushed Stone Tons Calculator', slug: '/crushed-stone-tons-calculator', badge: 'Tons' },
  { title: 'Crushed Stone Yardage Calculator', slug: '/crushed-stone-yardage-calculator', badge: 'Yards' },
  { title: 'Pea Gravel Bag Calculator', slug: '/pea-gravel-bag-calculator', badge: 'Pea Gravel' }
];
const bridgeLinks = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'Gradation' },
  { title: 'Crusher Run Calculator', slug: '/crusher-run-calculator', badge: 'Dense Base' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Buying' }
];
const supportGuides = [
  { title: 'Rock Bag Weight and Price Guide', slug: '/rock-bag-weight-and-price-guide', badge: 'Loading' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'Drain Rock Calculator', slug: '/drain-rock-calculator', badge: 'Drainage' }
];
---

<BaseLayout
  title={pageTitle}
  description="Count whole bags of crushed stone from area, finished depth, and the package's cubic-foot volume. Estimate carrying weight and cost from your label and local quotes."
  canonicalPath="/crushed-stone-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/crushed-stone-bag-calculator',
      description: 'Calculates whole bags of crushed stone from finished layer volume and the volume stated on a product label.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Bag"
      badge="Plan a bagged stone purchase"
      subtitle="A 10 × 10 ft area at 3 in deep needs 25 cubic feet of stone: 50 bags labeled 0.5 cubic foot, before any extra. Enter your bag's actual volume to get a whole-bag shopping count."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      theme="civil"
    />

    <section class="answer-strip" aria-labelledby="bag-start-heading">
      <div class="container answer-grid">
        <div>
          <p class="eyebrow">Start with volume</p>
          <h2 id="bag-start-heading">The label determines the count</h2>
          <p>Measure the stone-covered area and the <strong>finished layer depth</strong>. The calculator turns that layer into cubic feet, adds only the extra you choose, then rounds up to whole bags. Copy the bag's cubic-foot volume; a weight-only label cannot tell you coverage without more information.</p>
        </div>
        <div class="formula-card">
          <span>Installed cubic feet</span>
          <strong>Area (sq ft) × depth (in) ÷ 12</strong>
          <span>Whole bags to buy</span>
          <strong>Round up [planned cubic feet ÷ labeled cu ft per bag]</strong>
        </div>
      </div>
    </section>

    <section class="bag-tool-section" id="bag-tool" aria-labelledby="bag-tool-heading">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Your shopping worksheet</p>
          <h2 id="bag-tool-heading">Count bags, then check weight and price</h2>
          <p>The half-cubic-foot value is an example. Leave optional weight and prices blank until you have a label or quote.</p>
        </div>
        <div class="calc-wrapper">
          <div class="calc-panel">
            <h3>1. Measure the layer</h3>
            <fieldset class="area-choice">
              <legend>Enter the area as</legend>
              <label><input type="radio" name="csb-area-mode" value="rectangle" checked /> Length × width</label>
              <label><input type="radio" name="csb-area-mode" value="known" /> Measured square feet</label>
            </fieldset>
            <div class="dim-grid" id="csb-rectangle-fields">
              <div class="input-field">
                <label for="csb-length">Length (ft)</label>
                <input type="number" id="csb-length" value="10" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="csb-width">Average width (ft)</label>
                <input type="number" id="csb-width" value="10" min="0.01" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="dim-grid" id="csb-known-fields" hidden>
              <div class="input-field">
                <label for="csb-area">Measured area (sq ft)</label>
                <input type="number" id="csb-area" value="100" min="0.01" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="dim-grid">
              <div class="input-field">
                <label for="csb-depth">Finished layer depth (in)</label>
                <input type="number" id="csb-depth" value="3" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="csb-extra">Extra to order (%)</label>
                <input type="number" id="csb-extra" value="0" min="0" step="any" inputmode="decimal" />
              </div>
            </div>
            <p class="field-note">Use 0% if the measured depth and supplier guidance already cover uneven ground or base compaction. Extra is an ordering choice, not a universal factor.</p>

            <h3>2. Read your bag and quote</h3>
            <div class="dim-grid">
              <div class="input-field">
                <label for="csb-bag-volume">Volume per bag (cu ft)</label>
                <input type="number" id="csb-bag-volume" value="0.5" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="csb-bag-weight">Weight per bag (lb, optional)</label>
                <input type="number" id="csb-bag-weight" placeholder="From the label" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="csb-price">Price per bag ($, optional)</label>
                <input type="number" id="csb-price" placeholder="Store price" min="0" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="csb-bulk-quote">Comparable bulk quote ($, optional)</label>
                <input type="number" id="csb-bulk-quote" placeholder="All-in for this job" min="0" step="any" inputmode="decimal" />
              </div>
            </div>
            <p class="field-note">A bulk quote should include the supplier's minimum and delivery for the same stone and at least the planned volume. The cost comparison excludes tax and your own transport.</p>
            <p class="input-error" id="csb-error" role="alert" hidden></p>
          </div>

          <div class="calc-results-panel" aria-live="polite" aria-atomic="true">
            <h3>Your bag list</h3>
            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <div class="kpi-value" id="csb-bags">50</div>
                <div class="kpi-label">Whole bags to buy</div>
                <div class="kpi-subtext" id="csb-purchased">25 cu ft in purchased bags</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="csb-yards">0.93</div>
                <div class="kpi-label">Planned cubic yards</div>
                <div class="kpi-subtext" id="csb-plan-cuft">25 cu ft with 0% extra</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="csb-weight">—</div>
                <div class="kpi-label">Bags to carry</div>
                <div class="kpi-subtext">Enter the labeled bag weight</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="csb-cost">—</div>
                <div class="kpi-label">Bag material cost</div>
                <div class="kpi-subtext">Enter your store price</div>
              </div>
            </div>
            <div class="math-breakdown">
              <strong>How this count was built</strong>
              <p id="csb-volume-line">100 sq ft × 3 in ÷ 12 = 25 cu ft installed.</p>
              <p id="csb-bag-line">25 cu ft ÷ 0.5 cu ft per bag = 50; buy 50 whole bags.</p>
              <p id="csb-coverage-line">One bag covers 2 sq ft at this depth, by volume.</p>
            </div>
            <div class="quote-result">
              <strong>Bag versus bulk quote</strong>
              <p id="csb-compare">Enter a bag price and an all-in bulk quote to compare local material costs.</p>
            </div>
            <p class="result-note">If you collect bags yourself, check the occupants-and-cargo limit on the vehicle's doorjamb label. This estimate does not set a safe vehicle load.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="bag-guide">
      <div class="container">
        <nav class="guide-jumps" aria-label="On this page">
          <strong>Buying guide</strong>
          <a href="#bag-size">Bag size</a>
          <a href="#bag-grade">Stone type</a>
          <a href="#bag-purchase">Purchase checks</a>
          <a href="#bag-faq">Questions</a>
        </nav>

        <section class="guide-panel size-panel" id="bag-size">
          <div>
            <p class="eyebrow">A volume label is the key</p>
            <h2>One package size changes the whole order</h2>
            <p>A bag marked 0.5 cu ft covers 2 sq ft at a 3-inch finished depth. A bag marked 0.25 cu ft covers only 1 sq ft at the same depth. Retail listings include both <a href="https://www.homedepot.com/p/202636296" target="_blank" rel="noopener noreferrer">half-cubic-foot crushed bluestone</a> and <a href="https://www.lowes.com/pd/Yard-Elements-0-25-cu-ft-20-lb-Gold-Crushed-Stone-Less-than-0-5-in-Rock-Size/5015583527" target="_blank" rel="noopener noreferrer">quarter-cubic-foot crushed stone</a>; verify the product label before making the trip.</p>
            <p>The pounds printed on the bag answer a different question: how much must be carried. If the store lists only pounds, look for a package volume or manufacturer coverage figure before using a bag count. <a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> describes how aggregate bulk density is tested, but it does not assign every bag one pounds-to-volume conversion.</p>
          </div>
          <figure>
            <span class="mobile-figure-hint">Swipe the diagram to compare bag sizes.</span>
            <img src="/crushed-stone-bag-count-guide.svg" width="960" height="510" loading="lazy" alt="A 10 by 10 foot stone layer at 3 inches requires 25 cubic feet: 50 bags when each holds 0.5 cubic foot, or 100 bags when each holds 0.25 cubic foot." />
            <figcaption>The same measured layer needs twice as many bags when the package volume is halved.</figcaption>
          </figure>
        </section>

        <section class="guide-panel" id="bag-grade">
          <p class="eyebrow">Match the stone to the job</p>
          <h2>“Crushed stone” on a shelf is not one grade</h2>
          <div class="choice-grid">
            <div>
              <h3>Open drainage layer</h3>
              <p>Look for clean, low-fines stone in the specified size range. <a href="/57-stone-size-guide">#57</a> is a gradation designation, not a promise that every bag has been washed or fits your drain design. Confirm the label and the required outlet and separator for the project.</p>
            </div>
            <div>
              <h3>Compacted base</h3>
              <p>A <a href="/crusher-run-calculator">crusher run or paver-base blend</a> contains a range of particles, often with fines, to make a denser base. It is a different material from clean drain rock. Ask for the project depth and compaction specification instead of treating the calculator's depth as installation advice.</p>
            </div>
          </div>
          <p class="small-note">For larger work, the <a href="/crushed-stone-calculator">crushed stone calculator</a> estimates yards and tons with an editable supplier density. This bag tool counts package volume; it does not infer a bulk tonnage from bag weight.</p>
        </section>

        <section class="guide-panel" id="bag-purchase">
          <p class="eyebrow">Before leaving the store</p>
          <h2>Make the count usable on site</h2>
          <ol class="purchase-steps">
            <li><strong>Measure only the area receiving stone.</strong> Split an irregular pad or path into rectangles and add their square feet. Measure the intended finished depth, including low spots you will fill.</li>
            <li><strong>Confirm bagged volume and gradation.</strong> Keep the same product across the order; a similar color or a “gravel” label may hide a different mix of sizes and fines.</li>
            <li><strong>Choose extra deliberately.</strong> Enter an allowance for known unevenness or handling loss. If your project specification already gives a loose-to-finished factor, avoid adding it again.</li>
            <li><strong>Compare complete local quotes.</strong> Small repairs may be easier to carry in bags; larger quantities may favor bulk. Compare the whole-bag bill with a delivered quote for a comparable product, including the supplier's minimum and drop location. See the <a href="/bulk-vs-bagged-rock">bulk versus bagged guide</a>.</li>
          </ol>
          <p>For a pickup trip, multiply whole bags by their <em>labeled</em> weight and account for passengers and other cargo. <a href="https://www.nhtsa.gov/vehicle-safety/tires" target="_blank" rel="noopener noreferrer">NHTSA explains the vehicle tire and loading label</a>. A number of bags is not a safe load limit.</p>
        </section>

        <section class="guide-panel" id="bag-faq">
          <h2>Crushed stone bag questions</h2>
          <div class="faq-list">
            {faqItems.map(item => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/crushed-stone-bag-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>
  <Footer />

  <script>
    function initCrushedStoneBagCalculator() {
      const input = (id: string) => document.getElementById(id) as HTMLInputElement;
      const output = (id: string, value: string) => {
        const element = document.getElementById(id);
        if (element) element.textContent = value;
      };
      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
      const number = (value: number, digits = 2) => new Intl.NumberFormat('en-US', { maximumFractionDigits: digits }).format(value);
      const required = (element: HTMLInputElement, positive: boolean) => {
        const value = Number(element.value);
        const valid = element.value.trim() !== '' && element.validity.valid && Number.isFinite(value) && (positive ? value > 0 : value >= 0);
        element.setAttribute('aria-invalid', String(!valid));
        return valid ? value : NaN;
      };
      const optional = (element: HTMLInputElement, positive: boolean) => {
        if (element.value.trim() === '') {
          element.setAttribute('aria-invalid', 'false');
          return null;
        }
        const value = Number(element.value);
        const valid = element.validity.valid && Number.isFinite(value) && (positive ? value > 0 : value >= 0);
        element.setAttribute('aria-invalid', String(!valid));
        return valid ? value : NaN;
      };
      const error = document.getElementById('csb-error') as HTMLElement;

      function calculate() {
        const known = (document.querySelector('input[name="csb-area-mode"]:checked') as HTMLInputElement)?.value === 'known';
        const rectangle = document.getElementById('csb-rectangle-fields') as HTMLElement;
        const knownFields = document.getElementById('csb-known-fields') as HTMLElement;
        rectangle.hidden = known;
        knownFields.hidden = !known;

        const length = known ? NaN : required(input('csb-length'), true);
        const width = known ? NaN : required(input('csb-width'), true);
        const measured = known ? required(input('csb-area'), true) : NaN;
        [known ? input('csb-length') : input('csb-area'), input('csb-width')].forEach(element => {
          if (element && (known || element.id === 'csb-area')) element.setAttribute('aria-invalid', 'false');
        });
        const area = known ? measured : length * width;
        const depth = required(input('csb-depth'), true);
        const extra = required(input('csb-extra'), false);
        const bagVolume = required(input('csb-bag-volume'), true);
        const bagWeight = optional(input('csb-bag-weight'), true);
        const bagPrice = optional(input('csb-price'), false);
        const bulkQuote = optional(input('csb-bulk-quote'), false);
        const coreValid = Number.isFinite(area) && area > 0 && Number.isFinite(depth) && Number.isFinite(extra) && Number.isFinite(bagVolume);
        const messages: string[] = [];
        if (!coreValid) messages.push('Enter a positive area, depth, and bag volume; extra can be zero.');
        if (Number.isNaN(bagWeight)) messages.push('Bag weight must be greater than zero, or left blank.');
        if (Number.isNaN(bagPrice)) messages.push('Bag price must be zero or more, or left blank.');
        if (Number.isNaN(bulkQuote)) messages.push('Bulk quote must be zero or more, or left blank.');
        error.hidden = messages.length === 0;
        error.textContent = messages.join(' ');

        if (!coreValid) {
          ['csb-bags', 'csb-purchased', 'csb-yards', 'csb-plan-cuft', 'csb-weight', 'csb-cost', 'csb-volume-line', 'csb-bag-line', 'csb-coverage-line'].forEach(id => output(id, '—'));
          output('csb-compare', 'Correct the measurements and bag volume to compare costs.');
          return;
        }

        const installed = area * depth / 12;
        const planned = installed * (1 + extra / 100);
        // Ignore sub-nanobag floating-point noise at exact whole-bag boundaries.
        const bags = Math.max(1, Math.ceil(planned / bagVolume - 1e-9));
        if (!Number.isSafeInteger(bags)) {
          error.hidden = false;
          error.textContent = 'The entered quantity is too large to calculate a reliable bag count.';
          ['csb-bags', 'csb-purchased', 'csb-yards', 'csb-plan-cuft', 'csb-weight', 'csb-cost', 'csb-volume-line', 'csb-bag-line', 'csb-coverage-line'].forEach(id => output(id, '—'));
          output('csb-compare', 'Reduce the project size to compare costs.');
          return;
        }
        output('csb-bags', number(bags, 0));
        output('csb-purchased', number(bags * bagVolume) + ' cu ft in purchased bags');
        output('csb-yards', number(planned / 27));
        output('csb-plan-cuft', number(planned) + ' cu ft with ' + number(extra) + '% extra');
        output('csb-weight', bagWeight === null || Number.isNaN(bagWeight) ? '—' : number(bags * bagWeight, 0) + ' lb');
        output('csb-cost', bagPrice === null || Number.isNaN(bagPrice) ? '—' : money.format(bags * bagPrice));
        output('csb-volume-line', number(area) + ' sq ft × ' + number(depth) + ' in ÷ 12 = ' + number(installed) + ' cu ft installed; ' + number(planned) + ' cu ft planned.');
        output('csb-bag-line', number(planned) + ' cu ft ÷ ' + number(bagVolume) + ' cu ft per bag = ' + number(planned / bagVolume) + '; round up to ' + number(bags, 0) + ' bags.');
        output('csb-coverage-line', 'One bag covers ' + number(bagVolume * 12 / depth) + ' sq ft at ' + number(depth) + ' in, by volume.');

        if (bagPrice === null || bulkQuote === null || Number.isNaN(bagPrice) || Number.isNaN(bulkQuote)) {
          output('csb-compare', 'Enter a valid bag price and an all-in bulk quote to compare local material costs.');
        } else {
          const bagCost = bags * bagPrice;
          const difference = Math.abs(bagCost - bulkQuote);
          const verdict = difference < 0.005 ? 'The entered costs are equal.' : bagCost < bulkQuote ? 'Bags cost ' + money.format(difference) + ' less.' : 'The bulk quote costs ' + money.format(difference) + ' less.';
          output('csb-compare', number(bags, 0) + ' bags: ' + money.format(bagCost) + '. Bulk quote: ' + money.format(bulkQuote) + '. ' + verdict + ' Check that the stone, quantity, and delivery terms match.');
        }
      }

      document.querySelectorAll('input[name="csb-area-mode"], #bag-tool input[type="number"]').forEach(element => {
        element.addEventListener('input', calculate);
        element.addEventListener('change', calculate);
      });
      calculate();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCrushedStoneBagCalculator);
    else initCrushedStoneBagCalculator();
  </script>
</BaseLayout>

<style>
  .answer-strip { padding: var(--space-8) 0; background: var(--bg-body); }
  .answer-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-6); align-items: center; }
  .answer-grid h2, .section-heading h2, .guide-panel h2 { color: var(--text-primary); font-size: var(--text-2xl); margin: 0 0 var(--space-3); }
  .answer-grid p, .section-heading p, .guide-panel p { color: var(--text-secondary); line-height: 1.7; }
  .eyebrow { color: var(--accent-gold) !important; font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 var(--space-2); }
  .formula-card { display: grid; gap: var(--space-2); padding: var(--space-5); border: 1px solid var(--border-subtle); border-left: 3px solid var(--accent-gold); border-radius: var(--radius-lg); background: var(--bg-card); }
  .formula-card span { color: var(--text-muted); font-size: var(--text-xs); text-transform: uppercase; font-weight: 700; }
  .formula-card strong { color: var(--text-primary); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .bag-tool-section { padding: var(--space-8) 0 var(--space-12); }
  .section-heading { max-width: 760px; margin-bottom: var(--space-6); }
  .section-heading p:last-child { margin: 0; }
  .calc-panel h3, .calc-results-panel h3 { color: var(--text-primary); font-size: var(--text-lg); margin: 0 0 var(--space-4); }
  .calc-panel h3:not(:first-child) { margin-top: var(--space-7); }
  .area-choice { display: flex; flex-wrap: wrap; gap: var(--space-3); border: 0; padding: 0; margin: 0 0 var(--space-4); }
  .area-choice legend { color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2); }
  .area-choice label { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--text-primary); font-size: var(--text-sm); cursor: pointer; }
  .area-choice input { accent-color: var(--accent-gold); }
  [hidden] { display: none !important; }
