---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Pea Gravel Bag Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pea Gravel Calculator', url: '/pea-gravel-calculator' },
  { name: pageTitle, url: '/pea-gravel-bag-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Bagged pea gravel' },
  { label: 'Order unit', value: 'Bag volume printed on the label' },
  { label: 'Default bag', value: '0.5 cubic foot' }
];

const quickStats = [
  { value: '3 sq ft', label: 'One 0.5 ft³ bag', desc: 'Coverage at a level 2-inch depth, before extra' },
  { value: '54 bags', label: 'One cubic yard', desc: 'Volume equivalent for 0.5 ft³ bags' },
  { value: '53 bags', label: '12 × 12 ft example', desc: 'At 2 inches with a chosen 10% extra allowance' }
];

const faqItems = [
  {
    q: 'How many half-cubic-foot bags cover 100 square feet?',
    a: 'At 2 inches deep, 100 square feet needs 16.67 cubic feet, so round 33.33 up to 34 bags labeled 0.5 cubic foot. With a 10% extra allowance, multiply the volume before rounding: 16.67 × 1.10 ÷ 0.5 = 36.67, or 37 bags. At 3 inches with no extra, it takes 50 bags.'
  },
  {
    q: 'How many 0.5 cubic foot bags make one cubic yard?',
    a: 'Exactly 54 by volume: 1 cubic yard is 27 cubic feet, and 27 ÷ 0.5 = 54. This is a volume conversion, before any extra allowance or rounding for a particular project.'
  },
  {
    q: 'Can I treat every 50-pound bag as half a cubic foot?',
    a: 'No. Use the volume stated on the bag to calculate coverage. A 50-pound bag may yield a different volume depending on its product and aggregate; for example, Sakrete lists approximately 0.6 cubic foot for its 50-pound pea gravel bag. Bag weight is useful for estimating the load you will carry.'
  },
  {
    q: 'How much will my pea gravel bag order weigh?',
    a: 'Multiply the rounded bag count by the weight printed on your bag. For the example of 53 bags, a product labeled 50 pounds per bag gives 2,650 pounds of bagged product. Enter your actual bag weight in the calculator; leave it blank if the label does not provide one.'
  },
  {
    q: 'Is the 2-inch setting suitable under playground equipment?',
    a: 'No. The 2-inch example is for a decorative surface, not fall protection. Playground surfacing needs a separate design based on equipment fall height, impact performance, installed depth, containment, and maintenance. Consult the current CPSC playground handbook and the surface manufacturer.'
  }
];

const upLinks = [
  { title: 'Pea Gravel Calculator (Material Parent)', slug: '/pea-gravel-calculator', badge: 'Material' },
  { title: 'Rock Bag Calculator (Unit Parent)', slug: '/rock-bag-calculator', badge: 'Unit' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Pea Gravel Cubic Yard Calculator', slug: '/pea-gravel-cubic-yard-calculator', badge: 'Bulk Yards' },
  { title: 'Pea Gravel Coverage Calculator', slug: '/pea-gravel-coverage-calculator', badge: 'Coverage' },
  { title: 'Pea Gravel Patio Calculator', slug: '/pea-gravel-patio-calculator', badge: 'Patio' }
];

const bridgeLinks = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'Angular vs Rounded Rock', slug: '/angular-vs-rounded-rock', badge: 'Surface Choice' }
];

const supportGuides = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: 'Gravel Size and Sieve Guide', slug: '/gravel-sizes', badge: 'Stone Size' },
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Installation' }
];
---

<BaseLayout
  title={pageTitle}
  metaDescription="Find how many bags of pea gravel to buy from area, depth and the bag's labeled cubic feet. See coverage per bag, optional extra, carry weight and a local bulk quote comparison."
  canonicalPath="/pea-gravel-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/pea-gravel-bag-calculator',
      description: 'Calculates bagged pea gravel from area, depth, labeled bag volume and optional extra allowance.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Bag"
      badge="Retail bag planning"
      subtitle="A 12 × 12 ft area at 2 inches needs 48 half-cubic-foot bags before extra, or 53 with a 10% allowance. Enter your bag's labeled volume below; its weight alone does not tell you its coverage."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="utility"
    />

    <section class="section" aria-labelledby="bag-tool-heading">
      <div class="container">
        <div class="section-intro">
          <h2 id="bag-tool-heading">Build your bag order</h2>
          <p>Measure the finished surface, choose its pea gravel depth, then read the cubic feet printed on the bag. The 10% extra is an editable planning choice for edges, uneven spots or spillage.</p>
        </div>
        <div class="calc-wrapper">
          <div class="calc-panel">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 9v12"/></svg>
              <h3>Project and package</h3>
            </div>

            <div class="mode-tabs" role="group" aria-label="Area entry method">
              <button type="button" class="mode-btn active" id="pgb-mode-dims" aria-pressed="true">Length × width</button>
              <button type="button" class="mode-btn" id="pgb-mode-area" aria-pressed="false">Known square feet</button>
            </div>

            <div class="dim-grid" id="pgb-dim-fields">
              <div class="input-field">
                <label for="pgb-length">Length (ft)</label>
                <input type="number" id="pgb-length" value="12" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="pgb-width">Width (ft)</label>
                <input type="number" id="pgb-width" value="12" min="0.01" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="dim-grid" id="pgb-area-fields" hidden>
              <div class="input-field">
                <label for="pgb-area">Measured area (sq ft)</label>
                <input type="number" id="pgb-area" value="144" min="0.01" step="any" inputmode="decimal" />
              </div>
            </div>

            <div class="dim-grid">
              <div class="input-field">
                <label for="pgb-depth">Pea gravel depth (in)</label>
                <input type="number" id="pgb-depth" value="2" min="0.1" max="24" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="pgb-capacity">Bag volume (ft³)</label>
                <input type="number" id="pgb-capacity" value="0.5" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="pgb-extra">Extra allowance (%)</label>
                <input type="number" id="pgb-extra" value="10" min="0" max="50" step="any" inputmode="decimal" />
              </div>
            </div>
            <p class="field-note">Use the bag's stated <strong>volume</strong> for coverage. Enter 0% for exact geometric volume, or add only what suits your site.</p>

            <h4 class="optional-heading">Optional store and delivery details</h4>
            <div class="dim-grid optional-grid">
              <div class="input-field">
                <label for="pgb-price">Price per bag ($)</label>
                <input type="number" id="pgb-price" min="0" step="any" inputmode="decimal" placeholder="From your store" />
              </div>
              <div class="input-field">
                <label for="pgb-bagfees">Bag order tax / transport ($)</label>
                <input type="number" id="pgb-bagfees" min="0" step="any" inputmode="decimal" placeholder="Optional total" />
              </div>
              <div class="input-field">
                <label for="pgb-weight">Weight per bag (lb)</label>
                <input type="number" id="pgb-weight" min="0.01" step="any" inputmode="decimal" placeholder="From the label" />
              </div>
              <div class="input-field">
                <label for="pgb-bulk">Delivered bulk quote ($)</label>
                <input type="number" id="pgb-bulk" min="0" step="any" inputmode="decimal" placeholder="Same quantity" />
              </div>
            </div>
            <p class="field-note">For a fair comparison, include your bag order's tax and transport and use a bulk quote that includes the supplier's minimum, delivery, taxes and fees for at least the planned volume.</p>
            <p id="pgb-error" class="dimension-error" role="alert" hidden></p>
          </div>

          <div class="calc-results-panel" aria-live="polite">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h8"/></svg>
              <h3>Your purchase estimate</h3>
            </div>
            <div id="pgb-results">
              <div class="bag-count">
                <span class="bag-count-label">Whole bags to buy</span>
                <strong id="pgb-bags">53</strong>
                <span id="pgb-bag-size">at 0.5 ft³ per bag</span>
              </div>
              <div class="result-grid">
                <div class="result-item"><span>Area</span><strong id="pgb-area-result">144 sq ft</strong></div>
                <div class="result-item"><span>Net fill volume</span><strong id="pgb-net">24.0 ft³</strong></div>
                <div class="result-item"><span>Planned volume</span><strong id="pgb-planned">26.4 ft³</strong></div>
                <div class="result-item"><span>Planned cubic yards</span><strong id="pgb-yards">0.98 yd³</strong></div>
                <div class="result-item"><span>One bag covers</span><strong id="pgb-coverage">3.0 sq ft</strong></div>
                <div class="result-item"><span>Bag order total</span><strong id="pgb-cost">Add price</strong></div>
              </div>
              <p class="result-note" id="pgb-weight-result">Enter the labeled bag weight to estimate your carry load.</p>
              <p class="quote-note" id="pgb-compare">Enter both a bag price and a delivered bulk quote to compare this order.</p>
              <p class="rounding-note">Bag count rounds up once, after the extra allowance. Coverage per bag is geometric and excludes the extra allowance.</p>
            </div>
            <p id="pgb-invalid-results" class="invalid-results-message" hidden>Correct the highlighted input to see your bag order.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="content-guide-section">
      <div class="container guide-container">
        <section class="content-card visual-card" aria-labelledby="bag-coverage-heading">
          <div>
            <p class="eyebrow">Bag label → ground coverage</p>
            <h2 id="bag-coverage-heading">A cubic foot is a volume, not an area</h2>
            <p>A half-cubic-foot bag covers <strong>3 square feet at 2 inches</strong> or <strong>2 square feet at 3 inches</strong>. Spread it thinner and the footprint grows; spread it deeper and the footprint shrinks. The coverage assumes a level layer and uses no extra allowance.</p>
            <p>NorthRock's <a href="https://www.tccmaterials.com/wp-content/uploads/2020/07/data_Nr-Pea-Gravel-2C-21.03.02-1.pdf" target="_blank" rel="noopener noreferrer">pea gravel product sheet</a> lists a ½ ft³ bag at up to 3 sq ft at 2 inches, which matches the geometry.</p>
          </div>
          <figure>
            <img src="/pea-gravel-bag-coverage.svg" alt="A 0.5 cubic foot bag spread over 3 square feet at 2 inches deep, or 2 square feet at 3 inches deep." width="780" height="420" loading="lazy" />
            <figcaption>Same bag volume. A deeper layer covers less area.</figcaption>
          </figure>
        </section>

        <section class="content-card" aria-labelledby="coverage-table-heading">
          <h2 id="coverage-table-heading">Coverage by bag size and depth</h2>
          <p>Use this table when reading a store label or checking a carton quantity. Each cell is the ideal square feet covered by one bag; project orders still need whole bags.</p>
          <div class="table-scroll">
            <table>
              <caption>Square feet covered per bag, before any extra allowance</caption>
              <thead><tr><th scope="col">Pea gravel depth</th><th scope="col">0.5 ft³ bag</th><th scope="col">0.6 ft³ bag</th></tr></thead>
              <tbody>
                <tr><th scope="row">1.5 in</th><td>4.0 sq ft</td><td>4.8 sq ft</td></tr>
                <tr><th scope="row">2 in</th><td>3.0 sq ft</td><td>3.6 sq ft</td></tr>
                <tr><th scope="row">2.5 in</th><td>2.4 sq ft</td><td>2.9 sq ft</td></tr>
                <tr><th scope="row">3 in</th><td>2.0 sq ft</td><td>2.4 sq ft</td></tr>
              </tbody>
            </table>
          </div>
          <p class="table-footnote">The second column matches common half-cubic-foot listings, including this <a href="https://www.lowes.com/pd/earthessentials-by-quikrete-0-5-cu-ft-50-lb-multiple-colors-finishes-pea-gravel/50437606" target="_blank" rel="noopener noreferrer">Lowe's pea gravel listing</a>. A <a href="https://ezmixinc.com/assets/docs-technical/SAKPeaGravelTDS.pdf" target="_blank" rel="noopener noreferrer">Sakrete technical sheet</a> gives approximately 0.6 ft³ for one of its 50 lb bags. Read the product in your hand; pounds alone are not a reliable bag-size input.</p>
        </section>

        <section class="content-card" aria-labelledby="bag-method-heading">
          <p class="eyebrow">Worked order</p>
          <h2 id="bag-method-heading">Calculate volume, add extra, then round once</h2>
          <div class="formula-box">
            <code>Net ft³ = area (sq ft) × depth (in) ÷ 12</code>
            <code>Planned ft³ = net ft³ × (1 + extra % ÷ 100)</code>
            <code>Bags = round up (planned ft³ ÷ labeled ft³ per bag)</code>
          </div>
          <p>For a <strong>12 × 12 ft</strong> space at <strong>2 inches</strong>, the surface requires 144 × 2 ÷ 12 = <strong>24 ft³</strong>. A chosen 10% extra makes that <strong>26.4 ft³</strong>. With a bag labeled 0.5 ft³, 26.4 ÷ 0.5 = 52.8, so buy <strong>53 whole bags</strong>. Without extra, the same space needs 48 bags.</p>
          <p>For a curved bed, divide it into measured sections or use its known square footage in the calculator. If the subgrade has low spots, measure the extra fill separately; a flat-area formula cannot discover them. The <a href="/pea-gravel-coverage-calculator">pea gravel coverage calculator</a> solves the reverse question when you already know the quantity on hand.</p>
        </section>

        <section class="content-card buying-card" aria-labelledby="buying-heading">
          <p class="eyebrow">At the supplier</p>
          <h2 id="buying-heading">Three checks before loading the bags</h2>
          <ol class="buying-list">
            <li><strong>Read the volume line.</strong> If it says 0.5 ft³, use 0.5. If it says 0.6 ft³, use 0.6. A weight-only label needs a product yield or supplier confirmation before you can calculate precise coverage.</li>
            <li><strong>Check the stone and depth.</strong> Rounded pea gravel can move underfoot, so plan a suitable border as <a href="https://extension.umaine.edu/gardening/2021/07/30/weed-barrier-stone/" target="_blank" rel="noopener noreferrer">University of Maine Extension</a> advises for gravel paths and patios. A <a href="/pea-gravel-patio-calculator">patio</a> also needs its base calculated separately. Bag count here is for the pea gravel layer only.</li>
            <li><strong>Plan the carry load.</strong> Multiply whole bags by the labeled pounds per bag. For 53 bags labeled 50 lb, that is 2,650 lb of product, before passengers or other cargo. Use your vehicle's payload rating or arrange delivery.</li>
          </ol>
        </section>

        <section class="content-card" aria-labelledby="bulk-heading">
          <p class="eyebrow">Bagged or delivered loose?</p>
          <h2 id="bulk-heading">Compare the full local quotes</h2>
          <p>There is no universal bag count where bulk becomes cheaper. Bag prices, pallet discounts, a supplier's minimum order and delivery distance change the answer. Enter your local bag price, any bag pickup or delivery costs and a delivered bulk quote for at least the planned volume to compare like for like.</p>
          <p>As a hypothetical example, 53 bags at $5.75 each cost $304.75 before sales tax and transport. A $240 delivered loose quote for the same volume would be $64.75 less before any taxes or bag transport costs. Bags may still help when access is narrow or the job is spread across several small beds. The <a href="/bulk-vs-bagged-rock">bulk versus bagged guide</a> covers handling and delivery tradeoffs; the <a href="/pea-gravel-cubic-yard-calculator">pea gravel cubic yard calculator</a> converts larger orders.</p>
        </section>

        <section class="content-card faq-card" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Pea gravel bag questions</h2>
          <div class="faq-list">
            {faqItems.map(item => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
          <p class="safety-source">For playground surfacing, consult the <a href="https://www.cpsc.gov/Playground-Handbook" target="_blank" rel="noopener noreferrer">current CPSC Public Playground Safety Handbook</a>; a decorative gravel depth is not a fall-protection specification.</p>
        </section>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/pea-gravel-bag-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>
  <Footer />

  <script>
    type InputId = 'pgb-length' | 'pgb-width' | 'pgb-area' | 'pgb-depth' | 'pgb-capacity' | 'pgb-extra' | 'pgb-price' | 'pgb-bagfees' | 'pgb-weight' | 'pgb-bulk';
    const input = (id: InputId) => document.getElementById(id) as HTMLInputElement;
    const output = (id: string, value: string) => { const element = document.getElementById(id); if (element) element.textContent = value; };
    const value = (id: InputId) => {
      const raw = input(id).value.trim();
      return raw === '' ? NaN : Number(raw);
    };
    const money = (amount: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);
    let areaMode: 'dimensions' | 'square-feet' = 'dimensions';

    function updatePGB() {
      const required: InputId[] = areaMode === 'dimensions'
        ? ['pgb-length', 'pgb-width', 'pgb-depth', 'pgb-capacity', 'pgb-extra']
        : ['pgb-area', 'pgb-depth', 'pgb-capacity', 'pgb-extra'];
      const optional: InputId[] = ['pgb-price', 'pgb-bagfees', 'pgb-weight', 'pgb-bulk'];
      const invalid = [...required, ...optional].find(id => {
        const field = input(id);
        const number = value(id);
        if (optional.includes(id) && field.value.trim() === '') return false;
        const minimum = Number(field.min);
        const maximum = field.max === '' ? Infinity : Number(field.max);
        return !Number.isFinite(number) || number < minimum || number > maximum;
      });
      [...required, ...optional].forEach(id => {
        const field = input(id);
        if (id === invalid) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      });

      const error = document.getElementById('pgb-error') as HTMLElement;
      const results = document.getElementById('pgb-results') as HTMLElement;
      const invalidResults = document.getElementById('pgb-invalid-results') as HTMLElement;
      if (invalid) {
        error.textContent = 'Enter a valid value for ' + (document.querySelector('label[for="' + invalid + '"]')?.textContent?.trim() || 'the highlighted field') + '.';
        error.hidden = false;
        results.hidden = true;
        invalidResults.hidden = false;
        return;
      }
      error.hidden = true;
      results.hidden = false;
      invalidResults.hidden = true;

      const area = areaMode === 'dimensions' ? value('pgb-length') * value('pgb-width') : value('pgb-area');
      const depth = value('pgb-depth');
      const capacity = value('pgb-capacity');
      const extra = value('pgb-extra');
      const net = area * depth / 12;
      const planned = net * (1 + extra / 100);
      const bags = Math.ceil(planned / capacity - 1e-10);
      const price = value('pgb-price');
      const bagFees = value('pgb-bagfees');
      const weight = value('pgb-weight');
      const bulk = value('pgb-bulk');
      const bagCost = Number.isFinite(price) ? bags * price + (Number.isFinite(bagFees) ? bagFees : 0) : NaN;

      if (![area, net, planned, bags].every(Number.isFinite) || !Number.isSafeInteger(bags)) {
        error.textContent = 'Use smaller project values to calculate a reliable bag order.';
        error.hidden = false;
        results.hidden = true;
        invalidResults.hidden = false;
        return;
      }

      output('pgb-bags', bags.toLocaleString('en-US'));
      output('pgb-bag-size', 'at ' + capacity.toLocaleString('en-US', { maximumFractionDigits: 3 }) + ' ft³ per bag');
      output('pgb-area-result', area.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' sq ft');
      output('pgb-net', net.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' ft³');
      output('pgb-planned', planned.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' ft³');
      output('pgb-yards', (planned / 27).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' yd³');
      output('pgb-coverage', (capacity * 12 / depth).toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' sq ft');
      output('pgb-cost', Number.isFinite(bagCost) ? money(bagCost) : 'Add price');
      output('pgb-weight-result', Number.isFinite(weight)
        ? 'Carry load: ' + (bags * weight).toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' lb of bagged product at your labeled weight.'
        : 'Enter the labeled bag weight to estimate your carry load.');
      const comparison = !Number.isFinite(bagCost) || !Number.isFinite(bulk)
        ? 'Enter both a bag price and a delivered bulk quote to compare this order.'
        : bagCost > bulk
          ? 'For the same planned volume, the delivered bulk quote is ' + money(bagCost - bulk) + ' less than these bags.'
          : bagCost < bulk
            ? 'For the same planned volume, these bags are ' + money(bulk - bagCost) + ' less than the delivered bulk quote.'
            : 'The bag order and delivered bulk quote are equal.';
      output('pgb-compare', comparison);
    }

    function setMode(next: 'dimensions' | 'square-feet') {
      areaMode = next;
      const dimensions = next === 'dimensions';
      (document.getElementById('pgb-dim-fields') as HTMLElement).hidden = !dimensions;
      (document.getElementById('pgb-area-fields') as HTMLElement).hidden = dimensions;
      const dimsButton = document.getElementById('pgb-mode-dims') as HTMLButtonElement;
      const areaButton = document.getElementById('pgb-mode-area') as HTMLButtonElement;
      dimsButton.classList.toggle('active', dimensions);
      areaButton.classList.toggle('active', !dimensions);
      dimsButton.setAttribute('aria-pressed', String(dimensions));
      areaButton.setAttribute('aria-pressed', String(!dimensions));
      updatePGB();
    }

    document.getElementById('pgb-mode-dims')?.addEventListener('click', () => setMode('dimensions'));
    document.getElementById('pgb-mode-area')?.addEventListener('click', () => setMode('square-feet'));
    (['pgb-length', 'pgb-width', 'pgb-area', 'pgb-depth', 'pgb-capacity', 'pgb-extra', 'pgb-price', 'pgb-bagfees', 'pgb-weight', 'pgb-bulk'] as InputId[]).forEach(id => {
      input(id).addEventListener('input', updatePGB);
    });
    updatePGB();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0 var(--space-12); }
  .section-intro { max-width: 740px; margin: 0 0 var(--space-6); }
  .section-intro h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin-bottom: var(--space-2); color: var(--text-primary); }
