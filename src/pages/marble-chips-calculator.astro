    <PageHero
      title={pageTitle}
      highlightWord="Calculator"
      badge="White marble landscape stone"
      subtitle="For a 150 sq ft bed at 2 inches, the finished layer is 0.93 cubic yard. Add 10% to plan 1.02 cubic yards, or about 1.38 US short tons at the editable 2,700 lb/yd³ example weight."
      breadcrumbs={breadcrumbs}
