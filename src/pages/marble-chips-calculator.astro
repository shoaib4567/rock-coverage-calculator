      theme="decorative"
    />

    <section class="section marble-tool" aria-labelledby="marble-tool-title">
      <div class="container">
        <div class="section-intro">
          <h2 id="marble-tool-title">Estimate a finished layer and an order</h2>
          <p>Measure the area inside your edging. Enter the depth you want after spreading, then use your supplier’s loose bulk weight if you have it. Bag equivalents here use 0.5 cu ft; the <a href="/marble-chips-bag-calculator">marble chips bag calculator</a> accepts the actual volume printed on a retail bag.</p>
        </div>
        <div class="calc-wrapper">
          <div class="calc-panel">
            <div class="calc-panel-title"><h3>Bed measurements</h3></div>
            <div class="dim-grid">
              <div class="input-field"><label for="marble-length">Length (ft)</label><input id="marble-length" type="number" value="30" min="0.1" step="0.1" inputmode="decimal" /></div>
              <div class="input-field"><label for="marble-width">Width (ft)</label><input id="marble-width" type="number" value="5" min="0.1" step="0.1" inputmode="decimal" /></div>
              <div class="input-field"><label for="marble-depth">Finished depth (in)</label><input id="marble-depth" type="number" value="2" min="0.5" max="12" step="0.5" inputmode="decimal" /></div>
              <div class="input-field"><label for="marble-allowance">Order allowance (%)</label><input id="marble-allowance" type="number" value="10" min="0" max="25" step="1" inputmode="decimal" /></div>
              <div class="input-field"><label for="marble-density">Supplier bulk weight (lb/yd³)</label><input id="marble-density" type="number" value="2700" min="1" max="10000" step="50" inputmode="decimal" /><small>2,700 is one supplier example, not a universal marble density.</small></div>
            </div>
            <p class="input-error" id="marble-error" role="status" aria-live="polite"></p>
          </div>
          <div class="calc-results-panel" aria-live="polite">
            <div class="calc-panel-title"><h3>Marble chip quantities</h3></div>
            <div class="kpi-grid">
              <div class="kpi-card"><div class="kpi-value" id="kpi-marble-net">0.00</div><div class="kpi-label">Finished cubic yards</div><div class="kpi-subtext" id="kpi-marble-net-cuft">Before allowance</div></div>
              <div class="kpi-card highlight"><div class="kpi-value" id="kpi-marble-order">0.00</div><div class="kpi-label">Order cubic yards</div><div class="kpi-subtext" id="kpi-marble-order-cuft">With 10% allowance</div></div>
              <div class="kpi-card"><div class="kpi-value" id="kpi-marble-tons">0.00</div><div class="kpi-label">Estimated US short tons</div><div class="kpi-subtext" id="kpi-marble-lbs">At supplier bulk weight</div></div>
              <div class="kpi-card"><div class="kpi-value" id="kpi-marble-bags">0</div><div class="kpi-label">0.5 cu ft bag equivalents</div><div class="kpi-subtext">Round up whole bags; confirm your bag label.</div></div>
            </div>
            <p class="result-note">Order volume includes the chosen allowance. The scale weight is a planning estimate; a supplier’s actual material and moisture determine the billed weight.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="marble-guide">
      <div class="container">
        <section class="content-card" aria-labelledby="marble-math-title">
          <h2 id="marble-math-title">What the result means</h2>
          <p>A 30 × 5 ft border is 150 sq ft. A 2 in finished layer takes <strong>25 cu ft</strong> (150 × 2 ÷ 12), or <strong>0.93 cu yd</strong> (25 ÷ 27). A 10% ordering allowance brings that to <strong>27.5 cu ft = 1.02 cu yd</strong>. At 2,700 lb per loose cubic yard, the order weighs about <strong>2,750 lb = 1.38 US short tons</strong>. If you instead buy 0.5 cu ft bags, 27.5 ÷ 0.5 = <strong>55 bags</strong>.</p>
          <div class="formula-box" aria-label="Marble chips calculation formulas">
            <span>Finished cu ft = area (sq ft) × finished depth (in) ÷ 12</span>
            <span>Order cu yd = finished cu ft × (1 + allowance ÷ 100) ÷ 27</span>
            <span>US short tons = order cu yd × supplier lb/yd³ ÷ 2,000</span>
          </div>
          <p>Use the <a href="/marble-chips-bag-calculator">bag calculator</a> when a store sells 0.4 cu ft bags or quotes bag weight and price. Bag count depends on <em>labeled volume</em>; bulk density is used only for the loose stone tonnage estimate.</p>
        </section>

        <section class="content-card" aria-labelledby="marble-depth-title">
          <h2 id="marble-depth-title">Choose depth before you buy</h2>
          <p>Coverage changes directly with finished depth. Choose a depth suited to the chip size, ground beneath, and the look you want; a top-up over existing rock is different from a new bed. The table shows pure volume math. The <a href="https://cumminlandscapesupply.com/marblechips-gravel">supplier used for the default weight</a> advertises about 100 sq ft per cubic yard at 2 inches, versus 162 sq ft by geometry. Ask your seller to explain its product-specific yield and use the verified figure when placing the order.</p>
          <div class="table-scroll"><table><caption>Geometric coverage from one cubic yard, before allowance</caption><thead><tr><th scope="col">Finished depth</th><th scope="col">Coverage per cu yd</th><th scope="col">Coverage per US short ton at 2,700 lb/yd³</th></tr></thead><tbody><tr><th scope="row">1.5 in</th><td>216 sq ft</td><td>160 sq ft</td></tr><tr><th scope="row">2 in</th><td>162 sq ft</td><td>120 sq ft</td></tr><tr><th scope="row">3 in</th><td>108 sq ft</td><td>80 sq ft</td></tr></tbody></table></div>
          <figure class="marble-figure"><div class="figure-scroll" tabindex="0" aria-label="Scroll marble layer diagram"><img src="/marble-chips-layer.svg" width="1000" height="480" loading="lazy" alt="Cross section showing a measured two inch white marble chip layer inside edging, with an optional permeable separator above prepared soil." /></div><figcaption>Measure the chip layer itself. A permeable separator can keep soil and stone apart, but it is not a permanent weed solution. <span class="figure-scroll-tip">Swipe the diagram to see its full width.</span></figcaption></figure>
        </section>

        <section class="content-card" aria-labelledby="marble-weight-title">
          <h2 id="marble-weight-title">Why bulk weight is editable</h2>
          <p>White marble products differ by source and chip grading. <a href="https://cumminlandscapesupply.com/marblechips-gravel">Cummin Landscape Supply lists about 2,700 lb per cubic yard</a> for its marble chips, while <a href="https://www.gravelshop.com/shop/calculate-cubic-yard-feet-ton.asp?groupid=86&amp;productid=529">Gravelshop lists 2,410 lb per cubic yard</a> for its 1 in white chips. Both are supplier examples. Ask the seller for the loose bulk weight of the stone being delivered and replace the default when estimating tons.</p>
          <p>Marble is a recrystallized carbonate rock that can contain calcite, dolomite, or both, as described by the <a href="https://apps.usgs.gov/thesaurus/term-simple.php?code=5.2.5&amp;thcode=4">US Geological Survey</a>. Its <em>particle density</em> is different from the loose bulk weight used here because a stockpile contains gaps between chips. <a href="https://store.astm.org/c0029_c0029m-23.html">ASTM C29/C29M</a> describes a method for measuring aggregate bulk density; this calculator uses supplier figures and does not claim a laboratory test of this particular stone.</p>
        </section>

        <section class="content-card" aria-labelledby="marble-fit-title">
          <h2 id="marble-fit-title">Where white marble works, and where to pause</h2>
          <div class="advice-grid">
            <div><h3>Good uses</h3><p>Use it as a bright contrast in contained borders, around pavers, or in low-traffic accent beds. Install an edge so loose chips stay out of turf and off paving. Keep a small sample beside your exterior finish before committing to a large area; white chips can show leaves, dust, and stains readily.</p></div>
            <div><h3>Plant and maintenance checks</h3><p>Carbonate stone can increase soil alkalinity through leaching. <a href="https://extension.msstate.edu/sites/default/files/publications/P2301.pdf">Mississippi State Extension advises against gravel or stone mulch near acid-loving plants</a> and notes heat and reflected light. Keep chips away from stems and trunks, remove leaf litter, and plan for occasional hand weeding even if you use permeable fabric.</p></div>
          </div>
          <p class="source-note">Fabric can separate stone from soil, but <a href="https://extension.oregonstate.edu/sites/extd8/files/documents/ec1629.pdf">Oregon State Extension notes that weeds can grow in material above fabric</a>. For planted tree rings, consider whether stone is appropriate for the plant before following a decorative layout.</p>
        </section>

        <section class="content-card faq-card" aria-labelledby="marble-faq-title">
          <h2 id="marble-faq-title">Marble chips questions</h2>
          <div class="faq-list">{faqItems.map(item => <div class="faq-item"><h3>{item.q}</h3><p>{item.a}</p></div>)}</div>
        </section>
      </div>
    </article>

    <TopicClusterNav currentPage="/marble-chips-calculator" category="material" upLinks={upLinks} lateralLinks={lateralLinks} bridgeLinks={bridgeLinks} supportGuides={supportGuides} />
  </main>
  <Footer />

  <script>
    function updateMarble() {
      const value = (id: string) => parseFloat((document.getElementById(id) as HTMLInputElement).value);
      const length = value('marble-length');
      const width = value('marble-width');
      const depth = value('marble-depth');
      const allowance = value('marble-allowance');
      const density = value('marble-density');
      const fieldValidity: Record<string, boolean> = {
        'marble-length': Number.isFinite(length) && length > 0,
        'marble-width': Number.isFinite(width) && width > 0,
        'marble-depth': Number.isFinite(depth) && depth >= 0.5 && depth <= 12,
        'marble-allowance': Number.isFinite(allowance) && allowance >= 0 && allowance <= 25,
        'marble-density': Number.isFinite(density) && density > 0 && density <= 10000
      };
      Object.entries(fieldValidity).forEach(([id, valid]) => {
        document.getElementById(id)?.setAttribute('aria-invalid', String(!valid));
      });
      const volumeValid = ['marble-length', 'marble-width', 'marble-depth', 'marble-allowance']
        .every(id => fieldValidity[id]);
      const error = document.getElementById('marble-error');
      if (!volumeValid) {
        ['kpi-marble-net', 'kpi-marble-order', 'kpi-marble-tons', 'kpi-marble-bags']
          .forEach(id => { const el = document.getElementById(id); if (el) el.textContent = '—'; });
        ['kpi-marble-net-cuft', 'kpi-marble-order-cuft', 'kpi-marble-lbs'].forEach(id => {
          const el = document.getElementById(id); if (el) el.textContent = 'Enter valid values to calculate.';
        });
        if (error) error.textContent = 'Enter positive bed dimensions, a 0.5–12 in depth, and a 0–25% allowance.';
        return;
      }
      if (error) error.textContent = '';
      const finishedFeet = length * width * depth / 12;
      const orderFeet = finishedFeet * (1 + allowance / 100);
      const orderYards = orderFeet / 27;
      const values: Record<string, string> = {
        'kpi-marble-net': (finishedFeet / 27).toFixed(2),
        'kpi-marble-order': orderYards.toFixed(2),
        'kpi-marble-bags': Math.max(1, Math.ceil(orderFeet / 0.5 - 1e-10)).toLocaleString(),
        'kpi-marble-net-cuft': finishedFeet.toFixed(1) + ' cu ft before allowance',
        'kpi-marble-order-cuft': orderFeet.toFixed(1) + ' cu ft with ' + allowance + '% allowance'
      };
      Object.entries(values).forEach(([id, text]) => { const el = document.getElementById(id); if (el) el.textContent = text; });
      const tons = document.getElementById('kpi-marble-tons');
      const poundsLabel = document.getElementById('kpi-marble-lbs');
      if (fieldValidity['marble-density']) {
        const pounds = orderYards * density;
        if (tons) tons.textContent = (pounds / 2000).toFixed(2);
        if (poundsLabel) poundsLabel.textContent = Math.round(pounds).toLocaleString() + ' lb at ' + density.toLocaleString() + ' lb/yd³';
      } else {
        if (tons) tons.textContent = '—';
        if (poundsLabel) poundsLabel.textContent = 'Enter a positive supplier bulk weight.';
      }
    }
    ['marble-length', 'marble-width', 'marble-depth', 'marble-allowance', 'marble-density'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateMarble);
    });
    updateMarble();
  </script>
</BaseLayout>

