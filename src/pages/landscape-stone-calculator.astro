---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import LandscapeStoneCalculator from '../components/calculators/LandscapeStoneCalculator.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import { getMaterialById } from '../scripts/materials-data.js';

const pageTitle = 'Landscape Stone Calculator';
const cleanStoneDensity = getMaterialById('clean-stone-57').tonsPerCuYd;
const denseBaseDensity = getMaterialById('crusher-run-21a').tonsPerCuYd;
const finishedExampleYards = 20 * 20 * 4 / 324;
const cleanExampleYards = finishedExampleYards * 1.05;
const denseExampleBeforeExtra = finishedExampleYards / 0.85;
const denseExampleOrderYards = denseExampleBeforeExtra * 1.05;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: pageTitle, url: '/landscape-stone-calculator' }
];

const faqItems = [
  {
    q: 'How many cubic yards of landscape stone cover 100 square feet?',
    a: 'At 2 inches deep, 100 square feet requires 0.62 cubic yard in place; at 3 inches, it requires 0.93 cubic yard. Divide area in square feet times depth in inches by 324. Add a separate allowance for low spots and, for a compacted base, a supplier-specific loose-to-finished loss.'
  },
  {
    q: 'How many tons are in a cubic yard of landscape stone?',
    a: 'There is no universal tons-per-yard value. Loose bulk density changes with rock type, size grading, moisture, and the supplier. This calculator begins with editable examples of 1.25 to 1.45 US short tons per loose cubic yard; replace the example with your yard’s conversion before ordering.'
  },
  {
    q: 'Should I add 20% for compaction?',
    a: 'Only if your material and placement method justify a 20% loss of loose volume. Clean open-graded #57 stone and dense-graded base do not settle alike. Enter the loss your supplier or project specification uses. If loose material loses 20% of its volume, divide the finished volume by 0.80; that is a 25% increase in loose volume before any separate extra allowance.'
  },
  {
    q: 'Can I use this for flagstone, cobbles, or boulders?',
    a: 'This tool estimates loose stone spread in a layer. Flagstone slabs and cobbles are purchased by piece, pallet, or surface coverage, and a boulder is estimated from its own dimensions and weight. Calculate those materials separately from the crushed-stone base beneath them.'
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'All materials' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'Planning hub' }
];
const lateralLinks = [
  { title: 'Landscape Rock Calculator', slug: '/landscape-rock-calculator', badge: 'Garden beds' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: 'Aggregate' },
  { title: 'Crusher Run Calculator', slug: '/crusher-run-calculator', badge: 'Dense base' }
];
const bridgeLinks = [
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Weight' },
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Volume' },
  { title: 'Cobblestone Calculator', slug: '/cobblestone-calculator', badge: 'Piece count' }
];
const supportGuides = [
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'Grading' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'Decomposed Granite Calculator', slug: '/decomposed-granite-calculator', badge: 'DG' }
];
---

<BaseLayout
  title={pageTitle}
  description="Estimate loose cubic yards and US short tons of crushed landscape stone for a path, patio base, or driveway layer. Adjust depth, density, settlement, and extra material."
  canonicalPath="/landscape-stone-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/landscape-stone-calculator',
      description: 'Estimates finished volume, loose order volume, and US short tons for spread crushed stone with editable bulk density and volume loss.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question', name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Calculator"
      badge="Crushed stone • loose yards • short tons"
      subtitle={`A 20 × 20 ft layer at 4 in deep holds ${finishedExampleYards.toFixed(2)} yd³. With the clean #57 example, 5% extra and no assumed settlement, order about ${cleanExampleYards.toFixed(2)} loose yd³ or ${(cleanExampleYards * cleanStoneDensity).toFixed(2)} short tons. Enter your own dimensions and supplier figures below.`}
      breadcrumbs={breadcrumbs}
      entityTags={[
        { label: 'Use', value: 'Paths, patio base, driveway base' },
        { label: 'Units', value: 'Cubic yards and US short tons' }
      ]}
      quickStats={[
        { value: 'Area × depth ÷ 324', label: 'Finished yd³', desc: 'Area in square feet; depth in inches' },
        { value: '÷ (1 − loss)', label: 'Loose yd³', desc: 'Apply only a loss appropriate to your material' },
        { value: '× loose density', label: 'Short tons', desc: 'Use your supplier’s tons per cubic yard' }
      ]}
      theme="civil"
    />

    <LandscapeStoneCalculator />

    <article class="stone-field-guide">
      <div class="container">
        <div class="guide-intro">
          <p class="eyebrow">Before you place an order</p>
          <h2>Delivery volume and finished layer depth are different measurements</h2>
          <p>Those two volumes can differ. The calculator first finds the space the finished layer occupies, then adjusts for the loose-to-finished volume loss you enter, adds extra for low spots or spillage, and converts the loose order to weight. <strong>Its density and loss presets are examples, not material specifications.</strong> For a large order, ask the supplier for both values.</p>
        </div>

        <div class="coverage-strip" aria-label="Finished coverage from one cubic yard before allowances">
          <div><span>1 finished yd³ covers</span><strong>162 sq ft</strong><small>at 2 in deep</small></div>
          <div><span>1 finished yd³ covers</span><strong>108 sq ft</strong><small>at 3 in deep</small></div>
          <div><span>1 finished yd³ covers</span><strong>81 sq ft</strong><small>at 4 in deep</small></div>
          <p>These are geometric coverage figures before loose-to-finished loss or extra. Stone size and layer depth are separate measurements.</p>
        </div>

        <div class="diagram-layout">
          <figure class="layer-figure">
            <svg viewBox="0 0 640 330" role="img" aria-labelledby="stone-layer-title stone-layer-desc">
              <title id="stone-layer-title">Paver, bedding, stone base, and soil layers</title>
              <desc id="stone-layer-desc">A paver surface and its thin bedding course lie above a measured crushed-stone layer. Prepared soil lies below. Only the crushed-stone layer is counted in the calculator depth.</desc>
              <rect width="640" height="330" rx="18" fill="#172335" />
              <rect x="28" y="28" width="442" height="52" rx="5" fill="#b8946c" />
              <path d="M28 54H470M66 28v52M128 28v52M195 28v52M260 28v52M327 28v52M398 28v52" stroke="#6d523c" stroke-width="3" opacity=".7" />
              <rect x="28" y="86" width="442" height="26" rx="4" fill="#d3b884" />
              <path d="M38 99h420" stroke="#9c8258" stroke-width="5" stroke-dasharray="10 7" opacity=".8" />
              <rect x="28" y="118" width="442" height="100" rx="5" fill="#8294a4" />
              <path d="M42 133l28 15 25-15 28 20 32-17 22 16 31-16 20 15 29-20 34 16 30-18 23 19 31-13 27 21 31-19M46 178l27 21 25-17 33 20 25-17 30 16 24-15 30 15 28-18 29 16 28-16 29 18 27-17 25 14" fill="none" stroke="#47586b" stroke-width="8" stroke-linejoin="round" />
              <rect x="28" y="224" width="442" height="78" rx="5" fill="#705b46" />
              <path d="M31 246q60 10 120 0t120 0t198 0M31 275q70 12 142 0t145 2t151-2" fill="none" stroke="#564432" stroke-width="7" opacity=".5" />
              <path d="M483 118h15m-8 0v100m-7 0h15" stroke="#f9c96a" stroke-width="3" />
              <text x="510" y="56" fill="#f5e9d6" font-size="16" font-weight="700">Pavers</text>
              <text x="510" y="105" fill="#f5e9d6" font-size="16" font-weight="700">Bedding</text>
              <text x="510" y="169" fill="#f9c96a" font-size="16" font-weight="700">Stone depth</text>
              <text x="510" y="267" fill="#f5e9d6" font-size="16" font-weight="700">Soil</text>
            </svg>
            <figcaption>Measure only the stone layer. A paver and its bedding course are separate materials.</figcaption>
          </figure>
          <div class="field-note">
            <h3>Which stone does this page mean?</h3>
            <p>“Landscape stone” can mean many products at a yard. This tool is for <strong>loose crushed stone spread to a depth</strong>: clean angular #57, dense graded base, or decomposed granite. A label such as “¾ inch” tells you a size range, not the bulk density or the exact amount of fines.</p>
            <p>For river rock or decorative stone around plants, use the <a href="/landscape-rock-calculator">landscape rock calculator</a>. For individual blocks, use the <a href="/cobblestone-calculator">cobblestone calculator</a>. Flagstone slabs and boulders also need a different takeoff than bulk stone.</p>
          </div>
        </div>

        <section class="guide-section" aria-labelledby="stone-choice-title">
          <p class="eyebrow">Material choice</p>
          <h2 id="stone-choice-title">Choose by the layer’s job</h2>
          <div class="choice-grid">
            <div class="choice-card"><span class="card-number">01</span><h3>Clean #57 angular stone</h3><p>Open graded stone has fewer fines and leaves connected voids for drainage. It can be used in an <em>engineered open graded paver base</em> with a compatible bedding course; it is not merely a top dressing. Ask for the supplier’s exact grading.</p><a href="/57-stone-size-guide">Explore #57 sizing →</a></div>
            <div class="choice-card"><span class="card-number">02</span><h3>Dense graded base</h3><p>Crusher run or road base mixes coarse particles with smaller particles and fines. It is placed and compacted as a base. Regional product names such as #411 are not a substitute for the local gradation specification.</p><a href="/crusher-run-calculator">Calculate crusher run →</a></div>
            <div class="choice-card"><span class="card-number">03</span><h3>Decomposed granite</h3><p>DG is a finer surface material often used for paths. Natural and stabilized products behave differently, so check the manufacturer’s depth, compaction, and watering instructions before using a preset.</p><a href="/decomposed-granite-calculator">Explore DG quantities →</a></div>
          </div>
        </section>

        <section class="guide-section" aria-labelledby="example-title">
          <p class="eyebrow">Worked order</p>
          <h2 id="example-title">A 20 × 20 ft patio base at 4 in</h2>
          <p>For an illustration, choose <strong>dense graded base</strong> in the calculator. With its editable 15% loose-to-finished volume loss, 5% extra, and 1.45 short tons per loose cubic yard, the estimate is:</p>
          <div class="worked-math" aria-label="Worked patio base calculation">
            <div><span>Finished layer</span><strong>20 × 20 × 4 ÷ 324 = 4.94 yd³</strong></div>
            <div><span>Loose before extra</span><strong>4.94 ÷ 0.85 = 5.81 yd³</strong></div>
            <div><span>Loose order</span><strong>5.81 × 1.05 = 6.10 yd³</strong></div>
            <div><span>Estimated weight</span><strong>6.10 × 1.45 ≈ 8.85 short tons</strong></div>
          </div>
          <p class="small-note">Values are rounded for display. The calculator carries full precision through each step. A 15% <em>loss of loose volume</em> requires division by 0.85; it is not the same as adding 15% to the finished volume. The extra 5% is separate.</p>
        </section>

        <section class="guide-section split-section" aria-labelledby="measure-title">
          <div>
            <p class="eyebrow">Field checklist</p>
            <h2 id="measure-title">Measure the layer you will actually build</h2>
            <ol class="field-steps">
              <li><strong>Break up an irregular shape.</strong> Measure rectangles separately, or use half of base × height for a triangular end. Add their square footage before entering dimensions; for an irregular area, choose equivalent length and width whose product is the total area.</li>
              <li><strong>Set finished elevations.</strong> Measure stone depth below the bedding layer or finished path surface. Do not include pavers, bedding sand, or a separate decorative top course in the stone depth.</li>
              <li><strong>Check the subgrade.</strong> Low spots and over-excavation increase material. The extra field covers this uncertainty; it is not a second compaction factor.</li>
              <li><strong>Confirm the delivery unit.</strong> Ask whether the yard quotes loose cubic yards or scale tons and whether its tons are US short tons. Get the product’s loose tons-per-yard factor if you are converting between them.</li>
            </ol>
          </div>
          <aside class="order-note">
            <h3>What to ask the supplier</h3>
            <ul>
              <li>What is this product called locally, and what is its gradation?</li>
              <li>How many <em>short tons per loose cubic yard</em> should I use for this stockpile?</li>
              <li>For my depth and compactor, what loose-to-finished order factor do you use?</li>
              <li>Can one truck carry the calculated weight, and is there a minimum load?</li>
            </ul>
            <p>Bulk density and placed volume are different measurements. The calculator’s slider describes volume lost from <em>loose to finished</em>; it is not a laboratory “percent compaction” result.</p>
          </aside>
        </section>

        <section class="guide-section" aria-labelledby="depth-title">
          <p class="eyebrow">Build the right section</p>
          <h2 id="depth-title">Depth depends on soil, drainage, climate, and traffic</h2>
          <p>A four-inch example is useful for learning the math, but it is not a universal patio specification. The <a href="https://www.masonryandhardscapes.org/resource/pav-tec-010/" rel="noopener noreferrer">Concrete Masonry &amp; Hardscapes Association’s application guide</a> gives 4–6 inches of aggregate base for walks and 6–8 inches for driveways as minimum ranges that can grow with site conditions. Its diagrams show bedding and pavers as separate layers and geotextile as site dependent, not automatic.</p>
          <p>Compact base material in lifts suited to the equipment and gradation. Preserve a drainage slope away from buildings and address weak or wet soil before adding more stone. A clean open graded base uses a different bedding approach than a dense graded base; <a href="https://contractor.unilock.com/installation/paver-installation/how-to-install-patio-on-grade/" rel="noopener noreferrer">Unilock compares both assemblies</a>. For decorative coverage depth rather than a structural base, see the <a href="/rock-depth-guide">rock depth guide</a>.</p>
        </section>

        <section class="guide-section faq-section" aria-labelledby="faq-title">
          <p class="eyebrow">Common questions</p>
          <h2 id="faq-title">Landscape stone calculator FAQs</h2>
          {faqItems.map(item => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>

        <section class="source-note" aria-labelledby="sources-title">
          <h2 id="sources-title">How this estimate was checked</h2>
          <p>The area and volume conversion is geometry: 12 inches per foot and 27 cubic feet per cubic yard. The <a href="https://dirtandgravel.psu.edu/general-resources/dglvr-materials-calculator/" rel="noopener noreferrer">Penn State Center for Dirt and Gravel Road Studies</a> explains why supplier-specific density and compaction ratios matter and offers custom inputs. <a href="https://www.emnrd.nm.gov/mmd/wp-content/uploads/sites/5/ConvFctrs.pdf" rel="noopener noreferrer">New Mexico’s construction-material conversion table</a> shows different yard-to-ton factors for gravel, limestone, and base course. These references support editable estimates, not a guaranteed delivery weight.</p>
        </section>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/landscape-stone-calculator"
      category="material"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>
  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .stone-field-guide { padding: var(--space-12) 0; background: var(--bg-body); color: var(--text-secondary); }
  .stone-field-guide .container { max-width: 1140px; }
  .stone-field-guide h2, .stone-field-guide h3 { color: var(--text-primary); line-height: 1.22; }
  .stone-field-guide h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); margin: 0 0 var(--space-4); }
  .stone-field-guide h3 { font-size: var(--text-lg); margin: 0 0 var(--space-3); }
  .stone-field-guide p { line-height: 1.72; }
  .stone-field-guide a { color: var(--accent-gold); text-underline-offset: 3px; }
  .eyebrow { color: var(--accent-gold); font-size: var(--text-xs); font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 var(--space-3); }
  .guide-intro { max-width: 780px; margin-bottom: var(--space-8); }
  .guide-intro > p:last-child { font-size: var(--text-base); margin-bottom: 0; }
  .diagram-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-6); margin-bottom: var(--space-10); }
  .layer-figure, .field-note, .guide-section, .source-note { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .layer-figure { margin: 0; padding: var(--space-4); }
  .layer-figure svg { width: 100%; height: auto; display: block; border-radius: var(--radius-md); }
  .layer-figure figcaption { font-size: var(--text-xs); line-height: 1.5; margin: var(--space-3) var(--space-1) 0; color: var(--text-muted); }
  .field-note { padding: var(--space-6); border-left: 4px solid var(--accent-gold); }
  .field-note p:last-child { margin-bottom: 0; }
  .guide-section { padding: clamp(1.25rem, 3vw, 2.5rem); margin-bottom: var(--space-8); }
  .choice-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-6); }
  .choice-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-5); display: flex; flex-direction: column; }
  .choice-card .card-number { color: var(--accent-gold); font: 800 1.5rem var(--font-mono); margin-bottom: var(--space-3); }
  .choice-card p { flex: 1; margin-top: 0; }
  .choice-card a { font-weight: 700; font-size: var(--text-sm); }
  .worked-math { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3); margin: var(--space-6) 0 var(--space-4); }
  .worked-math div { display: flex; flex-direction: column; gap: var(--space-2); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-top: 3px solid var(--accent-gold); border-radius: var(--radius-md); padding: var(--space-4); }
  .worked-math span { font-size: var(--text-xs); color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .worked-math strong { color: var(--text-primary); font-size: var(--text-sm); line-height: 1.4; }
  .small-note { font-size: var(--text-sm); color: var(--text-muted); }
  .split-section { display: grid; grid-template-columns: 1.35fr 1fr; gap: var(--space-8); }
  .field-steps { padding-left: 1.4rem; margin-bottom: 0; }
  .field-steps li { margin-bottom: var(--space-4); line-height: 1.65; padding-left: .25rem; }
  .field-steps li::marker { color: var(--accent-gold); font-weight: 700; }
  .order-note { align-self: start; background: var(--bg-surface); border-radius: var(--radius-md); padding: var(--space-6); }
  .order-note ul { padding-left: 1.2rem; }
  .order-note li { margin-bottom: var(--space-3); line-height: 1.55; }
  .order-note p { color: var(--text-muted); font-size: var(--text-sm); margin-bottom: 0; }
  .faq-section details { border-top: 1px solid var(--border-subtle); padding: var(--space-4) 0; }
  .faq-section details:last-child { border-bottom: 1px solid var(--border-subtle); }
  .faq-section summary { cursor: pointer; color: var(--text-primary); font-weight: 700; }
  .faq-section details p { margin: var(--space-3) 0 0; }
  .source-note { padding: var(--space-6); font-size: var(--text-sm); }
  .source-note h2 { font-size: var(--text-lg); }
  .source-note p { margin-bottom: 0; }
  @media (max-width: 900px) { .diagram-layout, .split-section { grid-template-columns: 1fr; } .choice-grid { grid-template-columns: 1fr; } .worked-math { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .worked-math { grid-template-columns: 1fr; } .stone-field-guide { padding: var(--space-8) 0; } }
</style>
