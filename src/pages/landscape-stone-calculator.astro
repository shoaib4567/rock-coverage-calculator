---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import LandscapeStoneCalculator from '../components/calculators/LandscapeStoneCalculator.astro';
import LandscapeStoneVisualizer from '../components/visualizers/LandscapeStoneVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Material Calculators', url: '/landscape-rock-calculator' },
  { name: 'Landscape Stone Calculator', url: '/landscape-stone-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Structural Landscape Stone' },
  { label: 'Aggregate Type', value: 'Crushed Base, #57 Clean, and DGA Fines' },
  { label: 'Standard Specification', value: 'AASHTO M147 and ASTM D448' },
  { label: 'Bulk Density', value: '1.40 to 1.50 Tons/yd³ (ASTM C29)' }
];

const quickStats = [
  { value: '1.40 t/yd³', label: 'Crushed Limestone', desc: 'Standard bulk density for clean fractured angular aggregate' },
  { value: '20% Overage', label: 'Compacted Base', desc: 'Volume compaction allowance for vehicular driveway and patio sub-base' },
  { value: '77 sq ft', label: 'Coverage at 3"', desc: 'Standard square foot yield per ton of uncompacted structural stone' }
];

const faqItems = [
  {
    q: 'What is the structural difference between landscape rock and landscape stone?',
    a: 'Landscape rock refers to loose decorative aggregates (such as smooth river rock, volcanic lava, or marble chips) used for garden mulch and weed suppression. Landscape stone designates mechanically crushed angular aggregates (such as #57 limestone, crusher run, or road base) used for load-bearing sub-bases, driveways, and compacted structural foundations.'
  },
  {
    q: 'How many tons of crushed stone do I need for a 20x20 patio sub-base?',
    a: 'A 20x20 foot patio equals 400 square feet. A standard pedestrian patio requires a 4-inch compacted sub-base of crushed stone (#411 or crusher run). At 4 inches, net loose volume is 4.94 cubic yards. Accounting for a 20 percent mechanical compaction factor under a plate tamper, order 5.93 cubic yards, which equates to approximately 8.9 tons of stone.'
  },
  {
    q: 'What is the difference between clean crushed stone and dense graded stone with fines?',
    a: 'Clean crushed stone (such as ASTM D448 #57) has all stone dust washed away, creating open void spaces for rapid drainage in French drains and driveway topcoats. Dense graded aggregate (AASHTO M147 crusher run or quarry process) contains a continuum of particle sizes down to stone flour that locks together into a rigid, non-shifting foundation when rolled.'
  },
  {
    q: 'How much does a cubic yard of 3/4 inch landscape stone weigh?',
    a: 'A cubic yard of dry 3/4-inch crushed landscape stone weighs approximately 2,800 pounds (1.40 tons) per ASTM C29 loose stockpile testing. Rainwater absorption in outdoor quarry stockpiles can increase delivery ticket scale weight to 2,950 pounds (1.48 tons) per cubic yard.'
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'How Much Rock Do I Need? (Intent Hub)', slug: '/how-much-rock-do-i-need', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Landscape Rock Calculator (Decorative)', slug: '/landscape-rock-calculator', badge: '1.30 t/yd³' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: '1.40 t/yd³' },
  { title: 'Crusher Run Calculator (Road Base)', slug: '/crusher-run-calculator', badge: '1.45 t/yd³' }
];

const bridgeLinks = [
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Yardage' },
  { title: 'Crushed Stone Tons Calculator', slug: '/crushed-stone-tons-calculator', badge: 'Tons Solver' }
];

const supportGuides = [
  { title: 'Angular vs Rounded Aggregate', slug: '/angular-vs-rounded-rock', badge: 'Geotech Guide' },
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Gravel Size Chart Explained', slug: '/gravel-sizes', badge: 'AASHTO M43' }
];
---

<BaseLayout
  title="Landscape Stone Calculator - Structural Base, Crushed Stone & Compaction"
  description="Calculate cubic yards and scale tons of structural landscape stone, road base, and crushed aggregate. Sizing guides for 3/4 inch stone, patio sub-base, and compaction factors."
  canonicalPath="/landscape-stone-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Landscape Stone Calculator",
      "url": "https://rockcoveragecalculator.com/landscape-stone-calculator",
      "description": "Calculates structural crushed landscape stone volume, compaction factors, and quarry scale tonnage for sub-bases and driveways.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Civil Contractors, Paving Installers, Estimators, Homeowners"
      },
      "about": {
        "@type": "Thing",
        "name": "Structural Crushed Stone and Compaction Calculations"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Landscape Stone Calculator"
      highlightWord="Calculator"
      badge="Structural Base & Crushed Stone Engine"
      subtitle="Accurate volumetric, tonnage, and mechanical compaction estimations for crushed limestone, blue granite, driveway road base, and patio subgrades."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <LandscapeStoneCalculator />

    <LandscapeStoneVisualizer />

    <!-- Technical Guide on Landscape Stone -->
    <article class="content-guide-section">
      <div class="container">

        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="Structural Landscape Stone Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">Structural Stone Sizing Reference</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Loose Volume Formula</span>
              <span class="aeo-quick-value">Yards = (Area [sq ft] × Depth [in]) / 324</span>
              <p class="aeo-quick-desc">Net uncompacted volume required before tamping or rolling.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Compacted Base Factor</span>
              <span class="aeo-quick-value">Order Volume = Loose Yards × 1.20</span>
              <p class="aeo-quick-desc">Dense graded stone (crusher run/DGA) loses 15-20% under plate compactor.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Quarry Scale Weight</span>
              <span class="aeo-quick-value">Tons = Compacted Yards × 1.45 t/yd³</span>
              <p class="aeo-quick-desc">Standard bulk density per ASTM C29 for crushed limestone with fines.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Subgrade Lift Rule</span>
              <span class="aeo-quick-value">Max 2 to 3 Inches per Lift</span>
              <p class="aeo-quick-desc">Compact in successive thin lifts for uniform subgrade bearing capacity.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>Crushed Stone Mechanics: Angular Interlock vs Compaction</h2>
          <p>
            In the aggregate and heavy civil industry, <strong>Landscape Stone</strong> designates mechanically crushed sedimentary or igneous bedrock processed through primary jaw crushers and secondary cone crushers. This manufacturing process produces sharply fractured, multifaceted stone particles that behave fundamentally differently than smooth alluvial gravel.
          </p>

          <div class="formula-box">
            <code>Loose Quarry Volume = [Area (sq ft) × Installed Depth (inches)] / 324</code>
            <br />
            <code>Compacted Base Order = Loose Volume × 1.20 (20% Mechanical Compaction Factor)</code>
          </div>

          <h3>Sieve Classifications for Structural Landscape Stones</h3>
          <p>
            Quarries categorize crushed landscape stone according to standard ASTM and AASHTO sieve sizes. Selecting the correct fraction ensures appropriate stability and drainage for your specific application:
          </p>
          <ul>
            <li><strong>ASTM D448 #57 Crushed Stone (1/2" to 1"):</strong> The universal standard for clean drainage stone, driveway topping, and foundation border beds. Retains open void spaces for rapid drainage.</li>
            <li><strong>ASTM D448 #8 Stone (3/8" Pea Crushed Chips):</strong> Excellent for walking paths, between flagstone pavers, and garden seating areas. Easy to wheelbarrow and level with a landscape rake.</li>
            <li><strong>AASHTO M147 Crusher Run / DGA (3/4" down to dust):</strong> Dense-graded aggregate with fines. When compacted with a vibratory plate compactor, the stone dust fills all voids, creating an impermeable solid pavement base.</li>
          </ul>

          <div class="table-wrapper">
            <table class="guide-table">
              <thead>
                <tr>
                  <th>Installed Depth</th>
                  <th>Sq Ft per Cubic Yard</th>
                  <th>Sq Ft per Ton (Clean 3/4")</th>
                  <th>Sq Ft per Ton (Compacted Base)</th>
                  <th>Primary Field Application</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>1.0 inch</td><td>324 sq ft</td><td>231 sq ft</td><td>192 sq ft</td><td>Top dressing existing walkways</td></tr>
                <tr><td>2.0 inches</td><td>162 sq ft</td><td>116 sq ft</td><td>96 sq ft</td><td>Pedestrian pathways and garden beds</td></tr>
                <tr><td>3.0 inches</td><td>108 sq ft</td><td>77 sq ft</td><td>64 sq ft</td><td>Standard residential landscape coverage</td></tr>
                <tr><td>4.0 inches</td><td>81 sq ft</td><td>58 sq ft</td><td>48 sq ft</td><td>Patio and walkway sub-base layer</td></tr>
                <tr><td>6.0 inches</td><td>54 sq ft</td><td>39 sq ft</td><td>32 sq ft</td><td>Driveway base course and heavy parking</td></tr>
              </tbody>
            </table>
          </div>

          <h3>How to Build a Non-Shifting Crushed Stone Pathway</h3>
          <ol class="steps-list">
            <li>
              <strong>Trenching:</strong> Excavate the pathway 4 inches below adjacent turf. Crown the subgrade center slightly so water sheds to the edges.
            </li>
            <li>
              <strong>Geotextile Foundation:</strong> Lay a non-woven 4 oz polypropylene geotextile fabric. Pin edges securely with sod staples.
            </li>
            <li>
              <strong>Base Compaction:</strong> Install 2.5 inches of AASHTO M147 dense-graded road base. Moisten lightly with a hose and compact with a gas plate compactor until completely firm.
            </li>
            <li>
              <strong>Clean Stone Wearing Course:</strong> Spread a 1.5-inch wearing surface of clean #8 or #57 crushed limestone. Rake smooth. The clean stones bite into the dense base, providing a firm surface that does not rut under foot traffic.
            </li>
          </ol>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Landscape Stone</h2>
          <div class="faq-accordion">
            {faqItems.map((item, index) => (
              <details class="faq-detail" open={index === 0}>
                <summary class="faq-summary">
                  <span>{item.q}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </article>

    <TopicClusterNav 
      currentPage="/landscape-stone-calculator" 
      category="material"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</BaseLayout>

<style>
  .content-guide-section {
    padding: var(--space-12) 0;
    background: var(--bg-body);
  }

  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }

  .aeo-quick-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--accent-gold);
  }

  .aeo-quick-title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .aeo-quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .aeo-quick-item {
    background: var(--bg-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .aeo-quick-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-gold);
    margin-bottom: 2px;
  }

  .aeo-quick-value {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .aeo-quick-desc {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.35;
  }

  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .content-card h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .content-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: var(--space-6) 0 var(--space-3) 0;
  }

  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin: var(--space-6) 0;
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .guide-table th, .guide-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-table th {
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 700;
  }

  .guide-table tr:hover td {
    background: rgba(212, 168, 83, 0.04);
  }

  .steps-list {
    padding-left: var(--space-6);
    margin: var(--space-4) 0;
  }

  .steps-list li {
    margin-bottom: var(--space-3);
  }

  .faq-detail {
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--space-4) 0;
  }

  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary svg {
    transition: transform var(--transition-fast);
  }

  .faq-detail[open] .faq-summary svg {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
