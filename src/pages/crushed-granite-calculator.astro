  <script>
    const graniteModes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="granite-mode"]'));
    const graniteDimensions = document.getElementById('granite-dimensions-fields') as HTMLElement;
    const graniteAreaFields = document.getElementById('granite-area-fields') as HTMLElement;
    const graniteInputs = ['granite-length', 'granite-width', 'granite-area', 'granite-depth', 'granite-extra', 'granite-weight'].reduce((items, id) => {
      items[id] = document.getElementById(id) as HTMLInputElement;
      return items;
    }, {} as Record<string, HTMLInputElement>);
    const graniteOutput = (id: string, value: string) => {
      const element = document.getElementById(id);
      if (element) element.textContent = value;
    };
    const graniteRead = (id: string, min: number, max: number = Infinity) => {
      const field = graniteInputs[id];
      const value = Number(field.value);
      const valid = field.value.trim() !== '' && Number.isFinite(value) && value >= min && value <= max;
      field.setAttribute('aria-invalid', String(!valid));
      return valid ? value : null;
    };
    function updateGranite() {
      const mode = graniteModes.find(input => input.checked)?.value || 'dimensions';
      graniteDimensions.hidden = mode !== 'dimensions';
      graniteAreaFields.hidden = mode !== 'area';
      graniteInputs['granite-length'].removeAttribute('aria-invalid');
      graniteInputs['granite-width'].removeAttribute('aria-invalid');
      graniteInputs['granite-area'].removeAttribute('aria-invalid');
      const length = mode === 'dimensions' ? graniteRead('granite-length', 0.01) : null;
      const width = mode === 'dimensions' ? graniteRead('granite-width', 0.01) : null;
      const enteredArea = mode === 'area' ? graniteRead('granite-area', 0.01) : null;
      const area = mode === 'dimensions' && length !== null && width !== null ? length * width : enteredArea;
      const depth = graniteRead('granite-depth', 0.25, 24);
      const extra = graniteRead('granite-extra', 0, 100);
      const weight = graniteRead('granite-weight', 500, 5000);
      const error = document.getElementById('granite-error') as HTMLElement;
      const volumeValid = area !== null && Number.isFinite(area) && area > 0 && depth !== null && extra !== null;
      error.hidden = volumeValid && weight !== null;
      error.textContent = !volumeValid ? 'Enter a positive area, a finished depth from 0.25 to 24 inches, and an order extra from 0 to 100%.' : weight === null ? 'Enter a supplier loose bulk weight from 500 to 5,000 lb per cubic yard to estimate tons.' : '';
      if (!volumeValid) {
        ['granite-installed-yards', 'granite-installed-cuft', 'granite-result-area', 'granite-result-depth', 'granite-order-yards', 'granite-order-tons', 'granite-yard-coverage', 'granite-ton-coverage'].forEach(id => graniteOutput(id, '—'));
        return;
      }
      const installedCubicFeet = area * depth / 12;
      const installedYards = installedCubicFeet / 27;
      const orderYards = installedYards * (1 + extra / 100);
      const yardCoverage = 324 / depth;
      graniteOutput('granite-installed-yards', installedYards.toFixed(2));
      graniteOutput('granite-installed-cuft', installedCubicFeet.toFixed(2));
      graniteOutput('granite-result-area', area.toLocaleString(undefined, { maximumFractionDigits: 2 }));
      graniteOutput('granite-result-depth', String(depth));
      graniteOutput('granite-order-yards', orderYards.toFixed(2) + ' cu yd');
      graniteOutput('granite-yard-coverage', yardCoverage.toFixed(0) + ' sq ft');
      graniteOutput('granite-order-tons', weight === null ? '—' : (orderYards * weight / 2000).toFixed(2) + ' US tons');
      graniteOutput('granite-ton-coverage', weight === null ? '—' : (yardCoverage * 2000 / weight).toFixed(0) + ' sq ft');
    }
    graniteModes.forEach(input => input.addEventListener('change', updateGranite));
    Object.values(graniteInputs).forEach(input => input.addEventListener('input', updateGranite));
    updateGranite();
  </script>
</BaseLayout>

