---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'River Rock Bag Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'River Rock Calculator', url: '/river-rock-calculator' },
  { name: pageTitle, url: '/river-rock-bag-calculator' }
];
const entityTags = [
  { label: 'Measure', value: 'Bed area × installed depth' },
  { label: 'Check the label', value: 'Bag volume and bag weight' },
  { label: 'Order', value: 'Whole bags, cost, and carrying weight' }
];
const faqItems = [
  {
    q: 'How many bags of river rock cover a 10 × 10 ft bed?',
    a: 'At 3 inches deep, the bed needs 25 cubic feet of installed stone. Divide by 0.5 cubic feet per bag and round up: 50 bags without extra, or 55 bags with a 10% ordering allowance. Change the bag-volume field if your product is a different size.'
  },
  {
    q: 'How much area does one 0.5 cubic foot bag cover?',
    a: 'By volume, one 0.5 cubic foot bag covers 3 square feet at 2 inches deep, 2 square feet at 3 inches, or 1.5 square feet at 4 inches. Actual appearance depends on the stone size, shape, and how evenly it is spread.'
  },
  {
    q: 'How many half-cubic-foot bags equal one cubic yard?',
    a: 'One cubic yard contains 27 cubic feet, so it has the same loose volume as 54 bags labeled 0.5 cubic feet. This is a volume conversion, not a promise that 54 bags weigh the same as a supplier’s cubic yard of a different product.'
  },
  {
    q: 'Can I calculate bags from a 40, 44, or 50 lb label?',
    a: 'Use the package’s cubic-foot volume or stated coverage for the bag count. Pounds describe weight, not a fixed volume: river rock products labeled 0.5 cubic feet can have different listed weights. Enter the labeled weight only to estimate hauling load.'
  },
  {
    q: 'When is loose bulk river rock cheaper than bags?',
    a: 'There is no universal bag-count cutoff. Compare your rounded-up bag purchase with a quote for the same stone, including the supplier’s minimum order and delivery charge. Bags may be easier to place in a narrow yard even when their material cost is higher.'
  }
];
const upLinks = [
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: 'Material' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'All Stone' },
  { title: 'Rock Coverage Chart', slug: '/rock-coverage-chart', badge: 'Reference' }
];
const lateralLinks = [
  { title: 'River Rock Tons Calculator', slug: '/river-rock-tons-calculator', badge: 'Tons' },
  { title: 'River Rock Cubic Yard Calculator', slug: '/river-rock-cubic-yard-calculator', badge: 'Yards' },
  { title: 'Pea Gravel Bag Calculator', slug: '/pea-gravel-bag-calculator', badge: 'Pea Gravel' }
];
const bridgeLinks = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Buying' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth' },
  { title: 'Dry Creek Bed Guide', slug: '/dry-creek-bed', badge: 'Project' }
];
const supportGuides = [
  { title: 'Rock Bag Weight and Price Guide', slug: '/rock-bag-weight-and-price-guide', badge: 'Hauling' },
  { title: 'How to Install Landscape Rock', slug: '/how-to-install-landscape-rock', badge: 'Install' },
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Bulk Weight' }
];
---

<BaseLayout
  title={pageTitle}
  description="Calculate whole bags of river rock from bed area, depth, package volume, and extra allowance. Check bag weight, cost, and a local bulk-delivery quote."
  canonicalPath="/river-rock-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": pageTitle,
      "url": "https://rockcoveragecalculator.com/river-rock-bag-calculator",
      "description": "Estimates whole river rock bags, purchased volume, carrying weight, and cost using the package label and project dimensions.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main id="main-content">
    <PageHero
      title={pageTitle}
      highlightWord="Bag"
      badge="Bagged stone shopping planner"
      subtitle="A 10 × 10 ft bed at 3 in deep takes 50 half-cubic-foot bags; allow 10% extra and the order becomes 55. One bag covers about 2 sq ft at that depth. Enter the volume printed on your bag for a count you can take to the store."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      theme="decorative"
    />

    <section class="bag-tool-section" id="bag-tool" aria-labelledby="bag-tool-heading">
      <div class="container">
        <div class="tool-intro">
          <div>
            <p class="eyebrow">Plan your purchase</p>
            <h2 id="bag-tool-heading">Count whole bags for your actual product</h2>
          </div>
          <p>Volume gives the bag count. The weight and price on your store's label turn that count into a loading and budget estimate.</p>
        </div>
        <div class="calc-wrapper">
          <div class="calc-panel">
            <h3>1. Measure the stone-covered area</h3>
            <fieldset class="area-choice">
              <legend>How do you know the area?</legend>
              <label><input type="radio" name="rrb-area-mode" value="rectangle" checked /> Length × width</label>
              <label><input type="radio" name="rrb-area-mode" value="known" /> I know the square feet</label>
            </fieldset>
            <div class="dim-grid" id="rrb-rectangle-fields">
              <div class="input-field">
                <label for="rrb-length">Length (ft)</label>
                <input type="number" id="rrb-length" value="10" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="rrb-width">Average width (ft)</label>
                <input type="number" id="rrb-width" value="10" min="0.01" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="dim-grid" id="rrb-known-fields" hidden>
              <div class="input-field">
                <label for="rrb-area">Measured area (sq ft)</label>
                <input type="number" id="rrb-area" value="100" min="0.01" step="any" inputmode="decimal" />
              </div>
            </div>
            <div class="dim-grid">
              <div class="input-field">
                <label for="rrb-depth">Installed depth (in)</label>
                <input type="number" id="rrb-depth" value="3" min="0.1" max="24" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="rrb-extra">Extra to order (%)</label>
                <input type="number" id="rrb-extra" value="10" min="0" max="100" step="any" inputmode="decimal" />
              </div>
            </div>
            <h3>2. Copy your bag label</h3>
            <div class="dim-grid">
              <div class="input-field">
                <label for="rrb-bag-volume">Volume per bag (cu ft)</label>
                <input type="number" id="rrb-bag-volume" value="0.5" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="rrb-bag-weight">Labeled weight per bag (lb, optional)</label>
                <input type="number" id="rrb-bag-weight" value="50" min="0.01" step="any" inputmode="decimal" />
              </div>
              <div class="input-field">
                <label for="rrb-bag-price">Store price per bag ($)</label>
                <input type="number" id="rrb-bag-price" placeholder="Optional" min="0" step="any" inputmode="decimal" />
              </div>
            </div>
            <p class="tool-note">The 0.5 cu ft and 50 lb values are examples from one retail product. Other half-cubic-foot river rock bags list 40 or 44 lb; use the package you will buy.</p>
            <details class="quote-fields">
              <summary>Compare a loose bulk quote <span>optional</span></summary>
              <p>Enter a quote for comparable river rock. Include any delivery minimum so the comparison reflects what the supplier will charge.</p>
              <div class="dim-grid">
                <div class="input-field">
                  <label for="rrb-bulk-price">Bulk price per cubic yard ($)</label>
                  <input type="number" id="rrb-bulk-price" placeholder="Supplier quote" min="0" step="any" inputmode="decimal" />
                </div>
                <div class="input-field">
                  <label for="rrb-delivery">Delivery charge ($, optional)</label>
                  <input type="number" id="rrb-delivery" placeholder="Blank means $0" min="0" step="any" inputmode="decimal" />
                </div>
                <div class="input-field">
                  <label for="rrb-minimum">Minimum billable yards</label>
                  <input type="number" id="rrb-minimum" placeholder="0 if none" min="0" step="any" inputmode="decimal" />
                </div>
                <div class="input-field">
                  <label for="rrb-increment">Supplier selling increment</label>
                  <select id="rrb-increment">
                    <option value="0">Exact quoted yards</option>
                    <option value="0.25">Next ¼ yd³</option>
                    <option value="0.5">Next ½ yd³</option>
                    <option value="1">Next whole yd³</option>
                  </select>
                </div>
              </div>
            </details>
            <p class="input-error" id="rrb-error" role="alert" hidden></p>
          </div>

          <div class="calc-results-panel" aria-live="polite" aria-atomic="true">
            <h3>Your bag list</h3>
            <div class="kpi-grid">
              <div class="kpi-card kpi-hero">
                <div class="kpi-value" id="rrb-bags">55</div>
                <div class="kpi-label">Whole bags to buy</div>
                <div class="kpi-subtext" id="rrb-bought-volume">27.5 cu ft in purchased bags</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="rrb-coverage">2</div>
                <div class="kpi-label">Sq ft covered per bag</div>
                <div class="kpi-subtext" id="rrb-coverage-depth">At 3 in installed depth</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="rrb-weight">2,750 lb</div>
                <div class="kpi-label">Estimated bags to carry</div>
                <div class="kpi-subtext">Bag count × labeled weight, if provided</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="rrb-cost">—</div>
                <div class="kpi-label">Bag purchase estimate</div>
                <div class="kpi-subtext">Before tax or transport</div>
              </div>
            </div>
            <div class="result-explainer" id="rrb-breakdown">
              <strong>How the count is built</strong>
              <p id="rrb-volume-line">100 sq ft × 3 in ÷ 12 = 25 cu ft installed. Add 10% = 27.5 cu ft to order (1.02 cu yd).</p>
              <p id="rrb-rounding-line">27.5 cu ft ÷ 0.5 cu ft per bag = 55; buy 55 whole bags.</p>
            </div>
            <div class="quote-result" id="rrb-quote-result">
              <strong>Bulk comparison</strong>
              <p id="rrb-quote-text">Enter a store bag price and a local bulk quote to compare delivered material costs.</p>
            </div>
            <p class="result-caution">Before loading, check bag weight plus passengers and gear against your vehicle's tire and loading label. This result does not set a safe vehicle load.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="bag-guide">
      <div class="container">
        <nav class="guide-jumps" aria-label="On this page">
          <strong>Shop with confidence</strong>
          <a href="#bag-label">Read the bag</a>
          <a href="#bag-depth">Set the depth</a>
          <a href="#bag-order">Check the order</a>
          <a href="#bag-faq">Questions</a>
        </nav>

        <section class="guide-panel label-panel" id="bag-label">
          <div>
            <p class="eyebrow">The package matters</p>
            <h2>Use cubic feet for quantity, pounds for hauling</h2>
            <p>A bag is a container, not a standard measure of stone. For a volume-labeled product, divide the stone volume your bed needs by the dry volume printed on the package, then round <em>up</em> to a whole bag. A 0.5 cu ft bag is common, but the calculator lets you replace it.</p>
            <p>Do not turn a weight-only label into cubic feet using a universal “pounds per bag” rule. Even half-cubic-foot products differ: <a href="https://www.homedepot.com/p/100558618" target="_blank" rel="noopener noreferrer">Vigoro river pebbles list 50 lb</a>, <a href="https://www.lowes.com/pd/0-5-cu-ft-44-lb-Brown-River-Rock/3087183" target="_blank" rel="noopener noreferrer">Lowe's DecoRock lists 44 lb</a>, and <a href="https://www.homedepot.com/p/302985371" target="_blank" rel="noopener noreferrer">Vigoro creek rock lists 40 lb</a>. If only weight is shown, use the maker's stated coverage or ask for the packaged volume.</p>
          </div>
          <figure>
            <img src="/river-rock-bag-coverage.svg" width="840" height="520" loading="lazy" alt="One half-cubic-foot river rock bag spread at different depths: 3 square feet at 2 inches, 2 square feet at 3 inches, and 1.5 square feet at 4 inches." />
            <figcaption><span class="mobile-figure-hint">Swipe to read the diagram. </span>Equal bag volume covers less area as the layer gets deeper. The drawn stones illustrate coverage, not a prescribed stone size.</figcaption>
          </figure>
        </section>

        <section class="guide-panel" id="bag-depth">
          <p class="eyebrow">Depth changes the shopping list</p>
          <h2>Choose a finished layer before buying bags</h2>
          <p>For a decorative inorganic mulch, <a href="https://extension.usu.edu/cwel/principles" target="_blank" rel="noopener noreferrer">Utah State University Extension suggests 2–3 inches</a>. Treat that as a starting point, not a promise that every stone size will hide the ground at the same depth. Spread a small sample at the intended depth; larger mixed river stones can leave visible gaps and rounded stones move more readily on slopes and walked paths.</p>
          <div class="table-wrap">
            <table>
              <caption>Volume-based coverage for a bag labeled 0.5 cu ft, before extra</caption>
              <thead><tr><th scope="col">Installed depth</th><th scope="col">One bag covers</th><th scope="col">Bags for 100 sq ft</th></tr></thead>
              <tbody>
                <tr><th scope="row">2 in</th><td>3 sq ft</td><td>34</td></tr>
                <tr><th scope="row">3 in</th><td>2 sq ft</td><td>50</td></tr>
                <tr><th scope="row">4 in</th><td>1.5 sq ft</td><td>67</td></tr>
              </tbody>
            </table>
          </div>
          <p class="small-note">The 4-inch row illustrates how the math changes for a deeper layer; it is not a blanket recommendation. The bag count rounds up to whole bags. Add extra only after calculating installed volume.</p>
        </section>

        <section class="guide-panel" id="bag-order">
          <p class="eyebrow">From estimate to pickup</p>
          <h2>Three checks that prevent a second trip</h2>
          <div class="check-grid">
            <div><span>01</span><h3>Measure the area the stones touch</h3><p>For a rectangle, multiply length by average width. For curves, split the bed into simple sections, add their areas, then use “I know the square feet.” Exclude large planters or paving that will stay uncovered.</p></div>
            <div><span>02</span><h3>Match the product and the quote</h3><p>Compare bag and bulk costs for a similar size and color of river rock. Bulk may have a minimum billable order and a delivery fee. The calculator uses your entered prices; it does not assume a universal break-even point.</p></div>
            <div><span>03</span><h3>Plan the weight before pickup</h3><p>Multiply whole bags by the weight on your chosen product. Check the “occupants and cargo” limit on the vehicle's doorjamb label, then account for people and other cargo. <a href="https://www.nhtsa.gov/vehicle-safety/tires" target="_blank" rel="noopener noreferrer">NHTSA shows where to find the tire and loading label</a>.</p></div>
          </div>
          <p>For a larger bed, use the <a href="/river-rock-calculator">river rock calculator</a> to compare yards and tons. If you are choosing between store bags and delivery, read the <a href="/bulk-vs-bagged-rock">bulk versus bagged guide</a>. River rock around plants can heat the soil and does not improve it; <a href="https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/mulching-for-soil-and-garden-health" target="_blank" rel="noopener noreferrer">University of Minnesota Extension</a> recommends considering that tradeoff.</p>
        </section>

        <section class="guide-panel" id="bag-faq">
          <h2>River rock bag questions</h2>
          <div class="faq-list">
            {faqItems.map(item => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </article>

    <TopicClusterNav
      currentPage="/river-rock-bag-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>
  <Footer />

  <script>
    const field = (id: string) => document.getElementById(id) as HTMLInputElement;
    const output = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    const numberText = (value: number, maximumFractionDigits = 2) =>
      value.toLocaleString('en-US', { maximumFractionDigits });
    const moneyText = (value: number) =>
      value.toLocaleString('en-US', { style: 'currency', currency: 'USD' });

    function updateBagEstimate() {
      const mode = (document.querySelector('input[name="rrb-area-mode"]:checked') as HTMLInputElement).value;
      const required = mode === 'known'
        ? ['rrb-area', 'rrb-depth', 'rrb-extra', 'rrb-bag-volume']
        : ['rrb-length', 'rrb-width', 'rrb-depth', 'rrb-extra', 'rrb-bag-volume'];
      const optional = ['rrb-bag-weight', 'rrb-bag-price', 'rrb-bulk-price', 'rrb-delivery', 'rrb-minimum'];
      const inactive = mode === 'known' ? ['rrb-length', 'rrb-width'] : ['rrb-area'];
      inactive.forEach(id => field(id).removeAttribute('aria-invalid'));
      const invalidRequired: string[] = [];
      const invalidOptional: string[] = [];
      for (const id of required) {
        const input = field(id);
        const value = Number(input.value);
        const valid = !input.validity.badInput && input.value.trim() !== '' && Number.isFinite(value) && value >= Number(input.min || 0) &&
          (!input.max || value <= Number(input.max));
        input.setAttribute('aria-invalid', String(!valid));
        if (!valid) invalidRequired.push(id);
      }
      for (const id of optional) {
        const input = field(id);
        const value = Number(input.value);
        const valid = !input.validity.badInput && (input.value.trim() === '' ||
          (Number.isFinite(value) && value >= Number(input.min || 0) && (!input.max || value <= Number(input.max))));
        input.setAttribute('aria-invalid', String(!valid));
        if (!valid) invalidOptional.push(id);
      }
      const error = document.getElementById('rrb-error') as HTMLElement;
      const invalidFields = [...invalidRequired, ...invalidOptional];
      error.textContent = invalidFields.length ? 'Enter a valid number for: ' + invalidFields.map(id =>
        document.querySelector('label[for="' + id + '"]')?.textContent || id).join('; ') + '.' : '';
      error.hidden = invalidFields.length === 0;
      if (invalidRequired.length) {
        ['rrb-bags', 'rrb-coverage', 'rrb-weight', 'rrb-cost'].forEach(id => output(id, '—'));
        output('rrb-bought-volume', '');
        output('rrb-coverage-depth', '');
        output('rrb-volume-line', 'Correct the highlighted input to see the volume.');
        output('rrb-rounding-line', '');
        output('rrb-quote-text', 'Correct the input to compare costs.');
        return;
      }

      const area = mode === 'known' ? Number(field('rrb-area').value) :
        Number(field('rrb-length').value) * Number(field('rrb-width').value);
      const depth = Number(field('rrb-depth').value);
      const extra = Number(field('rrb-extra').value);
      const bagVolume = Number(field('rrb-bag-volume').value);
      const bagWeightRaw = field('rrb-bag-weight').value.trim();
      const installedVolume = area * depth / 12;
      const orderVolume = installedVolume * (1 + extra / 100);
      const bagCount = Math.ceil(orderVolume / bagVolume - 1e-10);
      const boughtVolume = bagCount * bagVolume;
      const yards = orderVolume / 27;

      output('rrb-bags', numberText(bagCount, 0));
      output('rrb-bought-volume', numberText(boughtVolume) + ' cu ft in purchased bags');
      output('rrb-coverage', numberText(bagVolume * 12 / depth));
      output('rrb-coverage-depth', 'At ' + numberText(depth) + ' in installed depth');
      output('rrb-weight', bagWeightRaw === '' || invalidOptional.includes('rrb-bag-weight')
        ? '—' : numberText(bagCount * Number(bagWeightRaw), 0) + ' lb');
      output('rrb-volume-line', numberText(area) + ' sq ft × ' + numberText(depth) + ' in ÷ 12 = ' +
        numberText(installedVolume) + ' cu ft installed. Add ' + numberText(extra) + '% = ' +
        numberText(orderVolume) + ' cu ft to order (' + numberText(yards) + ' cu yd).');
      output('rrb-rounding-line', numberText(orderVolume) + ' cu ft ÷ ' + numberText(bagVolume) +
        ' cu ft per bag = ' + numberText(orderVolume / bagVolume) + '; round up to ' +
        numberText(bagCount, 0) + ' whole bags.');

      const bagPriceRaw = field('rrb-bag-price').value.trim();
      const bulkPriceRaw = field('rrb-bulk-price').value.trim();
      const deliveryRaw = field('rrb-delivery').value.trim();
      const minimumRaw = field('rrb-minimum').value.trim();
      const invalidQuote = ['rrb-bulk-price', 'rrb-delivery', 'rrb-minimum'].some(id => invalidOptional.includes(id));
      if (invalidOptional.includes('rrb-bag-price')) {
        output('rrb-cost', '—');
        output('rrb-quote-text', 'Correct the highlighted store bag price to compare costs.');
        return;
      }
      if (bagPriceRaw === '') {
        output('rrb-cost', '—');
        output('rrb-quote-text', invalidQuote ? 'Correct the highlighted bulk quote field to compare costs.' :
          'Enter a store bag price and a local bulk quote to compare delivered material costs.');
        return;
      }
      const bagCost = bagCount * Number(bagPriceRaw);
      output('rrb-cost', moneyText(bagCost));
      if (invalidQuote) {
        output('rrb-quote-text', 'Correct the highlighted bulk quote field to compare costs.');
        return;
      }
      if (bulkPriceRaw === '') {
        output('rrb-quote-text', 'Bag estimate: ' + moneyText(bagCost) +
          '. Add a local bulk price per yard to compare your quotes; blank delivery counts as $0.');
        return;
      }
      const deliveryCharge = deliveryRaw === '' ? 0 : Number(deliveryRaw);
      const minimumYards = Math.max(yards, minimumRaw === '' ? 0 : Number(minimumRaw));
      const increment = Number((document.getElementById('rrb-increment') as HTMLSelectElement).value);
      const billableYards = increment > 0 ? Math.ceil((minimumYards - 1e-10) / increment) * increment : minimumYards;
      const bulkCost = billableYards * Number(bulkPriceRaw) + deliveryCharge;
      const difference = Math.abs(bagCost - bulkCost);
      const result = difference < 0.005 ? 'The two estimates are the same' :
        bagCost < bulkCost ? 'Bags estimate ' + moneyText(difference) + ' less' :
          'Bulk estimates ' + moneyText(difference) + ' less';
      output('rrb-quote-text', 'Bags ' + moneyText(bagCost) + ' vs bulk ' + moneyText(bulkCost) +
        ' (' + numberText(billableYards) + ' billable yd³, ' + moneyText(deliveryCharge) + ' delivery). ' + result +
        '. Confirm supplier minimums, tax, and the same stone grade.');
    }

    document.querySelectorAll('input[name="rrb-area-mode"]').forEach(input => {
      input.addEventListener('change', () => {
        const known = (input as HTMLInputElement).value === 'known' && (input as HTMLInputElement).checked;
        if (known) {
          const area = Number(field('rrb-length').value) * Number(field('rrb-width').value);
          if (Number.isFinite(area) && area > 0) field('rrb-area').value = String(area);
        }
        (document.getElementById('rrb-known-fields') as HTMLElement).hidden = !known;
        (document.getElementById('rrb-rectangle-fields') as HTMLElement).hidden = known;
        updateBagEstimate();
      });
    });
    document.querySelectorAll('#bag-tool input[type="number"]').forEach(input =>
      input.addEventListener('input', updateBagEstimate));
    document.getElementById('rrb-increment')?.addEventListener('change', updateBagEstimate);
    updateBagEstimate();
  </script>
</BaseLayout>

<style>
  .bag-tool-section, .bag-guide { padding: var(--space-10) 0; background: var(--bg-body); }
