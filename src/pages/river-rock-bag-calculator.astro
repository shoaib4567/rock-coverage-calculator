---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'River Rock Calculator', url: '/river-rock-calculator' },
  { name: 'River Rock Bag Calculator', url: '/river-rock-bag-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Bagged River Rock' },
  { label: 'Standard Bag Volume', value: '0.5 Cubic Feet per Bag' },
  { label: 'Average Bag Weight', value: '48 to 52 lbs per Bag' },
  { label: 'Yard Multiplier', value: '54 Bags = 1.0 Cubic Yard' }
];

const quickStats = [
  { value: '54 Bags', label: 'Per Cubic Yard', desc: 'Exact bag multiplier based on 27 cubic feet per yard' },
  { value: '2.0 sq ft', label: 'Yield at 3"', desc: 'Ground coverage per 0.5 cu ft bag at standard 3-inch bed depth' },
  { value: '20 Bags', label: 'Tipping Point', desc: 'Threshold where bulk quarry delivery becomes cheaper than retail bags' }
];

const faqItems = [
  {
    q: 'How many bags of river rock do I need for a 10x10 foot garden bed?',
    a: 'A 10x10 foot garden bed equals 100 square feet. At a recommended 3-inch depth for 1-3 inch river rock, you need 25 cubic feet of stone, which equals exactly 50 bags of 0.5 cubic feet each (approximately 2,500 lbs total weight).'
  },
  {
    q: 'How many bags of river rock are in a cubic yard?',
    a: 'There are exactly 54 bags of 0.5 cubic feet in one cubic yard (27 cubic feet / 0.5 cu ft = 54 bags). In terms of weight, 54 bags equal approximately 2,700 pounds (1.35 short tons).'
  },
  {
    q: 'How much does one bag of river rock cover?',
    a: 'One standard 0.5 cubic foot bag covers 3.0 square feet at 2 inches depth, 2.0 square feet at 3 inches depth, and 1.5 square feet at 4 inches depth.'
  },
  {
    q: 'When should I buy river rock in bulk instead of bags?',
    a: 'If your project requires 20 bags or more (over 10 cubic feet or 0.37 cubic yards), ordering bulk river rock from a local landscape yard or quarry saves between 40 and 60 percent on material costs, even after paying delivery fees.'
  }
];

const upLinks = [
  { title: 'River Rock Calculator (Material Parent)', slug: '/river-rock-calculator', badge: 'Material' },
  { title: 'Rock Bag Calculator (Unit Parent)', slug: '/rock-bag-calculator', badge: 'Unit' },
  { title: 'Rock Coverage Chart (Conversion Hub)', slug: '/rock-coverage-chart', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'River Rock Tons Calculator', slug: '/river-rock-tons-calculator', badge: 'Tons' },
  { title: 'River Rock Cubic Yard Calculator', slug: '/river-rock-cubic-yard-calculator', badge: 'Yards' },
  { title: 'Pea Gravel Bag Calculator', slug: '/pea-gravel-bag-calculator', badge: 'Pea Gravel' }
];

const bridgeLinks = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Dry Creek Bed Guide', slug: '/dry-creek-bed', badge: 'Drainage' }
];

const supportGuides = [
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="River Rock Bag Calculator - 0.5 Cu Ft Bag Sizing & Yields"
  metaDescription="Calculate exact 0.5 cu ft bags of river rock needed for landscaping beds, borders, and tree rings. Sizing formulas, coverage yields, and bulk cost analysis."
  canonicalPath="/river-rock-bag-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "River Rock Bag Calculator",
      "url": "https://rockcoveragecalculator.com/river-rock-bag-calculator",
      "description": "Calculates 0.5 cu ft retail bags of river rock needed based on area square footage and depth.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Homeowners, Gardeners, DIY Landscapers"
      },
      "about": {
        "@type": "Thing",
        "name": "Bagged River Rock Calculation"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="River Rock Bag Calculator"
      highlightWord="Bags"
      badge="Retail Bag Sizing Engine"
      subtitle="Calculate exact 0.5 cu ft bags of smooth river rock for flower beds, foundation borders, and garden accents."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <!-- Interactive River Rock Bag Calculator Tool -->
    <section class="section">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h3>River Rock Area Dimensions</h3>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="rrb-length">Length (Feet)</label>
              <input type="number" id="rrb-length" value="18" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="rrb-width">Width (Feet)</label>
              <input type="number" id="rrb-width" value="10" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="rrb-depth">Depth (Inches)</label>
              <input type="number" id="rrb-depth" value="3.0" min="1" max="12" step="0.5" />
            </div>
            <div class="input-field">
              <label for="rrb-price">Price per Bag ($)</label>
              <input type="number" id="rrb-price" value="5.25" min="1" step="0.25" />
            </div>
          </div>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h3>Required Material Totals</h3>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
              <div class="kpi-value" id="kpi-rrb-bags">0</div>
              <div class="kpi-label">0.5 Cu Ft Bags Needed</div>
              <div class="kpi-subtext" id="kpi-rrb-lbs">0 lbs total weight</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-rrb-yards">0.00</div>
              <div class="kpi-label">Volume (Cubic Yards)</div>
              <div class="kpi-subtext" id="kpi-rrb-cuft">0 cu ft</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-value" id="kpi-rrb-cost">$0.00</div>
              <div class="kpi-label">Estimated Material Cost</div>
              <div class="kpi-subtext" id="kpi-rrb-bulk-save">Bulk comparison</div>
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Guide on Bagged River Rock -->
    <article class="content-guide-section">
      <div class="container">

        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="River Rock Bag Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">River Rock Bag Reference</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Master Formula</span>
              <span class="aeo-quick-value">Bags = [Area (sq ft) × Depth (in) / 12] × 2</span>
              <p class="aeo-quick-desc">Converts cubic feet into 0.5 cu ft commercial retail bags.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Yield at 3"</span>
              <span class="aeo-quick-value">2.0 sq ft per Bag</span>
              <p class="aeo-quick-desc">Standard depth for 1-inch to 3-inch river stone mulch.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Bags per Yard</span>
              <span class="aeo-quick-value">54 Bags (27 cu ft)</span>
              <p class="aeo-quick-desc">Exact cubic yard volume equivalent for standard 0.5 cu ft bags.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Bulk Tipping Point</span>
              <span class="aeo-quick-value">20 Bags ($105 to $130)</span>
              <p class="aeo-quick-desc">Threshold where bulk quarry delivery becomes more economical.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>Sizing Retail Bags of River Rock</h2>
          <p>
            Standard retail bags of river rock sold at home improvement retailers (such as The Home Depot and Lowe's) hold <strong>0.5 cubic feet</strong> of material and weigh approximately <strong>50 pounds</strong>. Sizing your project accurately prevents multiple trips to the store:
          </p>

          <div class="formula-box">
            <code>Total Cubic Feet = [Length (ft) × Width (ft) × Depth (in)] / 12</code>
            <br />
            <code>Number of 0.5 cu ft Bags = Total Cubic Feet × 2</code>
          </div>

          <h3>Coverage per 0.5 Cu Ft Bag by Depth</h3>
          <ul>
            <li><strong>2.0 Inches Depth:</strong> Covers 3.0 sq ft per bag (small 3/8" to 3/4" pebbles).</li>
            <li><strong>3.0 Inches Depth:</strong> Covers 2.0 sq ft per bag (medium 1" to 3" river rock).</li>
            <li><strong>4.0 Inches Depth:</strong> Covers 1.5 sq ft per bag (large 3" to 5" river cobbles).</li>
          </ul>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions About Bagged River Rock</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </article>

    <TopicClusterNav
      currentPage="/river-rock-bag-calculator"
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateRRB() {
      const l = parseFloat((document.getElementById('rrb-length') as HTMLInputElement)?.value) || 0;
      const w = parseFloat((document.getElementById('rrb-width') as HTMLInputElement)?.value) || 0;
      const d = parseFloat((document.getElementById('rrb-depth') as HTMLInputElement)?.value) || 0;
      const price = parseFloat((document.getElementById('rrb-price') as HTMLInputElement)?.value) || 0;

      const cuft = (l * w * (d / 12));
      const bags = Math.ceil(cuft * 2);
      const yards = cuft / 27;
      const totalWeight = bags * 50;
      const totalCost = bags * price;

      const bEl = document.getElementById('kpi-rrb-bags');
      const yEl = document.getElementById('kpi-rrb-yards');
      const cEl = document.getElementById('kpi-rrb-cost');
      const lbsEl = document.getElementById('kpi-rrb-lbs');
      const cuftEl = document.getElementById('kpi-rrb-cuft');
      const saveEl = document.getElementById('kpi-rrb-bulk-save');

      if (bEl) bEl.innerText = bags.toLocaleString();
      if (yEl) yEl.innerText = yards.toFixed(2);
      if (cEl) cEl.innerText = '$' + totalCost.toFixed(2);
      if (lbsEl) lbsEl.innerText = totalWeight.toLocaleString() + ' lbs (~' + (totalWeight / 2000).toFixed(2) + ' tons)';
      if (cuftEl) cuftEl.innerText = cuft.toFixed(1) + ' cu ft net volume';

      if (saveEl) {
        if (bags >= 20) {
          const bulkCost = yards * 60 + 75; // $60/yd + $75 delivery
          const savings = totalCost - bulkCost;
          if (savings > 0) {
            saveEl.innerText = 'Bulk saves approx $' + Math.round(savings) + ' vs bags';
            saveEl.style.color = 'var(--accent-gold)';
          } else {
            saveEl.innerText = 'Bags are comparable in price';
            saveEl.style.color = 'var(--text-muted)';
          }
        } else {
          saveEl.innerText = 'Bags are more economical for this size';
          saveEl.style.color = 'var(--text-muted)';
        }
      }
    }

    ['rrb-length', 'rrb-width', 'rrb-depth', 'rrb-price'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateRRB);
    });
    updateRRB();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }
  .aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--accent-gold); }
  .aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .aeo-quick-item { background: var(--bg-surface); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); margin-bottom: 2px; }
  .aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .aeo-quick-desc { font-size: 11px; color: var(--text-muted); margin: 0; line-height: 1.35; }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .faq-card { margin-top: var(--space-8); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-item h3 { font-size: var(--text-base); color: var(--text-primary); margin: 0 0 var(--space-2) 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--text-muted); margin: 0; }
</style>
