---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import CivilStructuralBlock from '../components/intent/CivilStructuralBlock.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Riprap Calculator', url: '/riprap-calculator' }
];

const entityTags = [{"label":"Thickness","value":"Use the project detail"},{"label":"Product","value":"Confirm the actual gradation"},{"label":"Weight","value":"Example 1.40 US tons/yd³"}];

const quickStats = [{"value":"Measured surface","label":"Area","desc":"Include the slope surface"},{"value":"Specified layer","label":"Thickness","desc":"Not selected by this tool"},{"value":"Supplier input","label":"Order check","desc":"Confirm weight and delivery"}];

const faqItems = [
  {
    "q": "How many tons cover a 15 × 20 ft apron?",
    "a": "If the selected detail requires 12 inches, the measured volume is 11.11 yd³. With 10% extra and an example 1.40 tons per yard, the order estimate is 17.11 US short tons. Confirm thickness and product weight independently."
  },
  {
    "q": "What thickness should riprap be?",
    "a": "Use the applicable design and stone grading. This quantity tool cannot select armor thickness or size for a particular flow, slope or shoreline."
  },
  {
    "q": "Is fabric always required?",
    "a": "Use the specified filter and bedding detail. Granular filters, geotextiles and combinations serve different situations; there is no one fabric specification for every site."
  },
  {
    "q": "What do Class 1 and Class 2 mean?",
    "a": "They are agency or supplier designations whose gradation limits vary. Obtain the actual specification rather than assuming the class name sets a universal stone size."
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'How Much Rock Do I Need? (Intent Hub)', slug: '/how-much-rock-do-i-need', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: '1.40 t/yd³' },
  { title: 'Drain Rock Calculator', slug: '/drain-rock-calculator', badge: '1.35 t/yd³' },
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: '1.35 t/yd³' }
];

const bridgeLinks = [
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Coverage Calculator Yard', slug: '/rock-coverage-calculator-yard', badge: 'Volume' },
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Truckloads' }
];

const supportGuides = [
  { title: 'Dry Creek Bed Guide', slug: '/dry-creek-bed', badge: 'Drainage Design' },
  { title: '#57 Stone Size Guide', slug: '/57-stone-size-guide', badge: 'ASTM D448' },
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' }
];
---

<BaseLayout
  title="Riprap & Armor Rock Coverage Calculator - Class 1 & 2 Tonnage & Yards"
  metaDescription="Calculate cubic yards, scale tons, and coverage of rip rap rock and armor stone for erosion control. Sizing for culvert aprons, steep bank stabilization, and ponds."
  canonicalPath="/riprap-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Riprap & Armor Rock Coverage Calculator",
      "url": "https://rockcoveragecalculator.com/riprap-calculator",
      "description": "Calculates Class 1 and Class 2 riprap and armor rock coverage, cubic yards, and quarry tonnage for erosion control and civil drainage.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Civil Engineers, Drainage Contractors, Excavators, Estimators"
      },
      "about": {
        "@type": "Thing",
        "name": "Riprap Rock Coverage"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main id="main-content">
    <PageHero
      title="Riprap & Armor Rock Coverage Calculator"
      highlightWord="Rock Coverage"
      badge="Heavy Civil Erosion Control Engine"
      subtitle="Estimate riprap volume and example tonnage from the surface and thickness specified for your project."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
      theme="civil"
    />

    <!-- Interactive Riprap Calculator Tool -->
    <section class="section">
      <div class="container">
        <div class="calc-wrapper">
          <!-- LEFT: Input Panel -->
          <div class="calc-panel animate-fade-in-up">
            <div class="calc-panel-title">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
            <h2>Riprap Embankment Dimensions</h2>
          </div>

          <div class="dim-grid">
            <div class="input-field">
              <label for="riprap-length">Length (Feet)</label>
              <input type="number" id="riprap-length" value="40" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="riprap-width">Slope Width (Feet)</label>
              <input type="number" id="riprap-width" value="15" min="1" step="0.5" />
            </div>
            <div class="input-field">
              <label for="riprap-depth">Layer Thickness (Inches)</label>
              <input type="number" id="riprap-depth" value="12.0" min="6" max="36" step="1" />
            </div>
            <div class="input-field">
              <label for="riprap-waste">Safety Buffer (%)</label>
              <input type="number" id="riprap-waste" value="10" min="0" max="25" step="1" />
            </div>
          </div>
          </div>

          <!-- RIGHT: Results Panel -->
          <div class="calc-results-panel animate-fade-in-up">
            <div class="calc-panel-title">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              <h2>Required Material Totals</h2>
            </div>

            <div class="kpi-grid">
              <div class="kpi-card highlight">
                <div class="kpi-value" id="kpi-riprap-yards">24.44</div>
                <div class="kpi-label">Volume (Cubic Yards)</div>
                <div class="kpi-subtext" id="kpi-riprap-cuft">660.0 cu ft (with 10% buffer)</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="kpi-riprap-tons">34.22</div>
                <div class="kpi-label">Scale Weight (Tons)</div>
                <div class="kpi-subtext">At 1.40 t/yd³ (2,800 lbs/yd³)</div>
              </div>
              <div class="kpi-card">
                <div class="kpi-value" id="kpi-riprap-loads">2.3</div>
                <div class="kpi-label">Example Truckloads</div>
                <div class="kpi-subtext">15-ton example; confirm payload</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Civil Truckload Logistics & Subgrade Stabilization Block -->
    <CivilStructuralBlock />

    <!-- Technical Guide on Riprap -->
    <article class="content-guide-section"><div class="container"><div class="content-card"><h2>Calculate quantity after selecting the armor detail</h2><p>Use the specified stone size, grading, filter or bedding and finished thickness for your project. Riprap class names and dimensions vary between agencies and products. This tool does not select a stone size for flow, waves, erosion or slope stability.</p><h2>Measure the surface receiving stone</h2><p>For a sloped bank, measure along the actual surface rather than using its horizontal plan width. Divide irregular areas into sections and add their volumes. For each section, cubic yards = length in feet × surface width in feet × thickness in inches ÷ 324. Estimate filter or bedding layers separately.</p><h2>A quantity example</h2><p>If the project detail calls for a 12-inch layer over a measured 15 × 20 ft surface, the installed volume is 11.11 yd³. Adding a selected 10% allowance gives 12.22 yd³. At an example loose bulk weight of 1.40 US short tons per yard, the order is about 17.11 tons. The 12-inch thickness is an example input, not a universal armor specification.</p><h2>Confirm the actual product</h2><p>Ask the supplier for the required gradation and a suitable loose weight conversion for that large-stone product. Do not use a fine-gravel weight or a broad riprap class name as certification. Individual stone weights, placement voids and handling can affect the delivered amount.</p><h2>Plan filter, placement and access</h2><p>A project may require a specified granular filter, geotextile, bedding or a combination. Use its detail rather than assuming one fabric weight or layer rule applies everywhere. Confirm required environmental or watercourse approvals before work that affects a channel, bank or shoreline.</p><p>The truckload result divides by an example 15-ton example; confirm payload. Supplier payload and volume, ground conditions and placement access determine the actual deliveries. Use the <a href="/dry-creek-bed">dry creek measurement guide</a> for a decorative lining and the <a href="/drain-rock-calculator">drain calculator</a> for a pipe trench.</p><h2>Questions before ordering</h2>{faqItems.map(item=><section><h2>{item.q}</h2><p>{item.a}</p></section>)}</div></div></article>

    <TopicClusterNav
      currentPage="/riprap-calculator"
      category="material"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />

  <script>
    function updateRiprap() {
      const l = parseFloat((document.getElementById('riprap-length') as HTMLInputElement)?.value) || 0;
      const w = parseFloat((document.getElementById('riprap-width') as HTMLInputElement)?.value) || 0;
      const d = parseFloat((document.getElementById('riprap-depth') as HTMLInputElement)?.value) || 0;
      const waste = parseFloat((document.getElementById('riprap-waste') as HTMLInputElement)?.value) || 0;

      const netYards = (l * w * d) / 324;
      const totalYards = netYards * (1 + waste / 100);
      const tons = totalYards * 1.40;
      const loads = tons / 15;

      const yEl = document.getElementById('kpi-riprap-yards');
      const tEl = document.getElementById('kpi-riprap-tons');
      const lEl = document.getElementById('kpi-riprap-loads');

      if (yEl) yEl.innerText = totalYards.toFixed(2);
      if (tEl) tEl.innerText = tons.toFixed(2);
      if (lEl) lEl.innerText = loads.toFixed(1);
    }

    ['riprap-length', 'riprap-width', 'riprap-depth', 'riprap-waste'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateRiprap);
    });
    updateRiprap();
  </script>
</BaseLayout>

<style>
  .section { padding: var(--space-8) 0; }
  .content-guide-section { padding: var(--space-12) 0; background: var(--bg-body); }
  .aeo-quick-card {
    background: var(--bg-card);
    border: 1px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
    box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
  }
  .aeo-quick-header { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); color: var(--accent-gold); }
  .aeo-quick-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .aeo-quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .aeo-quick-item { background: var(--bg-surface); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .aeo-quick-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); margin-bottom: 2px; }
  .aeo-quick-value { display: block; font-size: var(--text-sm); font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
  .aeo-quick-desc { font-size: 11px; color: var(--text-muted); margin: 0; line-height: 1.35; }
  .content-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .content-card h2 { font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-4); }
  .content-card h3 { font-size: var(--text-xl); color: var(--text-primary); margin: var(--space-6) 0 var(--space-3) 0; }
  .formula-box {
    background: var(--bg-surface);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    font-size: var(--text-sm);
    line-height: 1.8;
  }
  .steps-list { padding-left: var(--space-6); margin: var(--space-4) 0; }
  .steps-list li { margin-bottom: var(--space-3); }
  .faq-card { margin-top: var(--space-8); }
  .faq-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-item { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: var(--space-4); }
  .faq-item h3 { font-size: var(--text-base); color: var(--text-primary); margin: 0 0 var(--space-2) 0; }
  .faq-item p { font-size: var(--text-sm); color: var(--text-muted); margin: 0; }
</style>
