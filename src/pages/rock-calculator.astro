---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import GeneralRockCalculator from '../components/calculators/GeneralRockCalculator.astro';
import GeneralRockVisualizer from '../components/visualizers/GeneralRockVisualizer.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Rock Calculator', url: '/rock-calculator' }
];

const entityTags = [
  { label: 'Material', value: 'Quick Rock Calculator' },
  { label: 'Calculation Type', value: 'Rapid Single-Shape Estimator' },
  { label: 'Units Computed', value: 'Cubic Yards, Short Tons, 0.5 cu ft Bags' },
  { label: 'Density Standard', value: 'ASTM C29 Loose Unit Weight' }
];

const quickStats = [
  { value: 'Instant', label: 'Response Time', desc: 'Real time volume and tonnage as you type dimensions' },
  { value: '324 Divisor', label: 'Contractor Constant', desc: 'Converts length ft x width ft x depth in to cubic yards' },
  { value: 'Zero Clutter', label: 'Mobile Optimized', desc: 'Designed for quick contractor and jobsite estimation' }
];

const faqItems = [
  {
    q: 'How does this quick rock calculator compute volume and weight?',
    a: 'The quick rock calculator multiplies your bed area in square feet by your layer depth in inches, then divides by 324 to determine total cubic yards. To convert to certified quarry scale weight, it applies the bulk density of your chosen rock, typically 1.35 tons per cubic yard for standard river stone and gravel.'
  },
  {
    q: 'Why does dividing by 324 give cubic yards?',
    a: 'There are 12 inches in a foot and 27 cubic feet in a cubic yard. Multiplying 12 by 27 yields the contractor constant 324. This formula allows you to enter bed dimensions in feet and depth in inches directly without manual conversions.'
  },
  {
    q: 'How many tons of rock do I need per cubic yard?',
    a: 'Standard landscape gravel and river stone weigh approximately 1.35 tons (2,700 pounds) per cubic yard loose stockpile weight per ASTM C29. Heavy crushed granite weighs 1.40 tons per yard, dense graded road base weighs 1.45 to 1.50 tons per yard, and lightweight lava rock weighs only 0.75 tons per yard.'
  },
  {
    q: 'How much safety buffer should I add for on-site rock ordering?',
    a: 'Contractors recommend adding a 10 percent safety buffer for standard rectangular beds to account for subgrade depressions and settling. For curved borders or vehicular driveways subject to roller compaction, add 12 to 15 percent extra material.'
  }
];

const upLinks = [
  { title: 'Rock Coverage Calculator (Pillar)', slug: '/', badge: 'Pillar' },
  { title: 'How Much Rock Do I Need? (Intent Hub)', slug: '/how-much-rock-do-i-need', badge: 'Hub' }
];

const lateralLinks = [
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: '1.35 t/yd³' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: '1.40 t/yd³' },
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: '1.40 t/yd³' }
];

const bridgeLinks = [
  { title: 'Rock Cubic Yard Calculator', slug: '/rock-cubic-yard-calculator', badge: 'Yards' },
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Tons' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'Bags' }
];

const supportGuides = [
  { title: 'Rock Weight and Density Reference', slug: '/rock-density-chart', badge: 'ASTM C29' },
  { title: 'How Deep Should Rock Be?', slug: '/rock-depth-guide', badge: 'Depth Rules' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Cost Guide' }
];
---

<BaseLayout
  title="Quick Rock Calculator - Fast Cubic Yards, Tons & Bag Estimator"
  description="Fast online rock calculator for contractors and homeowners. Estimate exact cubic yards, scale tons, and 0.5 cu ft bags in seconds with zero fluff."
  canonicalPath="/rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Quick Rock Calculator",
      "url": "https://rockcoveragecalculator.com/rock-calculator",
      "description": "Fast on-site rock coverage calculator computing cubic yards, tons, and bags for landscape beds and jobsite estimation.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "inLanguage": "en-US",
      "audience": {
        "@type": "Audience",
        "audienceType": "Landscape Contractors, Civil Engineers, Estimators, Homeowners"
      },
      "about": {
        "@type": "Thing",
        "name": "Rapid Aggregate Volume and Weight Estimation"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  </Fragment>

  <Header />

  <main>
    <PageHero
      title="Quick Rock Calculator"
      highlightWord="Calculator"
      badge="Fast Jobsite Estimator"
      subtitle="Rapid cubic yards, quarry tonnage, and retail bag estimation. Built for quick on-site calculations with zero clutter."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      quickStats={quickStats}
    />

    <GeneralRockCalculator />

    <GeneralRockVisualizer />

    <!-- Technical Guide on Rock Calculations -->
    <article class="content-guide-section">
      <div class="container">
        
        <!-- Project Reference Summary -->
        <section class="aeo-quick-card" aria-label="Rock Calculation Reference">
          <div class="aeo-quick-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span class="aeo-quick-title">Rock Calculation Reference for Field Estimators</span>
          </div>
          <div class="aeo-quick-grid">
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Cubic Yards Formula</span>
              <span class="aeo-quick-value">Yards = (Area [sq ft] × Depth [in]) / 324</span>
              <p class="aeo-quick-desc">The universal contractor equation based on 12 in/ft × 27 cu ft/yd³.</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Scale Tons Conversion</span>
              <span class="aeo-quick-value">Tons = Cubic Yards × Bulk Density (t/yd³)</span>
              <p class="aeo-quick-desc">Standard gravel & river rock = 1.35 t/yd³ (2,700 lbs per yard).</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Retail Bags (0.5 cu ft)</span>
              <span class="aeo-quick-value">Bags = Cubic Yards × 54</span>
              <p class="aeo-quick-desc">Standard 0.5 cu ft bag yields 0.0185 yards (20 bags = 0.37 yards).</p>
            </div>
            <div class="aeo-quick-item">
              <span class="aeo-quick-label">Standard Depth Rule</span>
              <span class="aeo-quick-value">Depth = 1.5× to 2× Stone Caliper</span>
              <p class="aeo-quick-desc">Min 2 inches for pea gravel, 3 inches for 1-3 inch rock, 4-6 inches for driveways.</p>
            </div>
          </div>
        </section>

        <div class="content-card">
          <h2>Mastering Rapid On-Site Rock Estimation</h2>
          <p>
            Whether measuring a residential flower bed on a mobile phone or verifying a supplier delivery ticket at a commercial jobsite, speed and volumetric accuracy are essential. Quarries and landscape supply yards sell rock in two primary commerce units: <strong>Cubic Yards (Volume)</strong> and <strong>US Short Tons (Weight of 2,000 lbs)</strong>.
          </p>

          <h3>The 5-Step Field Calculation Method</h3>
          <ol class="steps-list">
            <li>
              <strong>Measure Area in Square Feet:</strong> For rectangular zones, multiply Length in feet by Width in feet. For circular zones, multiply 3.1416 by radius squared.
            </li>
            <li>
              <strong>Select Layer Depth in Inches:</strong> Typical decorative beds require 2 to 3 inches of stone, while vehicular driveways and drainage trenches require 4 to 8 inches.
            </li>
            <li>
              <strong>Divide by 324:</strong> Dividing the product of square footage and depth in inches by 324 yields exact net cubic yards.
            </li>
            <li>
              <strong>Multiply by Bulk Density for Tonnage:</strong> Multiply cubic yards by your aggregate bulk density in tons per cubic yard (ASTM C29 loose stockpile basis).
            </li>
            <li>
              <strong>Add a Safety Buffer:</strong> Apply 10 percent extra for rectangular garden beds, or 12 to 15 percent for irregular borders and wheel-compacted driveways.
            </li>
          </ol>

          <div class="formula-callout">
            <div class="formula-math">Total Tons = [(Square Feet × Depth in Inches) / 324] × Bulk Density in Tons/yd³ × 1.10</div>
            <div class="formula-desc">The industry standard master equation for quarry scale aggregate ordering with a 10 percent safety buffer.</div>
          </div>

          <h3>Quarry Bulk Density Benchmark Table</h3>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Rock Material</th>
                  <th>Gradation / Caliper</th>
                  <th>Bulk Density (t/yd³)</th>
                  <th>Coverage at 3" Depth</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong><a href="/river-rock-calculator" class="text-gold">River Rock</a></strong></td>
                  <td>1 to 3 inch smooth round</td>
                  <td>1.35 t/yd³ (2,700 lbs)</td>
                  <td>80 sq ft per ton</td>
                </tr>
                <tr>
                  <td><strong><a href="/crushed-stone-calculator" class="text-gold">Crushed Limestone (#57)</a></strong></td>
                  <td>1/2 to 1 inch angular</td>
                  <td>1.35 t/yd³ (2,700 lbs)</td>
                  <td>80 sq ft per ton</td>
                </tr>
                <tr>
                  <td><strong><a href="/crushed-granite-calculator" class="text-gold">Crushed Granite</a></strong></td>
                  <td>3/4 inch fractured</td>
                  <td>1.40 t/yd³ (2,800 lbs)</td>
                  <td>77 sq ft per ton</td>
                </tr>
                <tr>
                  <td><strong><a href="/crusher-run-calculator" class="text-gold">Crusher Run / DGA</a></strong></td>
                  <td>3/4 inch minus with fines</td>
                  <td>1.45 to 1.50 t/yd³ (3,000 lbs)</td>
                  <td>72 sq ft per ton</td>
                </tr>
                <tr>
                  <td><strong><a href="/pea-gravel-calculator" class="text-gold">Pea Gravel</a></strong></td>
                  <td>3/8 inch rounded</td>
                  <td>1.35 t/yd³ (2,700 lbs)</td>
                  <td>80 sq ft per ton</td>
                </tr>
                <tr>
                  <td><strong><a href="/lava-rock-calculator" class="text-gold">Volcanic Lava Rock</a></strong></td>
                  <td>3/4 to 1.5 inch porous</td>
                  <td>0.75 t/yd³ (1,500 lbs)</td>
                  <td>144 sq ft per ton</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="content-card faq-card">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqItems.map((item) => (
              <div class="faq-item">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>

    <TopicClusterNav 
      currentPage="/rock-calculator" 
      category="quantity"
      upLinks={upLinks}
      lateralLinks={lateralLinks}
      bridgeLinks={bridgeLinks}
      supportGuides={supportGuides}
    />
  </main>

  <Footer />
</BaseLayout>

<style>
.content-guide-section {
  padding: var(--space-12) 0;
  background: var(--color-bg);
}

.aeo-quick-card {
  background: var(--color-surface);
  border: 1px solid var(--accent-gold);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  margin-bottom: var(--space-8);
  box-shadow: 0 4px 20px rgba(212, 168, 83, 0.08);
}

.aeo-quick-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
  color: var(--accent-gold);
}

.aeo-quick-title {
  font-size: var(--text-sm);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.aeo-quick-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--space-4);
}

.aeo-quick-item {
  background: var(--color-bg);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}

.aeo-quick-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--accent-gold);
  margin-bottom: 2px;
}

.aeo-quick-value {
  display: block;
  font-size: var(--text-sm);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 2px;
}

.aeo-quick-desc {
  font-size: 11px;
  color: var(--color-text-muted);
  margin: 0;
  line-height: 1.35;
}

.content-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  margin-bottom: var(--space-8);
}

.content-card h2 {
  font-size: var(--text-2xl);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-4);
}

.content-card h3 {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  margin: var(--space-6) 0 var(--space-3) 0;
}

.content-card p {
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: var(--space-4);
}

.steps-list {
  color: var(--color-text-muted);
  line-height: 1.8;
  margin-bottom: var(--space-4);
  padding-left: var(--space-6);
}

.steps-list li {
  margin-bottom: var(--space-3);
}

.formula-callout {
  background: rgba(202, 138, 4, 0.08);
  border: 1px solid rgba(202, 138, 4, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-6);
  margin: var(--space-4) 0;
}

.formula-math {
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--color-primary);
  font-family: monospace;
}

.formula-desc {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: var(--space-1);
}

.table-container {
  overflow-x: auto;
  margin: var(--space-4) 0;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
}

th {
  text-align: left;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg);
  color: var(--color-text);
  border-bottom: 2px solid var(--color-border);
  font-weight: 600;
}

td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-muted);
}

tr:hover td {
  background: rgba(202, 138, 4, 0.04);
}

.text-gold {
  color: var(--accent-gold);
  text-decoration: none;
}

.text-gold:hover {
  text-decoration: underline;
}

.faq-card {
  margin-top: var(--space-8);
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-top: var(--space-4);
}

.faq-item {
  padding: var(--space-4);
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.faq-item h3 {
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--color-text);
  margin: 0 0 var(--space-2) 0;
}

.faq-item p {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
  margin: 0;
}
</style>
