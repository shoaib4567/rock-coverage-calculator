---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import GeneralRockCalculator from '../components/calculators/GeneralRockCalculator.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';
import { getMaterialById } from '../scripts/materials-data.js';

const pageTitle = 'Rock Calculator: Cubic Yards, Tons & Bags';
const riverRock = getMaterialById('river-rock-1');
const crushedGranite = getMaterialById('crushed-granite');
const decomposedGranite = getMaterialById('decomposed-granite');
const lavaRock = getMaterialById('lava-rock');
const exampleOrderYards = 120 * 3 / 324 * 1.10;
const exampleTons = exampleOrderYards * riverRock.tonsPerCuYd;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Rock Calculator', url: '/rock-calculator' }
];
const entityTags = [
  { label: 'Measure', value: 'Rectangle, full circle or known area' },
  { label: 'Enter', value: 'Finished depth and extra material' },
  { label: 'Estimate', value: 'Cubic yards, short tons and 0.5 cu ft bags' }
];
const faqItems = [
  {
    q: 'How do I calculate cubic yards of rock?',
    a: 'Multiply the area in square feet by the finished rock depth in inches, then divide by 324. A 120-square-foot bed at 3 inches needs 1.11 cubic yards before any extra material. The calculator adds your selected allowance to its displayed order volume.'
  },
  {
    q: 'Does one cubic yard of rock always weigh the same?',
    a: 'No. Rock type, grading, void space and moisture change the delivered weight. The calculator uses its selected material preset as a planning estimate. Ask the supplier for the loose bulk density or a product-specific tons-per-yard conversion before placing a weight-based order.'
  },
  {
    q: 'Can the circle input calculate a rock ring around a tree or fire pit?',
    a: 'The circle input calculates the whole circle. For a ring, subtract the inner circle from the outer one: ring area in square feet = 0.7854 × (outer diameter² − inner diameter²), with both diameters in feet. Enter that result under Known Area.'
  },
  {
    q: 'Are the bag results based on 50-pound bags?',
    a: 'No. The bag count divides the allowance-inclusive volume by 0.5 cubic foot and rounds up to a whole bag. Bag weight varies by material; check the package volume on the product you plan to buy.'
  }
];
const upLinks = [
  { title: 'Rock Coverage Calculator', slug: '/', badge: 'All shapes' },
  { title: 'How Much Rock Do I Need?', slug: '/how-much-rock-do-i-need', badge: 'Planning guide' }
];
const lateralLinks = [
  { title: 'River Rock Calculator', slug: '/river-rock-calculator', badge: 'Rounded stone' },
  { title: 'Crushed Stone Calculator', slug: '/crushed-stone-calculator', badge: 'Angular stone' },
  { title: 'Gravel Calculator', slug: '/gravel-calculator', badge: 'Gravel' }
];
const bridgeLinks = [
  { title: 'Rock Yardage Calculator', slug: '/rock-yardage-calculator', badge: 'Volume' },
  { title: 'Rock Tons Calculator', slug: '/rock-tons-calculator', badge: 'Weight' },
  { title: 'Rock Bag Calculator', slug: '/rock-bag-calculator', badge: 'Retail bags' }
];
const supportGuides = [
  { title: 'Rock Density Chart', slug: '/rock-density-chart', badge: 'Bulk density' },
  { title: 'Rock Depth Guide', slug: '/rock-depth-guide', badge: 'Layer depth' },
  { title: 'Bulk vs Bagged Rock', slug: '/bulk-vs-bagged-rock', badge: 'Buying choice' }
];
---

<BaseLayout
  title={pageTitle}
  description="Estimate rock for a measured bed in cubic yards, short tons and 0.5-cubic-foot bags. See the formula, depth choice and ordering assumptions."
  canonicalPath="/rock-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/rock-calculator',
      description: 'Estimate the volume and weight of rock for a measured area and finished layer depth.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question', name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Rock Calculator"
      badge="Measure → estimate → order"
      subtitle="Enter the rock bed's area and finished depth to estimate cubic yards. Choose a material to convert that volume into approximate short tons, or use the 0.5-cubic-foot bag count. The displayed quantities include your selected extra-material allowance."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      theme="utility"
    />

    <nav class="page-jumps container" aria-label="On this page">
      <a href="#general-rock-calc">Use the calculator</a>
      <a href="#worked-example">See the math</a>
      <a href="#measure">Measure your bed</a>
      <a href="#ordering">Plan the order</a>
    </nav>

    <section class="answer-strip" aria-label="Example rock estimate">
      <div class="container answer-inner">
        <p><strong>Example:</strong> A 12 × 10 ft bed at a finished depth of 3 in needs <strong>1.11 yd³</strong> of rock. With the tool's default 10% extra, order volume becomes <strong>1.22 yd³</strong> — about <strong>{exampleTons.toFixed(2)} short tons</strong> using its 1–3 in river-rock preset, or <strong>66 bags</strong> if each bag holds 0.5 cu ft.</p>
      </div>
    </section>

    <GeneralRockCalculator />

    <article class="field-guide">
      <div class="container">
        <section class="guide-section" id="worked-example" aria-labelledby="math-heading">
          <div class="section-intro">
            <p class="eyebrow">The estimate, unpacked</p>
            <h2 id="math-heading">From bed measurements to an order quantity</h2>
            <p>The tool starts with the space the rock will occupy. It then adds your extra-material percentage before converting the result to weight, bags and wheelbarrow loads. A cubic yard contains 27 cubic feet; a US short ton contains 2,000 pounds.</p>
          </div>
          <div class="math-layout">
            <div class="example-ticket">
              <div class="ticket-head"><span>Sample field takeoff</span><span>12 ft × 10 ft × 3 in</span></div>
              <ol>
                <li><span>Bed area</span><strong>12 × 10 = 120 sq ft</strong></li>
                <li><span>Rock volume before extra</span><strong>120 × 3 ÷ 324 = 1.11 yd³</strong></li>
                <li><span>Order volume with 10% extra</span><strong>1.11 × 1.10 = 1.22 yd³</strong></li>
                <li><span>Estimated weight at {riverRock.tonsPerCuYd} tons/yd³</span><strong>1.22 × {riverRock.tonsPerCuYd} ≈ {exampleTons.toFixed(2)} short tons</strong></li>
                <li><span>0.5 cu ft bags</span><strong>33 cu ft ÷ 0.5 = 66 bags</strong></li>
              </ol>
              <p>Displayed figures are rounded. The calculator uses unrounded values for each conversion and rounds the bag count up to a whole bag.</p>
            </div>
            <aside class="formula-card" aria-label="Rock volume formula">
              <span class="formula-label">Volume formula</span>
              <strong>cubic yards = square feet × depth (in) ÷ 324</strong>
              <p>The 324 comes from 12 inches per foot × 27 cubic feet per cubic yard. For an irregular area, measure its square footage first and enter it directly.</p>
              <a href="/rock-coverage-chart">Compare coverage at other depths →</a>
            </aside>
          </div>
        </section>

        <section class="guide-section" id="measure" aria-labelledby="measure-heading">
          <div class="section-intro">
            <p class="eyebrow">Measure once, enter the right shape</p>
            <h2 id="measure-heading">Use the area that will actually receive rock</h2>
            <p>Measure to the inside of your edging and subtract large footprints that will stay uncovered. Enter the <em>finished layer depth</em>, not the depth of an excavation below a separate base course.</p>
          </div>
          <div class="measure-grid">
            <figure class="bed-diagram">
              <svg viewBox="0 0 420 220" role="img" aria-labelledby="diagram-title diagram-desc">
                <title id="diagram-title">Rectangle bed area and rock layer depth</title>
                <desc id="diagram-desc">Top view of a 12-foot by 10-foot rectangle beside a cross-section of a 3-inch rock layer.</desc>
                <rect x="25" y="37" width="156" height="130" rx="8" fill="#194336" stroke="#54bd92" stroke-width="3" />
                <path d="M25 184h156M15 37v130" stroke="#d3a344" stroke-width="2" />
                <text x="103" y="203" fill="currentColor" text-anchor="middle" font-size="14">12 ft length</text>
                <text x="9" y="102" fill="currentColor" text-anchor="middle" font-size="14" transform="rotate(-90 9 102)">10 ft width</text>
                <text x="103" y="108" fill="#fff" text-anchor="middle" font-size="17" font-weight="700">120 sq ft</text>
                <path d="M260 122h128v31H260z" fill="#956f4a" stroke="#e5b974" stroke-width="2" />
                <path d="M265 124l13 11 14-10 12 13 12-14 14 12 14-11 12 12 14-13 14 13" fill="none" stroke="#e8d3aa" stroke-width="6" stroke-linejoin="round" />
                <path d="M399 122v31" stroke="#d3a344" stroke-width="2" />
                <text x="315" y="109" fill="currentColor" text-anchor="middle" font-size="14">rock layer</text>
                <text x="365" y="175" fill="currentColor" text-anchor="middle" font-size="14">3 in deep</text>
              </svg>
              <figcaption>Area × installed depth gives volume. The drawing is a measurement guide, not a rock-size specification.</figcaption>
            </figure>
            <div class="shape-notes">
              <div><h3>Rectangle or strip</h3><p>Enter length and average width in feet. Break an L-shaped bed into rectangles, add their areas, then use Known Area.</p></div>
              <div><h3>Full circle</h3><p>Enter the diameter across the entire circle. This mode includes the center of the circle.</p></div>
              <div><h3>Tree or fire-pit ring</h3><p>Subtract the center opening first: <strong>0.7854 × (outer diameter² − inner diameter²)</strong>. Enter the remaining square feet under Known Area.</p></div>
            </div>
          </div>
        </section>

        <section class="guide-section" id="ordering" aria-labelledby="ordering-heading">
          <div class="section-intro">
            <p class="eyebrow">Before calling the supplier</p>
            <h2 id="ordering-heading">Match the estimate to the material you will buy</h2>
            <p>Volume is controlled by the footprint and depth. Weight depends on the loose bulk density of the particular rock; changing the material preset changes tons, not cubic yards.</p>
          </div>
          <div class="order-grid">
            <div class="order-card"><span>01</span><h3>Set a realistic layer depth</h3><p>For decorative inorganic mulch around plantings, 2–3 inches is a useful starting range. Larger stone or exposed fabric may call for a deeper layer. A driveway base has different compaction requirements; plan it as a separate layer.</p><a href="/rock-depth-guide">Use the depth guide →</a></div>
            <div class="order-card"><span>02</span><h3>Confirm the weight conversion</h3><p>This tool starts at {riverRock.tonsPerCuYd} US tons/yd³ for 1–3 in river rock, {crushedGranite.tonsPerCuYd} for 3/4 in crushed granite, {decomposedGranite.tonsPerCuYd} for 1/4 in minus decomposed granite, and {lavaRock.tonsPerCuYd} for 3/4–2 in lava rock. Ask your supplier for its product's conversion; a scale ticket records the actual delivered weight.</p><a href="/rock-density-chart">Understand bulk density →</a></div>
            <div class="order-card"><span>03</span><h3>Check the sales unit</h3><p>The bag result assumes each bag contains 0.5 cu ft. A bag sold by pounds can contain a different volume. The 10% default extra covers small low spots and handling; change it if you have a measured need or unusually even ground.</p><a href="/bulk-vs-bagged-rock">Compare bulk and bags →</a></div>
          </div>
          <p class="scope-note"><strong>Tool scope:</strong> The volume, weight, bag and wheelbarrow results include the selected extra-material allowance. The fabric line estimates 10% overlap separately and assumes 3 × 100 ft rolls; check your actual roll size. Wheelbarrow trips assume a full 6 cu ft load. These are planning quantities, not a certified scale weight or a vehicle payload recommendation.</p>
        </section>

        <section class="guide-section faq-section" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Rock calculator questions</h2>
          <div class="faq-grid">
            {faqItems.map(item => (
              <div class="faq-item"><h3>{item.q}</h3><p>{item.a}</p></div>
            ))}
          </div>
        </section>

        <aside class="source-note" aria-label="Research and calculation references">
          <h2>Calculation references</h2>
          <p>The volume method follows the <a href="https://my.ucanr.edu/repository/fileaccess.cfm?article=162182&p=ONZASA" target="_blank" rel="noopener noreferrer">University of California guidance for rock and mulch quantities</a>. <a href="https://extension.usu.edu/cwel/research/water-wise-landscaping-mulch" target="_blank" rel="noopener noreferrer">Utah State University Extension</a> gives the 2–3 inch inorganic-mulch starting depth. <a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> describes how aggregate bulk density is measured; it does not assign one weight to every rock. <a href="https://www.lowes.com/pd/0-5-cu-ft-Brown-River-Rock/50396326" target="_blank" rel="noopener noreferrer">Retail product specifications</a> show why bag volume should be checked directly.</p>
        </aside>
      </div>
    </article>

    <TopicClusterNav currentPage="/rock-calculator" category="quantity" upLinks={upLinks} lateralLinks={lateralLinks} bridgeLinks={bridgeLinks} supportGuides={supportGuides} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-jumps { display: flex; flex-wrap: wrap; gap: .6rem; padding-top: 1.25rem; padding-bottom: 1.25rem; }
  .page-jumps a { color: var(--color-text); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 999px; padding: .45rem .85rem; font-size: var(--text-sm); text-decoration: none; }
  .page-jumps a:hover, .page-jumps a:focus-visible { border-color: var(--accent-gold); }
  .answer-strip { background: rgba(202, 138, 4, .08); border-top: 1px solid rgba(202, 138, 4, .22); border-bottom: 1px solid rgba(202, 138, 4, .22); }
  .answer-inner { padding-top: 1rem; padding-bottom: 1rem; }
  .answer-inner p { margin: 0; line-height: 1.65; color: var(--color-text); }
  .field-guide { background: var(--color-bg); padding: var(--space-10) 0 var(--space-12); }
  .guide-section { margin-bottom: var(--space-12); scroll-margin-top: 2rem; }
  .section-intro { max-width: 820px; margin-bottom: var(--space-6); }
  .section-intro h2, .faq-section h2 { color: var(--color-text); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; margin: 0 0 var(--space-3); }
  .section-intro p:not(.eyebrow) { color: var(--color-text-muted); line-height: 1.7; margin: 0; }
  .eyebrow { color: var(--accent-gold); text-transform: uppercase; letter-spacing: .08em; font-size: var(--text-xs); font-weight: 800; margin: 0 0 var(--space-2); }
  .math-layout { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(260px, .8fr); gap: var(--space-5); align-items: stretch; }
  .example-ticket, .formula-card, .bed-diagram, .shape-notes > div, .order-card, .faq-item, .source-note { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .example-ticket { overflow: hidden; }
  .ticket-head { display: flex; justify-content: space-between; gap: 1rem; padding: var(--space-4) var(--space-5); background: rgba(202, 138, 4, .1); color: var(--color-text); font-size: var(--text-sm); font-weight: 800; }
  .example-ticket ol { margin: 0; padding: var(--space-3) var(--space-5); list-style: none; }
  .example-ticket li { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); font-size: var(--text-sm); }
  .example-ticket li:last-child { border-bottom: 0; }
  .example-ticket li strong { color: var(--color-text); text-align: right; }
  .example-ticket p { margin: 0; padding: 0 var(--space-5) var(--space-4); color: var(--color-text-muted); font-size: var(--text-xs); line-height: 1.5; }
  .formula-card { padding: var(--space-5); border-color: rgba(202, 138, 4, .5); display: flex; flex-direction: column; align-items: flex-start; }
  .formula-label { color: var(--accent-gold); text-transform: uppercase; font-size: var(--text-xs); letter-spacing: .08em; font-weight: 800; margin-bottom: var(--space-3); }
  .formula-card strong { color: var(--color-text); font-size: var(--text-lg); line-height: 1.45; }
  .formula-card p { color: var(--color-text-muted); line-height: 1.6; }
  .formula-card a, .order-card a, .source-note a { color: var(--accent-gold); }
  .formula-card a { margin-top: auto; }
  .measure-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-5); }
  .bed-diagram { margin: 0; padding: var(--space-5); display: flex; flex-direction: column; justify-content: center; }
  .bed-diagram svg { color: var(--color-text); display: block; width: 100%; max-width: 480px; height: auto; margin: auto; }
  .bed-diagram figcaption { color: var(--color-text-muted); font-size: var(--text-xs); line-height: 1.5; margin-top: var(--space-3); }
  .shape-notes { display: grid; gap: var(--space-3); }
  .shape-notes > div { padding: var(--space-4); }
  .shape-notes h3, .order-card h3, .faq-item h3 { color: var(--color-text); font-size: var(--text-base); margin: 0 0 var(--space-2); }
  .shape-notes p, .order-card p, .faq-item p { color: var(--color-text-muted); line-height: 1.6; font-size: var(--text-sm); margin: 0; }
  .order-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .order-card { padding: var(--space-5); display: flex; flex-direction: column; align-items: flex-start; }
  .order-card > span { color: var(--accent-gold); font-size: var(--text-xl); font-weight: 800; margin-bottom: var(--space-3); }
  .order-card a { margin-top: auto; padding-top: var(--space-4); font-size: var(--text-sm); font-weight: 700; }
  .scope-note { color: var(--color-text-muted); border-left: 3px solid var(--accent-gold); padding: var(--space-3) var(--space-4); margin: var(--space-5) 0 0; line-height: 1.65; font-size: var(--text-sm); }
  .scope-note strong { color: var(--color-text); }
  .faq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-5); }
  .faq-item { padding: var(--space-5); }
  .source-note { padding: var(--space-5); }
  .source-note h2 { color: var(--color-text); font-size: var(--text-base); margin: 0 0 var(--space-2); }
  .source-note p { color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.65; margin: 0; }
  @media (max-width: 800px) { .math-layout, .measure-grid, .order-grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .faq-grid { grid-template-columns: 1fr; } .example-ticket li, .ticket-head { flex-direction: column; gap: .2rem; } .example-ticket li strong { text-align: left; } }
</style>
