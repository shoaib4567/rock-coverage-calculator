---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import TopicClusterNav from '../components/TopicClusterNav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Gravel Tons Calculator';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gravel Calculator', url: '/gravel-calculator' },
  { name: pageTitle, url: '/gravel-tons-calculator' }
];
const entityTags = [
  { label: 'Order unit', value: 'US short ton (2,000 lb)' },
  { label: 'Volume', value: 'Cubic yards' },
  { label: 'Weight', value: 'Editable loose bulk density' }
];
const faqItems = [
  {
    q: 'How many tons of gravel do I need for a 10 × 50 foot area?',
    a: 'At 3 inches deep, 500 square feet needs 4.63 cubic yards before extra. At the calculator’s 1.40 short tons per cubic yard planning value, that is 6.48 short tons. With 10% extra, the order estimate is 7.13 short tons. Use your supplier’s bulk weight and the depth for your actual layer.'
  },
  {
    q: 'How do I convert cubic yards of gravel to tons?',
    a: 'Multiply cubic yards by the loose bulk weight of your gravel in US short tons per cubic yard. For example, 5 cubic yards at 1.40 short tons per cubic yard is about 7 short tons. The conversion changes with the product and its condition.'
  },
  {
    q: 'How many square feet does one ton of gravel cover?',
    a: 'At an assumed 1.40 short tons per cubic yard, one short ton covers about 116 square feet at 2 inches, 77 square feet at 3 inches, or 58 square feet at 4 inches. These are level-layer estimates before an extra allowance.'
  },
  {
    q: 'Does the 10% extra automatically cover compaction?',
    a: 'No. The extra field is a chosen ordering allowance, not a measured compaction factor. If your plan specifies a compacted finished depth, ask the supplier or installer how much loose material that product needs to reach it. Calculate base and surface layers separately.'
  },
  {
    q: 'How many tons fit in a gravel delivery truck?',
    a: 'There is no reliable capacity for every truck. Legal payload, truck configuration, route, and access differ. Give the supplier your estimated tons and ask how many deliveries it will take, the minimum order, and where the load can be tipped.'
  }
];
---

<BaseLayout
  title={pageTitle}
  metaDescription="Estimate US short tons of gravel from dimensions, measured square feet, or known cubic yards. Adjust supplier bulk weight and extra allowance; see yards and coverage."
  canonicalPath="/gravel-tons-calculator"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: pageTitle,
      url: 'https://rockcoveragecalculator.com/gravel-tons-calculator',
      description: 'Estimates US short tons of gravel from dimensions, area, or cubic yards using editable loose bulk weight and an ordering allowance.',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Web',
      inLanguage: 'en-US'
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    })} />
  </Fragment>
  <Header />
  <main>
    <PageHero
      title={pageTitle}
      highlightWord="Tons"
      badge="Bulk gravel order estimator"
      subtitle="A 10 × 50 ft area at 3 in deep needs about 6.48 US short tons at the 1.40 tons-per-yard planning weight, or 7.13 tons with 10% extra. Enter your measurements and the bulk weight of the gravel you will actually buy."
      breadcrumbs={breadcrumbs}
      entityTags={entityTags}
      theme="civil"
    />

    <section class="gt-tool" id="gt-calculator" aria-labelledby="gt-tool-heading">
      <div class="container">
        <div class="gt-tool-intro">
          <p class="gt-eyebrow">Your order, in weight</p>
          <h2 id="gt-tool-heading">How many tons of gravel do you need?</h2>
          <p>Start with the area you measured or the cubic yards already on your plan. The result is an estimate until you confirm the product's loose bulk weight and the seller's ordering unit.</p>
        </div>
        <div class="gt-tool-grid">
          <div class="gt-card gt-input-card">
            <fieldset class="gt-mode">
              <legend>What do you know?</legend>
              <label><input type="radio" name="gt-mode" value="rectangle" checked /> Length × width</label>
              <label><input type="radio" name="gt-mode" value="area" /> Square feet</label>
              <label><input type="radio" name="gt-mode" value="yards" /> Cubic yards</label>
            </fieldset>
            <div class="gt-measure-fields" id="gt-rectangle-fields">
              <div class="gt-field"><label for="gt-length">Length <span>(feet)</span></label><input id="gt-length" type="number" value="50" min="0.1" step="any" inputmode="decimal" /></div>
              <div class="gt-field"><label for="gt-width">Width <span>(feet)</span></label><input id="gt-width" type="number" value="10" min="0.1" step="any" inputmode="decimal" /></div>
            </div>
            <div class="gt-measure-fields" id="gt-area-fields" hidden>
              <div class="gt-field"><label for="gt-area">Measured area <span>(square feet)</span></label><input id="gt-area" type="number" value="500" min="0.1" step="any" inputmode="decimal" /></div>
            </div>
            <div class="gt-measure-fields" id="gt-yards-fields" hidden>
              <div class="gt-field"><label for="gt-yards">Known volume <span>(cubic yards)</span></label><input id="gt-yards" type="number" value="4.63" min="0.01" step="any" inputmode="decimal" /></div>
            </div>
            <div class="gt-measure-fields" id="gt-depth-fields">
              <div class="gt-field"><label for="gt-depth">Planned layer depth <span>(inches)</span></label><input id="gt-depth" type="number" value="3" min="0.1" max="36" step="any" inputmode="decimal" aria-describedby="gt-depth-help" /></div>
            </div>
            <div class="gt-measure-fields">
              <div class="gt-field"><label for="gt-density">Loose bulk weight <span>(short tons/yd³)</span></label><input id="gt-density" type="number" value="1.40" min="0.1" max="3.5" step="any" inputmode="decimal" aria-describedby="gt-density-help" /></div>
              <div class="gt-field"><label for="gt-extra">Extra to order <span>(%)</span></label><input id="gt-extra" type="number" value="10" min="0" max="100" step="any" inputmode="decimal" aria-describedby="gt-extra-help" /></div>
            </div>
            <div class="gt-help">
              <p id="gt-depth-help"><strong>Depth:</strong> enter the depth of this layer only. For a base and a surface made of different gravel, run each layer separately.</p>
              <p id="gt-density-help"><strong>Weight:</strong> 1.40 is an approximate planning conversion, equal to 2,800 lb/yd³. Replace it with your supplier's figure when available.</p>
              <p id="gt-extra-help"><strong>Extra:</strong> use this for your chosen allowance for low spots, grade changes, or handling. It is not an automatic compaction factor.</p>
            </div>
            <p id="gt-error" class="gt-error" role="alert" hidden></p>
          </div>

          <div class="gt-card gt-result-card" aria-live="polite">
            <p class="gt-eyebrow">Estimated amount to order</p>
            <div class="gt-primary-result"><strong id="gt-order-tons">7.13</strong><span>US short tons</span></div>
            <p id="gt-result-caption" class="gt-caption">500 sq ft at 3 in, with 10% extra</p>
            <dl class="gt-breakdown">
              <div><dt>Gravel at planned depth</dt><dd id="gt-net-tons">6.48 tons</dd></div>
              <div><dt>Volume before extra</dt><dd id="gt-net-yards">4.63 yd³</dd></div>
              <div><dt>Volume with extra</dt><dd id="gt-order-yards">5.09 yd³</dd></div>
              <div><dt>Estimated order weight</dt><dd id="gt-order-pounds">14,259 lb</dd></div>
              <div><dt>One ton covers at 3 in</dt><dd id="gt-one-ton-area">77 sq ft</dd></div>
            </dl>
            <p id="gt-math" class="gt-math">500 sq ft × 3 in ÷ 324 = 4.63 yd³; × 1.40 = 6.48 tons; + 10% = 7.13 tons.</p>
            <p class="gt-result-note">The scale ticket reports the delivered weight. Ask the yard about its minimum order, order increments, and delivery capacity.</p>
          </div>
        </div>
      </div>
    </section>

    <article class="gt-guide">
      <div class="container">
        <nav class="gt-jumps" aria-label="On this page">
          <strong>Plan the load</strong>
          <a href="#gt-method">Follow the math</a>
          <a href="#gt-coverage">Check coverage</a>
          <a href="#gt-layers">Separate layers</a>
          <a href="#gt-quote">Prepare a quote</a>
          <a href="#gt-questions">Questions</a>
        </nav>

        <section class="gt-panel gt-method" id="gt-method" aria-labelledby="gt-method-heading">
          <div>
            <p class="gt-eyebrow">Three measurements, one conversion</p>
            <h2 id="gt-method-heading">Turn a gravel layer into an order weight</h2>
            <p>Area and depth describe <em>volume</em>; a quarry sells a <em>weight</em>. First convert the planned layer to cubic yards. Then multiply by the gravel's loose bulk weight in short tons per cubic yard. Add your extra allowance once, after calculating the layer itself.</p>
            <div class="gt-formula"><code>cubic yards = area (sq ft) × depth (in) ÷ 324</code><code>short tons = cubic yards × loose short tons per yd³</code><code>order tons = short tons × (1 + extra % ÷ 100)</code></div>
            <p>For a <strong>10 × 50 ft area at 3 in</strong>, 500 × 3 ÷ 324 = <strong>4.63 yd³</strong>. At 1.40 short tons/yd³, that is <strong>6.48 tons</strong> at the planned depth. Choosing 10% extra raises the order estimate to <strong>7.13 tons</strong>. One US short ton is 2,000 lb.</p>
            <p class="gt-fine">The divisor 324 combines 12 inches per foot with 27 cubic feet per cubic yard. If you already have cubic yards, enter them directly and the calculator skips the area and depth conversion.</p>
          </div>
          <figure>
            <img src="/gravel-tons-order-path.svg" width="840" height="550" loading="lazy" alt="Gravel tonnage diagram: 500 square feet at 3 inches is 4.63 cubic yards, or 6.48 US short tons at 1.40 tons per cubic yard; 10 percent extra gives 7.13 tons." />
            <figcaption><span class="gt-mobile-figure-hint">Swipe to read the diagram. </span>Check each step against the units on your supplier's quote.</figcaption>
          </figure>
        </section>

        <section class="gt-panel" id="gt-coverage" aria-labelledby="gt-coverage-heading">
          <p class="gt-eyebrow">A check against the measured area</p>
          <h2 id="gt-coverage-heading">How far does one ton of gravel spread?</h2>
          <p>These figures use the same <strong>1.40 short tons/yd³</strong> planning weight and an even layer. They exclude extra. If the actual gravel weighs more per yard, a ton covers less ground. For your selected density, the calculator above updates the 3-inch yield.</p>
          <div class="gt-table-wrap"><table>
            <caption>Estimated gravel coverage before ordering extra</caption>
            <thead><tr><th scope="col">Layer depth</th><th scope="col">One cubic yard covers</th><th scope="col">One short ton covers</th></tr></thead>
            <tbody>
              <tr><th scope="row">2 in</th><td>162 sq ft</td><td>116 sq ft</td></tr>
              <tr><th scope="row">3 in</th><td>108 sq ft</td><td>77 sq ft</td></tr>
              <tr><th scope="row">4 in</th><td>81 sq ft</td><td>58 sq ft</td></tr>
              <tr><th scope="row">6 in</th><td>54 sq ft</td><td>39 sq ft</td></tr>
            </tbody>
          </table></div>
          <p class="gt-fine">This table estimates material quantity, not the depth a new driveway requires. Site conditions, traffic, subgrade, and the aggregate's role determine the section. See the <a href="/rock-depth-guide">depth guide</a> and <a href="/gravel-sizes">gravel size guide</a> before treating a single number as a design.</p>
        </section>

        <section class="gt-panel" id="gt-layers" aria-labelledby="gt-layers-heading">
          <p class="gt-eyebrow">For driveways and compacted bases</p>
          <h2 id="gt-layers-heading">Count the base and surface as separate orders</h2>
          <p>A base with fines and a clean surface gravel are different products. Their depths and bulk weights may differ, and a compacted finished layer may need more loose material than its geometric volume suggests. Measure each layer, calculate its tons, and add the orders only after checking the supplier's values.</p>
          <div class="gt-layer-grid">
            <div><span>01 / Base</span><h3>Measure the compacted target</h3><p>Confirm the base aggregate and finished thickness with your plan or installer. Ask the supplier what loose quantity achieves that thickness after placement and compaction. Enter any additional order amount deliberately in the extra field.</p></div>
            <div><span>02 / Surface</span><h3>Calculate the top layer</h3><p>Run the calculator again with its own depth and bulk weight. A decorative rounded gravel or clean drainage stone should not inherit the base's density or allowance.</p></div>
          </div>
          <p>For example, on the same 500 sq ft area, a <em>hypothetical</em> 4-inch base at 1.50 tons/yd³ is 9.26 tons before extra; a separate 2-inch layer at 1.40 tons/yd³ is 4.32 tons. That is 13.58 tons before any product-specific allowances. These example depths are arithmetic inputs, not a driveway specification. For a fuller project estimate, use the <a href="/driveway-rock-calculator">driveway rock calculator</a>; for a particular fractured stone, use the <a href="/crushed-stone-tons-calculator">crushed stone tons calculator</a>.</p>
        </section>

        <section class="gt-panel gt-quote" id="gt-quote" aria-labelledby="gt-quote-heading">
          <p class="gt-eyebrow">Before the truck is booked</p>
          <h2 id="gt-quote-heading">Make the estimate match the yard's quote</h2>
          <p>The <a href="https://www.ndltap.org/resources/downloads/gravel-spread.pdf" target="_blank" rel="noopener noreferrer">North Dakota Local Technical Assistance Program gravel spread chart</a> uses 1.4 tons per cubic yard as an <em>approximate</em> conversion. Its separate spread chart assumes a 25% compaction factor; this calculator does not apply that factor. <a href="https://store.astm.org/c0029_c0029m-23.html" target="_blank" rel="noopener noreferrer">ASTM C29/C29M</a> describes how to measure aggregate bulk density; it does not set a standard weight for all gravel. The standard also notes that moisture and packing in stockpiles or haul units can differ from a dry test.</p>
          <div class="gt-sensitivity" aria-label="How supplier weight changes an example gravel order">
            <div><span>1.30 tons/yd³</span><strong>6.62 tons</strong></div>
            <div><span>1.40 tons/yd³</span><strong>7.13 tons</strong></div>
            <div><span>1.50 tons/yd³</span><strong>7.64 tons</strong></div>
          </div>
          <p class="gt-fine">All three figures use 500 sq ft, a 3-inch layer, and 10% extra. Only the bulk weight changes. The surrounding values illustrate sensitivity; they are not prescribed densities for specific gravel grades.</p>
          <ol class="gt-checklist">
            <li><strong>Name the exact material.</strong> Ask whether the quote is for clean stone, natural gravel, or a graded base with fines. <a href="https://www.fhwa.dot.gov/publications/research/infrastructure/structures/97148/app3.cfm" target="_blank" rel="noopener noreferrer">FHWA's granular-base guidance</a> explains why grading and particle shape matter to a base layer.</li>
            <li><strong>Get the conversion used on the quote.</strong> Ask for that product's approximate pounds or short tons per loose cubic yard. If the seller quotes cubic yards, compare those with your order volume.</li>
            <li><strong>Clarify the finished depth.</strong> Confirm whether your planned number is loose spread depth or compacted depth. Ask what allowance is appropriate for that product and site.</li>
            <li><strong>Plan delivery from the actual payload.</strong> Ask about the truck's legal load for your route, minimum order, delivery charge, and safe tipping spot. A single generic truckload figure cannot determine your number of trips.</li>
          </ol>
          <p>Need a volume order instead? Use the <a href="/gravel-cubic-yard-calculator">gravel cubic yard calculator</a>. For small retail quantities, use the <a href="/gravel-bag-calculator">gravel bag calculator</a>. The <a href="/rock-density-chart">rock density reference</a> helps compare other aggregates.</p>
        </section>

        <section class="gt-panel" id="gt-questions" aria-labelledby="gt-questions-heading">
          <h2 id="gt-questions-heading">Gravel tonnage questions</h2>
          <div class="gt-faq">{faqItems.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
        </section>
      </div>
    </article>
    <TopicClusterNav currentPage="/gravel-tons-calculator" category="quantity" />
  </main>
  <Footer />
  <script>
    const gtInput = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    const gtNumber = (id: string) => {
      const raw = gtInput(id)?.value.trim();
      return raw ? Number(raw) : NaN;
    };
    const gtOutput = (id: string, value: string) => {
      const target = document.getElementById(id);
      if (target) target.textContent = value;
    };
    const gtResultIds = ['gt-order-tons', 'gt-net-tons', 'gt-net-yards', 'gt-order-yards', 'gt-order-pounds', 'gt-one-ton-area'];
    function updateGravelTons() {
      const mode = (document.querySelector('input[name="gt-mode"]:checked') as HTMLInputElement | null)?.value || 'rectangle';
      for (const name of ['rectangle', 'area', 'yards']) {
        const fields = document.getElementById('gt-' + name + '-fields');
        if (fields) fields.hidden = mode !== name;
      }
      const depthFields = document.getElementById('gt-depth-fields');
      if (depthFields) depthFields.hidden = mode === 'yards';
      const length = gtNumber('gt-length');
      const width = gtNumber('gt-width');
      const enteredArea = gtNumber('gt-area');
      const enteredYards = gtNumber('gt-yards');
      const depth = gtNumber('gt-depth');
      const density = gtNumber('gt-density');
      const extra = gtNumber('gt-extra');
      const area = mode === 'area' ? enteredArea : length * width;
      const netYards = mode === 'yards' ? enteredYards : area * depth / 324;
      const validMeasure = mode === 'yards'
        ? Number.isFinite(enteredYards) && enteredYards > 0
        : mode === 'area'
          ? Number.isFinite(enteredArea) && enteredArea > 0
          : [length, width].every(value => Number.isFinite(value) && value > 0);
      const validDepth = mode === 'yards' || (Number.isFinite(depth) && depth > 0 && depth <= 36);
      const orderYards = netYards * (1 + extra / 100);
      const netTons = netYards * density;
      const orderTons = orderYards * density;
      const valid = validMeasure && validDepth && Number.isFinite(netYards) && netYards > 0
        && Number.isFinite(density) && density > 0 && density <= 3.5
        && Number.isFinite(extra) && extra >= 0 && extra <= 100
        && Number.isFinite(orderTons) && orderTons > 0;
      const error = document.getElementById('gt-error');
      if (!valid) {
        gtResultIds.forEach(id => gtOutput(id, '—'));
        gtOutput('gt-result-caption', 'Enter valid measurements, bulk weight, and extra.');
        gtOutput('gt-math', 'Check the highlighted inputs to calculate an order.');
        if (error) {
          error.textContent = 'Use a positive area or volume, a depth up to 36 in, bulk weight up to 3.5 tons/yd³, and extra from 0% to 100%.';
          error.hidden = false;
        }
        return;
      }
      if (error) error.hidden = true;
      gtOutput('gt-order-tons', orderTons.toFixed(2));
      gtOutput('gt-net-tons', netTons.toFixed(2) + ' tons');
      gtOutput('gt-net-yards', netYards.toFixed(2) + ' yd³');
      gtOutput('gt-order-yards', orderYards.toFixed(2) + ' yd³');
      gtOutput('gt-order-pounds', Math.round(orderTons * 2000).toLocaleString('en-US') + ' lb');
      gtOutput('gt-one-ton-area', Math.round(108 / density).toLocaleString('en-US') + ' sq ft');
      gtOutput('gt-result-caption', mode === 'yards'
        ? netYards.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' yd³ entered, with ' + extra + '% extra'
        : area.toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' sq ft at ' + depth + ' in, with ' + extra + '% extra');
      gtOutput('gt-math', mode === 'yards'
        ? netYards.toFixed(2) + ' yd³ × ' + density + ' tons/yd³ = ' + netTons.toFixed(2) + ' tons; + ' + extra + '% = ' + orderTons.toFixed(2) + ' tons.'
        : area.toLocaleString('en-US', { maximumFractionDigits: 1 }) + ' sq ft × ' + depth + ' in ÷ 324 = ' + netYards.toFixed(2) + ' yd³; × ' + density + ' = ' + netTons.toFixed(2) + ' tons; + ' + extra + '% = ' + orderTons.toFixed(2) + ' tons.');
    }
    ['gt-length', 'gt-width', 'gt-area', 'gt-yards', 'gt-depth', 'gt-density', 'gt-extra']
      .forEach(id => gtInput(id)?.addEventListener('input', updateGravelTons));
    document.querySelectorAll<HTMLInputElement>('input[name="gt-mode"]')
      .forEach(item => item.addEventListener('change', updateGravelTons));
    updateGravelTons();
  </script>
</BaseLayout>

<style>
  .gt-tool { padding: var(--space-8) 0; }
  .gt-tool-intro { max-width: 730px; margin-bottom: var(--space-6); }
  .gt-tool-intro h2, .gt-panel h2 { color: var(--text-primary); font-size: var(--text-2xl); line-height: 1.25; margin: 0 0 var(--space-3); }
  .gt-tool-intro p, .gt-panel p { color: var(--text-secondary); line-height: 1.7; }
  .gt-eyebrow { color: var(--accent-gold) !important; text-transform: uppercase; letter-spacing: .08em; font-size: var(--text-xs); font-weight: 700; margin: 0 0 var(--space-2); }
  .gt-tool-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: var(--space-5); align-items: start; }
  .gt-card, .gt-panel { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); padding: var(--space-8); }
  .gt-mode { border: 0; margin: 0 0 var(--space-6); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .gt-mode legend { width: 100%; color: var(--text-primary); font-weight: 700; margin-bottom: var(--space-3); }
  .gt-mode label { display: inline-flex; align-items: center; gap: .45rem; color: var(--text-primary); border: 1px solid var(--border-subtle); border-radius: 999px; padding: .5rem .75rem; cursor: pointer; }
  .gt-mode input { accent-color: var(--accent-gold); }
  .gt-measure-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4); }
  .gt-measure-fields[hidden] { display: none; }
  .gt-field label { display: block; color: var(--text-primary); font-weight: 700; margin-bottom: .5rem; }
  .gt-field label span { font-weight: 400; color: var(--text-secondary); }
  .gt-field input { width: 100%; min-height: 48px; padding: .75rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-body); color: var(--text-primary); font: inherit; }
  .gt-field input:focus-visible, .gt-mode input:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
  .gt-help { border-top: 1px solid var(--border-subtle); padding-top: var(--space-4); }
  .gt-help p, .gt-result-note { font-size: var(--text-sm); line-height: 1.65; color: var(--text-secondary); margin: 0 0 var(--space-3); }
  .gt-error { color: #ffd0c6; background: rgba(180, 60, 40, .14); border: 1px solid rgba(220, 85, 64, .4); padding: .8rem 1rem; border-radius: var(--radius-md); margin: var(--space-4) 0 0; }
  .gt-error[hidden] { display: none; }
  .gt-result-card { background: linear-gradient(145deg, rgba(212, 168, 83, .13), var(--bg-card) 48%); }
  .gt-primary-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; color: var(--text-primary); }
  .gt-primary-result strong { font-size: clamp(3rem, 6vw, 5rem); line-height: 1; letter-spacing: -.05em; }
  .gt-primary-result span { font-size: var(--text-lg); font-weight: 700; }
  .gt-caption { color: var(--text-secondary); margin: var(--space-3) 0 var(--space-6); }
  .gt-breakdown { margin: 0; border-top: 1px solid var(--border-subtle); }
  .gt-breakdown div { display: flex; justify-content: space-between; gap: var(--space-4); border-bottom: 1px solid var(--border-subtle); padding: .9rem 0; }
  .gt-breakdown dt { color: var(--text-secondary); }
  .gt-breakdown dd { margin: 0; color: var(--text-primary); font-weight: 700; text-align: right; white-space: nowrap; }
  .gt-math { border-left: 3px solid var(--accent-gold); padding: .7rem 1rem; margin: var(--space-6) 0; background: rgba(212, 168, 83, .08); color: var(--text-primary); line-height: 1.6; }
  .gt-result-note { margin-bottom: 0; }
